@@ -0,0 +1,189 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Batch;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Diagnostics;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Io;
+using TradeReconciliation.Ledger;
+using TradeReconciliation.Matching;
+using TradeReconciliation.Reporting;
+
+namespace TradeReconciliation.Tests
+{
+    /// <summary>Shared builders and file helpers so individual tests stay focused on behaviour.</summary>
+    internal static class TestSupport
+    {
+        internal static readonly DateTime BusinessDate = new DateTime(2025, 3, 17);
+
+        internal static TradeRecord Trade(
+            string tradeId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            string currency = "USD",
+            decimal netAmount = 12500m,
+            DateTime? settlementDate = null)
+        {
+            return new TradeRecord
+            {
+                TradeId = tradeId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? BusinessDate,
+                Currency = currency,
+                NetAmount = netAmount
+            };
+        }
+
+        internal static PositionRecord Position(
+            string positionId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            string currency = "USD",
+            DateTime? settlementDate = null)
+        {
+            return new PositionRecord
+            {
+                PositionId = positionId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? BusinessDate,
+                Currency = currency
+            };
+        }
+
+        internal static SettlementRecord Settlement(
+            string settlementId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            string currency = "USD",
+            decimal cashAmount = 12500m,
+            DateTime? settlementDate = null)
+        {
+            return new SettlementRecord
+            {
+                SettlementId = settlementId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? BusinessDate,
+                Currency = currency,
+                CashAmount = cashAmount
+            };
+        }
+
+        internal static ManualOverrideRecord Override(
+            string tradeId,
+            string action = "ForceMatch",
+            string note = "Cash rounded by legacy custodian",
+            string approvedBy = "ops-manager")
+        {
+            return new ManualOverrideRecord
+            {
+                TradeId = tradeId,
+                Action = action,
+                Note = note,
+                ApprovedBy = approvedBy
+            };
+        }
+
+        internal static ReconciliationResult Reconcile(
+            IEnumerable<TradeRecord> trades,
+            IEnumerable<PositionRecord>? positions = null,
+            IEnumerable<SettlementRecord>? settlements = null,
+            IEnumerable<ManualOverrideRecord>? overrides = null,
+            ReconciliationOptions? options = null)
+        {
+            return new MatchingEngine(options ?? ReconciliationOptions.Default).Reconcile(
+                new List<TradeRecord>(trades),
+                new List<PositionRecord>(positions ?? Array.Empty<PositionRecord>()),
+                new List<SettlementRecord>(settlements ?? Array.Empty<SettlementRecord>()),
+                new List<ManualOverrideRecord>(overrides ?? Array.Empty<ManualOverrideRecord>()));
+        }
+
+        internal static ReconciliationBatch CreateBatch(IBatchLogger? logger = null)
+        {
+            return new ReconciliationBatch(
+                new CsvFileGateway(),
+                new MatchingEngine(),
+                new EndOfDayReporter(),
+                new InputSignatureCalculator(),
+                RunLedgerStore.ForOutputDirectory,
+                logger ?? new RecordingBatchLogger());
+        }
+
+        internal static string FixtureInput(string fixtureName)
+        {
+            return Path.Combine(AppContext.BaseDirectory, "Fixtures", fixtureName, "input");
+        }
+
+        internal static string FixtureExpected(string fixtureName, string fileName)
+        {
+            return Path.Combine(AppContext.BaseDirectory, "Fixtures", fixtureName, "expected", fileName);
+        }
+
+        /// <summary>Creates an empty scratch directory inside the test output folder.</summary>
+        internal static string FreshDirectory(string name)
+        {
+            string directory = Path.Combine(AppContext.BaseDirectory, "test-output", name);
+            if (Directory.Exists(directory))
+            {
+                Directory.Delete(directory, recursive: true);
+            }
+
+            Directory.CreateDirectory(directory);
+            return directory;
+        }
+
+        internal static string CopyInputs(string fixtureName, string targetName)
+        {
+            string target = FreshDirectory(targetName);
+            foreach (string file in Directory.GetFiles(FixtureInput(fixtureName)))
+            {
+                File.Copy(file, Path.Combine(target, Path.GetFileName(file)));
+            }
+
+            return target;
+        }
+
+        /// <summary>
+        /// Golden-master files are stored with LF endings while the batch emits the host's
+        /// <see cref="Environment.NewLine"/>, exactly as the legacy application did. Comparisons
+        /// against the stored masters therefore normalize endings; byte-for-byte equality is
+        /// asserted separately between reruns on the same host.
+        /// </summary>
+        internal static string NormalizeNewLines(string value)
+        {
+            return value.Replace("\r\n", "\n", StringComparison.Ordinal);
+        }
+
+        internal static string ReadNormalized(string path)
+        {
+            return NormalizeNewLines(File.ReadAllText(path));
+        }
+
+        /// <summary>Walks up from the test binaries to the candidate root.</summary>
+        internal static string CandidateRoot()
+        {
+            var directory = new DirectoryInfo(AppContext.BaseDirectory);
+            while (directory != null)
+            {
+                if (File.Exists(Path.Combine(directory.FullName, "benchmark-adapter.json")))
+                {
+                    return directory.FullName;
+                }
+
+                directory = directory.Parent;
+            }
+
+            throw new InvalidOperationException("benchmark-adapter.json was not found above " + AppContext.BaseDirectory + ".");
+        }
+    }
+}
