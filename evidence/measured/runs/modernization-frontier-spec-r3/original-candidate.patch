+++ b/src/TradeReconciliation.Core/FieldNormalizer.cs
@@ -0,0 +1,22 @@
+using System;
+
+namespace TradeReconciliation
+{
+    /// <summary>
+    /// Single definition of the normalization rule shared by matching, override lookup, and
+    /// output rendering: trimmed, invariant upper case (REQ-2 / AC-2).
+    /// </summary>
+    public static class FieldNormalizer
+    {
+        public static string Normalize(string? value)
+        {
+            return (value ?? string.Empty).Trim().ToUpperInvariant();
+        }
+
+        /// <summary>Composite key used to group counterparts by account and instrument.</summary>
+        public static string BuildPairKey(string? account, string? instrument)
+        {
+            return Normalize(account) + "|" + Normalize(instrument);
+        }
+    }
+}
