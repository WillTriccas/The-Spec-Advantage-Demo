new file mode 100644
index 0000000..583fb1d
--- /dev/null
+++ b/src/TradeReconciliation.Core/Configuration/ReconciliationOptions.cs
@@ -0,0 +1,61 @@
+using System;
+using System.Globalization;
+
+namespace TradeReconciliation.Configuration
+{
+    /// <summary>
+    /// Externally configurable matching tolerances. Defaults reproduce the legacy
+    /// <c>BatchConfiguration</c> constants exactly; overriding them is opt-in.
+    /// </summary>
+    public sealed class ReconciliationOptions
+    {
+        public const string PositionQuantityToleranceVariable = "TRADERECON_POSITION_QUANTITY_TOLERANCE";
+        public const string SettlementQuantityToleranceVariable = "TRADERECON_SETTLEMENT_QUANTITY_TOLERANCE";
+        public const string SettlementAmountToleranceVariable = "TRADERECON_SETTLEMENT_AMOUNT_TOLERANCE";
+
+        public static readonly ReconciliationOptions Default = new ReconciliationOptions();
+
+        /// <summary>Inclusive absolute tolerance between trade and position quantity.</summary>
+        public decimal PositionQuantityTolerance { get; init; } = 0.01m;
+
+        /// <summary>Inclusive absolute tolerance between trade and settlement quantity.</summary>
+        public decimal SettlementQuantityTolerance { get; init; } = 0.02m;
+
+        /// <summary>Inclusive absolute tolerance between trade net amount and settlement cash amount.</summary>
+        public decimal SettlementAmountTolerance { get; init; } = 5.00m;
+
+        /// <summary>
+        /// Reads tolerance overrides from the process environment. Unset variables keep the
+        /// legacy defaults; a present but unusable value fails fast (NFR-3).
+        /// </summary>
+        public static ReconciliationOptions FromEnvironment(Func<string, string?>? readVariable = null)
+        {
+            Func<string, string?> read = readVariable ?? Environment.GetEnvironmentVariable;
+            ReconciliationOptions defaults = Default;
+
+            return new ReconciliationOptions
+            {
+                PositionQuantityTolerance = ReadTolerance(read, PositionQuantityToleranceVariable, defaults.PositionQuantityTolerance),
+                SettlementQuantityTolerance = ReadTolerance(read, SettlementQuantityToleranceVariable, defaults.SettlementQuantityTolerance),
+                SettlementAmountTolerance = ReadTolerance(read, SettlementAmountToleranceVariable, defaults.SettlementAmountTolerance)
+            };
+        }
+
+        private static decimal ReadTolerance(Func<string, string?> read, string variableName, decimal fallback)
+        {
+            string? raw = read(variableName);
+            if (string.IsNullOrWhiteSpace(raw))
+            {
+                return fallback;
+            }
+
+            if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsed) || parsed < 0m)
+            {
+                throw new ReconciliationConfigurationException(
+                    variableName + " must be a non-negative invariant-culture decimal.");
+            }
+
+            return parsed;
+        }
+    }
+}
