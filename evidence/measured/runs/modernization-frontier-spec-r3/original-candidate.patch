+using System;
+using System.Collections.Generic;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Abstractions
+{
+    /// <summary>Applies the reconciliation business rules to already-loaded records.</summary>
+    public interface IReconciliationEngine
+    {
+        ReconciliationResult Reconcile(
+            IReadOnlyList<TradeRecord> trades,
+            IReadOnlyList<PositionRecord> positions,
+            IReadOnlyList<SettlementRecord> settlements,
+            IReadOnlyList<ManualOverrideRecord> overrides);
+    }
+
+    /// <summary>Reads the four input files and writes the three result files.</summary>
+    public interface IReconciliationFileGateway
+    {
+        IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory);
+
+        IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory);
+
+        IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory);
+
+        IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory);
+
+        void WriteMatchedTrades(string outputDirectory, IReadOnlyList<MatchedTradeRecord> matchedTrades);
+
+        void WriteBreakQueue(string outputDirectory, IReadOnlyList<BreakRecord> breakQueue);
+
+        void WriteEndOfDayReport(string outputDirectory, string reportText);
+
+        bool ResultFilesExist(string outputDirectory);
+    }
+
+    /// <summary>Renders the deterministic end-of-day report text.</summary>
+    public interface IEndOfDayReporter
+    {
+        string BuildReport(DateTime businessDate, ReconciliationResult result);
+    }
+
+    /// <summary>Append-only history of executed runs, used for idempotent rerun detection (INV-4).</summary>
+    public interface IRunLedgerStore
+    {
+        bool Contains(DateTime businessDate, string inputSignature);
+
+        void AppendIfMissing(RunLedgerEntry entry);
+    }
+
+    /// <summary>Computes a stable fingerprint of the business date plus every input file.</summary>
+    public interface IInputSignatureCalculator
+    {
+        string Calculate(DateTime businessDate, string inputDirectory);
+    }
+
+    /// <summary>
+    /// Operational diagnostics sink. Implementations must only ever receive dates, identifiers,
+    /// and counts - never full record payloads (NFR-5).
+    /// </summary>
+    public interface IBatchLogger
+    {
+        void Info(string message);
+
+        void Error(string message);
+    }
+}
