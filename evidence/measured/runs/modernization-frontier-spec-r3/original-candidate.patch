+using System;
+
+namespace TradeReconciliation.Configuration
+{
+    /// <summary>
+    /// Base type for operator-actionable failures. Messages are intentionally limited to file
+    /// names, positions, and counts so that no trade, position, settlement, or override payload
+    /// is ever written to a log or console (NFR-5).
+    /// </summary>
+    public class ReconciliationException : Exception
+    {
+        public ReconciliationException(string message)
+            : base(message)
+        {
+        }
+
+        public ReconciliationException(string message, Exception innerException)
+            : base(message, innerException)
+        {
+        }
+    }
+
+    /// <summary>Raised when command-line arguments cannot be turned into a run request.</summary>
+    public sealed class ReconciliationArgumentException : ReconciliationException
+    {
+        public ReconciliationArgumentException(string message)
+            : base(message)
+        {
+        }
+    }
+
+    /// <summary>Raised when an input file is missing, unreadable, or malformed.</summary>
+    public sealed class ReconciliationInputException : ReconciliationException
+    {
+        public ReconciliationInputException(string message)
+            : base(message)
+        {
+        }
+
+        public ReconciliationInputException(string message, Exception innerException)
+            : base(message, innerException)
+        {
+        }
+    }
+
+    /// <summary>Raised when externally supplied configuration cannot be used.</summary>
+    public sealed class ReconciliationConfigurationException : ReconciliationException
+    {
+        public ReconciliationConfigurationException(string message)
+            : base(message)
+        {
+        }
+    }
+}
