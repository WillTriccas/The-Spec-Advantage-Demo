+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Io
+{
+    /// <summary>
+    /// Reads and writes the legacy flat CSV schemas. Values never contain quoting or embedded
+    /// separators - a row with an unexpected cell count is rejected rather than guessed at - so
+    /// the writer keeps the legacy naive join and produces byte-identical files.
+    /// </summary>
+    public sealed class CsvFileGateway : IReconciliationFileGateway
+    {
+        public const string MatchedTradesHeader =
+            "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+
+        public const string BreakQueueHeader =
+            "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+        public IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory)
+        {
+            return ReadRecords(inputDirectory, BatchFileNames.Trades, required: true, (cells, _) => new TradeRecord
+            {
+                TradeId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = ParseDecimal(cells[3]),
+                SettlementDate = ParseDate(cells[4]),
+                Currency = cells[5],
+                NetAmount = ParseDecimal(cells[6])
+            }, expectedCellCount: 7);
+        }
+
+        public IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory)
+        {
+            return ReadRecords(inputDirectory, BatchFileNames.Positions, required: true, (cells, _) => new PositionRecord
+            {
+                PositionId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = ParseDecimal(cells[3]),
+                SettlementDate = ParseDate(cells[4]),
+                Currency = cells[5]
+            }, expectedCellCount: 6);
+        }
+
+        public IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory)
+        {
+            return ReadRecords(inputDirectory, BatchFileNames.Settlements, required: true, (cells, _) => new SettlementRecord
+            {
+                SettlementId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = ParseDecimal(cells[3]),
+                SettlementDate = ParseDate(cells[4]),
+                Currency = cells[5],
+                CashAmount = ParseDecimal(cells[6])
+            }, expectedCellCount: 7);
+        }
+
+        /// <summary>Overrides are optional; an absent file simply means "no instructions".</summary>
+        public IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory)
+        {
+            return ReadRecords(inputDirectory, BatchFileNames.Overrides, required: false, (cells, _) => new ManualOverrideRecord
+            {
+                TradeId = cells[0],
+                Action = cells[1],
+                Note = cells[2],
+                ApprovedBy = cells[3]
+            }, expectedCellCount: 4);
+        }
+
+        public void WriteMatchedTrades(string outputDirectory, IReadOnlyList<MatchedTradeRecord> matchedTrades)
+        {
+            ArgumentNullException.ThrowIfNull(matchedTrades);
+
+            var lines = new List<string> { MatchedTradesHeader };
+            lines.AddRange(matchedTrades
+                .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+                .Select(record => string.Join(
+                    ",",
+                    record.TradeId,
+                    record.Status,
+                    record.Account,
+                    record.Instrument,
+                    FormatDecimal(record.Quantity),
+                    FormatDate(record.SettlementDate),
+                    record.Currency,
+                    record.PositionId ?? string.Empty,
+                    record.SettlementId ?? string.Empty,
+                    record.OverrideNote ?? string.Empty)));
+
+            File.WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades), lines);
+        }
+
+        public void WriteBreakQueue(string outputDirectory, IReadOnlyList<BreakRecord> breakQueue)
+        {
+            ArgumentNullException.ThrowIfNull(breakQueue);
+
+            var lines = new List<string> { BreakQueueHeader };
+            lines.AddRange(breakQueue
+                .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+                .ThenBy(record => record.Reasons, StringComparer.Ordinal)
+                .Select(record => string.Join(
+                    ",",
+                    record.TradeId,
+                    record.Account,
+                    record.Instrument,
+                    FormatDecimal(record.Quantity),
+                    FormatDate(record.SettlementDate),
+                    record.Currency,
+                    record.Reasons,
+                    record.PositionId ?? string.Empty,
+                    record.SettlementId ?? string.Empty)));
+
+            File.WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.BreakQueue), lines);
+        }
+
+        public void WriteEndOfDayReport(string outputDirectory, string reportText)
+        {
+            File.WriteAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport), reportText);
+        }
+
+        public bool ResultFilesExist(string outputDirectory)
+        {
+            return File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)) &&
+                   File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)) &&
+                   File.Exists(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport));
+        }
+
+        private static List<TRecord> ReadRecords<TRecord>(
+            string inputDirectory,
+            string fileName,
+            bool required,
+            Func<string[], int, TRecord> project,
+            int expectedCellCount)
+        {
+            string path = Path.Combine(inputDirectory, fileName);
+            if (!File.Exists(path))
+            {
+                if (!required)
+                {
+                    return new List<TRecord>();
+                }
+
+                throw new ReconciliationInputException("Required input file '" + fileName + "' was not found in '" + inputDirectory + "'.");
+            }
+
+            string[] lines;
+            try
+            {
+                lines = File.ReadAllLines(path);
+            }
+            catch (IOException exception)
+            {
+                throw new ReconciliationInputException("Input file '" + fileName + "' could not be read.", exception);
+            }
+
+            var records = new List<TRecord>(Math.Max(0, lines.Length - 1));
+
+            // Row 1 is the header; blank rows are ignored exactly as the legacy batch did.
+            for (int index = 1; index < lines.Length; index++)
+            {
+                string line = lines[index];
+                if (string.IsNullOrWhiteSpace(line))
+                {
+                    continue;
+                }
+
+                int lineNumber = index + 1;
+                string[] cells = SplitCells(line, expectedCellCount, fileName, lineNumber);
+
+                try
+                {
+                    records.Add(project(cells, lineNumber));
+                }
+                catch (FormatException exception)
+                {
+                    // Diagnostics deliberately omit the row payload (NFR-5).
+                    throw new ReconciliationInputException(
+                        "Input file '" + fileName + "' line " + lineNumber.ToString(CultureInfo.InvariantCulture) +
+                        " contains a value that is not a valid invariant-culture number or yyyy-MM-dd date.",
+                        exception);
+                }
+            }
+
+            return records;
+        }
+
+        private static string[] SplitCells(string line, int expectedCellCount, string fileName, int lineNumber)
+        {
+            string[] cells = line.Split(',');
+            if (cells.Length != expectedCellCount)
+            {
+                throw new ReconciliationInputException(
+                    "Input file '" + fileName + "' line " + lineNumber.ToString(CultureInfo.InvariantCulture) +
+                    " has " + cells.Length.ToString(CultureInfo.InvariantCulture) +
+                    " columns but " + expectedCellCount.ToString(CultureInfo.InvariantCulture) + " were expected.");
+            }
+
+            for (int index = 0; index < cells.Length; index++)
+            {
+                cells[index] = cells[index].Trim();
+            }
+
+            return cells;
+        }
+
+        private static decimal ParseDecimal(string value)
+        {
+            return decimal.Parse(value, NumberStyles.Number | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture);
+        }
+
+        private static DateTime ParseDate(string value)
+        {
+            return DateTime.ParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+        }
+
+        internal static string FormatDecimal(decimal value)
+        {
+            return value.ToString("0.####", CultureInfo.InvariantCulture);
+        }
+
+        internal static string FormatDate(DateTime value)
+        {
+            return value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+        }
+    }
+}
diff --git a/src/TradeReconciliation.Core/Ledger/RunLedgerStore.cs b/src/TradeReconciliation.Core/Ledger/RunLedgerStore.cs
new file mode 100644
index 0000000..50af7bd
--- /dev/null
+++ b/src/TradeReconciliation.Core/Ledger/RunLedgerStore.cs
@@ -0,0 +1,128 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Ledger
+{
+    /// <summary>
+    /// Append-only <c>run-ledger.csv</c>. INV-4: an identical rerun must never add a second row.
+    /// </summary>
+    public sealed class RunLedgerStore : IRunLedgerStore
+    {
+        public const string Header = "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+        private readonly string _ledgerPath;
+
+        public RunLedgerStore(string ledgerPath)
+        {
+            if (string.IsNullOrWhiteSpace(ledgerPath))
+            {
+                throw new ArgumentException("A ledger path is required.", nameof(ledgerPath));
+            }
+
+            _ledgerPath = ledgerPath;
+        }
+
+        public static RunLedgerStore ForOutputDirectory(string outputDirectory)
+        {
+            return new RunLedgerStore(Path.Combine(outputDirectory, BatchFileNames.RunLedger));
+        }
+
+        public bool Contains(DateTime businessDate, string inputSignature)
+        {
+            foreach (RunLedgerEntry entry in LoadEntries())
+            {
+                if (entry.BusinessDate == businessDate &&
+                    string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        public void AppendIfMissing(RunLedgerEntry entry)
+        {
+            ArgumentNullException.ThrowIfNull(entry);
+
+            if (Contains(entry.BusinessDate, entry.InputSignature))
+            {
+                return;
+            }
+
+            bool fileExists = File.Exists(_ledgerPath);
+            using (var writer = new StreamWriter(_ledgerPath, append: true))
+            {
+                if (!fileExists)
+                {
+                    writer.WriteLine(Header);
+                }
+
+                writer.WriteLine(string.Join(
+                    ",",
+                    entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+                    entry.InputSignature,
+                    entry.TotalTradesRead.ToString(CultureInfo.InvariantCulture),
+                    entry.OpenBreakCount.ToString(CultureInfo.InvariantCulture),
+                    entry.MatchedCount.ToString(CultureInfo.InvariantCulture)));
+            }
+        }
+
+        private List<RunLedgerEntry> LoadEntries()
+        {
+            var entries = new List<RunLedgerEntry>();
+            if (!File.Exists(_ledgerPath))
+            {
+                return entries;
+            }
+
+            string[] lines = File.ReadAllLines(_ledgerPath);
+            for (int index = 1; index < lines.Length; index++)
+            {
+                string line = lines[index];
+                if (string.IsNullOrWhiteSpace(line))
+                {
+                    continue;
+                }
+
+                entries.Add(ParseEntry(line, index + 1));
+            }
+
+            return entries;
+        }
+
+        private static RunLedgerEntry ParseEntry(string line, int lineNumber)
+        {
+            string[] cells = line.Split(',');
+            if (cells.Length != 5)
+            {
+                throw new ReconciliationInputException(
+                    "Run ledger line " + lineNumber.ToString(CultureInfo.InvariantCulture) +
+                    " has " + cells.Length.ToString(CultureInfo.InvariantCulture) + " columns but 5 were expected.");
+            }
+
+            try
+            {
+                return new RunLedgerEntry
+                {
+                    BusinessDate = DateTime.ParseExact(cells[0], "yyyy-MM-dd", CultureInfo.InvariantCulture),
+                    InputSignature = cells[1],
+                    TotalTradesRead = int.Parse(cells[2], CultureInfo.InvariantCulture),
+                    OpenBreakCount = int.Parse(cells[3], CultureInfo.InvariantCulture),
+                    MatchedCount = int.Parse(cells[4], CultureInfo.InvariantCulture)
+                };
+            }
+            catch (FormatException exception)
+            {
+                throw new ReconciliationInputException(
+                    "Run ledger line " + lineNumber.ToString(CultureInfo.InvariantCulture) + " is malformed.",
+                    exception);
+            }
+        }
+    }
+}
diff --git a/src/TradeReconciliation.Core/Matching/MatchingEngine.cs b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
new file mode 100644
index 0000000..325778e
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
@@ -0,0 +1,394 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Matching
+{
+    /// <summary>
+    /// Pure, file-free implementation of the reconciliation rules. Every behaviour documented in
+    /// the brownfield discovery is preserved verbatim; only the structure around it changed.
+    /// </summary>
+    public sealed class MatchingEngine : IReconciliationEngine
+    {
+        private readonly ReconciliationOptions _options;
+
+        public MatchingEngine()
+            : this(ReconciliationOptions.Default)
+        {
+        }
+
+        public MatchingEngine(ReconciliationOptions options)
+        {
+            _options = options ?? throw new ArgumentNullException(nameof(options));
+        }
+
+        public ReconciliationResult Reconcile(
+            IReadOnlyList<TradeRecord> trades,
+            IReadOnlyList<PositionRecord> positions,
+            IReadOnlyList<SettlementRecord> settlements,
+            IReadOnlyList<ManualOverrideRecord> overrides)
+        {
+            ArgumentNullException.ThrowIfNull(trades);
+            ArgumentNullException.ThrowIfNull(positions);
+            ArgumentNullException.ThrowIfNull(settlements);
+            ArgumentNullException.ThrowIfNull(overrides);
+
+            var matchedTrades = new List<MatchedTradeRecord>();
+            var breakQueue = new List<BreakRecord>();
+
+            // Reference identity (not value equality) is required throughout: two override rows
+            // with identical text are separate instructions and must be accounted for separately.
+            var staleOverrides = new List<ManualOverrideRecord>();
+
+            List<IGrouping<string, ManualOverrideRecord>> overrideGroups = overrides
+                .GroupBy(record => FieldNormalizer.Normalize(record.TradeId), StringComparer.Ordinal)
+                .ToList();
+
+            // AMB-2 / AC-7: only the first instruction per trade may apply; the rest are stale.
+            Dictionary<string, ManualOverrideRecord> overrideMap = overrideGroups
+                .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
+            staleOverrides.AddRange(overrideGroups.SelectMany(group => group.Skip(1)));
+
+            Dictionary<string, List<PositionRecord>> positionsByPair = positions
+                .GroupBy(position => FieldNormalizer.BuildPairKey(position.Account, position.Instrument), StringComparer.Ordinal)
+                .ToDictionary(
+                    group => group.Key,
+                    group => group.OrderBy(position => position.PositionId, StringComparer.Ordinal).ToList(),
+                    StringComparer.Ordinal);
+
+            Dictionary<string, List<SettlementRecord>> settlementsByPair = settlements
+                .GroupBy(settlement => FieldNormalizer.BuildPairKey(settlement.Account, settlement.Instrument), StringComparer.Ordinal)
+                .ToDictionary(
+                    group => group.Key,
+                    group => group.OrderBy(settlement => settlement.SettlementId, StringComparer.Ordinal).ToList(),
+                    StringComparer.Ordinal);
+
+            var usedPositions = new HashSet<string>(StringComparer.Ordinal);
+            var usedSettlements = new HashSet<string>(StringComparer.Ordinal);
+            var seenTradeIds = new HashSet<string>(StringComparer.Ordinal);
+            int duplicateTradeCount = 0;
+
+            foreach (TradeRecord trade in trades)
+            {
+                string normalizedTradeId = FieldNormalizer.Normalize(trade.TradeId);
+
+                // INV-1 / AC-3: the first occurrence is canonical, later ones are breaks.
+                if (!seenTradeIds.Add(normalizedTradeId))
+                {
+                    duplicateTradeCount++;
+                    breakQueue.Add(CreateBreak(trade, BreakReason.DuplicateTradeId, null, null, canManualOverride: false));
+                    continue;
+                }
+
+                // AC-5: non-positive quantity or net amount is always a break.
+                if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+                {
+                    breakQueue.Add(CreateBreak(trade, BreakReason.TradeValueOutOfBounds, null, null, canManualOverride: false));
+                    continue;
+                }
+
+                string pairKey = FieldNormalizer.BuildPairKey(trade.Account, trade.Instrument);
+                PositionRecord? position = null;
+                SettlementRecord? settlement = null;
+                var reasons = new List<string>();
+
+                if (!positionsByPair.TryGetValue(pairKey, out List<PositionRecord>? positionCandidates))
+                {
+                    reasons.Add(BreakReason.MissingPosition);
+                }
+                else
+                {
+                    position = FindPosition(trade, positionCandidates, usedPositions, reasons);
+                }
+
+                if (!settlementsByPair.TryGetValue(pairKey, out List<SettlementRecord>? settlementCandidates))
+                {
+                    reasons.Add(BreakReason.MissingSettlement);
+                }
+                else
+                {
+                    settlement = FindSettlement(trade, settlementCandidates, usedSettlements, reasons);
+                }
+
+                if (reasons.Count == 0 && position != null && settlement != null)
+                {
+                    usedPositions.Add(position.PositionId);
+                    usedSettlements.Add(settlement.SettlementId);
+                    matchedTrades.Add(CreateMatchedTrade(trade, MatchStatus.Matched, position.PositionId, settlement.SettlementId, null));
+                    continue;
+                }
+
+                breakQueue.Add(CreateBreak(
+                    trade,
+                    string.Join("|", reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal)),
+                    position != null ? position.PositionId : GetNearestPositionId(trade, positionCandidates),
+                    settlement != null ? settlement.SettlementId : GetNearestSettlementId(trade, settlementCandidates),
+                    positionCandidates != null &&
+                        settlementCandidates != null &&
+                        reasons.All(reason =>
+                            reason != BreakReason.MissingPosition &&
+                            reason != BreakReason.MissingSettlement &&
+                            reason != BreakReason.DuplicateTradeId &&
+                            reason != BreakReason.TradeValueOutOfBounds)));
+            }
+
+            ApplyManualOverrides(overrideMap, breakQueue, matchedTrades, staleOverrides, overrides);
+
+            return new ReconciliationResult
+            {
+                MatchedTrades = matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                OpenBreaks = breakQueue.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                StaleOverrides = staleOverrides.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                TotalTradesRead = trades.Count,
+                CanonicalTradeCount = seenTradeIds.Count,
+                DuplicateTradeCount = duplicateTradeCount,
+                MatchedCount = matchedTrades.Count(record => record.Status == MatchStatus.Matched),
+                ManualOverrideMatchedCount = matchedTrades.Count(record => record.Status == MatchStatus.ManualOverrideMatched),
+                ManualOverrideSuppressedCount = matchedTrades.Count(record => record.Status == MatchStatus.ManualOverrideSuppressed)
+            };
+        }
+
+        /// <summary>
+        /// INV-3: overrides may only resolve breaks that already carry concrete counterpart
+        /// candidates; anything else stays a visible break and the instruction becomes stale.
+        /// </summary>
+        private static void ApplyManualOverrides(
+            Dictionary<string, ManualOverrideRecord> overrideMap,
+            List<BreakRecord> breakQueue,
+            List<MatchedTradeRecord> matchedTrades,
+            List<ManualOverrideRecord> staleOverrides,
+            IReadOnlyList<ManualOverrideRecord> overrides)
+        {
+            var resolvedTrades = new HashSet<string>(StringComparer.Ordinal);
+
+            foreach (BreakRecord breakRecord in breakQueue.ToList())
+            {
+                if (!overrideMap.TryGetValue(FieldNormalizer.Normalize(breakRecord.TradeId), out ManualOverrideRecord? manualOverride))
+                {
+                    continue;
+                }
+
+                resolvedTrades.Add(FieldNormalizer.Normalize(breakRecord.TradeId));
+
+                if (!breakRecord.CanManualOverride ||
+                    string.IsNullOrWhiteSpace(manualOverride.Note) ||
+                    string.IsNullOrWhiteSpace(manualOverride.ApprovedBy))
+                {
+                    staleOverrides.Add(manualOverride);
+                    continue;
+                }
+
+                string action = FieldNormalizer.Normalize(manualOverride.Action);
+                string? status = action switch
+                {
+                    OverrideAction.ForceMatch => MatchStatus.ManualOverrideMatched,
+                    OverrideAction.SuppressBreak => MatchStatus.ManualOverrideSuppressed,
+                    _ => null
+                };
+
+                if (status == null)
+                {
+                    staleOverrides.Add(manualOverride);
+                    continue;
+                }
+
+                // The suppressed/forced break stays evidenced in matched-trades.csv.
+                matchedTrades.Add(new MatchedTradeRecord
+                {
+                    TradeId = FieldNormalizer.Normalize(breakRecord.TradeId),
+                    Status = status,
+                    Account = FieldNormalizer.Normalize(breakRecord.Account),
+                    Instrument = FieldNormalizer.Normalize(breakRecord.Instrument),
+                    Quantity = breakRecord.Quantity,
+                    SettlementDate = breakRecord.SettlementDate,
+                    Currency = FieldNormalizer.Normalize(breakRecord.Currency),
+                    PositionId = breakRecord.PositionId,
+                    SettlementId = breakRecord.SettlementId,
+                    OverrideNote = manualOverride.Note
+                });
+
+                breakQueue.Remove(breakRecord);
+            }
+
+            // Any instruction that never met a break of its own is surfaced rather than dropped.
+            List<ManualOverrideRecord> unmatchedInstructions = overrides
+                .Where(record =>
+                    !resolvedTrades.Contains(FieldNormalizer.Normalize(record.TradeId)) &&
+                    !staleOverrides.Any(existing => ReferenceEquals(existing, record)))
+                .ToList();
+
+            staleOverrides.AddRange(unmatchedInstructions);
+        }
+
+        private PositionRecord? FindPosition(
+            TradeRecord trade,
+            IEnumerable<PositionRecord> candidates,
+            ISet<string> usedPositions,
+            ICollection<string> reasons)
+        {
+            List<PositionRecord> available = candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+            if (available.Count == 0)
+            {
+                reasons.Add(BreakReason.MissingPosition);
+                return null;
+            }
+
+            // INV-2: identity compatibility is proven before any tolerance is evaluated.
+            List<PositionRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+            if (sameDate.Count == 0)
+            {
+                reasons.Add(BreakReason.PositionSettlementDateMismatch);
+                return null;
+            }
+
+            List<PositionRecord> sameCurrency = sameDate
+                .Where(candidate => FieldNormalizer.Normalize(candidate.Currency) == FieldNormalizer.Normalize(trade.Currency))
+                .ToList();
+            if (sameCurrency.Count == 0)
+            {
+                reasons.Add(BreakReason.PositionCurrencyMismatch);
+                return null;
+            }
+
+            PositionRecord candidatePosition = sameCurrency
+                .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+                .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+                .First();
+
+            if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+            {
+                reasons.Add(BreakReason.PositionQuantitySignMismatch);
+                return null;
+            }
+
+            // AC-4: inclusive (closed interval) comparison.
+            if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _options.PositionQuantityTolerance)
+            {
+                reasons.Add(BreakReason.PositionQuantityOutOfTolerance);
+                return null;
+            }
+
+            return candidatePosition;
+        }
+
+        private SettlementRecord? FindSettlement(
+            TradeRecord trade,
+            IEnumerable<SettlementRecord> candidates,
+            ISet<string> usedSettlements,
+            ICollection<string> reasons)
+        {
+            List<SettlementRecord> available = candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+            if (available.Count == 0)
+            {
+                reasons.Add(BreakReason.MissingSettlement);
+                return null;
+            }
+
+            List<SettlementRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+            if (sameDate.Count == 0)
+            {
+                reasons.Add(BreakReason.SettlementDateMismatch);
+                return null;
+            }
+
+            List<SettlementRecord> sameCurrency = sameDate
+                .Where(candidate => FieldNormalizer.Normalize(candidate.Currency) == FieldNormalizer.Normalize(trade.Currency))
+                .ToList();
+            if (sameCurrency.Count == 0)
+            {
+                reasons.Add(BreakReason.SettlementCurrencyMismatch);
+                return null;
+            }
+
+            SettlementRecord candidateSettlement = sameCurrency
+                .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+                .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+                .First();
+
+            if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+            {
+                reasons.Add(BreakReason.SettlementQuantitySignMismatch);
+                return null;
+            }
+
+            if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _options.SettlementQuantityTolerance)
+            {
+                reasons.Add(BreakReason.SettlementQuantityOutOfTolerance);
+                return null;
+            }
+
+            if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _options.SettlementAmountTolerance)
+            {
+                reasons.Add(BreakReason.SettlementAmountOutOfTolerance);
+                return null;
+            }
+
+            return candidateSettlement;
+        }
+
+        private static string? GetNearestPositionId(TradeRecord trade, IEnumerable<PositionRecord>? candidates)
+        {
+            return candidates?
+                .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+                .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+                .Select(candidate => candidate.PositionId)
+                .FirstOrDefault();
+        }
+
+        private static string? GetNearestSettlementId(TradeRecord trade, IEnumerable<SettlementRecord>? candidates)
+        {
+            return candidates?
+                .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+                .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+                .Select(candidate => candidate.SettlementId)
+                .FirstOrDefault();
+        }
+
+        private static BreakRecord CreateBreak(
+            TradeRecord trade,
+            string reasons,
+            string? positionId,
+            string? settlementId,
+            bool canManualOverride)
+        {
+            return new BreakRecord
+            {
+                TradeId = FieldNormalizer.Normalize(trade.TradeId),
+                Account = FieldNormalizer.Normalize(trade.Account),
+                Instrument = FieldNormalizer.Normalize(trade.Instrument),
+                Quantity = trade.Quantity,
+                SettlementDate = trade.SettlementDate,
+                Currency = FieldNormalizer.Normalize(trade.Currency),
+                Reasons = reasons,
+                PositionId = positionId,
+                SettlementId = settlementId,
+                CanManualOverride = canManualOverride
+            };
+        }
+
+        private static MatchedTradeRecord CreateMatchedTrade(
+            TradeRecord trade,
+            string status,
+            string? positionId,
+            string? settlementId,
+            string? note)
+        {
+            return new MatchedTradeRecord
+            {
+                TradeId = FieldNormalizer.Normalize(trade.TradeId),
+                Status = status,
+                Account = FieldNormalizer.Normalize(trade.Account),
+                Instrument = FieldNormalizer.Normalize(trade.Instrument),
+                Quantity = trade.Quantity,
+                SettlementDate = trade.SettlementDate,
+                Currency = FieldNormalizer.Normalize(trade.Currency),
+                PositionId = positionId,
+                SettlementId = settlementId,
+                OverrideNote = note
+            };
+        }
+    }
+}
