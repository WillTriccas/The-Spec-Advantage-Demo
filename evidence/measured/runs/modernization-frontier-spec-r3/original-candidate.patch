+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using TradeReconciliation.Batch;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Diagnostics;
+using TradeReconciliation.Tests.Framework;
+
+namespace TradeReconciliation.Tests
+{
+    /// <summary>
+    /// Locks the external contract: positional CLI arguments, documented exit codes, and the
+    /// benchmark adapter that external evaluation drives the candidate through.
+    /// </summary>
+    public static class ContractTests
+    {
+        [TestCase("REQ-1 / AC-1")]
+        public static void CandidateTargetsNet8()
+        {
+            Assert.Contains(
+                System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription,
+                ".NET 8.",
+                "The candidate must build and run on .NET 8.");
+        }
+
+        [TestCase("REQ-1 / AC-10")]
+        public static void AdapterDeclaresShellFreeCommandsPlaceholdersAndOutputs()
+        {
+            string adapterPath = Path.Combine(TestSupport.CandidateRoot(), "benchmark-adapter.json");
+            using JsonDocument document = JsonDocument.Parse(File.ReadAllText(adapterPath));
+            JsonElement root = document.RootElement;
+
+            Assert.AreEqual("1.0.0", root.GetProperty("schemaVersion").GetString(), "The adapter schema version must be preserved.");
+            Assert.AreEqual(".", root.GetProperty("workingDirectory").GetString(), "Commands are relative to the candidate root.");
+
+            foreach (string section in new[] { "build", "test", "run" })
+            {
+                JsonElement command = root.GetProperty(section);
+                string executable = command.GetProperty("executable").GetString() ?? string.Empty;
+
+                Assert.IsTrue(executable.Length > 0, section + " must declare an executable.");
+                AssertShellFree(executable, section + " executable");
+
+                foreach (JsonElement argument in command.GetProperty("arguments").EnumerateArray())
+                {
+                    AssertShellFree(argument.GetString() ?? string.Empty, section + " argument");
+                }
+
+                Assert.IsTrue(
+                    command.GetProperty("allowedExitCodes").EnumerateArray().Any(code => code.GetInt32() == 0),
+                    section + " must accept the documented success exit code.");
+            }
+
+            List<string> runArguments = root.GetProperty("run").GetProperty("arguments")
+                .EnumerateArray()
+                .Select(argument => argument.GetString() ?? string.Empty)
+                .ToList();
+
+            foreach (string placeholder in new[] { "{businessDate}", "{inputDirectory}", "{outputDirectory}" })
+            {
+                Assert.IsTrue(runArguments.Contains(placeholder), "The run command must substitute " + placeholder + ".");
+            }
+
+            List<string> outputs = root.GetProperty("outputs")
+                .EnumerateArray()
+                .Select(output => output.GetString() ?? string.Empty)
+                .ToList();
+
+            foreach (string fileName in new[]
+            {
+                BatchFileNames.MatchedTrades,
+                BatchFileNames.BreakQueue,
+                BatchFileNames.EndOfDayReport,
+                BatchFileNames.RunLedger
+            })
+            {
+                Assert.IsTrue(outputs.Contains(fileName), "The adapter must declare " + fileName + ".");
+            }
+
+            Assert.AreEqual(4, outputs.Count, "Exactly the four contract outputs are declared.");
+        }
+
+        [TestCase("REQ-1 / AC-10")]
+        public static void AdapterExecutablesResolveToBuiltArtifacts()
+        {
+            string candidateRoot = TestSupport.CandidateRoot();
+            using JsonDocument document = JsonDocument.Parse(File.ReadAllText(Path.Combine(candidateRoot, "benchmark-adapter.json")));
+
+            foreach (string section in new[] { "test", "run" })
+            {
+                string? assemblyArgument = document.RootElement.GetProperty(section).GetProperty("arguments")
+                    .EnumerateArray()
+                    .Select(argument => argument.GetString())
+                    .FirstOrDefault(argument => argument != null && argument.EndsWith(".dll", StringComparison.Ordinal));
+
+                Assert.IsTrue(assemblyArgument != null, "The " + section + " command must point at a built assembly.");
+                Assert.IsTrue(
+                    File.Exists(Path.Combine(candidateRoot, assemblyArgument!.Replace('/', Path.DirectorySeparatorChar))),
+                    "The " + section + " assembly must exist after a Release build: " + assemblyArgument);
+            }
+        }
+
+        [TestCase("REQ-1 / AMB-1")]
+        public static void PositionalArgumentsAreResolvedAndValidated()
+        {
+            RunRequest request = RunRequest.Resolve(new[] { "2025-03-17", ".", "." });
+            Assert.AreEqual("2025-03-17", request.FormattedBusinessDate, "The business date is positional argument one.");
+
+            Assert.Throws<ReconciliationArgumentException>(
+                () => RunRequest.Resolve(new[] { "2025-03-17", "." }),
+                "Two arguments are not a valid invocation.");
+            Assert.Throws<ReconciliationArgumentException>(
+                () => RunRequest.Resolve(new[] { "17/03/2025", ".", "." }),
+                "The business date must be yyyy-MM-dd.");
+            Assert.Throws<ReconciliationArgumentException>(
+                () => RunRequest.Resolve(new[] { "2025-03-17", "  ", "." }),
+                "An empty directory argument is rejected.");
+
+            RunRequest fallback = RunRequest.Resolve(Array.Empty<string>());
+            Assert.Contains(fallback.InputDirectory, "sample", "No arguments keeps the bundled sample behaviour.");
+        }
+
+        [TestCase("REQ-7 / NFR-3")]
+        public static void CliReturnsDocumentedExitCodes()
+        {
+            var successLogger = new RecordingBatchLogger();
+            string outputDirectory = TestSupport.FreshDirectory("cli-success");
+            int success = Cli.Program.Run(
+                new[] { "2025-03-17", TestSupport.FixtureInput("baseline"), outputDirectory },
+                successLogger);
+
+            Assert.AreEqual(Cli.Program.SuccessExitCode, success, "A healthy run exits with the success code.");
+            Assert.AreEqual(0, successLogger.ErrorMessages.Count, "A healthy run writes no error diagnostics.");
+
+            var usageLogger = new RecordingBatchLogger();
+            int usage = Cli.Program.Run(new[] { "not-a-date" }, usageLogger);
+            Assert.AreEqual(Cli.Program.InputFailureExitCode, usage, "A usage error is not success-shaped.");
+            Assert.Contains(string.Join(Environment.NewLine, usageLogger.ErrorMessages), "Usage:", "Usage guidance must be actionable.");
+
+            var inputLogger = new RecordingBatchLogger();
+            int missingInput = Cli.Program.Run(
+                new[] { "2025-03-17", Path.Combine(AppContext.BaseDirectory, "test-output", "absent"), outputDirectory },
+                inputLogger);
+            Assert.AreEqual(Cli.Program.InputFailureExitCode, missingInput, "A missing input directory is not success-shaped.");
+            Assert.Contains(string.Join(Environment.NewLine, inputLogger.ErrorMessages), "Reconciliation failed", "Failures are reported.");
+        }
+
+        [TestCase("REQ-7 / AC-9")]
+        public static void CliRerunKeepsOutputsIdenticalAndStillSucceeds()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("cli-rerun");
+            string[] args = { "2025-03-17", TestSupport.FixtureInput("override-rerun"), outputDirectory };
+
+            Assert.AreEqual(Cli.Program.SuccessExitCode, Cli.Program.Run(args, new RecordingBatchLogger()), "First run succeeds.");
+            string ledgerAfterFirst = File.ReadAllText(Path.Combine(outputDirectory, BatchFileNames.RunLedger));
+
+            Assert.AreEqual(Cli.Program.SuccessExitCode, Cli.Program.Run(args, new RecordingBatchLogger()), "Rerun also succeeds.");
+            Assert.AreEqual(
+                ledgerAfterFirst,
+                File.ReadAllText(Path.Combine(outputDirectory, BatchFileNames.RunLedger)),
+                "An exact rerun must not extend the ledger.");
+        }
+
+        private static void AssertShellFree(string value, string label)
+        {
+            foreach (char forbidden in new[] { '|', '&', ';', '>', '<', '`', '$', '\n', '\r' })
+            {
+                Assert.IsFalse(
+                    value.IndexOf(forbidden) >= 0,
+                    label + " must not contain shell metacharacters (found '" + forbidden + "' in '" + value + "').");
+            }
+        }
+    }
+}
