+using System;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Batch;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Diagnostics;
+
+namespace TradeReconciliation.Cli
+{
+    /// <summary>
+    /// Console host for the reconciliation batch.
+    /// Exit codes: 0 success (including a detected exact rerun), 2 usage/input failure,
+    /// 3 unexpected failure. Only 0 is a success-shaped outcome (NFR-3).
+    /// </summary>
+    public static class Program
+    {
+        public const int SuccessExitCode = 0;
+        public const int InputFailureExitCode = 2;
+        public const int UnexpectedFailureExitCode = 3;
+
+        public static int Main(string[] args)
+        {
+            return Run(args, new ConsoleBatchLogger());
+        }
+
+        public static int Run(string[] args, IBatchLogger logger)
+        {
+            try
+            {
+                ReconciliationOptions options = ReconciliationOptions.FromEnvironment();
+                RunRequest request = RunRequest.Resolve(args);
+                ReconciliationBatch.CreateDefault(options, logger).Run(request);
+                return SuccessExitCode;
+            }
+            catch (ReconciliationException exception)
+            {
+                logger.Error("Reconciliation failed: " + exception.Message);
+                return InputFailureExitCode;
+            }
+            catch (Exception exception)
+            {
+                // Message only: input payloads must never reach the diagnostics stream (NFR-5).
+                logger.Error("Reconciliation failed unexpectedly (" + exception.GetType().Name + "): " + exception.Message);
+                return UnexpectedFailureExitCode;
+            }
+        }
+    }
+}
