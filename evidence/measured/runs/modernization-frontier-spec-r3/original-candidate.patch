+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Io;
+using TradeReconciliation.Ledger;
+using TradeReconciliation.Matching;
+using TradeReconciliation.Reporting;
+
+namespace TradeReconciliation.Batch
+{
+    /// <summary>
+    /// Orchestrates one reconciliation run. Every collaborator is injected so the batch can be
+    /// exercised without touching the console or the real file system (NFR-2).
+    /// </summary>
+    public sealed class ReconciliationBatch
+    {
+        private readonly IReconciliationFileGateway _fileGateway;
+        private readonly IReconciliationEngine _matchingEngine;
+        private readonly IEndOfDayReporter _reporter;
+        private readonly IInputSignatureCalculator _signatureCalculator;
+        private readonly Func<string, IRunLedgerStore> _ledgerStoreFactory;
+        private readonly IBatchLogger _logger;
+
+        public ReconciliationBatch(
+            IReconciliationFileGateway fileGateway,
+            IReconciliationEngine matchingEngine,
+            IEndOfDayReporter reporter,
+            IInputSignatureCalculator signatureCalculator,
+            Func<string, IRunLedgerStore> ledgerStoreFactory,
+            IBatchLogger logger)
+        {
+            _fileGateway = fileGateway ?? throw new ArgumentNullException(nameof(fileGateway));
+            _matchingEngine = matchingEngine ?? throw new ArgumentNullException(nameof(matchingEngine));
+            _reporter = reporter ?? throw new ArgumentNullException(nameof(reporter));
+            _signatureCalculator = signatureCalculator ?? throw new ArgumentNullException(nameof(signatureCalculator));
+            _ledgerStoreFactory = ledgerStoreFactory ?? throw new ArgumentNullException(nameof(ledgerStoreFactory));
+            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
+        }
+
+        /// <summary>Builds the production wiring used by the CLI.</summary>
+        public static ReconciliationBatch CreateDefault(ReconciliationOptions options, IBatchLogger logger)
+        {
+            ArgumentNullException.ThrowIfNull(options);
+
+            return new ReconciliationBatch(
+                new CsvFileGateway(),
+                new MatchingEngine(options),
+                new EndOfDayReporter(),
+                new InputSignatureCalculator(),
+                outputDirectory => RunLedgerStore.ForOutputDirectory(outputDirectory),
+                logger);
+        }
+
+        public BatchOutcome Run(RunRequest request)
+        {
+            ArgumentNullException.ThrowIfNull(request);
+
+            if (!Directory.Exists(request.InputDirectory))
+            {
+                throw new ReconciliationInputException("Input directory '" + request.InputDirectory + "' does not exist.");
+            }
+
+            Directory.CreateDirectory(request.OutputDirectory);
+
+            string inputSignature = _signatureCalculator.Calculate(request.BusinessDate, request.InputDirectory);
+            IRunLedgerStore ledgerStore = _ledgerStoreFactory(request.OutputDirectory);
+
+            // REQ-6 / INV-4: an exact same-date rerun keeps the existing outputs untouched.
+            if (ledgerStore.Contains(request.BusinessDate, inputSignature) && _fileGateway.ResultFilesExist(request.OutputDirectory))
+            {
+                _logger.Info("Exact rerun detected for " + request.FormattedBusinessDate + ". Existing outputs were retained.");
+                return BatchOutcome.Rerun(inputSignature);
+            }
+
+            IReadOnlyList<TradeRecord> trades = _fileGateway.LoadTrades(request.InputDirectory);
+            IReadOnlyList<PositionRecord> positions = _fileGateway.LoadPositions(request.InputDirectory);
+            IReadOnlyList<SettlementRecord> settlements = _fileGateway.LoadSettlements(request.InputDirectory);
+            IReadOnlyList<ManualOverrideRecord> overrides = _fileGateway.LoadOverrides(request.InputDirectory);
+
+            ReconciliationResult result = _matchingEngine.Reconcile(trades, positions, settlements, overrides);
+
+            _fileGateway.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+            _fileGateway.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+            _fileGateway.WriteEndOfDayReport(request.OutputDirectory, _reporter.BuildReport(request.BusinessDate, result));
+
+            ledgerStore.AppendIfMissing(new RunLedgerEntry
+            {
+                BusinessDate = request.BusinessDate,
+                InputSignature = inputSignature,
+                TotalTradesRead = result.TotalTradesRead,
+                OpenBreakCount = result.OpenBreaks.Count,
+                MatchedCount = result.MatchedTrades.Count
+            });
+
+            // NFR-5: counts and dates only - never record payloads.
+            _logger.Info(string.Format(
+                CultureInfo.InvariantCulture,
+                "Processed {0} trades into {1} matched rows and {2} open breaks.",
+                result.TotalTradesRead,
+                result.MatchedTrades.Count,
+                result.OpenBreaks.Count));
+            _logger.Info(string.Format(
+                CultureInfo.InvariantCulture,
+                "business_date={0} canonical={1} duplicates={2} override_matched={3} override_suppressed={4} stale_overrides={5}",
+                request.FormattedBusinessDate,
+                result.CanonicalTradeCount,
+                result.DuplicateTradeCount,
+                result.ManualOverrideMatchedCount,
+                result.ManualOverrideSuppressedCount,
+                result.StaleOverrides.Count));
+
+            return BatchOutcome.Processed(inputSignature, result);
+        }
+    }
+
+    /// <summary>Outcome of a run, exposed so tests and hosts can assert without re-reading files.</summary>
+    public sealed class BatchOutcome
+    {
+        private BatchOutcome(bool wasRerun, string inputSignature, ReconciliationResult? result)
+        {
+            WasRerun = wasRerun;
+            InputSignature = inputSignature;
+            Result = result;
+        }
+
+        public bool WasRerun { get; }
+
+        public string InputSignature { get; }
+
+        /// <summary>Null when the run short-circuited as an exact rerun.</summary>
+        public ReconciliationResult? Result { get; }
+
+        internal static BatchOutcome Rerun(string inputSignature) => new BatchOutcome(true, inputSignature, null);
+
+        internal static BatchOutcome Processed(string inputSignature, ReconciliationResult result) =>
+            new BatchOutcome(false, inputSignature, result);
+    }
+}
