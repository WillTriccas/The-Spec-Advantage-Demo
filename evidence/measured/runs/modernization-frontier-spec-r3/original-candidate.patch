diff --git a/tests/TradeReconciliation.Tests/BatchIntegrationTests.cs b/tests/TradeReconciliation.Tests/BatchIntegrationTests.cs
new file mode 100644
index 0000000..7ea108e
--- /dev/null
+++ b/tests/TradeReconciliation.Tests/BatchIntegrationTests.cs
@@ -0,0 +1,220 @@
+using System;
+using System.IO;
+using System.Linq;
+using TradeReconciliation.Batch;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Diagnostics;
+using TradeReconciliation.Io;
+using TradeReconciliation.Ledger;
+using TradeReconciliation.Tests.Framework;
+
+namespace TradeReconciliation.Tests
+{
+    /// <summary>Golden-master and end-to-end file behaviour of a full batch run.</summary>
+    public static class BatchIntegrationTests
+    {
+        [TestCase("REQ-5 / RISK-1")]
+        public static void BaselineFixtureMatchesTheGoldenMaster()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("baseline");
+            RunFixture("baseline", outputDirectory);
+
+            Assert.AreEqual(
+                TestSupport.ReadNormalized(TestSupport.FixtureExpected("baseline", "break-queue.csv")),
+                TestSupport.ReadNormalized(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)),
+                "break-queue.csv must reproduce the legacy golden master.");
+
+            Assert.AreEqual(
+                TestSupport.ReadNormalized(TestSupport.FixtureExpected("baseline", "end-of-day-report.txt")),
+                TestSupport.ReadNormalized(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport)),
+                "end-of-day-report.txt must reproduce the legacy golden master.");
+        }
+
+        [TestCase("REQ-4 / REQ-5 / RISK-1")]
+        public static void OverrideFixtureMatchesTheGoldenMaster()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("override-rerun");
+            RunFixture("override-rerun", outputDirectory);
+
+            foreach (string fileName in new[]
+            {
+                BatchFileNames.MatchedTrades,
+                BatchFileNames.BreakQueue,
+                BatchFileNames.EndOfDayReport
+            })
+            {
+                Assert.AreEqual(
+                    TestSupport.ReadNormalized(TestSupport.FixtureExpected("override-rerun", fileName)),
+                    TestSupport.ReadNormalized(Path.Combine(outputDirectory, fileName)),
+                    fileName + " must reproduce the legacy golden master.");
+            }
+        }
+
+        [TestCase("REQ-5 / AC-8")]
+        public static void EveryRunWritesAllFourDeclaredOutputsWithStableHeaders()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("declared-outputs");
+            RunFixture("baseline", outputDirectory);
+
+            foreach (string fileName in new[]
+            {
+                BatchFileNames.MatchedTrades,
+                BatchFileNames.BreakQueue,
+                BatchFileNames.EndOfDayReport,
+                BatchFileNames.RunLedger
+            })
+            {
+                Assert.IsTrue(File.Exists(Path.Combine(outputDirectory, fileName)), fileName + " must be produced.");
+            }
+
+            Assert.AreEqual(
+                CsvFileGateway.MatchedTradesHeader,
+                File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades))[0],
+                "matched-trades.csv header is a downstream contract.");
+            Assert.AreEqual(
+                CsvFileGateway.BreakQueueHeader,
+                File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.BreakQueue))[0],
+                "break-queue.csv header is a downstream contract.");
+            Assert.AreEqual(
+                RunLedgerStore.Header,
+                File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger))[0],
+                "run-ledger.csv header is a downstream contract.");
+        }
+
+        [TestCase("REQ-6 / AC-9 / INV-4")]
+        public static void ExactRerunIsByteIdenticalAndAddsNoLedgerRow()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("rerun");
+            BatchOutcome first = RunFixture("override-rerun", outputDirectory);
+            Assert.IsFalse(first.WasRerun, "The first execution is a real run.");
+
+            byte[][] before = ReadAllDeclaredOutputs(outputDirectory);
+
+            BatchOutcome second = RunFixture("override-rerun", outputDirectory);
+            Assert.IsTrue(second.WasRerun, "The second execution must be detected as an exact rerun.");
+
+            byte[][] after = ReadAllDeclaredOutputs(outputDirectory);
+            for (int index = 0; index < before.Length; index++)
+            {
+                Assert.IsTrue(before[index].SequenceEqual(after[index]), "Declared output " + index + " must be byte-identical after a rerun.");
+            }
+
+            string[] ledger = File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger));
+            Assert.AreEqual(2, ledger.Length, "The ledger must hold exactly one header plus one run entry.");
+        }
+
+        [TestCase("REQ-6 / INV-4")]
+        public static void ChangedInputForTheSameDateIsProcessedAsANewRun()
+        {
+            string inputDirectory = TestSupport.CopyInputs("override-rerun", "changed-input");
+            string outputDirectory = TestSupport.FreshDirectory("changed-output");
+
+            BatchOutcome first = TestSupport.CreateBatch().Run(new RunRequest(TestSupport.BusinessDate, inputDirectory, outputDirectory));
+            Assert.IsFalse(first.WasRerun, "The first execution is a real run.");
+
+            File.AppendAllText(
+                Path.Combine(inputDirectory, BatchFileNames.Overrides),
+                "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager" + Environment.NewLine);
+
+            BatchOutcome second = TestSupport.CreateBatch().Run(new RunRequest(TestSupport.BusinessDate, inputDirectory, outputDirectory));
+            Assert.IsFalse(second.WasRerun, "Changed inputs must not be treated as an exact rerun.");
+            Assert.IsFalse(
+                string.Equals(first.InputSignature, second.InputSignature, StringComparison.Ordinal),
+                "A changed input must change the fingerprint.");
+
+            string report = File.ReadAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport));
+            Assert.Contains(report, "Stale Overrides: 1", "The duplicate instruction must be audited.");
+            Assert.Contains(report, "T-1003: ForceMatch (ops-manager)", "The duplicate instruction must be itemized.");
+
+            string[] ledger = File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger));
+            Assert.AreEqual(3, ledger.Length, "A genuinely new run appends exactly one ledger row.");
+        }
+
+        [TestCase("REQ-5")]
+        public static void MissingOverridesFileIsTreatedAsNoInstructions()
+        {
+            string inputDirectory = TestSupport.CopyInputs("baseline", "no-overrides-input");
+            string outputDirectory = TestSupport.FreshDirectory("no-overrides-output");
+            File.Delete(Path.Combine(inputDirectory, BatchFileNames.Overrides));
+
+            TestSupport.CreateBatch().Run(new RunRequest(TestSupport.BusinessDate, inputDirectory, outputDirectory));
+
+            Assert.Contains(
+                File.ReadAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport)),
+                "Stale Overrides: 0",
+                "An absent overrides file simply means no instructions.");
+        }
+
+        [TestCase("NFR-3")]
+        public static void MissingInputDirectoryProducesAnActionableFailure()
+        {
+            string outputDirectory = TestSupport.FreshDirectory("missing-input-output");
+            string missing = Path.Combine(AppContext.BaseDirectory, "test-output", "does-not-exist");
+
+            ReconciliationInputException failure = Assert.Throws<ReconciliationInputException>(
+                () => TestSupport.CreateBatch().Run(new RunRequest(TestSupport.BusinessDate, missing, outputDirectory)),
+                "A missing input directory must fail.");
+
+            Assert.Contains(failure.Message, "does-not-exist", "The message must name the offending directory.");
+        }
+
+        [TestCase("NFR-3 / NFR-5")]
+        public static void MalformedInputFailsWithoutLeakingRowPayloads()
+        {
+            string inputDirectory = TestSupport.CopyInputs("baseline", "malformed-input");
+            string outputDirectory = TestSupport.FreshDirectory("malformed-output");
+
+            File.AppendAllText(
+                Path.Combine(inputDirectory, BatchFileNames.Trades),
+                "T-9999,ACC-777,SECRET.N,not-a-number,2025-03-17,USD,4242.42" + Environment.NewLine);
+
+            ReconciliationInputException failure = Assert.Throws<ReconciliationInputException>(
+                () => TestSupport.CreateBatch().Run(new RunRequest(TestSupport.BusinessDate, inputDirectory, outputDirectory)),
+                "A malformed row must fail the run.");
+
+            Assert.Contains(failure.Message, BatchFileNames.Trades, "The message must name the offending file.");
+            Assert.Contains(failure.Message, "line 7", "The message must locate the offending row.");
+            Assert.DoesNotContain(failure.Message, "SECRET.N", "Diagnostics must not echo record payloads.");
+            Assert.DoesNotContain(failure.Message, "ACC-777", "Diagnostics must not echo record payloads.");
+            Assert.IsFalse(
+                File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)),
+                "A failed run must not leave success-shaped output.");
+        }
+
+        [TestCase("NFR-5")]
+        public static void DiagnosticsExposeCountsButNoRecordPayloads()
+        {
+            var logger = new RecordingBatchLogger();
+            string outputDirectory = TestSupport.FreshDirectory("diagnostics");
+            TestSupport.CreateBatch(logger).Run(new RunRequest(TestSupport.BusinessDate, TestSupport.FixtureInput("baseline"), outputDirectory));
+
+            string messages = string.Join(Environment.NewLine, logger.InfoMessages);
+
+            Assert.Contains(messages, "Processed 5 trades", "Operational counts must be visible.");
+            Assert.Contains(messages, "business_date=2025-03-17", "The business date must be visible.");
+            Assert.DoesNotContain(messages, "ACC-001", "Account payloads must not be logged.");
+            Assert.DoesNotContain(messages, "IBM.N", "Instrument payloads must not be logged.");
+            Assert.DoesNotContain(messages, "12500", "Monetary payloads must not be logged.");
+            Assert.AreEqual(0, logger.ErrorMessages.Count, "A healthy run logs no errors.");
+        }
+
+        private static BatchOutcome RunFixture(string fixtureName, string outputDirectory)
+        {
+            return TestSupport.CreateBatch().Run(
+                new RunRequest(TestSupport.BusinessDate, TestSupport.FixtureInput(fixtureName), outputDirectory));
+        }
+
+        private static byte[][] ReadAllDeclaredOutputs(string outputDirectory)
+        {
+            return new[]
+            {
+                BatchFileNames.MatchedTrades,
+                BatchFileNames.BreakQueue,
+                BatchFileNames.EndOfDayReport,
+                BatchFileNames.RunLedger
+            }
+            .Select(fileName => File.ReadAllBytes(Path.Combine(outputDirectory, fileName)))
+            .ToArray();
+        }
+    }
+}
