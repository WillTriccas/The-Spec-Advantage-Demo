+++ b/src/TradeReconciliation.Core/Batch/RunRequest.cs
@@ -0,0 +1,96 @@
+using System;
+using System.Globalization;
+using System.IO;
+using TradeReconciliation.Configuration;
+
+namespace TradeReconciliation.Batch
+{
+    /// <summary>
+    /// The externally observable command contract: an optional positional triple of
+    /// business date, input directory, and output directory (REQ-1 / AMB-1).
+    /// </summary>
+    public sealed class RunRequest
+    {
+        public const string UsageText =
+            "Usage: TradeReconciliation.Cli [<business-date yyyy-MM-dd> <input-directory> <output-directory>]";
+
+        public RunRequest(DateTime businessDate, string inputDirectory, string outputDirectory)
+        {
+            if (string.IsNullOrWhiteSpace(inputDirectory))
+            {
+                throw new ReconciliationArgumentException("An input directory is required. " + UsageText);
+            }
+
+            if (string.IsNullOrWhiteSpace(outputDirectory))
+            {
+                throw new ReconciliationArgumentException("An output directory is required. " + UsageText);
+            }
+
+            BusinessDate = businessDate;
+            InputDirectory = inputDirectory;
+            OutputDirectory = outputDirectory;
+        }
+
+        public DateTime BusinessDate { get; }
+
+        public string InputDirectory { get; }
+
+        public string OutputDirectory { get; }
+
+        public string FormattedBusinessDate => BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+        /// <summary>
+        /// Resolves command-line arguments. No arguments keeps the legacy behaviour of running the
+        /// bundled synthetic sample; anything other than zero or three arguments fails fast.
+        /// </summary>
+        public static RunRequest Resolve(string[]? args)
+        {
+            if (args == null || args.Length == 0)
+            {
+                string baseDirectory = AppContext.BaseDirectory;
+                return new RunRequest(
+                    new DateTime(2025, 3, 17),
+                    Path.Combine(baseDirectory, "data", "sample"),
+                    Path.Combine(baseDirectory, "output", "sample"));
+            }
+
+            if (args.Length != 3)
+            {
+                throw new ReconciliationArgumentException(
+                    "Expected either no arguments or exactly three. " + UsageText);
+            }
+
+            if (!DateTime.TryParseExact(
+                    args[0],
+                    "yyyy-MM-dd",
+                    CultureInfo.InvariantCulture,
+                    DateTimeStyles.None,
+                    out DateTime businessDate))
+            {
+                throw new ReconciliationArgumentException("The business date must be formatted as yyyy-MM-dd. " + UsageText);
+            }
+
+            return new RunRequest(
+                businessDate,
+                ResolveFullPath(args[1], "input"),
+                ResolveFullPath(args[2], "output"));
+        }
+
+        private static string ResolveFullPath(string value, string role)
+        {
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                throw new ReconciliationArgumentException("The " + role + " directory argument was empty. " + UsageText);
+            }
+
+            try
+            {
+                return Path.GetFullPath(value);
+            }
+            catch (Exception exception) when (exception is ArgumentException or NotSupportedException or PathTooLongException)
+            {
+                throw new ReconciliationArgumentException("The " + role + " directory argument is not a usable path. " + UsageText);
+            }
+        }
+    }
+}
