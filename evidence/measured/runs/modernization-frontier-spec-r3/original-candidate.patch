@@ -0,0 +1,40 @@
+using System;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+using TradeReconciliation.Abstractions;
+using TradeReconciliation.Configuration;
+
+namespace TradeReconciliation.Batch
+{
+    /// <summary>
+    /// Fingerprints the business date together with the full content of every file in the input
+    /// directory. Two runs share a signature only when the inputs are byte-identical, which is
+    /// what makes exact reruns detectable (REQ-6 / INV-4).
+    /// </summary>
+    public sealed class InputSignatureCalculator : IInputSignatureCalculator
+    {
+        public string Calculate(DateTime businessDate, string inputDirectory)
+        {
+            if (!Directory.Exists(inputDirectory))
+            {
+                throw new ReconciliationInputException("Input directory '" + inputDirectory + "' does not exist.");
+            }
+
+            var payload = new StringBuilder();
+            payload.AppendLine(businessDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
+
+            string[] filePaths = Directory.GetFiles(inputDirectory);
+            Array.Sort(filePaths, StringComparer.OrdinalIgnoreCase);
+
+            foreach (string filePath in filePaths)
+            {
+                payload.AppendLine(Path.GetFileName(filePath));
+                payload.AppendLine(File.ReadAllText(filePath));
+            }
+
+            byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+            return Convert.ToHexString(hash).ToLowerInvariant();
+        }
+    }
+}
