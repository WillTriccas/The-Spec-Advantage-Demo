+using System;
+using System.Linq;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Reporting;
+using TradeReconciliation.Tests.Framework;
+
+namespace TradeReconciliation.Tests
+{
+    /// <summary>Manual override eligibility, evidence, and stale-instruction accounting.</summary>
+    public static class ManualOverrideTests
+    {
+        [TestCase("REQ-4 / AC-6 / INV-3")]
+        public static void OverrideCannotManufactureAMatchWithoutConcreteCounterparts()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1") },
+                overrides: new[] { TestSupport.Override("T-1") });
+
+            Assert.AreEqual(0, result.MatchedTrades.Count, "No match may be manufactured.");
+            Assert.AreEqual(1, result.OpenBreaks.Count, "The break must remain visible.");
+            Assert.AreEqual(1, result.StaleOverrides.Count, "The unusable instruction must be surfaced.");
+        }
+
+        [TestCase("REQ-4 / AC-7")]
+        public static void OnlyTheFirstOverrideForATradeApplies()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", currency: "USD") },
+                new[] { TestSupport.Position("P-1", currency: "EUR") },
+                new[] { TestSupport.Settlement("S-1", currency: "EUR") },
+                new[]
+                {
+                    TestSupport.Override("T-1", action: "ForceMatch", note: "first instruction"),
+                    TestSupport.Override("T-1", action: "ForceMatch", note: "superseded instruction")
+                });
+
+            Assert.AreEqual(1, result.ManualOverrideMatchedCount, "The first instruction applies.");
+            Assert.AreEqual(0, result.OpenBreaks.Count, "The resolved break leaves the queue.");
+            Assert.AreEqual(1, result.StaleOverrides.Count, "The later instruction must be stale.");
+            Assert.AreEqual("superseded instruction", result.StaleOverrides[0].Note, "The superseded row is the stale one.");
+            Assert.AreEqual("first instruction", result.MatchedTrades[0].OverrideNote, "Applied evidence must be retained.");
+        }
+
+        [TestCase("REQ-4 / REQ-5")]
+        public static void SuppressedBreakStaysEvidencedInMatchedTrades()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", currency: "USD") },
+                new[] { TestSupport.Position("P-1", currency: "EUR") },
+                new[] { TestSupport.Settlement("S-1", currency: "EUR") },
+                new[] { TestSupport.Override("T-1", action: "SuppressBreak", note: "FX leg booked in broker mirror") });
+
+            Assert.AreEqual(1, result.ManualOverrideSuppressedCount, "The suppression must be applied.");
+            Assert.AreEqual(0, result.OpenBreaks.Count, "The suppressed break leaves the queue.");
+            Assert.AreEqual(MatchStatus.ManualOverrideSuppressed, result.MatchedTrades[0].Status, "Status records the suppression.");
+            Assert.AreEqual("FX leg booked in broker mirror", result.MatchedTrades[0].OverrideNote, "The note is the audit trail.");
+            Assert.AreEqual("P-1", result.MatchedTrades[0].PositionId ?? string.Empty, "The counterpart evidence is retained.");
+            Assert.AreEqual("S-1", result.MatchedTrades[0].SettlementId ?? string.Empty, "The counterpart evidence is retained.");
+        }
+
+        [TestCase("REQ-4 / INV-3")]
+        public static void OverrideWithoutNoteOrApproverIsStale()
+        {
+            foreach (ManualOverrideRecord instruction in new[]
+            {
+                TestSupport.Override("T-1", note: "   "),
+                TestSupport.Override("T-1", approvedBy: string.Empty),
+                TestSupport.Override("T-1", action: "DeleteEverything")
+            })
+            {
+                ReconciliationResult result = TestSupport.Reconcile(
+                    new[] { TestSupport.Trade("T-1", currency: "USD") },
+                    new[] { TestSupport.Position("P-1", currency: "EUR") },
+                    new[] { TestSupport.Settlement("S-1", currency: "EUR") },
+                    new[] { instruction });
+
+                Assert.AreEqual(0, result.MatchedTrades.Count, "An incomplete instruction cannot resolve a break.");
+                Assert.AreEqual(1, result.OpenBreaks.Count, "The break stays visible.");
+                Assert.AreEqual(1, result.StaleOverrides.Count, "The instruction is surfaced as stale.");
+            }
+        }
+
+        [TestCase("REQ-4")]
+        public static void OverrideForATradeWithNoBreakIsStale()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1") },
+                new[] { TestSupport.Position("P-1") },
+                new[] { TestSupport.Settlement("S-1") },
+                new[] { TestSupport.Override("T-1") });
+
+            Assert.AreEqual(1, result.MatchedCount, "The trade matched on its own.");
+            Assert.AreEqual(1, result.StaleOverrides.Count, "An unused instruction is never silently dropped.");
+        }
+
+        [TestCase("REQ-4 / RISK-2")]
+        public static void IdenticalDuplicateInstructionsAreAccountedForSeparately()
+        {
+            ManualOverrideRecord first = TestSupport.Override("T-9", note: "same text");
+            ManualOverrideRecord second = TestSupport.Override("T-9", note: "same text");
+
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1") },
+                overrides: new[] { first, second });
+
+            Assert.AreEqual(2, result.StaleOverrides.Count, "Value-identical rows must not collapse into one.");
+            Assert.IsTrue(
+                result.StaleOverrides.Any(record => ReferenceEquals(record, first)) &&
+                result.StaleOverrides.Any(record => ReferenceEquals(record, second)),
+                "Both original instructions must be present.");
+        }
+
+        [TestCase("REQ-5")]
+        public static void ReportListsBreakReasonsAndStaleOverridesDeterministically()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-2"), TestSupport.Trade("T-1") },
+                overrides: new[] { TestSupport.Override("T-9", action: "ForceMatch", approvedBy: "ops-manager") });
+
+            string report = new EndOfDayReporter().BuildReport(TestSupport.BusinessDate, result);
+
+            Assert.Contains(report, "Business Date: 2025-03-17", "The business date is reported.");
+            Assert.Contains(report, "Trades Read: 2", "Totals are reported.");
+            Assert.Contains(report, "Stale Overrides: 1", "Stale instructions are counted.");
+            Assert.Contains(report, "T-9: ForceMatch (ops-manager)", "Stale instructions are itemized.");
+            Assert.AreEqual(
+                new EndOfDayReporter().BuildReport(TestSupport.BusinessDate, result),
+                report,
+                "Report generation must be deterministic.");
+        }
+
+        [TestCase("REQ-5")]
+        public static void ReportSaysNoneWhenThereAreNoOpenBreaks()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1") },
+                new[] { TestSupport.Position("P-1") },
+                new[] { TestSupport.Settlement("S-1") });
+
+            string report = new EndOfDayReporter().BuildReport(TestSupport.BusinessDate, result);
+
+            Assert.Contains(report, "Open Break Reasons" + Environment.NewLine + "------------------" + Environment.NewLine + "None", "An empty break queue reports None.");
+            Assert.DoesNotContain(report, "Stale Overrides" + Environment.NewLine + "---------------", "No stale section without stale instructions.");
+        }
+    }
+}
diff --git a/tests/TradeReconciliation.Tests/MatchingEngineTests.cs b/tests/TradeReconciliation.Tests/MatchingEngineTests.cs
new file mode 100644
index 0000000..dfd78ad
--- /dev/null
+++ b/tests/TradeReconciliation.Tests/MatchingEngineTests.cs
@@ -0,0 +1,232 @@
+using System;
+using System.Linq;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Tests.Framework;
+
+namespace TradeReconciliation.Tests
+{
+    /// <summary>Unit coverage for normalization, duplicates, counterpart identity, and tolerances.</summary>
+    public static class MatchingEngineTests
+    {
+        [TestCase("REQ-2 / AC-2")]
+        public static void ComparesAccountInstrumentAndCurrencyOnTrimmedUppercaseValues()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade(" t-1 ", account: " acc-001 ", instrument: " ibm.n ", currency: " usd ") },
+                new[] { TestSupport.Position("P-1", account: "ACC-001", instrument: "IBM.N", currency: "USD") },
+                new[] { TestSupport.Settlement("S-1", account: "ACC-001", instrument: "IBM.N", currency: "USD") });
+
+            Assert.AreEqual(1, result.MatchedCount, "Case and whitespace differences must still match.");
+            Assert.AreEqual(0, result.OpenBreaks.Count, "No break is expected for a normalized match.");
+            Assert.AreEqual("T-1", result.MatchedTrades[0].TradeId, "Trade id must be normalized in output.");
+            Assert.AreEqual("ACC-001", result.MatchedTrades[0].Account, "Account must be normalized in output.");
+            Assert.AreEqual("IBM.N", result.MatchedTrades[0].Instrument, "Instrument must be normalized in output.");
+            Assert.AreEqual("USD", result.MatchedTrades[0].Currency, "Currency must be normalized in output.");
+        }
+
+        [TestCase("REQ-2 / AC-3 / INV-1")]
+        public static void FirstTradeIdOccurrenceIsCanonicalAndLaterOnesBreak()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[]
+                {
+                    TestSupport.Trade("T-1"),
+                    TestSupport.Trade("T-1"),
+                    TestSupport.Trade("t-1 ")
+                },
+                new[] { TestSupport.Position("P-1") },
+                new[] { TestSupport.Settlement("S-1") });
+
+            Assert.AreEqual(3, result.TotalTradesRead, "Every input row must be counted.");
+            Assert.AreEqual(1, result.CanonicalTradeCount, "Only the first occurrence is canonical.");
+            Assert.AreEqual(2, result.DuplicateTradeCount, "Both later occurrences are duplicates.");
+            Assert.AreEqual(1, result.MatchedCount, "Only the canonical trade may match.");
+            Assert.AreEqual(2, result.OpenBreaks.Count, "Duplicates are never silently dropped.");
+            Assert.IsTrue(
+                result.OpenBreaks.All(record => record.Reasons == BreakReason.DuplicateTradeId),
+                "Duplicate rows must be reported with the DuplicateTradeId reason.");
+        }
+
+        [TestCase("REQ-3 / AC-4")]
+        public static void AcceptsCandidatesExactlyOnEveryToleranceBoundary()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m, netAmount: 12500m) },
+                new[] { TestSupport.Position("P-1", quantity: 100.01m) },
+                new[] { TestSupport.Settlement("S-1", quantity: 100.02m, cashAmount: 12505.00m) });
+
+            Assert.AreEqual(1, result.MatchedCount, "Closed-interval tolerances must accept boundary values.");
+        }
+
+        [TestCase("REQ-3 / AC-4")]
+        public static void RejectsPositionQuantityJustOutsideTolerance()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m) },
+                new[] { TestSupport.Position("P-1", quantity: 100.011m) },
+                new[] { TestSupport.Settlement("S-1") });
+
+            Assert.AreEqual(0, result.MatchedCount, "A quantity beyond the tolerance must not match.");
+            Assert.AreEqual(BreakReason.PositionQuantityOutOfTolerance, result.OpenBreaks[0].Reasons, "Reason code must be preserved.");
+        }
+
+        [TestCase("REQ-3 / AC-4")]
+        public static void RejectsSettlementQuantityAndAmountJustOutsideTolerance()
+        {
+            ReconciliationResult quantityResult = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m) },
+                new[] { TestSupport.Position("P-1", quantity: 100m) },
+                new[] { TestSupport.Settlement("S-1", quantity: 100.021m) });
+
+            Assert.AreEqual(
+                BreakReason.SettlementQuantityOutOfTolerance,
+                quantityResult.OpenBreaks[0].Reasons,
+                "Settlement quantity has its own tolerance.");
+
+            ReconciliationResult amountResult = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", netAmount: 12500m) },
+                new[] { TestSupport.Position("P-1") },
+                new[] { TestSupport.Settlement("S-1", cashAmount: 12505.01m) });
+
+            Assert.AreEqual(
+                BreakReason.SettlementAmountOutOfTolerance,
+                amountResult.OpenBreaks[0].Reasons,
+                "Settlement cash amount has its own tolerance.");
+        }
+
+        [TestCase("REQ-3 / AC-5")]
+        public static void NonPositiveQuantityOrNetAmountAlwaysBreaks()
+        {
+            foreach (TradeRecord trade in new[]
+            {
+                TestSupport.Trade("T-1", quantity: 0m),
+                TestSupport.Trade("T-2", quantity: -100m),
+                TestSupport.Trade("T-3", netAmount: 0m),
+                TestSupport.Trade("T-4", netAmount: -12500m)
+            })
+            {
+                ReconciliationResult result = TestSupport.Reconcile(
+                    new[] { trade },
+                    new[] { TestSupport.Position("P-1", quantity: trade.Quantity) },
+                    new[] { TestSupport.Settlement("S-1", quantity: trade.Quantity, cashAmount: trade.NetAmount) });
+
+                Assert.AreEqual(0, result.MatchedCount, "Non-positive trade values can never match: " + trade.TradeId);
+                Assert.AreEqual(1, result.OpenBreaks.Count, "A break is expected for " + trade.TradeId);
+                Assert.AreEqual(BreakReason.TradeValueOutOfBounds, result.OpenBreaks[0].Reasons, "Reason code for " + trade.TradeId);
+                Assert.IsFalse(result.OpenBreaks[0].CanManualOverride, "Out-of-bounds values are not override eligible.");
+            }
+        }
+
+        [TestCase("REQ-3 / INV-2")]
+        public static void CounterpartIdentityIsProvenBeforeTolerances()
+        {
+            ReconciliationResult dateMismatch = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1") },
+                new[] { TestSupport.Position("P-1", settlementDate: TestSupport.BusinessDate.AddDays(1)) },
+                new[] { TestSupport.Settlement("S-1", settlementDate: TestSupport.BusinessDate.AddDays(1)) });
+
+            Assert.AreEqual(
+                BreakReason.PositionSettlementDateMismatch + "|" + BreakReason.SettlementDateMismatch,
+                dateMismatch.OpenBreaks[0].Reasons,
+                "Settlement date must agree before tolerances are considered.");
+
+            ReconciliationResult currencyMismatch = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", currency: "USD") },
+                new[] { TestSupport.Position("P-1", currency: "EUR") },
+                new[] { TestSupport.Settlement("S-1", currency: "EUR") });
+
+            Assert.AreEqual(
+                BreakReason.PositionCurrencyMismatch + "|" + BreakReason.SettlementCurrencyMismatch,
+                currencyMismatch.OpenBreaks[0].Reasons,
+                "Currency must agree before tolerances are considered.");
+        }
+
+        [TestCase("REQ-3 / INV-2")]
+        public static void MissingCounterpartsAreReportedAndNotOverrideEligible()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(new[] { TestSupport.Trade("T-1") });
+
+            Assert.AreEqual(
+                BreakReason.MissingPosition + "|" + BreakReason.MissingSettlement,
+                result.OpenBreaks[0].Reasons,
+                "Both counterparts are missing.");
+            Assert.IsFalse(result.OpenBreaks[0].CanManualOverride, "A break with no concrete counterpart is not override eligible.");
+        }
+
+        [TestCase("REQ-3")]
+        public static void CounterpartsAreConsumedOnlyOnce()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1"), TestSupport.Trade("T-2") },
+                new[] { TestSupport.Position("P-1") },
+                new[] { TestSupport.Settlement("S-1") });
+
+            Assert.AreEqual(1, result.MatchedCount, "A counterpart may back only one trade.");
+            Assert.AreEqual(1, result.OpenBreaks.Count, "The second trade must break.");
+            Assert.AreEqual(
+                BreakReason.MissingPosition + "|" + BreakReason.MissingSettlement,
+                result.OpenBreaks[0].Reasons,
+                "Exhausted counterparts read as missing.");
+        }
+
+        [TestCase("REQ-3")]
+        public static void QuantitySignMismatchIsReported()
+        {
+            ReconciliationResult result = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m) },
+                new[] { TestSupport.Position("P-1", quantity: -100m) },
+                new[] { TestSupport.Settlement("S-1", quantity: -100m) });
+
+            Assert.AreEqual(
+                BreakReason.PositionQuantitySignMismatch + "|" + BreakReason.SettlementQuantitySignMismatch,
+                result.OpenBreaks[0].Reasons,
+                "Opposite signs must never match.");
+        }
+
+        [TestCase("NFR-2")]
+        public static void TolerancesAreExternallyConfigurable()
+        {
+            var widened = new ReconciliationOptions
+            {
+                PositionQuantityTolerance = 1m,
+                SettlementQuantityTolerance = 1m,
+                SettlementAmountTolerance = 100m
+            };
+
+            ReconciliationResult tightened = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m, netAmount: 12500m) },
+                new[] { TestSupport.Position("P-1", quantity: 100.5m) },
+                new[] { TestSupport.Settlement("S-1", quantity: 100.5m, cashAmount: 12550m) });
+
+            Assert.AreEqual(0, tightened.MatchedCount, "Default tolerances must reject the wider difference.");
+
+            ReconciliationResult relaxed = TestSupport.Reconcile(
+                new[] { TestSupport.Trade("T-1", quantity: 100m, netAmount: 12500m) },
+                new[] { TestSupport.Position("P-1", quantity: 100.5m) },
+                new[] { TestSupport.Settlement("S-1", quantity: 100.5m, cashAmount: 12550m) },
+                options: widened);
+
+            Assert.AreEqual(1, relaxed.MatchedCount, "Configured tolerances must be honoured.");
+        }
+
+        [TestCase("NFR-3")]
+        public static void InvalidToleranceConfigurationFailsFast()
+        {
+            Assert.Throws<ReconciliationConfigurationException>(
+                () => ReconciliationOptions.FromEnvironment(name =>
+                    name == ReconciliationOptions.PositionQuantityToleranceVariable ? "not-a-number" : null),
+                "A malformed tolerance override must fail fast.");
+
+            Assert.Throws<ReconciliationConfigurationException>(
+                () => ReconciliationOptions.FromEnvironment(name =>
+                    name == ReconciliationOptions.SettlementAmountToleranceVariable ? "-1" : null),
+                "A negative tolerance override must fail fast.");
+
+            ReconciliationOptions defaults = ReconciliationOptions.FromEnvironment(_ => null);
+            Assert.AreEqual(0.01m, defaults.PositionQuantityTolerance, "Unset variables keep the legacy default.");
+            Assert.AreEqual(0.02m, defaults.SettlementQuantityTolerance, "Unset variables keep the legacy default.");
+            Assert.AreEqual(5.00m, defaults.SettlementAmountTolerance, "Unset variables keep the legacy default.");
+        }
+    }
+}
