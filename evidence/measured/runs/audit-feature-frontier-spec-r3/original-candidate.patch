new file mode 100644
index 0000000..465efba
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
@@ -0,0 +1,96 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// The candidate-root adapter contracts stay data-only, shell-free and complete
+/// (REQ-1, REQ-9, AC-1, AC-11).
+/// </summary>
+public class AuditAdapterContractTests
+{
+    private static JsonObject Adapter(string fileName)
+    {
+        var path = Path.Combine(AuditTestHarness.CandidateRoot(), fileName);
+        Assert.True(File.Exists(path), $"{fileName} must exist at the candidate root.");
+        return (JsonObject)JsonNode.Parse(File.ReadAllText(path))!;
+    }
+
+    [Fact]
+    public void The_existing_benchmark_adapter_is_preserved()
+    {
+        var adapter = Adapter("benchmark-adapter.json");
+
+        Assert.Equal(".", (string?)adapter["workingDirectory"]);
+        foreach (var command in new[] { "build", "test", "run" })
+        {
+            Assert.True(adapter.ContainsKey(command), $"benchmark-adapter.json must keep its '{command}' command.");
+        }
+
+        var outputs = ((JsonArray)adapter["outputs"]!).Select(node => (string?)node).ToList();
+        Assert.Contains("{businessDate}/eod-summary.txt", outputs);
+        Assert.Contains("{businessDate}/eod-break-register.csv", outputs);
+        Assert.Contains("{businessDate}/eod-result.json", outputs);
+    }
+
+    [Theory]
+    [InlineData("initialize", new[] { "{stateDirectory}" })]
+    [InlineData("propose", new[] { "{stateDirectory}", "{requestId}", "{proposer}", "{businessDate}", "{reason}", "{evidence}" })]
+    [InlineData("decide", new[] { "{stateDirectory}", "{requestId}", "{approver}", "{decision}" })]
+    [InlineData("export", new[] { "{stateDirectory}", "{fromDate}", "{toDate}", "{exportPath}" })]
+    public void The_audit_adapter_declares_every_documented_placeholder(string command, string[] placeholders)
+    {
+        var adapter = Adapter("audit-adapter.json");
+        var definition = Assert.IsType<JsonObject>(adapter[command]);
+
+        var executable = (string?)definition["executable"];
+        Assert.False(string.IsNullOrWhiteSpace(executable));
+
+        var arguments = ((JsonArray)definition["arguments"]!).Select(node => (string?)node ?? string.Empty).ToList();
+        Assert.NotEmpty(arguments);
+
+        foreach (var placeholder in placeholders)
+        {
+            Assert.Contains(placeholder, arguments);
+        }
+
+        // Shell-free: no argument may smuggle in shell metacharacters.
+        Assert.All(arguments, argument => Assert.DoesNotContain('|', argument));
+        Assert.All(arguments, argument => Assert.DoesNotContain('&', argument));
+        Assert.All(arguments, argument => Assert.DoesNotContain('>', argument));
+        Assert.DoesNotContain(executable, new[] { "sh", "bash", "cmd", "cmd.exe", "powershell", "pwsh" });
+
+        var allowedExitCodes = ((JsonArray)definition["allowedExitCodes"]!).Select(node => (int)node!).ToList();
+        Assert.Contains(0, allowedExitCodes);
+    }
+
+    [Fact]
+    public void The_audit_adapter_matches_the_published_contract_schema()
+    {
+        var adapter = Adapter("audit-adapter.json");
+        var schemaPath = Path.Combine(AuditTestHarness.CandidateRoot(), "contracts", "audit-adapter.schema.json");
+        Assert.True(File.Exists(schemaPath));
+
+        var schema = (JsonObject)JsonNode.Parse(File.ReadAllText(schemaPath))!;
+        var required = ((JsonArray)schema["required"]!).Select(node => (string?)node ?? string.Empty);
+
+        Assert.Equal(".", (string?)adapter["workingDirectory"]);
+        Assert.False(string.IsNullOrWhiteSpace((string?)adapter["schemaVersion"]));
+        Assert.All(required, name => Assert.True(adapter.ContainsKey(name), $"audit-adapter.json is missing '{name}'."));
+
+        // Only contract-level properties are declared; no internal project details leak in.
+        var allowed = ((JsonObject)schema["properties"]!).Select(property => property.Key).ToHashSet(StringComparer.Ordinal);
+        Assert.All(adapter.Select(property => property.Key), key => Assert.Contains(key, allowed));
+    }
+
+    [Fact]
+    public void The_audit_adapter_is_data_only_json()
+    {
+        var path = Path.Combine(AuditTestHarness.CandidateRoot(), "audit-adapter.json");
+
+        using var document = JsonDocument.Parse(File.ReadAllText(path));
+
+        Assert.Equal(JsonValueKind.Object, document.RootElement.ValueKind);
+    }
+}
