+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>Append-only ordering and tamper evidence of the audit history (REQ-4, AC-6).</summary>
+public class AuditHistoryChainTests : IDisposable
+{
+    private readonly string _state = AuditTestHarness.NewStateDirectory();
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_state))
+        {
+            Directory.Delete(_state, recursive: true);
+        }
+
+        GC.SuppressFinalize(this);
+    }
+
+    [Fact]
+    public void Exported_entries_are_contiguously_sequenced_and_hash_linked()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-700", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-700", "checker-b", "approve");
+        service.Propose("REQ-701", "maker-c", "2024-06-03", "Custodian confirmed", "ticket/RES-2");
+        service.Decide("REQ-701", "checker-d", "reject");
+
+        var entries = AuditTestHarness.Entries(AuditTestHarness.Export(_state)).Cast<JsonObject>().ToList();
+
+        Assert.Equal(4, entries.Count);
+
+        string? previousHash = null;
+        for (var i = 0; i < entries.Count; i++)
+        {
+            var entry = entries[i];
+            Assert.Equal(i + 1, (int)entry["sequence"]!);
+            Assert.Equal(previousHash, (string?)entry["previousHash"]);
+
+            var hash = AuditTestHarness.Field(entry, "hash");
+            Assert.Equal(64, hash.Length);
+            Assert.Equal(hash, hash.ToLowerInvariant());
+            Assert.Equal(hash, AuditTestHarness.RecomputeHash(entry));
+
+            previousHash = hash;
+        }
+    }
+
+    [Fact]
+    public void Lifecycle_entries_keep_their_original_order_per_request()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-702", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-702", "checker-b", "approve");
+
+        var entries = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-702").ToList();
+
+        Assert.Equal("PROPOSED", AuditTestHarness.Field(entries[0], "action"));
+        Assert.Equal(1, (int)entries[0]["requestSequence"]!);
+        Assert.Equal("APPROVED", AuditTestHarness.Field(entries[1], "action"));
+        Assert.Equal(2, (int)entries[1]["requestSequence"]!);
+        Assert.True(
+            string.CompareOrdinal(
+                AuditTestHarness.Field(entries[0], "timestamp"),
+                AuditTestHarness.Field(entries[1], "timestamp")) < 0);
+    }
+
+    [Fact]
+    public void Existing_history_lines_are_never_rewritten()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-703", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var historyPath = service.Store.HistoryPath;
+        var afterProposal = File.ReadAllLines(historyPath);
+
+        service.Decide("REQ-703", "checker-b", "approve");
+        var afterDecision = File.ReadAllLines(historyPath);
+
+        Assert.Single(afterProposal);
+        Assert.Equal(2, afterDecision.Length);
+        Assert.Equal(afterProposal[0], afterDecision[0]);
+    }
+
+    [Fact]
+    public void A_tampered_history_line_is_detected()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-704", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-704", "checker-b", "approve");
+
+        var historyPath = service.Store.HistoryPath;
+        var lines = File.ReadAllLines(historyPath);
+        lines[0] = lines[0].Replace("maker-a", "maker-z", StringComparison.Ordinal);
+        File.WriteAllLines(historyPath, lines);
+
+        Assert.Throws<InvalidDataException>(() => new AuditHistoryStore(_state).ReadAll());
+    }
+
+    [Fact]
+    public void A_removed_history_line_is_detected()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-705", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-705", "checker-b", "approve");
+
+        var historyPath = service.Store.HistoryPath;
+        File.WriteAllLines(historyPath, File.ReadAllLines(historyPath).Skip(1));
+
+        Assert.Throws<InvalidDataException>(() => new AuditHistoryStore(_state).ReadAll());
+    }
+
+    [Fact]
+    public void Canonical_json_sorts_keys_recursively_and_stays_compact()
+    {
+        var node = JsonNode.Parse("""{"b":1,"a":{"z":true,"y":[3,{"q":null,"p":"x"}]}}""");
+
+        Assert.Equal("""{"a":{"y":[3,{"p":"x","q":null}],"z":true},"b":1}""", CanonicalJson.Serialize(node));
+    }
+}
