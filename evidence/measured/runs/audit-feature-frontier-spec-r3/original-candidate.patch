+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>Sensitive-data boundary of the audit workflow (REQ-8, INV-5, NFR-1, AC-10).</summary>
+public class AuditSensitiveDataTests : IDisposable
+{
+    private readonly string _state = AuditTestHarness.NewStateDirectory();
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_state))
+        {
+            Directory.Delete(_state, recursive: true);
+        }
+
+        GC.SuppressFinalize(this);
+    }
+
+    [Theory]
+    [InlineData("ACC001")]
+    [InlineData("ACCT-SENTINEL-90210")]
+    [InlineData("account 4455-8899")]
+    [InlineData("8675309.42")]
+    [InlineData("1,600,500.00")]
+    [InlineData("EUR 1600500")]
+    public void Account_and_amount_shaped_tokens_are_masked(string text)
+    {
+        var redacted = SensitiveDataRedactor.Redact(text);
+
+        Assert.DoesNotContain("ACC001", redacted, StringComparison.OrdinalIgnoreCase);
+        Assert.DoesNotContain("90210", redacted, StringComparison.Ordinal);
+        Assert.DoesNotContain("8675309", redacted, StringComparison.Ordinal);
+        Assert.DoesNotContain("1600500", redacted, StringComparison.Ordinal);
+        Assert.DoesNotContain("4455", redacted, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("Broker confirmed the break", "Broker confirmed the break")]
+    [InlineData("Confirmed on 2024-06-03 by operations", "Confirmed on 2024-06-03 by operations")]
+    [InlineData("Escalated twice within 24 hours", "Escalated twice within 24 hours")]
+    public void Ordinary_explanations_survive_redaction_unchanged(string text, string expected)
+    {
+        Assert.Equal(expected, SensitiveDataRedactor.Redact(text));
+    }
+
+    [Theory]
+    [InlineData("Break on ACC001 confirmed")]
+    [InlineData("Break on ACC-42 confirmed")]
+    [InlineData("Break on account ACC002 confirmed")]
+    public void Reconciliation_account_identifiers_are_masked(string text)
+    {
+        var redacted = SensitiveDataRedactor.Redact(text);
+
+        Assert.Contains(SensitiveDataRedactor.IdentifierMask, redacted, StringComparison.Ordinal);
+        Assert.DoesNotContain("ACC001", redacted, StringComparison.OrdinalIgnoreCase);
+        Assert.DoesNotContain("ACC002", redacted, StringComparison.OrdinalIgnoreCase);
+        Assert.DoesNotContain("ACC-42", redacted, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Theory]
+    [InlineData("ticket/RES-77")]
+    [InlineData("see ticket RES-9 for the approval trail")]
+    public void Explanatory_ticket_references_survive_redaction(string text)
+    {
+        Assert.Equal(text, SensitiveDataRedactor.Redact(text));
+    }
+
+    [Fact]
+    public void Sentinels_supplied_in_reason_and_evidence_never_reach_the_export_or_output()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+
+        var reason = $"Break on account {AuditTestHarness.AccountSentinel} for {AuditTestHarness.AmountSentinel}";
+        var evidence = $"custodian statement lists {AuditTestHarness.AmountSentinel} against {AuditTestHarness.AccountSentinel}";
+
+        var proposal = service.Propose("REQ-800", "maker-a", "2024-06-03", reason, evidence);
+        var decision = service.Decide("REQ-800", "checker-b", "approve");
+        var export = service.Export("2024-06-01", "2024-06-30", AuditTestHarness.ExportPath(_state));
+
+        var surfaces = new[]
+        {
+            proposal.ToJson(),
+            decision.ToJson(),
+            export.ToJson(),
+            File.ReadAllText(AuditTestHarness.ExportPath(_state)),
+            File.ReadAllText(service.Store.HistoryPath)
+        };
+
+        foreach (var surface in surfaces)
+        {
+            Assert.DoesNotContain(AuditTestHarness.AccountSentinel, surface, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(AuditTestHarness.AmountSentinel, surface, StringComparison.Ordinal);
+            Assert.DoesNotContain("90210", surface, StringComparison.Ordinal);
+            Assert.DoesNotContain("8675309", surface, StringComparison.Ordinal);
+        }
+    }
+
+    [Fact]
+    public void Redacted_reason_and_evidence_remain_present_and_non_empty_in_the_export()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose(
+            "REQ-801",
+            "maker-a",
+            "2024-06-03",
+            $"Break on {AuditTestHarness.AccountSentinel}",
+            AuditTestHarness.AmountSentinel);
+
+        var entry = Assert.Single(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-801"));
+
+        Assert.False(string.IsNullOrWhiteSpace(AuditTestHarness.Field(entry, "reason")));
+        Assert.False(string.IsNullOrWhiteSpace(AuditTestHarness.Field(entry, "evidence")));
+        Assert.Contains("Break on", AuditTestHarness.Field(entry, "reason"), StringComparison.Ordinal);
+        Assert.Equal(SensitiveDataRedactor.AmountMask, AuditTestHarness.Field(entry, "evidence"));
+    }
+
+    [Fact]
+    public void Request_and_actor_identities_are_preserved_exactly()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-802", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-802", "checker-b", "approve");
+
+        var entries = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-802").ToList();
+
+        Assert.All(entries, entry => Assert.Equal("REQ-802", AuditTestHarness.Field(entry, "requestId")));
+        Assert.All(entries, entry => Assert.Equal("maker-a", AuditTestHarness.Field(entry, "proposer")));
+        Assert.Equal("checker-b", AuditTestHarness.Field(entries[1], "checker"));
+    }
+}
diff --git a/tests/TradeRecon.Tests/AuditTestHarness.cs b/tests/TradeRecon.Tests/AuditTestHarness.cs
new file mode 100644
index 0000000..09ee496
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditTestHarness.cs
@@ -0,0 +1,175 @@
+using System.Diagnostics;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>Shared helpers for the audit workflow tests.</summary>
+internal static class AuditTestHarness
+{
+    public const string AccountSentinel = "ACCT-SENTINEL-90210";
+    public const string AmountSentinel = "8675309.42";
+
+    public static string NewStateDirectory()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"trade-recon-audit-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(path);
+        return path;
+    }
+
+    public static AuditWorkflowService Service(string stateDirectory) => new(stateDirectory);
+
+    public static string ExportPath(string stateDirectory) => Path.Combine(stateDirectory, "export", "audit-history.json");
+
+    public static JsonObject Export(string stateDirectory, string from = "2000-01-01", string to = "2100-12-31")
+    {
+        var result = Service(stateDirectory).Export(from, to, ExportPath(stateDirectory));
+        Assert.True(result.Accepted);
+        return (JsonObject)JsonNode.Parse(File.ReadAllText(ExportPath(stateDirectory)))!;
+    }
+
+    public static JsonArray Entries(JsonObject export) => (JsonArray)export["entries"]!;
+
+    public static IEnumerable<JsonObject> EntriesFor(JsonObject export, string requestId)
+        => Entries(export)
+            .Cast<JsonObject>()
+            .Where(entry => (string?)entry["requestId"] == requestId);
+
+    public static string Field(JsonObject entry, string name) => (string?)entry[name] ?? string.Empty;
+
+    /// <summary>Locates the candidate root (the directory holding TradeRecon.sln).</summary>
+    public static string CandidateRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "TradeRecon.sln")))
+        {
+            directory = directory.Parent;
+        }
+
+        Assert.NotNull(directory);
+        return directory!.FullName;
+    }
+
+    /// <summary>
+    /// Resolves the built audit console assembly so tests can exercise it as a real,
+    /// separate operating-system process.
+    /// </summary>
+    public static string AuditConsolePath
+    {
+        get
+        {
+            var local = Path.Combine(AppContext.BaseDirectory, "TradeRecon.AuditConsole.dll");
+            if (IsRunnable(local))
+            {
+                return local;
+            }
+
+            var binRoot = Path.Combine(CandidateRoot(), "src", "TradeRecon.AuditConsole", "bin");
+            Assert.True(Directory.Exists(binRoot), $"The audit console has not been built ({binRoot} is missing).");
+
+            var configuration = new DirectoryInfo(AppContext.BaseDirectory).Parent?.Name;
+            var candidates = Directory
+                .GetFiles(binRoot, "TradeRecon.AuditConsole.dll", SearchOption.AllDirectories)
+                .Where(IsRunnable)
+                .OrderByDescending(path => configuration is not null
+                    && path.Contains(Path.DirectorySeparatorChar + configuration + Path.DirectorySeparatorChar, StringComparison.Ordinal))
+                .ThenByDescending(File.GetLastWriteTimeUtc)
+                .ToList();
+
+            Assert.NotEmpty(candidates);
+            return candidates[0];
+        }
+    }
+
+    private static bool IsRunnable(string assemblyPath)
+        => File.Exists(assemblyPath)
+           && File.Exists(Path.Combine(
+               Path.GetDirectoryName(assemblyPath)!,
+               Path.GetFileNameWithoutExtension(assemblyPath) + ".runtimeconfig.json"));
+
+    public static string HostPath =>
+        Environment.GetEnvironmentVariable("DOTNET_HOST_PATH") is { Length: > 0 } host && File.Exists(host)
+            ? host
+            : "dotnet";
+
+    /// <summary>Runs the audit console in a separate OS process and captures its JSON stdout.</summary>
+    public static (int ExitCode, string StdOut, string StdErr) RunProcess(params string[] arguments)
+    {
+        var startInfo = new ProcessStartInfo(HostPath)
+        {
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+            StandardOutputEncoding = Encoding.UTF8,
+            StandardErrorEncoding = Encoding.UTF8
+        };
+
+        startInfo.ArgumentList.Add(AuditConsolePath);
+        foreach (var argument in arguments)
+        {
+            startInfo.ArgumentList.Add(argument);
+        }
+
+        using var process = Process.Start(startInfo)
+                            ?? throw new InvalidOperationException("Unable to start the audit console process.");
+
+        var stdout = process.StandardOutput.ReadToEndAsync();
+        var stderr = process.StandardError.ReadToEndAsync();
+        Assert.True(process.WaitForExit(120_000), "The audit console process did not exit in time.");
+
+        return (process.ExitCode, stdout.GetAwaiter().GetResult(), stderr.GetAwaiter().GetResult());
+    }
+
+    /// <summary>
+    /// Independent re-implementation of the documented canonicalisation: lowercase SHA-256
+    /// over compact JSON with recursively sorted object keys and the hash field removed.
+    /// </summary>
+    public static string RecomputeHash(JsonObject entry)
+    {
+        var copy = (JsonObject)JsonNode.Parse(entry.ToJsonString())!;
+        copy.Remove("hash");
+
+        var canonical = Canonicalize(copy);
+        var digest = System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(canonical));
+        return Convert.ToHexString(digest).ToLowerInvariant();
+    }
+
+    private static readonly JsonSerializerOptions StringOptions = new()
+    {
+        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+
+    private static string Canonicalize(JsonNode? node)
+    {
+        switch (node)
+        {
+            case null:
+                return "null";
+            case JsonObject obj:
+            {
+                var parts = new SortedDictionary<string, string>(StringComparer.Ordinal);
+                foreach (var property in obj)
+                {
+                    parts[property.Key] = Canonicalize(property.Value);
+                }
+
+                return "{" + string.Join(",", parts.Select(p => $"{JsonSerializer.Serialize(p.Key, StringOptions)}:{p.Value}")) + "}";
+            }
+
+            case JsonArray array:
+                return "[" + string.Join(",", array.Select(Canonicalize)) + "]";
+            default:
+            {
+                var element = node.GetValue<JsonElement>();
+                return element.ValueKind switch
+                {
+                    JsonValueKind.String => JsonSerializer.Serialize(element.GetString(), StringOptions),
+                    _ => element.GetRawText()
+                };
+            }
+        }
+    }
+}
