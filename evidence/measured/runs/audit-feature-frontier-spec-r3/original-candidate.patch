+
+    [Fact]
+    public void Export_returns_the_complete_history_for_the_inclusive_range()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-500", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-500", "checker-b", "approve");
+        service.Propose("REQ-501", "maker-c", "2024-06-04", "Custodian confirmed", "ticket/RES-2");
+        service.Decide("REQ-501", "checker-d", "reject");
+
+        var export = AuditTestHarness.Export(_state, "2024-06-03", "2024-06-04");
+
+        Assert.Equal(4, AuditTestHarness.Entries(export).Count);
+        Assert.Equal(2, AuditTestHarness.EntriesFor(export, "REQ-500").Count());
+        Assert.Equal(2, AuditTestHarness.EntriesFor(export, "REQ-501").Count());
+        Assert.Equal("2024-06-03", (string?)export["fromDate"]);
+        Assert.Equal("2024-06-04", (string?)export["toDate"]);
+        Assert.Equal(4, (int)export["entryCount"]!);
+    }
+
+    [Fact]
