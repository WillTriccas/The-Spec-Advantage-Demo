@@ -0,0 +1,216 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+
+namespace TradeRecon.AuditConsole;
+
+/// <summary>
+/// Console host for the explainable break-resolution audit workflow.
+///
+/// The host is a shell-free, black-box command contract used by <c>audit-adapter.json</c>:
+///
+///   initialize --state &lt;dir&gt;
+///   propose    --state &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;id&gt; --business-date &lt;yyyy-MM-dd&gt;
+///              --reason &lt;text&gt; --evidence &lt;text&gt;
+///   decide     --state &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;id&gt; --decision &lt;approve|reject&gt;
+///   export     --state &lt;dir&gt; --from &lt;yyyy-MM-dd&gt; --to &lt;yyyy-MM-dd&gt; --export-path &lt;file&gt;
+///
+/// Every invocation writes exactly one parseable JSON document to stdout; <c>export</c> also
+/// writes the same document to the export path. Nothing else is written to stdout and no
+/// caller-supplied reason or evidence text is ever written to stderr, so account identifiers
+/// and trade amounts cannot leak through operational output.
+///
+/// Exit codes: 0 = accepted (including idempotent repeats), 3 = refused by a control rule,
+/// 1 = usage or unexpected error.
+/// </summary>
+public static class Program
+{
+    public const int ExitAccepted = AuditCommandResult.ExitAccepted;
+    public const int ExitRejected = AuditCommandResult.ExitRejected;
+    public const int ExitError = 1;
+
+    private const string Usage =
+        "Usage: TradeRecon.AuditConsole <initialize|propose|decide|export> [options]\n" +
+        "  initialize --state <dir>\n" +
+        "  propose    --state <dir> --request-id <id> --proposer <id> --business-date <yyyy-MM-dd> --reason <text> --evidence <text>\n" +
+        "  decide     --state <dir> --request-id <id> --approver <id> --decision <approve|reject>\n" +
+        "  export     --state <dir> --from <yyyy-MM-dd> --to <yyyy-MM-dd> --export-path <file>";
+
+    public static int Main(string[] args) => Run(args, System.Console.Out);
+
+    public static int Run(string[] args, TextWriter stdout)
+    {
+        if (args.Length == 0 || args[0] is "--help" or "-h" or "help")
+        {
+            Write(stdout, Failure("help", "usage", Usage));
+            return args.Length == 0 ? ExitError : ExitAccepted;
+        }
+
+        var command = args[0].Trim().ToLowerInvariant();
+
+        Dictionary<string, string> options;
+        try
+        {
+            options = ParseOptions(args.AsSpan(1));
+        }
+        catch (ArgumentException ex)
+        {
+            Write(stdout, Failure(command, "invalid_arguments", ex.Message));
+            return ExitError;
+        }
+
+        try
+        {
+            var result = Execute(command, options);
+            if (result is null)
+            {
+                Write(stdout, Failure(command, "unknown_command", $"Unknown command '{command}'."));
+                return ExitError;
+            }
+
+            Write(stdout, result.Payload);
+            return result.ExitCode;
+        }
+        catch (Exception ex) when (ex is IOException
+                                      or UnauthorizedAccessException
+                                      or TimeoutException
+                                      or InvalidDataException
+                                      or FormatException
+                                      or ArgumentException
+                                      or NotSupportedException)
+        {
+            // Only the exception category is reported: caller-supplied free text never
+            // reaches stdout or stderr through a diagnostic message.
+            Write(stdout, Failure(command, "command_failed", $"{ex.GetType().Name} while executing '{command}'."));
+            System.Console.Error.WriteLine($"audit: {ex.GetType().Name} while executing '{command}'.");
+            return ExitError;
+        }
+    }
+
+    private static AuditCommandResult? Execute(string command, Dictionary<string, string> options)
+    {
+        switch (command)
+        {
+            case "initialize":
+            case "init":
+            {
+                var service = CreateService(options);
+                return service.Initialize();
+            }
+
+            case "propose":
+            {
+                var service = CreateService(options);
+                return service.Propose(
+                    Option(options, "request-id", "requestid", "request"),
+                    Option(options, "proposer", "maker", "actor"),
+                    Option(options, "business-date", "businessdate", "date"),
+                    Option(options, "reason"),
+                    Option(options, "evidence"));
+            }
+
+            case "decide":
+            case "decision":
+            {
+                var service = CreateService(options);
+                return service.Decide(
+                    Option(options, "request-id", "requestid", "request"),
+                    Option(options, "approver", "checker", "decider", "actor"),
+                    Option(options, "decision", "outcome"));
+            }
+
+            case "export":
+            {
+                var service = CreateService(options);
+                return service.Export(
+                    Option(options, "from", "from-date", "fromdate"),
+                    Option(options, "to", "to-date", "todate"),
+                    Option(options, "export-path", "exportpath", "out", "output"));
+            }
+
+            default:
+                return null;
+        }
+    }
+
+    private static AuditWorkflowService CreateService(Dictionary<string, string> options)
+    {
+        var stateDirectory = Option(options, "state", "state-directory", "statedirectory");
+        if (string.IsNullOrWhiteSpace(stateDirectory))
+        {
+            throw new ArgumentException("A --state directory is required.");
+        }
+
+        return new AuditWorkflowService(stateDirectory.Trim());
+    }
+
+    private static string? Option(Dictionary<string, string> options, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (options.TryGetValue(name, out var value))
+            {
+                return value;
+            }
+        }
+
+        return null;
+    }
+
+    private static Dictionary<string, string> ParseOptions(ReadOnlySpan<string> args)
+    {
+        var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+
+        for (var i = 0; i < args.Length; i++)
+        {
+            var token = args[i];
+            if (!token.StartsWith("--", StringComparison.Ordinal))
+            {
+                throw new ArgumentException($"Unexpected argument at position {i + 1}.");
+            }
+
+            var name = token[2..];
+            string value;
+
+            var separator = name.IndexOf('=', StringComparison.Ordinal);
+            if (separator >= 0)
+            {
+                value = name[(separator + 1)..];
+                name = name[..separator];
+            }
+            else
+            {
+                if (i + 1 >= args.Length)
+                {
+                    throw new ArgumentException($"Option --{name} requires a value.");
+                }
+
+                value = args[++i];
+            }
+
+            if (name.Length == 0)
+            {
+                throw new ArgumentException("An option name is required after '--'.");
+            }
+
+            options[name] = value;
+        }
+
+        return options;
+    }
+
+    private static JsonObject Failure(string command, string status, string message) => new()
+    {
+        ["schemaVersion"] = AuditWorkflowService.SchemaVersion,
+        ["command"] = command,
+        ["status"] = status,
+        ["accepted"] = false,
+        ["message"] = message
+    };
+
+    private static void Write(TextWriter stdout, JsonObject payload)
+    {
+        stdout.Write(payload.ToJsonString(AuditJson.CompactOptions));
+        stdout.Write('\n');
+        stdout.Flush();
+    }
+}
