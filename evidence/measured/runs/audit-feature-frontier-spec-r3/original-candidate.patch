+using System.Text.Encodings.Web;
+using System.Text.Json;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Shared serializer options for every audit document written by the workflow.</summary>
+public static class AuditJson
+{
+    public static readonly JsonSerializerOptions CompactOptions = new()
+    {
+        WriteIndented = false,
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+
+    public static readonly JsonSerializerOptions IndentedOptions = new()
+    {
+        WriteIndented = true,
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+}
diff --git a/src/TradeRecon.Audit/AuditWorkflowService.cs b/src/TradeRecon.Audit/AuditWorkflowService.cs
new file mode 100644
index 0000000..a5e2438
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditWorkflowService.cs
@@ -0,0 +1,421 @@
+using System.Globalization;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Maker-checker break-resolution workflow over the append-only audit history.
+///
+/// Behaviour is intentionally black-box friendly: every command returns a deterministic
+/// <see cref="AuditCommandResult"/>, state lives entirely beneath the caller-supplied state
+/// directory and survives across separate processes, and no reconciliation payload
+/// (account identifiers, trade amounts) is ever emitted.
+/// </summary>
+public sealed class AuditWorkflowService(AuditHistoryStore store)
+{
+    public const string SchemaVersion = "1.0";
+
+    private readonly AuditHistoryStore _store = store;
+
+    public AuditWorkflowService(string stateDirectory)
+        : this(new AuditHistoryStore(stateDirectory))
+    {
+    }
+
+    public AuditHistoryStore Store => _store;
+
+    /// <summary>Creates (or confirms) durable workflow state beneath the state directory.</summary>
+    public AuditCommandResult Initialize()
+    {
+        _store.EnsureCreated();
+
+        using var gate = _store.AcquireExclusiveAccess();
+        var entries = _store.ReadAll();
+
+        var payload = NewPayload("initialize", "initialized", accepted: true);
+        payload["stateDirectory"] = _store.StateDirectory;
+        payload["historyPath"] = _store.HistoryPath;
+        payload["entryCount"] = entries.Count;
+
+        return new AuditCommandResult
+        {
+            Command = "initialize",
+            Status = "initialized",
+            Accepted = true,
+            Payload = payload
+        };
+    }
+
+    /// <summary>Records a maker's proposed resolution for a reconciliation break.</summary>
+    public AuditCommandResult Propose(
+        string? requestId,
+        string? proposer,
+        string? businessDate,
+        string? reason,
+        string? evidence)
+    {
+        requestId = Normalize(requestId);
+        proposer = Normalize(proposer);
+
+        if (requestId.Length == 0)
+        {
+            return Invalid("propose", "missing_request_id", "A non-empty requestId is required.");
+        }
+
+        if (proposer.Length == 0)
+        {
+            return Invalid("propose", "missing_proposer", "A non-empty proposer identity is required.");
+        }
+
+        if (!TryParseDate(businessDate, out var parsedDate))
+        {
+            return Invalid("propose", "invalid_business_date", "businessDate must be an ISO yyyy-MM-dd date.");
+        }
+
+        if (string.IsNullOrWhiteSpace(reason))
+        {
+            return Invalid("propose", "missing_reason", "A non-empty reason is required.", requestId);
+        }
+
+        if (string.IsNullOrWhiteSpace(evidence))
+        {
+            return Invalid("propose", "missing_evidence", "A non-empty evidence reference is required.", requestId);
+        }
+
+        var safeReason = SensitiveDataRedactor.Redact(reason.Trim());
+        var safeEvidence = SensitiveDataRedactor.Redact(evidence.Trim());
+        var isoDate = parsedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+        _store.EnsureCreated();
+        using var gate = _store.AcquireExclusiveAccess();
+        var entries = _store.ReadAll();
+
+        var existing = FindProposal(entries, requestId);
+        if (existing is not null)
+        {
+            if (!SameIdentity(existing.Proposer, proposer))
+            {
+                var conflict = NewPayload("propose", "duplicate_request_conflict", accepted: false);
+                conflict["requestId"] = requestId;
+                conflict["proposer"] = existing.Proposer;
+                conflict["message"] = "requestId is already owned by a different proposer.";
+                return new AuditCommandResult
+                {
+                    Command = "propose",
+                    Status = "duplicate_request_conflict",
+                    Accepted = false,
+                    Payload = conflict
+                };
+            }
+
+            var duplicate = NewPayload("propose", "duplicate", accepted: true);
+            Describe(duplicate, existing);
+            duplicate["idempotent"] = true;
+            return new AuditCommandResult
+            {
+                Command = "propose",
+                Status = "duplicate",
+                Accepted = true,
+                Payload = duplicate
+            };
+        }
+
+        var entry = _store.Append(entries, new AuditEntryDraft
+        {
+            RequestId = requestId,
+            Action = AuditActions.Proposed,
+            Actor = proposer,
+            Proposer = proposer,
+            Checker = null,
+            BusinessDate = isoDate,
+            Reason = safeReason,
+            Evidence = safeEvidence,
+            RequestSequence = 1
+        });
+
+        var payload = NewPayload("propose", "proposed", accepted: true);
+        Describe(payload, entry);
+        payload["idempotent"] = false;
+
+        return new AuditCommandResult
+        {
+            Command = "propose",
+            Status = "proposed",
+            Accepted = true,
+            Payload = payload
+        };
+    }
+
+    /// <summary>Records a checker's terminal approval or rejection of a proposed resolution.</summary>
+    public AuditCommandResult Decide(string? requestId, string? approver, string? decision)
+    {
+        requestId = Normalize(requestId);
+        approver = Normalize(approver);
+
+        if (requestId.Length == 0)
+        {
+            return Invalid("decide", "missing_request_id", "A non-empty requestId is required.");
+        }
+
+        if (approver.Length == 0)
+        {
+            return Invalid("decide", "missing_approver", "A non-empty approver identity is required.");
+        }
+
+        if (!TryNormalizeDecision(decision, out var action))
+        {
+            return Invalid("decide", "invalid_decision", "decision must be approve/approved or reject/rejected.", requestId);
+        }
+
+        _store.EnsureCreated();
+        using var gate = _store.AcquireExclusiveAccess();
+        var entries = _store.ReadAll();
+
+        var proposal = FindProposal(entries, requestId);
+        if (proposal is null)
+        {
+            var unknown = NewPayload("decide", "unknown_request", accepted: false);
+            unknown["requestId"] = requestId;
+            unknown["decision"] = action;
+            unknown["message"] = "No durable proposal exists for the supplied requestId.";
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = "unknown_request",
+                Accepted = false,
+                Payload = unknown
+            };
+        }
+
+        // INV-1: the checker is always compared against the durable proposer, never against
+        // an actor supplied on this command.
+        if (SameIdentity(proposal.Proposer, approver))
+        {
+            var denied = NewPayload("decide", "self_approval_denied", accepted: false);
+            denied["requestId"] = requestId;
+            denied["proposer"] = proposal.Proposer;
+            denied["attemptedDecision"] = action;
+            denied["message"] = "A proposer may not decide their own request; no decision was recorded.";
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = "self_approval_denied",
+                Accepted = false,
+                Payload = denied
+            };
+        }
+
+        var terminal = FindTerminal(entries, requestId);
+        if (terminal is not null)
+        {
+            var isSameDecision = SameIdentity(terminal.Checker, approver)
+                                 && string.Equals(terminal.Action, action, StringComparison.Ordinal);
+
+            var status = isSameDecision ? "duplicate" : "conflict";
+            var payload = NewPayload("decide", status, accepted: isSameDecision);
+            Describe(payload, terminal);
+            payload["idempotent"] = isSameDecision;
+            payload["attemptedDecision"] = action;
+            payload["finalDecision"] = terminal.Action;
+            payload["finalChecker"] = terminal.Checker;
+            if (!isSameDecision)
+            {
+                payload["message"] = "The request already has a durable final decision.";
+            }
+
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = status,
+                Accepted = isSameDecision,
+                Payload = payload
+            };
+        }
+
+        var requestSequence = entries.Count(e => SameRequest(e.RequestId, requestId)) + 1;
+        var entry = _store.Append(entries, new AuditEntryDraft
+        {
+            RequestId = requestId,
+            Action = action,
+            Actor = approver,
+            Proposer = proposal.Proposer,
+            Checker = approver,
+            BusinessDate = proposal.BusinessDate,
+            Reason = proposal.Reason,
+            Evidence = proposal.Evidence,
+            RequestSequence = requestSequence
+        });
+
+        var accepted = NewPayload("decide", action == AuditActions.Approved ? "approved" : "rejected", accepted: true);
+        Describe(accepted, entry);
+        accepted["idempotent"] = false;
+        accepted["finalDecision"] = entry.Action;
+        accepted["finalChecker"] = entry.Checker;
+
+        return new AuditCommandResult
+        {
+            Command = "decide",
+            Status = action == AuditActions.Approved ? "approved" : "rejected",
+            Accepted = true,
+            Payload = accepted
+        };
+    }
+
+    /// <summary>Exports the durable lifecycle history for an inclusive business-date range.</summary>
+    public AuditCommandResult Export(string? fromDate, string? toDate, string? exportPath)
+    {
+        if (!TryParseDate(fromDate, out var from))
+        {
+            return Invalid("export", "invalid_from_date", "fromDate must be an ISO yyyy-MM-dd date.");
+        }
+
+        if (!TryParseDate(toDate, out var to))
+        {
+            return Invalid("export", "invalid_to_date", "toDate must be an ISO yyyy-MM-dd date.");
+        }
+
+        if (string.IsNullOrWhiteSpace(exportPath))
+        {
+            return Invalid("export", "missing_export_path", "An export path is required.");
+        }
+
+        _store.EnsureCreated();
+
+        IReadOnlyList<AuditEntry> entries;
+        using (var gate = _store.AcquireExclusiveAccess())
+        {
+            entries = _store.ReadAll();
+        }
+
+        var selected = entries
+            .Where(entry => entry.BusinessDateValue >= from && entry.BusinessDateValue <= to)
+            .OrderBy(entry => entry.Sequence)
+            .ToList();
+
+        var resolvedExportPath = Path.GetFullPath(exportPath);
+
+        var document = new JsonObject
+        {
+            ["schemaVersion"] = SchemaVersion,
+            ["command"] = "export",
+            ["status"] = "exported",
+            ["accepted"] = true,
+            ["fromDate"] = from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            ["toDate"] = to.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            ["entryCount"] = selected.Count,
+            ["count"] = selected.Count,
+            ["hashAlgorithm"] = "sha256",
+            ["canonicalization"] = "sorted-keys-compact-json-without-hash",
+            ["exportPath"] = resolvedExportPath,
+            ["entries"] = new JsonArray(selected.Select(entry => (JsonNode)entry.ToJsonObject()).ToArray())
+        };
+
+        var directory = Path.GetDirectoryName(resolvedExportPath);
+        if (!string.IsNullOrEmpty(directory))
+        {
+            Directory.CreateDirectory(directory);
+        }
+
+        File.WriteAllText(
+            resolvedExportPath,
+            JsonSerializer.Serialize(document, AuditJson.IndentedOptions) + "\n",
+            new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+
+        return new AuditCommandResult
+        {
+            Command = "export",
+            Status = "exported",
+            Accepted = true,
+            Payload = document
+        };
+    }
+
+    private static AuditEntry? FindProposal(IReadOnlyList<AuditEntry> entries, string requestId)
+        => entries.FirstOrDefault(e =>
+            SameRequest(e.RequestId, requestId)
+            && string.Equals(e.Action, AuditActions.Proposed, StringComparison.Ordinal));
+
+    private static AuditEntry? FindTerminal(IReadOnlyList<AuditEntry> entries, string requestId)
+        => entries.FirstOrDefault(e => SameRequest(e.RequestId, requestId) && AuditActions.IsTerminal(e.Action));
+
+    private static bool SameRequest(string left, string right)
+        => string.Equals(left, right, StringComparison.Ordinal);
+
+    private static bool SameIdentity(string? left, string? right)
+        => left is not null
+           && right is not null
+           && string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);
+
+    private static bool TryParseDate(string? value, out DateOnly date)
+        => DateOnly.TryParseExact(
+            (value ?? string.Empty).Trim(),
+            "yyyy-MM-dd",
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.None,
+            out date);
+
+    private static bool TryNormalizeDecision(string? value, out string action)
+    {
+        switch ((value ?? string.Empty).Trim().ToUpperInvariant())
+        {
+            case "APPROVE":
+            case "APPROVED":
+            case "APPROVAL":
+                action = AuditActions.Approved;
+                return true;
+            case "REJECT":
+            case "REJECTED":
+            case "REJECTION":
+                action = AuditActions.Rejected;
+                return true;
+            default:
+                action = string.Empty;
+                return false;
+        }
+    }
+
+    private static string Normalize(string? value) => (value ?? string.Empty).Trim();
+
+    private static JsonObject NewPayload(string command, string status, bool accepted) => new()
+    {
+        ["schemaVersion"] = SchemaVersion,
+        ["command"] = command,
+        ["status"] = status,
+        ["accepted"] = accepted
+    };
+
+    private static void Describe(JsonObject payload, AuditEntry entry)
+    {
+        payload["requestId"] = entry.RequestId;
+        payload["action"] = entry.Action;
+        payload["proposer"] = entry.Proposer;
+        payload["checker"] = entry.Checker;
+        payload["businessDate"] = entry.BusinessDate;
+        payload["sequence"] = entry.Sequence;
+        payload["requestSequence"] = entry.RequestSequence;
+        payload["previousHash"] = entry.PreviousHash;
+        payload["hash"] = entry.Hash;
+        payload["timestamp"] = entry.Timestamp;
+    }
+
+    private static AuditCommandResult Invalid(string command, string status, string message, string? requestId = null)
+    {
+        var payload = NewPayload(command, status, accepted: false);
+        if (requestId is not null)
+        {
+            payload["requestId"] = requestId;
+        }
+
+        payload["message"] = message;
+
+        return new AuditCommandResult
+        {
+            Command = command,
+            Status = status,
+            Accepted = false,
+            Payload = payload
+        };
+    }
+}
diff --git a/src/TradeRecon.Audit/CanonicalJson.cs b/src/TradeRecon.Audit/CanonicalJson.cs
new file mode 100644
index 0000000..a14311c
--- /dev/null
+++ b/src/TradeRecon.Audit/CanonicalJson.cs
@@ -0,0 +1,180 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Canonical JSON serialization used for the tamper-evidence hash chain.
+///
+/// The canonical form is deterministic and interoperable:
+///   * object keys are sorted recursively using ordinal (code-unit) ordering;
+///   * no insignificant whitespace is emitted ("," and ":" separators only);
+///   * strings escape only <c>"</c>, <c>\</c> and control characters, matching
+///     the escaping used by <c>JSON.stringify</c> and <c>json.dumps</c> for ASCII text;
+///   * numbers are emitted exactly as they appear in the source document.
+/// </summary>
+public static class CanonicalJson
+{
+    public static string Serialize(JsonNode? node)
+    {
+        var builder = new StringBuilder();
+        Write(builder, node);
+        return builder.ToString();
+    }
+
+    private static void Write(StringBuilder builder, JsonNode? node)
+    {
+        switch (node)
+        {
+            case null:
+                builder.Append("null");
+                return;
+            case JsonObject obj:
+                WriteObject(builder, obj);
+                return;
+            case JsonArray array:
+                WriteArray(builder, array);
+                return;
+            case JsonValue value:
+                WriteValue(builder, value);
+                return;
+            default:
+                throw new NotSupportedException($"Unsupported JSON node type '{node.GetType().Name}'.");
+        }
+    }
+
+    private static void WriteObject(StringBuilder builder, JsonObject obj)
+    {
+        builder.Append('{');
+        var first = true;
+        foreach (var property in obj.OrderBy(p => p.Key, StringComparer.Ordinal))
+        {
+            if (!first)
+            {
+                builder.Append(',');
+            }
+
+            first = false;
+            WriteString(builder, property.Key);
+            builder.Append(':');
+            Write(builder, property.Value);
+        }
+
+        builder.Append('}');
+    }
+
+    private static void WriteArray(StringBuilder builder, JsonArray array)
+    {
+        builder.Append('[');
+        for (var i = 0; i < array.Count; i++)
+        {
+            if (i > 0)
+            {
+                builder.Append(',');
+            }
+
+            Write(builder, array[i]);
+        }
+
+        builder.Append(']');
+    }
+
+    private static void WriteValue(StringBuilder builder, JsonValue value)
+    {
+        if (value.TryGetValue(out JsonElement element))
+        {
+            switch (element.ValueKind)
+            {
+                case JsonValueKind.String:
+                    WriteString(builder, element.GetString() ?? string.Empty);
+                    return;
+                case JsonValueKind.Number:
+                    builder.Append(element.GetRawText());
+                    return;
+                case JsonValueKind.True:
+                    builder.Append("true");
+                    return;
+                case JsonValueKind.False:
+                    builder.Append("false");
+                    return;
+                case JsonValueKind.Null:
+                    builder.Append("null");
+                    return;
+                default:
+                    throw new NotSupportedException($"Unsupported JSON value kind '{element.ValueKind}'.");
+            }
+        }
+
+        if (value.TryGetValue(out string? text))
+        {
+            WriteString(builder, text ?? string.Empty);
+            return;
+        }
+
+        if (value.TryGetValue(out bool flag))
+        {
+            builder.Append(flag ? "true" : "false");
+            return;
+        }
+
+        if (value.TryGetValue(out int number))
+        {
+            builder.Append(number.ToString(System.Globalization.CultureInfo.InvariantCulture));
+            return;
+        }
+
+        if (value.TryGetValue(out long longNumber))
+        {
+            builder.Append(longNumber.ToString(System.Globalization.CultureInfo.InvariantCulture));
+            return;
+        }
+
+        throw new NotSupportedException("Unsupported JSON scalar value.");
+    }
+
+    private static void WriteString(StringBuilder builder, string value)
+    {
+        builder.Append('"');
+        foreach (var c in value)
+        {
+            switch (c)
+            {
+                case '"':
+                    builder.Append("\\\"");
+                    break;
+                case '\\':
+                    builder.Append("\\\\");
+                    break;
+                case '\b':
+                    builder.Append("\\b");
+                    break;
+                case '\f':
+                    builder.Append("\\f");
+                    break;
+                case '\n':
+                    builder.Append("\\n");
+                    break;
+                case '\r':
+                    builder.Append("\\r");
+                    break;
+                case '\t':
+                    builder.Append("\\t");
+                    break;
+                default:
+                    if (c < ' ')
+                    {
+                        builder.Append("\\u").Append(((int)c).ToString("x4", System.Globalization.CultureInfo.InvariantCulture));
+                    }
+                    else
+                    {
+                        builder.Append(c);
+                    }
+
+                    break;
+            }
+        }
+
+        builder.Append('"');
+    }
+}
diff --git a/src/TradeRecon.Audit/SensitiveDataRedactor.cs b/src/TradeRecon.Audit/SensitiveDataRedactor.cs
new file mode 100644
index 0000000..8efbbdc
--- /dev/null
+++ b/src/TradeRecon.Audit/SensitiveDataRedactor.cs
@@ -0,0 +1,114 @@
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Masks account identifiers and monetary amounts out of free-text audit fields.
+///
+/// Reason and evidence are caller supplied, so they are the only channel through which
+/// account numbers or trade amounts could reach durable audit history, an export or a
+/// diagnostic message. Values are redacted once, on the way in, so no downstream
+/// consumer can leak them (INV-5 / NFR-1).
+///
+/// Redaction is deliberately conservative: ordinary prose, ISO business dates and small
+/// counts survive untouched, so a clean reason such as "Client confirmed the break" is
+/// exported verbatim.
+/// </summary>
+public static partial class SensitiveDataRedactor
+{
+    public const string IdentifierMask = "[REDACTED-IDENTIFIER]";
+    public const string AmountMask = "[REDACTED-AMOUNT]";
+
+    /// <summary>Returns <paramref name="value"/> with account-like and amount-like tokens masked.</summary>
+    public static string Redact(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return string.Empty;
+        }
+
+        return TokenPattern().Replace(value, match => Classify(match.Value));
+    }
+
+    private static string Classify(string token)
+    {
+        var trimmed = token.TrimEnd('.', ',', '-', '/', '_');
+        var suffix = token[trimmed.Length..];
+
+        if (trimmed.Length == 0)
+        {
+            return token;
+        }
+
+        if (IsoDatePattern().IsMatch(trimmed))
+        {
+            return token;
+        }
+
+        var letters = 0;
+        var digits = 0;
+        foreach (var c in trimmed)
+        {
+            if (char.IsLetter(c))
+            {
+                letters++;
+            }
+            else if (char.IsDigit(c))
+            {
+                digits++;
+            }
+        }
+
+        if (digits == 0)
+        {
+            return token;
+        }
+
+        if (letters > 0)
+        {
+            // Mixed alphanumeric tokens that carry an account keyword, or three or more
+            // digits, look like account or ledger identifiers (ACC001, ACCT-42,
+            // SENTINEL-ACCOUNT-9911). Sparse references such as "ticket/RES-77" are
+            // explanatory rather than sensitive and are left intact.
+            if (HasAccountKeyword(trimmed) || digits >= 3)
+            {
+                return IdentifierMask + suffix;
+            }
+
+            return token;
+        }
+
+        var hasFraction = FractionPattern().IsMatch(trimmed);
+        var hasGrouping = trimmed.Contains(',', StringComparison.Ordinal);
+        if (hasFraction || hasGrouping || digits >= 4)
+        {
+            return AmountMask + suffix;
+        }
+
+        return token;
+    }
+
+    private static bool HasAccountKeyword(string token)
+    {
+        foreach (var keyword in AccountKeywords)
+        {
+            if (token.Contains(keyword, StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static readonly string[] AccountKeywords = ["acct", "account", "acc", "iban", "ledger", "custody"];
+
+    [GeneratedRegex(@"[A-Za-z0-9][A-Za-z0-9_.,\-/]*", RegexOptions.CultureInvariant)]
+    private static partial Regex TokenPattern();
+
+    [GeneratedRegex(@"^\d{4}-\d{2}-\d{2}$", RegexOptions.CultureInvariant)]
+    private static partial Regex IsoDatePattern();
+
+    [GeneratedRegex(@"\.\d", RegexOptions.CultureInvariant)]
+    private static partial Regex FractionPattern();
+}
