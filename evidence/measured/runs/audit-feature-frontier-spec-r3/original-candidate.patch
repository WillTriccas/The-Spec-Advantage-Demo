@@ -0,0 +1,184 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Cross-process behaviour of the audit adapter commands: durable state between separate
+/// processes and exactly one final decision under concurrent conflicting decisions
+/// (REQ-6, INV-3, NFR-2, AC-8).
+/// </summary>
+public class AuditConcurrencyTests : IDisposable
+{
+    private readonly string _state = AuditTestHarness.NewStateDirectory();
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_state))
+        {
+            Directory.Delete(_state, recursive: true);
+        }
+
+        GC.SuppressFinalize(this);
+    }
+
+    [Fact]
+    public void Workflow_state_survives_across_separate_processes()
+    {
+        var initialize = AuditTestHarness.RunProcess("initialize", "--state", _state);
+        Assert.Equal(0, initialize.ExitCode);
+        Assert.Equal("initialized", (string?)Parse(initialize.StdOut)["status"]);
+
+        var propose = AuditTestHarness.RunProcess(
+            "propose",
+            "--state", _state,
+            "--request-id", "REQ-CLI-1",
+            "--proposer", "maker-a",
+            "--business-date", "2024-06-03",
+            "--reason", "Broker confirmed the break",
+            "--evidence", "ticket/RES-9");
+        Assert.Equal(0, propose.ExitCode);
+        Assert.Equal("proposed", (string?)Parse(propose.StdOut)["status"]);
+
+        var decide = AuditTestHarness.RunProcess(
+            "decide",
+            "--state", _state,
+            "--request-id", "REQ-CLI-1",
+            "--approver", "checker-b",
+            "--decision", "approve");
+        Assert.Equal(0, decide.ExitCode);
+        Assert.Equal("approved", (string?)Parse(decide.StdOut)["status"]);
+
+        var exportPath = Path.Combine(_state, "export", "history.json");
+        var export = AuditTestHarness.RunProcess(
+            "export",
+            "--state", _state,
+            "--from", "2024-06-01",
+            "--to", "2024-06-30",
+            "--export-path", exportPath);
+
+        Assert.Equal(0, export.ExitCode);
+        Assert.True(File.Exists(exportPath));
+
+        foreach (var document in new[] { Parse(export.StdOut), (JsonObject)JsonNode.Parse(File.ReadAllText(exportPath))! })
+        {
+            var entries = AuditTestHarness.Entries(document);
+            Assert.Equal(2, entries.Count);
+            Assert.Equal("REQ-CLI-1", AuditTestHarness.Field((JsonObject)entries[0]!, "requestId"));
+            Assert.Equal("APPROVED", AuditTestHarness.Field((JsonObject)entries[1]!, "action"));
+            Assert.Equal("checker-b", AuditTestHarness.Field((JsonObject)entries[1]!, "checker"));
+        }
+    }
+
+    [Fact]
+    public void Self_approval_from_a_separate_process_is_refused_with_a_declared_outcome()
+    {
+        AuditTestHarness.RunProcess("initialize", "--state", _state);
+        AuditTestHarness.RunProcess(
+            "propose",
+            "--state", _state,
+            "--request-id", "REQ-CLI-2",
+            "--proposer", "maker-a",
+            "--business-date", "2024-06-03",
+            "--reason", "Broker confirmed the break",
+            "--evidence", "ticket/RES-9");
+
+        var denied = AuditTestHarness.RunProcess(
+            "decide",
+            "--state", _state,
+            "--request-id", "REQ-CLI-2",
+            "--approver", "maker-a",
+            "--decision", "approve");
+
+        Assert.Equal(AuditCommandResult.ExitRejected, denied.ExitCode);
+        Assert.Equal("self_approval_denied", (string?)Parse(denied.StdOut)["status"]);
+
+        var finals = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-CLI-2")
+            .Where(entry => AuditTestHarness.Field(entry, "action") is "APPROVED" or "REJECTED");
+        Assert.Empty(finals);
+    }
+
+    [Fact]
+    public async Task Concurrent_conflicting_decisions_leave_exactly_one_final_decision()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-RACE", "maker-a", "2024-06-03", "Broker confirmed the break", "ticket/RES-9");
+
+        var approve = Task.Run(() => AuditTestHarness.RunProcess(
+            "decide", "--state", _state, "--request-id", "REQ-RACE", "--approver", "checker-b", "--decision", "approve"));
+        var reject = Task.Run(() => AuditTestHarness.RunProcess(
+            "decide", "--state", _state, "--request-id", "REQ-RACE", "--approver", "checker-c", "--decision", "reject"));
+
+        var outcomes = await Task.WhenAll(approve, reject);
+
+        foreach (var outcome in outcomes)
+        {
+            Assert.Contains(outcome.ExitCode, new[] { AuditCommandResult.ExitAccepted, AuditCommandResult.ExitRejected });
+            Assert.NotNull(JsonNode.Parse(outcome.StdOut));
+        }
+
+        Assert.Equal(1, outcomes.Count(outcome => outcome.ExitCode == AuditCommandResult.ExitAccepted));
+
+        var finals = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-RACE")
+            .Where(entry => AuditTestHarness.Field(entry, "action") is "APPROVED" or "REJECTED")
+            .ToList();
+
+        var final = Assert.Single(finals);
+        Assert.False(string.IsNullOrWhiteSpace(AuditTestHarness.Field(final, "checker")));
+        Assert.NotEqual("maker-a", AuditTestHarness.Field(final, "checker"));
+        Assert.Equal(2, AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-RACE").Count());
+    }
+
+    [Fact]
+    public async Task Concurrent_identical_approvals_stay_idempotent()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-RETRY", "maker-a", "2024-06-03", "Broker confirmed the break", "ticket/RES-9");
+
+        var attempts = Enumerable.Range(0, 4)
+            .Select(_ => Task.Run(() => AuditTestHarness.RunProcess(
+                "decide", "--state", _state, "--request-id", "REQ-RETRY", "--approver", "checker-b", "--decision", "approve")))
+            .ToArray();
+
+        var outcomes = await Task.WhenAll(attempts);
+
+        Assert.All(outcomes, outcome => Assert.Equal(AuditCommandResult.ExitAccepted, outcome.ExitCode));
+
+        var finals = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-RETRY")
+            .Where(entry => AuditTestHarness.Field(entry, "action") is "APPROVED" or "REJECTED")
+            .ToList();
+        Assert.Single(finals);
+    }
+
+    [Fact]
+    public async Task Concurrent_proposals_for_one_request_create_a_single_proposal()
+    {
+        AuditTestHarness.Service(_state).Initialize();
+
+        var attempts = Enumerable.Range(0, 4)
+            .Select(_ => Task.Run(() => AuditTestHarness.RunProcess(
+                "propose",
+                "--state", _state,
+                "--request-id", "REQ-PARALLEL",
+                "--proposer", "maker-a",
+                "--business-date", "2024-06-03",
+                "--reason", "Broker confirmed the break",
+                "--evidence", "ticket/RES-9")))
+            .ToArray();
+
+        var outcomes = await Task.WhenAll(attempts);
+
+        Assert.All(outcomes, outcome => Assert.Equal(AuditCommandResult.ExitAccepted, outcome.ExitCode));
+        Assert.Single(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-PARALLEL"));
+    }
+
+    private static JsonObject Parse(string stdout)
+    {
+        var node = JsonNode.Parse(stdout);
+        Assert.NotNull(node);
+        return (JsonObject)node!;
+    }
+}
