@@ -0,0 +1,74 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://benchmark.local/contracts/audit-adapter.schema.json",
+  "title": "Audit adapter contract",
+  "description": "Data-only, shell-free command contract exposing the maker-checker break-resolution audit workflow to an external evaluator. The evaluator owns every path and substitutes the documented placeholders into the argument arrays.",
+  "type": "object",
+  "required": [
+    "schemaVersion",
+    "initialize",
+    "propose",
+    "decide",
+    "export"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "type": "string",
+      "description": "Version of this adapter contract."
+    },
+    "workingDirectory": {
+      "type": "string",
+      "description": "Directory, relative to the candidate root, that every command is executed from.",
+      "default": "."
+    },
+    "initialize": {
+      "$ref": "#/$defs/command",
+      "description": "Creates durable workflow state. Placeholders: {stateDirectory}."
+    },
+    "propose": {
+      "$ref": "#/$defs/command",
+      "description": "Records a maker's proposed resolution. Placeholders: {stateDirectory}, {requestId}, {proposer}, {businessDate}, {reason}, {evidence}."
+    },
+    "decide": {
+      "$ref": "#/$defs/command",
+      "description": "Records a checker's approval or rejection. Placeholders: {stateDirectory}, {requestId}, {approver}, {decision}."
+    },
+    "export": {
+      "$ref": "#/$defs/command",
+      "description": "Exports durable history for an inclusive business-date range. Placeholders: {stateDirectory}, {fromDate}, {toDate}, {exportPath}."
+    }
+  },
+  "$defs": {
+    "command": {
+      "type": "object",
+      "required": [
+        "executable",
+        "arguments"
+      ],
+      "properties": {
+        "executable": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Executable name or path; never a shell string."
+        },
+        "arguments": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "Argument vector passed verbatim to the executable after placeholder substitution."
+        },
+        "allowedExitCodes": {
+          "type": "array",
+          "items": {
+            "type": "integer"
+          },
+          "default": [
+            0
+          ],
+          "description": "Exit codes that represent a completed command. Every allowed exit code still produces parseable JSON on stdout (or, for export, at {exportPath})."
+        }
+      }
+    }
+  }
+}
diff --git a/src/TradeRecon.Audit/AuditCommandResult.cs b/src/TradeRecon.Audit/AuditCommandResult.cs
new file mode 100644
index 0000000..bc3ec18
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditCommandResult.cs
@@ -0,0 +1,29 @@
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// The machine-readable outcome of one audit workflow command.
+/// Every command produces one of these, for accepted and rejected outcomes alike, so the
+/// adapter contract always has parseable JSON to report (NFR-5).
+/// </summary>
+public sealed record AuditCommandResult
+{
+    /// <summary>Command completed and the requested state change is durable (or already was).</summary>
+    public const int ExitAccepted = 0;
+
+    /// <summary>Command completed but the request was refused by a control rule.</summary>
+    public const int ExitRejected = 3;
+
+    public required string Command { get; init; }
+
+    public required string Status { get; init; }
+
+    public required bool Accepted { get; init; }
+
+    public required JsonObject Payload { get; init; }
+
+    public int ExitCode => Accepted ? ExitAccepted : ExitRejected;
+
+    public string ToJson() => Payload.ToJsonString(AuditJson.CompactOptions);
+}
diff --git a/src/TradeRecon.Audit/AuditEntry.cs b/src/TradeRecon.Audit/AuditEntry.cs
new file mode 100644
index 0000000..68c1b21
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditEntry.cs
@@ -0,0 +1,142 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Lifecycle actions recorded in the append-only audit history.</summary>
+public static class AuditActions
+{
+    public const string Proposed = "PROPOSED";
+    public const string Approved = "APPROVED";
+    public const string Rejected = "REJECTED";
+
+    public static bool IsTerminal(string action)
+        => string.Equals(action, Approved, StringComparison.Ordinal)
+           || string.Equals(action, Rejected, StringComparison.Ordinal);
+}
+
+/// <summary>
+/// One immutable entry of the append-only maker-checker history.
+///
+/// Every entry carries the request identity, the lifecycle action, the recognised
+/// proposer/checker identities and the tamper-evidence metadata (contiguous 1-based
+/// <see cref="Sequence"/>, <see cref="PreviousHash"/> link and SHA-256 <see cref="Hash"/>).
+/// Only allow-listed fields are serialised; no reconciliation payload is ever attached.
+/// </summary>
+public sealed record AuditEntry
+{
+    public const string EntrySchemaVersion = "1.0";
+
+    public required int Sequence { get; init; }
+
+    public required int RequestSequence { get; init; }
+
+    public required string RequestId { get; init; }
+
+    public required string Action { get; init; }
+
+    public required string Actor { get; init; }
+
+    public required string Proposer { get; init; }
+
+    public string? Checker { get; init; }
+
+    public required string BusinessDate { get; init; }
+
+    public required string Reason { get; init; }
+
+    public required string Evidence { get; init; }
+
+    public required string Timestamp { get; init; }
+
+    public string? PreviousHash { get; init; }
+
+    public string Hash { get; init; } = string.Empty;
+
+    public string? Decision => AuditActions.IsTerminal(Action) ? Action : null;
+
+    /// <summary>Builds the allow-listed JSON projection of this entry.</summary>
+    public JsonObject ToJsonObject(bool includeHash = true)
+    {
+        var obj = new JsonObject
+        {
+            ["schemaVersion"] = EntrySchemaVersion,
+            ["sequence"] = Sequence,
+            ["requestSequence"] = RequestSequence,
+            ["version"] = RequestSequence,
+            ["requestId"] = RequestId,
+            ["action"] = Action,
+            ["eventType"] = Action,
+            ["status"] = Action,
+            ["decision"] = Decision,
+            ["actor"] = Actor,
+            ["proposer"] = Proposer,
+            ["checker"] = Checker,
+            ["businessDate"] = BusinessDate,
+            ["reason"] = Reason,
+            ["evidence"] = Evidence,
+            ["timestamp"] = Timestamp,
+            ["previousHash"] = PreviousHash
+        };
+
+        if (includeHash)
+        {
+            obj["hash"] = Hash;
+        }
+
+        return obj;
+    }
+
+    /// <summary>
+    /// Lowercase SHA-256 over the canonical JSON of this entry without its <c>hash</c>
+    /// property, with object keys sorted recursively.
+    /// </summary>
+    public string ComputeHash()
+    {
+        var canonical = CanonicalJson.Serialize(ToJsonObject(includeHash: false));
+        var digest = SHA256.HashData(Encoding.UTF8.GetBytes(canonical));
+        return Convert.ToHexString(digest).ToLowerInvariant();
+    }
+
+    public AuditEntry WithComputedHash() => this with { Hash = ComputeHash() };
+
+    public static AuditEntry FromJson(string line)
+    {
+        var node = JsonNode.Parse(line) as JsonObject
+                   ?? throw new FormatException("Audit history line is not a JSON object.");
+
+        return new AuditEntry
+        {
+            Sequence = ReadInt(node, "sequence"),
+            RequestSequence = ReadInt(node, "requestSequence"),
+            RequestId = ReadString(node, "requestId"),
+            Action = ReadString(node, "action"),
+            Actor = ReadString(node, "actor"),
+            Proposer = ReadString(node, "proposer"),
+            Checker = ReadOptionalString(node, "checker"),
+            BusinessDate = ReadString(node, "businessDate"),
+            Reason = ReadString(node, "reason"),
+            Evidence = ReadString(node, "evidence"),
+            Timestamp = ReadString(node, "timestamp"),
+            PreviousHash = ReadOptionalString(node, "previousHash"),
+            Hash = ReadString(node, "hash")
+        };
+    }
+
+    public DateOnly BusinessDateValue
+        => DateOnly.ParseExact(BusinessDate, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+    private static string ReadString(JsonObject node, string name)
+        => ReadOptionalString(node, name)
+           ?? throw new FormatException($"Audit history entry is missing required field '{name}'.");
+
+    private static string? ReadOptionalString(JsonObject node, string name)
+        => node.TryGetPropertyValue(name, out var value) ? value?.GetValue<string>() : null;
+
+    private static int ReadInt(JsonObject node, string name)
+        => node.TryGetPropertyValue(name, out var value) && value is not null
+            ? value.GetValue<int>()
+            : throw new FormatException($"Audit history entry is missing required field '{name}'.");
+}
diff --git a/src/TradeRecon.Audit/AuditHistoryStore.cs b/src/TradeRecon.Audit/AuditHistoryStore.cs
new file mode 100644
index 0000000..a10a541
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditHistoryStore.cs
@@ -0,0 +1,242 @@
+using System.Globalization;
+using System.Text;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Append-only, cross-process durable store for the maker-checker lifecycle history.
+///
+/// The history is a JSON-lines file beneath the evaluator-owned state directory. Entries
+/// are only ever appended; existing lines are never rewritten (INV-2). All read-modify-append
+/// sequences run under an exclusive OS file lock so that concurrent processes cannot
+/// interleave a decision check with its append (INV-3, RISK-3).
+/// </summary>
+public sealed class AuditHistoryStore
+{
+    public const string AuditDirectoryName = "audit";
+    public const string HistoryFileName = "history.jsonl";
+    private const string LockFileName = ".audit.lock";
+
+    private static readonly TimeSpan DefaultLockTimeout = TimeSpan.FromSeconds(60);
+
+    private readonly string _stateDirectory;
+    private readonly string _auditDirectory;
+
+    public AuditHistoryStore(string stateDirectory)
+    {
+        if (string.IsNullOrWhiteSpace(stateDirectory))
+        {
+            throw new ArgumentException("A state directory is required.", nameof(stateDirectory));
+        }
+
+        _stateDirectory = Path.GetFullPath(stateDirectory);
+        _auditDirectory = Path.Combine(_stateDirectory, AuditDirectoryName);
+        HistoryPath = Path.Combine(_auditDirectory, HistoryFileName);
+        LockPath = Path.Combine(_auditDirectory, LockFileName);
+    }
+
+    public string StateDirectory => _stateDirectory;
+
+    public string HistoryPath { get; }
+
+    public string LockPath { get; }
+
+    /// <summary>Creates the durable layout. Safe to call repeatedly and from several processes.</summary>
+    public void EnsureCreated()
+    {
+        Directory.CreateDirectory(_auditDirectory);
+
+        if (File.Exists(HistoryPath))
+        {
+            return;
+        }
+
+        try
+        {
+            using var stream = new FileStream(HistoryPath, FileMode.CreateNew, FileAccess.Write, FileShare.ReadWrite);
+        }
+        catch (IOException) when (File.Exists(HistoryPath))
+        {
+            // Another process created the history first; that is the desired end state.
+        }
+    }
+
+    public bool IsInitialized => File.Exists(HistoryPath);
+
+    /// <summary>Takes the exclusive cross-process gate protecting read-modify-append sequences.</summary>
+    public IDisposable AcquireExclusiveAccess(TimeSpan? timeout = null)
+    {
+        EnsureCreated();
+
+        var deadline = DateTime.UtcNow + (timeout ?? DefaultLockTimeout);
+        var delayMilliseconds = 5;
+
+        while (true)
+        {
+            try
+            {
+                return new FileLease(new FileStream(
+                    LockPath,
+                    FileMode.OpenOrCreate,
+                    FileAccess.ReadWrite,
+                    FileShare.None,
+                    bufferSize: 1,
+                    FileOptions.None));
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new TimeoutException("Timed out waiting for exclusive access to the audit history.");
+                }
+
+                Thread.Sleep(delayMilliseconds);
+                delayMilliseconds = Math.Min(delayMilliseconds * 2, 50);
+            }
+        }
+    }
+
+    /// <summary>Reads the full ordered history and verifies its sequence and hash chain.</summary>
+    public IReadOnlyList<AuditEntry> ReadAll()
+    {
+        if (!File.Exists(HistoryPath))
+        {
+            return Array.Empty<AuditEntry>();
+        }
+
+        var entries = new List<AuditEntry>();
+        foreach (var line in File.ReadAllLines(HistoryPath))
+        {
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            entries.Add(AuditEntry.FromJson(line));
+        }
+
+        VerifyChain(entries);
+        return entries;
+    }
+
+    /// <summary>
+    /// Appends one entry to the history. The caller must already hold
+    /// <see cref="AcquireExclusiveAccess"/> and must pass the history it validated against.
+    /// </summary>
+    public AuditEntry Append(IReadOnlyList<AuditEntry> current, AuditEntryDraft draft)
+    {
+        ArgumentNullException.ThrowIfNull(current);
+        ArgumentNullException.ThrowIfNull(draft);
+
+        var previous = current.Count == 0 ? null : current[^1];
+        var timestamp = NextTimestamp(previous?.Timestamp);
+
+        var entry = new AuditEntry
+        {
+            Sequence = current.Count + 1,
+            RequestSequence = draft.RequestSequence,
+            RequestId = draft.RequestId,
+            Action = draft.Action,
+            Actor = draft.Actor,
+            Proposer = draft.Proposer,
+            Checker = draft.Checker,
+            BusinessDate = draft.BusinessDate,
+            Reason = draft.Reason,
+            Evidence = draft.Evidence,
+            Timestamp = timestamp,
+            PreviousHash = previous?.Hash
+        }.WithComputedHash();
+
+        var line = System.Text.Json.JsonSerializer.Serialize(
+            entry.ToJsonObject(),
+            AuditJson.CompactOptions);
+
+        using var stream = new FileStream(
+            HistoryPath,
+            FileMode.Append,
+            FileAccess.Write,
+            FileShare.Read,
+            bufferSize: 4096,
+            FileOptions.None);
+        using var writer = new StreamWriter(stream, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+        writer.Write(line);
+        writer.Write('\n');
+        writer.Flush();
+        stream.Flush(flushToDisk: true);
+
+        return entry;
+    }
+
+    /// <summary>Verifies contiguous 1-based ordering and the SHA-256 previous-hash chain.</summary>
+    public static void VerifyChain(IReadOnlyList<AuditEntry> entries)
+    {
+        string? previousHash = null;
+        for (var i = 0; i < entries.Count; i++)
+        {
+            var entry = entries[i];
+            if (entry.Sequence != i + 1)
+            {
+                throw new InvalidDataException(
+                    $"Audit history is not contiguous: expected sequence {i + 1} but found {entry.Sequence}.");
+            }
+
+            if (!string.Equals(entry.PreviousHash, previousHash, StringComparison.Ordinal))
+            {
+                throw new InvalidDataException(
+                    $"Audit history hash chain is broken at sequence {entry.Sequence}.");
+            }
+
+            if (!string.Equals(entry.Hash, entry.ComputeHash(), StringComparison.Ordinal))
+            {
+                throw new InvalidDataException(
+                    $"Audit history entry {entry.Sequence} does not match its recorded hash.");
+            }
+
+            previousHash = entry.Hash;
+        }
+    }
+
+    private static string NextTimestamp(string? previousTimestamp)
+    {
+        var now = DateTime.UtcNow;
+        if (previousTimestamp is not null
+            && DateTime.TryParse(
+                previousTimestamp,
+                CultureInfo.InvariantCulture,
+                DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal,
+                out var previous)
+            && now <= previous)
+        {
+            now = previous.AddTicks(1);
+        }
+
+        return now.ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ", CultureInfo.InvariantCulture);
+    }
+
+    private sealed class FileLease(FileStream stream) : IDisposable
+    {
+        public void Dispose() => stream.Dispose();
+    }
+}
+
+/// <summary>The mutable inputs of a new history entry; ordering metadata is assigned by the store.</summary>
+public sealed class AuditEntryDraft
+{
+    public required string RequestId { get; init; }
+
+    public required string Action { get; init; }
+
+    public required string Actor { get; init; }
+
+    public required string Proposer { get; init; }
+
+    public string? Checker { get; init; }
+
+    public required string BusinessDate { get; init; }
+
+    public required string Reason { get; init; }
+
+    public required string Evidence { get; init; }
+
+    public required int RequestSequence { get; init; }
+}
