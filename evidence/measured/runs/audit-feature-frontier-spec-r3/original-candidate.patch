+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Lifecycle behaviour of the maker-checker break-resolution workflow
+/// (REQ-2, REQ-3, REQ-5, REQ-7 and the matching acceptance criteria).
+/// </summary>
+public class AuditWorkflowTests : IDisposable
+{
+    private readonly string _state = AuditTestHarness.NewStateDirectory();
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_state))
+        {
+            Directory.Delete(_state, recursive: true);
+        }
+
+        GC.SuppressFinalize(this);
+    }
+
+    [Fact]
+    public void Initialize_creates_durable_state_and_is_repeatable()
+    {
+        var service = AuditTestHarness.Service(_state);
+
+        var first = service.Initialize();
+        var second = service.Initialize();
+
+        Assert.True(first.Accepted);
+        Assert.True(second.Accepted);
+        Assert.Equal("initialized", second.Status);
+        Assert.True(File.Exists(Path.Combine(_state, "audit", "history.jsonl")));
+        Assert.Equal(0, (int)second.Payload["entryCount"]!);
+    }
+
+    [Fact]
+    public void Proposal_is_durably_recorded_for_its_maker()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+
+        var result = service.Propose("REQ-100", "maker-a", "2024-06-03", "Broker confirmed the break", "ticket/RES-77");
+
+        Assert.True(result.Accepted);
+        Assert.Equal("proposed", result.Status);
+
+        var entries = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-100").ToList();
+        var proposal = Assert.Single(entries);
+        Assert.Equal("PROPOSED", AuditTestHarness.Field(proposal, "action"));
+        Assert.Equal("maker-a", AuditTestHarness.Field(proposal, "proposer"));
+        Assert.Equal("2024-06-03", AuditTestHarness.Field(proposal, "businessDate"));
+        Assert.Equal("Broker confirmed the break", AuditTestHarness.Field(proposal, "reason"));
+        Assert.Equal("ticket/RES-77", AuditTestHarness.Field(proposal, "evidence"));
+        Assert.Equal(1, (int)proposal["sequence"]!);
+        Assert.Null(proposal["previousHash"]?.GetValue<string?>());
+    }
+
+    [Theory]
+    [InlineData("", "ticket/RES-1")]
+    [InlineData("   ", "ticket/RES-1")]
+    [InlineData("Reason", "")]
+    [InlineData("Reason", "  ")]
+    public void Proposal_without_reason_or_evidence_writes_no_history(string reason, string evidence)
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+
+        var result = service.Propose("REQ-EMPTY", "maker-a", "2024-06-03", reason, evidence);
+
+        Assert.False(result.Accepted);
+        Assert.Equal(AuditCommandResult.ExitRejected, result.ExitCode);
+        Assert.Empty(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-EMPTY"));
+    }
+
+    [Fact]
+    public void Proposal_with_invalid_business_date_writes_no_history()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+
+        var result = service.Propose("REQ-BADDATE", "maker-a", "03/06/2024", "Reason", "Evidence");
+
+        Assert.False(result.Accepted);
+        Assert.Equal("invalid_business_date", result.Status);
+        Assert.Empty(AuditTestHarness.Entries(AuditTestHarness.Export(_state)));
+    }
+
+    [Fact]
+    public void Repeated_proposal_by_the_same_maker_is_idempotent()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-101", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var repeat = service.Propose("REQ-101", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        Assert.True(repeat.Accepted);
+        Assert.Equal("duplicate", repeat.Status);
+        Assert.Single(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-101"));
+    }
+
+    [Fact]
+    public void Proposal_reusing_another_makers_request_id_is_refused()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-102", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var hijack = service.Propose("REQ-102", "maker-b", "2024-06-03", "Different story", "ticket/RES-2");
+
+        Assert.False(hijack.Accepted);
+        Assert.Single(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-102"));
+    }
+
+    [Fact]
+    public void Self_approval_is_refused_and_leaves_no_final_decision()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-200", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var denied = service.Decide("REQ-200", "maker-a", "approve");
+
+        Assert.False(denied.Accepted);
+        Assert.Equal("self_approval_denied", denied.Status);
+
+        var entries = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-200").ToList();
+        Assert.Single(entries);
+        Assert.DoesNotContain(entries, e => AuditTestHarness.Field(e, "action") is "APPROVED" or "REJECTED");
+    }
+
+    [Fact]
+    public void Self_approval_is_refused_regardless_of_identity_casing_and_padding()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-201", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var denied = service.Decide("REQ-201", "  MAKER-A ", "reject");
+
+        Assert.False(denied.Accepted);
+        Assert.Equal("self_approval_denied", denied.Status);
+        Assert.Single(AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-201"));
+    }
+
+    [Fact]
+    public void Distinct_checker_creates_exactly_one_approved_entry()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-300", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var approval = service.Decide("REQ-300", "checker-b", "approve");
+
+        Assert.True(approval.Accepted);
+        Assert.Equal("approved", approval.Status);
+
+        var entries = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-300").ToList();
+        Assert.Equal(2, entries.Count);
+
+        var final = Assert.Single(entries, e => AuditTestHarness.Field(e, "action") is "APPROVED" or "REJECTED");
+        Assert.Equal("APPROVED", AuditTestHarness.Field(final, "action"));
+        Assert.Equal("APPROVED", AuditTestHarness.Field(final, "eventType"));
+        Assert.Equal("APPROVED", AuditTestHarness.Field(final, "status"));
+        Assert.Equal("checker-b", AuditTestHarness.Field(final, "checker"));
+        Assert.Equal("maker-a", AuditTestHarness.Field(final, "proposer"));
+        Assert.NotEqual(
+            AuditTestHarness.Field(final, "proposer"),
+            AuditTestHarness.Field(final, "checker"));
+    }
+
+    [Fact]
+    public void Distinct_checker_can_reject()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-301", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+
+        var rejection = service.Decide("REQ-301", "checker-c", "reject");
+
+        Assert.True(rejection.Accepted);
+        Assert.Equal("rejected", rejection.Status);
+
+        var final = Assert.Single(
+            AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-301"),
+            e => AuditTestHarness.Field(e, "action") is "APPROVED" or "REJECTED");
+        Assert.Equal("REJECTED", AuditTestHarness.Field(final, "action"));
+        Assert.Equal("checker-c", AuditTestHarness.Field(final, "checker"));
+    }
+
+    [Fact]
+    public void Repeating_an_accepted_decision_is_idempotent()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-400", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        var first = service.Decide("REQ-400", "checker-b", "approve");
+
+        var repeat = service.Decide("REQ-400", "checker-b", "approve");
+
+        Assert.True(repeat.Accepted);
+        Assert.Equal("duplicate", repeat.Status);
+        Assert.True((bool)repeat.Payload["idempotent"]!);
+        Assert.Equal((string?)first.Payload["hash"], (string?)repeat.Payload["hash"]);
+
+        var finals = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-400")
+            .Where(e => AuditTestHarness.Field(e, "action") is "APPROVED" or "REJECTED");
+        Assert.Single(finals);
+    }
+
+    [Fact]
+    public void A_second_conflicting_decision_is_refused()
+    {
+        var service = AuditTestHarness.Service(_state);
+        service.Initialize();
+        service.Propose("REQ-401", "maker-a", "2024-06-03", "Broker confirmed", "ticket/RES-1");
+        service.Decide("REQ-401", "checker-b", "approve");
+
+        var conflicting = service.Decide("REQ-401", "checker-c", "reject");
+
+        Assert.False(conflicting.Accepted);
+        Assert.Equal("conflict", conflicting.Status);
+        Assert.Equal("APPROVED", (string?)conflicting.Payload["finalDecision"]);
+
+        var finals = AuditTestHarness.EntriesFor(AuditTestHarness.Export(_state), "REQ-401")
+            .Where(e => AuditTestHarness.Field(e, "action") is "APPROVED" or "REJECTED");
+        Assert.Single(finals);
+    }
+
+    [Fact]
+    public void Deciding_an_unknown_request_writes_no_history()
+    {
