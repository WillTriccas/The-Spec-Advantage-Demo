+    private sealed class AuditStateLock : IDisposable
+    {
+        private readonly FileStream _stream;
+
+        public AuditStateLock(string stateDirectory)
+        {
+            Directory.CreateDirectory(stateDirectory);
+            _stream = new FileStream(Path.Combine(stateDirectory, "audit.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+        }
+
+        public Task AcquireAsync()
+        {
+            if (OperatingSystem.IsWindows())
+            {
+                _stream.Lock(0, 0);
+            }
+
+            return Task.CompletedTask;
+        }
+
+        public void Dispose()
+        {
+            if (OperatingSystem.IsWindows())
+            {
+                _stream.Unlock(0, 0);
+            }
+
+            _stream.Dispose();
+        }
+    }
