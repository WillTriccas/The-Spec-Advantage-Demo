+    private static bool IsAuditCommand(string command)
+        => string.Equals(command, AuditCommandInitialize, StringComparison.OrdinalIgnoreCase)
+            || string.Equals(command, AuditCommandPropose, StringComparison.OrdinalIgnoreCase)
+            || string.Equals(command, AuditCommandDecide, StringComparison.OrdinalIgnoreCase)
+            || string.Equals(command, AuditCommandExport, StringComparison.OrdinalIgnoreCase)
+            || string.Equals(command, AuditCommandHelp, StringComparison.OrdinalIgnoreCase);
+
+    private static async Task<int> HandleAuditCommandAsync(string[] args)
+    {
+        var request = args[0];
+        try
+        {
+            if (string.Equals(request, AuditCommandHelp, StringComparison.OrdinalIgnoreCase)
+                || args.Contains("--help", StringComparer.OrdinalIgnoreCase)
+                || args.Contains("-h", StringComparer.OrdinalIgnoreCase))
+            {
+                WriteAuditJson(new
+                {
+                    ok = true,
+                    action = "help",
+                    commands = new[]
+                    {
+                        AuditCommandInitialize,
+                        AuditCommandPropose,
+                        AuditCommandDecide,
+                        AuditCommandExport
+                    },
+                    usage = "initialize|propose|decide|export"
+                });
+                return ExitClean;
+            }
+
+            return request.ToLowerInvariant() switch
+            {
+                "initialize" => await RunInitializeAsync(args).ConfigureAwait(false),
+                "propose" => await RunProposeAsync(args).ConfigureAwait(false),
+                "decide" => await RunDecideAsync(args).ConfigureAwait(false),
+                "export" => await RunExportAsync(args).ConfigureAwait(false),
+                _ => ExitError
+            };
+        }
+        catch (Exception ex)
+        {
+            WriteAuditJson(new { ok = false, error = SanitizeOutput(ex.Message) });
+            return ExitError;
+        }
+    }
