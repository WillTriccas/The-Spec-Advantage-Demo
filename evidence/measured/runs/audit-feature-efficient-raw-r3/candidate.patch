+    private static string GetRequiredValue(string[] args, params string[] optionNames)
+    {
+        foreach (var optionName in optionNames)
+        {
+            var index = Array.FindIndex(args, arg => string.Equals(arg, optionName, StringComparison.OrdinalIgnoreCase));
+            if (index >= 0)
+            {
+                if (index + 1 >= args.Length || args[index + 1].StartsWith("--", StringComparison.Ordinal))
+                {
+                    throw new ArgumentException($"Option {optionName} requires a value.");
+                }
+
+                return args[index + 1];
+            }
+        }
+
+        throw new ArgumentException($"Missing required option ({string.Join(", ", optionNames)}).");
+    }
