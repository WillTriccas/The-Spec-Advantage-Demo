+                var requestMatches = string.Equals(existing.Proposer, proposer, StringComparison.OrdinalIgnoreCase)
+                    && string.Equals(existing.BusinessDate, businessDate, StringComparison.OrdinalIgnoreCase)
+                    && string.Equals(existing.Reason, reason, StringComparison.Ordinal)
