+            businessDate = SanitizeOutput(entry.BusinessDate),
+            timestamp = SanitizeOutput(entry.Timestamp),
+            sequence = entry.Sequence,
+            version = entry.Version,
+            hash = SanitizeOutput(entry.Hash),
+            previousHash = SanitizeOutput(entry.PreviousHash),
+            decision = SanitizeOutput(entry.Decision),
+            isFinalDecision = entry.IsFinalDecision,
+            reason = SanitizeOutput(entry.Reason),
