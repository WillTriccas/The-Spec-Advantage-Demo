+    private static async Task<AuditState> ReadStateAsync(string stateDirectory)
+    {
+        Directory.CreateDirectory(stateDirectory);
+        var statePath = Path.Combine(stateDirectory, "audit-state.json");
+        if (!File.Exists(statePath))
+        {
+            return new AuditState
+            {
+                Version = 1,
+                Sequence = 0,
+                Entries = new List<AuditEntry>(),
+                Requests = new Dictionary<string, AuditRequestRecord>(StringComparer.OrdinalIgnoreCase)
+            };
+        }
+
+        var json = await File.ReadAllTextAsync(statePath).ConfigureAwait(false);
+        if (string.IsNullOrWhiteSpace(json))
+        {
+            return new AuditState
+            {
+                Version = 1,
+                Sequence = 0,
+                Entries = new List<AuditEntry>(),
+                Requests = new Dictionary<string, AuditRequestRecord>(StringComparer.OrdinalIgnoreCase)
+            };
+        }
+
+        var state = JsonSerializer.Deserialize<AuditState>(json, AuditJsonOptions)
+            ?? new AuditState
+            {
+                Version = 1,
+                Sequence = 0,
+                Entries = new List<AuditEntry>(),
+                Requests = new Dictionary<string, AuditRequestRecord>(StringComparer.OrdinalIgnoreCase)
+            };
+
+        state.Entries ??= new List<AuditEntry>();
+        state.Requests ??= new Dictionary<string, AuditRequestRecord>(StringComparer.OrdinalIgnoreCase);
+        return state;
+    }
+
+    private static async Task WriteStateAsync(string stateDirectory, AuditState state)
+    {
+        var statePath = Path.Combine(stateDirectory, "audit-state.json");
+        var tempPath = Path.Combine(stateDirectory, $"audit-state-{Guid.NewGuid():N}.tmp");
+        var payload = JsonSerializer.Serialize(state, AuditJsonOptions);
+        await File.WriteAllTextAsync(tempPath, payload).ConfigureAwait(false);
+        File.Move(tempPath, statePath, overwrite: true);
+    }
