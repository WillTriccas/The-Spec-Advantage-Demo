+    private static AuditEntry CreateAuditEntry(AuditState state, string requestId, string action, string actor, string role, string businessDate)
+    {
+        var previousHash = state.Entries.Count > 0 ? state.Entries[^1].Hash : "genesis";
+        var timestamp = DateTimeOffset.UtcNow.ToString("O");
+        var sequence = state.Sequence + 1;
+        var entry = new AuditEntry
+        {
+            RequestId = requestId,
+            Action = action,
+            Actor = actor,
+            Role = role,
+            BusinessDate = businessDate,
+            Timestamp = timestamp,
+            Sequence = sequence,
+            Version = state.Version,
+            PreviousHash = previousHash,
+            Decision = null,
+            IsFinalDecision = false
+        };
+
+        var payload = JsonSerializer.Serialize(new
+        {
+            requestId = entry.RequestId,
+            action = entry.Action,
+            actor = entry.Actor,
+            role = entry.Role,
+            businessDate = entry.BusinessDate,
+            timestamp = entry.Timestamp,
+            sequence = entry.Sequence,
+            version = entry.Version,
+            previousHash = entry.PreviousHash,
+            decision = entry.Decision,
+            isFinalDecision = entry.IsFinalDecision,
+            reason = entry.Reason,
+            evidence = entry.Evidence
+        }, AuditJsonOptions);
+
+        entry.Hash = ComputeHash(previousHash + "|" + payload);
+        state.Sequence = sequence;
+        return entry;
+    }
+
+    private static string ComputeHash(string value)
+    {
+        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(value));
+        return Convert.ToHexString(bytes).ToLowerInvariant();
+    }
