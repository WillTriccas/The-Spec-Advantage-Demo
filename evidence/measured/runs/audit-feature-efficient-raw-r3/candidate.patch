+    private static string SanitizeOutput(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return string.Empty;
+        }
+
+        var sanitized = value;
+        sanitized = Regex.Replace(sanitized, @"(?i)\b(?:account|acct|customer|trade|settlement)[\s:=/-]*[A-Z0-9-]{2,}\b", "[ACCOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\bACC[A-Z0-9-]+\b", "[ACCOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b[A-Z]{2,}[0-9]{3,}\b", "[ACCOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)(?:USD|EUR|GBP|JPY|CAD|AUD|CHF|CNY|RUB|INR|NOK|SEK|MXN|NZD)\s*[-$]?\d[\d,]*(?:\.\d+)?", "[AMOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\$\d[\d,]*(?:\.\d+)?", "[AMOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b\d[\d,]*(?:\.\d+)?\b(?=\s*(?:amount|value|notional|principal|total|settlement|trade))", "[AMOUNT_REDACTED]");
+        return sanitized;
+    }
