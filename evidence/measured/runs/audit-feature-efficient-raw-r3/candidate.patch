+    private static async Task<int> RunDecideAsync(string[] args)
+    {
+        var stateDirectory = GetRequiredValue(args, "--stateDirectory", "--state-directory");
+        var requestId = SanitizeOutput(GetRequiredValue(args, "--requestId", "--request-id"));
+        var approver = SanitizeOutput(GetRequiredValue(args, "--approver"));
+        var decision = NormalizeDecision(GetRequiredValue(args, "--decision"));
+
+        Directory.CreateDirectory(stateDirectory);
+        var lockFile = new AuditStateLock(stateDirectory);
+        try
+        {
+            await lockFile.AcquireAsync().ConfigureAwait(false);
+            var state = await ReadStateAsync(stateDirectory).ConfigureAwait(false);
+            state.Requests ??= new Dictionary<string, AuditRequestRecord>(StringComparer.OrdinalIgnoreCase);
+
+            if (!state.Requests.TryGetValue(requestId, out var request))
+            {
+                throw new InvalidOperationException("request is not found.");
+            }
+
+            if (string.Equals(request.Proposer, approver, StringComparison.OrdinalIgnoreCase))
+            {
+                throw new InvalidOperationException("self-approval is not allowed.");
+            }
+
+            if (!string.IsNullOrWhiteSpace(request.FinalDecision))
+            {
+                if (string.Equals(request.FinalDecision, decision, StringComparison.OrdinalIgnoreCase)
+                    && string.Equals(request.FinalChecker, approver, StringComparison.OrdinalIgnoreCase))
+                {
+                    WriteAuditJson(new
+                    {
+                        ok = true,
+                        action = decision,
+                        requestId,
+                        approver,
+                        decision,
+                        status = decision,
+                        duplicate = true,
+                        finalDecision = request.FinalDecision,
+                        checker = request.FinalChecker,
+                        businessDate = request.BusinessDate
+                    });
+                    return ExitClean;
+                }
+
+                throw new InvalidOperationException("request already has a final decision.");
+            }
+
+            request.FinalDecision = decision;
+            request.FinalChecker = approver;
+            request.DecidedAt = DateTimeOffset.UtcNow;
+
+            var entry = CreateAuditEntry(state, requestId, decision, approver, "checker", request.BusinessDate);
+            entry.Decision = decision;
+            entry.IsFinalDecision = true;
+            entry.Reason = request.Reason;
+            entry.Evidence = request.Evidence;
+            state.Entries ??= new List<AuditEntry>();
+            state.Entries.Add(entry);
+            await WriteStateAsync(stateDirectory, state).ConfigureAwait(false);
+
+            WriteAuditJson(new
+            {
+                ok = true,
+                action = decision,
+                requestId,
+                approver,
+                decision,
+                status = decision,
+                checker = approver,
+                businessDate = request.BusinessDate,
+                sequence = entry.Sequence,
+                hash = entry.Hash,
+                finalDecision = decision,
+                duplicate = false
+            });
+            return ExitClean;
+        }
+        finally
+        {
+            lockFile.Dispose();
+        }
+    }
