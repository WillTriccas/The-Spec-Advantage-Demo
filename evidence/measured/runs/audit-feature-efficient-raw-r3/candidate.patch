+    private static async Task<int> RunExportAsync(string[] args)
+    {
+        var stateDirectory = GetRequiredValue(args, "--stateDirectory", "--state-directory");
+        var fromDate = GetRequiredValue(args, "--fromDate", "--from-date");
+        var toDate = GetRequiredValue(args, "--toDate", "--to-date");
+        var exportPath = GetRequiredValue(args, "--exportPath", "--export-path");
+
+        var lockFile = new AuditStateLock(stateDirectory);
+        try
+        {
+            await lockFile.AcquireAsync().ConfigureAwait(false);
+            var state = await ReadStateAsync(stateDirectory).ConfigureAwait(false);
+            state.Entries ??= new List<AuditEntry>();
+
+            var from = DateOnly.ParseExact(fromDate, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+            var to = DateOnly.ParseExact(toDate, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+            var filtered = state.Entries
+                .Where(entry =>
+                {
+                    if (!DateOnly.TryParseExact(entry.BusinessDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var businessDate))
+                    {
+                        return false;
+                    }
+
+                    return businessDate >= from && businessDate <= to;
+                })
+                .Select(MapEntryForExport)
+                .ToList();
+
+            var payload = new
+            {
+                ok = true,
+                action = "export",
+                fromDate,
+                toDate,
+                exportPath,
+                entries = filtered
+            };
+
+            var exportDirectory = Path.GetDirectoryName(exportPath);
+            if (!string.IsNullOrWhiteSpace(exportDirectory))
+            {
+                Directory.CreateDirectory(exportDirectory);
+            }
+
+            await File.WriteAllTextAsync(exportPath, JsonSerializer.Serialize(payload, AuditJsonOptions) + Environment.NewLine).ConfigureAwait(false);
+            WriteAuditJson(payload);
+            return ExitClean;
+        }
+        finally
+        {
+            lockFile.Dispose();
+        }
+    }
