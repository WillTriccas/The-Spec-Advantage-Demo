+{
+  "schemaVersion": "1.0.0",
+  "workingDirectory": ".",
+  "initialize": {
+    "executable": "dotnet",
+    "arguments": [
+      "run",
+      "--project",
+      "src/TradeRecon.Audit/TradeRecon.Audit.csproj",
+      "--",
+      "initialize",
+      "{stateDirectory}"
+    ],
+    "allowedExitCodes": [0]
+  },
+  "propose": {
+    "executable": "dotnet",
+    "arguments": [
+      "run",
+      "--project",
+      "src/TradeRecon.Audit/TradeRecon.Audit.csproj",
+      "--",
+      "propose",
+      "{stateDirectory}",
+      "{requestId}",
+      "{proposer}",
+      "{businessDate}",
+      "{reason}",
+      "{evidence}"
+    ],
+    "allowedExitCodes": [0, 1]
+  },
+  "decide": {
+    "executable": "dotnet",
+    "arguments": [
+      "run",
+      "--project",
+      "src/TradeRecon.Audit/TradeRecon.Audit.csproj",
+      "--",
+      "decide",
+      "{stateDirectory}",
+      "{requestId}",
+      "{approver}",
+      "{decision}"
+    ],
+    "allowedExitCodes": [0, 1]
+  },
+  "export": {
+    "executable": "dotnet",
+    "arguments": [
+      "run",
+      "--project",
+      "src/TradeRecon.Audit/TradeRecon.Audit.csproj",
+      "--",
+      "export",
+      "{stateDirectory}",
+      "{fromDate}",
+      "{toDate}",
+      "{exportPath}"
+    ],
+    "allowedExitCodes": [0]
+  }
+}
diff --git a/contracts/audit-adapter.schema.json b/contracts/audit-adapter.schema.json
new file mode 100644
index 0000000..c1a8a1e
--- /dev/null
+++ b/contracts/audit-adapter.schema.json
@@ -0,0 +1,33 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Audit adapter contract",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "workingDirectory", "initialize", "propose", "decide", "export"],
+  "properties": {
+    "schemaVersion": { "type": "string" },
+    "workingDirectory": { "type": "string" },
+    "initialize": { "$ref": "#/$defs/command" },
+    "propose": { "$ref": "#/$defs/command" },
+    "decide": { "$ref": "#/$defs/command" },
+    "export": { "$ref": "#/$defs/command" }
+  },
+  "$defs": {
+    "command": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["executable", "arguments"],
+      "properties": {
+        "executable": { "type": "string" },
+        "arguments": {
+          "type": "array",
+          "items": { "type": "string" }
+        },
+        "allowedExitCodes": {
+          "type": "array",
+          "items": { "type": "integer" }
+        }
+      }
+    }
+  }
+}
diff --git a/src/TradeRecon.Audit/AuditWorkflow.cs b/src/TradeRecon.Audit/AuditWorkflow.cs
new file mode 100644
index 0000000..ae03043
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditWorkflow.cs
@@ -0,0 +1,567 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Audit;
+
+public static partial class AuditWorkflow
+{
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+        WriteIndented = false
+    };
+
+    private const string ProposedAction = "PROPOSED";
+    private const string ApprovedAction = "APPROVED";
+    private const string RejectedAction = "REJECTED";
+
+    public static async Task<AuditCommandResponse> ExecuteAsync(string[] args)
+    {
+        if (args.Length == 0)
+        {
+            return Fail("MissingCommand");
+        }
+
+        var command = args[0];
+        var remaining = args[1..];
+
+        try
+        {
+            return command switch
+            {
+                "--help" or "-h" => Help(),
+                "initialize" => await InitializeAsync(remaining),
+                "propose" => await ProposeAsync(remaining),
+                "decide" => await DecideAsync(remaining),
+                "export" => await ExportAsync(remaining),
+                _ => Fail("UnknownCommand", command)
+            };
+        }
+        catch (Exception)
+        {
+            return Fail("CommandFailed");
+        }
+    }
+
+    private static AuditCommandResponse Help() => new()
+    {
+        Ok = true,
+        Status = "help",
+        Message = "Usage: initialize <stateDirectory> | propose <stateDirectory> <requestId> <proposer> <businessDate> <reason> <evidence> | decide <stateDirectory> <requestId> <approver> <decision> | export <stateDirectory> <fromDate> <toDate> <exportPath>"
+    };
+
+    private static async Task<AuditCommandResponse> InitializeAsync(string[] args)
+    {
+        if (args.Length < 1)
+        {
+            return Fail("InvalidArguments", status: "initialize");
+        }
+
+        var stateDirectory = args[0];
+        Directory.CreateDirectory(stateDirectory);
+
+        var statePath = GetStateFilePath(stateDirectory);
+        if (!File.Exists(statePath))
+        {
+            var state = new AuditState();
+            await File.WriteAllTextAsync(statePath, JsonSerializer.Serialize(state, JsonOptions));
+        }
+
+        return new AuditCommandResponse
+        {
+            Ok = true,
+            Status = "initialized",
+            StateDirectory = stateDirectory,
+            EntryCount = await LoadStateAsync(stateDirectory) is AuditState loaded ? loaded.Entries.Count : 0
+        };
+    }
+
+    private static async Task<AuditCommandResponse> ProposeAsync(string[] args)
+    {
+        if (args.Length < 6)
+        {
+            return Fail("InvalidArguments", status: "propose");
+        }
+
+        var stateDirectory = args[0];
+        var requestId = args[1];
+        var proposer = args[2];
+        var businessDate = args[3];
+        var reason = args[4];
+        var evidence = args[5];
+
+        if (string.IsNullOrWhiteSpace(requestId) || string.IsNullOrWhiteSpace(proposer))
+        {
+            return Fail("ProposalValidationFailed", status: "proposal_invalid");
+        }
+
+        if (!TryParseBusinessDate(businessDate, out var parsedDate))
+        {
+            return Fail("InvalidBusinessDate", status: "proposal_invalid");
+        }
+
+        var sanitizedReason = SanitizeText(reason);
+        var sanitizedEvidence = SanitizeText(evidence);
+        if (string.IsNullOrWhiteSpace(sanitizedReason) || string.IsNullOrWhiteSpace(sanitizedEvidence))
+        {
+            return Fail("ProposalValidationFailed", status: "proposal_invalid");
+        }
+
+        var proposalReason = sanitizedReason;
+        var proposalEvidence = sanitizedEvidence;
+
+        using var handle = AcquireLock(stateDirectory);
+        var state = await LoadStateAsync(stateDirectory);
+        var relevantEntries = state.Entries.Where(e => string.Equals(e.RequestId, requestId, StringComparison.Ordinal)).ToList();
+
+        if (relevantEntries.Count > 0)
+        {
+            var existingProposal = relevantEntries.LastOrDefault(e => string.Equals(e.Action, ProposedAction, StringComparison.Ordinal));
+            if (existingProposal is not null)
+            {
+                var same = string.Equals(existingProposal.Proposer, proposer, StringComparison.Ordinal)
+                    && string.Equals(existingProposal.BusinessDate, businessDate, StringComparison.Ordinal)
+                    && string.Equals(existingProposal.Reason, sanitizedReason, StringComparison.Ordinal)
+                    && string.Equals(existingProposal.Evidence, sanitizedEvidence, StringComparison.Ordinal);
+
+                if (same)
+                {
+                    return new AuditCommandResponse
+                    {
+                        Ok = true,
+                        Status = "proposal_exists",
+                        RequestId = requestId,
+                        Action = ProposedAction,
+                        Actor = proposer,
+                        Proposer = proposer,
+                        BusinessDate = businessDate,
+                        Reason = SanitizeText(existingProposal.Reason),
+                        Evidence = SanitizeText(existingProposal.Evidence),
+                        Entry = existingProposal with { Reason = SanitizeText(existingProposal.Reason), Evidence = SanitizeText(existingProposal.Evidence) },
+                        Sequence = existingProposal.Sequence
+                    };
+                }
+            }
+
+            var finalDecision = relevantEntries.LastOrDefault(e => string.Equals(e.Action, ApprovedAction, StringComparison.Ordinal) || string.Equals(e.Action, RejectedAction, StringComparison.Ordinal));
+            if (finalDecision is not null)
+            {
+                return new AuditCommandResponse
+                {
+                    Ok = true,
+                    Status = "final_decision_exists",
+                    RequestId = requestId,
+                    Action = finalDecision.Action,
+                    Actor = finalDecision.Actor,
+                    Checker = finalDecision.Checker,
+                    FinalDecision = finalDecision.Action,
+                    Entry = finalDecision,
+                    Sequence = finalDecision.Sequence
+                };
+            }
+        }
+
+        var previous = state.Entries.LastOrDefault();
+        var entry = new AuditEntry
+        {
+            Sequence = state.Entries.Count + 1,
+            RequestId = requestId,
+            Action = ProposedAction,
+            EventType = ProposedAction,
+            Actor = proposer,
+            Proposer = proposer,
+            Checker = null,
+            BusinessDate = businessDate,
+            Decision = null,
+            Reason = proposalReason,
+            Evidence = proposalEvidence,
+            Timestamp = DateTimeOffset.UtcNow.ToString("O", CultureInfo.InvariantCulture),
+            Version = 1,
+            PreviousHash = previous is null ? null : previous.Hash,
+            Hash = null
+        };
+
+        entry = entry with { Hash = ComputeHash(entry) };
+        state.Entries.Add(entry);
+        await PersistStateAsync(stateDirectory, state);
+
+        return new AuditCommandResponse
+        {
+            Ok = true,
+            Status = "proposal_recorded",
+            RequestId = requestId,
+            Action = ProposedAction,
+            Actor = proposer,
+            Proposer = proposer,
+            BusinessDate = businessDate,
+            Reason = SanitizeText(entry.Reason),
+            Evidence = SanitizeText(entry.Evidence),
+            Entry = entry with { Reason = SanitizeText(entry.Reason), Evidence = SanitizeText(entry.Evidence) },
+            Sequence = entry.Sequence,
+            PreviousHash = entry.PreviousHash,
+            Hash = entry.Hash
+        };
+    }
+
+    private static async Task<AuditCommandResponse> DecideAsync(string[] args)
+    {
+        if (args.Length < 4)
+        {
+            return Fail("InvalidArguments", status: "decide");
+        }
+
+        var stateDirectory = args[0];
+        var requestId = args[1];
+        var approver = args[2];
+        var decisionToken = args[3];
+
+        if (string.IsNullOrWhiteSpace(requestId) || string.IsNullOrWhiteSpace(approver))
+        {
+            return Fail("DecisionValidationFailed", status: "decision_invalid");
+        }
+
+        if (!string.Equals(decisionToken, ApprovedAction, StringComparison.Ordinal) &&
+            !string.Equals(decisionToken, RejectedAction, StringComparison.Ordinal))
+        {
+            return Fail("DecisionValidationFailed", status: "decision_invalid");
+        }
+
+        using var handle = AcquireLock(stateDirectory);
+        var state = await LoadStateAsync(stateDirectory);
+        var requestEntries = state.Entries.Where(e => string.Equals(e.RequestId, requestId, StringComparison.Ordinal)).ToList();
+        var proposal = requestEntries.LastOrDefault(e => string.Equals(e.Action, ProposedAction, StringComparison.Ordinal));
+        if (proposal is null)
+        {
+            return Fail("RequestNotFound", status: "decision_invalid");
+        }
+
+        if (string.Equals(proposal.Proposer, approver, StringComparison.Ordinal))
+        {
+            return new AuditCommandResponse
+            {
+                Ok = false,
+                Status = "SELF_APPROVAL_DENIED",
+                RequestId = requestId,
+                Action = decisionToken,
+                Actor = approver,
+                Proposer = proposal.Proposer,
+                Checker = approver,
+                BusinessDate = proposal.BusinessDate,
+                Error = "Self approval is not allowed."
+            };
+        }
+
+        var existingDecision = requestEntries.LastOrDefault(e => string.Equals(e.Action, ApprovedAction, StringComparison.Ordinal) || string.Equals(e.Action, RejectedAction, StringComparison.Ordinal));
+        if (existingDecision is not null)
+        {
+            if (string.Equals(existingDecision.Action, decisionToken, StringComparison.Ordinal) &&
+                string.Equals(existingDecision.Actor, approver, StringComparison.Ordinal))
+            {
+                return new AuditCommandResponse
+                {
+                    Ok = true,
+                    Status = "decision_idempotent",
+                    RequestId = requestId,
+                    Action = existingDecision.Action,
+                    Actor = existingDecision.Actor,
+                    Checker = existingDecision.Checker,
+                    FinalDecision = existingDecision.Action,
+                    BusinessDate = existingDecision.BusinessDate,
+                    Entry = existingDecision with { Reason = SanitizeText(existingDecision.Reason), Evidence = SanitizeText(existingDecision.Evidence) },
+                    Sequence = existingDecision.Sequence
+                };
+            }
+
+            return new AuditCommandResponse
+            {
+                Ok = true,
+                Status = "final_decision_exists",
+                RequestId = requestId,
+                Action = existingDecision.Action,
+                Actor = existingDecision.Actor,
+                Checker = existingDecision.Checker,
+                FinalDecision = existingDecision.Action,
+                BusinessDate = existingDecision.BusinessDate,
+                Entry = existingDecision with { Reason = SanitizeText(existingDecision.Reason), Evidence = SanitizeText(existingDecision.Evidence) },
+                Sequence = existingDecision.Sequence
+            };
+        }
+
+        var previous = state.Entries.LastOrDefault();
+        var finalReason = SanitizeText(proposal.Reason);
+        var finalEvidence = SanitizeText(proposal.Evidence);
+        var finalEntry = new AuditEntry
+        {
+            Sequence = state.Entries.Count + 1,
+            RequestId = requestId,
+            Action = decisionToken,
+            EventType = decisionToken,
+            Actor = approver,
+            Proposer = proposal.Proposer,
+            Checker = approver,
+            BusinessDate = proposal.BusinessDate,
+            Decision = decisionToken,
+            Reason = finalReason,
+            Evidence = finalEvidence,
+            Timestamp = DateTimeOffset.UtcNow.ToString("O", CultureInfo.InvariantCulture),
+            Version = 1,
+            PreviousHash = previous is null ? null : previous.Hash,
+            Hash = null
+        };
+
+        finalEntry = finalEntry with { Hash = ComputeHash(finalEntry) };
+        state.Entries.Add(finalEntry);
+        await PersistStateAsync(stateDirectory, state);
+
+        return new AuditCommandResponse
+        {
+            Ok = true,
+            Status = "decision_recorded",
+            RequestId = requestId,
+            Action = decisionToken,
+            Actor = approver,
+            Proposer = proposal.Proposer,
+            Checker = approver,
+            FinalDecision = decisionToken,
+            BusinessDate = proposal.BusinessDate,
+            Reason = finalReason,
+            Evidence = finalEvidence,
+            Entry = finalEntry with { Reason = finalReason, Evidence = finalEvidence },
+            Sequence = finalEntry.Sequence,
+            PreviousHash = finalEntry.PreviousHash,
+            Hash = finalEntry.Hash
+        };
+    }
+
+    private static async Task<AuditCommandResponse> ExportAsync(string[] args)
+    {
+        if (args.Length < 4)
+        {
+            return Fail("InvalidArguments", status: "export");
+        }
+
+        var stateDirectory = args[0];
+        var fromDate = args[1];
+        var toDate = args[2];
+        var exportPath = args[3];
+
+        if (!TryParseBusinessDate(fromDate, out var fromParsed) || !TryParseBusinessDate(toDate, out var toParsed) || fromParsed > toParsed)
+        {
+            return Fail("InvalidDateRange", status: "export");
+        }
+
+        using var handle = AcquireLock(stateDirectory);
+        var state = await LoadStateAsync(stateDirectory);
+        var selected = state.Entries
+            .Where(e => TryParseBusinessDate(e.BusinessDate, out var businessDate) && businessDate >= fromParsed && businessDate <= toParsed)
+            .OrderBy(e => e.Sequence)
+            .Select(CloneExportEntry)
+            .ToList();
+
+        var payload = new
+        {
+            ok = true,
+            status = "exported",
+            fromDate,
+            toDate,
+            count = selected.Count,
+            entries = selected
+        };
+
+        Directory.CreateDirectory(Path.GetDirectoryName(exportPath) ?? stateDirectory);
+        var json = JsonSerializer.Serialize(payload, JsonOptions);
+        await File.WriteAllTextAsync(exportPath, json);
+
+        return new AuditCommandResponse
+        {
+            Ok = true,
+            Status = "exported",
+            FromDate = fromDate,
+            ToDate = toDate,
+            Count = selected.Count,
+            Entries = selected,
+            ExportPath = exportPath
+        };
+    }
+
+    private static AuditEntry CloneExportEntry(AuditEntry entry)
+    {
+        return entry with
+        {
+            Reason = SanitizeText(entry.Reason),
+            Evidence = SanitizeText(entry.Evidence),
+            Hash = entry.Hash,
+            PreviousHash = entry.PreviousHash,
+            Decision = entry.Decision,
+            Action = entry.Action,
+            Actor = entry.Actor,
+            Proposer = entry.Proposer,
+            Checker = entry.Checker,
+            Timestamp = entry.Timestamp,
+            Version = entry.Version,
+            Sequence = entry.Sequence,
+            RequestId = entry.RequestId,
+            BusinessDate = entry.BusinessDate,
+            EventType = entry.EventType
+        };
+    }
+
+    private static AuditState CreateDefaultState() => new();
+
+    private static async Task<AuditState> LoadStateAsync(string stateDirectory)
+    {
+        Directory.CreateDirectory(stateDirectory);
+        var statePath = GetStateFilePath(stateDirectory);
+        if (!File.Exists(statePath))
+        {
+            return CreateDefaultState();
+        }
+
+        var json = await File.ReadAllTextAsync(statePath);
+        if (string.IsNullOrWhiteSpace(json))
+        {
+            return CreateDefaultState();
+        }
+
+        var state = JsonSerializer.Deserialize<AuditState>(json, JsonOptions) ?? CreateDefaultState();
+        return state;
+    }
+
+    private static async Task PersistStateAsync(string stateDirectory, AuditState state)
+    {
+        Directory.CreateDirectory(stateDirectory);
+        var statePath = GetStateFilePath(stateDirectory);
+        var tmpPath = statePath + ".tmp";
+        var text = JsonSerializer.Serialize(state, JsonOptions);
+        await File.WriteAllTextAsync(tmpPath, text);
+        if (File.Exists(statePath))
+        {
+            File.Delete(statePath);
+        }
+
+        File.Move(tmpPath, statePath);
+    }
+
+    private static string GetStateFilePath(string stateDirectory) => Path.Combine(stateDirectory, "audit-state.json");
+
+    private static string ComputeHash(AuditEntry entry)
+    {
+        var withoutHash = entry with { Hash = null };
+        var document = JsonDocument.Parse(JsonSerializer.Serialize(withoutHash, JsonOptions));
+        var canonical = Canonicalize(document.RootElement);
+        using var sha = SHA256.Create();
+        var bytes = sha.ComputeHash(Encoding.UTF8.GetBytes(canonical));
+        return Convert.ToHexString(bytes).ToLowerInvariant();
+    }
+
+    private static string Canonicalize(JsonElement element)
+    {
+        return element.ValueKind switch
+        {
+            JsonValueKind.Object => "{" + string.Join(",", element.EnumerateObject().OrderBy(pair => pair.Name, StringComparer.Ordinal).Select(pair => JsonEncodedText.Encode(pair.Name) + ":" + Canonicalize(pair.Value))) + "}",
+            JsonValueKind.Array => "[" + string.Join(",", element.EnumerateArray().Select(Canonicalize)) + "]",
+            JsonValueKind.String => JsonSerializer.Serialize(element.GetString()),
+            JsonValueKind.Number => element.GetRawText(),
+            JsonValueKind.True => "true",
+            JsonValueKind.False => "false",
+            JsonValueKind.Null => "null",
+            _ => "null"
+        };
+    }
+
+    private static string SanitizeText(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return string.Empty;
+        }
+
+        var sanitized = value;
+        sanitized = Regex.Replace(sanitized, @"(?i)\b(?:acc|account|acct)[A-Za-z0-9-]*\b", "[ACCOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b(?:trade|instrument|security)[A-Za-z0-9-]*\b", "[REFERENCE_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?<![\d])\b\d{1,3}(?:,\d{3})*(?:\.\d+)?\b(?![\d])", "[AMOUNT_REDACTED]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b[A-Z]{2,}\d+[A-Z0-9-]*\b", "[ACCOUNT_REDACTED]");
+        return sanitized.Trim();
+    }
+
+    private static bool TryParseBusinessDate(string? value, out DateOnly date)
+    {
+        return DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date);
+    }
+
+    private static FileStream AcquireLock(string stateDirectory)
+    {
+        Directory.CreateDirectory(stateDirectory);
+        var lockPath = Path.Combine(stateDirectory, ".audit.lock");
+        return new FileStream(lockPath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+    }
+
+    private static AuditCommandResponse Fail(string error, string? command = null, string? status = null)
+        => new()
+        {
+            Ok = false,
+            Error = error,
+            Status = status ?? command ?? error,
+            Command = command
+        };
+}
+
