diff --git a/tests/TradeRecon.Tests/AuditWorkflowTests.cs b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
new file mode 100644
index 0000000..61125a3
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
@@ -0,0 +1,139 @@
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditWorkflowTests
+{
+    [Fact]
+    public async Task ProposeAndApprove_CreatesOrderedHashChain()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "traderecon-audit-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            var initialized = await AuditWorkflow.ExecuteAsync(["initialize", stateDirectory]);
+            Assert.True(initialized.Ok);
+
+            var proposed = await AuditWorkflow.ExecuteAsync([
+                "propose",
+                stateDirectory,
+                "REQ-001",
+                "maker-a",
+                "2024-06-03",
+                "Price variance after settlement replay.",
+                "Evidence: ACC-1542 amount 100.25 referenced by trade T-9811."]);
+            Assert.True(proposed.Ok);
+            Assert.Equal("PROPOSED", proposed.Action);
+            Assert.Equal("maker-a", proposed.Actor);
+
+            var approved = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-001", "checker-b", "APPROVED"]);
+            Assert.True(approved.Ok);
+            Assert.Equal("APPROVED", approved.Action);
+            Assert.Equal("checker-b", approved.Actor);
+
+            var exportPath = Path.Combine(stateDirectory, "export.json");
+            var exported = await AuditWorkflow.ExecuteAsync(["export", stateDirectory, "2024-06-03", "2024-06-03", exportPath]);
+            Assert.True(exported.Ok);
+            Assert.NotNull(exported.Entries);
+            Assert.Equal(2, exported.Entries!.Count);
+            Assert.Null(exported.Entries[0].PreviousHash);
+            Assert.Equal(exported.Entries[0].Hash, exported.Entries[1].PreviousHash);
+            Assert.Contains(exported.Entries, entry => entry.Action == "PROPOSED");
+            Assert.Contains(exported.Entries, entry => entry.Action == "APPROVED");
+
+            var exportText = await File.ReadAllTextAsync(exportPath);
+            Assert.DoesNotContain("ACC-1542", exportText, StringComparison.Ordinal);
+            Assert.DoesNotContain("100.25", exportText, StringComparison.Ordinal);
+            Assert.Contains("requestId", exportText, StringComparison.Ordinal);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task SelfApproval_IsRejected_AndDuplicateApproval_IsIdempotent()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "traderecon-audit-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            await AuditWorkflow.ExecuteAsync(["initialize", stateDirectory]);
+            var proposed = await AuditWorkflow.ExecuteAsync([
+                "propose",
+                stateDirectory,
+                "REQ-002",
+                "maker-a",
+                "2024-06-03",
+                "Manual exception is valid.",
+                "Evidence: account ACC-2000 amount 7150.00"]); 
+            Assert.True(proposed.Ok);
+
+            var selfApproval = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-002", "maker-a", "APPROVED"]);
+            Assert.False(selfApproval.Ok);
+            Assert.Equal("SELF_APPROVAL_DENIED", selfApproval.Status);
+
+            var approve = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-002", "checker-b", "APPROVED"]);
+            Assert.True(approve.Ok);
+
+            var duplicateApprove = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-002", "checker-b", "APPROVED"]);
+            Assert.True(duplicateApprove.Ok);
+
+            var exportPath = Path.Combine(stateDirectory, "export.json");
+            var exported = await AuditWorkflow.ExecuteAsync(["export", stateDirectory, "2024-06-03", "2024-06-03", exportPath]);
+            Assert.True(exported.Ok);
+            Assert.Equal(2, exported.Entries!.Count);
+            Assert.Equal(1, exported.Entries.Count(entry => entry.Action == "APPROVED"));
+
+            var exportText = await File.ReadAllTextAsync(exportPath);
+            Assert.DoesNotContain("ACC-2000", exportText, StringComparison.Ordinal);
+            Assert.DoesNotContain("7150.00", exportText, StringComparison.Ordinal);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task ConflictingDecisions_KeepExactlyOneFinalDecision()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "traderecon-audit-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            await AuditWorkflow.ExecuteAsync(["initialize", stateDirectory]);
+            await AuditWorkflow.ExecuteAsync([
+                "propose",
+                stateDirectory,
+                "REQ-003",
+                "maker-a",
+                "2024-06-03",
+                "Exceptional amount variance.",
+                "Evidence: ACC-3000 amount 88.75 or 99.10"]);
+
+            var approve = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-003", "checker-b", "APPROVED"]);
+            Assert.True(approve.Ok);
+
+            var reject = await AuditWorkflow.ExecuteAsync(["decide", stateDirectory, "REQ-003", "checker-c", "REJECTED"]);
+            Assert.True(reject.Ok);
+            Assert.Equal("APPROVED", reject.FinalDecision);
+
+            var exportPath = Path.Combine(stateDirectory, "export.json");
+            var exported = await AuditWorkflow.ExecuteAsync(["export", stateDirectory, "2024-06-03", "2024-06-03", exportPath]);
+            Assert.True(exported.Ok);
+            Assert.NotNull(exported.Entries);
+            Assert.Equal(1, exported.Entries!.Count(entry => entry.Action is "APPROVED" or "REJECTED"));
+            Assert.Equal("APPROVED", exported.Entries.Single(entry => entry.Action is "APPROVED" or "REJECTED").Action);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+}
