+++ b/tests/LegacyTradeReconciliation.Tests/CharacterizationTests.cs
@@ -0,0 +1,109 @@
+using System.IO;
+using LegacyTradeReconciliation.Configuration;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    /// <summary>
+    /// Golden-master tests. These lock in the byte-for-byte artifacts the .NET
+    /// Framework batch produced, and are the safety net for the .NET 8 port.
+    /// </summary>
+    public sealed class CharacterizationTests
+    {
+        [Theory]
+        [InlineData("baseline")]
+        [InlineData("override-rerun")]
+        public void Scenario_reproduces_the_golden_master_artifacts(string scenario)
+        {
+            using var output = new TempDirectory(scenario);
+
+            TestEnvironment.CreateBatch().Run(TestEnvironment.Request(TestEnvironment.FixtureInput(scenario), output.Path));
+
+            AssertMatchesGolden(scenario, output.Path, BatchFileNames.MatchedTrades);
+            AssertMatchesGolden(scenario, output.Path, BatchFileNames.BreakQueue);
+            AssertMatchesGolden(scenario, output.Path, BatchFileNames.EndOfDayReport);
+        }
+
+        [Fact]
+        public void Exact_input_rerun_is_idempotent()
+        {
+            using var output = new TempDirectory("rerun");
+            string input = TestEnvironment.FixtureInput("override-rerun");
+
+            var firstOutcome = TestEnvironment.CreateBatch().Run(TestEnvironment.Request(input, output.Path));
+
+            string matchedTrades = TestEnvironment.ReadOutput(output.Path, BatchFileNames.MatchedTrades);
+            string breakQueue = TestEnvironment.ReadOutput(output.Path, BatchFileNames.BreakQueue);
+            string report = TestEnvironment.ReadOutput(output.Path, BatchFileNames.EndOfDayReport);
+            string ledger = TestEnvironment.ReadOutput(output.Path, BatchFileNames.RunLedger);
+
+            var log = new RecordingBatchLog();
+            var secondOutcome = TestEnvironment.CreateBatch(log).Run(TestEnvironment.Request(input, output.Path));
+
+            Assert.False(firstOutcome.WasRerun);
+            Assert.True(secondOutcome.WasRerun);
+            Assert.Equal(firstOutcome.InputSignature, secondOutcome.InputSignature);
+            Assert.Contains(log.Messages, message => message.Contains("Exact rerun detected for 2025-03-17", System.StringComparison.Ordinal));
+
+            Assert.Equal(matchedTrades, TestEnvironment.ReadOutput(output.Path, BatchFileNames.MatchedTrades));
+            Assert.Equal(breakQueue, TestEnvironment.ReadOutput(output.Path, BatchFileNames.BreakQueue));
+            Assert.Equal(report, TestEnvironment.ReadOutput(output.Path, BatchFileNames.EndOfDayReport));
+            Assert.Equal(ledger, TestEnvironment.ReadOutput(output.Path, BatchFileNames.RunLedger));
+        }
+
+        [Fact]
+        public void A_changed_input_for_the_same_business_date_is_republished()
+        {
+            using var input = new TempDirectory("changed-input");
+            using var output = new TempDirectory("changed-output");
+            CopyFixtureInput("override-rerun", input.Path);
+
+            TestEnvironment.CreateBatch().Run(TestEnvironment.Request(input.Path, output.Path));
+
+            File.AppendAllText(
+                Path.Combine(input.Path, BatchFileNames.Trades),
+                "T-1009,ACC-009,BP.L,10,2025-03-17,GBP,100.00" + System.Environment.NewLine);
+
+            var outcome = TestEnvironment.CreateBatch().Run(TestEnvironment.Request(input.Path, output.Path));
+
+            Assert.False(outcome.WasRerun);
+
+            string[] ledgerLines = File.ReadAllLines(Path.Combine(output.Path, BatchFileNames.RunLedger));
+            Assert.Equal(3, ledgerLines.Length);
+            Assert.All(ledgerLines[1..], line => Assert.StartsWith("2025-03-17,", line, System.StringComparison.Ordinal));
+        }
+
+        [Fact]
+        public void Superseded_override_instructions_are_audited_rather_than_discarded()
+        {
+            using var input = new TempDirectory("duplicate-override-input");
+            using var output = new TempDirectory("duplicate-override-output");
+            CopyFixtureInput("override-rerun", input.Path);
+
+            File.AppendAllText(
+                Path.Combine(input.Path, BatchFileNames.Overrides),
+                "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager" + System.Environment.NewLine);
+
+            TestEnvironment.CreateBatch().Run(TestEnvironment.Request(input.Path, output.Path));
+
+            string report = TestEnvironment.ReadOutput(output.Path, BatchFileNames.EndOfDayReport);
+            Assert.Contains("Stale Overrides: 1", report, System.StringComparison.Ordinal);
+            Assert.Contains("T-1003: ForceMatch (ops-manager)", report, System.StringComparison.Ordinal);
+        }
+
+        private static void AssertMatchesGolden(string scenario, string outputDirectory, string fileName)
+        {
+            string expected = TestEnvironment.NormalizeNewlines(TestEnvironment.ReadExpected(scenario, fileName));
+            string actual = TestEnvironment.NormalizeNewlines(TestEnvironment.ReadOutput(outputDirectory, fileName));
+            Assert.Equal(expected, actual);
+        }
+
+        private static void CopyFixtureInput(string scenario, string destination)
+        {
+            foreach (string file in Directory.GetFiles(TestEnvironment.FixtureInput(scenario)))
+            {
+                File.Copy(file, Path.Combine(destination, Path.GetFileName(file)), overwrite: true);
+            }
+        }
+    }
+}
