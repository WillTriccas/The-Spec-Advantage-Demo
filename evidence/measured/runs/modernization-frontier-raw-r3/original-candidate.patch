+using System;
+using System.IO;
+using LegacyTradeReconciliation.Configuration;
+
+namespace LegacyTradeReconciliation.Cli
+{
+    /// <summary>
+    /// Parses the batch command line. The accepted shapes are unchanged:
+    /// no arguments (built-in sample run) or
+    /// <c>&lt;business-date yyyy-MM-dd&gt; &lt;input-directory&gt; &lt;output-directory&gt;</c>.
+    /// </summary>
+    public static class CommandLine
+    {
+        public const string Usage =
+            "Usage: LegacyTradeReconciliation [<business-date yyyy-MM-dd> <input-directory> <output-directory>]";
+
+        public static RunRequest Parse(string[]? args, string baseDirectory)
+        {
+            ArgumentException.ThrowIfNullOrWhiteSpace(baseDirectory);
+
+            if (args is null || args.Length == 0)
+            {
+                return new RunRequest(
+                    new DateTime(2025, 3, 17),
+                    Path.Combine(baseDirectory, "data", "sample"),
+                    Path.Combine(baseDirectory, "output", "sample"));
+            }
+
+            if (args.Length != 3)
+            {
+                throw new ArgumentException(
+                    "Expected either no arguments or: <business-date yyyy-MM-dd> <input-directory> <output-directory>.",
+                    nameof(args));
+            }
+
+            return new RunRequest(
+                RunRequest.ParseBusinessDate(args[0]),
+                args[1],
+                args[2]);
+        }
+    }
+}
