new file mode 100644
index 0000000..52a140c
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Cli/Program.cs
@@ -0,0 +1,58 @@
+using System;
+using System.IO;
+using System.Security;
+using LegacyTradeReconciliation.Configuration;
+
+namespace LegacyTradeReconciliation.Cli
+{
+    /// <summary>
+    /// Entry point for the reconciliation batch.
+    /// </summary>
+    public static class Program
+    {
+        /// <summary>Reconciliation completed, or an exact rerun was skipped.</summary>
+        public const int ExitSuccess = 0;
+
+        /// <summary>The command line or the business date could not be understood.</summary>
+        public const int ExitInvalidArguments = 2;
+
+        /// <summary>Input data or the environment prevented the batch from running.</summary>
+        public const int ExitRunFailed = 3;
+
+        public static int Main(string[] args)
+        {
+            var log = new ConsoleBatchLog();
+
+            RunRequest request;
+            try
+            {
+                request = CommandLine.Parse(args, AppContext.BaseDirectory);
+            }
+            catch (Exception exception) when (exception is ArgumentException or FormatException)
+            {
+                ConsoleBatchLog.Error(exception.Message);
+                ConsoleBatchLog.Error(CommandLine.Usage);
+                return ExitInvalidArguments;
+            }
+
+            try
+            {
+                ReconciliationBatch.CreateDefault(log).Run(request);
+                return ExitSuccess;
+            }
+            catch (Exception exception) when (
+                exception is IOException or
+                UnauthorizedAccessException or
+                SecurityException or
+                FormatException or
+                OverflowException or
+                NotSupportedException)
+            {
+                // Operability: batch schedulers get a single actionable line on stderr
+                // and a distinct exit code instead of an unhandled stack trace.
+                ConsoleBatchLog.Error("Reconciliation run failed: " + exception.Message);
+                return ExitRunFailed;
+            }
+        }
+    }
+}
