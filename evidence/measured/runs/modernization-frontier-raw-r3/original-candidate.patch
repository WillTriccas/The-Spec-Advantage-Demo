+using System;
+
+namespace LegacyTradeReconciliation.Configuration
+{
+    /// <summary>
+    /// Matching tolerances. Previously hard-coded compile-time constants; now an
+    /// explicit, injectable and validated value object so alternative tolerance
+    /// sets can be exercised by tests without recompiling the batch.
+    /// </summary>
+    public sealed class ReconciliationTolerances
+    {
+        /// <summary>The tolerances the batch has always shipped with.</summary>
+        public static ReconciliationTolerances Default { get; } = new ReconciliationTolerances(
+            positionQuantity: 0.01m,
+            settlementQuantity: 0.02m,
+            settlementAmount: 5.00m);
+
+        public ReconciliationTolerances(decimal positionQuantity, decimal settlementQuantity, decimal settlementAmount)
+        {
+            if (positionQuantity < 0m)
+            {
+                throw new ArgumentOutOfRangeException(nameof(positionQuantity), positionQuantity, "Tolerances must not be negative.");
+            }
+
+            if (settlementQuantity < 0m)
+            {
+                throw new ArgumentOutOfRangeException(nameof(settlementQuantity), settlementQuantity, "Tolerances must not be negative.");
+            }
+
+            if (settlementAmount < 0m)
+            {
+                throw new ArgumentOutOfRangeException(nameof(settlementAmount), settlementAmount, "Tolerances must not be negative.");
+            }
+
+            PositionQuantity = positionQuantity;
+            SettlementQuantity = settlementQuantity;
+            SettlementAmount = settlementAmount;
+        }
+
+        public decimal PositionQuantity { get; }
+
+        public decimal SettlementQuantity { get; }
+
+        public decimal SettlementAmount { get; }
+    }
+}
