+++ b/src/LegacyTradeReconciliation.Core/Csv/CsvInputReader.cs
@@ -0,0 +1,152 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Csv
+{
+    /// <summary>
+    /// Reads the four synthetic CSV feeds. Parsing is strict: a row whose shape does
+    /// not match the published schema aborts the batch instead of being silently
+    /// coerced into a reconciliation decision.
+    /// </summary>
+    public sealed class CsvInputReader : IReconciliationInputReader
+    {
+        public ReconciliationInputSet Read(string inputDirectory)
+        {
+            ArgumentException.ThrowIfNullOrWhiteSpace(inputDirectory);
+
+            if (!Directory.Exists(inputDirectory))
+            {
+                throw new DirectoryNotFoundException($"Input directory '{inputDirectory}' does not exist.");
+            }
+
+            return new ReconciliationInputSet
+            {
+                Trades = ReadRequired(inputDirectory, BatchFileNames.Trades, 7, ParseTrade),
+                Positions = ReadRequired(inputDirectory, BatchFileNames.Positions, 6, ParsePosition),
+                Settlements = ReadRequired(inputDirectory, BatchFileNames.Settlements, 7, ParseSettlement),
+                Overrides = ReadOptional(inputDirectory, BatchFileNames.Overrides, 4, ParseOverride)
+            };
+        }
+
+        private static List<T> ReadRequired<T>(string inputDirectory, string fileName, int cellCount, Func<string[], T> projection)
+        {
+            string path = Path.Combine(inputDirectory, fileName);
+            if (!File.Exists(path))
+            {
+                throw new FileNotFoundException($"Required input file '{fileName}' was not found in '{inputDirectory}'.", path);
+            }
+
+            return ParseRows(path, fileName, cellCount, projection);
+        }
+
+        private static List<T> ReadOptional<T>(string inputDirectory, string fileName, int cellCount, Func<string[], T> projection)
+        {
+            string path = Path.Combine(inputDirectory, fileName);
+            return File.Exists(path)
+                ? ParseRows(path, fileName, cellCount, projection)
+                : new List<T>();
+        }
+
+        private static List<T> ParseRows<T>(string path, string fileName, int cellCount, Func<string[], T> projection)
+        {
+            string[] lines = File.ReadAllLines(path);
+            var records = new List<T>(Math.Max(0, lines.Length - 1));
+
+            // Row 1 is the header row.
+            for (int index = 1; index < lines.Length; index++)
+            {
+                string line = lines[index];
+                if (string.IsNullOrWhiteSpace(line))
+                {
+                    continue;
+                }
+
+                string[] cells = Split(line, cellCount, fileName, lineNumber: index + 1);
+                try
+                {
+                    records.Add(projection(cells));
+                }
+                catch (FormatException exception)
+                {
+                    // Deliberately reports the location rather than echoing the row, so
+                    // operational logs never carry raw trade data.
+                    throw new InvalidDataException($"{fileName} line {index + 1} contains a malformed value.", exception);
+                }
+            }
+
+            return records;
+        }
+
+        private static string[] Split(string line, int expectedCellCount, string fileName, int lineNumber)
+        {
+            string[] cells = line.Split(',');
+            if (cells.Length != expectedCellCount)
+            {
+                throw new InvalidDataException(
+                    $"{fileName} line {lineNumber} has {cells.Length.ToString(CultureInfo.InvariantCulture)} columns but {expectedCellCount.ToString(CultureInfo.InvariantCulture)} were expected.");
+            }
+
+            for (int index = 0; index < cells.Length; index++)
+            {
+                cells[index] = cells[index].Trim();
+            }
+
+            return cells;
+        }
+
+        private static TradeRecord ParseTrade(string[] cells) => new TradeRecord
+        {
+            TradeId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5],
+            NetAmount = ParseDecimal(cells[6])
+        };
+
+        private static PositionRecord ParsePosition(string[] cells) => new PositionRecord
+        {
+            PositionId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5]
+        };
+
+        private static SettlementRecord ParseSettlement(string[] cells) => new SettlementRecord
+        {
+            SettlementId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5],
+            CashAmount = ParseDecimal(cells[6])
+        };
+
+        private static ManualOverrideRecord ParseOverride(string[] cells) => new ManualOverrideRecord
+        {
+            TradeId = cells[0],
+            Action = cells[1],
+            Note = cells[2],
+            ApprovedBy = cells[3]
+        };
+
+        private static decimal ParseDecimal(string value)
+        {
+            return decimal.Parse(value, NumberStyles.Number | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture);
+        }
+
+        private static DateTime ParseDate(string value)
+        {
+            return DateTime.ParseExact(value, CsvFormat.DateFormat, CultureInfo.InvariantCulture);
+        }
+    }
+}
diff --git a/src/LegacyTradeReconciliation.Core/Csv/CsvOutputWriter.cs b/src/LegacyTradeReconciliation.Core/Csv/CsvOutputWriter.cs
new file mode 100644
index 0000000..ba2395f
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/Csv/CsvOutputWriter.cs
@@ -0,0 +1,84 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Csv
+{
+    /// <summary>
+    /// Writes the observable batch artifacts. Column order, sort order, number and
+    /// date formats are a published contract.
+    /// </summary>
+    public sealed class CsvOutputWriter : IReconciliationOutputWriter
+    {
+        internal const string MatchedTradesHeader = "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+        internal const string BreakQueueHeader = "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+        public void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades)
+        {
+            ArgumentNullException.ThrowIfNull(matchedTrades);
+
+            var lines = new List<string>(matchedTrades.Count + 1) { MatchedTradesHeader };
+            lines.AddRange(matchedTrades
+                .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+                .Select(record => CsvFormat.Row(
+                    record.TradeId,
+                    record.Status,
+                    record.Account,
+                    record.Instrument,
+                    CsvFormat.Decimal(record.Quantity),
+                    CsvFormat.Date(record.SettlementDate),
+                    record.Currency,
+                    record.PositionId,
+                    record.SettlementId,
+                    record.OverrideNote)));
+
+            WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades), lines);
+        }
+
+        public void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue)
+        {
+            ArgumentNullException.ThrowIfNull(breakQueue);
+
+            var lines = new List<string>(breakQueue.Count + 1) { BreakQueueHeader };
+            lines.AddRange(breakQueue
+                .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+                .ThenBy(record => record.Reasons, StringComparer.Ordinal)
+                .Select(record => CsvFormat.Row(
+                    record.TradeId,
+                    record.Account,
+                    record.Instrument,
+                    CsvFormat.Decimal(record.Quantity),
+                    CsvFormat.Date(record.SettlementDate),
+                    record.Currency,
+                    record.Reasons,
+                    record.PositionId,
+                    record.SettlementId)));
+
+            WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.BreakQueue), lines);
+        }
+
+        public void WriteEndOfDayReport(string outputDirectory, string reportText)
+        {
+            ArgumentException.ThrowIfNullOrEmpty(outputDirectory);
+            File.WriteAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport), reportText, CsvFormat.Utf8NoBom);
+        }
+
+        public bool OutputsExist(string outputDirectory)
+        {
+            ArgumentException.ThrowIfNullOrEmpty(outputDirectory);
+
+            return File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)) &&
+                   File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)) &&
+                   File.Exists(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport));
+        }
+
+        private static void WriteAllLines(string path, IEnumerable<string> lines)
+        {
+            File.WriteAllLines(path, lines, CsvFormat.Utf8NoBom);
+        }
+    }
+}
