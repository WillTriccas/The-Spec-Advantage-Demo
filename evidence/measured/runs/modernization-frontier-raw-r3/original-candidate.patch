diff --git a/tests/LegacyTradeReconciliation.Tests/MatchingEngineTests.cs b/tests/LegacyTradeReconciliation.Tests/MatchingEngineTests.cs
new file mode 100644
index 0000000..7c4e402
--- /dev/null
+++ b/tests/LegacyTradeReconciliation.Tests/MatchingEngineTests.cs
@@ -0,0 +1,400 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Matching;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    /// <summary>
+    /// Rule-level tests for the business invariants Trade Operations depends on.
+    /// </summary>
+    public sealed class MatchingEngineTests
+    {
+        private static readonly DateTime SettlementDate = new(2025, 3, 17);
+        private readonly MatchingEngine _engine = new();
+
+        [Fact]
+        public void Account_instrument_and_currency_are_compared_on_trimmed_uppercase_values()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("t-1", account: " acc-001 ", instrument: " ibm.n ", currency: " usd ") },
+                positions: new[] { Position("P-1", account: "ACC-001", instrument: "IBM.N", currency: "USD") },
+                settlements: new[] { Settlement("S-1", account: "ACC-001", instrument: "IBM.N", currency: "USD") }));
+
+            MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+            Assert.Equal(MatchStatus.Matched, matched.Status);
+            Assert.Equal("T-1", matched.TradeId);
+            Assert.Equal("ACC-001", matched.Account);
+            Assert.Equal("IBM.N", matched.Instrument);
+            Assert.Equal("USD", matched.Currency);
+            Assert.Empty(result.OpenBreaks);
+        }
+
+        [Fact]
+        public void The_first_occurrence_of_a_trade_identifier_is_canonical()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1"), Trade("t-1") },
+                positions: new[] { Position("P-1") },
+                settlements: new[] { Settlement("S-1") }));
+
+            Assert.Equal(2, result.TotalTradesRead);
+            Assert.Equal(1, result.CanonicalTradeCount);
+            Assert.Equal(1, result.DuplicateTradeCount);
+            Assert.Equal(MatchStatus.Matched, Assert.Single(result.MatchedTrades).Status);
+            Assert.Equal(BreakReasons.DuplicateTradeId, Assert.Single(result.OpenBreaks).Reasons);
+        }
+
+        [Theory]
+        [InlineData("0", "100")]
+        [InlineData("-5", "100")]
+        [InlineData("100", "0")]
+        [InlineData("100", "-1")]
+        public void Non_positive_quantities_or_net_amounts_are_always_breaks(string quantityText, string netAmountText)
+        {
+            decimal quantity = Amount(quantityText);
+            decimal netAmount = Amount(netAmountText);
+
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: quantity, netAmount: netAmount) },
+                positions: new[] { Position("P-1", quantity: quantity) },
+                settlements: new[] { Settlement("S-1", quantity: quantity, cashAmount: netAmount) }));
+
+            BreakRecord open = Assert.Single(result.OpenBreaks);
+            Assert.Equal(BreakReasons.TradeValueOutOfBounds, open.Reasons);
+            Assert.False(open.CanManualOverride);
+        }
+
+        [Fact]
+        public void Missing_counterparts_are_reported_separately()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(trades: new[] { Trade("T-1") }));
+
+            BreakRecord open = Assert.Single(result.OpenBreaks);
+            Assert.Equal("MissingPosition|MissingSettlement", open.Reasons);
+            Assert.False(open.CanManualOverride);
+            Assert.Null(open.PositionId);
+            Assert.Null(open.SettlementId);
+        }
+
+        [Theory]
+        [InlineData("100.005", null)]
+        [InlineData("100.02", BreakReasons.PositionQuantityOutOfTolerance)]
+        public void Position_quantity_tolerance_is_honoured(string positionQuantity, string? expectedReason)
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: Amount(positionQuantity)) },
+                settlements: new[] { Settlement("S-1", quantity: 100m) }));
+
+            AssertReason(result, expectedReason);
+        }
+
+        [Theory]
+        [InlineData("100.02", null)]
+        [InlineData("100.03", BreakReasons.SettlementQuantityOutOfTolerance)]
+        public void Settlement_quantity_has_its_own_tolerance(string settlementQuantity, string? expectedReason)
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: 100m) },
+                settlements: new[] { Settlement("S-1", quantity: Amount(settlementQuantity)) }));
+
+            AssertReason(result, expectedReason);
+        }
+
+        [Theory]
+        [InlineData("1005", null)]
+        [InlineData("1006", BreakReasons.SettlementAmountOutOfTolerance)]
+        public void Settlement_cash_amount_has_its_own_tolerance(string cashAmount, string? expectedReason)
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", netAmount: 1000m) },
+                positions: new[] { Position("P-1") },
+                settlements: new[] { Settlement("S-1", cashAmount: Amount(cashAmount)) }));
+
+            AssertReason(result, expectedReason);
+        }
+
+        private static decimal Amount(string value) => decimal.Parse(value, System.Globalization.CultureInfo.InvariantCulture);
+
+        [Fact]
+        public void Tolerances_are_configurable_without_recompiling_the_rules()
+        {
+            var lenient = new MatchingEngine(new ReconciliationTolerances(positionQuantity: 1m, settlementQuantity: 1m, settlementAmount: 1000m));
+
+            ReconciliationResult result = lenient.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m, netAmount: 1000m) },
+                positions: new[] { Position("P-1", quantity: 100.5m) },
+                settlements: new[] { Settlement("S-1", quantity: 100.5m, cashAmount: 1500m) }));
+
+            Assert.Empty(result.OpenBreaks);
+            Assert.Equal(1, result.MatchedCount);
+        }
+
+        [Fact]
+        public void Negative_tolerances_are_rejected()
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() => new ReconciliationTolerances(-1m, 0m, 0m));
+            Assert.Throws<ArgumentOutOfRangeException>(() => new ReconciliationTolerances(0m, -1m, 0m));
+            Assert.Throws<ArgumentOutOfRangeException>(() => new ReconciliationTolerances(0m, 0m, -1m));
+        }
+
+        [Fact]
+        public void Counterpart_records_are_consumed_at_most_once()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1"), Trade("T-2") },
+                positions: new[] { Position("P-1") },
+                settlements: new[] { Settlement("S-1") }));
+
+            Assert.Equal(1, result.MatchedCount);
+            BreakRecord open = Assert.Single(result.OpenBreaks);
+            Assert.Equal("T-2", open.TradeId);
+            Assert.Equal("MissingPosition|MissingSettlement", open.Reasons);
+        }
+
+        [Fact]
+        public void Settlement_date_and_currency_must_agree_before_tolerances_are_evaluated()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1") },
+                positions: new[] { Position("P-1", settlementDate: SettlementDate.AddDays(1)) },
+                settlements: new[] { Settlement("S-1", currency: "GBP") }));
+
+            BreakRecord open = Assert.Single(result.OpenBreaks);
+            Assert.Equal("PositionSettlementDateMismatch|SettlementCurrencyMismatch", open.Reasons);
+
+            // Nearest counterpart identifiers are still surfaced for the break queue.
+            Assert.Equal("P-1", open.PositionId);
+            Assert.Equal("S-1", open.SettlementId);
+            Assert.True(open.CanManualOverride);
+        }
+
+        [Fact]
+        public void An_override_cannot_manufacture_a_missing_counterpart()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1") },
+                overrides: new[] { Override("T-1", "ForceMatch") }));
+
+            Assert.Empty(result.MatchedTrades);
+            Assert.Single(result.OpenBreaks);
+            Assert.Single(result.StaleOverrides);
+        }
+
+        [Fact]
+        public void A_suppressed_break_leaves_an_audit_trail_instead_of_disappearing()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: 100m) },
+                settlements: new[] { Settlement("S-1", quantity: 500m) },
+                overrides: new[] { Override("T-1", "SuppressBreak", note: "Booked in mirror") }));
+
+            MatchedTradeRecord audited = Assert.Single(result.MatchedTrades);
+            Assert.Equal(MatchStatus.ManualOverrideSuppressed, audited.Status);
+            Assert.Equal("Booked in mirror", audited.OverrideNote);
+            Assert.Equal("P-1", audited.PositionId);
+            Assert.Equal("S-1", audited.SettlementId);
+            Assert.Empty(result.OpenBreaks);
+            Assert.Equal(0, result.MatchedCount);
+            Assert.Equal(1, result.ManualOverrideSuppressedCount);
+        }
+
+        [Theory]
+        [InlineData("", "ops-manager")]
+        [InlineData("   ", "ops-manager")]
+        [InlineData("note", "")]
+        [InlineData("note", "   ")]
+        public void An_override_without_a_note_or_an_approver_is_stale(string note, string approvedBy)
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: 100m) },
+                settlements: new[] { Settlement("S-1", quantity: 500m) },
+                overrides: new[] { Override("T-1", "ForceMatch", note, approvedBy) }));
+
+            Assert.Single(result.OpenBreaks);
+            Assert.Single(result.StaleOverrides);
+            Assert.Empty(result.MatchedTrades);
+        }
+
+        [Fact]
+        public void An_unknown_override_action_is_stale()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: 100m) },
+                settlements: new[] { Settlement("S-1", quantity: 500m) },
+                overrides: new[] { Override("T-1", "PleaseFixIt") }));
+
+            Assert.Single(result.OpenBreaks);
+            Assert.Single(result.StaleOverrides);
+        }
+
+        [Fact]
+        public void Only_the_first_override_for_a_trade_is_applied_and_later_ones_are_surfaced()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1", quantity: 100m) },
+                positions: new[] { Position("P-1", quantity: 100m) },
+                settlements: new[] { Settlement("S-1", quantity: 500m) },
+                overrides: new[]
+                {
+                    Override("T-1", "ForceMatch", note: "applied"),
+                    Override("T-1", "SuppressBreak", note: "superseded")
+                }));
+
+            MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+            Assert.Equal(MatchStatus.ManualOverrideMatched, matched.Status);
+            Assert.Equal("applied", matched.OverrideNote);
+
+            ManualOverrideRecord stale = Assert.Single(result.StaleOverrides);
+            Assert.Equal("superseded", stale.Note);
+        }
+
+        [Fact]
+        public void An_override_that_targets_no_break_is_surfaced_as_stale()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1") },
+                positions: new[] { Position("P-1") },
+                settlements: new[] { Settlement("S-1") },
+                overrides: new[] { Override("T-404", "ForceMatch") }));
+
+            Assert.Equal(1, result.MatchedCount);
+            Assert.Equal("T-404", Assert.Single(result.StaleOverrides).TradeId);
+        }
+
+        [Fact]
+        public void A_rejected_override_is_audited_once_per_rejected_break()
+        {
+            // The duplicate trade produces two breaks with the same identifier; the
+            // single instruction is audited once per rejected break.
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-1"), Trade("T-1") },
+                overrides: new[] { Override("T-1", "ForceMatch") }));
+
+            Assert.Equal(2, result.OpenBreaks.Count);
+            Assert.Equal(2, result.StaleOverrides.Count);
+        }
+
+        [Fact]
+        public void Results_are_sorted_by_trade_identifier()
+        {
+            ReconciliationResult result = _engine.Reconcile(Inputs(
+                trades: new[] { Trade("T-3"), Trade("T-1"), Trade("T-2") },
+                positions: new[] { Position("P-1"), Position("P-2"), Position("P-3") },
+                settlements: new[] { Settlement("S-1"), Settlement("S-2"), Settlement("S-3") }));
+
+            Assert.Equal(new[] { "T-1", "T-2", "T-3" }, result.MatchedTrades.Select(record => record.TradeId));
+        }
+
+        private static void AssertReason(ReconciliationResult result, string? expectedReason)
+        {
+            if (expectedReason is null)
+            {
+                Assert.Empty(result.OpenBreaks);
+                Assert.Equal(1, result.MatchedCount);
+                return;
+            }
+
+            Assert.Equal(expectedReason, Assert.Single(result.OpenBreaks).Reasons);
+        }
+
+        private static ReconciliationInputSet Inputs(
+            IReadOnlyList<TradeRecord>? trades = null,
+            IReadOnlyList<PositionRecord>? positions = null,
+            IReadOnlyList<SettlementRecord>? settlements = null,
+            IReadOnlyList<ManualOverrideRecord>? overrides = null)
+        {
+            return new ReconciliationInputSet
+            {
+                Trades = trades ?? Array.Empty<TradeRecord>(),
+                Positions = positions ?? Array.Empty<PositionRecord>(),
+                Settlements = settlements ?? Array.Empty<SettlementRecord>(),
+                Overrides = overrides ?? Array.Empty<ManualOverrideRecord>()
+            };
+        }
+
+        private static TradeRecord Trade(
+            string tradeId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            DateTime? settlementDate = null,
+            string currency = "USD",
+            decimal netAmount = 1000m)
+        {
+            return new TradeRecord
+            {
+                TradeId = tradeId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? SettlementDate,
+                Currency = currency,
+                NetAmount = netAmount
+            };
+        }
+
+        private static PositionRecord Position(
+            string positionId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            DateTime? settlementDate = null,
+            string currency = "USD")
+        {
+            return new PositionRecord
+            {
+                PositionId = positionId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? SettlementDate,
+                Currency = currency
+            };
+        }
+
+        private static SettlementRecord Settlement(
+            string settlementId,
+            string account = "ACC-001",
+            string instrument = "IBM.N",
+            decimal quantity = 100m,
+            DateTime? settlementDate = null,
+            string currency = "USD",
+            decimal cashAmount = 1000m)
+        {
+            return new SettlementRecord
+            {
+                SettlementId = settlementId,
+                Account = account,
+                Instrument = instrument,
+                Quantity = quantity,
+                SettlementDate = settlementDate ?? SettlementDate,
+                Currency = currency,
+                CashAmount = cashAmount
+            };
+        }
+
+        private static ManualOverrideRecord Override(
+            string tradeId,
+            string action,
+            string note = "note",
+            string approvedBy = "ops-manager")
+        {
+            return new ManualOverrideRecord
+            {
+                TradeId = tradeId,
+                Action = action,
+                Note = note,
+                ApprovedBy = approvedBy
+            };
+        }
+    }
+}
diff --git a/tests/LegacyTradeReconciliation.Tests/OutputContractTests.cs b/tests/LegacyTradeReconciliation.Tests/OutputContractTests.cs
new file mode 100644
index 0000000..e45c869
--- /dev/null
+++ b/tests/LegacyTradeReconciliation.Tests/OutputContractTests.cs
@@ -0,0 +1,155 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Csv;
+using LegacyTradeReconciliation.Domain;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    /// <summary>
+    /// Pins the physical file contract: headers, formats, encoding and line endings.
+    /// </summary>
+    public sealed class OutputContractTests
+    {
+        private static readonly DateTime SettlementDate = new(2025, 3, 17);
+        private readonly CsvOutputWriter _writer = new();
+
+        [Fact]
+        public void Matched_trades_use_the_published_header_and_formats()
+        {
+            using var output = new TempDirectory("matched-format");
+
+            _writer.WriteMatchedTrades(output.Path, new[]
+            {
+                new MatchedTradeRecord
+                {
+                    TradeId = "T-2",
+                    Status = MatchStatus.Matched,
+                    Account = "ACC-001",
+                    Instrument = "IBM.N",
+                    Quantity = 100.5m,
+                    SettlementDate = SettlementDate,
+                    Currency = "USD",
+                    PositionId = "P-1",
+                    SettlementId = "S-1",
+                    OverrideNote = null
+                },
+                new MatchedTradeRecord
+                {
+                    TradeId = "T-1",
+                    Status = MatchStatus.ManualOverrideSuppressed,
+                    Account = "ACC-001",
+                    Instrument = "IBM.N",
+                    Quantity = 100m,
+                    SettlementDate = SettlementDate,
+                    Currency = "USD",
+                    PositionId = null,
+                    SettlementId = null,
+                    OverrideNote = "note"
+                }
+            });
+
+            string[] lines = File.ReadAllLines(Path.Combine(output.Path, BatchFileNames.MatchedTrades));
+
+            Assert.Equal("trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note", lines[0]);
+            Assert.Equal("T-1,ManualOverrideSuppressed,ACC-001,IBM.N,100,2025-03-17,USD,,,note", lines[1]);
+            Assert.Equal("T-2,Matched,ACC-001,IBM.N,100.5,2025-03-17,USD,P-1,S-1,", lines[2]);
+        }
+
+        [Fact]
+        public void Break_queue_uses_the_published_header_and_sorts_by_trade_then_reasons()
+        {
+            using var output = new TempDirectory("break-format");
+
+            _writer.WriteBreakQueue(output.Path, new[]
+            {
+                Break("T-1", BreakReasons.MissingSettlement),
+                Break("T-1", BreakReasons.DuplicateTradeId)
+            });
+
+            string[] lines = File.ReadAllLines(Path.Combine(output.Path, BatchFileNames.BreakQueue));
+
+            Assert.Equal("trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id", lines[0]);
+            Assert.Equal("T-1,ACC-001,IBM.N,100,2025-03-17,USD,DuplicateTradeId,,", lines[1]);
+            Assert.Equal("T-1,ACC-001,IBM.N,100,2025-03-17,USD,MissingSettlement,,", lines[2]);
+        }
+
+        [Fact]
+        public void Artifacts_are_written_as_utf8_without_a_byte_order_mark_and_end_with_a_newline()
+        {
+            using var output = new TempDirectory("encoding");
+
+            _writer.WriteMatchedTrades(output.Path, Array.Empty<MatchedTradeRecord>());
+            _writer.WriteEndOfDayReport(output.Path, "report" + Environment.NewLine);
+
+            byte[] csv = File.ReadAllBytes(Path.Combine(output.Path, BatchFileNames.MatchedTrades));
+            byte[] report = File.ReadAllBytes(Path.Combine(output.Path, BatchFileNames.EndOfDayReport));
+
+            Assert.False(StartsWithBom(csv));
+            Assert.False(StartsWithBom(report));
+
+            byte[] newline = Encoding.UTF8.GetBytes(Environment.NewLine);
+            Assert.EndsWith(Environment.NewLine, Encoding.UTF8.GetString(csv), StringComparison.Ordinal);
+            Assert.Equal(newline.Length, csv.Length - CsvOutputWriter.MatchedTradesHeader.Length);
+        }
+
+        [Fact]
+        public void Outputs_exist_only_when_every_non_ledger_artifact_is_present()
+        {
+            using var output = new TempDirectory("outputs-exist");
+
+            Assert.False(_writer.OutputsExist(output.Path));
+
+            _writer.WriteMatchedTrades(output.Path, Array.Empty<MatchedTradeRecord>());
+            _writer.WriteBreakQueue(output.Path, Array.Empty<BreakRecord>());
+            Assert.False(_writer.OutputsExist(output.Path));
+
+            _writer.WriteEndOfDayReport(output.Path, "report");
+            Assert.True(_writer.OutputsExist(output.Path));
+        }
+
+        [Theory]
+        [InlineData("plain", "plain")]
+        [InlineData("", "")]
+        [InlineData(null, "")]
+        [InlineData("has,comma", "\"has,comma\"")]
+        [InlineData("has\"quote", "\"has\"\"quote\"")]
+        public void Fields_are_defensively_escaped_but_untouched_when_they_are_already_safe(string? value, string expected)
+        {
+            Assert.Equal(expected, CsvFormat.Field(value));
+        }
+
+        [Theory]
+        [InlineData("100", "100")]
+        [InlineData("100.5", "100.5")]
+        [InlineData("100.50000", "100.5")]
+        [InlineData("0.123456", "0.1235")]
+        [InlineData("-42", "-42")]
+        public void Decimals_use_the_published_format(string input, string expected)
+        {
+            Assert.Equal(expected, CsvFormat.Decimal(decimal.Parse(input, System.Globalization.CultureInfo.InvariantCulture)));
+        }
+
+        private static bool StartsWithBom(byte[] bytes)
+        {
+            return bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF;
+        }
+
+        private static BreakRecord Break(string tradeId, string reasons) => new()
+        {
+            TradeId = tradeId,
+            Account = "ACC-001",
+            Instrument = "IBM.N",
+            Quantity = 100m,
+            SettlementDate = SettlementDate,
+            Currency = "USD",
+            Reasons = reasons,
+            PositionId = null,
+            SettlementId = null,
+            CanManualOverride = false
+        };
+    }
+}
