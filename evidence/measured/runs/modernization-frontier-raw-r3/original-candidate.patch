+using System;
+using System.IO;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Ledger;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    public sealed class RunLedgerStoreTests
+    {
+        private static readonly DateTime BusinessDate = new(2025, 3, 17);
+        private readonly CsvRunLedgerStore _store = new();
+
+        [Fact]
+        public void An_empty_ledger_contains_nothing()
+        {
+            using var output = new TempDirectory("ledger-empty");
+
+            Assert.False(_store.Contains(output.Path, BusinessDate, "signature"));
+            Assert.Empty(_store.Read(output.Path));
+        }
+
+        [Fact]
+        public void The_header_is_written_once_and_entries_are_appended()
+        {
+            using var output = new TempDirectory("ledger-append");
+
+            _store.AppendIfMissing(output.Path, Entry("signature-a", matchedCount: 2));
+            _store.AppendIfMissing(output.Path, Entry("signature-b", matchedCount: 3));
+
+            string[] lines = File.ReadAllLines(Path.Combine(output.Path, BatchFileNames.RunLedger));
+
+            Assert.Equal("business_date,input_signature,total_trades_read,open_break_count,matched_count", lines[0]);
+            Assert.Equal("2025-03-17,signature-a,5,1,2", lines[1]);
+            Assert.Equal("2025-03-17,signature-b,5,1,3", lines[2]);
+            Assert.Equal(3, lines.Length);
+        }
+
+        [Fact]
+        public void An_identical_entry_is_never_appended_twice()
+        {
+            using var output = new TempDirectory("ledger-idempotent");
+
+            _store.AppendIfMissing(output.Path, Entry("signature-a"));
+            _store.AppendIfMissing(output.Path, Entry("signature-a"));
+
+            Assert.Single(_store.Read(output.Path));
+            Assert.True(_store.Contains(output.Path, BusinessDate, "signature-a"));
+            Assert.False(_store.Contains(output.Path, BusinessDate.AddDays(1), "signature-a"));
+        }
+
+        [Fact]
+        public void A_hand_edited_ledger_fails_loudly()
+        {
+            using var output = new TempDirectory("ledger-corrupt");
+            File.WriteAllText(
+                Path.Combine(output.Path, BatchFileNames.RunLedger),
+                "business_date,input_signature,total_trades_read,open_break_count,matched_count" + Environment.NewLine +
+                "2025-03-17,signature" + Environment.NewLine);
+
+            InvalidDataException exception = Assert.Throws<InvalidDataException>(() => _store.Read(output.Path));
+            Assert.Contains(BatchFileNames.RunLedger, exception.Message, StringComparison.Ordinal);
+        }
+
+        private static RunLedgerEntry Entry(string signature, int matchedCount = 2) => new()
+        {
+            BusinessDate = BusinessDate,
+            InputSignature = signature,
+            TotalTradesRead = 5,
+            OpenBreakCount = 1,
+            MatchedCount = matchedCount
+        };
+    }
+}
