@@ -0,0 +1,23 @@
+namespace LegacyTradeReconciliation.Domain
+{
+    /// <summary>
+    /// Field normalization shared by every comparison in the batch.
+    /// Account, instrument, currency, trade identifiers and override actions are
+    /// always compared on their trimmed, upper-cased invariant form.
+    /// </summary>
+    public static class FieldNormalizer
+    {
+        public static string Normalize(string? value)
+        {
+            return (value ?? string.Empty).Trim().ToUpperInvariant();
+        }
+
+        /// <summary>
+        /// Builds the account/instrument bucket key used to index counterpart records.
+        /// </summary>
+        public static string PairKey(string? account, string? instrument)
+        {
+            return Normalize(account) + "|" + Normalize(instrument);
+        }
+    }
+}
