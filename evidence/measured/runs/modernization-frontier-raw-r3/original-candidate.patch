@@ -0,0 +1,87 @@
+using System;
+using System.IO;
+using LegacyTradeReconciliation.Cli;
+using LegacyTradeReconciliation.Configuration;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    public sealed class CommandLineTests
+    {
+        [Fact]
+        public void No_arguments_runs_the_built_in_sample_batch()
+        {
+            RunRequest request = CommandLine.Parse(Array.Empty<string>(), baseDirectory: Path.Combine(Path.GetTempPath(), "app"));
+
+            Assert.Equal(new DateTime(2025, 3, 17), request.BusinessDate);
+            Assert.EndsWith(Path.Combine("data", "sample"), request.InputDirectory, StringComparison.Ordinal);
+            Assert.EndsWith(Path.Combine("output", "sample"), request.OutputDirectory, StringComparison.Ordinal);
+        }
+
+        [Fact]
+        public void Three_arguments_are_resolved_to_absolute_directories()
+        {
+            RunRequest request = CommandLine.Parse(new[] { "2025-03-17", "in", "out" }, baseDirectory: Path.GetTempPath());
+
+            Assert.Equal(new DateTime(2025, 3, 17), request.BusinessDate);
+            Assert.Equal("2025-03-17", request.FormattedBusinessDate);
+            Assert.True(Path.IsPathFullyQualified(request.InputDirectory));
+            Assert.True(Path.IsPathFullyQualified(request.OutputDirectory));
+        }
+
+        [Fact]
+        public void An_unsupported_argument_count_is_rejected()
+        {
+            string[][] unsupported =
+            {
+                new[] { "2025-03-17" },
+                new[] { "2025-03-17", "in" },
+                new[] { "2025-03-17", "in", "out", "extra" }
+            };
+
+            foreach (string[] args in unsupported)
+            {
+                Assert.Throws<ArgumentException>(() => CommandLine.Parse(args, baseDirectory: Path.GetTempPath()));
+            }
+        }
+
+        [Theory]
+        [InlineData("17-03-2025")]
+        [InlineData("2025/03/17")]
+        [InlineData("not-a-date")]
+        public void An_unsupported_business_date_is_rejected(string businessDate)
+        {
+            Assert.Throws<FormatException>(() => CommandLine.Parse(new[] { businessDate, "in", "out" }, baseDirectory: Path.GetTempPath()));
+        }
+
+        [Fact]
+        public void A_successful_run_exits_with_zero()
+        {
+            using var output = new TempDirectory("cli-success");
+
+            int exitCode = Program.Main(new[] { "2025-03-17", TestEnvironment.FixtureInput("baseline"), output.Path });
+
+            Assert.Equal(Program.ExitSuccess, exitCode);
+            Assert.True(File.Exists(Path.Combine(output.Path, BatchFileNames.MatchedTrades)));
+            Assert.True(File.Exists(Path.Combine(output.Path, BatchFileNames.RunLedger)));
+        }
+
+        [Fact]
+        public void A_bad_command_line_exits_with_the_invalid_argument_code()
+        {
+            using var output = new TempDirectory("cli-bad-args");
+
+            Assert.Equal(Program.ExitInvalidArguments, Program.Main(new[] { "17-03-2025", "in", output.Path }));
+            Assert.Equal(Program.ExitInvalidArguments, Program.Main(new[] { "2025-03-17", "in" }));
+        }
+
+        [Fact]
+        public void A_missing_input_directory_exits_with_the_run_failure_code()
+        {
+            using var output = new TempDirectory("cli-missing-input");
+            string missing = Path.Combine(Path.GetTempPath(), "missing-" + Guid.NewGuid().ToString("N"));
+
+            Assert.Equal(Program.ExitRunFailed, Program.Main(new[] { "2025-03-17", missing, output.Path }));
+        }
+    }
+}
