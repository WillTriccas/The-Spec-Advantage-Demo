diff --git a/src/LegacyTradeReconciliation.Core/Ledger/CsvRunLedgerStore.cs b/src/LegacyTradeReconciliation.Core/Ledger/CsvRunLedgerStore.cs
new file mode 100644
index 0000000..953436c
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/Ledger/CsvRunLedgerStore.cs
@@ -0,0 +1,118 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Csv;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Ledger
+{
+    /// <summary>
+    /// Append-only <c>run-ledger.csv</c> store. The ledger is what makes an
+    /// exact-input rerun for the same business date a no-op.
+    /// </summary>
+    public sealed class CsvRunLedgerStore : IRunLedgerStore
+    {
+        internal const string Header = "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+        public bool Contains(string outputDirectory, DateTime businessDate, string inputSignature)
+        {
+            ArgumentNullException.ThrowIfNull(inputSignature);
+
+            return Load(LedgerPath(outputDirectory)).Any(entry =>
+                entry.BusinessDate == businessDate &&
+                string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal));
+        }
+
+        public void AppendIfMissing(string outputDirectory, RunLedgerEntry entry)
+        {
+            ArgumentNullException.ThrowIfNull(entry);
+
+            string path = LedgerPath(outputDirectory);
+            if (Contains(outputDirectory, entry.BusinessDate, entry.InputSignature))
+            {
+                return;
+            }
+
+            var lines = new List<string>(2);
+            if (!File.Exists(path))
+            {
+                lines.Add(Header);
+            }
+
+            lines.Add(CsvFormat.Row(
+                CsvFormat.Date(entry.BusinessDate),
+                entry.InputSignature,
+                entry.TotalTradesRead.ToString(CultureInfo.InvariantCulture),
+                entry.OpenBreakCount.ToString(CultureInfo.InvariantCulture),
+                entry.MatchedCount.ToString(CultureInfo.InvariantCulture)));
+
+            File.AppendAllLines(path, lines, CsvFormat.Utf8NoBom);
+        }
+
+        public IReadOnlyList<RunLedgerEntry> Read(string outputDirectory)
+        {
+            return Load(LedgerPath(outputDirectory));
+        }
+
+        private static string LedgerPath(string outputDirectory)
+        {
+            ArgumentException.ThrowIfNullOrWhiteSpace(outputDirectory);
+            return Path.Combine(outputDirectory, BatchFileNames.RunLedger);
+        }
+
+        private static List<RunLedgerEntry> Load(string ledgerPath)
+        {
+            if (!File.Exists(ledgerPath))
+            {
+                return new List<RunLedgerEntry>();
+            }
+
+            string[] lines = File.ReadAllLines(ledgerPath);
+            var entries = new List<RunLedgerEntry>(Math.Max(0, lines.Length - 1));
+
+            for (int index = 1; index < lines.Length; index++)
+            {
+                if (string.IsNullOrWhiteSpace(lines[index]))
+                {
+                    continue;
+                }
+
+                entries.Add(ParseEntry(lines[index], index + 1));
+            }
+
+            return entries;
+        }
+
+        private static RunLedgerEntry ParseEntry(string line, int lineNumber)
+        {
+            string[] cells = line.Split(',');
+            if (cells.Length != 5)
+            {
+                throw new InvalidDataException(
+                    $"{BatchFileNames.RunLedger} line {lineNumber.ToString(CultureInfo.InvariantCulture)} is corrupt; the run ledger must not be edited by hand.");
+            }
+
+            try
+            {
+                return new RunLedgerEntry
+                {
+                    BusinessDate = DateTime.ParseExact(cells[0], CsvFormat.DateFormat, CultureInfo.InvariantCulture),
+                    InputSignature = cells[1],
+                    TotalTradesRead = int.Parse(cells[2], CultureInfo.InvariantCulture),
+                    OpenBreakCount = int.Parse(cells[3], CultureInfo.InvariantCulture),
+                    MatchedCount = int.Parse(cells[4], CultureInfo.InvariantCulture)
+                };
+            }
+            catch (FormatException exception)
+            {
+                throw new InvalidDataException(
+                    $"{BatchFileNames.RunLedger} line {lineNumber.ToString(CultureInfo.InvariantCulture)} is corrupt; the run ledger must not be edited by hand.",
+                    exception);
+            }
+        }
+    }
+}
diff --git a/src/LegacyTradeReconciliation.Core/Ledger/Sha256InputSignatureCalculator.cs b/src/LegacyTradeReconciliation.Core/Ledger/Sha256InputSignatureCalculator.cs
new file mode 100644
index 0000000..6549827
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/Ledger/Sha256InputSignatureCalculator.cs
@@ -0,0 +1,45 @@
+using System;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Csv;
+
+namespace LegacyTradeReconciliation.Ledger
+{
+    /// <summary>
+    /// Computes the SHA-256 content signature of a business date plus every file in
+    /// the input directory. The signature is recorded in <c>run-ledger.csv</c> and is
+    /// what lets the batch recognise an exact rerun.
+    /// </summary>
+    /// <remarks>
+    /// The payload layout (and therefore the published signature value) is a
+    /// behavioral contract and must not be "improved".
+    /// </remarks>
+    public sealed class Sha256InputSignatureCalculator : IInputSignatureCalculator
+    {
+        public string Calculate(DateTime businessDate, string inputDirectory)
+        {
+            ArgumentException.ThrowIfNullOrWhiteSpace(inputDirectory);
+
+            if (!Directory.Exists(inputDirectory))
+            {
+                throw new DirectoryNotFoundException($"Input directory '{inputDirectory}' does not exist.");
+            }
+
+            var payload = new StringBuilder();
+            payload.AppendLine(businessDate.ToString(CsvFormat.DateFormat, CultureInfo.InvariantCulture));
+
+            foreach (string filePath in Directory.GetFiles(inputDirectory).OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
+            {
+                payload.AppendLine(Path.GetFileName(filePath));
+                payload.AppendLine(File.ReadAllText(filePath));
+            }
+
+            byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+            return Convert.ToHexString(hash).ToLowerInvariant();
+        }
+    }
+}
