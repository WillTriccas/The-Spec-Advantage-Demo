+using LegacyTradeReconciliation.Csv;
+using LegacyTradeReconciliation.Domain;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    public sealed class CsvInputReaderTests
+    {
+        private readonly CsvInputReader _reader = new();
+
+        [Fact]
+        public void Reads_every_feed_from_a_fixture_directory()
+        {
+            ReconciliationInputSet inputs = _reader.Read(TestEnvironment.FixtureInput("override-rerun"));
+
+            Assert.Equal(5, inputs.Trades.Count);
+            Assert.Equal(4, inputs.Positions.Count);
+            Assert.Equal(4, inputs.Settlements.Count);
+            Assert.Equal(2, inputs.Overrides.Count);
+            Assert.Equal("T-1001", inputs.Trades[0].TradeId);
+            Assert.Equal(new DateTime(2025, 3, 17), inputs.Trades[0].SettlementDate);
+        }
+
+        [Fact]
+        public void Overrides_are_optional()
+        {
+            using var input = new TempDirectory("no-overrides");
+            CopyFeedsExceptOverrides(input.Path);
+
+            ReconciliationInputSet inputs = _reader.Read(input.Path);
+
+            Assert.Empty(inputs.Overrides);
+        }
+
+        [Fact]
+        public void Blank_rows_are_ignored_and_cells_are_trimmed()
+        {
+            using var input = new TempDirectory("blank-rows");
+            CopyFeedsExceptOverrides(input.Path);
+            File.WriteAllText(
+                Path.Combine(input.Path, BatchFileNames.Trades),
+                "trade_id,account,instrument,quantity,settlement_date,currency,net_amount\n" +
+                "\n" +
+                "  T-1 , ACC-1 , IBM.N , 100 , 2025-03-17 , USD , 1000 \n" +
+                "   \n");
+
+            ReconciliationInputSet inputs = _reader.Read(input.Path);
+
+            TradeRecord trade = Assert.Single(inputs.Trades);
+            Assert.Equal("T-1", trade.TradeId);
+            Assert.Equal("ACC-1", trade.Account);
+            Assert.Equal(1000m, trade.NetAmount);
+        }
+
+        [Fact]
+        public void A_row_with_the_wrong_column_count_aborts_the_run()
+        {
+            using var input = new TempDirectory("bad-shape");
+            CopyFeedsExceptOverrides(input.Path);
+            File.AppendAllText(Path.Combine(input.Path, BatchFileNames.Trades), "T-9,ACC-1,IBM.N,100\n");
+
+            InvalidDataException exception = Assert.Throws<InvalidDataException>(() => _reader.Read(input.Path));
+
+            Assert.Contains(BatchFileNames.Trades, exception.Message, StringComparison.Ordinal);
+            Assert.DoesNotContain("ACC-1", exception.Message, StringComparison.Ordinal);
+        }
+
+        [Fact]
+        public void A_row_with_an_unparsable_value_aborts_the_run_without_echoing_data()
+        {
+            using var input = new TempDirectory("bad-value");
+            CopyFeedsExceptOverrides(input.Path);
+            File.AppendAllText(Path.Combine(input.Path, BatchFileNames.Trades), "T-9,ACC-1,IBM.N,100,17-03-2025,USD,1000\n");
+
+            InvalidDataException exception = Assert.Throws<InvalidDataException>(() => _reader.Read(input.Path));
+
+            Assert.Contains("malformed value", exception.Message, StringComparison.Ordinal);
+            Assert.DoesNotContain("ACC-1", exception.Message, StringComparison.Ordinal);
+        }
+
+        [Fact]
+        public void A_missing_required_feed_is_reported_clearly()
+        {
+            using var input = new TempDirectory("missing-feed");
+
+            Assert.Throws<FileNotFoundException>(() => _reader.Read(input.Path));
+        }
+
+        [Fact]
+        public void A_missing_input_directory_is_reported_clearly()
+        {
+            Assert.Throws<DirectoryNotFoundException>(() => _reader.Read(Path.Combine(Path.GetTempPath(), "definitely-not-here-" + Guid.NewGuid().ToString("N"))));
+        }
+
+        private static void CopyFeedsExceptOverrides(string destination)
+        {
+            foreach (string file in Directory.GetFiles(TestEnvironment.FixtureInput("override-rerun"))
+                         .Where(path => !string.Equals(Path.GetFileName(path), BatchFileNames.Overrides, StringComparison.Ordinal)))
+            {
+                File.Copy(file, Path.Combine(destination, Path.GetFileName(file)), overwrite: true);
+            }
+        }
+    }
+}
