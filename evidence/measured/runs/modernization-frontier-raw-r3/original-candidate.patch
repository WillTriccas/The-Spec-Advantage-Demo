+using System;
+using System.Globalization;
+using System.IO;
+
+namespace LegacyTradeReconciliation.Configuration
+{
+    /// <summary>
+    /// A validated batch invocation: business date plus fully qualified input and
+    /// output directories.
+    /// </summary>
+    public sealed class RunRequest
+    {
+        public const string BusinessDateFormat = "yyyy-MM-dd";
+
+        public RunRequest(DateTime businessDate, string inputDirectory, string outputDirectory)
+        {
+            ArgumentException.ThrowIfNullOrWhiteSpace(inputDirectory);
+            ArgumentException.ThrowIfNullOrWhiteSpace(outputDirectory);
+
+            BusinessDate = businessDate.Date;
+            InputDirectory = Path.GetFullPath(inputDirectory);
+            OutputDirectory = Path.GetFullPath(outputDirectory);
+        }
+
+        public DateTime BusinessDate { get; }
+
+        public string InputDirectory { get; }
+
+        public string OutputDirectory { get; }
+
+        public string FormattedBusinessDate => BusinessDate.ToString(BusinessDateFormat, CultureInfo.InvariantCulture);
+
+        /// <summary>
+        /// Parses a business date in the only format the batch has ever accepted.
+        /// </summary>
+        public static DateTime ParseBusinessDate(string value)
+        {
+            ArgumentNullException.ThrowIfNull(value);
+
+            if (!DateTime.TryParseExact(value, BusinessDateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime businessDate))
+            {
+                throw new FormatException($"Business date '{value}' is not in the required {BusinessDateFormat} format.");
+            }
+
+            return businessDate;
+        }
+    }
+}
diff --git a/src/LegacyTradeReconciliation.Core/Csv/CsvFormat.cs b/src/LegacyTradeReconciliation.Core/Csv/CsvFormat.cs
new file mode 100644
index 0000000..afb3b16
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/Csv/CsvFormat.cs
@@ -0,0 +1,56 @@
+using System;
+using System.Globalization;
+using System.Text;
+
+namespace LegacyTradeReconciliation.Csv
+{
+    /// <summary>
+    /// Formatting and escaping rules shared by every CSV artifact the batch writes.
+    /// </summary>
+    public static class CsvFormat
+    {
+        /// <summary>
+        /// UTF-8 without a byte order mark, matching the encoding the batch has
+        /// always produced. Invalid surrogates fail loudly instead of being
+        /// silently replaced.
+        /// </summary>
+        public static Encoding Utf8NoBom { get; } = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true);
+
+        public const string DateFormat = "yyyy-MM-dd";
+
+        public const string DecimalFormat = "0.####";
+
+        public static string Decimal(decimal value) => value.ToString(DecimalFormat, CultureInfo.InvariantCulture);
+
+        public static string Date(DateTime value) => value.ToString(DateFormat, CultureInfo.InvariantCulture);
+
+        /// <summary>
+        /// Defensive RFC 4180 escaping. The strict input parser rejects rows whose
+        /// cell count does not match the schema, so well-formed feeds can never
+        /// contain a separator, quote or newline. This is belt-and-braces so a future
+        /// input source cannot inject extra columns or rows into a downstream file.
+        /// </summary>
+        public static string Field(string? value)
+        {
+            if (string.IsNullOrEmpty(value))
+            {
+                return string.Empty;
+            }
+
+            if (value.IndexOfAny(EscapeTriggers) < 0)
+            {
+                return value;
+            }
+
+            return "\"" + value.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";
+        }
+
+        public static string Row(params string?[] fields)
+        {
+            ArgumentNullException.ThrowIfNull(fields);
+            return string.Join(",", Array.ConvertAll(fields, Field));
+        }
+
+        private static readonly char[] EscapeTriggers = { ',', '"', '\r', '\n' };
+    }
+}
