@@ -0,0 +1,75 @@
+using System;
+using System.IO;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Ledger;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    public sealed class InputSignatureTests
+    {
+        private readonly Sha256InputSignatureCalculator _calculator = new();
+
+        /// <summary>
+        /// The signature is published in <c>run-ledger.csv</c>, so these are the exact
+        /// values the .NET Framework batch produced for the shipped fixtures.
+        /// </summary>
+        [Theory]
+        [InlineData("baseline", "993d5b30312e3dbe1e13840e3d1ddeb76fb5359c1f964ef525595bf721f6685f")]
+        [InlineData("override-rerun", "c5d01c66c9e4af13353b6d368ba9fa0e1d48dbba072302d9ed9ce5f8eebd0b7f")]
+        public void Signature_matches_the_legacy_value(string scenario, string expected)
+        {
+            if (!string.Equals(Environment.NewLine, "\r\n", StringComparison.Ordinal))
+            {
+                // The legacy payload separator is the platform newline; the pinned
+                // values were produced on Windows.
+                return;
+            }
+
+            Assert.Equal(expected, _calculator.Calculate(new DateTime(2025, 3, 17), TestEnvironment.FixtureInput(scenario)));
+        }
+
+        [Fact]
+        public void Signature_is_stable_across_calls()
+        {
+            string input = TestEnvironment.FixtureInput("baseline");
+
+            Assert.Equal(
+                _calculator.Calculate(new DateTime(2025, 3, 17), input),
+                _calculator.Calculate(new DateTime(2025, 3, 17), input));
+        }
+
+        [Fact]
+        public void Signature_covers_the_business_date()
+        {
+            string input = TestEnvironment.FixtureInput("baseline");
+
+            Assert.NotEqual(
+                _calculator.Calculate(new DateTime(2025, 3, 17), input),
+                _calculator.Calculate(new DateTime(2025, 3, 18), input));
+        }
+
+        [Fact]
+        public void Signature_covers_every_file_in_the_input_directory()
+        {
+            using var input = new TempDirectory("signature-input");
+            foreach (string file in Directory.GetFiles(TestEnvironment.FixtureInput("baseline")))
+            {
+                File.Copy(file, Path.Combine(input.Path, Path.GetFileName(file)), overwrite: true);
+            }
+
+            string before = _calculator.Calculate(new DateTime(2025, 3, 17), input.Path);
+            File.AppendAllText(Path.Combine(input.Path, BatchFileNames.Positions), "P-9,ACC-9,BP.L,10,2025-03-17,GBP\n");
+            string after = _calculator.Calculate(new DateTime(2025, 3, 17), input.Path);
+
+            Assert.NotEqual(before, after);
+        }
+
+        [Fact]
+        public void A_missing_input_directory_is_reported_clearly()
+        {
+            Assert.Throws<DirectoryNotFoundException>(
+                () => _calculator.Calculate(new DateTime(2025, 3, 17), Path.Combine(Path.GetTempPath(), "missing-" + Guid.NewGuid().ToString("N"))));
+        }
+    }
+}
