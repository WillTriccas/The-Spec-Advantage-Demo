--- a/LegacyTradeReconciliation/EndOfDayReporter.cs
+++ b/src/LegacyTradeReconciliation.Core/Reporting/EndOfDayReporter.cs
@@ -2,28 +2,35 @@ using System;
 using System.Globalization;
 using System.Linq;
 using System.Text;
+using LegacyTradeReconciliation.Abstractions;
 using LegacyTradeReconciliation.Domain;
 
-namespace LegacyTradeReconciliation
+namespace LegacyTradeReconciliation.Reporting
 {
-    public sealed class EndOfDayReporter
+    /// <summary>
+    /// Renders <c>end-of-day-report.txt</c>. The layout is part of the observable
+    /// contract Trade Operations reads every morning.
+    /// </summary>
+    public sealed class EndOfDayReporter : IEndOfDayReportBuilder
     {
         public string BuildReport(DateTime businessDate, ReconciliationResult result)
         {
+            ArgumentNullException.ThrowIfNull(result);
+
