+using System;
+using System.IO;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Csv;
+using LegacyTradeReconciliation.Ledger;
+using LegacyTradeReconciliation.Matching;
+using LegacyTradeReconciliation.Reporting;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    /// <summary>
+    /// Shared helpers for fixture-driven tests.
+    /// </summary>
+    internal static class TestEnvironment
+    {
+        public static string FixtureInput(string scenario) => Path.Combine(FixtureRoot(scenario), "input");
+
+        public static string FixtureExpected(string scenario) => Path.Combine(FixtureRoot(scenario), "expected");
+
+        public static string FixtureRoot(string scenario) => Path.Combine(AppContext.BaseDirectory, "Fixtures", scenario);
+
+        public static ReconciliationBatch CreateBatch(IBatchLog? log = null)
+        {
+            return new ReconciliationBatch(
+                new CsvInputReader(),
+                new MatchingEngine(),
+                new EndOfDayReporter(),
+                new CsvOutputWriter(),
+                new CsvRunLedgerStore(),
+                new Sha256InputSignatureCalculator(),
+                log ?? NullBatchLog.Instance);
+        }
+
+        public static RunRequest Request(string inputDirectory, string outputDirectory, string businessDate = "2025-03-17")
+        {
+            return new RunRequest(RunRequest.ParseBusinessDate(businessDate), inputDirectory, outputDirectory);
+        }
+
+        /// <summary>
+        /// Compares text ignoring the platform line ending so golden masters stay
+        /// portable; <see cref="OutputContractTests"/> pins the newline style itself.
+        /// </summary>
+        public static string NormalizeNewlines(string value)
+        {
+            return value.Replace("\r\n", "\n", StringComparison.Ordinal);
+        }
+
+        public static string ReadOutput(string outputDirectory, string fileName)
+        {
+            return File.ReadAllText(Path.Combine(outputDirectory, fileName));
+        }
+
+        public static string ReadExpected(string scenario, string fileName)
+        {
+            return File.ReadAllText(Path.Combine(FixtureExpected(scenario), fileName));
+        }
+    }
+
+    /// <summary>
+    /// A throwaway directory that is removed when the test finishes.
+    /// </summary>
+    internal sealed class TempDirectory : IDisposable
+    {
+        public TempDirectory(string label)
+        {
+            Path = System.IO.Path.Combine(
+                System.IO.Path.GetTempPath(),
+                "legacy-trade-reconciliation-tests",
+                label + "-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(Path);
+        }
+
+        public string Path { get; }
+
+        public void Dispose()
+        {
+            try
+            {
+                if (Directory.Exists(Path))
+                {
+                    Directory.Delete(Path, recursive: true);
+                }
+            }
+            catch (IOException)
+            {
+                // A leaked temp directory must never fail a test run.
+            }
+        }
+    }
+
+    /// <summary>Captures log output so tests can assert on operator-facing messages.</summary>
+    internal sealed class RecordingBatchLog : IBatchLog
+    {
+        private readonly System.Collections.Generic.List<string> _messages = new();
+
+        public System.Collections.Generic.IReadOnlyList<string> Messages => _messages;
+
+        public void Info(string message) => _messages.Add(message);
+    }
+}
