diff --git a/src/LegacyTradeReconciliation.Core/Matching/MatchingEngine.cs b/src/LegacyTradeReconciliation.Core/Matching/MatchingEngine.cs
new file mode 100644
index 0000000..36959f7
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/Matching/MatchingEngine.cs
@@ -0,0 +1,404 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Matching
+{
+    /// <summary>
+    /// Applies the trade reconciliation rules. The engine is deterministic and free
+    /// of I/O, so every rule below is directly unit testable.
+    /// </summary>
+    /// <remarks>
+    /// The behavior encoded here is a business contract that Trade Operations relies
+    /// on. Ordering, reason codes and the manual override lifecycle are intentionally
+    /// preserved exactly as the .NET Framework batch behaved.
+    /// </remarks>
+    public sealed class MatchingEngine : IMatchingEngine
+    {
+        private readonly ReconciliationTolerances _tolerances;
+
+        public MatchingEngine()
+            : this(ReconciliationTolerances.Default)
+        {
+        }
+
+        public MatchingEngine(ReconciliationTolerances tolerances)
+        {
+            ArgumentNullException.ThrowIfNull(tolerances);
+            _tolerances = tolerances;
+        }
+
+        public ReconciliationResult Reconcile(ReconciliationInputSet inputs)
+        {
+            ArgumentNullException.ThrowIfNull(inputs);
+
+            var matchedTrades = new List<MatchedTradeRecord>();
+            var breakQueue = new List<BreakRecord>();
+
+            // Override rows keep reference identity: two rows with identical values are
+            // still two distinct instructions for audit purposes.
+            var staleOverrides = new List<ManualOverrideRecord>();
+            var staleOverrideIdentities = new HashSet<ManualOverrideRecord>(ReferenceEqualityComparer.Instance);
+
+            List<IGrouping<string, ManualOverrideRecord>> overrideGroups = inputs.Overrides
+                .GroupBy(record => FieldNormalizer.Normalize(record.TradeId), StringComparer.Ordinal)
+                .ToList();
+
+            // Only the first instruction per trade is applied; later ones are audited.
+            Dictionary<string, ManualOverrideRecord> overrideMap = overrideGroups
+                .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
+
+            foreach (ManualOverrideRecord supersededOverride in overrideGroups.SelectMany(group => group.Skip(1)))
+            {
+                AddStale(staleOverrides, staleOverrideIdentities, supersededOverride);
+            }
+
+            Dictionary<string, List<PositionRecord>> positionsByPair = inputs.Positions
+                .GroupBy(position => FieldNormalizer.PairKey(position.Account, position.Instrument), StringComparer.Ordinal)
+                .ToDictionary(
+                    group => group.Key,
+                    group => group.OrderBy(position => position.PositionId, StringComparer.Ordinal).ToList(),
+                    StringComparer.Ordinal);
+
+            Dictionary<string, List<SettlementRecord>> settlementsByPair = inputs.Settlements
+                .GroupBy(settlement => FieldNormalizer.PairKey(settlement.Account, settlement.Instrument), StringComparer.Ordinal)
+                .ToDictionary(
+                    group => group.Key,
+                    group => group.OrderBy(settlement => settlement.SettlementId, StringComparer.Ordinal).ToList(),
+                    StringComparer.Ordinal);
+
+            var usedPositions = new HashSet<string>(StringComparer.Ordinal);
+            var usedSettlements = new HashSet<string>(StringComparer.Ordinal);
+            var seenTradeIds = new HashSet<string>(StringComparer.Ordinal);
+            int duplicateTradeCount = 0;
+
+            foreach (TradeRecord trade in inputs.Trades)
+            {
+                string normalizedTradeId = FieldNormalizer.Normalize(trade.TradeId);
+
+                // The first occurrence of a trade identifier is canonical.
+                if (!seenTradeIds.Add(normalizedTradeId))
+                {
+                    duplicateTradeCount++;
+                    breakQueue.Add(CreateBreak(trade, BreakReasons.DuplicateTradeId, positionId: null, settlementId: null, canManualOverride: false));
+                    continue;
+                }
+
+                // Non-positive quantities or net amounts are always breaks.
+                if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+                {
+                    breakQueue.Add(CreateBreak(trade, BreakReasons.TradeValueOutOfBounds, positionId: null, settlementId: null, canManualOverride: false));
+                    continue;
+                }
+
+                string pairKey = FieldNormalizer.PairKey(trade.Account, trade.Instrument);
+                var reasons = new List<string>();
+
+                PositionRecord? position = null;
+                SettlementRecord? settlement = null;
+
+                if (!positionsByPair.TryGetValue(pairKey, out List<PositionRecord>? positionCandidates))
+                {
+                    reasons.Add(BreakReasons.MissingPosition);
+                }
+                else
+                {
+                    position = FindPosition(trade, positionCandidates, usedPositions, reasons);
+                }
+
+                if (!settlementsByPair.TryGetValue(pairKey, out List<SettlementRecord>? settlementCandidates))
+                {
+                    reasons.Add(BreakReasons.MissingSettlement);
+                }
+                else
+                {
+                    settlement = FindSettlement(trade, settlementCandidates, usedSettlements, reasons);
+                }
+
+                if (reasons.Count == 0 && position is not null && settlement is not null)
+                {
+                    usedPositions.Add(position.PositionId);
+                    usedSettlements.Add(settlement.SettlementId);
+                    matchedTrades.Add(CreateMatchedTrade(trade, MatchStatus.Matched, position.PositionId, settlement.SettlementId, overrideNote: null));
+                    continue;
+                }
+
+                // A break may only be manually overridden when concrete counterpart
+                // candidates existed. Duplicate and out-of-bounds trades never reach
+                // this point, so they can never be overridden.
+                bool canManualOverride =
+                    positionCandidates is not null &&
+                    settlementCandidates is not null &&
+                    !reasons.Contains(BreakReasons.MissingPosition, StringComparer.Ordinal) &&
+                    !reasons.Contains(BreakReasons.MissingSettlement, StringComparer.Ordinal);
+
+                breakQueue.Add(CreateBreak(
+                    trade,
+                    FormatReasons(reasons),
+                    position?.PositionId ?? GetNearestPositionId(trade, positionCandidates),
+                    settlement?.SettlementId ?? GetNearestSettlementId(trade, settlementCandidates),
+                    canManualOverride));
+            }
+
+            ApplyManualOverrides(overrideMap, inputs.Overrides, matchedTrades, breakQueue, staleOverrides, staleOverrideIdentities);
+
+            return new ReconciliationResult
+            {
+                MatchedTrades = matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                OpenBreaks = breakQueue.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                StaleOverrides = staleOverrides.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+                TotalTradesRead = inputs.Trades.Count,
+                CanonicalTradeCount = seenTradeIds.Count,
+                DuplicateTradeCount = duplicateTradeCount,
+                MatchedCount = matchedTrades.Count(record => record.Status == MatchStatus.Matched),
+                ManualOverrideMatchedCount = matchedTrades.Count(record => record.Status == MatchStatus.ManualOverrideMatched),
+                ManualOverrideSuppressedCount = matchedTrades.Count(record => record.Status == MatchStatus.ManualOverrideSuppressed)
+            };
+        }
+
+        private static void ApplyManualOverrides(
+            Dictionary<string, ManualOverrideRecord> overrideMap,
+            IReadOnlyList<ManualOverrideRecord> allOverrides,
+            List<MatchedTradeRecord> matchedTrades,
+            List<BreakRecord> breakQueue,
+            List<ManualOverrideRecord> staleOverrides,
+            HashSet<ManualOverrideRecord> staleOverrideIdentities)
+        {
+            var targetedTrades = new HashSet<string>(StringComparer.Ordinal);
+
+            foreach (BreakRecord breakRecord in breakQueue.ToList())
+            {
+                if (!overrideMap.TryGetValue(FieldNormalizer.Normalize(breakRecord.TradeId), out ManualOverrideRecord? manualOverride))
+                {
+                    continue;
+                }
+
+                targetedTrades.Add(FieldNormalizer.Normalize(breakRecord.TradeId));
+
+                // Overrides cannot manufacture missing counterpart records, and they
+                // must carry an approver and a note to be auditable.
+                if (!breakRecord.CanManualOverride ||
+                    string.IsNullOrWhiteSpace(manualOverride.Note) ||
+                    string.IsNullOrWhiteSpace(manualOverride.ApprovedBy))
+                {
+                    // Intentionally unguarded: when a trade identifier produced more than
+                    // one break, the same instruction is audited once per rejected break.
+                    AddStale(staleOverrides, staleOverrideIdentities, manualOverride);
+                    continue;
+                }
+
+                string action = FieldNormalizer.Normalize(manualOverride.Action);
+                string? status = action switch
+                {
+                    OverrideActions.ForceMatch => MatchStatus.ManualOverrideMatched,
+                    OverrideActions.SuppressBreak => MatchStatus.ManualOverrideSuppressed,
+                    _ => null
+                };
+
+                if (status is null)
+                {
+                    AddStale(staleOverrides, staleOverrideIdentities, manualOverride);
+                    continue;
+                }
+
+                // Suppressed breaks leave an audit trail in matched-trades.csv rather
+                // than disappearing silently.
+                matchedTrades.Add(CreateMatchedTrade(breakRecord, status, manualOverride.Note));
+                breakQueue.Remove(breakRecord);
+            }
+
+            // Instructions that never targeted a break are surfaced as stale too.
+            foreach (ManualOverrideRecord manualOverride in allOverrides)
+            {
+                if (!targetedTrades.Contains(FieldNormalizer.Normalize(manualOverride.TradeId)) &&
+                    !staleOverrideIdentities.Contains(manualOverride))
+                {
+                    AddStale(staleOverrides, staleOverrideIdentities, manualOverride);
+                }
+            }
+        }
+
+        private static void AddStale(
+            List<ManualOverrideRecord> staleOverrides,
+            HashSet<ManualOverrideRecord> staleOverrideIdentities,
+            ManualOverrideRecord manualOverride)
+        {
+            staleOverrides.Add(manualOverride);
+            staleOverrideIdentities.Add(manualOverride);
+        }
+
+        private static string FormatReasons(IEnumerable<string> reasons)
+        {
+            return string.Join("|", reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal));
+        }
+
+        private PositionRecord? FindPosition(TradeRecord trade, List<PositionRecord> candidates, HashSet<string> usedPositions, ICollection<string> reasons)
+        {
+            List<PositionRecord> available = candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+            if (available.Count == 0)
+            {
+                reasons.Add(BreakReasons.MissingPosition);
+                return null;
+            }
+
+            List<PositionRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+            if (sameDate.Count == 0)
+            {
+                reasons.Add(BreakReasons.PositionSettlementDateMismatch);
+                return null;
+            }
+
+            List<PositionRecord> sameCurrency = sameDate
+                .Where(candidate => FieldNormalizer.Normalize(candidate.Currency) == FieldNormalizer.Normalize(trade.Currency))
+                .ToList();
+            if (sameCurrency.Count == 0)
+            {
+                reasons.Add(BreakReasons.PositionCurrencyMismatch);
+                return null;
+            }
+
+            PositionRecord candidatePosition = sameCurrency
+                .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+                .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+                .First();
+
+            if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+            {
+                reasons.Add(BreakReasons.PositionQuantitySignMismatch);
+                return null;
+            }
+
+            if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _tolerances.PositionQuantity)
+            {
+                reasons.Add(BreakReasons.PositionQuantityOutOfTolerance);
+                return null;
+            }
+
+            return candidatePosition;
+        }
+
+        private SettlementRecord? FindSettlement(TradeRecord trade, List<SettlementRecord> candidates, HashSet<string> usedSettlements, ICollection<string> reasons)
+        {
+            List<SettlementRecord> available = candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+            if (available.Count == 0)
+            {
+                reasons.Add(BreakReasons.MissingSettlement);
+                return null;
+            }
+
+            List<SettlementRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+            if (sameDate.Count == 0)
+            {
+                reasons.Add(BreakReasons.SettlementDateMismatch);
+                return null;
+            }
+
+            List<SettlementRecord> sameCurrency = sameDate
+                .Where(candidate => FieldNormalizer.Normalize(candidate.Currency) == FieldNormalizer.Normalize(trade.Currency))
+                .ToList();
+            if (sameCurrency.Count == 0)
+            {
+                reasons.Add(BreakReasons.SettlementCurrencyMismatch);
+                return null;
+            }
+
+            SettlementRecord candidateSettlement = sameCurrency
+                .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+                .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+                .First();
+
+            if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+            {
+                reasons.Add(BreakReasons.SettlementQuantitySignMismatch);
+                return null;
+            }
+
+            if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _tolerances.SettlementQuantity)
+            {
+                reasons.Add(BreakReasons.SettlementQuantityOutOfTolerance);
+                return null;
+            }
+
+            if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _tolerances.SettlementAmount)
+            {
+                reasons.Add(BreakReasons.SettlementAmountOutOfTolerance);
+                return null;
+            }
+
+            return candidateSettlement;
+        }
+
+        private static string? GetNearestPositionId(TradeRecord trade, IEnumerable<PositionRecord>? candidates)
+        {
+            return candidates?
+                .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+                .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+                .Select(candidate => candidate.PositionId)
+                .FirstOrDefault();
+        }
+
+        private static string? GetNearestSettlementId(TradeRecord trade, IEnumerable<SettlementRecord>? candidates)
+        {
+            return candidates?
+                .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+                .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+                .Select(candidate => candidate.SettlementId)
+                .FirstOrDefault();
+        }
+
+        private static BreakRecord CreateBreak(TradeRecord trade, string reasons, string? positionId, string? settlementId, bool canManualOverride)
+        {
+            return new BreakRecord
+            {
+                TradeId = FieldNormalizer.Normalize(trade.TradeId),
+                Account = FieldNormalizer.Normalize(trade.Account),
+                Instrument = FieldNormalizer.Normalize(trade.Instrument),
+                Quantity = trade.Quantity,
+                SettlementDate = trade.SettlementDate,
+                Currency = FieldNormalizer.Normalize(trade.Currency),
+                Reasons = reasons,
+                PositionId = positionId,
+                SettlementId = settlementId,
+                CanManualOverride = canManualOverride
+            };
+        }
+
+        private static MatchedTradeRecord CreateMatchedTrade(TradeRecord trade, string status, string? positionId, string? settlementId, string? overrideNote)
+        {
+            return new MatchedTradeRecord
+            {
+                TradeId = FieldNormalizer.Normalize(trade.TradeId),
+                Status = status,
+                Account = FieldNormalizer.Normalize(trade.Account),
+                Instrument = FieldNormalizer.Normalize(trade.Instrument),
+                Quantity = trade.Quantity,
+                SettlementDate = trade.SettlementDate,
+                Currency = FieldNormalizer.Normalize(trade.Currency),
+                PositionId = positionId,
+                SettlementId = settlementId,
+                OverrideNote = overrideNote
+            };
+        }
+
+        private static MatchedTradeRecord CreateMatchedTrade(BreakRecord breakRecord, string status, string? overrideNote)
+        {
+            // Break records already carry normalized values.
+            return new MatchedTradeRecord
+            {
+                TradeId = FieldNormalizer.Normalize(breakRecord.TradeId),
+                Status = status,
+                Account = FieldNormalizer.Normalize(breakRecord.Account),
+                Instrument = FieldNormalizer.Normalize(breakRecord.Instrument),
+                Quantity = breakRecord.Quantity,
+                SettlementDate = breakRecord.SettlementDate,
+                Currency = FieldNormalizer.Normalize(breakRecord.Currency),
+                PositionId = breakRecord.PositionId,
+                SettlementId = breakRecord.SettlementId,
+                OverrideNote = overrideNote
+            };
+        }
+    }
+}
diff --git a/src/LegacyTradeReconciliation.Core/ReconciliationBatch.cs b/src/LegacyTradeReconciliation.Core/ReconciliationBatch.cs
new file mode 100644
index 0000000..c875e85
--- /dev/null
+++ b/src/LegacyTradeReconciliation.Core/ReconciliationBatch.cs
@@ -0,0 +1,137 @@
+using System;
+using System.Globalization;
+using System.IO;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Csv;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Ledger;
+using LegacyTradeReconciliation.Matching;
+using LegacyTradeReconciliation.Reporting;
+
+namespace LegacyTradeReconciliation
+{
+    /// <summary>
+    /// Orchestrates one reconciliation run: idempotency check, reconcile, publish,
+    /// then record the run in the ledger.
+    /// </summary>
+    public sealed class ReconciliationBatch
+    {
+        private readonly IReconciliationInputReader _inputReader;
+        private readonly IMatchingEngine _matchingEngine;
+        private readonly IEndOfDayReportBuilder _reporter;
+        private readonly IReconciliationOutputWriter _outputWriter;
+        private readonly IRunLedgerStore _ledgerStore;
+        private readonly IInputSignatureCalculator _signatureCalculator;
+        private readonly IBatchLog _log;
+
+        /// <summary>
+        /// Builds a batch wired with the production file-system collaborators.
+        /// </summary>
+        public static ReconciliationBatch CreateDefault(IBatchLog? log = null)
+        {
+            return new ReconciliationBatch(
+                new CsvInputReader(),
+                new MatchingEngine(),
+                new EndOfDayReporter(),
+                new CsvOutputWriter(),
+                new CsvRunLedgerStore(),
+                new Sha256InputSignatureCalculator(),
+                log ?? NullBatchLog.Instance);
+        }
+
+        public ReconciliationBatch(
+            IReconciliationInputReader inputReader,
+            IMatchingEngine matchingEngine,
+            IEndOfDayReportBuilder reporter,
+            IReconciliationOutputWriter outputWriter,
+            IRunLedgerStore ledgerStore,
+            IInputSignatureCalculator signatureCalculator,
+            IBatchLog log)
+        {
+            ArgumentNullException.ThrowIfNull(inputReader);
+            ArgumentNullException.ThrowIfNull(matchingEngine);
+            ArgumentNullException.ThrowIfNull(reporter);
+            ArgumentNullException.ThrowIfNull(outputWriter);
+            ArgumentNullException.ThrowIfNull(ledgerStore);
+            ArgumentNullException.ThrowIfNull(signatureCalculator);
+            ArgumentNullException.ThrowIfNull(log);
+
+            _inputReader = inputReader;
+            _matchingEngine = matchingEngine;
+            _reporter = reporter;
+            _outputWriter = outputWriter;
+            _ledgerStore = ledgerStore;
+            _signatureCalculator = signatureCalculator;
+            _log = log;
+        }
+
+        public BatchRunOutcome Run(RunRequest request)
+        {
+            ArgumentNullException.ThrowIfNull(request);
+
+            Directory.CreateDirectory(request.OutputDirectory);
+
+            string inputSignature = _signatureCalculator.Calculate(request.BusinessDate, request.InputDirectory);
+
+            // An exact rerun for the same business date must not republish or duplicate
+            // anything, including ledger entries.
+            if (_ledgerStore.Contains(request.OutputDirectory, request.BusinessDate, inputSignature) &&
+                _outputWriter.OutputsExist(request.OutputDirectory))
+            {
+                _log.Info("Exact rerun detected for " + request.FormattedBusinessDate + ". Existing outputs were retained.");
+                return BatchRunOutcome.Rerun(inputSignature);
+            }
+
+            ReconciliationInputSet inputs = _inputReader.Read(request.InputDirectory);
+            ReconciliationResult result = _matchingEngine.Reconcile(inputs);
+
+            _outputWriter.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+            _outputWriter.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+            _outputWriter.WriteEndOfDayReport(request.OutputDirectory, _reporter.BuildReport(request.BusinessDate, result));
+
+            _ledgerStore.AppendIfMissing(request.OutputDirectory, new RunLedgerEntry
+            {
+                BusinessDate = request.BusinessDate,
+                InputSignature = inputSignature,
+                TotalTradesRead = result.TotalTradesRead,
+                OpenBreakCount = result.OpenBreaks.Count,
+                MatchedCount = result.MatchedTrades.Count
+            });
+
+            _log.Info(string.Format(
+                CultureInfo.InvariantCulture,
+                "Processed {0} trades into {1} matched rows and {2} open breaks.",
+                result.TotalTradesRead,
+                result.MatchedTrades.Count,
+                result.OpenBreaks.Count));
+
+            return BatchRunOutcome.Published(inputSignature, result);
+        }
+    }
+
+    /// <summary>
+    /// What a run did, so callers and tests can assert on it without re-reading files.
+    /// </summary>
+    public sealed class BatchRunOutcome
+    {
+        private BatchRunOutcome(bool wasRerun, string inputSignature, ReconciliationResult? result)
+        {
+            WasRerun = wasRerun;
+            InputSignature = inputSignature;
+            Result = result;
+        }
+
+        /// <summary>True when the run was recognised as an exact rerun and skipped.</summary>
+        public bool WasRerun { get; }
+
+        public string InputSignature { get; }
+
+        /// <summary>The reconciliation result, or <c>null</c> for a skipped rerun.</summary>
+        public ReconciliationResult? Result { get; }
+
+        internal static BatchRunOutcome Rerun(string inputSignature) => new BatchRunOutcome(true, inputSignature, null);
+
+        internal static BatchRunOutcome Published(string inputSignature, ReconciliationResult result) => new BatchRunOutcome(false, inputSignature, result);
+    }
+}
