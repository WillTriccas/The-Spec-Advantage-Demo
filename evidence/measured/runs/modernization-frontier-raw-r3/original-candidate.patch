+using System;
+using System.Collections.Generic;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Reporting;
+using Xunit;
+
+namespace LegacyTradeReconciliation.Tests
+{
+    public sealed class EndOfDayReporterTests
+    {
+        private static readonly DateTime BusinessDate = new(2025, 3, 17);
+        private readonly EndOfDayReporter _reporter = new();
+
+        [Fact]
+        public void A_clean_day_reports_no_break_reasons()
+        {
+            string report = _reporter.BuildReport(BusinessDate, Result());
+
+            Assert.Contains("Business Date: 2025-03-17", report, StringComparison.Ordinal);
+            Assert.Contains("Open Break Reasons" + Environment.NewLine + "------------------" + Environment.NewLine + "None", report, StringComparison.Ordinal);
+            Assert.DoesNotContain("Stale Overrides" + Environment.NewLine + "---------------", report, StringComparison.Ordinal);
+        }
+
+        [Fact]
+        public void Break_reasons_are_counted_per_component_and_sorted()
+        {
+            string report = _reporter.BuildReport(BusinessDate, Result(openBreaks: new[]
+            {
+                Break("T-2", "SettlementDateMismatch|MissingPosition"),
+                Break("T-1", "MissingPosition")
+            }));
+
+            int missingPosition = report.IndexOf("MissingPosition: 2", StringComparison.Ordinal);
+            int settlementDateMismatch = report.IndexOf("SettlementDateMismatch: 1", StringComparison.Ordinal);
+
+            Assert.True(missingPosition >= 0);
+            Assert.True(settlementDateMismatch > missingPosition);
+        }
+
+        [Fact]
+        public void Stale_overrides_are_listed_for_audit()
+        {
+            string report = _reporter.BuildReport(BusinessDate, Result(staleOverrides: new[]
+            {
+                new ManualOverrideRecord { TradeId = "T-9", Action = "ForceMatch", Note = "n", ApprovedBy = "ops-manager" },
+                new ManualOverrideRecord { TradeId = "T-1", Action = "SuppressBreak", Note = "n", ApprovedBy = "ops-supervisor" }
+            }));
+
+            Assert.Contains("Stale Overrides: 2", report, StringComparison.Ordinal);
+            int first = report.IndexOf("T-1: SuppressBreak (ops-supervisor)", StringComparison.Ordinal);
+            int second = report.IndexOf("T-9: ForceMatch (ops-manager)", StringComparison.Ordinal);
+            Assert.True(first >= 0);
+            Assert.True(second > first);
+        }
+
+        [Fact]
+        public void The_report_ends_with_exactly_one_newline()
+        {
+            string report = _reporter.BuildReport(BusinessDate, Result());
+
+            Assert.EndsWith("None" + Environment.NewLine, report, StringComparison.Ordinal);
+        }
+
+        private static ReconciliationResult Result(
+            IReadOnlyList<BreakRecord>? openBreaks = null,
+            IReadOnlyList<ManualOverrideRecord>? staleOverrides = null)
+        {
+            return new ReconciliationResult
+            {
+                MatchedTrades = Array.Empty<MatchedTradeRecord>(),
+                OpenBreaks = openBreaks ?? Array.Empty<BreakRecord>(),
+                StaleOverrides = staleOverrides ?? Array.Empty<ManualOverrideRecord>(),
+                TotalTradesRead = 0,
+                CanonicalTradeCount = 0,
+                DuplicateTradeCount = 0,
+                MatchedCount = 0,
+                ManualOverrideMatchedCount = 0,
+                ManualOverrideSuppressedCount = 0
+            };
+        }
+
+        private static BreakRecord Break(string tradeId, string reasons) => new()
+        {
+            TradeId = tradeId,
+            Account = "ACC-001",
+            Instrument = "IBM.N",
+            Quantity = 100m,
+            SettlementDate = BusinessDate,
+            Currency = "USD",
+            Reasons = reasons,
+            CanManualOverride = false
+        };
+    }
+}
