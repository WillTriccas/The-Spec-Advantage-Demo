+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Envelope returned on stdout by every audit workflow command. It is deliberately free of
+/// account identifiers and trade amounts: only redacted narrative, digests and identities
+/// appear.
+/// </summary>
+public sealed class AuditCommandResponse
+{
+    [JsonPropertyName("schemaVersion")]
+    public string SchemaVersion { get; set; } = AuditContract.SchemaVersion;
+
+    /// <summary>The command that produced this response.</summary>
+    [JsonPropertyName("command")]
+    public string Command { get; set; } = string.Empty;
+
+    /// <summary>True when the command achieved (or replayed) its intended durable outcome.</summary>
+    [JsonPropertyName("ok")]
+    public bool Ok { get; set; }
+
+    /// <summary><c>Succeeded</c> or <c>Failed</c>.</summary>
+    [JsonPropertyName("status")]
+    public string Status { get; set; } = string.Empty;
+
+    /// <summary>Stable failure code from <see cref="AuditErrorCodes"/>, otherwise null.</summary>
+    [JsonPropertyName("errorCode")]
+    public string? ErrorCode { get; set; }
+
+    /// <summary>Operator-safe explanation.</summary>
+    [JsonPropertyName("message")]
+    public string Message { get; set; } = string.Empty;
+
+    /// <summary>True when a retry replayed an already-durable outcome without appending.</summary>
+    [JsonPropertyName("idempotent")]
+    public bool Idempotent { get; set; }
+
+    [JsonPropertyName("requestId")]
+    public string? RequestId { get; set; }
+
+    /// <summary>True when the command was refused because a proposer tried to decide their own request.</summary>
+    [JsonPropertyName("selfApprovalPrevented")]
+    public bool SelfApprovalPrevented { get; set; }
+
+    /// <summary>Absolute path of the audit state directory.</summary>
+    [JsonPropertyName("stateDirectory")]
+    public string? StateDirectory { get; set; }
+
+    /// <summary>Number of durable entries in the whole history.</summary>
+    [JsonPropertyName("entryCount")]
+    public int? EntryCount { get; set; }
+
+    /// <summary>Whole-of-ledger tamper-evidence fingerprint.</summary>
+    [JsonPropertyName("ledgerHash")]
+    public string? LedgerHash { get; set; }
+
+    /// <summary>The entry this command created or replayed.</summary>
+    [JsonPropertyName("entry")]
+    public AuditEntryDocument? Entry { get; set; }
+
+    /// <summary>The proposal entry for the request, when known.</summary>
+    [JsonPropertyName("proposal")]
+    public AuditEntryDocument? Proposal { get; set; }
+
+    /// <summary>The one durable final decision for the request, when one exists.</summary>
+    [JsonPropertyName("finalDecision")]
+    public AuditEntryDocument? FinalDecision { get; set; }
+}
