+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// The Compliance export: an append-only slice of the audit history for a business-date range.
+/// </summary>
+public sealed class AuditExportDocument
+{
+    [JsonPropertyName("schemaVersion")]
+    public string SchemaVersion { get; set; } = AuditContract.SchemaVersion;
+
+    [JsonPropertyName("generatedAt")]
+    public string GeneratedAt { get; set; } = string.Empty;
+
+    [JsonPropertyName("fromDate")]
+    public string FromDate { get; set; } = string.Empty;
+
+    [JsonPropertyName("toDate")]
+    public string ToDate { get; set; } = string.Empty;
+
+    [JsonPropertyName("entryCount")]
+    public int EntryCount { get; set; }
+
+    [JsonPropertyName("requestCount")]
+    public int RequestCount { get; set; }
+
+    /// <summary>True when the whole persisted hash chain verified at export time.</summary>
+    [JsonPropertyName("chainVerified")]
+    public bool ChainVerified { get; set; }
+
+    /// <summary>Hash of the head of the chain: a fingerprint of the entire history.</summary>
+    [JsonPropertyName("ledgerHash")]
+    public string LedgerHash { get; set; } = string.Empty;
+
+    /// <summary>Declares that identifiers and amounts are redacted from all narrative fields.</summary>
+    [JsonPropertyName("redaction")]
+    public AuditRedactionNotice Redaction { get; set; } = new();
+
+    /// <summary>The append-only history entries, in durable sequence order.</summary>
+    [JsonPropertyName("entries")]
+    public IReadOnlyList<AuditEntryDocument> Entries { get; set; } = [];
+
+    /// <summary>Per-request rollup over <see cref="Entries"/>.</summary>
+    [JsonPropertyName("requests")]
+    public IReadOnlyList<AuditRequestSummary> Requests { get; set; } = [];
+}
+
+/// <summary>Describes the redaction guarantee applied to every exported narrative field.</summary>
+public sealed class AuditRedactionNotice
+{
+    [JsonPropertyName("applied")]
+    public bool Applied { get; set; } = true;
+
+    [JsonPropertyName("policy")]
+    public string Policy { get; set; } =
+        "Account, instrument and record identifiers and all monetary or quantity amounts are "
+        + "replaced with placeholders before persistence; only digests of the original text are kept.";
+
+    [JsonPropertyName("identifierPlaceholder")]
+    public string IdentifierPlaceholder { get; set; } = Domain.Audit.SensitiveTextRedactor.IdentifierPlaceholder;
+
+    [JsonPropertyName("amountPlaceholder")]
+    public string AmountPlaceholder { get; set; } = Domain.Audit.SensitiveTextRedactor.AmountPlaceholder;
+}
diff --git a/src/TradeRecon.Application/Audit/AuditRequestSummary.cs b/src/TradeRecon.Application/Audit/AuditRequestSummary.cs
