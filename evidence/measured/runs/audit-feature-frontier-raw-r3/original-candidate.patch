@@ -0,0 +1,56 @@
+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Per-request rollup included in the export so a reviewer can see, without replaying the
+/// entries themselves, that a decided request has exactly one final decision and that the
+/// checker is a different person from the proposer.
+/// </summary>
+public sealed class AuditRequestSummary
+{
+    [JsonPropertyName("requestId")]
+    public string RequestId { get; set; } = string.Empty;
+
+    [JsonPropertyName("businessDate")]
+    public string BusinessDate { get; set; } = string.Empty;
+
+    /// <summary>Current lifecycle state: <c>Pending</c>, <c>Approved</c> or <c>Rejected</c>.</summary>
+    [JsonPropertyName("status")]
+    public string Status { get; set; } = string.Empty;
+
+    [JsonPropertyName("proposer")]
+    public string Proposer { get; set; } = string.Empty;
+
+    /// <summary>Deciding checker, when the request has been decided.</summary>
+    [JsonPropertyName("checker")]
+    public string? Checker { get; set; }
+
+    /// <summary>Alias of <see cref="Checker"/>.</summary>
+    [JsonPropertyName("approver")]
+    public string? Approver { get; set; }
+
+    /// <summary>Terminal action, when decided.</summary>
+    [JsonPropertyName("finalDecision")]
+    public string? FinalDecision { get; set; }
+
+    /// <summary>Ledger sequence of the single durable final decision.</summary>
+    [JsonPropertyName("finalDecisionSequence")]
+    public long? FinalDecisionSequence { get; set; }
+
+    /// <summary>Number of durable decision entries. Never exceeds one.</summary>
+    [JsonPropertyName("decisionCount")]
+    public int DecisionCount { get; set; }
+
+    /// <summary>Total durable entries recorded for the request.</summary>
+    [JsonPropertyName("entryCount")]
+    public int EntryCount { get; set; }
+
+    /// <summary>True when the request is decided by a checker distinct from its proposer.</summary>
+    [JsonPropertyName("checkerDistinctFromProposer")]
+    public bool CheckerDistinctFromProposer { get; set; }
+
+    /// <summary>True when the maker-checker invariant holds for this request.</summary>
+    [JsonPropertyName("segregationOfDutiesSatisfied")]
+    public bool SegregationOfDutiesSatisfied { get; set; }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditWorkflowContracts.cs b/src/TradeRecon.Application/Audit/AuditWorkflowContracts.cs
new file mode 100644
index 0000000..2de1aec
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditWorkflowContracts.cs
@@ -0,0 +1,114 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>Request to propose a resolution for a reconciliation break.</summary>
+public sealed record ProposeResolutionCommand
+{
+    /// <summary>Caller-supplied idempotency key that identifies the resolution request.</summary>
+    public required string RequestId { get; init; }
+
+    /// <summary>Identity of the analyst (maker) raising the proposal.</summary>
+    public required string Proposer { get; init; }
+
+    /// <summary>Business date of the reconciliation break.</summary>
+    public required DateOnly BusinessDate { get; init; }
+
+    /// <summary>Why the break should be resolved. Redacted before persistence.</summary>
+    public required string Reason { get; init; }
+
+    /// <summary>Supporting evidence for the proposal. Redacted before persistence.</summary>
+    public required string Evidence { get; init; }
+
+    /// <summary>Optional reconciliation break key; only its digest is ever stored.</summary>
+    public string? BreakKey { get; init; }
+}
+
+/// <summary>Request for a checker to approve or reject a proposed resolution.</summary>
+public sealed record RecordDecisionCommand
+{
+    public required string RequestId { get; init; }
+
+    /// <summary>Identity of the checker deciding the request.</summary>
+    public required string Approver { get; init; }
+
+    public required ResolutionDecision Decision { get; init; }
+}
+
+/// <summary>Request for the Compliance history export over an inclusive date range.</summary>
+public sealed record ExportHistoryQuery
+{
+    public required DateOnly FromDate { get; init; }
+
+    public required DateOnly ToDate { get; init; }
+}
+
+/// <summary>Outcome of a propose or decide operation.</summary>
+public sealed record AuditOperationResult
+{
+    public required bool Ok { get; init; }
+
+    /// <summary>Stable failure code from <see cref="AuditErrorCodes"/>, when not successful.</summary>
+    public string? ErrorCode { get; init; }
+
+    /// <summary>Operator-safe message. Never contains identifiers or amounts.</summary>
+    public string? Message { get; init; }
+
+    /// <summary>True when the call replayed an already-durable outcome rather than appending.</summary>
+    public bool Idempotent { get; init; }
+
+    /// <summary>The entry created or replayed by this call.</summary>
+    public AuditLedgerEntry? Entry { get; init; }
+
+    /// <summary>The proposal entry for the request, when known.</summary>
+    public AuditLedgerEntry? Proposal { get; init; }
+
+    /// <summary>The single durable final decision for the request, when one exists.</summary>
+    public AuditLedgerEntry? FinalDecision { get; init; }
+
+    public static AuditOperationResult Success(
+        AuditLedgerEntry entry,
+        bool idempotent,
+        AuditLedgerEntry? proposal = null,
+        AuditLedgerEntry? finalDecision = null)
+        => new()
+        {
+            Ok = true,
+            Idempotent = idempotent,
+            Entry = entry,
+            Proposal = proposal,
+            FinalDecision = finalDecision
+        };
+
+    public static AuditOperationResult Failure(
+        string errorCode,
+        string message,
+        AuditLedgerEntry? proposal = null,
+        AuditLedgerEntry? finalDecision = null)
+        => new()
+        {
+            Ok = false,
+            ErrorCode = errorCode,
+            Message = message,
+            Proposal = proposal,
+            FinalDecision = finalDecision
+        };
+}
+
+/// <summary>Outcome of a history export.</summary>
+public sealed record AuditExportResult
+{
+    public required bool Ok { get; init; }
+
+    public string? ErrorCode { get; init; }
+
+    public string? Message { get; init; }
+
+    public AuditExportDocument? Document { get; init; }
+
+    public static AuditExportResult Success(AuditExportDocument document)
+        => new() { Ok = true, Document = document };
+
+    public static AuditExportResult Failure(string errorCode, string message)
+        => new() { Ok = false, ErrorCode = errorCode, Message = message };
+}
diff --git a/src/TradeRecon.Application/Audit/IAuditLedger.cs b/src/TradeRecon.Application/Audit/IAuditLedger.cs
new file mode 100644
index 0000000..251c9c7
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/IAuditLedger.cs
@@ -0,0 +1,53 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// The business content of a ledger entry before the store assigns its position and seals it.
+/// </summary>
+public sealed record AuditEntryDraft
+{
+    public required int Version { get; init; }
+    public required string RequestId { get; init; }
+    public required AuditAction Action { get; init; }
+    public required string Actor { get; init; }
+    public required ActorRole ActorRole { get; init; }
+    public required string Proposer { get; init; }
+    public string? Approver { get; init; }
+    public required DateOnly BusinessDate { get; init; }
+    public required DateTimeOffset Timestamp { get; init; }
+    public required string Reason { get; init; }
+    public required string ReasonDigest { get; init; }
+    public required string Evidence { get; init; }
+    public required string EvidenceDigest { get; init; }
+    public string? BreakReference { get; init; }
+}
+
+/// <summary>
+/// Append-only store for the resolution audit history.
+/// </summary>
+public interface IAuditLedger
+{
+    /// <summary>Prepares the store so that subsequent operations can run.</summary>
+    Task InitializeAsync(CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Takes exclusive ownership of the ledger and materialises its current contents. All
+    /// read-decide-append sequences run inside one transaction, which is what guarantees that
+    /// concurrent decisions collapse to exactly one durable outcome.
+    /// </summary>
+    Task<IAuditLedgerTransaction> BeginAsync(CancellationToken cancellationToken = default);
+}
+
+/// <summary>An exclusive unit of work over the audit ledger.</summary>
+public interface IAuditLedgerTransaction : IAsyncDisposable
+{
+    /// <summary>Every entry durably present when the transaction started, in sequence order.</summary>
+    IReadOnlyList<AuditLedgerEntry> Entries { get; }
+
+    /// <summary>False when the persisted hash chain failed verification.</summary>
+    bool ChainVerified { get; }
+
+    /// <summary>Seals <paramref name="draft"/> onto the end of the chain and flushes it.</summary>
+    Task<AuditLedgerEntry> AppendAsync(AuditEntryDraft draft, CancellationToken cancellationToken = default);
+}
diff --git a/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs b/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs
new file mode 100644
index 0000000..916781b
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs
@@ -0,0 +1,308 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Maker-checker workflow for explainable reconciliation-break resolution.
+/// </summary>
+/// <remarks>
+/// Guarantees, all enforced inside one exclusive ledger transaction per call:
+/// <list type="bullet">
+/// <item>a proposal is durable exactly once per request id (retries replay it);</item>
+/// <item>a request is never decided by its own proposer;</item>
+/// <item>a decided request keeps exactly one durable final decision, so concurrent or
+/// conflicting decisions cannot both win;</item>
+/// <item>nothing sensitive is persisted: narrative is redacted and only digests of the
+/// original reason, evidence and break key are retained.</item>
+/// </list>
+/// </remarks>
+public sealed class ResolutionWorkflowService
+{
+    private readonly IAuditLedger _ledger;
+    private readonly TimeProvider _timeProvider;
+
+    public ResolutionWorkflowService(IAuditLedger ledger, TimeProvider timeProvider)
+    {
+        _ledger = ledger ?? throw new ArgumentNullException(nameof(ledger));
+        _timeProvider = timeProvider ?? throw new ArgumentNullException(nameof(timeProvider));
+    }
+
+    /// <summary>Creates the durable state so later commands have somewhere to append.</summary>
+    public Task InitializeAsync(CancellationToken cancellationToken = default)
+        => _ledger.InitializeAsync(cancellationToken);
+
+    /// <summary>Records an analyst's proposed resolution. Idempotent on the request id.</summary>
+    public async Task<AuditOperationResult> ProposeAsync(
+        ProposeResolutionCommand command,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        if (!AuditIdentity.IsValidRequestId(command.RequestId))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.InvalidRequestId,
+                "The request identifier is missing or not in a recognised format.");
+        }
+
+        if (!AuditIdentity.IsValidActor(command.Proposer))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.InvalidIdentity,
+                "The proposer identity is missing or not in a recognised format.");
+        }
+
+        if (string.IsNullOrWhiteSpace(command.Reason))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.ReasonRequired,
+                "A resolution proposal must carry a reason.");
+        }
+
+        if (string.IsNullOrWhiteSpace(command.Evidence))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.EvidenceRequired,
+                "A resolution proposal must carry supporting evidence.");
+        }
+
+        var requestId = AuditIdentity.Normalize(command.RequestId);
+        var proposer = AuditIdentity.Normalize(command.Proposer);
+        var reasonDigest = AuditHash.Compute(command.Reason.Trim());
+        var evidenceDigest = AuditHash.Compute(command.Evidence.Trim());
+        var breakReference = string.IsNullOrWhiteSpace(command.BreakKey)
+            ? null
+            : AuditHash.Compute(command.BreakKey.Trim());
+
+        await using var transaction = await _ledger.BeginAsync(cancellationToken).ConfigureAwait(false);
+
+        if (!transaction.ChainVerified)
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.LedgerIntegrityViolation,
+                "The audit history failed hash-chain verification; no entry was appended.");
+        }
+
+        var existing = EntriesFor(transaction.Entries, requestId);
+        var existingProposal = existing.FirstOrDefault(entry => entry.Action == AuditAction.Proposed);
+
+        if (existingProposal is not null)
+        {
+            var sameProposal =
+                AuditIdentity.AreSameParty(existingProposal.Proposer, proposer)
+                && existingProposal.BusinessDate == command.BusinessDate
+                && string.Equals(existingProposal.ReasonDigest, reasonDigest, StringComparison.Ordinal)
+                && string.Equals(existingProposal.EvidenceDigest, evidenceDigest, StringComparison.Ordinal)
+                && string.Equals(existingProposal.BreakReference, breakReference, StringComparison.Ordinal);
+
+            return sameProposal
+                ? AuditOperationResult.Success(
+                    existingProposal,
+                    idempotent: true,
+                    proposal: existingProposal,
+                    finalDecision: FinalDecision(existing))
+                : AuditOperationResult.Failure(
+                    AuditErrorCodes.RequestConflict,
+                    "The request identifier is already in use for a materially different proposal.",
+                    proposal: existingProposal,
+                    finalDecision: FinalDecision(existing));
+        }
+
+        var draft = new AuditEntryDraft
+        {
+            Version = 1,
+            RequestId = requestId,
+            Action = AuditAction.Proposed,
+            Actor = proposer,
+            ActorRole = ActorRole.Proposer,
+            Proposer = proposer,
+            Approver = null,
+            BusinessDate = command.BusinessDate,
+            Timestamp = _timeProvider.GetUtcNow(),
+            Reason = SensitiveTextRedactor.Redact(command.Reason),
+            ReasonDigest = reasonDigest,
+            Evidence = SensitiveTextRedactor.Redact(command.Evidence),
+            EvidenceDigest = evidenceDigest,
+            BreakReference = breakReference
+        };
+
+        var appended = await transaction.AppendAsync(draft, cancellationToken).ConfigureAwait(false);
+        return AuditOperationResult.Success(appended, idempotent: false, proposal: appended);
+    }
+
+    /// <summary>
+    /// Records a checker's decision. Self-approval is refused, a repeat of the same decision by
+    /// the same checker replays the durable outcome, and any conflicting decision loses to the
+    /// one already committed.
+    /// </summary>
+    public async Task<AuditOperationResult> DecideAsync(
+        RecordDecisionCommand command,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        if (!AuditIdentity.IsValidRequestId(command.RequestId))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.InvalidRequestId,
+                "The request identifier is missing or not in a recognised format.");
+        }
+
+        if (!AuditIdentity.IsValidActor(command.Approver))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.InvalidIdentity,
+                "The approver identity is missing or not in a recognised format.");
+        }
+
+        var requestId = AuditIdentity.Normalize(command.RequestId);
+        var approver = AuditIdentity.Normalize(command.Approver);
+
+        await using var transaction = await _ledger.BeginAsync(cancellationToken).ConfigureAwait(false);
+
+        if (!transaction.ChainVerified)
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.LedgerIntegrityViolation,
+                "The audit history failed hash-chain verification; no decision was appended.");
+        }
+
+        var existing = EntriesFor(transaction.Entries, requestId);
+        var proposal = existing.FirstOrDefault(entry => entry.Action == AuditAction.Proposed);
+
+        if (proposal is null)
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.UnknownRequest,
+                "No proposed resolution exists for that request identifier.");
+        }
+
+        if (AuditIdentity.AreSameParty(proposal.Proposer, approver))
+        {
+            return AuditOperationResult.Failure(
+                AuditErrorCodes.SelfApprovalNotPermitted,
+                "Segregation of duties: the proposer of a resolution may not decide it.",
+                proposal: proposal,
+                finalDecision: FinalDecision(existing));
+        }
+
+        var decided = FinalDecision(existing);
+        if (decided is not null)
+        {
+            var isReplay =
+                AuditIdentity.AreSameParty(decided.Actor, approver)
+                && decided.Action == ToAction(command.Decision);
+
+            return isReplay
+                ? AuditOperationResult.Success(decided, idempotent: true, proposal: proposal, finalDecision: decided)
+                : AuditOperationResult.Failure(
+                    AuditErrorCodes.AlreadyDecided,
+                    "The request already has a durable final decision, which stands unchanged.",
+                    proposal: proposal,
+                    finalDecision: decided);
+        }
+
+        var draft = new AuditEntryDraft
+        {
+            Version = existing.Count + 1,
+            RequestId = requestId,
+            Action = ToAction(command.Decision),
+            Actor = approver,
+            ActorRole = ActorRole.Checker,
+            Proposer = proposal.Proposer,
+            Approver = approver,
+            BusinessDate = proposal.BusinessDate,
+            Timestamp = _timeProvider.GetUtcNow(),
+            Reason = proposal.Reason,
+            ReasonDigest = proposal.ReasonDigest,
+            Evidence = proposal.Evidence,
+            EvidenceDigest = proposal.EvidenceDigest,
+            BreakReference = proposal.BreakReference
+        };
+
+        var appended = await transaction.AppendAsync(draft, cancellationToken).ConfigureAwait(false);
+        return AuditOperationResult.Success(appended, idempotent: false, proposal: proposal, finalDecision: appended);
+    }
+
+    /// <summary>Builds the append-only Compliance export for an inclusive business-date range.</summary>
+    public async Task<AuditExportResult> ExportAsync(
+        ExportHistoryQuery query,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(query);
+
+        if (query.FromDate > query.ToDate)
+        {
+            return AuditExportResult.Failure(
+                AuditErrorCodes.InvalidDateRange,
+                "The export start date must not be after the end date.");
+        }
+
+        await using var transaction = await _ledger.BeginAsync(cancellationToken).ConfigureAwait(false);
+
+        var all = transaction.Entries;
+        var selected = all
+            .Where(entry => entry.BusinessDate >= query.FromDate && entry.BusinessDate <= query.ToDate)
+            .OrderBy(entry => entry.Sequence)
+            .ToList();
+
+        var summaries = selected
+            .GroupBy(entry => entry.RequestId, StringComparer.Ordinal)
+            .OrderBy(group => group.Min(entry => entry.Sequence))
+            .Select(BuildSummary)
+            .ToList();
+
+        var document = new AuditExportDocument
+        {
+            GeneratedAt = AuditTimestamp.Format(_timeProvider.GetUtcNow()),
+            FromDate = AuditTimestamp.FormatDate(query.FromDate),
+            ToDate = AuditTimestamp.FormatDate(query.ToDate),
+            EntryCount = selected.Count,
+            RequestCount = summaries.Count,
+            ChainVerified = transaction.ChainVerified,
+            LedgerHash = AuditEntrySealer.HeadHash(all),
+            Entries = selected.Select(AuditContract.ToDocument).ToList(),
+            Requests = summaries
+        };
+
+        return AuditExportResult.Success(document);
+    }
+
+    private static AuditRequestSummary BuildSummary(IGrouping<string, AuditLedgerEntry> group)
+    {
+        var entries = group.OrderBy(entry => entry.Sequence).ToList();
+        var proposal = entries.FirstOrDefault(entry => entry.Action == AuditAction.Proposed);
+        var decisions = entries.Where(entry => entry.IsFinalDecision).ToList();
+        var decision = decisions.FirstOrDefault();
+        var proposer = proposal?.Proposer ?? entries[0].Proposer;
+        var distinct = decision is not null && !AuditIdentity.AreSameParty(decision.Actor, proposer);
+
+        return new AuditRequestSummary
+        {
+            RequestId = group.Key,
+            BusinessDate = AuditTimestamp.FormatDate(entries[0].BusinessDate),
+            Status = decision?.Action.ToString() ?? "Pending",
+            Proposer = proposer,
+            Checker = decision?.Actor,
+            Approver = decision?.Actor,
+            FinalDecision = decision?.Action.ToString(),
+            FinalDecisionSequence = decision?.Sequence,
+            DecisionCount = decisions.Count,
+            EntryCount = entries.Count,
+            CheckerDistinctFromProposer = distinct,
+            SegregationOfDutiesSatisfied = decision is null ? proposal is not null : distinct && decisions.Count == 1
+        };
+    }
+
+    private static List<AuditLedgerEntry> EntriesFor(IReadOnlyList<AuditLedgerEntry> entries, string requestId)
+        => entries
+            .Where(entry => string.Equals(entry.RequestId, requestId, StringComparison.Ordinal))
+            .OrderBy(entry => entry.Sequence)
+            .ToList();
+
+    private static AuditLedgerEntry? FinalDecision(IEnumerable<AuditLedgerEntry> entries)
+        => entries.FirstOrDefault(entry => entry.IsFinalDecision);
+
+    private static AuditAction ToAction(ResolutionDecision decision)
+        => decision == ResolutionDecision.Approved ? AuditAction.Approved : AuditAction.Rejected;
+}
diff --git a/src/TradeRecon.Audit.Console/Program.cs b/src/TradeRecon.Audit.Console/Program.cs
new file mode 100644
index 0000000..ec10d61
--- /dev/null
+++ b/src/TradeRecon.Audit.Console/Program.cs
@@ -0,0 +1,338 @@
+using System.Text.Json;
+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using TradeRecon.Infrastructure.Audit;
+
+namespace TradeRecon.Audit.Console;
+
+/// <summary>
+/// Shell-free command-line host for the explainable resolution workflow and its append-only
+/// audit history. It is the executable side of <c>audit-adapter.json</c>.
+/// </summary>
+/// <remarks>
+/// <para>Verbs:</para>
+/// <list type="bullet">
+/// <item><c>initialize --state &lt;dir&gt;</c></item>
+/// <item><c>propose --state &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;who&gt;
+/// --business-date &lt;yyyy-MM-dd&gt; --reason &lt;text&gt; --evidence &lt;text&gt;
+/// [--break-key &lt;key&gt;]</c></item>
+/// <item><c>decide --state &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;who&gt;
+/// --decision &lt;approve|reject&gt;</c></item>
+/// <item><c>export --state &lt;dir&gt; --from &lt;yyyy-MM-dd&gt; --to &lt;yyyy-MM-dd&gt;
+/// --out &lt;file&gt;</c></item>
+/// </list>
+/// <para>
+/// Every verb writes a single parseable JSON document to stdout and nothing else; diagnostics
+/// go to stderr. Exit codes are <c>0</c> for a durable (or replayed) success, <c>3</c> for a
+/// policy refusal that still produced JSON, and <c>1</c> for a usage or I/O failure.
+/// </para>
+/// </remarks>
+public static class Program
+{
+    /// <summary>The command achieved or replayed its durable outcome.</summary>
+    public const int ExitSuccess = 0;
+
+    /// <summary>Usage or I/O failure.</summary>
+    public const int ExitUsageError = 1;
+
+    /// <summary>The command was refused by a workflow rule; stdout still carries JSON.</summary>
+    public const int ExitRefused = 3;
+
+    public static async Task<int> Main(string[] args)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+
+        if (args.Length == 0 || args.Contains("--help") || args.Contains("-h"))
+        {
+            System.Console.Error.WriteLine(Usage);
+            return args.Length == 0 ? ExitUsageError : ExitSuccess;
+        }
+
+        try
+        {
+            var command = args[0].Trim().ToLowerInvariant();
+            var options = CommandLine.Parse(args.Skip(1));
+
+            return command switch
+            {
+                "initialize" or "init" => await InitializeAsync(options).ConfigureAwait(false),
+                "propose" => await ProposeAsync(options).ConfigureAwait(false),
+                "decide" => await DecideAsync(options).ConfigureAwait(false),
+                "export" => await ExportAsync(options).ConfigureAwait(false),
+                _ => UnknownCommand(command)
+            };
+        }
+        catch (Exception ex) when (ex is ArgumentException or FormatException or IOException
+                                    or UnauthorizedAccessException or TimeoutException)
+        {
+            System.Console.Error.WriteLine($"audit: {ex.Message}");
+            return ExitUsageError;
+        }
+    }
+
+    private const string Usage =
+        "Usage: TradeRecon.Audit.Console <initialize|propose|decide|export> [options]\n"
+        + "  initialize --state <dir>\n"
+        + "  propose    --state <dir> --request-id <id> --proposer <identity> "
+        + "--business-date <yyyy-MM-dd> --reason <text> --evidence <text> [--break-key <key>]\n"
+        + "  decide     --state <dir> --request-id <id> --approver <identity> --decision <approve|reject>\n"
+        + "  export     --state <dir> --from <yyyy-MM-dd> --to <yyyy-MM-dd> --out <file>";
+
+    private static int UnknownCommand(string command)
+    {
+        System.Console.Error.WriteLine($"audit: unrecognised command '{command}'.\n{Usage}");
+        return ExitUsageError;
+    }
+
+    private static ResolutionWorkflowService CreateService(string stateDirectory)
+        => new(new FileAuditLedger(stateDirectory), TimeProvider.System);
+
+    private static async Task<int> InitializeAsync(CommandLine options)
+    {
+        var stateDirectory = options.RequireValue("state", "state-directory", "state-dir");
+        var ledger = new FileAuditLedger(stateDirectory);
+        await ledger.InitializeAsync().ConfigureAwait(false);
+
+        await using var transaction = await ledger.BeginAsync().ConfigureAwait(false);
+
+        return Emit(new AuditCommandResponse
+        {
+            Command = "initialize",
+            Ok = true,
+            Status = "Succeeded",
+            Message = "Audit state directory is ready for maker-checker resolution requests.",
+            StateDirectory = Path.GetFullPath(stateDirectory),
+            EntryCount = transaction.Entries.Count,
+            LedgerHash = AuditEntrySealer.HeadHash(transaction.Entries)
+        });
+    }
+
+    private static async Task<int> ProposeAsync(CommandLine options)
+    {
+        var stateDirectory = options.RequireValue("state", "state-directory", "state-dir");
+        var requestId = options.RequireValue("request-id", "request", "requestid");
+        var proposer = options.RequireValue("proposer", "maker", "analyst");
+        var businessDateText = options.RequireValue("business-date", "date", "businessdate");
+        var reason = options.RequireValue("reason");
+        var evidence = options.RequireValue("evidence");
+        var breakKey = options.Value("break-key", "breakkey", "break");
+
+        if (!AuditTimestamp.TryParseDate(businessDateText, out var businessDate))
+        {
+            return Emit(Refusal(
+                "propose",
+                requestId,
+                AuditErrorCodes.InvalidBusinessDate,
+                "The business date must be an ISO yyyy-MM-dd value."));
+        }
+
+        var service = CreateService(stateDirectory);
+        var result = await service.ProposeAsync(new ProposeResolutionCommand
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = businessDate,
+            Reason = reason,
+            Evidence = evidence,
+            BreakKey = breakKey
+        }).ConfigureAwait(false);
+
+        return Emit(ToResponse("propose", requestId, result, stateDirectory));
+    }
+
+    private static async Task<int> DecideAsync(CommandLine options)
+    {
+        var stateDirectory = options.RequireValue("state", "state-directory", "state-dir");
+        var requestId = options.RequireValue("request-id", "request", "requestid");
+        var approver = options.RequireValue("approver", "checker", "decider");
+        var decisionText = options.RequireValue("decision", "outcome");
+
+        if (!TryParseDecision(decisionText, out var decision))
+        {
+            return Emit(Refusal(
+                "decide",
+                requestId,
+                AuditErrorCodes.InvalidDecision,
+                "The decision must be 'approve' or 'reject'."));
+        }
+
+        var service = CreateService(stateDirectory);
+        var result = await service.DecideAsync(new RecordDecisionCommand
+        {
+            RequestId = requestId,
+            Approver = approver,
+            Decision = decision
+        }).ConfigureAwait(false);
+
+        return Emit(ToResponse("decide", requestId, result, stateDirectory));
+    }
+
+    private static async Task<int> ExportAsync(CommandLine options)
+    {
+        var stateDirectory = options.RequireValue("state", "state-directory", "state-dir");
+        var fromText = options.RequireValue("from", "from-date", "fromdate");
+        var toText = options.RequireValue("to", "to-date", "todate");
+        var exportPath = options.RequireValue("out", "export-path", "output", "exportpath");
+
+        if (!AuditTimestamp.TryParseDate(fromText, out var fromDate)
+            || !AuditTimestamp.TryParseDate(toText, out var toDate))
+        {
+            return Emit(Refusal(
+                "export",
+                requestId: null,
+                AuditErrorCodes.InvalidBusinessDate,
+                "The export range dates must be ISO yyyy-MM-dd values."));
+        }
+
+        var service = CreateService(stateDirectory);
+        var result = await service
+            .ExportAsync(new ExportHistoryQuery { FromDate = fromDate, ToDate = toDate })
+            .ConfigureAwait(false);
+
+        if (!result.Ok || result.Document is null)
+        {
+            return Emit(Refusal(
+                "export",
+                requestId: null,
+                result.ErrorCode ?? AuditErrorCodes.InvalidDateRange,
+                result.Message ?? "The history export was refused."));
+        }
+
+        var json = JsonSerializer.Serialize(result.Document, AuditContract.Readable);
+
+        var directory = Path.GetDirectoryName(Path.GetFullPath(exportPath));
+        if (!string.IsNullOrEmpty(directory))
+        {
+            Directory.CreateDirectory(directory);
+        }
+
+        await File.WriteAllTextAsync(Path.GetFullPath(exportPath), json + "\n").ConfigureAwait(false);
+
+        // stdout carries the export document itself so a caller can parse either source.
+        System.Console.Out.Write(json);
+        System.Console.Out.Write('\n');
+        return ExitSuccess;
+    }
+
+    private static bool TryParseDecision(string text, out ResolutionDecision decision)
+    {
+        switch (text.Trim().ToLowerInvariant())
+        {
+            case "approve":
+            case "approved":
+            case "accept":
+            case "accepted":
+                decision = ResolutionDecision.Approved;
+                return true;
+            case "reject":
+            case "rejected":
+            case "decline":
+            case "declined":
+                decision = ResolutionDecision.Rejected;
+                return true;
+            default:
+                decision = default;
+                return false;
+        }
+    }
+
+    private static AuditCommandResponse Refusal(
+        string command,
+        string? requestId,
+        string errorCode,
+        string message)
+        => new()
+        {
+            Command = command,
+            Ok = false,
+            Status = "Failed",
+            ErrorCode = errorCode,
+            Message = message,
+            RequestId = requestId
+        };
+
+    private static AuditCommandResponse ToResponse(
+        string command,
+        string requestId,
+        AuditOperationResult result,
+        string stateDirectory)
+        => new()
+        {
+            Command = command,
+            Ok = result.Ok,
+            Status = result.Ok ? "Succeeded" : "Failed",
+            ErrorCode = result.ErrorCode,
+            Message = result.Message ?? (result.Idempotent
+                ? "The durable outcome already recorded for this request was replayed unchanged."
+                : "The entry was appended to the audit history."),
+            Idempotent = result.Idempotent,
+            RequestId = requestId,
+            SelfApprovalPrevented =
+                string.Equals(result.ErrorCode, AuditErrorCodes.SelfApprovalNotPermitted, StringComparison.Ordinal),
+            StateDirectory = Path.GetFullPath(stateDirectory),
+            Entry = result.Entry is null ? null : AuditContract.ToDocument(result.Entry),
+            Proposal = result.Proposal is null ? null : AuditContract.ToDocument(result.Proposal),
+            FinalDecision = result.FinalDecision is null ? null : AuditContract.ToDocument(result.FinalDecision)
+        };
+
+    private static int Emit(AuditCommandResponse response)
+    {
+        System.Console.Out.Write(JsonSerializer.Serialize(response, AuditContract.Readable));
+        System.Console.Out.Write('\n');
+        return response.Ok ? ExitSuccess : ExitRefused;
+    }
+
+    /// <summary>Minimal, shell-free <c>--name value</c> option reader.</summary>
+    private sealed class CommandLine
+    {
+        private readonly Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);
+
+        public static CommandLine Parse(IEnumerable<string> args)
+        {
+            var line = new CommandLine();
+            using var enumerator = args.GetEnumerator();
+
+            while (enumerator.MoveNext())
+            {
+                var token = enumerator.Current;
+                if (!token.StartsWith("--", StringComparison.Ordinal))
+                {
+                    throw new ArgumentException($"Unexpected argument '{token}'.");
+                }
+
+                var name = token[2..];
+                var separator = name.IndexOf('=', StringComparison.Ordinal);
+                if (separator >= 0)
+                {
+                    line._values[name[..separator]] = name[(separator + 1)..];
+                    continue;
+                }
+
+                if (!enumerator.MoveNext())
+                {
+                    throw new ArgumentException($"Option --{name} requires a value.");
+                }
+
+                line._values[name] = enumerator.Current;
+            }
+
+            return line;
+        }
+
+        public string? Value(params string[] names)
+        {
+            foreach (var name in names)
+            {
+                if (_values.TryGetValue(name, out var value))
+                {
+                    return value;
+                }
+            }
+
+            return null;
+        }
+
+        public string RequireValue(params string[] names)
+            => Value(names) ?? throw new ArgumentException($"Option --{names[0]} is required.");
+    }
+}
