+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// Lifecycle action recorded against a resolution request in the append-only audit ledger.
+/// </summary>
+public enum AuditAction
+{
+    /// <summary>An analyst (maker) proposed a resolution with a reason and evidence.</summary>
+    Proposed = 0,
+
+    /// <summary>A checker approved the proposed resolution. Terminal.</summary>
+    Approved = 1,
+
+    /// <summary>A checker rejected the proposed resolution. Terminal.</summary>
+    Rejected = 2
+}
+
+/// <summary>Role in which an identity acted for a given ledger entry.</summary>
+public enum ActorRole
+{
+    /// <summary>The maker who raised the resolution request.</summary>
+    Proposer = 0,
+
+    /// <summary>The independent checker who decided the request.</summary>
+    Checker = 1
+}
+
+/// <summary>The decision a checker may record against a proposed resolution.</summary>
+public enum ResolutionDecision
+{
+    Approved = 0,
+    Rejected = 1
+}
