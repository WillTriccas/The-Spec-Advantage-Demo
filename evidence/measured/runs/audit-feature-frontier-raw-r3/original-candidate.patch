@@ -0,0 +1,48 @@
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// Rules for the identities and request identifiers the workflow will recognise. Identities
+/// are compared case-insensitively after trimming so that <c>Analyst.One</c> and
+/// <c>analyst.one</c> can never be used to defeat the maker-checker separation.
+/// </summary>
+public static class AuditIdentity
+{
+    /// <summary>Maximum accepted length of an actor identity or request identifier.</summary>
+    public const int MaxLength = 128;
+
+    private static readonly Regex ActorPattern = new(
+        @"^[A-Za-z0-9][A-Za-z0-9 ._@+\-]*$",
+        RegexOptions.CultureInvariant,
+        TimeSpan.FromSeconds(2));
+
+    private static readonly Regex RequestIdPattern = new(
+        @"^[A-Za-z0-9][A-Za-z0-9._:\-]*$",
+        RegexOptions.CultureInvariant,
+        TimeSpan.FromSeconds(2));
+
+    /// <summary>Trims surrounding whitespace and collapses the value to its recognised form.</summary>
+    public static string Normalize(string? raw)
+        => raw?.Trim() ?? string.Empty;
+
+    /// <summary>True when <paramref name="raw"/> is a recognisable actor identity.</summary>
+    public static bool IsValidActor(string? raw)
+    {
+        var value = Normalize(raw);
+        return value.Length is > 0 and <= MaxLength && ActorPattern.IsMatch(value);
+    }
+
+    /// <summary>True when <paramref name="raw"/> is a usable idempotency / request key.</summary>
+    public static bool IsValidRequestId(string? raw)
+    {
+        var value = Normalize(raw);
+        return value.Length is > 0 and <= MaxLength && RequestIdPattern.IsMatch(value);
+    }
+
+    /// <summary>
+    /// Case-insensitive identity comparison used to enforce segregation of duties.
+    /// </summary>
+    public static bool AreSameParty(string? left, string? right)
+        => string.Equals(Normalize(left), Normalize(right), StringComparison.OrdinalIgnoreCase);
+}
diff --git a/src/TradeRecon.Domain/Audit/AuditLedgerEntry.cs b/src/TradeRecon.Domain/Audit/AuditLedgerEntry.cs
new file mode 100644
index 0000000..3e0e54d
--- /dev/null
+++ b/src/TradeRecon.Domain/Audit/AuditLedgerEntry.cs
@@ -0,0 +1,71 @@
+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// One immutable, append-only record in the resolution audit history.
+/// </summary>
+/// <remarks>
+/// Entries are sealed into a hash chain: <see cref="EntryHash"/> covers every business field
+/// plus <see cref="PreviousHash"/>, so neither reordering, editing nor removing a historical
+/// entry can go undetected. Only redacted narrative and digests are carried — an entry never
+/// contains an account identifier or a trade amount.
+/// </remarks>
+public sealed record AuditLedgerEntry
+{
+    /// <summary>Global 1-based position of this entry in the ledger.</summary>
+    public required long Sequence { get; init; }
+
+    /// <summary>1-based version of the request that this entry produced.</summary>
+    public required int Version { get; init; }
+
+    /// <summary>Caller-supplied stable identity of the resolution request (idempotency key).</summary>
+    public required string RequestId { get; init; }
+
+    /// <summary>Lifecycle action this entry records.</summary>
+    public required AuditAction Action { get; init; }
+
+    /// <summary>Recognised identity that performed <see cref="Action"/>.</summary>
+    public required string Actor { get; init; }
+
+    /// <summary>Capacity in which <see cref="Actor"/> acted.</summary>
+    public required ActorRole ActorRole { get; init; }
+
+    /// <summary>Recognised identity of the maker who raised the request.</summary>
+    public required string Proposer { get; init; }
+
+    /// <summary>Recognised identity of the checker, once the request has been decided.</summary>
+    public string? Approver { get; init; }
+
+    /// <summary>Business date the underlying reconciliation break belongs to.</summary>
+    public required DateOnly BusinessDate { get; init; }
+
+    /// <summary>UTC instant the entry was sealed.</summary>
+    public required DateTimeOffset Timestamp { get; init; }
+
+    /// <summary>Analyst reason with identifiers and amounts redacted.</summary>
+    public required string Reason { get; init; }
+
+    /// <summary>Digest of the original reason text, for after-the-fact verification.</summary>
+    public required string ReasonDigest { get; init; }
+
+    /// <summary>Supporting evidence with identifiers and amounts redacted.</summary>
+    public required string Evidence { get; init; }
+
+    /// <summary>Digest of the original evidence text.</summary>
+    public required string EvidenceDigest { get; init; }
+
+    /// <summary>Digest of the reconciliation break key, when one was supplied.</summary>
+    public string? BreakReference { get; init; }
+
+    /// <summary>Hash of the preceding entry, or <see cref="AuditHash.Genesis"/> for the first.</summary>
+    public required string PreviousHash { get; init; }
+
+    /// <summary>Hash sealing this entry. Empty until the entry is sealed.</summary>
+    public string EntryHash { get; init; } = string.Empty;
+
+    /// <summary>True when this entry is a terminal decision.</summary>
+    public bool IsFinalDecision => Action is AuditAction.Approved or AuditAction.Rejected;
+
+    /// <summary>True when a decision was taken by someone other than the proposer.</summary>
+    public bool CheckerIsDistinctFromProposer
+        => IsFinalDecision && !AuditIdentity.AreSameParty(Actor, Proposer);
+}
diff --git a/src/TradeRecon.Domain/Audit/AuditTimestamp.cs b/src/TradeRecon.Domain/Audit/AuditTimestamp.cs
new file mode 100644
index 0000000..de37687
--- /dev/null
+++ b/src/TradeRecon.Domain/Audit/AuditTimestamp.cs
@@ -0,0 +1,42 @@
+using System.Globalization;
+
+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// Single canonical timestamp / date representation shared by the hash chain and every
+/// serialised form, so a ledger entry re-read from disk hashes identically to the entry
+/// that was written.
+/// </summary>
+public static class AuditTimestamp
+{
+    private const string Layout = "yyyy-MM-ddTHH:mm:ss.fffffffZ";
+
+    /// <summary>Formats an instant as UTC ISO-8601 with fixed precision.</summary>
+    public static string Format(DateTimeOffset value)
+        => value.ToUniversalTime().ToString(Layout, CultureInfo.InvariantCulture);
+
+    /// <summary>Parses a canonical timestamp produced by <see cref="Format"/>.</summary>
+    public static DateTimeOffset Parse(string value)
+        => DateTimeOffset.ParseExact(
+            value,
+            Layout,
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal);
+
+    /// <summary>Attempts to parse a canonical timestamp.</summary>
+    public static bool TryParse(string? value, out DateTimeOffset result)
+        => DateTimeOffset.TryParseExact(
+            value,
+            Layout,
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
+            out result);
+
+    /// <summary>Formats a business date in ISO form.</summary>
+    public static string FormatDate(DateOnly value)
+        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+    /// <summary>Attempts to parse an ISO business date.</summary>
+    public static bool TryParseDate(string? value, out DateOnly result)
+        => DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out result);
+}
diff --git a/src/TradeRecon.Domain/Audit/SensitiveTextRedactor.cs b/src/TradeRecon.Domain/Audit/SensitiveTextRedactor.cs
new file mode 100644
index 0000000..ecfc68a
--- /dev/null
+++ b/src/TradeRecon.Domain/Audit/SensitiveTextRedactor.cs
@@ -0,0 +1,86 @@
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// Removes account identifiers, instrument identifiers, record identifiers and monetary /
+/// quantity amounts from analyst-supplied free text before it is ever persisted, logged or
+/// exported. Redaction happens at the boundary, so the durable ledger itself never contains
+/// sensitive values — only redacted narrative plus a digest of the original.
+/// </summary>
+/// <remarks>
+/// The policy is deliberately conservative: any token that mixes letters and digits (for
+/// example <c>ACC001</c>, <c>T003</c>, <c>GB00B03MLX29</c>) and any numeric literal
+/// (for example <c>1600500.00</c>) is replaced. ISO business dates are preserved because
+/// they carry no client-identifying information and are needed for explainability.
+/// </remarks>
+public static class SensitiveTextRedactor
+{
+    /// <summary>Replacement token for account, instrument and record identifiers.</summary>
+    public const string IdentifierPlaceholder = "[redacted-id]";
+
+    /// <summary>Replacement token for monetary amounts and quantities.</summary>
+    public const string AmountPlaceholder = "[redacted-amount]";
+
+    /// <summary>Maximum retained length of a redacted narrative.</summary>
+    public const int MaxLength = 2048;
+
+    private static readonly Regex SensitivePattern = new(
+        @"(?<date>\b\d{4}-\d{2}-\d{2}\b)" +
+        @"|(?<id>\b(?=[A-Za-z0-9\-]*[A-Za-z])(?=[A-Za-z0-9\-]*[0-9])[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\b)" +
+        @"|(?<amount>\b\d+(?:[.,]\d+)*\b)",
+        RegexOptions.CultureInvariant | RegexOptions.ExplicitCapture,
+        TimeSpan.FromSeconds(2));
+
+    private static readonly Regex WhitespacePattern = new(
+        @"\s+",
+        RegexOptions.CultureInvariant,
+        TimeSpan.FromSeconds(2));
+
+    /// <summary>
+    /// Returns a safe-to-persist form of <paramref name="text"/> with identifiers and amounts
+    /// replaced by stable placeholders and whitespace normalised to single spaces.
+    /// </summary>
+    public static string Redact(string? text)
+    {
+        if (string.IsNullOrWhiteSpace(text))
+        {
+            return string.Empty;
+        }
+
+        var normalised = WhitespacePattern.Replace(text, " ").Trim();
+        var redacted = SensitivePattern.Replace(normalised, static match =>
+        {
+            if (match.Groups["date"].Success)
+            {
+                return match.Value;
+            }
+
+            return match.Groups["id"].Success ? IdentifierPlaceholder : AmountPlaceholder;
+        });
+
+        return redacted.Length <= MaxLength ? redacted : redacted[..MaxLength];
+    }
+
+    /// <summary>
+    /// True when <paramref name="text"/> still contains a value the redaction policy treats as
+    /// sensitive. Used as a defensive assertion before anything is written or printed.
+    /// </summary>
+    public static bool ContainsSensitiveValue(string? text)
+    {
+        if (string.IsNullOrEmpty(text))
+        {
+            return false;
+        }
+
+        foreach (Match match in SensitivePattern.Matches(text))
+        {
+            if (!match.Groups["date"].Success)
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
diff --git a/src/TradeRecon.Infrastructure/Audit/AuditServiceCollectionExtensions.cs b/src/TradeRecon.Infrastructure/Audit/AuditServiceCollectionExtensions.cs
