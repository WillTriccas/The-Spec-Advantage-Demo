+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditWorkflowTests
+{
+    [Fact]
+    public async Task ProposeAppendsOneSealedEntryWithRedactedNarrative()
+    {
+        using var state = new AuditTestState();
+
+        var result = await state.Service.ProposeAsync(state.Proposal(breakKey:
+            "20240603|QuantityMismatch|ACC002|DE0005140008|EUR|T003|S003"));
+
+        Assert.True(result.Ok);
+        Assert.False(result.Idempotent);
+        var entry = Assert.IsType<AuditLedgerEntry>(result.Entry);
+        Assert.Equal(1, entry.Sequence);
+        Assert.Equal(1, entry.Version);
+        Assert.Equal(AuditAction.Proposed, entry.Action);
+        Assert.Equal(ActorRole.Proposer, entry.ActorRole);
+        Assert.Equal("analyst.one", entry.Proposer);
+        Assert.Equal(AuditHash.Genesis, entry.PreviousHash);
+        Assert.StartsWith(AuditHash.Prefix, entry.EntryHash, StringComparison.Ordinal);
+        Assert.True(AuditEntrySealer.IsSealValid(entry));
+
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveValue(entry.Reason));
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveValue(entry.Evidence));
+        Assert.StartsWith(AuditHash.Prefix, entry.BreakReference, StringComparison.Ordinal);
+        Assert.Single(state.LedgerLines);
+    }
+
+    [Fact]
+    public async Task ProposeIsIdempotentForARepeatedRequestId()
+    {
+        using var state = new AuditTestState();
+
+        var first = await state.Service.ProposeAsync(state.Proposal());
+        var retry = await state.Service.ProposeAsync(state.Proposal());
+
+        Assert.True(first.Ok);
+        Assert.True(retry.Ok);
+        Assert.False(first.Idempotent);
+        Assert.True(retry.Idempotent);
+        Assert.Equal(first.Entry!.EntryHash, retry.Entry!.EntryHash);
+        Assert.Single(state.LedgerLines);
+    }
+
+    [Fact]
+    public async Task ReusingARequestIdForDifferentContentIsRefused()
+    {
+        using var state = new AuditTestState();
+
+        await state.Service.ProposeAsync(state.Proposal());
+        var conflict = await state.Service.ProposeAsync(state.Proposal(reason: "A materially different reason."));
+
+        Assert.False(conflict.Ok);
+        Assert.Equal(AuditErrorCodes.RequestConflict, conflict.ErrorCode);
+        Assert.Single(state.LedgerLines);
+    }
+
+    [Theory]
+    [InlineData("analyst.one")]
+    [InlineData("Analyst.One")]
+    [InlineData("  analyst.one  ")]
+    public async Task AProposerCanNeverDecideTheirOwnRequest(string approver)
+    {
+        using var state = new AuditTestState();
+        await state.Service.ProposeAsync(state.Proposal());
+
