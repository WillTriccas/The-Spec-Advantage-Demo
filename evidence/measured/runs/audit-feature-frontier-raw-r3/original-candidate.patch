+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using TradeRecon.Infrastructure.Audit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Helpers for asserting that no sensitive value survives into durable audit text.
+/// Hash digests are hexadecimal, so they can coincidentally contain short numeric
+/// literals; they are elided before a leakage scan so the assertion stays exact.
+/// </summary>
+internal static class AuditText
+{
+    private static readonly System.Text.RegularExpressions.Regex DigestPattern =
+        new("sha256:[0-9a-fA-F]{64}", System.Text.RegularExpressions.RegexOptions.Compiled);
+
+    public static readonly string[] SensitiveValues =
+    [
+        "ACC002", "DE0005140008", "T003", "S003", "CM-88421", "1600500.00", "1900", "2000"
+    ];
+
+    public static string WithoutDigests(string text) => DigestPattern.Replace(text, "sha256:<digest>");
+
+    public static void AssertNoLeakage(string text)
+    {
+        var scrubbed = WithoutDigests(text);
+        foreach (var value in SensitiveValues)
+        {
+            Xunit.Assert.DoesNotContain(value, scrubbed, StringComparison.OrdinalIgnoreCase);
+        }
+    }
+}
+
+/// <summary>Deterministic, monotonically advancing clock for audit tests.</summary>
+internal sealed class SteppingTimeProvider : TimeProvider
+{
+    private DateTimeOffset _now;
+
+    public SteppingTimeProvider(DateTimeOffset start) => _now = start;
+
+    public override DateTimeOffset GetUtcNow()
+    {
+        var current = _now;
+        _now = _now.AddSeconds(1);
+        return current;
+    }
+}
+
+/// <summary>Creates and cleans up an isolated audit state directory.</summary>
+internal sealed class AuditTestState : IDisposable
+{
+    public AuditTestState()
+    {
+        Directory = Path.Combine(Path.GetTempPath(), $"trade-recon-audit-{Guid.NewGuid():N}");
+        System.IO.Directory.CreateDirectory(Directory);
+        Ledger = new FileAuditLedger(Directory);
+        Service = new ResolutionWorkflowService(Ledger, new SteppingTimeProvider(
+            new DateTimeOffset(2024, 6, 4, 9, 0, 0, TimeSpan.Zero)));
+    }
+
+    public string Directory { get; }
+
+    public FileAuditLedger Ledger { get; }
+
+    public ResolutionWorkflowService Service { get; }
+
+    public string LedgerText => File.Exists(Ledger.LedgerPath) ? File.ReadAllText(Ledger.LedgerPath) : string.Empty;
+
+    public IReadOnlyList<string> LedgerLines => File.Exists(Ledger.LedgerPath)
+        ? File.ReadAllLines(Ledger.LedgerPath).Where(line => !string.IsNullOrWhiteSpace(line)).ToList()
+        : [];
+
+    public ProposeResolutionCommand Proposal(
+        string requestId = "REQ-001",
+        string proposer = "analyst.one",
+        string reason = "Break on ACC002 for T003: custodian confirmed 1900 against 2000.",
+        string evidence = "Custodian mail CM-88421 for account ACC002.",
+        DateOnly? businessDate = null,
+        string? breakKey = null)
+        => new()
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = businessDate ?? new DateOnly(2024, 6, 3),
+            Reason = reason,
+            Evidence = evidence,
+            BreakKey = breakKey
+        };
+
+    public RecordDecisionCommand Decision(
+        string requestId = "REQ-001",
+        string approver = "checker.two",
+        ResolutionDecision decision = ResolutionDecision.Approved)
+        => new() { RequestId = requestId, Approver = approver, Decision = decision };
+
+    public void Dispose()
+    {
+        try
+        {
+            if (System.IO.Directory.Exists(Directory))
+            {
+                System.IO.Directory.Delete(Directory, recursive: true);
+            }
+        }
+        catch (IOException)
+        {
+            // Best-effort cleanup of a temporary directory.
+        }
+    }
+}
