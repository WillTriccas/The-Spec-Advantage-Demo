@@ -0,0 +1,226 @@
+using System.Text.Json;
+using TradeRecon.Application.Audit;
+using Xunit;
+using AuditCli = TradeRecon.Audit.Console.Program;
+
+namespace TradeRecon.Tests;
+
+public class AuditCliTests : IDisposable
+{
+    private const int Success = 0;
+    private const int UsageError = 1;
+    private const int Refused = 3;
+
+    private readonly string _directory;
+
+    public AuditCliTests()
+    {
+        _directory = Path.Combine(Path.GetTempPath(), "tradercon-audit-cli-" + Guid.NewGuid().ToString("N"));
+    }
+
+    public void Dispose()
+    {
+        GC.SuppressFinalize(this);
+        if (Directory.Exists(_directory))
+        {
+            Directory.Delete(_directory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task InitializePreparesTheStateDirectory()
+    {
+        var exitCode = await AuditCli.Main(["initialize", "--state", _directory]);
+
+        Assert.Equal(Success, exitCode);
+        Assert.True(Directory.Exists(_directory));
+    }
+
+    [Fact]
+    public async Task InitializeIsSafeToRepeat()
+    {
+        Assert.Equal(Success, await AuditCli.Main(["initialize", "--state", _directory]));
+        Assert.Equal(Success, await AuditCli.Main(["init", "--state", _directory]));
+    }
+
+    [Fact]
+    public async Task TheAdapterLifecycleRunsEndToEnd()
+    {
+        var exportPath = Path.Combine(_directory, "audit-history.json");
+
+        Assert.Equal(Success, await AuditCli.Main(["initialize", "--state", _directory]));
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+        Assert.Equal(Refused, await AuditCli.Main(Decide("analyst.one", "approve")));
+        Assert.Equal(Success, await AuditCli.Main(Decide("checker.two", "approve")));
+        Assert.Equal(Success, await AuditCli.Main(Decide("checker.two", "approve")));
+        Assert.Equal(Refused, await AuditCli.Main(Decide("checker.three", "reject")));
+        Assert.Equal(Success, await AuditCli.Main(Export(exportPath)));
+
+        var document = JsonSerializer.Deserialize<AuditExportDocument>(
+            await File.ReadAllTextAsync(exportPath),
+            AuditContract.Readable)!;
+
+        Assert.True(document.ChainVerified);
+        Assert.Equal(2, document.EntryCount);
+        Assert.Equal(1, document.RequestCount);
+
+        var summary = Assert.Single(document.Requests);
+        Assert.Equal("REQ-001", summary.RequestId);
+        Assert.Equal("Approved", summary.Status);
+        Assert.Equal("analyst.one", summary.Proposer);
+        Assert.Equal("checker.two", summary.Checker);
+        Assert.Equal(1, summary.DecisionCount);
+        Assert.True(summary.SegregationOfDutiesSatisfied);
+
+        Assert.Collection(
+            document.Entries,
+            entry => Assert.Equal("Proposed", entry.Action),
+            entry =>
+            {
+                Assert.Equal("Approved", entry.Action);
+                Assert.True(entry.IsFinalDecision);
+                Assert.True(entry.CheckerDistinctFromProposer);
+            });
+    }
+
+    [Fact]
+    public async Task AnExportedHistoryNeverCarriesAccountsInstrumentsOrAmounts()
+    {
+        var exportPath = Path.Combine(_directory, "audit-history.json");
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+        Assert.Equal(Success, await AuditCli.Main(Decide("checker.two", "approve")));
+        Assert.Equal(Success, await AuditCli.Main(Export(exportPath)));
+
+        var exported = await File.ReadAllTextAsync(exportPath);
+        var ledger = await File.ReadAllTextAsync(Path.Combine(_directory, "audit-ledger.jsonl"));
+
+        AuditText.AssertNoLeakage(exported);
+        AuditText.AssertNoLeakage(ledger);
+    }
+
+    [Fact]
+    public async Task ProposeAcceptsInlineOptionValues()
+    {
+        var exitCode = await AuditCli.Main([
+            "propose",
+            $"--state={_directory}",
+            "--request-id=REQ-042",
+            "--proposer=analyst.one",
+            "--business-date=2024-06-03",
+            "--reason=Quantity break cleared against the custodian statement.",
+            "--evidence=Custodian statement page 4."
+        ]);
+
+        Assert.Equal(Success, exitCode);
+        Assert.Single(await File.ReadAllLinesAsync(Path.Combine(_directory, "audit-ledger.jsonl")));
+    }
+
+    [Fact]
+    public async Task RetryingAProposalDoesNotGrowTheLedger()
+    {
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+
+        Assert.Single(await File.ReadAllLinesAsync(Path.Combine(_directory, "audit-ledger.jsonl")));
+    }
+
+    [Fact]
+    public async Task DecidingAnUnknownRequestIsARefusalNotACrash()
+    {
+        Assert.Equal(Success, await AuditCli.Main(["initialize", "--state", _directory]));
+
+        Assert.Equal(Refused, await AuditCli.Main(Decide("checker.two", "approve", "REQ-MISSING")));
+    }
+
+    public static TheoryData<string[]> MisuseCases
+    {
+        get
+        {
+            var cases = new TheoryData<string[]>();
+            cases.Add(Array.Empty<string>());
+            cases.Add(new[] { "verify" });
+            cases.Add(new[] { "propose" });
+            cases.Add(new[] { "decide", "--state", "." });
+            cases.Add(new[] { "export", "--state", "." });
+            return cases;
+        }
+    }
+
+    [Theory]
+    [MemberData(nameof(MisuseCases))]
+    public async Task MisuseIsReportedAsAUsageError(string[] args)
+    {
+        Assert.Equal(UsageError, await AuditCli.Main(args));
+    }
+
+    [Fact]
+    public async Task AnUnparsableDecisionIsRefused()
+    {
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+
+        Assert.Equal(Refused, await AuditCli.Main(Decide("checker.two", "maybe")));
+    }
+
+    [Fact]
+    public async Task ExportStillSucceedsWhenNothingMatchesTheRange()
+    {
+        var exportPath = Path.Combine(_directory, "empty.json");
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+
+        Assert.Equal(Success, await AuditCli.Main([
+            "export", "--state", _directory, "--from", "2030-01-01", "--to", "2030-12-31", "--out", exportPath
+        ]));
+
+        var document = JsonSerializer.Deserialize<AuditExportDocument>(
+            await File.ReadAllTextAsync(exportPath),
+            AuditContract.Readable)!;
+
+        Assert.Equal(0, document.EntryCount);
+        Assert.Empty(document.Entries);
+        Assert.Empty(document.Requests);
+    }
+
+    [Fact]
+    public async Task AnInvertedExportRangeIsRefused()
+    {
+        Assert.Equal(Success, await AuditCli.Main(Propose()));
+
+        Assert.Equal(Refused, await AuditCli.Main([
+            "export",
+            "--state", _directory,
+            "--from", "2024-06-30",
+            "--to", "2024-06-01",
+            "--out", Path.Combine(_directory, "inverted.json")
+        ]));
+    }
+
+    private string[] Propose() =>
+    [
+        "propose",
+        "--state", _directory,
+        "--request-id", "REQ-001",
+        "--proposer", "analyst.one",
+        "--business-date", "2024-06-03",
+        "--reason", "Quantity break on ACC002 for T003 cleared: custodian shows 1900 against street 2000.",
+        "--evidence", "Custodian statement CM-88421 confirms 1600500.00 settled.",
+        "--break-key", "20240603|QuantityMismatch|ACC002|DE0005140008|EUR|T003|S003"
+    ];
+
+    private string[] Decide(string approver, string decision, string requestId = "REQ-001") =>
+    [
+        "decide",
+        "--state", _directory,
+        "--request-id", requestId,
+        "--approver", approver,
+        "--decision", decision
+    ];
+
+    private string[] Export(string exportPath) =>
+    [
+        "export",
+        "--state", _directory,
+        "--from", "2024-06-01",
+        "--to", "2024-06-30",
+        "--out", exportPath
+    ];
+}
