@@ -0,0 +1,29 @@
+using Microsoft.Extensions.DependencyInjection;
+using TradeRecon.Application.Audit;
+using TradeRecon.Infrastructure.Audit;
+
+namespace TradeRecon.Infrastructure;
+
+/// <summary>
+/// Composition root helpers for the maker-checker resolution audit workflow.
+/// </summary>
+public static class AuditServiceCollectionExtensions
+{
+    /// <summary>
+    /// Registers the file-backed append-only audit ledger and the workflow service that
+    /// enforces segregation of duties, idempotency and single-final-decision semantics.
+    /// </summary>
+    public static IServiceCollection AddTradeReconAudit(
+        this IServiceCollection services,
+        string stateDirectory,
+        TimeProvider? timeProvider = null)
+    {
+        ArgumentNullException.ThrowIfNull(services);
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+
+        services.AddSingleton(timeProvider ?? TimeProvider.System);
+        services.AddSingleton<IAuditLedger>(_ => new FileAuditLedger(stateDirectory));
+        services.AddSingleton<ResolutionWorkflowService>();
+        return services;
+    }
+}
diff --git a/src/TradeRecon.Infrastructure/Audit/FileAuditLedger.cs b/src/TradeRecon.Infrastructure/Audit/FileAuditLedger.cs
new file mode 100644
index 0000000..a2c4438
--- /dev/null
+++ b/src/TradeRecon.Infrastructure/Audit/FileAuditLedger.cs
@@ -0,0 +1,271 @@
+using System.Text;
+using System.Text.Json;
+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Infrastructure.Audit;
+
+/// <summary>
+/// Durable append-only audit ledger backed by a hash-chained JSON-lines file inside the
+/// state directory.
+/// </summary>
+/// <remarks>
+/// Mutual exclusion is provided by an exclusively-opened lock file, so the read-decide-append
+/// sequence is atomic across threads <em>and</em> across processes. Two racing decisions
+/// therefore serialise: the first commits, the second observes the committed decision and is
+/// refused, leaving exactly one durable final decision.
+/// </remarks>
+public sealed class FileAuditLedger : IAuditLedger
+{
+    /// <summary>Name of the append-only hash-chained history file.</summary>
+    public const string LedgerFileName = "audit-ledger.jsonl";
+
+    /// <summary>Name of the cross-process mutual-exclusion file.</summary>
+    public const string LockFileName = "audit-ledger.lock";
+
+    /// <summary>Name of the state marker written by initialize.</summary>
+    public const string ManifestFileName = "audit-state.json";
+
+    private static readonly TimeSpan LockTimeout = TimeSpan.FromSeconds(60);
+
+    private readonly string _stateDirectory;
+
+    public FileAuditLedger(string stateDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+        _stateDirectory = Path.GetFullPath(stateDirectory);
+    }
+
+    /// <summary>Absolute path of the append-only history file.</summary>
+    public string LedgerPath => Path.Combine(_stateDirectory, LedgerFileName);
+
+    /// <summary>Absolute path of the state marker.</summary>
+    public string ManifestPath => Path.Combine(_stateDirectory, ManifestFileName);
+
+    /// <inheritdoc />
+    public async Task InitializeAsync(CancellationToken cancellationToken = default)
+    {
+        Directory.CreateDirectory(_stateDirectory);
+
+        await SeedAsync(LedgerPath, string.Empty, cancellationToken).ConfigureAwait(false);
+
+        var manifest = JsonSerializer.Serialize(
+            new
+            {
+                schemaVersion = AuditContract.SchemaVersion,
+                ledgerFile = LedgerFileName,
+                hashAlgorithm = "sha256",
+                appendOnly = true
+            },
+            AuditContract.Readable);
+
+        await SeedAsync(ManifestPath, manifest + "\n", cancellationToken).ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// Creates a state file exactly once. Initialization runs before the write lock is taken,
+    /// so concurrent hosts can race here; the loser simply keeps the winner's file.
+    /// </summary>
+    private static async Task SeedAsync(string path, string contents, CancellationToken cancellationToken)
+    {
+        if (File.Exists(path))
+        {
+            return;
+        }
+
+        try
+        {
+            await using var stream = new FileStream(
+                path,
+                FileMode.CreateNew,
+                FileAccess.Write,
+                FileShare.Read,
+                bufferSize: 4096,
+                FileOptions.Asynchronous);
+
+            if (contents.Length > 0)
+            {
+                await using var writer = new StreamWriter(stream);
+                await writer.WriteAsync(contents.AsMemory(), cancellationToken).ConfigureAwait(false);
+            }
+        }
+        catch (IOException) when (File.Exists(path))
+        {
+            // Another host created the file first; its content is equivalent.
+        }
+        catch (UnauthorizedAccessException) when (File.Exists(path))
+        {
+            // As above: the file exists, so initialization has already succeeded.
+        }
+    }
+
+    /// <inheritdoc />
+    public async Task<IAuditLedgerTransaction> BeginAsync(CancellationToken cancellationToken = default)
+    {
+        await InitializeAsync(cancellationToken).ConfigureAwait(false);
+
+        var lockStream = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+        try
+        {
+            var (entries, chainVerified) = await ReadEntriesAsync(cancellationToken).ConfigureAwait(false);
+            return new Transaction(LedgerPath, lockStream, entries, chainVerified);
+        }
+        catch
+        {
+            await lockStream.DisposeAsync().ConfigureAwait(false);
+            throw;
+        }
+    }
+
+    private async Task<FileStream> AcquireLockAsync(CancellationToken cancellationToken)
+    {
+        var lockPath = Path.Combine(_stateDirectory, LockFileName);
+        var deadline = DateTime.UtcNow + LockTimeout;
+
+        while (true)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+
+            try
+            {
+                return new FileStream(
+                    lockPath,
+                    FileMode.OpenOrCreate,
+                    FileAccess.ReadWrite,
+                    FileShare.None,
+                    bufferSize: 1,
+                    FileOptions.None);
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new TimeoutException("Timed out waiting for exclusive access to the audit ledger.", ex);
+                }
+
+                await Task.Delay(Random.Shared.Next(5, 25), cancellationToken).ConfigureAwait(false);
+            }
+        }
+    }
+
+    private async Task<(List<AuditLedgerEntry> Entries, bool ChainVerified)> ReadEntriesAsync(
+        CancellationToken cancellationToken)
+    {
+        var entries = new List<AuditLedgerEntry>();
+
+        if (!File.Exists(LedgerPath))
+        {
+            return (entries, true);
+        }
+
+        var lines = await File.ReadAllLinesAsync(LedgerPath, Encoding.UTF8, cancellationToken).ConfigureAwait(false);
+
+        foreach (var line in lines)
+        {
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            AuditLedgerEntry entry;
+            try
+            {
+                var document = JsonSerializer.Deserialize<AuditEntryDocument>(line, AuditContract.Compact)
+                    ?? throw new FormatException("Audit ledger entry is empty.");
+                entry = AuditContract.ToEntry(document);
+            }
+            catch (Exception ex) when (ex is JsonException or FormatException)
+            {
+                // An unreadable line means the history has been altered outside the workflow.
+                return (entries, false);
+            }
+
+            entries.Add(entry);
+        }
+
+        return (entries, AuditEntrySealer.IsChainValid(entries));
+    }
+
+    private sealed class Transaction : IAuditLedgerTransaction
+    {
+        private readonly string _ledgerPath;
+        private readonly FileStream _lockStream;
+        private readonly List<AuditLedgerEntry> _entries;
+        private bool _disposed;
+
+        internal Transaction(
+            string ledgerPath,
+            FileStream lockStream,
+            List<AuditLedgerEntry> entries,
+            bool chainVerified)
+        {
+            _ledgerPath = ledgerPath;
+            _lockStream = lockStream;
+            _entries = entries;
+            ChainVerified = chainVerified;
+        }
+
+        public IReadOnlyList<AuditLedgerEntry> Entries => _entries;
+
+        public bool ChainVerified { get; }
+
+        public async Task<AuditLedgerEntry> AppendAsync(
+            AuditEntryDraft draft,
+            CancellationToken cancellationToken = default)
+        {
+            ArgumentNullException.ThrowIfNull(draft);
+            ObjectDisposedException.ThrowIf(_disposed, this);
+
+            var unsealed = new AuditLedgerEntry
+            {
+                Sequence = _entries.Count + 1,
+                Version = draft.Version,
+                RequestId = draft.RequestId,
+                Action = draft.Action,
+                Actor = draft.Actor,
+                ActorRole = draft.ActorRole,
+                Proposer = draft.Proposer,
+                Approver = draft.Approver,
+                BusinessDate = draft.BusinessDate,
+                Timestamp = draft.Timestamp,
+                Reason = draft.Reason,
+                ReasonDigest = draft.ReasonDigest,
+                Evidence = draft.Evidence,
+                EvidenceDigest = draft.EvidenceDigest,
+                BreakReference = draft.BreakReference,
+                PreviousHash = AuditEntrySealer.HeadHash(_entries)
+            };
+
+            var entry = AuditEntrySealer.Seal(unsealed);
+            var line = JsonSerializer.Serialize(AuditContract.ToDocument(entry), AuditContract.Compact) + "\n";
+
+            await using (var stream = new FileStream(
+                _ledgerPath,
+                FileMode.Append,
+                FileAccess.Write,
+                FileShare.Read,
+                bufferSize: 4096,
+                FileOptions.None))
+            {
+                var bytes = Encoding.UTF8.GetBytes(line);
+                await stream.WriteAsync(bytes, cancellationToken).ConfigureAwait(false);
+                await stream.FlushAsync(cancellationToken).ConfigureAwait(false);
+                stream.Flush(flushToDisk: true);
+            }
+
+            _entries.Add(entry);
+            return entry;
+        }
+
+        public ValueTask DisposeAsync()
+        {
+            if (_disposed)
+            {
+                return ValueTask.CompletedTask;
+            }
+
+            _disposed = true;
+            return _lockStream.DisposeAsync();
+        }
+    }
+}
diff --git a/tests/TradeRecon.Tests/AuditAdapterContractTests.cs b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
new file mode 100644
index 0000000..414de07
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
@@ -0,0 +1,127 @@
+using System.Text.Json;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditAdapterContractTests
+{
+    private static readonly string[] ShellExecutables =
+        ["cmd", "cmd.exe", "sh", "bash", "zsh", "powershell", "powershell.exe", "pwsh", "pwsh.exe"];
+
+    private static readonly char[] ShellMetacharacters = ['|', '&', ';', '>', '<', '`', '$', '\n'];
+
+    public static TheoryData<string, string[]> RequiredPlaceholders
+    {
+        get
+        {
+            var cases = new TheoryData<string, string[]>();
+            cases.Add("initialize", new[] { "{stateDirectory}" });
+            cases.Add("propose", new[]
+            {
+                "{stateDirectory}", "{requestId}", "{proposer}", "{businessDate}", "{reason}", "{evidence}"
+            });
+            cases.Add("decide", new[] { "{stateDirectory}", "{requestId}", "{approver}", "{decision}" });
+            cases.Add("export", new[] { "{stateDirectory}", "{fromDate}", "{toDate}", "{exportPath}" });
+            return cases;
+        }
+    }
+
+    [Fact]
+    public void TheAuditAdapterSitsAtTheCandidateRootAndIsValidJson()
+    {
+        using var document = JsonDocument.Parse(File.ReadAllText(AuditAdapterPath));
+        var root = document.RootElement;
+
+        Assert.Equal(JsonValueKind.Object, root.ValueKind);
+        Assert.False(string.IsNullOrWhiteSpace(root.GetProperty("schemaVersion").GetString()));
+        Assert.False(string.IsNullOrWhiteSpace(root.GetProperty("workingDirectory").GetString()));
+    }
+
+    [Theory]
+    [MemberData(nameof(RequiredPlaceholders))]
+    public void EveryCommandIsAShellFreeArrayCarryingItsPlaceholders(string command, string[] placeholders)
+    {
+        using var document = JsonDocument.Parse(File.ReadAllText(AuditAdapterPath));
+        var element = document.RootElement.GetProperty(command);
+
+        var executable = element.GetProperty("executable").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(executable));
+        Assert.DoesNotContain(executable!.ToLowerInvariant(), ShellExecutables);
+
+        var arguments = element.GetProperty("arguments")
+            .EnumerateArray()
+            .Select(argument => argument.GetString() ?? string.Empty)
+            .ToList();
+
+        Assert.NotEmpty(arguments);
+        Assert.All(arguments, argument => Assert.Equal(-1, argument.IndexOfAny(ShellMetacharacters)));
+
+        foreach (var placeholder in placeholders)
+        {
+            Assert.Contains(placeholder, arguments);
+        }
+
+        var exitCodes = element.GetProperty("allowedExitCodes").EnumerateArray().Select(code => code.GetInt32());
+        Assert.Contains(0, exitCodes);
+    }
+
+    [Fact]
+    public void EveryPlaceholderIsItsOwnArgumentSoNoQuotingIsRequired()
+    {
+        using var document = JsonDocument.Parse(File.ReadAllText(AuditAdapterPath));
+
+        foreach (var command in new[] { "initialize", "propose", "decide", "export" })
+        {
+            var arguments = document.RootElement
+                .GetProperty(command)
+                .GetProperty("arguments")
+                .EnumerateArray()
+                .Select(argument => argument.GetString() ?? string.Empty);
+
+            foreach (var argument in arguments.Where(value => value.Contains('{', StringComparison.Ordinal)))
+            {
+                Assert.StartsWith("{", argument, StringComparison.Ordinal);
+                Assert.EndsWith("}", argument, StringComparison.Ordinal);
+                Assert.Equal(1, argument.Count(character => character == '{'));
+            }
+        }
+    }
+
+    [Fact]
+    public void TheReconciliationAdapterContractIsPreserved()
+    {
+        var path = Path.Combine(RepositoryRoot, "benchmark-adapter.json");
+        using var document = JsonDocument.Parse(File.ReadAllText(path));
+        var root = document.RootElement;
+
+        Assert.Equal("1.0.0", root.GetProperty("schemaVersion").GetString());
+        foreach (var command in new[] { "build", "test", "run" })
+        {
+            Assert.True(root.TryGetProperty(command, out var element));
+            Assert.Equal("dotnet", element.GetProperty("executable").GetString());
+            Assert.NotEmpty(element.GetProperty("arguments").EnumerateArray());
+        }
+
+        var outputs = root.GetProperty("outputs").EnumerateArray().Select(output => output.GetString()).ToList();
+        Assert.Contains("{businessDate}/eod-summary.txt", outputs);
+        Assert.Contains("{businessDate}/eod-break-register.csv", outputs);
+        Assert.Contains("{businessDate}/eod-result.json", outputs);
+    }
+
+    private static string AuditAdapterPath => Path.Combine(RepositoryRoot, "audit-adapter.json");
+
+    private static string RepositoryRoot
+    {
+        get
+        {
+            var directory = new DirectoryInfo(AppContext.BaseDirectory);
+            while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "TradeRecon.sln")))
+            {
+                directory = directory.Parent;
+            }
+
+            return directory?.FullName
+                ?? throw new InvalidOperationException("Could not locate the candidate root from the test output.");
+        }
+    }
+}
