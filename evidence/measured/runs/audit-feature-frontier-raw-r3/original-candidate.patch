+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Serialised form of a single append-only audit history entry. This is both the on-disk
+/// ledger line and the exported entry, so what Compliance reads is exactly what was sealed.
+/// </summary>
+public sealed class AuditEntryDocument
+{
+    /// <summary>Global append order of the entry (1-based, gap-free).</summary>
+    [JsonPropertyName("sequence")]
+    public long Sequence { get; set; }
+
+    /// <summary>Version of the request that this entry produced (1 = proposal).</summary>
+    [JsonPropertyName("version")]
+    public int Version { get; set; }
+
+    /// <summary>Identity of the resolution request this entry belongs to.</summary>
+    [JsonPropertyName("requestId")]
+    public string RequestId { get; set; } = string.Empty;
+
+    /// <summary>Lifecycle action: <c>Proposed</c>, <c>Approved</c> or <c>Rejected</c>.</summary>
+    [JsonPropertyName("action")]
+    public string Action { get; set; } = string.Empty;
+
+    /// <summary>Alias of <see cref="Action"/> for readers keyed on lifecycle wording.</summary>
+    [JsonPropertyName("lifecycleAction")]
+    public string LifecycleAction { get; set; } = string.Empty;
+
+    /// <summary>Recognised identity that performed the action.</summary>
+    [JsonPropertyName("actor")]
+    public string Actor { get; set; } = string.Empty;
+
+    /// <summary>Capacity of the actor: <c>Proposer</c> or <c>Checker</c>.</summary>
+    [JsonPropertyName("actorRole")]
+    public string ActorRole { get; set; } = string.Empty;
+
+    /// <summary>Recognised identity of the maker who raised the request.</summary>
+    [JsonPropertyName("proposer")]
+    public string Proposer { get; set; } = string.Empty;
+
+    /// <summary>Recognised identity of the checker, once decided.</summary>
+    [JsonPropertyName("approver")]
+    public string? Approver { get; set; }
+
+    /// <summary>Alias of <see cref="Approver"/>.</summary>
+    [JsonPropertyName("checker")]
+    public string? Checker { get; set; }
+
+    /// <summary>Business date of the reconciliation break under resolution.</summary>
+    [JsonPropertyName("businessDate")]
+    public string BusinessDate { get; set; } = string.Empty;
+
+    /// <summary>UTC instant the entry was sealed.</summary>
+    [JsonPropertyName("timestamp")]
+    public string Timestamp { get; set; } = string.Empty;
+
+    /// <summary>Analyst narrative, redacted of identifiers and amounts.</summary>
+    [JsonPropertyName("reason")]
+    public string Reason { get; set; } = string.Empty;
+
+    /// <summary>Digest of the original, unredacted reason.</summary>
+    [JsonPropertyName("reasonDigest")]
+    public string ReasonDigest { get; set; } = string.Empty;
+
+    /// <summary>Supporting evidence reference, redacted of identifiers and amounts.</summary>
+    [JsonPropertyName("evidence")]
+    public string Evidence { get; set; } = string.Empty;
+
+    /// <summary>Digest of the original, unredacted evidence.</summary>
+    [JsonPropertyName("evidenceDigest")]
+    public string EvidenceDigest { get; set; } = string.Empty;
+
+    /// <summary>Digest of the reconciliation break key, when one was supplied.</summary>
+    [JsonPropertyName("breakReference")]
+    public string? BreakReference { get; set; }
+
+    /// <summary>True when this entry is the terminal decision for its request.</summary>
+    [JsonPropertyName("isFinalDecision")]
+    public bool IsFinalDecision { get; set; }
+
+    /// <summary>True when a decision was taken by someone other than the proposer.</summary>
+    [JsonPropertyName("checkerDistinctFromProposer")]
+    public bool? CheckerDistinctFromProposer { get; set; }
+
+    /// <summary>Hash of the preceding entry; anchors this entry into the chain.</summary>
+    [JsonPropertyName("previousHash")]
+    public string PreviousHash { get; set; } = string.Empty;
+
+    /// <summary>Hash sealing this entry's content and its link to the chain.</summary>
+    [JsonPropertyName("entryHash")]
+    public string EntryHash { get; set; } = string.Empty;
+}
diff --git a/src/TradeRecon.Application/Audit/AuditErrorCodes.cs b/src/TradeRecon.Application/Audit/AuditErrorCodes.cs
new file mode 100644
index 0000000..afaa3e2
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditErrorCodes.cs
@@ -0,0 +1,31 @@
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Stable machine-readable failure codes surfaced on stdout so a caller can distinguish a
+/// policy refusal from a transport or usage problem.
+/// </summary>
+public static class AuditErrorCodes
+{
+    public const string InvalidRequestId = "InvalidRequestId";
+    public const string InvalidIdentity = "InvalidIdentity";
+    public const string InvalidBusinessDate = "InvalidBusinessDate";
+    public const string InvalidDateRange = "InvalidDateRange";
+    public const string ReasonRequired = "ReasonRequired";
+    public const string EvidenceRequired = "EvidenceRequired";
+    public const string InvalidDecision = "InvalidDecision";
+
+    /// <summary>The request id was reused for materially different proposal content.</summary>
+    public const string RequestConflict = "RequestConflict";
+
+    /// <summary>A decision was attempted for a request that was never proposed.</summary>
+    public const string UnknownRequest = "UnknownRequest";
+
+    /// <summary>Segregation of duties: the proposer may not decide their own request.</summary>
+    public const string SelfApprovalNotPermitted = "SelfApprovalNotPermitted";
+
+    /// <summary>A conflicting decision lost the race; the durable final decision stands.</summary>
+    public const string AlreadyDecided = "AlreadyDecided";
+
+    /// <summary>The persisted hash chain no longer verifies.</summary>
+    public const string LedgerIntegrityViolation = "LedgerIntegrityViolation";
+}
