@@ -0,0 +1,115 @@
+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using TradeRecon.Infrastructure.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditConcurrencyTests
+{
+    private static ResolutionWorkflowService NewService(string directory)
+        => new(new FileAuditLedger(directory), TimeProvider.System);
+
+    [Fact]
+    public async Task ConcurrentConflictingDecisionsLeaveExactlyOneDurableFinalDecision()
+    {
+        using var state = new AuditTestState();
+        await state.Service.ProposeAsync(state.Proposal());
+
+        var contenders = new (string Approver, ResolutionDecision Decision)[]
+        {
+            ("checker.a", ResolutionDecision.Approved),
+            ("checker.b", ResolutionDecision.Rejected),
+            ("checker.c", ResolutionDecision.Approved),
+            ("checker.d", ResolutionDecision.Rejected),
+            ("checker.e", ResolutionDecision.Approved),
+            ("checker.f", ResolutionDecision.Rejected),
+            ("checker.g", ResolutionDecision.Approved),
+            ("checker.h", ResolutionDecision.Rejected)
+        };
+
+        var results = await Task.WhenAll(contenders.Select(contender => Task.Run(() =>
+            NewService(state.Directory).DecideAsync(new RecordDecisionCommand
+            {
+                RequestId = "REQ-001",
+                Approver = contender.Approver,
+                Decision = contender.Decision
+            }))));
+
+        var winners = results.Where(result => result.Ok).ToList();
+        Assert.Single(winners);
+        Assert.All(results.Where(result => !result.Ok),
+            result => Assert.Equal(AuditErrorCodes.AlreadyDecided, result.ErrorCode));
+
+        await using var transaction = await new FileAuditLedger(state.Directory).BeginAsync();
+        Assert.True(transaction.ChainVerified);
+        Assert.Equal(2, transaction.Entries.Count);
+        var decisions = transaction.Entries.Where(entry => entry.IsFinalDecision).ToList();
+        Assert.Single(decisions);
+        Assert.Equal(winners[0].Entry!.EntryHash, decisions[0].EntryHash);
+        Assert.True(decisions[0].CheckerIsDistinctFromProposer);
+    }
+
+    [Fact]
+    public async Task ConcurrentRetriesOfTheSameProposalAppendOnlyOnce()
+    {
+        using var state = new AuditTestState();
+        var command = state.Proposal();
+
+        var results = await Task.WhenAll(Enumerable.Range(0, 8).Select(_ => Task.Run(() =>
+            NewService(state.Directory).ProposeAsync(command))));
+
+        Assert.All(results, result => Assert.True(result.Ok));
+        Assert.Single(results, result => !result.Idempotent);
+
+        await using var transaction = await new FileAuditLedger(state.Directory).BeginAsync();
+        Assert.True(transaction.ChainVerified);
+        Assert.Single(transaction.Entries);
+    }
+
+    [Fact]
+    public async Task ConcurrentWritesAcrossRequestsKeepTheChainContiguous()
+    {
+        using var state = new AuditTestState();
+
+        var results = await Task.WhenAll(Enumerable.Range(1, 12).Select(index => Task.Run(() =>
+            NewService(state.Directory).ProposeAsync(state.Proposal(
+                requestId: $"REQ-{index:D3}",
+                reason: $"Custodian confirmation batch {index} narrative.")))));
+
+        Assert.All(results, result => Assert.True(result.Ok));
+
+        await using var transaction = await new FileAuditLedger(state.Directory).BeginAsync();
+        Assert.True(transaction.ChainVerified);
+        Assert.Equal(12, transaction.Entries.Count);
+        Assert.Equal(
+            Enumerable.Range(1, 12).Select(index => (long)index).ToList(),
+            transaction.Entries.Select(entry => entry.Sequence).ToList());
+        Assert.Equal(12, transaction.Entries.Select(entry => entry.RequestId).Distinct(StringComparer.Ordinal).Count());
+    }
+
+    [Fact]
+    public async Task ConcurrentSelfApprovalAttemptsNeverProduceADecision()
+    {
+        using var state = new AuditTestState();
+        await state.Service.ProposeAsync(state.Proposal());
+
+        var results = await Task.WhenAll(Enumerable.Range(0, 6).Select(index => Task.Run(() =>
+            NewService(state.Directory).DecideAsync(new RecordDecisionCommand
+            {
+                RequestId = "REQ-001",
+                Approver = index % 2 == 0 ? "analyst.one" : "ANALYST.ONE",
+                Decision = ResolutionDecision.Approved
+            }))));
+
+        Assert.All(results, result =>
+        {
+            Assert.False(result.Ok);
+            Assert.Equal(AuditErrorCodes.SelfApprovalNotPermitted, result.ErrorCode);
+        });
+
+        await using var transaction = await new FileAuditLedger(state.Directory).BeginAsync();
+        Assert.Single(transaction.Entries);
+        Assert.DoesNotContain(transaction.Entries, entry => entry.IsFinalDecision);
+    }
+}
