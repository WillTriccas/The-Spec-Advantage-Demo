@@ -0,0 +1,97 @@
+using TradeRecon.Domain.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditRedactionTests
+{
+    [Theory]
+    [InlineData("ACC001")]
+    [InlineData("ACC002")]
+    [InlineData("DE0005140008")]
+    [InlineData("GB00B03MLX29")]
+    [InlineData("T003")]
+    [InlineData("S008")]
+    public void AccountAndRecordIdentifiersAreReplaced(string identifier)
+    {
+        var redacted = SensitiveTextRedactor.Redact($"Confirmed against {identifier} by the custodian.");
+
+        Assert.DoesNotContain(identifier, redacted, StringComparison.OrdinalIgnoreCase);
+        Assert.Contains(SensitiveTextRedactor.IdentifierPlaceholder, redacted, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("1600500.00")]
+    [InlineData("1,600,500.00")]
+    [InlineData("2000")]
+    [InlineData("0.01")]
+    public void TradeAmountsAreReplaced(string amount)
+    {
+        var redacted = SensitiveTextRedactor.Redact($"Amount difference of {amount} accepted.");
+
+        Assert.DoesNotContain(amount, redacted, StringComparison.Ordinal);
+        Assert.Contains(SensitiveTextRedactor.AmountPlaceholder, redacted, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void BusinessDatesArePreservedBecauseTheyAreNotClientIdentifying()
+    {
+        var redacted = SensitiveTextRedactor.Redact("Custodian confirmed on 2024-06-03.");
+
+        Assert.Contains("2024-06-03", redacted, StringComparison.Ordinal);
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveValue("2024-06-03"));
+    }
+
+    [Fact]
+    public void NarrativeSurvivesRedaction()
+    {
+        var redacted = SensitiveTextRedactor.Redact(
+            "Break on ACC002 for T003: custodian confirmed the settled quantity of 1900 on 2024-06-03");
+
+        Assert.Contains("custodian confirmed the settled quantity", redacted, StringComparison.Ordinal);
+        Assert.Contains("2024-06-03", redacted, StringComparison.Ordinal);
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveValue(redacted));
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("   ")]
+    public void EmptyInputRedactsToEmptyString(string? text)
+        => Assert.Equal(string.Empty, SensitiveTextRedactor.Redact(text));
+
+    [Fact]
+    public void WhitespaceIsNormalisedAndLengthIsBounded()
+    {
+        var redacted = SensitiveTextRedactor.Redact("  multi   line\r\n narrative  ");
+        Assert.Equal("multi line narrative", redacted);
+
+        var long_ = SensitiveTextRedactor.Redact(new string('a', SensitiveTextRedactor.MaxLength * 2));
+        Assert.Equal(SensitiveTextRedactor.MaxLength, long_.Length);
+    }
+
+    [Fact]
+    public void SensitiveValueDetectionFlagsIdentifiersAndAmounts()
+    {
+        Assert.True(SensitiveTextRedactor.ContainsSensitiveValue("ACC001"));
+        Assert.True(SensitiveTextRedactor.ContainsSensitiveValue("1600500.00"));
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveValue("custodian confirmed"));
+    }
+
+    [Theory]
+    [InlineData("analyst.one", true)]
+    [InlineData("Jane Doe", true)]
+    [InlineData("checker@example.com", true)]
+    [InlineData("", false)]
+    [InlineData("   ", false)]
+    [InlineData("bad;identity", false)]
+    public void ActorIdentitiesAreValidated(string raw, bool expected)
+        => Assert.Equal(expected, AuditIdentity.IsValidActor(raw));
+
+    [Fact]
+    public void PartyComparisonIgnoresCaseAndSurroundingWhitespace()
+    {
+        Assert.True(AuditIdentity.AreSameParty("Analyst.One", "  analyst.one "));
+        Assert.False(AuditIdentity.AreSameParty("analyst.one", "checker.two"));
+    }
+}
