diff --git a/src/TradeRecon.Infrastructure/Audit/FileAuditTrailStore.cs b/src/TradeRecon.Infrastructure/Audit/FileAuditTrailStore.cs
new file mode 100644
index 0000000..65b9f3d
--- /dev/null
+++ b/src/TradeRecon.Infrastructure/Audit/FileAuditTrailStore.cs
@@ -0,0 +1,204 @@
+using System.Text;
+using TradeRecon.Application.Abstractions;
+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Infrastructure.Audit;
+
+/// <summary>Location of the durable audit trail on disk.</summary>
+public sealed record FileAuditTrailStoreOptions
+{
+    /// <summary>Directory that holds the trail, its lock and its marker file.</summary>
+    public required string StateDirectory { get; init; }
+}
+
+/// <summary>
+/// Append-only, file-backed audit trail.
+///
+/// Entries are stored as line-delimited JSON and are only ever appended: a new decision never
+/// rewrites an existing byte, and each line is hash-chained to its predecessor so an edit or a
+/// deletion is detectable on read.
+///
+/// Mutations are serialised through an operating-system file lock held for the whole
+/// read-decide-append cycle. The lock is honoured across processes, so two agents deciding the
+/// same request concurrently — whether in one process or in two — are ordered, and the second
+/// one observes the first one's durable decision instead of overwriting it.
+/// </summary>
+public sealed class FileAuditTrailStore : IAuditTrailStore
+{
+    /// <summary>Name of the append-only trail file inside the state directory.</summary>
+    public const string TrailFileName = "resolution-audit-trail.jsonl";
+
+    /// <summary>Name of the cross-process lock file.</summary>
+    public const string LockFileName = "resolution-audit-trail.lock";
+
+    /// <summary>Name of the marker written by <c>initialize</c>.</summary>
+    public const string MarkerFileName = "audit-state.json";
+
+    private const string MarkerContent =
+        "{\n  \"schemaVersion\": \"1.0\",\n  \"trailFile\": \"" + TrailFileName + "\"\n}\n";
+
+    private static readonly TimeSpan LockTimeout = TimeSpan.FromSeconds(60);
+    private static readonly UTF8Encoding Utf8NoBom = new(encoderShouldEmitUTF8Identifier: false);
+
+    private readonly string _stateDirectory;
+    private readonly string _trailPath;
+    private readonly string _lockPath;
+    private readonly string _markerPath;
+
+    public FileAuditTrailStore(FileAuditTrailStoreOptions options)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        ArgumentException.ThrowIfNullOrWhiteSpace(options.StateDirectory);
+
+        _stateDirectory = Path.GetFullPath(options.StateDirectory);
+        _trailPath = Path.Combine(_stateDirectory, TrailFileName);
+        _lockPath = Path.Combine(_stateDirectory, LockFileName);
+        _markerPath = Path.Combine(_stateDirectory, MarkerFileName);
+    }
+
+    /// <summary>Full path of the append-only trail file.</summary>
+    public string TrailPath => _trailPath;
+
+    /// <inheritdoc />
+    public async Task InitializeAsync(CancellationToken cancellationToken = default)
+    {
+        Directory.CreateDirectory(_stateDirectory);
+
+        using var guard = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+
+        if (!File.Exists(_trailPath))
+        {
+            await File.WriteAllTextAsync(_trailPath, string.Empty, Utf8NoBom, cancellationToken).ConfigureAwait(false);
+        }
+
+        if (!File.Exists(_markerPath))
+        {
+            await File.WriteAllTextAsync(_markerPath, MarkerContent, Utf8NoBom, cancellationToken).ConfigureAwait(false);
+        }
+    }
+
+    /// <inheritdoc />
+    public async Task<AuditTrailSnapshot> ReadAsync(CancellationToken cancellationToken = default)
+    {
+        Directory.CreateDirectory(_stateDirectory);
+
+        using var guard = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+        return await ReadUnlockedAsync(cancellationToken).ConfigureAwait(false);
+    }
+
+    /// <inheritdoc />
+    public async Task<TResult> ExecuteAsync<TResult>(
+        Func<AuditTrailSnapshot, AuditTransaction<TResult>> decide,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(decide);
+        Directory.CreateDirectory(_stateDirectory);
+
+        using var guard = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+
+        var snapshot = await ReadUnlockedAsync(cancellationToken).ConfigureAwait(false);
+        var transaction = decide(snapshot);
+
+        if (transaction.Append is { } entry)
+        {
+            Validate(entry, snapshot);
+            await AppendUnlockedAsync(entry, cancellationToken).ConfigureAwait(false);
+        }
+
+        return transaction.Result;
+    }
+
+    private static void Validate(AuditEntry entry, AuditTrailSnapshot snapshot)
+    {
+        if (entry.Sequence != snapshot.NextSequence
+            || !string.Equals(entry.PreviousHash, snapshot.HeadHash, StringComparison.Ordinal)
+            || !AuditHashing.HasValidHash(entry))
+        {
+            throw new InvalidOperationException(
+                "Refusing to append an audit entry that does not extend the current trail head.");
+        }
+    }
+
+    private async Task<AuditTrailSnapshot> ReadUnlockedAsync(CancellationToken cancellationToken)
+    {
+        if (!File.Exists(_trailPath))
+        {
+            return AuditTrailSnapshot.Create([]);
+        }
+
+        var lines = await File.ReadAllLinesAsync(_trailPath, Utf8NoBom, cancellationToken).ConfigureAwait(false);
+        var entries = new List<AuditEntry>(lines.Length);
+
+        for (var i = 0; i < lines.Length; i++)
+        {
+            if (string.IsNullOrWhiteSpace(lines[i]))
+            {
+                continue;
+            }
+
+            try
+            {
+                entries.Add(AuditEntrySerializer.Deserialize(lines[i]));
+            }
+            catch (Exception ex) when (ex is FormatException or System.Text.Json.JsonException or ArgumentException)
+            {
+                throw new InvalidDataException(
+                    $"The audit trail is unreadable at line {i + 1}; it may have been tampered with.", ex);
+            }
+        }
+
+        return AuditTrailSnapshot.Create(entries);
+    }
+
+    private async Task AppendUnlockedAsync(AuditEntry entry, CancellationToken cancellationToken)
+    {
+        var line = AuditEntrySerializer.Serialize(entry) + "\n";
+        var bytes = Utf8NoBom.GetBytes(line);
+
+        await using var stream = new FileStream(
+            _trailPath,
+            FileMode.Append,
+            FileAccess.Write,
+            FileShare.Read,
+            bufferSize: 4096,
+            FileOptions.WriteThrough);
+
+        await stream.WriteAsync(bytes, cancellationToken).ConfigureAwait(false);
+        await stream.FlushAsync(cancellationToken).ConfigureAwait(false);
+        stream.Flush(flushToDisk: true);
+    }
+
+    private async Task<FileStream> AcquireLockAsync(CancellationToken cancellationToken)
+    {
+        var deadline = DateTime.UtcNow + LockTimeout;
+        var delayMilliseconds = 2;
+
+        while (true)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+
+            try
+            {
+                return new FileStream(
+                    _lockPath,
+                    FileMode.OpenOrCreate,
+                    FileAccess.ReadWrite,
+                    FileShare.None,
+                    bufferSize: 1,
+                    FileOptions.None);
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new TimeoutException(
+                        "Timed out waiting for exclusive access to the audit trail.", ex);
+                }
+
+                await Task.Delay(delayMilliseconds, cancellationToken).ConfigureAwait(false);
+                delayMilliseconds = Math.Min(delayMilliseconds * 2, 50);
+            }
+        }
+    }
+}
