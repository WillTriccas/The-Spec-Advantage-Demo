+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using TradeRecon.Infrastructure.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Behavioural guarantees of the maker-checker resolution workflow and of the append-only trail
+/// it writes.
+/// </summary>
+public class AuditWorkflowTests
+{
+    [Fact]
+    public async Task ProposeThenApprove_RecordsMakerAndCheckerAsDistinctPeople()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.InitializeAsync();
+
+        var proposal = await context.Workflow.ProposeAsync(context.Proposal());
+        var decision = await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-1",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.True(proposal.Ok);
+        Assert.Equal(WorkflowOutcome.Proposed, proposal.Outcome);
+        Assert.Equal(ResolutionStatus.Pending, proposal.Status);
+
+        Assert.True(decision.Ok);
+        Assert.Equal(WorkflowOutcome.Approved, decision.Outcome);
+        Assert.Equal(ResolutionStatus.Approved, decision.Status);
+        Assert.Equal("analyst.maker", decision.Proposer);
+        Assert.Equal("compliance.checker", decision.Checker);
+
+        var snapshot = await context.Store.ReadAsync();
+        Assert.True(snapshot.ChainVerified);
+        Assert.Equal(2, snapshot.Entries.Count);
+        Assert.Equal(new long[] { 1, 2 }, snapshot.Entries.Select(e => e.Sequence).ToArray());
+        Assert.Equal(new[] { 1, 2 }, snapshot.Entries.Select(e => e.Version).ToArray());
+        Assert.Equal(ActorRole.Proposer, snapshot.Entries[0].ActorRole);
+        Assert.Equal(ActorRole.Checker, snapshot.Entries[1].ActorRole);
+    }
+
+    [Fact]
+    public async Task SelfApproval_IsRefusedAndLeavesNoDurableDecision()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        var decision = await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-1",
+            Approver = "Analyst.Maker ",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.False(decision.Ok);
+        Assert.Equal(WorkflowOutcome.SelfApprovalRejected, decision.Outcome);
+        Assert.Equal(ResolutionStatus.Pending, decision.Status);
+
+        var snapshot = await context.Store.ReadAsync();
+        Assert.Single(snapshot.Entries);
+        Assert.Null(snapshot.DecisionFor("REQ-1"));
+    }
+
+    [Fact]
+    public async Task RepeatedProposal_IsIdempotentAndAppendsNothing()
+    {
+        using var context = AuditTestContext.Create();
+
+        var first = await context.Workflow.ProposeAsync(context.Proposal());
+        var retry = await context.Workflow.ProposeAsync(context.Proposal());
+
+        Assert.True(retry.Ok);
+        Assert.True(retry.IdempotentReplay);
+        Assert.Equal(WorkflowOutcome.ProposalReplayed, retry.Outcome);
+        Assert.Equal(first.EntryHash, retry.EntryHash);
+        Assert.Single((await context.Store.ReadAsync()).Entries);
+    }
+
+    [Fact]
+    public async Task ReusingRequestIdForDifferentContent_IsRefused()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        var conflicting = await context.Workflow.ProposeAsync(
+            context.Proposal(reason: "A different justification entirely."));
+
+        Assert.False(conflicting.Ok);
+        Assert.Equal(WorkflowOutcome.ProposalConflict, conflicting.Outcome);
+        Assert.Single((await context.Store.ReadAsync()).Entries);
+    }
+
+    [Fact]
+    public async Task RepeatedDecision_FromSameCheckerIsIdempotent()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        var command = new DecideCommand
+        {
+            RequestId = "REQ-1",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Rejected
+        };
+
+        var first = await context.Workflow.DecideAsync(command);
+        var retry = await context.Workflow.DecideAsync(command);
+
+        Assert.True(first.Ok);
+        Assert.True(retry.Ok);
+        Assert.True(retry.IdempotentReplay);
+        Assert.Equal(WorkflowOutcome.DecisionReplayed, retry.Outcome);
+        Assert.Equal(first.EntryHash, retry.EntryHash);
+        Assert.Equal(2, (await context.Store.ReadAsync()).Entries.Count);
+    }
+
+    [Fact]
+    public async Task ConflictingConcurrentDecisions_ProduceExactlyOneFinalDecision()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        // Separate stores model separate agents: each takes the cross-process lock in turn.
+        var approver = NewWorkflow(context);
+        var rejecter = NewWorkflow(context);
+
+        var results = await Task.WhenAll(
+            Task.Run(() => approver.DecideAsync(new DecideCommand
+            {
+                RequestId = "REQ-1",
+                Approver = "checker.one",
+                Decision = ResolutionAction.Approved
+            })),
+            Task.Run(() => rejecter.DecideAsync(new DecideCommand
+            {
+                RequestId = "REQ-1",
+                Approver = "checker.two",
+                Decision = ResolutionAction.Rejected
+            })));
+
+        Assert.Single(results, r => r.Ok);
+        Assert.Single(results, r => !r.Ok && r.Outcome == WorkflowOutcome.AlreadyDecided);
+
+        var snapshot = await context.Store.ReadAsync();
+        Assert.True(snapshot.ChainVerified);
+        Assert.Equal(2, snapshot.Entries.Count);
+
+        var decisions = snapshot.Entries.Where(e => e.Action != ResolutionAction.Proposed).ToList();
+        var durable = Assert.Single(decisions);
+        Assert.NotEqual(durable.Actor, durable.Proposer);
+
+        var winner = results.Single(r => r.Ok);
+        Assert.Equal(winner.EntryHash, durable.EntryHash);
+        Assert.Equal(winner.Checker, durable.Actor);
+    }
+
+    [Fact]
+    public async Task ManyConcurrentRetries_AppendAtMostOneDecision()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        var attempts = Enumerable.Range(0, 8).Select(i => Task.Run(() =>
+            NewWorkflow(context).DecideAsync(new DecideCommand
+            {
+                RequestId = "REQ-1",
+                Approver = i % 2 == 0 ? "checker.one" : "checker.two",
+                Decision = i % 3 == 0 ? ResolutionAction.Rejected : ResolutionAction.Approved
+            })));
+
+        await Task.WhenAll(attempts);
+
+        var snapshot = await context.Store.ReadAsync();
+        Assert.True(snapshot.ChainVerified);
+        Assert.Single(snapshot.Entries, e => e.Action != ResolutionAction.Proposed);
+    }
+
+    [Fact]
+    public async Task DecidingAnUnknownRequest_IsRefused()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.InitializeAsync();
+
+        var decision = await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-does-not-exist",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.False(decision.Ok);
+        Assert.Equal(WorkflowOutcome.UnknownRequest, decision.Outcome);
+        Assert.Empty((await context.Store.ReadAsync()).Entries);
+    }
+
+    [Fact]
+    public async Task Trail_IsAppendOnlyAndNeverRewritesEarlierBytes()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+        var afterProposal = context.TrailText;
+
+        await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-1",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        var afterDecision = context.TrailText;
+
+        Assert.StartsWith(afterProposal, afterDecision, StringComparison.Ordinal);
+        Assert.True(afterDecision.Length > afterProposal.Length);
+    }
+
+    [Fact]
+    public async Task TrailStoresRedactedReasonAndEvidenceOnly()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+
+        AuditTestContext.AssertNoSensitiveData(context.TrailText);
+
+        var entry = (await context.Store.ReadAsync()).Entries[0];
+        Assert.Contains(SensitiveTextRedactor.IdentifierMask, entry.ReasonRedacted, StringComparison.Ordinal);
+        Assert.Equal(64, entry.ReasonHash.Length);
+        Assert.Equal(64, entry.EvidenceHash.Length);
+    }
+
+    [Fact]
+    public async Task EditingTheTrailBreaksTheHashChain()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal());
+        await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-1",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.True((await context.Store.ReadAsync()).ChainVerified);
+
+        var lines = await File.ReadAllLinesAsync(context.Store.TrailPath);
+        lines[0] = lines[0].Replace("\"actor\":\"analyst.maker\"", "\"actor\":\"someone.else\"", StringComparison.Ordinal);
+        await File.WriteAllLinesAsync(context.Store.TrailPath, lines);
+
+        var tampered = await context.Store.ReadAsync();
+        Assert.False(tampered.ChainVerified);
+
+        var export = AuditExportBuilder.Build(tampered, AuditTestContext.BusinessDate, AuditTestContext.BusinessDate);
+        Assert.False(export.ChainVerified);
+    }
+
+    [Fact]
+    public async Task Export_ProvesOneFinalDecisionByADistinctChecker()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal("REQ-A"));
+        await context.Workflow.ProposeAsync(context.Proposal("REQ-B", proposer: "second.maker"));
+        await context.Workflow.DecideAsync(new DecideCommand
+        {
+            RequestId = "REQ-A",
+            Approver = "compliance.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        var export = await context.Workflow.ExportAsync(
+            AuditTestContext.BusinessDate,
+            AuditTestContext.BusinessDate);
+
+        Assert.True(export.ChainVerified);
+        Assert.Equal(3, export.EntryCount);
+        Assert.Equal(2, export.RequestCount);
+
+        var approved = export.Requests.Single(r => r.RequestId == "REQ-A");
+        Assert.Equal("Approved", approved.Status);
+        Assert.Equal(1, approved.DecisionCount);
+        Assert.Equal("compliance.checker", approved.FinalDecidedBy);
+        Assert.True(approved.CheckerDistinctFromProposer);
+        Assert.False(approved.SelfApproved);
+
+        var pending = export.Requests.Single(r => r.RequestId == "REQ-B");
+        Assert.Equal("Pending", pending.Status);
+        Assert.Equal(0, pending.DecisionCount);
+        Assert.Null(pending.FinalDecidedBy);
+
+        AuditTestContext.AssertNoSensitiveData(AuditJson.Serialize(export));
+    }
+
+    [Fact]
+    public async Task Export_OnlyCoversTheRequestedBusinessDateRange()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.ProposeAsync(context.Proposal("REQ-IN"));
+        await context.Workflow.ProposeAsync(new ProposeCommand
+        {
+            RequestId = "REQ-OUT",
+            Proposer = "analyst.maker",
+            BusinessDate = new DateOnly(2024, 7, 1),
+            Reason = "Outside the exported range.",
+            Evidence = "Ticket OPS-9000."
+        });
+
+        var export = await context.Workflow.ExportAsync(new DateOnly(2024, 6, 1), new DateOnly(2024, 6, 30));
+
+        Assert.Equal(1, export.RequestCount);
+        Assert.Equal("REQ-IN", export.Requests[0].RequestId);
+        Assert.All(export.Entries, e => Assert.Equal("2024-06-03", e.BusinessDate));
+    }
+
+    [Fact]
+    public async Task Export_RejectsAnInvertedRange()
+    {
+        using var context = AuditTestContext.Create();
+        await context.Workflow.InitializeAsync();
+
+        await Assert.ThrowsAsync<ArgumentException>(() =>
+            context.Workflow.ExportAsync(new DateOnly(2024, 6, 30), new DateOnly(2024, 6, 1)));
+    }
+
+    [Fact]
+    public async Task InitializeIsIdempotentAndCreatesTheTrail()
+    {
+        using var context = AuditTestContext.Create();
+
+        var first = await context.Workflow.InitializeAsync();
+        var second = await context.Workflow.InitializeAsync();
+
+        Assert.True(first.Ok);
+        Assert.True(second.Ok);
+        Assert.True(File.Exists(context.Store.TrailPath));
+        Assert.True(File.Exists(Path.Combine(context.StateDirectory, FileAuditTrailStore.MarkerFileName)));
+        Assert.Empty((await context.Store.ReadAsync()).Entries);
+    }
+
+    private static ResolutionWorkflowService NewWorkflow(AuditTestContext context)
+        => new(new FileAuditTrailStore(new FileAuditTrailStoreOptions { StateDirectory = context.StateDirectory }));
+}
