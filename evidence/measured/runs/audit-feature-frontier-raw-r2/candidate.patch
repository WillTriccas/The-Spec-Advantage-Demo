+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Tamper-evidence primitives for the audit trail. Every entry is hashed over its canonical
+/// form together with the previous entry's hash, so any edit, reorder or deletion inside the
+/// append-only file is detectable by recomputing the chain.
+/// </summary>
+public static class AuditHashing
+{
+    /// <summary>Previous-hash value used by the first entry in a trail.</summary>
+    public static readonly string GenesisHash = new('0', 64);
+
+    /// <summary>Lower-case hexadecimal SHA-256 digest of <paramref name="value"/>.</summary>
+    public static string Sha256Hex(string value)
+    {
+        ArgumentNullException.ThrowIfNull(value);
+        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(value));
+        return Convert.ToHexString(bytes).ToLowerInvariant();
+    }
+
+    /// <summary>
+    /// Canonical, culture-independent projection of an entry used as hash input. Field order is
+    /// fixed and every field is delimited so no two distinct entries can collide.
+    /// </summary>
+    public static string CanonicalForm(AuditEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+
+        return string.Join('\u001f',
+            entry.PreviousHash,
+            entry.Sequence.ToString(CultureInfo.InvariantCulture),
+            entry.Version.ToString(CultureInfo.InvariantCulture),
+            entry.RequestId,
+            entry.Action.ToString(),
+            entry.Actor,
+            entry.ActorRole.ToString(),
+            entry.Proposer,
+            entry.Checker ?? string.Empty,
+            entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            entry.Timestamp.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture),
+            entry.ReasonHash,
+            entry.EvidenceHash,
+            entry.ReasonRedacted,
+            entry.EvidenceRedacted);
+    }
+
+    /// <summary>Returns <paramref name="entry"/> with <c>EntryHash</c> recomputed.</summary>
+    public static AuditEntry WithComputedHash(AuditEntry entry)
+        => entry with { EntryHash = Sha256Hex(CanonicalForm(entry)) };
+
+    /// <summary>True when the entry's stored hash matches its canonical form.</summary>
+    public static bool HasValidHash(AuditEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+        return string.Equals(entry.EntryHash, Sha256Hex(CanonicalForm(entry)), StringComparison.Ordinal);
+    }
+}
