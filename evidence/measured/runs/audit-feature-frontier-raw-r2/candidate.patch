@@ -0,0 +1,273 @@
+using System.Text.Json;
+using TradeRecon.Application.Audit;
+using Xunit;
+using AuditProgram = TradeRecon.AuditConsole.Program;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Black-box contract of the audit command-line host: one JSON document on stdout, documented
+/// exit codes, a durable export file, and no sensitive data anywhere in its output.
+/// </summary>
+public class AuditCliTests
+{
+    [Fact]
+    public async Task FullLifecycle_ProposeDecideExport_IsRecordedAndExplainable()
+    {
+        using var context = AuditTestContext.Create();
+        var exportPath = Path.Combine(context.Root, "export", "history.json");
+
+        var initialize = await RunAsync("initialize", "--state", context.StateDirectory);
+        Assert.Equal(AuditProgram.ExitOk, initialize.ExitCode);
+        Assert.Equal("initialized", Outcome(initialize.Stdout));
+
+        var propose = await RunAsync(
+            "propose",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--proposer", "analyst.maker",
+            "--business-date", "2024-06-03",
+            "--reason", AuditTestContext.SensitiveReason,
+            "--evidence", AuditTestContext.SensitiveEvidence);
+
+        Assert.Equal(AuditProgram.ExitOk, propose.ExitCode);
+        Assert.Equal("proposed", Outcome(propose.Stdout));
+
+        var decide = await RunAsync(
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--approver", "compliance.checker",
+            "--decision", "approve");
+
+        Assert.Equal(AuditProgram.ExitOk, decide.ExitCode);
+        Assert.Equal("approved", Outcome(decide.Stdout));
+
+        var export = await RunAsync(
+            "export",
+            "--state", context.StateDirectory,
+            "--from", "2024-06-01",
+            "--to", "2024-06-30",
+            "--output", exportPath);
+
+        Assert.Equal(AuditProgram.ExitOk, export.ExitCode);
+        Assert.True(File.Exists(exportPath));
+
+        var document = AuditJson.Deserialize<AuditExportDocument>(await File.ReadAllTextAsync(exportPath));
+        Assert.NotNull(document);
+        Assert.True(document!.ChainVerified);
+        Assert.Equal(2, document.EntryCount);
+
+        var request = Assert.Single(document.Requests);
+        Assert.Equal("Approved", request.Status);
+        Assert.Equal("analyst.maker", request.Proposer);
+        Assert.Equal("compliance.checker", request.FinalDecidedBy);
+        Assert.Equal(1, request.DecisionCount);
+        Assert.True(request.CheckerDistinctFromProposer);
+
+        // The exported entries carry identity, action, actor and ordering/tamper metadata.
+        foreach (var entry in document.Entries)
+        {
+            Assert.Equal("REQ-1", entry.RequestId);
+            Assert.False(string.IsNullOrWhiteSpace(entry.Action));
+            Assert.False(string.IsNullOrWhiteSpace(entry.Actor));
+            Assert.False(string.IsNullOrWhiteSpace(entry.Timestamp));
+            Assert.Equal(64, entry.EntryHash.Length);
+            Assert.True(entry.Sequence > 0);
+            Assert.True(entry.Version > 0);
+        }
+
+        foreach (var output in new[] { propose.Stdout, propose.Stderr, decide.Stdout, export.Stdout, export.Stderr })
+        {
+            AuditTestContext.AssertNoSensitiveData(output);
+        }
+
+        AuditTestContext.AssertNoSensitiveData(await File.ReadAllTextAsync(exportPath));
+    }
+
+    [Fact]
+    public async Task SelfApproval_IsRefusedWithTheDocumentedExitCode()
+    {
+        using var context = AuditTestContext.Create();
+        await ProposeAsync(context);
+
+        var decide = await RunAsync(
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--approver", "analyst.maker",
+            "--decision", "approve");
+
+        Assert.Equal(AuditProgram.ExitRefused, decide.ExitCode);
+        Assert.Equal("self-approval-rejected", Outcome(decide.Stdout));
+
+        var exportPath = Path.Combine(context.Root, "history.json");
+        var export = await RunAsync(
+            "export",
+            "--state", context.StateDirectory,
+            "--from", "2024-06-03",
+            "--to", "2024-06-03",
+            "--output", exportPath);
+
+        var document = AuditJson.Deserialize<AuditExportDocument>(export.Stdout);
+        Assert.NotNull(document);
+        Assert.Equal(1, document!.EntryCount);
+        Assert.Equal("Pending", document.Requests[0].Status);
+        Assert.False(document.Requests[0].SelfApproved);
+    }
+
+    [Fact]
+    public async Task RetriedCommands_AreIdempotent()
+    {
+        using var context = AuditTestContext.Create();
+
+        var first = await ProposeAsync(context);
+        var again = await ProposeAsync(context);
+
+        Assert.Equal(AuditProgram.ExitOk, first.ExitCode);
+        Assert.Equal(AuditProgram.ExitOk, again.ExitCode);
+        Assert.Equal("proposal-replayed", Outcome(again.Stdout));
+
+        var decideArgs = new[]
+        {
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--approver", "compliance.checker",
+            "--decision", "reject"
+        };
+
+        var decided = await RunAsync(decideArgs);
+        var redecided = await RunAsync(decideArgs);
+
+        Assert.Equal(AuditProgram.ExitOk, decided.ExitCode);
+        Assert.Equal("rejected", Outcome(decided.Stdout));
+        Assert.Equal(AuditProgram.ExitOk, redecided.ExitCode);
+        Assert.Equal("decision-replayed", Outcome(redecided.Stdout));
+
+        var export = await RunAsync(
+            "export",
+            "--state", context.StateDirectory,
+            "--from", "2024-06-03",
+            "--to", "2024-06-03",
+            "--output", Path.Combine(context.Root, "history.json"));
+
+        var document = AuditJson.Deserialize<AuditExportDocument>(export.Stdout);
+        Assert.Equal(2, document!.EntryCount);
+        Assert.Equal(1, document.Requests[0].DecisionCount);
+    }
+
+    [Fact]
+    public async Task ConflictingDecision_IsRefusedAfterTheFirstOne()
+    {
+        using var context = AuditTestContext.Create();
+        await ProposeAsync(context);
+
+        var accepted = await RunAsync(
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--approver", "checker.one",
+            "--decision", "approve");
+
+        var refused = await RunAsync(
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-1",
+            "--approver", "checker.two",
+            "--decision", "reject");
+
+        Assert.Equal(AuditProgram.ExitOk, accepted.ExitCode);
+        Assert.Equal(AuditProgram.ExitRefused, refused.ExitCode);
+        Assert.Equal("already-decided", Outcome(refused.Stdout));
+    }
+
+    [Theory]
+    [InlineData("unknown-request", "REQ-missing", "compliance.checker", "approve")]
+    [InlineData("invalid-decision", "REQ-1", "compliance.checker", "maybe")]
+    public async Task RefusedDecisions_ReportAStableOutcomeCode(
+        string expectedOutcome,
+        string requestId,
+        string approver,
+        string decision)
+    {
+        using var context = AuditTestContext.Create();
+        await ProposeAsync(context);
+
+        var result = await RunAsync(
+            "decide",
+            "--state", context.StateDirectory,
+            "--request-id", requestId,
+            "--approver", approver,
+            "--decision", decision);
+
+        Assert.Equal(AuditProgram.ExitRefused, result.ExitCode);
+        Assert.Equal(expectedOutcome, Outcome(result.Stdout));
+    }
+
+    [Theory]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    [InlineData("initialize")]
+    public async Task MissingRequiredOptions_ReturnTheDocumentedErrorCode(string verb)
+    {
+        var result = await RunAsync(verb);
+
+        Assert.Equal(AuditProgram.ExitError, result.ExitCode);
+        Assert.Equal("invalid-arguments", Outcome(result.Stdout));
+    }
+
+    [Fact]
+    public async Task UnknownCommand_ReturnsTheDocumentedErrorCode()
+    {
+        using var context = AuditTestContext.Create();
+
+        var result = await RunAsync("frobnicate", "--state", context.StateDirectory);
+
+        Assert.Equal(AuditProgram.ExitError, result.ExitCode);
+    }
+
+    [Fact]
+    public async Task ProposalReasonMayStartWithADash()
+    {
+        using var context = AuditTestContext.Create();
+
+        var result = await RunAsync(
+            "propose",
+            "--state", context.StateDirectory,
+            "--request-id", "REQ-DASH",
+            "--proposer", "analyst.maker",
+            "--business-date", "2024-06-03",
+            "--reason", "--custodian confirmed the timing difference",
+            "--evidence", "Ticket OPS-1");
+
+        Assert.Equal(AuditProgram.ExitOk, result.ExitCode);
+        Assert.Equal("proposed", Outcome(result.Stdout));
+    }
+
+    private static Task<CliRun> ProposeAsync(AuditTestContext context) => RunAsync(
+        "propose",
+        "--state", context.StateDirectory,
+        "--request-id", "REQ-1",
+        "--proposer", "analyst.maker",
+        "--business-date", "2024-06-03",
+        "--reason", AuditTestContext.SensitiveReason,
+        "--evidence", AuditTestContext.SensitiveEvidence);
+
+    private static async Task<CliRun> RunAsync(params string[] args)
+    {
+        var stdout = new StringWriter();
+        var stderr = new StringWriter();
+        var exitCode = await AuditProgram.RunAsync(args, stdout, stderr);
+        return new CliRun(exitCode, stdout.ToString(), stderr.ToString());
+    }
+
+    private static string Outcome(string stdout)
+    {
+        using var document = JsonDocument.Parse(stdout);
+        return document.RootElement.GetProperty("result").GetProperty("outcome").GetString() ?? string.Empty;
+    }
+
+    private sealed record CliRun(int ExitCode, string Stdout, string Stderr);
+}
