+++ b/tests/TradeRecon.Tests/AuditTestContext.cs
@@ -0,0 +1,87 @@
+using TradeRecon.Application.Audit;
+using TradeRecon.Infrastructure.Audit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Shared scaffolding for the audit tests: a throwaway state directory plus the sensitive
+/// sample text used to prove that nothing leaks into durable state or output.
+/// </summary>
+internal sealed class AuditTestContext : IDisposable
+{
+    private AuditTestContext(string root)
+    {
+        Root = root;
+        StateDirectory = Path.Combine(root, "state");
+        Store = new FileAuditTrailStore(new FileAuditTrailStoreOptions { StateDirectory = StateDirectory });
+        Workflow = new ResolutionWorkflowService(Store);
+    }
+
+    /// <summary>An account identifier that must never reach the trail, output or export.</summary>
+    public const string SensitiveAccount = "ACC002";
+
+    /// <summary>An instrument identifier from the break register.</summary>
+    public const string SensitiveInstrument = "DE0005140008";
+
+    /// <summary>A trade amount that must never reach the trail, output or export.</summary>
+    public const string SensitiveAmount = "1600500.00";
+
+    /// <summary>Operator text deliberately full of sensitive values.</summary>
+    public const string SensitiveReason =
+        "Custodian timing difference on account ACC002 instrument DE0005140008 for 1600500.00 EUR.";
+
+    /// <summary>Evidence reference that also embeds sensitive values.</summary>
+    public const string SensitiveEvidence =
+        "Ticket OPS-4471; custodian statement shows 1,600,500.00 EUR settled for ACC002.";
+
+    public string Root { get; }
+
+    public string StateDirectory { get; }
+
+    public FileAuditTrailStore Store { get; }
+
+    public ResolutionWorkflowService Workflow { get; }
+
+    public string TrailText => File.Exists(Store.TrailPath) ? File.ReadAllText(Store.TrailPath) : string.Empty;
+
+    public static AuditTestContext Create()
+        => new(Directory.CreateDirectory(
+            Path.Combine(Path.GetTempPath(), $"trade-recon-audit-{Guid.NewGuid():N}")).FullName);
+
+    public static DateOnly BusinessDate => new(2024, 6, 3);
+
+    public ProposeCommand Proposal(
+        string requestId = "REQ-1",
+        string proposer = "analyst.maker",
+        string? reason = null,
+        string? evidence = null)
+        => new()
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = BusinessDate,
+            Reason = reason ?? SensitiveReason,
+            Evidence = evidence ?? SensitiveEvidence
+        };
+
+    /// <summary>Asserts that no sensitive token from the sample text appears in <paramref name="text"/>.</summary>
+    public static void AssertNoSensitiveData(string text)
+    {
+        Xunit.Assert.DoesNotContain(SensitiveAccount, text, StringComparison.OrdinalIgnoreCase);
+        Xunit.Assert.DoesNotContain(SensitiveInstrument, text, StringComparison.OrdinalIgnoreCase);
+        Xunit.Assert.DoesNotContain("1600500", text, StringComparison.Ordinal);
+        Xunit.Assert.DoesNotContain("1,600,500", text, StringComparison.Ordinal);
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            Directory.Delete(Root, recursive: true);
+        }
+        catch (IOException)
+        {
+            // A throwaway directory that cannot be removed must not fail the test run.
+        }
+    }
+}
