+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Serialisation settings shared by every audit command's stdout document and by the Compliance
+/// export file, so a harness sees one consistent JSON shape.
+/// </summary>
+public static class AuditJson
+{
+    private static readonly JsonSerializerOptions Options = new()
+    {
+        WriteIndented = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        DefaultIgnoreCondition = JsonIgnoreCondition.Never,
+        Converters = { new JsonStringEnumConverter() }
+    };
+
+    /// <summary>Renders <paramref name="value"/> as indented, camelCase JSON.</summary>
+    public static string Serialize<T>(T value) => JsonSerializer.Serialize(value, Options);
+
+    /// <summary>Parses JSON produced by <see cref="Serialize{T}"/>.</summary>
+    public static T? Deserialize<T>(string json) => JsonSerializer.Deserialize<T>(json, Options);
+}
diff --git a/src/TradeRecon.Application/Audit/AuditTrailSnapshot.cs b/src/TradeRecon.Application/Audit/AuditTrailSnapshot.cs
new file mode 100644
index 0000000..ba2ed61
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditTrailSnapshot.cs
@@ -0,0 +1,67 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// An immutable, hash-verified view of the whole audit trail as read from durable storage.
+/// </summary>
+public sealed class AuditTrailSnapshot
+{
+    private AuditTrailSnapshot(IReadOnlyList<AuditEntry> entries, bool chainVerified, string headHash)
+    {
+        Entries = entries;
+        ChainVerified = chainVerified;
+        HeadHash = headHash;
+    }
+
+    /// <summary>Entries in durable append order.</summary>
+    public IReadOnlyList<AuditEntry> Entries { get; }
+
+    /// <summary>False when a hash, link or sequence number does not reconcile.</summary>
+    public bool ChainVerified { get; }
+
+    /// <summary>Hash of the last entry, or the genesis hash for an empty trail.</summary>
+    public string HeadHash { get; }
+
+    /// <summary>Sequence number the next appended entry must take.</summary>
+    public long NextSequence => Entries.Count == 0 ? 1 : Entries[^1].Sequence + 1;
+
+    /// <summary>Builds a snapshot, recomputing the hash chain to detect tampering.</summary>
+    public static AuditTrailSnapshot Create(IReadOnlyList<AuditEntry> entries)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+
+        var verified = true;
+        var previous = AuditHashing.GenesisHash;
+        var expectedSequence = 1L;
+
+        foreach (var entry in entries)
+        {
+            if (entry.Sequence != expectedSequence
+                || !string.Equals(entry.PreviousHash, previous, StringComparison.Ordinal)
+                || !AuditHashing.HasValidHash(entry))
+            {
+                verified = false;
+            }
+
+            previous = entry.EntryHash;
+            expectedSequence++;
+        }
+
+        return new AuditTrailSnapshot(entries, verified, previous);
+    }
+
+    /// <summary>All entries for a request, in append order.</summary>
+    public IReadOnlyList<AuditEntry> EntriesFor(string requestId)
+        => Entries.Where(e => ResolutionIdentity.SameRequest(e.RequestId, requestId)).ToList();
+
+    /// <summary>The proposal entry for a request, or <c>null</c> when it was never proposed.</summary>
+    public AuditEntry? ProposalFor(string requestId)
+        => Entries.FirstOrDefault(e =>
+            e.Action == ResolutionAction.Proposed && ResolutionIdentity.SameRequest(e.RequestId, requestId));
+
+    /// <summary>The single durable final decision for a request, or <c>null</c> when still pending.</summary>
+    public AuditEntry? DecisionFor(string requestId)
+        => Entries.FirstOrDefault(e =>
+            e.Action != ResolutionAction.Proposed && ResolutionIdentity.SameRequest(e.RequestId, requestId));
+}
diff --git a/src/TradeRecon.Application/Audit/ResolutionIdentity.cs b/src/TradeRecon.Application/Audit/ResolutionIdentity.cs
new file mode 100644
index 0000000..d7eadbc
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/ResolutionIdentity.cs
@@ -0,0 +1,21 @@
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Comparison rules for the identities the workflow recognises. Request ids and person ids are
+/// compared case-insensitively after trimming so that a retry sent as <c>"Alice"</c> cannot be
+/// mistaken for a second, distinct person <c>"alice "</c> — which would otherwise defeat both
+/// idempotency and the self-approval guard.
+/// </summary>
+public static class ResolutionIdentity
+{
+    /// <summary>Canonical form of a supplied identity or request id.</summary>
+    public static string Normalize(string? value) => (value ?? string.Empty).Trim();
+
+    /// <summary>True when both values name the same request.</summary>
+    public static bool SameRequest(string? left, string? right)
+        => string.Equals(Normalize(left), Normalize(right), StringComparison.OrdinalIgnoreCase);
+
+    /// <summary>True when both values name the same person.</summary>
+    public static bool SamePerson(string? left, string? right)
+        => string.Equals(Normalize(left), Normalize(right), StringComparison.OrdinalIgnoreCase);
+}
diff --git a/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs b/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs
new file mode 100644
index 0000000..b184c25
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/ResolutionWorkflowService.cs
@@ -0,0 +1,391 @@
+using System.Globalization;
+using TradeRecon.Application.Abstractions;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// The maker-checker resolution workflow.
+///
+/// Guarantees, each enforced inside the store's exclusive transaction so they hold across
+/// concurrent processes:
+///
+/// 1. <b>Segregation of duties.</b> A decision by the proposer is refused and leaves no durable
+///    entry, so an approved or rejected request always shows a checker distinct from its maker.
+/// 2. <b>Idempotent retries.</b> Re-sending the same proposal, or the same decision from the same
+///    checker, returns the original outcome and appends nothing.
+/// 3. <b>Exactly one final decision.</b> The first decision to win the lock is durable; a
+///    conflicting concurrent decision is refused and reports the decision that won.
+/// 4. <b>No sensitive leakage.</b> Reason and evidence are redacted and hashed before they reach
+///    the trail, so account identifiers and trade amounts never enter durable state or output.
+/// </summary>
+public sealed class ResolutionWorkflowService
+{
+    private readonly IAuditTrailStore _store;
+    private readonly TimeProvider _clock;
+
+    public ResolutionWorkflowService(IAuditTrailStore store, TimeProvider? clock = null)
+    {
+        _store = store ?? throw new ArgumentNullException(nameof(store));
+        _clock = clock ?? TimeProvider.System;
+    }
+
+    /// <summary>Creates the durable trail if needed.</summary>
+    public async Task<WorkflowResult> InitializeAsync(CancellationToken cancellationToken = default)
+    {
+        await _store.InitializeAsync(cancellationToken).ConfigureAwait(false);
+        var snapshot = await _store.ReadAsync(cancellationToken).ConfigureAwait(false);
+
+        return new WorkflowResult
+        {
+            Ok = true,
+            Outcome = WorkflowOutcome.Initialized,
+            RequestId = null,
+            Status = null,
+            IdempotentReplay = snapshot.Entries.Count > 0,
+            EntryCount = snapshot.Entries.Count,
+            HeadHash = snapshot.HeadHash,
+            Message = "Audit trail ready."
+        };
+    }
+
+    /// <summary>Records an analyst's proposed resolution, or replays an identical retry.</summary>
+    public Task<WorkflowResult> ProposeAsync(ProposeCommand command, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        var requestId = ResolutionIdentity.Normalize(command.RequestId);
+        var proposer = ResolutionIdentity.Normalize(command.Proposer);
+        var reasonHash = AuditHashing.Sha256Hex(command.Reason ?? string.Empty);
+        var evidenceHash = AuditHashing.Sha256Hex(command.Evidence ?? string.Empty);
+        var reasonRedacted = SensitiveTextRedactor.Redact(command.Reason);
+        var evidenceRedacted = SensitiveTextRedactor.Redact(command.Evidence);
+
+        return _store.ExecuteAsync<WorkflowResult>(snapshot =>
+        {
+            var existing = snapshot.ProposalFor(requestId);
+            if (existing is not null)
+            {
+                var identical = ResolutionIdentity.SamePerson(existing.Proposer, proposer)
+                    && existing.BusinessDate == command.BusinessDate
+                    && string.Equals(existing.ReasonHash, reasonHash, StringComparison.Ordinal)
+                    && string.Equals(existing.EvidenceHash, evidenceHash, StringComparison.Ordinal);
+
+                if (!identical)
+                {
+                    return new AuditTransaction<WorkflowResult>(null, Failure(
+                        WorkflowOutcome.ProposalConflict,
+                        requestId,
+                        snapshot,
+                        "A different proposal already exists for this request id."));
+                }
+
+                return new AuditTransaction<WorkflowResult>(null, Success(
+                    WorkflowOutcome.ProposalReplayed,
+                    requestId,
+                    snapshot,
+                    existing,
+                    idempotentReplay: true,
+                    "Identical proposal already recorded; nothing appended."));
+            }
+
+            var entry = AuditHashing.WithComputedHash(new AuditEntry
+            {
+                Sequence = snapshot.NextSequence,
+                Version = 1,
+                RequestId = requestId,
+                Action = ResolutionAction.Proposed,
+                Actor = proposer,
+                ActorRole = ActorRole.Proposer,
+                Proposer = proposer,
+                Checker = null,
+                BusinessDate = command.BusinessDate,
+                Timestamp = _clock.GetUtcNow(),
+                ReasonRedacted = reasonRedacted,
+                ReasonHash = reasonHash,
+                EvidenceRedacted = evidenceRedacted,
+                EvidenceHash = evidenceHash,
+                PreviousHash = snapshot.HeadHash,
+                EntryHash = string.Empty
+            });
+
+            return new AuditTransaction<WorkflowResult>(entry, new WorkflowResult
+            {
+                Ok = true,
+                Outcome = WorkflowOutcome.Proposed,
+                RequestId = requestId,
+                Status = ResolutionStatus.Pending,
+                Proposer = proposer,
+                Checker = null,
+                BusinessDate = command.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+                Sequence = entry.Sequence,
+                Version = entry.Version,
+                EntryHash = entry.EntryHash,
+                IdempotentReplay = false,
+                EntryCount = snapshot.Entries.Count + 1,
+                HeadHash = entry.EntryHash,
+                Message = "Resolution proposed and awaiting a checker."
+            });
+        }, cancellationToken);
+    }
+
+    /// <summary>Records a checker's approval or rejection, enforcing segregation of duties.</summary>
+    public Task<WorkflowResult> DecideAsync(DecideCommand command, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        var requestId = ResolutionIdentity.Normalize(command.RequestId);
+        var approver = ResolutionIdentity.Normalize(command.Approver);
+
+        return _store.ExecuteAsync<WorkflowResult>(snapshot =>
+        {
+            var proposal = snapshot.ProposalFor(requestId);
+            if (proposal is null)
+            {
+                return new AuditTransaction<WorkflowResult>(null, Failure(
+                    WorkflowOutcome.UnknownRequest,
+                    requestId,
+                    snapshot,
+                    "No proposal exists for this request id."));
+            }
+
+            if (ResolutionIdentity.SamePerson(proposal.Proposer, approver))
+            {
+                return new AuditTransaction<WorkflowResult>(null, Failure(
+                    WorkflowOutcome.SelfApprovalRejected,
+                    requestId,
+                    snapshot,
+                    "The proposer cannot decide their own request; a different checker is required.",
+                    proposal));
+            }
+
+            var decided = snapshot.DecisionFor(requestId);
+            if (decided is not null)
+            {
+                var replay = ResolutionIdentity.SamePerson(decided.Actor, approver)
+                    && decided.Action == command.Decision;
+
+                if (replay)
+                {
+                    return new AuditTransaction<WorkflowResult>(null, Success(
+                        WorkflowOutcome.DecisionReplayed,
+                        requestId,
+                        snapshot,
+                        decided,
+                        idempotentReplay: true,
+                        "Identical decision already recorded; nothing appended."));
+                }
+
+                return new AuditTransaction<WorkflowResult>(null, Failure(
+                    WorkflowOutcome.AlreadyDecided,
+                    requestId,
+                    snapshot,
+                    "The request already has a final decision; it cannot be decided again.",
+                    proposal,
+                    decided));
+            }
+
+            var entry = AuditHashing.WithComputedHash(new AuditEntry
+            {
+                Sequence = snapshot.NextSequence,
+                Version = proposal.Version + 1,
+                RequestId = requestId,
+                Action = command.Decision,
+                Actor = approver,
+                ActorRole = ActorRole.Checker,
+                Proposer = proposal.Proposer,
+                Checker = approver,
+                BusinessDate = proposal.BusinessDate,
+                Timestamp = _clock.GetUtcNow(),
+                ReasonRedacted = proposal.ReasonRedacted,
+                ReasonHash = proposal.ReasonHash,
+                EvidenceRedacted = proposal.EvidenceRedacted,
+                EvidenceHash = proposal.EvidenceHash,
+                PreviousHash = snapshot.HeadHash,
+                EntryHash = string.Empty
+            });
+
+            return new AuditTransaction<WorkflowResult>(entry, new WorkflowResult
+            {
+                Ok = true,
+                Outcome = command.Decision == ResolutionAction.Approved
+                    ? WorkflowOutcome.Approved
+                    : WorkflowOutcome.Rejected,
+                RequestId = requestId,
+                Status = StatusOf(command.Decision),
+                Proposer = proposal.Proposer,
+                Checker = approver,
+                BusinessDate = proposal.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+                Sequence = entry.Sequence,
+                Version = entry.Version,
+                EntryHash = entry.EntryHash,
+                IdempotentReplay = false,
+                EntryCount = snapshot.Entries.Count + 1,
+                HeadHash = entry.EntryHash,
+                Message = "Final decision recorded by a checker distinct from the proposer."
+            });
+        }, cancellationToken);
+    }
+
+    /// <summary>Projects the append-only history for a business-date range.</summary>
+    public async Task<AuditExportDocument> ExportAsync(
+        DateOnly fromDate,
+        DateOnly toDate,
+        CancellationToken cancellationToken = default)
+    {
+        if (toDate < fromDate)
+        {
+            throw new ArgumentException("The export range end date precedes its start date.", nameof(toDate));
+        }
+
+        var snapshot = await _store.ReadAsync(cancellationToken).ConfigureAwait(false);
+        return AuditExportBuilder.Build(snapshot, fromDate, toDate);
+    }
+
+    private static ResolutionStatus StatusOf(ResolutionAction action) => action switch
+    {
+        ResolutionAction.Approved => ResolutionStatus.Approved,
+        ResolutionAction.Rejected => ResolutionStatus.Rejected,
+        _ => ResolutionStatus.Pending
+    };
+
+    private static WorkflowResult Success(
+        string outcome,
+        string requestId,
+        AuditTrailSnapshot snapshot,
+        AuditEntry entry,
+        bool idempotentReplay,
+        string message)
+    {
+        var decision = snapshot.DecisionFor(requestId);
+
+        return new WorkflowResult
+        {
+            Ok = true,
+            Outcome = outcome,
+            RequestId = requestId,
+            Status = decision is null ? ResolutionStatus.Pending : StatusOf(decision.Action),
+            Proposer = entry.Proposer,
+            Checker = decision?.Actor,
+            BusinessDate = entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Sequence = entry.Sequence,
+            Version = entry.Version,
+            EntryHash = entry.EntryHash,
+            IdempotentReplay = idempotentReplay,
+            EntryCount = snapshot.Entries.Count,
+            HeadHash = snapshot.HeadHash,
+            Message = message
+        };
+    }
+
+    private static WorkflowResult Failure(
+        string outcome,
+        string requestId,
+        AuditTrailSnapshot snapshot,
+        string message,
+        AuditEntry? proposal = null,
+        AuditEntry? decision = null)
+    {
+        decision ??= snapshot.DecisionFor(requestId);
+        proposal ??= snapshot.ProposalFor(requestId);
+
+        return new WorkflowResult
+        {
+            Ok = false,
+            Outcome = outcome,
+            Error = outcome,
+            RequestId = requestId,
+            Status = decision is null
+                ? (proposal is null ? null : ResolutionStatus.Pending)
+                : StatusOf(decision.Action),
+            Proposer = proposal?.Proposer,
+            Checker = decision?.Actor,
+            BusinessDate = proposal?.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Sequence = decision?.Sequence ?? proposal?.Sequence,
+            Version = decision?.Version ?? proposal?.Version,
+            EntryHash = decision?.EntryHash ?? proposal?.EntryHash,
+            IdempotentReplay = false,
+            EntryCount = snapshot.Entries.Count,
+            HeadHash = snapshot.HeadHash,
+            Message = message
+        };
+    }
+}
+
+/// <summary>An analyst's proposed resolution for a reconciliation break.</summary>
+public sealed record ProposeCommand
+{
+    public required string RequestId { get; init; }
+    public required string Proposer { get; init; }
+    public required DateOnly BusinessDate { get; init; }
+
+    /// <summary>Free-text justification. Redacted and hashed before it is persisted.</summary>
+    public required string Reason { get; init; }
+
+    /// <summary>Free-text evidence reference. Redacted and hashed before it is persisted.</summary>
+    public required string Evidence { get; init; }
+}
+
+/// <summary>A checker's decision on an existing proposal.</summary>
+public sealed record DecideCommand
+{
+    public required string RequestId { get; init; }
+    public required string Approver { get; init; }
+
+    /// <summary>Either <see cref="ResolutionAction.Approved"/> or <see cref="ResolutionAction.Rejected"/>.</summary>
+    public required ResolutionAction Decision { get; init; }
+}
+
+/// <summary>Stable outcome codes reported on stdout so a harness can assert on them.</summary>
+public static class WorkflowOutcome
+{
+    public const string Initialized = "initialized";
+    public const string Proposed = "proposed";
+    public const string ProposalReplayed = "proposal-replayed";
+    public const string ProposalConflict = "proposal-conflict";
+    public const string Approved = "approved";
+    public const string Rejected = "rejected";
+    public const string DecisionReplayed = "decision-replayed";
+    public const string AlreadyDecided = "already-decided";
+    public const string SelfApprovalRejected = "self-approval-rejected";
+    public const string UnknownRequest = "unknown-request";
+    public const string InvalidDecision = "invalid-decision";
+    public const string Exported = "exported";
+}
+
+/// <summary>Result of a workflow command, rendered verbatim as the command's JSON stdout.</summary>
+public sealed record WorkflowResult
+{
+    /// <summary>True when the command was accepted (including an idempotent replay).</summary>
+    public required bool Ok { get; init; }
+
+    /// <summary>Stable outcome code (see <see cref="WorkflowOutcome"/>).</summary>
+    public required string Outcome { get; init; }
+
+    public string? RequestId { get; init; }
+
+    /// <summary>Lifecycle state of the request after the command.</summary>
+    public ResolutionStatus? Status { get; init; }
+
+    public string? Proposer { get; init; }
+    public string? Checker { get; init; }
+    public string? BusinessDate { get; init; }
+    public long? Sequence { get; init; }
+    public int? Version { get; init; }
+    public string? EntryHash { get; init; }
+
+    /// <summary>True when a retry matched an existing entry and nothing was appended.</summary>
+    public required bool IdempotentReplay { get; init; }
+
+    /// <summary>Total entries in the trail after the command.</summary>
+    public int EntryCount { get; init; }
+
+    /// <summary>Hash of the trail head after the command.</summary>
+    public string? HeadHash { get; init; }
+
+    /// <summary>Set to the outcome code when <see cref="Ok"/> is false.</summary>
+    public string? Error { get; init; }
+
+    /// <summary>Human-readable explanation. Never contains caller-supplied text.</summary>
+    public required string Message { get; init; }
+}
diff --git a/src/TradeRecon.Application/Audit/SensitiveTextRedactor.cs b/src/TradeRecon.Application/Audit/SensitiveTextRedactor.cs
new file mode 100644
index 0000000..2c9bd13
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/SensitiveTextRedactor.cs
@@ -0,0 +1,102 @@
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Masks sensitive tokens out of operator-supplied free text before it is logged, printed or
+/// persisted.
+///
+/// The reconciliation domain treats account identifiers (and instrument identifiers, which are
+/// account-linked in the break register) and trade amounts as sensitive. A human writing a
+/// resolution reason may paste any of them, so redaction is applied structurally rather than by
+/// blocklist: any token that mixes letters and digits is treated as an identifier, and any token
+/// carrying three or more digits is treated as a monetary or quantity value. The rule is
+/// deliberately conservative — it may mask a harmless token, but it cannot let an account number
+/// or an amount through.
+/// </summary>
+public static class SensitiveTextRedactor
+{
+    /// <summary>Replacement emitted for a masked identifier-like token.</summary>
+    public const string IdentifierMask = "[REDACTED-ID]";
+
+    /// <summary>Replacement emitted for a masked numeric (amount or quantity) token.</summary>
+    public const string NumericMask = "[REDACTED-AMOUNT]";
+
+    /// <summary>Maximum length of a redacted projection; longer text is truncated.</summary>
+    public const int MaxLength = 512;
+
+    private static readonly Regex TokenPattern = new(
+        @"[A-Za-z0-9][A-Za-z0-9._,\-/]*",
+        RegexOptions.Compiled | RegexOptions.CultureInvariant);
+
+    private static readonly Regex WhitespacePattern = new(
+        @"\s+",
+        RegexOptions.Compiled | RegexOptions.CultureInvariant);
+
+    /// <summary>
+    /// Returns <paramref name="text"/> with identifier-like and amount-like tokens masked,
+    /// whitespace normalised and control characters removed.
+    /// </summary>
+    public static string Redact(string? text)
+    {
+        if (string.IsNullOrWhiteSpace(text))
+        {
+            return string.Empty;
+        }
+
+        var normalised = WhitespacePattern.Replace(StripControlCharacters(text), " ").Trim();
+        var masked = TokenPattern.Replace(normalised, static match => MaskToken(match.Value));
+
+        return masked.Length <= MaxLength
+            ? masked
+            : masked[..MaxLength] + "…";
+    }
+
+    /// <summary>True when <paramref name="text"/> would survive redaction unchanged.</summary>
+    public static bool IsFreeOfSensitiveTokens(string? text)
+        => string.Equals(Redact(text), WhitespacePattern.Replace(StripControlCharacters(text ?? string.Empty), " ").Trim(), StringComparison.Ordinal);
+
+    private static string MaskToken(string token)
+    {
+        var letters = 0;
+        var digits = 0;
+
+        foreach (var c in token)
+        {
+            if (char.IsAsciiLetter(c))
+            {
+                letters++;
+            }
+            else if (char.IsAsciiDigit(c))
+            {
+                digits++;
+            }
+        }
+
+        if (digits == 0)
+        {
+            return token;
+        }
+
+        // A token mixing letters and digits is an identifier (ACC001, GB00B03MLX29, T003).
+        if (letters > 0 && digits >= 2)
+        {
+            return IdentifierMask;
+        }
+
+        // Pure numbers of any material size are treated as amounts or quantities.
+        return digits >= 3 ? NumericMask : token;
+    }
+
+    private static string StripControlCharacters(string text)
+    {
+        var sb = new StringBuilder(text.Length);
+        foreach (var c in text)
+        {
+            sb.Append(char.IsControl(c) ? ' ' : c);
+        }
+
+        return sb.ToString();
+    }
+}
