@@ -0,0 +1,109 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Converts audit entries to and from the single-line JSON form used by the append-only trail
+/// file. Line-delimited JSON keeps the store genuinely append-only: writing a new entry never
+/// rewrites an existing byte.
+/// </summary>
+public static class AuditEntrySerializer
+{
+    private static readonly JsonSerializerOptions Options = new()
+    {
+        WriteIndented = false,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        DefaultIgnoreCondition = JsonIgnoreCondition.Never
+    };
+
+    /// <summary>Serialises <paramref name="entry"/> as one JSON line (no trailing newline).</summary>
+    public static string Serialize(AuditEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+        return JsonSerializer.Serialize(ToDocument(entry), Options);
+    }
+
+    /// <summary>Parses one JSON line back into an entry.</summary>
+    public static AuditEntry Deserialize(string line)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(line);
+
+        var document = JsonSerializer.Deserialize<AuditEntryDocument>(line, Options)
+            ?? throw new FormatException("Audit trail line is not a JSON object.");
+
+        return FromDocument(document);
+    }
+
+    /// <summary>Wire projection of an entry. Dates and instants are invariant strings.</summary>
+    public static AuditEntryDocument ToDocument(AuditEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+
+        return new AuditEntryDocument
+        {
+            Sequence = entry.Sequence,
+            Version = entry.Version,
+            RequestId = entry.RequestId,
+            Action = entry.Action.ToString(),
+            Actor = entry.Actor,
+            ActorRole = entry.ActorRole.ToString(),
+            Proposer = entry.Proposer,
+            Checker = entry.Checker,
+            BusinessDate = entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Timestamp = entry.Timestamp.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture),
+            ReasonRedacted = entry.ReasonRedacted,
+            ReasonHash = entry.ReasonHash,
+            EvidenceRedacted = entry.EvidenceRedacted,
+            EvidenceHash = entry.EvidenceHash,
+            PreviousHash = entry.PreviousHash,
+            EntryHash = entry.EntryHash
+        };
+    }
+
+    private static AuditEntry FromDocument(AuditEntryDocument document)
+    {
+        return new AuditEntry
+        {
+            Sequence = document.Sequence,
+            Version = document.Version,
+            RequestId = document.RequestId,
+            Action = Enum.Parse<ResolutionAction>(document.Action, ignoreCase: false),
+            Actor = document.Actor,
+            ActorRole = Enum.Parse<ActorRole>(document.ActorRole, ignoreCase: false),
+            Proposer = document.Proposer,
+            Checker = string.IsNullOrEmpty(document.Checker) ? null : document.Checker,
+            BusinessDate = DateOnly.ParseExact(document.BusinessDate, "yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Timestamp = DateTimeOffset.Parse(document.Timestamp, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind),
+            ReasonRedacted = document.ReasonRedacted,
+            ReasonHash = document.ReasonHash,
+            EvidenceRedacted = document.EvidenceRedacted,
+            EvidenceHash = document.EvidenceHash,
+            PreviousHash = document.PreviousHash,
+            EntryHash = document.EntryHash
+        };
+    }
+}
+
+/// <summary>Serialisation shape of an audit entry, shared by the trail file and the export.</summary>
+public sealed record AuditEntryDocument
+{
+    public required long Sequence { get; init; }
+    public required int Version { get; init; }
+    public required string RequestId { get; init; }
+    public required string Action { get; init; }
+    public required string Actor { get; init; }
+    public required string ActorRole { get; init; }
+    public required string Proposer { get; init; }
+    public string? Checker { get; init; }
+    public required string BusinessDate { get; init; }
+    public required string Timestamp { get; init; }
+    public required string ReasonRedacted { get; init; }
+    public required string ReasonHash { get; init; }
+    public required string EvidenceRedacted { get; init; }
+    public required string EvidenceHash { get; init; }
+    public required string PreviousHash { get; init; }
+    public required string EntryHash { get; init; }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditExportBuilder.cs b/src/TradeRecon.Application/Audit/AuditExportBuilder.cs
new file mode 100644
index 0000000..f8371f3
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditExportBuilder.cs
@@ -0,0 +1,137 @@
+using System.Globalization;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Projects the append-only trail into the Compliance export for a business-date range.
+///
+/// The export is a faithful copy of durable entries — never a re-derivation — plus a per-request
+/// roll-up that makes the maker-checker property directly assertable: every approved or rejected
+/// request shows exactly one final decision, taken by a checker distinct from its proposer.
+/// </summary>
+public static class AuditExportBuilder
+{
+    /// <summary>Schema version stamped into the export so readers can pin expectations.</summary>
+    public const string SchemaVersion = "1.0";
+
+    public static AuditExportDocument Build(AuditTrailSnapshot snapshot, DateOnly fromDate, DateOnly toDate)
+    {
+        ArgumentNullException.ThrowIfNull(snapshot);
+
+        var entries = snapshot.Entries
+            .Where(e => e.BusinessDate >= fromDate && e.BusinessDate <= toDate)
+            .OrderBy(e => e.Sequence)
+            .ToList();
+
+        var requests = entries
+            .GroupBy(e => ResolutionIdentity.Normalize(e.RequestId), StringComparer.OrdinalIgnoreCase)
+            .OrderBy(g => g.Min(e => e.Sequence))
+            .Select(BuildRequestSummary)
+            .ToList();
+
+        return new AuditExportDocument
+        {
+            SchemaVersion = SchemaVersion,
+            FromDate = fromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            ToDate = toDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            EntryCount = entries.Count,
+            RequestCount = requests.Count,
+            ChainVerified = snapshot.ChainVerified,
+            HeadHash = snapshot.HeadHash,
+            Requests = requests,
+            Entries = entries.Select(AuditEntrySerializer.ToDocument).ToList()
+        };
+    }
+
+    private static AuditRequestSummaryDocument BuildRequestSummary(IGrouping<string, AuditEntry> group)
+    {
+        var ordered = group.OrderBy(e => e.Sequence).ToList();
+        var proposal = ordered.FirstOrDefault(e => e.Action == ResolutionAction.Proposed);
+        var decisions = ordered.Where(e => e.Action != ResolutionAction.Proposed).ToList();
+        var finalDecision = decisions.Count > 0 ? decisions[0] : null;
+
+        var status = finalDecision?.Action switch
+        {
+            ResolutionAction.Approved => ResolutionStatus.Approved,
+            ResolutionAction.Rejected => ResolutionStatus.Rejected,
+            _ => ResolutionStatus.Pending
+        };
+
+        var proposer = proposal?.Proposer ?? ordered[0].Proposer;
+
+        return new AuditRequestSummaryDocument
+        {
+            RequestId = group.Key,
+            BusinessDate = ordered[0].BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Proposer = proposer,
+            Status = status.ToString(),
+            FinalAction = finalDecision?.Action.ToString(),
+            FinalDecidedBy = finalDecision?.Actor,
+            DecisionCount = decisions.Count,
+            EntryCount = ordered.Count,
+            FirstSequence = ordered[0].Sequence,
+            LastSequence = ordered[^1].Sequence,
+            LatestVersion = ordered[^1].Version,
+            LatestHash = ordered[^1].EntryHash,
+            CheckerDistinctFromProposer = finalDecision is not null
+                && !ResolutionIdentity.SamePerson(finalDecision.Actor, proposer),
+            SelfApproved = finalDecision is not null
+                && ResolutionIdentity.SamePerson(finalDecision.Actor, proposer)
+        };
+    }
+}
+
+/// <summary>The Compliance export document for a business-date range.</summary>
+public sealed record AuditExportDocument
+{
+    public required string SchemaVersion { get; init; }
+    public required string FromDate { get; init; }
+    public required string ToDate { get; init; }
+    public required int EntryCount { get; init; }
+    public required int RequestCount { get; init; }
+
+    /// <summary>False when recomputing the hash chain does not reconcile with what is stored.</summary>
+    public required bool ChainVerified { get; init; }
+
+    /// <summary>Hash of the trail head at export time.</summary>
+    public required string HeadHash { get; init; }
+
+    /// <summary>Per-request roll-up of the maker-checker outcome.</summary>
+    public required IReadOnlyList<AuditRequestSummaryDocument> Requests { get; init; }
+
+    /// <summary>Every durable entry in the range, in append order.</summary>
+    public required IReadOnlyList<AuditEntryDocument> Entries { get; init; }
+}
+
+/// <summary>Roll-up of one request's lifecycle within the exported range.</summary>
+public sealed record AuditRequestSummaryDocument
+{
+    public required string RequestId { get; init; }
+    public required string BusinessDate { get; init; }
+    public required string Proposer { get; init; }
+
+    /// <summary>Pending, Approved or Rejected.</summary>
+    public required string Status { get; init; }
+
+    /// <summary>Approved or Rejected once decided; otherwise <c>null</c>.</summary>
+    public string? FinalAction { get; init; }
+
+    /// <summary>The checker who took the final decision; otherwise <c>null</c>.</summary>
+    public string? FinalDecidedBy { get; init; }
+
+    /// <summary>Durable decisions recorded. Never exceeds one.</summary>
+    public required int DecisionCount { get; init; }
+
+    public required int EntryCount { get; init; }
+    public required long FirstSequence { get; init; }
+    public required long LastSequence { get; init; }
+    public required int LatestVersion { get; init; }
+    public required string LatestHash { get; init; }
+
+    /// <summary>True when a decision exists and its checker differs from the proposer.</summary>
+    public required bool CheckerDistinctFromProposer { get; init; }
+
+    /// <summary>Always false: self-approval is refused before anything is appended.</summary>
+    public required bool SelfApproved { get; init; }
+}
