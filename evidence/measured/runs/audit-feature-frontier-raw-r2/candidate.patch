diff --git a/tests/TradeRecon.Tests/AuditAdapterContractTests.cs b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
new file mode 100644
index 0000000..6de0a9c
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
@@ -0,0 +1,165 @@
+using System.Text.Json;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Guards the machine-readable contract a harness uses to drive the resolution workflow.
+///
+/// The adapter must stay shell-free: every command is an executable plus a fully separated
+/// argument array, so operator-supplied text (a reason, an evidence reference) can never be
+/// re-interpreted as shell syntax.
+/// </summary>
+public class AuditAdapterContractTests
+{
+    private static readonly string[] RequiredCommands = ["initialize", "propose", "decide", "export"];
+
+    private static readonly IReadOnlyDictionary<string, string[]> RequiredPlaceholders =
+        new Dictionary<string, string[]>(StringComparer.Ordinal)
+        {
+            ["initialize"] = ["{stateDirectory}"],
+            ["propose"] = ["{stateDirectory}", "{requestId}", "{proposer}", "{businessDate}", "{reason}", "{evidence}"],
+            ["decide"] = ["{stateDirectory}", "{requestId}", "{approver}", "{decision}"],
+            ["export"] = ["{stateDirectory}", "{fromDate}", "{toDate}", "{exportPath}"]
+        };
+
+    [Fact]
+    public void AdapterFileExistsAtTheCandidateRoot()
+    {
+        Assert.True(File.Exists(AdapterPath()), $"audit-adapter.json was not found at {AdapterPath()}.");
+    }
+
+    [Fact]
+    public void AdapterDeclaresTheFourWorkflowCommands()
+    {
+        using var document = ReadAdapter();
+        var root = document.RootElement;
+
+        Assert.Equal(JsonValueKind.Object, root.ValueKind);
+        Assert.False(string.IsNullOrWhiteSpace(root.GetProperty("schemaVersion").GetString()));
+        Assert.False(string.IsNullOrWhiteSpace(root.GetProperty("workingDirectory").GetString()));
+
+        foreach (var command in RequiredCommands)
+        {
+            Assert.True(root.TryGetProperty(command, out var element), $"Missing '{command}' command.");
+            Assert.Equal(JsonValueKind.Object, element.ValueKind);
+            Assert.Equal("dotnet", element.GetProperty("executable").GetString());
+            Assert.NotEmpty(Arguments(element));
+            Assert.Contains(0, ExitCodes(element));
+        }
+    }
+
+    [Theory]
+    [InlineData("initialize")]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    public void EachCommandCarriesItsPlaceholdersAsStandaloneArguments(string command)
+    {
+        using var document = ReadAdapter();
+        var arguments = Arguments(document.RootElement.GetProperty(command));
+
+        foreach (var placeholder in RequiredPlaceholders[command])
+        {
+            // A placeholder occupying a whole argument cannot be split, quoted or concatenated
+            // into neighbouring text by the caller.
+            Assert.Contains(placeholder, arguments);
+        }
+    }
+
+    [Theory]
+    [InlineData("initialize")]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    public void NoArgumentUsesShellSyntax(string command)
+    {
+        string[] metacharacters = ["&&", "||", ";", "|", ">", "<", "`", "$(", "\"", "'", "\n"];
+
+        using var document = ReadAdapter();
+
+        foreach (var argument in Arguments(document.RootElement.GetProperty(command)))
+        {
+            foreach (var metacharacter in metacharacters)
+            {
+                Assert.DoesNotContain(metacharacter, argument, StringComparison.Ordinal);
+            }
+        }
+    }
+
+    [Theory]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    public void RefusableCommandsAllowThePolicyRefusalExitCode(string command)
+    {
+        using var document = ReadAdapter();
+
+        Assert.Contains(3, ExitCodes(document.RootElement.GetProperty(command)));
+    }
+
+    [Fact]
+    public void EveryCommandTargetsTheAuditConsoleProject()
+    {
+        using var document = ReadAdapter();
+
+        foreach (var command in RequiredCommands)
+        {
+            var arguments = Arguments(document.RootElement.GetProperty(command));
+
+            Assert.Contains("src/TradeRecon.AuditConsole/TradeRecon.AuditConsole.csproj", arguments);
+            Assert.Contains(command, arguments);
+
+            var separator = Array.IndexOf(arguments, "--");
+            var verb = Array.IndexOf(arguments, command);
+            Assert.True(separator >= 0, "The dotnet run separator '--' is required.");
+            Assert.True(verb > separator, $"The '{command}' verb must follow the '--' separator.");
+        }
+    }
+
+    [Fact]
+    public void TheBaselineAdapterIsStillIntact()
+    {
+        var path = Path.Combine(RepositoryRoot(), "benchmark-adapter.json");
+        using var document = JsonDocument.Parse(File.ReadAllText(path));
+        var root = document.RootElement;
+
+        foreach (var command in new[] { "build", "test", "run" })
+        {
+            Assert.True(root.TryGetProperty(command, out _), $"benchmark-adapter.json lost its '{command}' command.");
+        }
+
+        Assert.Equal(JsonValueKind.Array, root.GetProperty("outputs").ValueKind);
+    }
+
+    private static JsonDocument ReadAdapter() => JsonDocument.Parse(File.ReadAllText(AdapterPath()));
+
+    private static string AdapterPath() => Path.Combine(RepositoryRoot(), "audit-adapter.json");
+
+    private static string[] Arguments(JsonElement command) => command
+        .GetProperty("arguments")
+        .EnumerateArray()
+        .Select(a => a.GetString() ?? string.Empty)
+        .ToArray();
+
+    private static int[] ExitCodes(JsonElement command) => command
+        .GetProperty("allowedExitCodes")
+        .EnumerateArray()
+        .Select(a => a.GetInt32())
+        .ToArray();
+
+    private static string RepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            if (File.Exists(Path.Combine(directory.FullName, "TradeRecon.sln")))
+            {
+                return directory.FullName;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new InvalidOperationException("Could not locate the repository root from the test output directory.");
+    }
+}
