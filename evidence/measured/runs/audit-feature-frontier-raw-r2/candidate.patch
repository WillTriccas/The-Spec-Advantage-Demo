new file mode 100644
index 0000000..2855006
--- /dev/null
+++ b/src/TradeRecon.AuditConsole/AuditCliCommand.cs
@@ -0,0 +1,86 @@
+namespace TradeRecon.AuditConsole;
+
+/// <summary>
+/// A parsed audit command: a verb plus its <c>--option value</c> pairs.
+///
+/// Option values are taken verbatim, including values that begin with a dash, because a
+/// resolution reason is arbitrary operator text. Commands are therefore safe to express as a
+/// shell-free argument array in an adapter contract.
+/// </summary>
+internal sealed class AuditCliCommand
+{
+    private readonly Dictionary<string, string> _options;
+
+    private AuditCliCommand(string verb, Dictionary<string, string> options)
+    {
+        Verb = verb;
+        _options = options;
+    }
+
+    /// <summary>The command verb, lower-cased.</summary>
+    public string Verb { get; }
+
+    public static AuditCliCommand Parse(string[] args)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+
+        if (args.Length == 0 || args[0].StartsWith('-'))
+        {
+            throw new ArgumentException("A command is required: initialize, propose, decide or export.");
+        }
+
+        var verb = args[0].Trim().ToLowerInvariant();
+        var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+
+        for (var i = 1; i < args.Length; i++)
+        {
+            var token = args[i];
+            if (!token.StartsWith("--", StringComparison.Ordinal) || token.Length <= 2)
+            {
+                throw new ArgumentException($"Unexpected argument at position {i}; expected an --option.");
+            }
+
+            var name = token[2..];
+            string value;
+
+            var separator = name.IndexOf('=', StringComparison.Ordinal);
+            if (separator >= 0)
+            {
+                value = name[(separator + 1)..];
+                name = name[..separator];
+            }
+            else
+            {
+                if (i + 1 >= args.Length)
+                {
+                    throw new ArgumentException($"Option --{name} requires a value.");
+                }
+
+                value = args[++i];
+            }
+
+            if (name.Length == 0)
+            {
+                throw new ArgumentException($"Unexpected argument at position {i}; expected an --option.");
+            }
+
+            options[name] = value;
+        }
+
+        return new AuditCliCommand(verb, options);
+    }
+
+    /// <summary>Returns the first supplied alias of an option, or throws when none was given.</summary>
+    public string RequireOption(params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (_options.TryGetValue(name, out var value) && !string.IsNullOrWhiteSpace(value))
+            {
+                return value;
+            }
+        }
+
+        throw new ArgumentException($"Option --{names[0]} is required and must not be empty.");
+    }
+}
diff --git a/src/TradeRecon.AuditConsole/Program.cs b/src/TradeRecon.AuditConsole/Program.cs
new file mode 100644
index 0000000..6e25329
--- /dev/null
+++ b/src/TradeRecon.AuditConsole/Program.cs
@@ -0,0 +1,266 @@
+using System.Globalization;
+using Microsoft.Extensions.DependencyInjection;
+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using TradeRecon.Infrastructure;
+
+namespace TradeRecon.AuditConsole;
+
+/// <summary>
+/// Black-box command-line host for explainable exception resolution and its audit history.
+///
+/// Four verbs, each writing one JSON document to stdout and nothing else:
+///
+/// <code>
+/// initialize --state &lt;dir&gt;
+/// propose    --state &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;who&gt; --business-date &lt;yyyy-MM-dd&gt;
+///            --reason &lt;text&gt; --evidence &lt;text&gt;
+/// decide     --state &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;who&gt; --decision &lt;approve|reject&gt;
+/// export     --state &lt;dir&gt; --from &lt;yyyy-MM-dd&gt; --to &lt;yyyy-MM-dd&gt; --output &lt;path&gt;
+/// </code>
+///
+/// Exit codes: 0 accepted (including an idempotent retry), 3 refused by policy (self-approval,
+/// an already-decided request, a conflicting proposal, an unknown request), 1 invalid arguments
+/// or an I/O failure. A refusal still writes a JSON document describing why.
+///
+/// Caller-supplied reason and evidence text is redacted before it reaches stdout, stderr or
+/// durable state, so account identifiers and trade amounts cannot leak through this host.
+/// </summary>
+public static class Program
+{
+    /// <summary>The command was accepted, or an identical retry was replayed.</summary>
+    public const int ExitOk = 0;
+
+    /// <summary>Invalid arguments or an I/O failure.</summary>
+    public const int ExitError = 1;
+
+    /// <summary>The command was understood but refused by a workflow rule.</summary>
+    public const int ExitRefused = 3;
+
+    private const string Usage = """
+        Usage:
+          TradeRecon.AuditConsole initialize --state <dir>
+          TradeRecon.AuditConsole propose    --state <dir> --request-id <id> --proposer <who>
+                                             --business-date <yyyy-MM-dd> --reason <text> --evidence <text>
+          TradeRecon.AuditConsole decide     --state <dir> --request-id <id> --approver <who>
+                                             --decision <approve|reject>
+          TradeRecon.AuditConsole export     --state <dir> --from <yyyy-MM-dd> --to <yyyy-MM-dd>
+                                             --output <path>
+        """;
+
+    public static Task<int> Main(string[] args)
+        => RunAsync(args, System.Console.Out, System.Console.Error);
+
+    /// <summary>Entry point with injectable streams so the CLI contract is directly testable.</summary>
+    public static async Task<int> RunAsync(string[] args, TextWriter stdout, TextWriter stderr)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+        ArgumentNullException.ThrowIfNull(stdout);
+        ArgumentNullException.ThrowIfNull(stderr);
+
+        if (args.Length == 0 || args.Contains("--help") || args.Contains("-h"))
+        {
+            await stdout.WriteLineAsync(Usage).ConfigureAwait(false);
+            return args.Length == 0 ? ExitError : ExitOk;
+        }
+
+        AuditCliCommand command;
+        try
+        {
+            command = AuditCliCommand.Parse(args);
+        }
+        catch (ArgumentException ex)
+        {
+            return await FailAsync(stdout, stderr, ex.Message).ConfigureAwait(false);
+        }
+
+        try
+        {
+            return await DispatchAsync(command, stdout, stderr).ConfigureAwait(false);
+        }
+        catch (ArgumentException ex)
+        {
+            return await FailAsync(stdout, stderr, ex.Message).ConfigureAwait(false);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or TimeoutException or InvalidOperationException)
+        {
+            return await FailAsync(stdout, stderr, $"Audit state is unavailable: {ex.GetType().Name}.").ConfigureAwait(false);
+        }
+    }
+
+    private static async Task<int> DispatchAsync(AuditCliCommand command, TextWriter stdout, TextWriter stderr)
+    {
+        var services = new ServiceCollection();
+        services.AddTradeReconAudit(command.RequireOption("state", "state-directory", "state-dir"));
+
+        await using var provider = services.BuildServiceProvider();
+        var workflow = provider.GetRequiredService<ResolutionWorkflowService>();
+
+        switch (command.Verb)
+        {
+            case "initialize":
+                return await WriteResultAsync(stdout, stderr, command.Verb, await workflow.InitializeAsync().ConfigureAwait(false)).ConfigureAwait(false);
+
+            case "propose":
+            {
+                var result = await workflow.ProposeAsync(new ProposeCommand
+                {
+                    RequestId = command.RequireOption("request-id", "request", "id"),
+                    Proposer = command.RequireOption("proposer", "maker"),
+                    BusinessDate = ParseDate(command.RequireOption("business-date", "date"), "--business-date"),
+                    Reason = command.RequireOption("reason"),
+                    Evidence = command.RequireOption("evidence")
+                }).ConfigureAwait(false);
+
+                return await WriteResultAsync(stdout, stderr, command.Verb, result).ConfigureAwait(false);
+            }
+
+            case "decide":
+            {
+                var raw = command.RequireOption("decision", "outcome");
+                if (!TryParseDecision(raw, out var decision))
+                {
+                    var refusal = new WorkflowResult
+                    {
+                        Ok = false,
+                        Outcome = WorkflowOutcome.InvalidDecision,
+                        Error = WorkflowOutcome.InvalidDecision,
+                        RequestId = command.RequireOption("request-id", "request", "id"),
+                        IdempotentReplay = false,
+                        Message = "The decision must be either approve or reject."
+                    };
+
+                    return await WriteResultAsync(stdout, stderr, command.Verb, refusal).ConfigureAwait(false);
+                }
+
+                var result = await workflow.DecideAsync(new DecideCommand
+                {
+                    RequestId = command.RequireOption("request-id", "request", "id"),
+                    Approver = command.RequireOption("approver", "checker", "decider"),
+                    Decision = decision
+                }).ConfigureAwait(false);
+
+                return await WriteResultAsync(stdout, stderr, command.Verb, result).ConfigureAwait(false);
+            }
+
+            case "export":
+            {
+                var from = ParseDate(command.RequireOption("from", "from-date"), "--from");
+                var to = ParseDate(command.RequireOption("to", "to-date"), "--to");
+                if (to < from)
+                {
+                    throw new ArgumentException("The --to date precedes the --from date.");
+                }
+
+                var exportPath = Path.GetFullPath(command.RequireOption("output", "export-path", "out"));
+                var export = await workflow.ExportAsync(from, to).ConfigureAwait(false);
+                var json = AuditJson.Serialize(export);
+
+                var directory = Path.GetDirectoryName(exportPath);
+                if (!string.IsNullOrEmpty(directory))
+                {
+                    Directory.CreateDirectory(directory);
+                }
+
+                await File.WriteAllTextAsync(exportPath, json + "\n").ConfigureAwait(false);
+                await stdout.WriteLineAsync(json).ConfigureAwait(false);
+                return ExitOk;
+            }
+
+            default:
+                return await FailAsync(stdout, stderr, $"Unknown command '{command.Verb}'.").ConfigureAwait(false);
+        }
+    }
+
+    private static async Task<int> WriteResultAsync(
+        TextWriter stdout,
+        TextWriter stderr,
+        string verb,
+        WorkflowResult result)
+    {
+        await stdout.WriteLineAsync(AuditJson.Serialize(new AuditCommandResponse
+        {
+            SchemaVersion = AuditExportBuilder.SchemaVersion,
+            Command = verb,
+            Result = result
+        })).ConfigureAwait(false);
+
+        if (result.Ok)
+        {
+            return ExitOk;
+        }
+
+        await stderr.WriteLineAsync($"{verb}: refused ({result.Outcome}).").ConfigureAwait(false);
+        return ExitRefused;
+    }
+
+    private static async Task<int> FailAsync(TextWriter stdout, TextWriter stderr, string message)
+    {
+        await stdout.WriteLineAsync(AuditJson.Serialize(new AuditCommandResponse
+        {
+            SchemaVersion = AuditExportBuilder.SchemaVersion,
+            Command = "unknown",
+            Result = new WorkflowResult
+            {
+                Ok = false,
+                Outcome = "invalid-arguments",
+                Error = "invalid-arguments",
+                IdempotentReplay = false,
+                Message = message
+            }
+        })).ConfigureAwait(false);
+
+        await stderr.WriteLineAsync(message).ConfigureAwait(false);
+        await stderr.WriteLineAsync(Usage).ConfigureAwait(false);
+        return ExitError;
+    }
+
+    private static DateOnly ParseDate(string value, string option)
+    {
+        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
+        {
+            return date;
+        }
+
+        if (DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var instant))
+        {
+            return DateOnly.FromDateTime(instant.UtcDateTime);
+        }
+
+        throw new ArgumentException($"Option {option} requires an ISO date (yyyy-MM-dd).");
+    }
+
+    private static bool TryParseDecision(string value, out ResolutionAction decision)
+    {
+        switch (value.Trim().ToLowerInvariant())
+        {
+            case "approve":
+            case "approved":
+            case "accept":
+            case "accepted":
+                decision = ResolutionAction.Approved;
+                return true;
+
+            case "reject":
+            case "rejected":
+            case "decline":
+            case "declined":
+            case "deny":
+            case "denied":
+                decision = ResolutionAction.Rejected;
+                return true;
+
+            default:
+                decision = ResolutionAction.Proposed;
+                return false;
+        }
+    }
+}
+
+/// <summary>Envelope written to stdout by every audit command except <c>export</c>.</summary>
+public sealed record AuditCommandResponse
+{
+    public required string SchemaVersion { get; init; }
+    public required string Command { get; init; }
+    public required WorkflowResult Result { get; init; }
+}
