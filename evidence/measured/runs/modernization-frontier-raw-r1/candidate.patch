@@ -0,0 +1,77 @@
+using System.Globalization;
+using System.Text;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Application;
+
+/// <summary>
+/// Renders the operator-facing end-of-day report.
+/// </summary>
+/// <remarks>
+/// The layout is a published artefact that Trade Operations reads every night, so the
+/// headings, ordering and blank lines are fixed. The report always ends with exactly one
+/// trailing newline.
+/// </remarks>
+public sealed class EndOfDayReportBuilder : IEndOfDayReportBuilder
+{
+    public string BuildReport(DateOnly businessDate, ReconciliationResult result)
+    {
+        ArgumentNullException.ThrowIfNull(result);
+
+        var report = new StringBuilder();
+        report.AppendLine("Legacy Trade Reconciliation - End Of Day Report");
+        report.AppendLine("Business Date: " + businessDate.ToString(CommandLineDateFormat, CultureInfo.InvariantCulture));
+        report.AppendLine();
+        report.AppendLine("Totals");
+        report.AppendLine("------");
+        report.AppendLine("Trades Read: " + result.TotalTradesRead.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Canonical Trades: " + result.CanonicalTradeCount.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Matched: " + result.MatchedCount.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Manual Override Matched: " + result.ManualOverrideMatchedCount.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Manual Override Suppressed: " + result.ManualOverrideSuppressedCount.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Open Breaks: " + result.OpenBreaks.Count.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Duplicate Trades: " + result.DuplicateTradeCount.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine("Stale Overrides: " + result.StaleOverrides.Count.ToString(CultureInfo.InvariantCulture));
+        report.AppendLine();
+        report.AppendLine("Open Break Reasons");
+        report.AppendLine("------------------");
+
+        List<KeyValuePair<string, int>> reasonCounts = result.OpenBreaks
+            .SelectMany(record => record.Reasons.Split('|'))
+            .Select(reason => reason.Trim())
+            .Where(reason => !string.IsNullOrWhiteSpace(reason))
+            .GroupBy(reason => reason, StringComparer.Ordinal)
+            .OrderBy(group => group.Key, StringComparer.Ordinal)
+            .Select(group => new KeyValuePair<string, int>(group.Key, group.Count()))
+            .ToList();
+
+        foreach (KeyValuePair<string, int> reasonCount in reasonCounts)
+        {
+            report.AppendLine(reasonCount.Key + ": " + reasonCount.Value.ToString(CultureInfo.InvariantCulture));
+        }
+
+        if (reasonCounts.Count == 0)
+        {
+            report.AppendLine("None");
+        }
+
+        if (result.StaleOverrides.Count > 0)
+        {
+            report.AppendLine();
+            report.AppendLine("Stale Overrides");
+            report.AppendLine("---------------");
+
+            // The trade identifier is echoed exactly as the operator submitted it so the
+            // audit line can be traced back to the source row.
+            foreach (ManualOverrideRecord staleOverride in result.StaleOverrides.OrderBy(item => item.TradeId, StringComparer.Ordinal))
+            {
+                report.AppendLine(staleOverride.TradeId + ": " + staleOverride.Action + " (" + staleOverride.ApprovedBy + ")");
+            }
+        }
+
+        return report.ToString().TrimEnd() + Environment.NewLine;
+    }
+
+    private const string CommandLineDateFormat = "yyyy-MM-dd";
+}
diff --git a/LegacyTradeReconciliation/Application/MatchingEngine.cs b/LegacyTradeReconciliation/Application/MatchingEngine.cs
new file mode 100644
index 0000000..f3aa744
--- /dev/null
+++ b/LegacyTradeReconciliation/Application/MatchingEngine.cs
@@ -0,0 +1,377 @@
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Application;
+
+/// <summary>
+/// Reconciles trades against custodian positions and settlement instructions, then
+/// applies manual overrides to the resulting break queue.
+/// </summary>
+/// <remarks>
+/// The rules implemented here are the published Trade Operations contract:
+/// <list type="number">
+/// <item>Account, instrument and currency are compared on trimmed uppercase values.</item>
+/// <item>The first occurrence of a trade identifier is canonical; later duplicates always break.</item>
+/// <item>A counterpart must agree on account, instrument, settlement date and currency
+/// before any tolerance is evaluated.</item>
+/// <item>Positions and settlements have separate quantity tolerances; settlement cash has its own.</item>
+/// <item>Non-positive trade quantities and net amounts always break.</item>
+/// <item>Overrides may only resolve breaks that already have concrete counterpart candidates.</item>
+/// <item>Suppressed breaks stay visible in <c>matched-trades.csv</c> rather than disappearing.</item>
+/// <item>If several overrides target one trade, only the first applies and the rest are audited as stale.</item>
+/// </list>
+/// </remarks>
+public sealed class MatchingEngine : IMatchingEngine
+{
+    private readonly ReconciliationOptions _options;
+
+    public MatchingEngine()
+        : this(ReconciliationOptions.Default)
+    {
+    }
+
+    public MatchingEngine(ReconciliationOptions options)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        options.Validate();
+        _options = options;
+    }
+
+    public ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord> trades,
+        IReadOnlyCollection<PositionRecord> positions,
+        IReadOnlyCollection<SettlementRecord> settlements,
+        IReadOnlyCollection<ManualOverrideRecord> overrides)
+    {
+        ArgumentNullException.ThrowIfNull(trades);
+        ArgumentNullException.ThrowIfNull(positions);
+        ArgumentNullException.ThrowIfNull(settlements);
+        ArgumentNullException.ThrowIfNull(overrides);
+
+        OverrideLedger overrideLedger = OverrideLedger.Build(overrides);
+        CounterpartIndex<PositionRecord> positionIndex = CounterpartIndex<PositionRecord>.Build(
+            positions, position => BuildPairKey(position.Account, position.Instrument), position => position.PositionId);
+        CounterpartIndex<SettlementRecord> settlementIndex = CounterpartIndex<SettlementRecord>.Build(
+            settlements, settlement => BuildPairKey(settlement.Account, settlement.Instrument), settlement => settlement.SettlementId);
+
+        var matchedTrades = new List<MatchedTradeRecord>();
+        var breakQueue = new List<BreakRecord>();
+        var usedPositions = new HashSet<string>(StringComparer.Ordinal);
+        var usedSettlements = new HashSet<string>(StringComparer.Ordinal);
+        var seenTradeIds = new HashSet<string>(StringComparer.Ordinal);
+        int duplicateTradeCount = 0;
+
+        foreach (TradeRecord trade in trades)
+        {
+            string normalizedTradeId = Normalize(trade.TradeId);
+            if (!seenTradeIds.Add(normalizedTradeId))
+            {
+                duplicateTradeCount++;
+                breakQueue.Add(CreateBreak(trade, BreakReasons.DuplicateTradeId, null, null, canManualOverride: false));
+                continue;
+            }
+
+            if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+            {
+                breakQueue.Add(CreateBreak(trade, BreakReasons.TradeValueOutOfBounds, null, null, canManualOverride: false));
+                continue;
+            }
+
+            string pairKey = BuildPairKey(trade.Account, trade.Instrument);
+            var reasons = new List<string>();
+
+            IReadOnlyList<PositionRecord>? positionCandidates = positionIndex.Find(pairKey);
+            PositionRecord? position = null;
+            if (positionCandidates is null)
+            {
+                reasons.Add(BreakReasons.MissingPosition);
+            }
+            else
+            {
+                position = SelectPosition(trade, positionCandidates, usedPositions, reasons);
+            }
+
+            IReadOnlyList<SettlementRecord>? settlementCandidates = settlementIndex.Find(pairKey);
+            SettlementRecord? settlement = null;
+            if (settlementCandidates is null)
+            {
+                reasons.Add(BreakReasons.MissingSettlement);
+            }
+            else
+            {
+                settlement = SelectSettlement(trade, settlementCandidates, usedSettlements, reasons);
+            }
+
+            if (reasons.Count == 0 && position is not null && settlement is not null)
+            {
+                usedPositions.Add(position.PositionId);
+                usedSettlements.Add(settlement.SettlementId);
+                matchedTrades.Add(CreateMatchedTrade(trade, MatchStatuses.Matched, position.PositionId, settlement.SettlementId, note: null));
+                continue;
+            }
+
+            // A break may still be overridable, but only when both counterpart feeds
+            // actually contained candidates for the account/instrument pair.
+            bool canManualOverride =
+                positionCandidates is not null &&
+                settlementCandidates is not null &&
+                !reasons.Exists(BreakReasons.BlocksManualOverride);
+
+            breakQueue.Add(CreateBreak(
+                trade,
+                FormatReasons(reasons),
+                position?.PositionId ?? NearestId(positionCandidates, trade.SettlementDate, candidate => candidate.SettlementDate, candidate => candidate.PositionId),
+                settlement?.SettlementId ?? NearestId(settlementCandidates, trade.SettlementDate, candidate => candidate.SettlementDate, candidate => candidate.SettlementId),
+                canManualOverride));
+        }
+
+        ApplyManualOverrides(overrideLedger, breakQueue, matchedTrades);
+        IReadOnlyList<ManualOverrideRecord> staleOverrides = overrideLedger.CollectStale(overrides);
+
+        return new ReconciliationResult(
+            MatchedTrades: [.. matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            OpenBreaks: [.. breakQueue.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            StaleOverrides: [.. staleOverrides.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            TotalTradesRead: trades.Count,
+            CanonicalTradeCount: seenTradeIds.Count,
+            DuplicateTradeCount: duplicateTradeCount,
+            MatchedCount: matchedTrades.Count(record => record.Status == MatchStatuses.Matched),
+            ManualOverrideMatchedCount: matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideMatched),
+            ManualOverrideSuppressedCount: matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideSuppressed));
+    }
+
+    /// <summary>
+    /// Walks the break queue in production order and applies the single canonical
+    /// override for each trade. Breaks are removed by identity, because duplicate
+    /// trade rows can produce textually identical break records.
+    /// </summary>
+    private static void ApplyManualOverrides(
+        OverrideLedger overrideLedger,
+        List<BreakRecord> breakQueue,
+        List<MatchedTradeRecord> matchedTrades)
+    {
+        foreach (BreakRecord breakRecord in breakQueue.ToArray())
+        {
+            if (!overrideLedger.TryGetCanonical(Normalize(breakRecord.TradeId), out ManualOverrideRecord? manualOverride))
+            {
+                continue;
+            }
+
+            overrideLedger.MarkTargetResolved(Normalize(breakRecord.TradeId));
+
+            if (!breakRecord.CanManualOverride ||
+                string.IsNullOrWhiteSpace(manualOverride.Note) ||
+                string.IsNullOrWhiteSpace(manualOverride.ApprovedBy))
+            {
+                overrideLedger.MarkStale(manualOverride);
+                continue;
+            }
+
+            string status = Normalize(manualOverride.Action) switch
+            {
+                OverrideActions.ForceMatch => MatchStatuses.ManualOverrideMatched,
+                OverrideActions.SuppressBreak => MatchStatuses.ManualOverrideSuppressed,
+                _ => string.Empty
+            };
+
+            if (status.Length == 0)
+            {
+                overrideLedger.MarkStale(manualOverride);
+                continue;
+            }
+
+            matchedTrades.Add(new MatchedTradeRecord(
+                breakRecord.TradeId,
+                status,
+                breakRecord.Account,
+                breakRecord.Instrument,
+                breakRecord.Quantity,
+                breakRecord.SettlementDate,
+                breakRecord.Currency,
+                breakRecord.PositionId,
+                breakRecord.SettlementId,
+                manualOverride.Note));
+
+            RemoveByIdentity(breakQueue, breakRecord);
+        }
+    }
+
+    private static void RemoveByIdentity(List<BreakRecord> breakQueue, BreakRecord breakRecord)
+    {
+        for (int index = 0; index < breakQueue.Count; index++)
+        {
+            if (ReferenceEquals(breakQueue[index], breakRecord))
+            {
+                breakQueue.RemoveAt(index);
+                return;
+            }
+        }
+    }
+
+    private PositionRecord? SelectPosition(
+        TradeRecord trade,
+        IReadOnlyList<PositionRecord> candidates,
+        HashSet<string> usedPositions,
+        List<string> reasons)
+    {
+        List<PositionRecord> available = candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingPosition);
+            return null;
+        }
+
+        List<PositionRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionSettlementDateMismatch);
+            return null;
+        }
+
+        List<PositionRecord> sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionCurrencyMismatch);
+            return null;
+        }
+
+        PositionRecord candidatePosition = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.PositionQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _options.PositionQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.PositionQuantityOutOfTolerance);
+            return null;
+        }
+
+        return candidatePosition;
+    }
+
+    private SettlementRecord? SelectSettlement(
+        TradeRecord trade,
+        IReadOnlyList<SettlementRecord> candidates,
+        HashSet<string> usedSettlements,
+        List<string> reasons)
+    {
+        List<SettlementRecord> available = candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingSettlement);
+            return null;
+        }
+
+        List<SettlementRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementDateMismatch);
+            return null;
+        }
+
+        List<SettlementRecord> sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementCurrencyMismatch);
+            return null;
+        }
+
+        SettlementRecord candidateSettlement = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.SettlementQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _options.SettlementQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementQuantityOutOfTolerance);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _options.SettlementAmountTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementAmountOutOfTolerance);
+            return null;
+        }
+
+        return candidateSettlement;
+    }
+
+    /// <summary>
+    /// Surfaces the closest counterpart by settlement date so an analyst has a
+    /// starting point even when nothing matched.
+    /// </summary>
+    private static string? NearestId<T>(
+        IReadOnlyList<T>? candidates,
+        DateOnly tradeSettlementDate,
+        Func<T, DateOnly> dateSelector,
+        Func<T, string> idSelector)
+    {
+        if (candidates is null)
+        {
+            return null;
+        }
+
+        return candidates
+            .OrderBy(candidate => Math.Abs(dateSelector(candidate).DayNumber - tradeSettlementDate.DayNumber))
+            .ThenBy(idSelector, StringComparer.Ordinal)
+            .Select(idSelector)
+            .FirstOrDefault();
+    }
+
+    private static string FormatReasons(IEnumerable<string> reasons) =>
+        string.Join("|", reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal));
+
+    private static BreakRecord CreateBreak(
+        TradeRecord trade,
+        string reasons,
+        string? positionId,
+        string? settlementId,
+        bool canManualOverride) =>
+        new(
+            Normalize(trade.TradeId),
+            Normalize(trade.Account),
+            Normalize(trade.Instrument),
+            trade.Quantity,
+            trade.SettlementDate,
+            Normalize(trade.Currency),
+            reasons,
+            positionId,
+            settlementId,
+            canManualOverride);
+
+    private static MatchedTradeRecord CreateMatchedTrade(
+        TradeRecord trade,
+        string status,
+        string? positionId,
+        string? settlementId,
+        string? note) =>
+        new(
+            Normalize(trade.TradeId),
+            status,
+            Normalize(trade.Account),
+            Normalize(trade.Instrument),
+            trade.Quantity,
+            trade.SettlementDate,
+            Normalize(trade.Currency),
+            positionId,
+            settlementId,
+            note);
+
+    internal static string BuildPairKey(string account, string instrument) =>
+        Normalize(account) + "|" + Normalize(instrument);
+
+    internal static string Normalize(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();
+}
