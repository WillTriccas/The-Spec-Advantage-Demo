+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+using Xunit;
+
+namespace Reconciliation.Tests;
+
+/// <summary>Rule-level tests for the reconciliation engine.</summary>
+public sealed class MatchingEngineTests
+{
+    [Fact]
+    public void A_clean_trade_matches_its_position_and_settlement()
+    {
+        ReconciliationResult result = Build.Reconcile(
+            [Build.Trade()],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.Matched, matched.Status);
+        Assert.Equal("P-1", matched.PositionId);
+        Assert.Equal("S-1", matched.SettlementId);
+        Assert.Empty(result.OpenBreaks);
+        Assert.Equal(1, result.CanonicalTradeCount);
+        Assert.Equal(0, result.DuplicateTradeCount);
+    }
+
+    [Fact]
+    public void Identifiers_are_compared_case_insensitively_and_trimmed()
+    {
+        ReconciliationResult result = Build.Reconcile(
+            [Build.Trade(tradeId: " t-1 ", account: " acc-1 ", instrument: "aaa.n", currency: "usd")],
+            [Build.Position(account: "ACC-1", instrument: "AAA.N", currency: "USD")],
+            [Build.Settlement(account: "ACC-1", instrument: "AAA.N", currency: "USD")]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.Matched, matched.Status);
+        Assert.Equal("T-1", matched.TradeId);
+    }
+
+    [Fact]
+    public void A_repeated_trade_id_keeps_the_first_row_and_breaks_the_rest()
+    {
+        ReconciliationResult result = Build.Reconcile(
