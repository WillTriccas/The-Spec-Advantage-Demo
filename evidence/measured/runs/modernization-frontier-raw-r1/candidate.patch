@@ -0,0 +1,71 @@
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Abstractions;
+
+/// <summary>Reads the four synthetic CSV inputs for a run.</summary>
+public interface IReconciliationInputReader
+{
+    IReadOnlyList<TradeRecord> ReadTrades(string inputDirectory);
+
+    IReadOnlyList<PositionRecord> ReadPositions(string inputDirectory);
+
+    IReadOnlyList<SettlementRecord> ReadSettlements(string inputDirectory);
+
+    /// <summary>Overrides are optional; a missing file yields an empty list.</summary>
+    IReadOnlyList<ManualOverrideRecord> ReadOverrides(string inputDirectory);
+}
+
+/// <summary>Writes the published run artefacts.</summary>
+public interface IReconciliationOutputWriter
+{
+    void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades);
+
+    void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue);
+
+    void WriteEndOfDayReport(string outputDirectory, string reportText);
+
+    /// <summary>True when a previous run already published the full artefact set.</summary>
+    bool OutputsExist(string outputDirectory);
+}
+
+/// <summary>Reconciles one day's trades against positions, settlements and overrides.</summary>
+public interface IMatchingEngine
+{
+    ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord> trades,
+        IReadOnlyCollection<PositionRecord> positions,
+        IReadOnlyCollection<SettlementRecord> settlements,
+        IReadOnlyCollection<ManualOverrideRecord> overrides);
+}
+
+/// <summary>Renders the human-readable end-of-day report.</summary>
+public interface IEndOfDayReportBuilder
+{
+    string BuildReport(DateOnly businessDate, ReconciliationResult result);
+}
+
+/// <summary>Computes the content signature that makes reruns idempotent.</summary>
+public interface IInputSignatureCalculator
+{
+    string Calculate(RunRequest request);
+}
+
+/// <summary>Append-only audit trail of completed runs.</summary>
+public interface IRunLedger
+{
+    bool Contains(string ledgerPath, DateOnly businessDate, string signature);
+
+    void AppendIfMissing(string ledgerPath, RunLedgerEntry entry);
+}
+
+/// <summary>
+/// Minimal operational logging seam. Kept dependency-free on purpose: the batch must
+/// build and run on a locked-down server with no package feed available.
+/// </summary>
+public interface IBatchLog
+{
+    void Info(string message);
+
+    void Error(string message);
+}
