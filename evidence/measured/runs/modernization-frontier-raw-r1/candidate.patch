+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Application;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Infrastructure;
+
+namespace LegacyTradeReconciliation.Hosting;
+
+/// <summary>
+/// Composition root for the batch.
+/// </summary>
+/// <remarks>
+/// Wiring lives in exactly one place so <see cref="ReconciliationBatch"/> stays free of
+/// construction detail and tests can substitute any collaborator.
+/// </remarks>
+public static class BatchFactory
+{
+    public static ReconciliationBatch Create(IBatchLog log, ReconciliationOptions? options = null)
+    {
+        ArgumentNullException.ThrowIfNull(log);
+
+        return new ReconciliationBatch(
+            new CsvInputReader(),
+            new CsvOutputWriter(),
+            new MatchingEngine(options ?? ReconciliationOptions.Default),
+            new EndOfDayReportBuilder(),
+            new InputSignatureCalculator(),
+            new CsvRunLedger(),
+            log);
+    }
+}
+
+/// <summary>Writes operational messages to the process console streams.</summary>
+public sealed class ConsoleBatchLog : IBatchLog
+{
+    public void Info(string message) => Console.Out.WriteLine(message);
+
+    /// <summary>
+    /// Errors go to standard error so that a scheduler capturing stdout for the run
+    /// summary does not interleave failures into it.
+    /// </summary>
+    public void Error(string message) => Console.Error.WriteLine(message);
+}
diff --git a/LegacyTradeReconciliation/Infrastructure/CsvFieldFormat.cs b/LegacyTradeReconciliation/Infrastructure/CsvFieldFormat.cs
new file mode 100644
index 0000000..3ba2e10
--- /dev/null
+++ b/LegacyTradeReconciliation/Infrastructure/CsvFieldFormat.cs
@@ -0,0 +1,75 @@
+using System.Globalization;
+
+namespace LegacyTradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Shared field-level formatting and parsing for the batch's CSV contract.
+/// </summary>
+/// <remarks>
+/// Every value is read and written with <see cref="CultureInfo.InvariantCulture"/>. That
+/// is what keeps a run on an operator workstation byte-identical to a run on the batch
+/// server, regardless of regional settings.
+/// </remarks>
+internal static class CsvFieldFormat
+{
+    public const string DateFormat = "yyyy-MM-dd";
+
+    /// <summary>Trailing zeros are trimmed, matching the published output schema.</summary>
+    private const string DecimalFormat = "0.####";
+
+    private const NumberStyles DecimalStyles = NumberStyles.Number | NumberStyles.AllowLeadingSign;
+
+    public static string FormatDecimal(decimal value) =>
+        value.ToString(DecimalFormat, CultureInfo.InvariantCulture);
+
+    public static string FormatDate(DateOnly value) =>
+        value.ToString(DateFormat, CultureInfo.InvariantCulture);
+
+    public static decimal ParseDecimal(string value, string fieldName, CsvLocation location)
+    {
+        if (!decimal.TryParse(value, DecimalStyles, CultureInfo.InvariantCulture, out decimal parsed))
+        {
+            throw new CsvFormatException(location, $"Field '{fieldName}' value '{value}' is not a valid decimal.");
+        }
+
+        return parsed;
+    }
+
+    public static DateOnly ParseDate(string value, string fieldName, CsvLocation location)
+    {
+        if (!DateOnly.TryParseExact(value, DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly parsed))
+        {
+            throw new CsvFormatException(location, $"Field '{fieldName}' value '{value}' is not a valid {DateFormat} date.");
+        }
+
+        return parsed;
+    }
+}
+
+/// <summary>Identifies a row in an input file for diagnostics.</summary>
+internal readonly record struct CsvLocation(string FileName, int LineNumber)
+{
+    public override string ToString() =>
+        FileName + " line " + LineNumber.ToString(CultureInfo.InvariantCulture);
+}
+
+/// <summary>
+/// Raised when an input file does not satisfy the agreed CSV contract.
+/// </summary>
+/// <remarks>
+/// The message names the file and line so an operator can correct the feed without
+/// needing a developer to read a stack trace.
+/// </remarks>
+public sealed class CsvFormatException : IOException
+{
+    internal CsvFormatException(CsvLocation location, string message)
+        : base($"{location}: {message}")
+    {
+        FileName = location.FileName;
+        LineNumber = location.LineNumber;
+    }
+
+    public string FileName { get; }
+
+    public int LineNumber { get; }
+}
diff --git a/LegacyTradeReconciliation/Infrastructure/CsvInputReader.cs b/LegacyTradeReconciliation/Infrastructure/CsvInputReader.cs
new file mode 100644
index 0000000..833964c
--- /dev/null
+++ b/LegacyTradeReconciliation/Infrastructure/CsvInputReader.cs
@@ -0,0 +1,134 @@
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Reads the four synthetic CSV feeds from an input directory.
+/// </summary>
+/// <remarks>
+/// <para>
+/// The parsing contract is unchanged: a single header row, comma separated fields with a
+/// fixed count per feed, values trimmed, and blank lines ignored. What has changed is the
+/// diagnostics. A malformed row now reports the file, the line number and the offending
+/// field instead of a bare "Unexpected csv format" string, and files are streamed rather
+/// than fully materialised as a string array.
+/// </para>
+/// </remarks>
+public sealed class CsvInputReader : IReconciliationInputReader
+{
+    private const int TradeFieldCount = 7;
+    private const int PositionFieldCount = 6;
+    private const int SettlementFieldCount = 7;
+    private const int OverrideFieldCount = 4;
+
+    public IReadOnlyList<TradeRecord> ReadTrades(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Trades, TradeFieldCount, static (fields, location) => new TradeRecord(
+            TradeId: fields[0],
+            Account: fields[1],
+            Instrument: fields[2],
+            Quantity: CsvFieldFormat.ParseDecimal(fields[3], "quantity", location),
+            SettlementDate: CsvFieldFormat.ParseDate(fields[4], "settlement_date", location),
+            Currency: fields[5],
+            NetAmount: CsvFieldFormat.ParseDecimal(fields[6], "net_amount", location)));
+
+    public IReadOnlyList<PositionRecord> ReadPositions(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Positions, PositionFieldCount, static (fields, location) => new PositionRecord(
+            PositionId: fields[0],
+            Account: fields[1],
+            Instrument: fields[2],
+            Quantity: CsvFieldFormat.ParseDecimal(fields[3], "quantity", location),
+            SettlementDate: CsvFieldFormat.ParseDate(fields[4], "settlement_date", location),
+            Currency: fields[5]));
+
+    public IReadOnlyList<SettlementRecord> ReadSettlements(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Settlements, SettlementFieldCount, static (fields, location) => new SettlementRecord(
+            SettlementId: fields[0],
+            Account: fields[1],
+            Instrument: fields[2],
+            Quantity: CsvFieldFormat.ParseDecimal(fields[3], "quantity", location),
+            SettlementDate: CsvFieldFormat.ParseDate(fields[4], "settlement_date", location),
+            Currency: fields[5],
+            CashAmount: CsvFieldFormat.ParseDecimal(fields[6], "cash_amount", location)));
+
+    /// <summary>Overrides are optional: most business dates have none.</summary>
+    public IReadOnlyList<ManualOverrideRecord> ReadOverrides(string inputDirectory)
+    {
+        string path = ResolvePath(inputDirectory, BatchFileNames.Overrides);
+        if (!File.Exists(path))
+        {
+            return [];
+        }
+
+        return Parse(path, BatchFileNames.Overrides, OverrideFieldCount, static (fields, _) => new ManualOverrideRecord(
+            TradeId: fields[0],
+            Action: fields[1],
+            Note: fields[2],
+            ApprovedBy: fields[3]));
+    }
+
+    private static IReadOnlyList<T> ReadRequired<T>(
+        string inputDirectory,
+        string fileName,
+        int fieldCount,
+        Func<string[], CsvLocation, T> projection)
+    {
+        string path = ResolvePath(inputDirectory, fileName);
+        if (!File.Exists(path))
+        {
+            throw new FileNotFoundException($"Required input file '{fileName}' was not found in '{inputDirectory}'.", path);
+        }
+
+        return Parse(path, fileName, fieldCount, projection);
+    }
+
+    private static List<T> Parse<T>(
+        string path,
+        string fileName,
+        int fieldCount,
+        Func<string[], CsvLocation, T> projection)
+    {
+        var records = new List<T>();
+        int lineNumber = 0;
+
+        foreach (string line in File.ReadLines(path))
+        {
+            lineNumber++;
+
+            // The first physical line is always the header.
+            if (lineNumber == 1 || string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            var location = new CsvLocation(fileName, lineNumber);
+            string[] fields = line.Split(',');
+            if (fields.Length != fieldCount)
+            {
+                throw new CsvFormatException(
+                    location,
+                    $"Expected {fieldCount} comma separated fields but found {fields.Length}.");
+            }
+
+            for (int index = 0; index < fields.Length; index++)
+            {
+                fields[index] = fields[index].Trim();
+            }
+
+            records.Add(projection(fields, location));
+        }
+
+        return records;
+    }
+
+    /// <summary>
+    /// Combines the directory and the batch's own fixed file name. The file name is a
+    /// compile-time constant, so this can never be steered outside the supplied directory.
+    /// </summary>
+    private static string ResolvePath(string inputDirectory, string fileName)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(inputDirectory);
+        return Path.Combine(inputDirectory, fileName);
+    }
+}
