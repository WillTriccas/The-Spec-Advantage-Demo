index 0000000..0d49672
--- /dev/null
+++ b/LegacyTradeReconciliation/Infrastructure/CsvOutputWriter.cs
@@ -0,0 +1,92 @@
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Publishes <c>matched-trades.csv</c>, <c>break-queue.csv</c> and
+/// <c>end-of-day-report.txt</c> into the run's output directory.
+/// </summary>
+/// <remarks>
+/// The header rows and column order are a published contract consumed by downstream
+/// Trade Operations tooling and must not drift. Rows are ordered deterministically here
+/// as well as in the engine so the files are stable even if a caller supplies an
+/// unordered result.
+/// </remarks>
+public sealed class CsvOutputWriter : IReconciliationOutputWriter
+{
+    private const string MatchedTradesHeader =
+        "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+
+    private const string BreakQueueHeader =
+        "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+    public void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades)
+    {
+        ArgumentNullException.ThrowIfNull(matchedTrades);
+
+        IEnumerable<string> rows = matchedTrades
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ',',
+                record.TradeId,
+                record.Status,
+                record.Account,
+                record.Instrument,
+                CsvFieldFormat.FormatDecimal(record.Quantity),
+                CsvFieldFormat.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty,
+                record.OverrideNote ?? string.Empty));
+
+        WriteAllRows(outputDirectory, BatchFileNames.MatchedTrades, MatchedTradesHeader, rows);
+    }
+
+    public void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue)
+    {
+        ArgumentNullException.ThrowIfNull(breakQueue);
+
+        IEnumerable<string> rows = breakQueue
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .ThenBy(record => record.Reasons, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ',',
+                record.TradeId,
+                record.Account,
+                record.Instrument,
+                CsvFieldFormat.FormatDecimal(record.Quantity),
+                CsvFieldFormat.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.Reasons,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty));
+
+        WriteAllRows(outputDirectory, BatchFileNames.BreakQueue, BreakQueueHeader, rows);
+    }
+
+    public void WriteEndOfDayReport(string outputDirectory, string reportText)
+    {
+        ArgumentNullException.ThrowIfNull(reportText);
+        File.WriteAllText(BuildPath(outputDirectory, BatchFileNames.EndOfDayReport), reportText);
+    }
+
+    public bool OutputsExist(string outputDirectory) =>
+        File.Exists(BuildPath(outputDirectory, BatchFileNames.MatchedTrades)) &&
+        File.Exists(BuildPath(outputDirectory, BatchFileNames.BreakQueue)) &&
+        File.Exists(BuildPath(outputDirectory, BatchFileNames.EndOfDayReport));
+
+    private static void WriteAllRows(string outputDirectory, string fileName, string header, IEnumerable<string> rows)
+    {
+        var lines = new List<string> { header };
+        lines.AddRange(rows);
+        File.WriteAllLines(BuildPath(outputDirectory, fileName), lines);
+    }
+
+    private static string BuildPath(string outputDirectory, string fileName)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(outputDirectory);
+        return Path.Combine(outputDirectory, fileName);
+    }
+}
