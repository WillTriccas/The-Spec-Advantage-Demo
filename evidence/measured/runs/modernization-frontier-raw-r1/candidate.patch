diff --git a/LegacyTradeReconciliation/Configuration/CommandLineParser.cs b/LegacyTradeReconciliation/Configuration/CommandLineParser.cs
new file mode 100644
index 0000000..4972ded
--- /dev/null
+++ b/LegacyTradeReconciliation/Configuration/CommandLineParser.cs
@@ -0,0 +1,109 @@
+using System.Globalization;
+
+namespace LegacyTradeReconciliation.Configuration;
+
+/// <summary>A validated request to run the batch for one business date.</summary>
+public sealed record RunRequest(DateOnly BusinessDate, string InputDirectory, string OutputDirectory);
+
+/// <summary>The outcome of interpreting the process command line.</summary>
+public sealed record CommandLineParseResult(RunRequest? Request, string? ErrorMessage, bool HelpRequested)
+{
+    public static CommandLineParseResult Success(RunRequest request) => new(request, null, false);
+
+    public static CommandLineParseResult Failure(string message) => new(null, message, false);
+
+    public static CommandLineParseResult Help() => new(null, null, true);
+}
+
+/// <summary>
+/// Parses the batch command line.
+/// <para>
+/// The historical contract is preserved exactly: no arguments runs the bundled
+/// sample, and three arguments supply business date, input directory and output
+/// directory. Unlike the legacy build, an operator mistake now yields a readable
+/// diagnostic and a non-zero exit code instead of an unhandled exception and a
+/// stack trace on the console.
+/// </para>
+/// </summary>
+public static class CommandLineParser
+{
+    public const string DateFormat = "yyyy-MM-dd";
+
+    public static string Usage =>
+        "Usage: LegacyTradeReconciliation [<business-date yyyy-MM-dd> <input-directory> <output-directory>]" +
+        Environment.NewLine +
+        "  With no arguments the bundled sample batch under data/sample is processed." +
+        Environment.NewLine +
+        "  Options: --help | -h    Show this message.";
+
+    public static CommandLineParseResult Parse(string[]? args, string baseDirectory)
+    {
+        ArgumentException.ThrowIfNullOrEmpty(baseDirectory);
+
+        args ??= [];
+
+        if (args.Length == 1 && (args[0] is "--help" or "-h" or "/?"))
+        {
+            return CommandLineParseResult.Help();
+        }
+
+        if (args.Length == 0)
+        {
+            return CommandLineParseResult.Success(new RunRequest(
+                new DateOnly(2025, 3, 17),
+                Path.Combine(baseDirectory, "data", "sample"),
+                Path.Combine(baseDirectory, "output", "sample")));
+        }
+
+        if (args.Length != 3)
+        {
+            return CommandLineParseResult.Failure(
+                $"Expected either no arguments or 3 arguments but received {args.Length}.");
+        }
+
+        if (!DateOnly.TryParseExact(args[0], DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly businessDate))
+        {
+            return CommandLineParseResult.Failure($"Business date '{args[0]}' is not a valid {DateFormat} date.");
+        }
+
+        if (!TryResolveDirectory(args[1], "Input directory", out string inputDirectory, out string inputError))
+        {
+            return CommandLineParseResult.Failure(inputError);
+        }
+
+        if (!TryResolveDirectory(args[2], "Output directory", out string outputDirectory, out string outputError))
+        {
+            return CommandLineParseResult.Failure(outputError);
+        }
+
+        return CommandLineParseResult.Success(new RunRequest(businessDate, inputDirectory, outputDirectory));
+    }
+
+    /// <summary>
+    /// Resolves a caller-supplied path to a rooted, canonical form. Rooting the path
+    /// up front means every later file operation is unaffected by the process working
+    /// directory, and malformed paths are rejected before any file is touched.
+    /// </summary>
+    private static bool TryResolveDirectory(string value, string label, out string resolved, out string error)
+    {
+        resolved = string.Empty;
+        error = string.Empty;
+
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            error = $"{label} must not be empty.";
+            return false;
+        }
+
+        try
+        {
+            resolved = Path.GetFullPath(value);
+            return true;
+        }
+        catch (Exception exception) when (exception is ArgumentException or NotSupportedException or PathTooLongException)
+        {
+            error = $"{label} '{value}' is not a usable path: {exception.Message}";
+            return false;
+        }
+    }
+}
