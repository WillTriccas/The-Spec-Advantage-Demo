+namespace LegacyTradeReconciliation.Domain;
+
+/// <summary>
+/// Break reason codes. Trade Operations filters and reports on these exact
+/// strings, so they are part of the published output contract.
+/// </summary>
+public static class BreakReasons
+{
+    public const string DuplicateTradeId = "DuplicateTradeId";
+    public const string TradeValueOutOfBounds = "TradeValueOutOfBounds";
+    public const string MissingPosition = "MissingPosition";
+    public const string MissingSettlement = "MissingSettlement";
+    public const string PositionSettlementDateMismatch = "PositionSettlementDateMismatch";
+    public const string PositionCurrencyMismatch = "PositionCurrencyMismatch";
+    public const string PositionQuantitySignMismatch = "PositionQuantitySignMismatch";
+    public const string PositionQuantityOutOfTolerance = "PositionQuantityOutOfTolerance";
+    public const string SettlementDateMismatch = "SettlementDateMismatch";
+    public const string SettlementCurrencyMismatch = "SettlementCurrencyMismatch";
+    public const string SettlementQuantitySignMismatch = "SettlementQuantitySignMismatch";
+    public const string SettlementQuantityOutOfTolerance = "SettlementQuantityOutOfTolerance";
+    public const string SettlementAmountOutOfTolerance = "SettlementAmountOutOfTolerance";
+
+    /// <summary>
+    /// Reasons that describe a structurally absent or invalid counterpart. A manual
+    /// override may never resolve one of these, because doing so would manufacture a
+    /// position or settlement that does not exist.
+    /// </summary>
+    public static bool BlocksManualOverride(string reason) =>
+        reason is MissingPosition or MissingSettlement or DuplicateTradeId or TradeValueOutOfBounds;
+}
+
+/// <summary>Statuses published in <c>matched-trades.csv</c>.</summary>
+public static class MatchStatuses
+{
+    public const string Matched = "Matched";
+    public const string ManualOverrideMatched = "ManualOverrideMatched";
+    public const string ManualOverrideSuppressed = "ManualOverrideSuppressed";
+}
+
+/// <summary>Recognised manual override verbs, compared after normalisation.</summary>
+public static class OverrideActions
+{
+    public const string ForceMatch = "FORCEMATCH";
+    public const string SuppressBreak = "SUPPRESSBREAK";
+}
