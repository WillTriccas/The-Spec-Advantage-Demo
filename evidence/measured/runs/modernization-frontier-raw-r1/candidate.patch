+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Application;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Hosting;
+
+namespace Reconciliation.Tests;
+
+/// <summary>Captures batch log output so tests can assert on operator messaging.</summary>
+internal sealed class RecordingBatchLog : IBatchLog
+{
+    public List<string> Info { get; } = [];
+
+    public List<string> Errors { get; } = [];
+
+    void IBatchLog.Info(string message) => Info.Add(message);
+
+    void IBatchLog.Error(string message) => Errors.Add(message);
+}
+
+/// <summary>Shared helpers for fixture-driven tests.</summary>
+internal static class TestEnvironment
+{
+    public static string FixtureRoot(string name) =>
+        Path.Combine(AppContext.BaseDirectory, "Fixtures", name);
+
+    public static string FixtureInput(string name) => Path.Combine(FixtureRoot(name), "input");
+
+    public static string FixtureExpected(string name, string fileName) =>
+        Path.Combine(FixtureRoot(name), "expected", fileName);
+
+    /// <summary>Creates an empty, uniquely named output directory for one test.</summary>
+    public static string CreateOutputDirectory()
+    {
+        string directory = Path.Combine(
+            Path.GetTempPath(),
+            "trade-reconciliation-tests",
+            Guid.NewGuid().ToString("n"));
+        Directory.CreateDirectory(directory);
+        return directory;
+    }
+
+    /// <summary>Copies a fixture's inputs so a test can mutate them safely.</summary>
+    public static string CopyFixtureInput(string name)
+    {
+        string destination = Path.Combine(CreateOutputDirectory(), "input");
+        Directory.CreateDirectory(destination);
+        foreach (string file in Directory.GetFiles(FixtureInput(name)))
+        {
+            File.Copy(file, Path.Combine(destination, Path.GetFileName(file)));
+        }
+
+        return destination;
+    }
+
+    public static RunOutcome RunBatch(string inputDirectory, string outputDirectory, string businessDate = "2025-03-17")
+    {
+        var log = new RecordingBatchLog();
+        return RunBatch(inputDirectory, outputDirectory, log, businessDate);
+    }
+
+    public static RunOutcome RunBatch(string inputDirectory, string outputDirectory, RecordingBatchLog log, string businessDate = "2025-03-17") =>
+        BatchFactory.Create(log).Run(new RunRequest(DateOnly.Parse(businessDate), inputDirectory, outputDirectory));
+
+    public static string ReadOutput(string outputDirectory, string fileName) =>
+        File.ReadAllText(Path.Combine(outputDirectory, fileName));
+
+    /// <summary>
+    /// Compares text ignoring line-ending style. The published artefacts use the platform
+    /// newline, whereas the checked-in golden files are stored with a fixed style, so a
+    /// raw comparison would fail purely on how Git materialised the fixture.
+    /// </summary>
+    public static string Normalize(string value) =>
+        value.Replace("\r\n", "\n", StringComparison.Ordinal);
+}
+
+/// <summary>Fluent builders keeping engine tests focused on the rule under test.</summary>
+internal static class Build
+{
+    public static readonly DateOnly SettlementDate = new(2025, 3, 17);
+
+    public static TradeRecord Trade(
+        string tradeId = "T-1",
+        string account = "ACC-1",
+        string instrument = "AAA.N",
+        decimal quantity = 100m,
+        DateOnly? settlementDate = null,
+        string currency = "USD",
+        decimal netAmount = 1000m) =>
+        new(tradeId, account, instrument, quantity, settlementDate ?? SettlementDate, currency, netAmount);
+
+    public static PositionRecord Position(
+        string positionId = "P-1",
+        string account = "ACC-1",
+        string instrument = "AAA.N",
+        decimal quantity = 100m,
+        DateOnly? settlementDate = null,
+        string currency = "USD") =>
+        new(positionId, account, instrument, quantity, settlementDate ?? SettlementDate, currency);
+
+    public static SettlementRecord Settlement(
+        string settlementId = "S-1",
+        string account = "ACC-1",
+        string instrument = "AAA.N",
+        decimal quantity = 100m,
+        DateOnly? settlementDate = null,
+        string currency = "USD",
+        decimal cashAmount = 1000m) =>
+        new(settlementId, account, instrument, quantity, settlementDate ?? SettlementDate, currency, cashAmount);
+
+    public static ManualOverrideRecord Override(
+        string tradeId = "T-1",
+        string action = "ForceMatch",
+        string note = "Approved",
+        string approvedBy = "ops-manager") =>
+        new(tradeId, action, note, approvedBy);
+
+    public static ReconciliationResult Reconcile(
+        IEnumerable<TradeRecord>? trades = null,
+        IEnumerable<PositionRecord>? positions = null,
+        IEnumerable<SettlementRecord>? settlements = null,
+        IEnumerable<ManualOverrideRecord>? overrides = null,
+        ReconciliationOptions? options = null) =>
+        new MatchingEngine(options ?? ReconciliationOptions.Default).Reconcile(
+            trades?.ToList() ?? [],
+            positions?.ToList() ?? [],
+            settlements?.ToList() ?? [],
+            overrides?.ToList() ?? []);
+}
