@@ -0,0 +1,106 @@
+using System.Diagnostics.CodeAnalysis;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Application;
+
+/// <summary>
+/// Tracks manual override instructions for a single reconciliation pass and produces
+/// the stale-override audit trail.
+/// </summary>
+/// <remarks>
+/// <para>
+/// Two audit rules drive this type and both are load bearing for Trade Operations:
+/// </para>
+/// <list type="number">
+/// <item>
+/// When several instructions target one trade, the first is canonical and every later
+/// instruction is reported as stale rather than discarded.
+/// </item>
+/// <item>
+/// An instruction that targeted a real break is considered "used" even when it turned
+/// out to be unusable, so it is never re-reported by the final sweep.
+/// </item>
+/// </list>
+/// <para>
+/// Instructions are tracked by <em>reference</em>, never by value. Two separate rows
+/// carrying identical text are distinct operator submissions and must both surface;
+/// collapsing them by value would hide a duplicate submission.
+/// </para>
+/// </remarks>
+internal sealed class OverrideLedger
+{
+    private readonly Dictionary<string, ManualOverrideRecord> _canonicalByTradeId;
+    private readonly HashSet<string> _resolvedTradeIds = new(StringComparer.Ordinal);
+    private readonly List<ManualOverrideRecord> _stale = [];
+
+    private OverrideLedger(Dictionary<string, ManualOverrideRecord> canonicalByTradeId)
+    {
+        _canonicalByTradeId = canonicalByTradeId;
+    }
+
+    public static OverrideLedger Build(IReadOnlyCollection<ManualOverrideRecord> overrides)
+    {
+        ArgumentNullException.ThrowIfNull(overrides);
+
+        List<IGrouping<string, ManualOverrideRecord>> groups = overrides
+            .GroupBy(record => MatchingEngine.Normalize(record.TradeId), StringComparer.Ordinal)
+            .ToList();
+
+        var ledger = new OverrideLedger(groups.ToDictionary(
+            group => group.Key,
+            group => group.First(),
+            StringComparer.Ordinal));
+
+        // Superseded instructions are audited immediately, in delivery order.
+        foreach (ManualOverrideRecord superseded in groups.SelectMany(group => group.Skip(1)))
+        {
+            ledger.MarkStale(superseded);
+        }
+
+        return ledger;
+    }
+
+    public bool TryGetCanonical(string normalizedTradeId, [NotNullWhen(true)] out ManualOverrideRecord? canonical) =>
+        _canonicalByTradeId.TryGetValue(normalizedTradeId, out canonical);
+
+    public void MarkTargetResolved(string normalizedTradeId) => _resolvedTradeIds.Add(normalizedTradeId);
+
+    /// <summary>
+    /// Appends an instruction to the audit trail. Repeat calls for the same instance are
+    /// intentionally additive: a single instruction can be rejected once per break it
+    /// targeted, and each rejection is a separate audit event.
+    /// </summary>
+    public void MarkStale(ManualOverrideRecord record) => _stale.Add(record);
+
+    /// <summary>
+    /// Completes the audit trail by appending every instruction that never lined up with
+    /// a break, skipping instructions already recorded during override application.
+    /// </summary>
+    public IReadOnlyList<ManualOverrideRecord> CollectStale(IReadOnlyCollection<ManualOverrideRecord> overrides)
+    {
+        ArgumentNullException.ThrowIfNull(overrides);
+
+        foreach (ManualOverrideRecord record in overrides)
+        {
+            if (!_resolvedTradeIds.Contains(MatchingEngine.Normalize(record.TradeId)) && !ContainsInstance(record))
+            {
+                _stale.Add(record);
+            }
+        }
+
+        return _stale;
+    }
+
+    private bool ContainsInstance(ManualOverrideRecord record)
+    {
+        foreach (ManualOverrideRecord existing in _stale)
+        {
+            if (ReferenceEquals(existing, record))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
diff --git a/LegacyTradeReconciliation/Application/ReconciliationBatch.cs b/LegacyTradeReconciliation/Application/ReconciliationBatch.cs
new file mode 100644
index 0000000..4e29990
--- /dev/null
