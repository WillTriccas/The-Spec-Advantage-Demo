+++ b/tests/Reconciliation.Tests/CommandLineTests.cs
@@ -0,0 +1,136 @@
+using LegacyTradeReconciliation;
+using LegacyTradeReconciliation.Configuration;
+using Xunit;
+
+namespace Reconciliation.Tests;
+
+/// <summary>Tests for the command line contract and process-level error handling.</summary>
+public sealed class CommandLineTests
+{
+    [Fact]
+    public void No_arguments_runs_the_bundled_sample_batch()
+    {
+        CommandLineParseResult parsed = CommandLineParser.Parse([], @"C:\app");
+
+        Assert.NotNull(parsed.Request);
+        Assert.Equal(new DateOnly(2025, 3, 17), parsed.Request!.BusinessDate);
+        Assert.EndsWith(Path.Combine("data", "sample"), parsed.Request.InputDirectory, StringComparison.Ordinal);
+        Assert.EndsWith(Path.Combine("output", "sample"), parsed.Request.OutputDirectory, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Three_arguments_select_the_business_date_and_directories()
+    {
+        CommandLineParseResult parsed = CommandLineParser.Parse(
+            ["2025-06-02", "inputs", "outputs"],
+            AppContext.BaseDirectory);
+
+        Assert.NotNull(parsed.Request);
+        Assert.Equal(new DateOnly(2025, 6, 2), parsed.Request!.BusinessDate);
+        Assert.True(Path.IsPathRooted(parsed.Request.InputDirectory));
+        Assert.True(Path.IsPathRooted(parsed.Request.OutputDirectory));
+    }
+
+    [Theory]
+    [InlineData("--help")]
+    [InlineData("-h")]
+    [InlineData("/?")]
+    public void Help_is_reported_without_running_the_batch(string flag)
+    {
+        var log = new RecordingBatchLog();
+
+        int exitCode = Program.Run([flag], AppContext.BaseDirectory, log);
+
+        Assert.Equal(Program.SuccessExitCode, exitCode);
+        Assert.Contains(log.Info, message => message.Contains("Usage:", StringComparison.Ordinal));
+        Assert.Empty(log.Errors);
+    }
+
+    [Theory]
+    [InlineData("2025-06-02")]
+    [InlineData("2025-06-02;inputs")]
+    [InlineData("2025-06-02;inputs;outputs;extra")]
+    public void An_unexpected_argument_count_is_refused(string argumentList)
+    {
+        var log = new RecordingBatchLog();
+
+        int exitCode = Program.Run(argumentList.Split(';'), AppContext.BaseDirectory, log);
+
+        Assert.Equal(Program.FailureExitCode, exitCode);
+        Assert.Contains(log.Errors, message => message.Contains("Expected either no arguments or 3 arguments", StringComparison.Ordinal));
+    }
+
+    [Theory]
+    [InlineData("17-03-2025")]
+    [InlineData("2025/03/17")]
+    [InlineData("not-a-date")]
+    [InlineData("2025-02-30")]
+    public void A_business_date_outside_the_agreed_format_is_refused(string businessDate)
+    {
+        var log = new RecordingBatchLog();
+
+        int exitCode = Program.Run(
+            [businessDate, AppContext.BaseDirectory, TestEnvironment.CreateOutputDirectory()],
+            AppContext.BaseDirectory,
+            log);
+
+        Assert.Equal(Program.FailureExitCode, exitCode);
+        Assert.Contains(log.Errors, message => message.Contains("is not a valid yyyy-MM-dd date", StringComparison.Ordinal));
+    }
+
+    [Fact]
+    public void An_empty_directory_argument_is_refused()
+    {
+        CommandLineParseResult parsed = CommandLineParser.Parse(["2025-06-02", "   ", "outputs"], AppContext.BaseDirectory);
+
+        Assert.Null(parsed.Request);
+        Assert.Equal("Input directory must not be empty.", parsed.ErrorMessage);
+    }
+
+    [Fact]
+    public void A_missing_input_directory_fails_with_a_diagnostic_and_no_stack_trace()
+    {
+        var log = new RecordingBatchLog();
+        string missing = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("n"));
+
+        int exitCode = Program.Run(
+            ["2025-03-17", missing, TestEnvironment.CreateOutputDirectory()],
+            AppContext.BaseDirectory,
+            log);
+
+        Assert.Equal(Program.FailureExitCode, exitCode);
+        string reported = Assert.Single(log.Errors);
+        Assert.StartsWith("Reconciliation failed: ", reported, StringComparison.Ordinal);
+        Assert.DoesNotContain("   at ", reported, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_malformed_feed_fails_the_run_rather_than_publishing_partial_output()
+    {
+        var log = new RecordingBatchLog();
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+        File.AppendAllText(Path.Combine(inputDirectory, BatchFileNames.Trades), "broken-row" + Environment.NewLine);
+
+        int exitCode = Program.Run(["2025-03-17", inputDirectory, outputDirectory], AppContext.BaseDirectory, log);
+
+        Assert.Equal(Program.FailureExitCode, exitCode);
+        Assert.False(File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)));
+    }
+
+    [Fact]
+    public void A_successful_run_reports_the_headline_counts()
+    {
+        var log = new RecordingBatchLog();
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        int exitCode = Program.Run(
+            ["2025-03-17", TestEnvironment.FixtureInput("baseline"), outputDirectory],
+            AppContext.BaseDirectory,
+            log);
+
+        Assert.Equal(Program.SuccessExitCode, exitCode);
+        Assert.Contains(log.Info, message => message.Contains("Processed", StringComparison.Ordinal) && message.Contains("open breaks", StringComparison.Ordinal));
+        Assert.Empty(log.Errors);
+    }
+}
