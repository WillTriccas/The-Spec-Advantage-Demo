@@ -0,0 +1,114 @@
+using System.Globalization;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Application;
+
+/// <summary>
+/// Orchestrates one reconciliation run: load, reconcile, publish, record.
+/// </summary>
+/// <remarks>
+/// <para>
+/// Every collaborator is injected, so the whole batch can be exercised in tests against
+/// in-memory feeds without touching disk, and an operator concern such as logging can be
+/// swapped without editing business logic.
+/// </para>
+/// </remarks>
+public sealed class ReconciliationBatch
+{
+    private readonly IReconciliationInputReader _inputReader;
+    private readonly IReconciliationOutputWriter _outputWriter;
+    private readonly IMatchingEngine _matchingEngine;
+    private readonly IEndOfDayReportBuilder _reportBuilder;
+    private readonly IInputSignatureCalculator _signatureCalculator;
+    private readonly IRunLedger _runLedger;
+    private readonly IBatchLog _log;
+
+    public ReconciliationBatch(
+        IReconciliationInputReader inputReader,
+        IReconciliationOutputWriter outputWriter,
+        IMatchingEngine matchingEngine,
+        IEndOfDayReportBuilder reportBuilder,
+        IInputSignatureCalculator signatureCalculator,
+        IRunLedger runLedger,
+        IBatchLog log)
+    {
+        ArgumentNullException.ThrowIfNull(inputReader);
+        ArgumentNullException.ThrowIfNull(outputWriter);
+        ArgumentNullException.ThrowIfNull(matchingEngine);
+        ArgumentNullException.ThrowIfNull(reportBuilder);
+        ArgumentNullException.ThrowIfNull(signatureCalculator);
+        ArgumentNullException.ThrowIfNull(runLedger);
+        ArgumentNullException.ThrowIfNull(log);
+
+        _inputReader = inputReader;
+        _outputWriter = outputWriter;
+        _matchingEngine = matchingEngine;
+        _reportBuilder = reportBuilder;
+        _signatureCalculator = signatureCalculator;
+        _runLedger = runLedger;
+        _log = log;
+    }
+
+    public RunOutcome Run(RunRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        Directory.CreateDirectory(request.OutputDirectory);
+
+        string inputSignature = _signatureCalculator.Calculate(request);
+        string ledgerPath = Path.Combine(request.OutputDirectory, BatchFileNames.RunLedger);
+
+        // An exact rerun of an already-published business date is a no-op. Both halves of
+        // the check matter: the ledger proves the inputs are unchanged, and the artefact
+        // check proves the previous run's outputs are still on disk.
+        if (_runLedger.Contains(ledgerPath, request.BusinessDate, inputSignature) &&
+            _outputWriter.OutputsExist(request.OutputDirectory))
+        {
+            _log.Info(
+                "Exact rerun detected for " +
+                request.BusinessDate.ToString(CsvDateFormat, CultureInfo.InvariantCulture) +
+                ". Existing outputs were retained.");
+            return RunOutcome.Rerun;
+        }
+
+        ReconciliationResult result = _matchingEngine.Reconcile(
+            _inputReader.ReadTrades(request.InputDirectory),
+            _inputReader.ReadPositions(request.InputDirectory),
+            _inputReader.ReadSettlements(request.InputDirectory),
+            _inputReader.ReadOverrides(request.InputDirectory));
+
+        _outputWriter.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+        _outputWriter.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+        _outputWriter.WriteEndOfDayReport(request.OutputDirectory, _reportBuilder.BuildReport(request.BusinessDate, result));
+
+        _runLedger.AppendIfMissing(ledgerPath, new RunLedgerEntry(
+            request.BusinessDate,
+            inputSignature,
+            result.TotalTradesRead,
+            result.OpenBreaks.Count,
+            result.MatchedTrades.Count));
+
+        _log.Info(string.Format(
+            CultureInfo.InvariantCulture,
+            "Processed {0} trades into {1} matched rows and {2} open breaks.",
+            result.TotalTradesRead,
+            result.MatchedTrades.Count,
+            result.OpenBreaks.Count));
+
+        return RunOutcome.Processed;
+    }
+
+    private const string CsvDateFormat = "yyyy-MM-dd";
+}
+
+/// <summary>Why a run finished, for callers that need more than an exit code.</summary>
+public enum RunOutcome
+{
+    /// <summary>Inputs were reconciled and artefacts were published.</summary>
+    Processed,
+
+    /// <summary>An identical run had already been published, so outputs were retained.</summary>
+    Rerun,
+}
