@@ -0,0 +1,133 @@
+using LegacyTradeReconciliation.Application;
+using LegacyTradeReconciliation.Configuration;
+using Xunit;
+
+namespace Reconciliation.Tests;
+
+/// <summary>
+/// Golden-master tests that lock in the batch's externally observable artefacts.
+/// </summary>
+/// <remarks>
+/// These are the safety net for the modernization: the expected files were produced by the
+/// original .NET Framework implementation, so any behavioural drift fails here.
+/// </remarks>
+public sealed class GoldenMasterTests
+{
+    [Theory]
+    [InlineData("baseline", "2025-03-17")]
+    [InlineData("override-rerun", "2025-03-17")]
+    [InlineData("edge", "2025-06-02")]
+    public void Fixture_produces_the_expected_artifacts(string fixtureName, string businessDate)
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        RunOutcome outcome = TestEnvironment.RunBatch(
+            TestEnvironment.FixtureInput(fixtureName),
+            outputDirectory,
+            businessDate);
+
+        Assert.Equal(RunOutcome.Processed, outcome);
+
+        foreach (string fileName in new[] { "matched-trades.csv", "break-queue.csv", "end-of-day-report.txt" })
+        {
+            string expected = File.ReadAllText(TestEnvironment.FixtureExpected(fixtureName, fileName));
+            string actual = TestEnvironment.ReadOutput(outputDirectory, fileName);
+            Assert.Equal(TestEnvironment.Normalize(expected), TestEnvironment.Normalize(actual));
+        }
+    }
+
+    [Fact]
+    public void Every_run_publishes_the_four_contract_files()
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)));
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)));
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport)));
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.RunLedger)));
+    }
+
+    [Fact]
+    public void Rerunning_identical_inputs_changes_nothing()
+    {
+        string inputDirectory = TestEnvironment.FixtureInput("override-rerun");
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        string matchedAfterFirstRun = TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.MatchedTrades);
+        string breaksAfterFirstRun = TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.BreakQueue);
+        string reportAfterFirstRun = TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.EndOfDayReport);
+        string ledgerAfterFirstRun = TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.RunLedger);
+
+        var log = new RecordingBatchLog();
+        RunOutcome secondOutcome = TestEnvironment.RunBatch(inputDirectory, outputDirectory, log);
+        RunOutcome thirdOutcome = TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        Assert.Equal(RunOutcome.Rerun, secondOutcome);
+        Assert.Equal(RunOutcome.Rerun, thirdOutcome);
+        Assert.Contains(log.Info, message => message.Contains("Exact rerun detected", StringComparison.Ordinal));
+
+        Assert.Equal(matchedAfterFirstRun, TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.MatchedTrades));
+        Assert.Equal(breaksAfterFirstRun, TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.BreakQueue));
+        Assert.Equal(reportAfterFirstRun, TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.EndOfDayReport));
+        Assert.Equal(ledgerAfterFirstRun, TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.RunLedger));
+    }
+
+    [Fact]
+    public void The_ledger_gains_one_row_per_distinct_input_set()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("override-rerun");
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        // Change the inputs, so the same business date legitimately produces a new entry.
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Overrides),
+            "T-9999,ForceMatch,Late instruction,ops-manager" + Environment.NewLine);
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        string[] ledgerLines = File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger));
+
+        Assert.Equal("business_date,input_signature,total_trades_read,open_break_count,matched_count", ledgerLines[0]);
+        Assert.Equal(3, ledgerLines.Length);
+        Assert.All(ledgerLines.Skip(1), line => Assert.StartsWith("2025-03-17,", line, StringComparison.Ordinal));
+    }
+
+    [Fact]
+    public void Reruns_are_detected_only_when_the_previous_outputs_survive()
+    {
+        string inputDirectory = TestEnvironment.FixtureInput("baseline");
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+        File.Delete(Path.Combine(outputDirectory, BatchFileNames.BreakQueue));
+
+        RunOutcome outcome = TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        Assert.Equal(RunOutcome.Processed, outcome);
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)));
+    }
+
+    [Fact]
+    public void A_superseded_override_instruction_is_audited_rather_than_discarded()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("override-rerun");
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Overrides),
+            "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager" + Environment.NewLine);
+
+        TestEnvironment.RunBatch(inputDirectory, outputDirectory);
+
+        string report = TestEnvironment.ReadOutput(outputDirectory, BatchFileNames.EndOfDayReport);
+
+        Assert.Contains("Stale Overrides: 1", report, StringComparison.Ordinal);
+        Assert.Contains("T-1003: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+    }
+}
