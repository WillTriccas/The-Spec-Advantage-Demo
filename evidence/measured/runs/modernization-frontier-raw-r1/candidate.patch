+using System.Globalization;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Domain;
+using LegacyTradeReconciliation.Infrastructure;
+using Xunit;
+
+namespace Reconciliation.Tests;
+
+/// <summary>Tests for the CSV gateways, the run ledger and the input signature.</summary>
+public sealed class InfrastructureTests
+{
+    [Fact]
+    public void A_malformed_row_reports_the_file_and_line_that_caused_it()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Trades),
+            "T-BAD,ACC-1,AAA.N" + Environment.NewLine);
+
+        var exception = Assert.Throws<CsvFormatException>(() => new CsvInputReader().ReadTrades(inputDirectory));
+
+        Assert.Equal(BatchFileNames.Trades, exception.FileName);
+        Assert.Contains("Expected 7 comma separated fields but found 3", exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void An_unparseable_field_is_named_in_the_diagnostic()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Trades),
+            "T-BAD,ACC-1,AAA.N,not-a-number,2025-03-17,USD,100" + Environment.NewLine);
+
+        var exception = Assert.Throws<CsvFormatException>(() => new CsvInputReader().ReadTrades(inputDirectory));
+
+        Assert.Contains("quantity", exception.Message, StringComparison.Ordinal);
+        Assert.True(exception.LineNumber > 1);
+    }
+
+    [Fact]
+    public void A_missing_required_feed_is_reported_by_name()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        File.Delete(Path.Combine(inputDirectory, BatchFileNames.Positions));
+
+        var exception = Assert.Throws<FileNotFoundException>(() => new CsvInputReader().ReadPositions(inputDirectory));
+
+        Assert.Contains(BatchFileNames.Positions, exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Overrides_are_optional_and_blank_lines_are_ignored()
+    {
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        string overridesPath = Path.Combine(inputDirectory, BatchFileNames.Overrides);
+        File.Delete(overridesPath);
+
+        Assert.Empty(new CsvInputReader().ReadOverrides(inputDirectory));
+
+        File.WriteAllLines(
+            overridesPath,
+            ["trade_id,action,note,approved_by", string.Empty, "T-1,ForceMatch,Note,ops", "   "]);
+
+        ManualOverrideRecord parsed = Assert.Single(new CsvInputReader().ReadOverrides(inputDirectory));
+        Assert.Equal("T-1", parsed.TradeId);
+    }
+
+    [Fact]
+    public void Published_files_keep_their_agreed_headers_and_column_order()
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        Assert.Equal(
+            "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note",
+            File.ReadLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)).First());
+        Assert.Equal(
+            "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id",
+            File.ReadLines(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)).First());
+        Assert.Equal(
+            "business_date,input_signature,total_trades_read,open_break_count,matched_count",
+            File.ReadLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger)).First());
+    }
+
+    [Fact]
+    public void Csv_output_is_written_as_utf8_without_a_byte_order_mark()
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        byte[] bytes = File.ReadAllBytes(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades));
+
+        Assert.NotEqual<byte[]>([0xEF, 0xBB, 0xBF], bytes.Take(3).ToArray());
+    }
+
+    [Fact]
+    public void Numbers_and_dates_are_formatted_invariantly()
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        foreach (string row in File.ReadLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)).Skip(1))
+        {
+            string[] fields = row.Split(',');
+            Assert.True(decimal.TryParse(fields[4], NumberStyles.Number, CultureInfo.InvariantCulture, out _));
+            Assert.True(DateOnly.TryParseExact(fields[5], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out _));
+        }
+    }
+
+    [Fact]
+    public void The_input_signature_is_stable_for_identical_inputs()
+    {
+        var calculator = new InputSignatureCalculator();
+        string first = TestEnvironment.CopyFixtureInput("baseline");
+        string second = TestEnvironment.CopyFixtureInput("baseline");
+        var businessDate = new DateOnly(2025, 3, 17);
+
+        string firstSignature = calculator.Calculate(new RunRequest(businessDate, first, first));
+        string secondSignature = calculator.Calculate(new RunRequest(businessDate, second, second));
+
+        Assert.Equal(firstSignature, secondSignature);
+        Assert.Equal(64, firstSignature.Length);
+        Assert.Matches("^[0-9a-f]{64}$", firstSignature);
+    }
+
+    [Fact]
+    public void The_input_signature_changes_when_the_inputs_or_the_date_change()
+    {
+        var calculator = new InputSignatureCalculator();
+        string inputDirectory = TestEnvironment.CopyFixtureInput("baseline");
+        var businessDate = new DateOnly(2025, 3, 17);
+
+        string original = calculator.Calculate(new RunRequest(businessDate, inputDirectory, inputDirectory));
+        string otherDate = calculator.Calculate(new RunRequest(businessDate.AddDays(1), inputDirectory, inputDirectory));
+
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Overrides),
+            "T-1,ForceMatch,Note,ops" + Environment.NewLine);
+        string afterEdit = calculator.Calculate(new RunRequest(businessDate, inputDirectory, inputDirectory));
+
+        Assert.NotEqual(original, otherDate);
+        Assert.NotEqual(original, afterEdit);
+    }
+
+    [Fact]
+    public void A_missing_input_directory_is_rejected_before_any_hashing()
+    {
+        var request = new RunRequest(
+            new DateOnly(2025, 3, 17),
+            Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("n")),
+            Path.GetTempPath());
+
+        Assert.Throws<DirectoryNotFoundException>(() => new InputSignatureCalculator().Calculate(request));
+    }
+
+    [Fact]
+    public void The_ledger_survives_a_partially_written_previous_run()
+    {
+        string outputDirectory = TestEnvironment.CreateOutputDirectory();
+        string ledgerPath = Path.Combine(outputDirectory, BatchFileNames.RunLedger);
+        File.WriteAllText(ledgerPath, string.Empty);
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        string[] lines = File.ReadAllLines(ledgerPath);
+        Assert.Equal("business_date,input_signature,total_trades_read,open_break_count,matched_count", lines[0]);
+        Assert.Equal(2, lines.Length);
+    }
+
+    [Fact]
+    public void The_output_directory_is_created_when_it_does_not_exist()
+    {
+        string outputDirectory = Path.Combine(TestEnvironment.CreateOutputDirectory(), "nested", "run");
+
+        TestEnvironment.RunBatch(TestEnvironment.FixtureInput("baseline"), outputDirectory);
+
+        Assert.True(File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)));
+    }
+}
