new file mode 100644
index 0000000..3f25ade
--- /dev/null
+++ b/LegacyTradeReconciliation/Infrastructure/CsvRunLedger.cs
@@ -0,0 +1,105 @@
+using System.Globalization;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Domain;
+
+namespace LegacyTradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Append-only audit trail of completed runs, stored as <c>run-ledger.csv</c>.
+/// </summary>
+/// <remarks>
+/// The ledger is what makes reruns observable after the fact: each row records the
+/// business date, the input signature and the headline counts. Entries are never
+/// rewritten or removed, and an entry for an already-recorded signature is not appended
+/// twice.
+/// </remarks>
+public sealed class CsvRunLedger : IRunLedger
+{
+    private const string LedgerHeader =
+        "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+    private const int LedgerFieldCount = 5;
+
+    public bool Contains(string ledgerPath, DateOnly businessDate, string signature)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(ledgerPath);
+
+        return ReadEntries(ledgerPath).Any(entry =>
+            entry.BusinessDate == businessDate &&
+            string.Equals(entry.InputSignature, signature, StringComparison.Ordinal));
+    }
+
+    public void AppendIfMissing(string ledgerPath, RunLedgerEntry entry)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(ledgerPath);
+        ArgumentNullException.ThrowIfNull(entry);
+
+        if (Contains(ledgerPath, entry.BusinessDate, entry.InputSignature))
+        {
+            return;
+        }
+
+        bool needsHeader = !File.Exists(ledgerPath) || new FileInfo(ledgerPath).Length == 0;
+        using var writer = new StreamWriter(ledgerPath, append: true);
+
+        if (needsHeader)
+        {
+            writer.WriteLine(LedgerHeader);
+        }
+
+        writer.WriteLine(string.Join(
+            ',',
+            CsvFieldFormat.FormatDate(entry.BusinessDate),
+            entry.InputSignature,
+            entry.TotalTradesRead.ToString(CultureInfo.InvariantCulture),
+            entry.OpenBreakCount.ToString(CultureInfo.InvariantCulture),
+            entry.MatchedCount.ToString(CultureInfo.InvariantCulture)));
+    }
+
+    private static List<RunLedgerEntry> ReadEntries(string ledgerPath)
+    {
+        var entries = new List<RunLedgerEntry>();
+        if (!File.Exists(ledgerPath))
+        {
+            return entries;
+        }
+
+        int lineNumber = 0;
+        foreach (string line in File.ReadLines(ledgerPath))
+        {
+            lineNumber++;
+            if (lineNumber == 1 || string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            var location = new CsvLocation(Path.GetFileName(ledgerPath), lineNumber);
+            string[] fields = line.Split(',');
+            if (fields.Length != LedgerFieldCount)
+            {
+                throw new CsvFormatException(
+                    location,
+                    $"Expected {LedgerFieldCount} comma separated fields but found {fields.Length}.");
+            }
+
+            entries.Add(new RunLedgerEntry(
+                CsvFieldFormat.ParseDate(fields[0], "business_date", location),
+                fields[1],
+                ParseCount(fields[2], "total_trades_read", location),
+                ParseCount(fields[3], "open_break_count", location),
+                ParseCount(fields[4], "matched_count", location)));
+        }
+
+        return entries;
+    }
+
+    private static int ParseCount(string value, string fieldName, CsvLocation location)
+    {
+        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsed))
+        {
+            throw new CsvFormatException(location, $"Field '{fieldName}' value '{value}' is not a valid integer.");
+        }
+
+        return parsed;
+    }
+}
diff --git a/LegacyTradeReconciliation/Infrastructure/InputSignatureCalculator.cs b/LegacyTradeReconciliation/Infrastructure/InputSignatureCalculator.cs
