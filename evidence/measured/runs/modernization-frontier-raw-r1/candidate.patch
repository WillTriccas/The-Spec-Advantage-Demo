@@ -0,0 +1,56 @@
+namespace LegacyTradeReconciliation.Configuration;
+
+/// <summary>
+/// Matching tolerances. These are business-approved thresholds; they are exposed as
+/// an injectable option object rather than compile-time constants so that Trade
+/// Operations can be given a controlled way to vary them and so that tests can pin
+/// boundary behaviour explicitly.
+/// </summary>
+public sealed record ReconciliationOptions
+{
+    /// <summary>Maximum absolute quantity difference tolerated against a position.</summary>
+    public decimal PositionQuantityTolerance { get; init; } = 0.01m;
+
+    /// <summary>Maximum absolute quantity difference tolerated against a settlement.</summary>
+    public decimal SettlementQuantityTolerance { get; init; } = 0.02m;
+
+    /// <summary>Maximum absolute cash difference tolerated against a settlement.</summary>
+    public decimal SettlementAmountTolerance { get; init; } = 5.00m;
+
+    /// <summary>The production defaults used by the nightly batch.</summary>
+    public static ReconciliationOptions Default { get; } = new();
+
+    /// <summary>Fails fast on a configuration that could silently mis-reconcile.</summary>
+    public void Validate()
+    {
+        ThrowIfNegative(PositionQuantityTolerance, nameof(PositionQuantityTolerance));
+        ThrowIfNegative(SettlementQuantityTolerance, nameof(SettlementQuantityTolerance));
+        ThrowIfNegative(SettlementAmountTolerance, nameof(SettlementAmountTolerance));
+    }
+
+    private static void ThrowIfNegative(decimal value, string name)
+    {
+        if (value < 0m)
+        {
+            throw new ArgumentOutOfRangeException(name, value, "Tolerances must not be negative.");
+        }
+    }
+}
+
+/// <summary>
+/// The fixed file names that make up the batch's input and output contract.
+/// Trade Operations tooling depends on these names, so they are centralised here
+/// and never composed ad hoc at a call site.
+/// </summary>
+public static class BatchFileNames
+{
+    public const string Trades = "trades.csv";
+    public const string Positions = "positions.csv";
+    public const string Settlements = "settlements.csv";
+    public const string Overrides = "overrides.csv";
+
+    public const string MatchedTrades = "matched-trades.csv";
+    public const string BreakQueue = "break-queue.csv";
+    public const string EndOfDayReport = "end-of-day-report.txt";
+    public const string RunLedger = "run-ledger.csv";
+}
