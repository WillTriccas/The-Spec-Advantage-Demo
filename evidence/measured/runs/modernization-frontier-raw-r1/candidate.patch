+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Application;
+using LegacyTradeReconciliation.Configuration;
+using LegacyTradeReconciliation.Hosting;
+
+namespace LegacyTradeReconciliation;
+
+/// <summary>Process entry point for the nightly reconciliation batch.</summary>
+public static class Program
+{
+    /// <summary>Exit code returned when the run completed.</summary>
+    public const int SuccessExitCode = 0;
+
+    /// <summary>Exit code returned when the run could not be completed.</summary>
+    public const int FailureExitCode = 1;
+
+    public static int Main(string[] args) => Run(args, AppContext.BaseDirectory, new ConsoleBatchLog());
+
+    /// <summary>
+    /// Testable entry point.
+    /// </summary>
+    /// <remarks>
+    /// Unlike the legacy build, an operator mistake or a malformed feed now produces a
+    /// single readable diagnostic and a non-zero exit code rather than an unhandled
+    /// exception and a stack trace, which keeps scheduler alerts actionable and avoids
+    /// leaking internal paths and implementation detail into batch logs.
+    /// </remarks>
+    public static int Run(string[] args, string baseDirectory, IBatchLog log)
+    {
+        ArgumentNullException.ThrowIfNull(log);
+
+        CommandLineParseResult parsed = CommandLineParser.Parse(args, baseDirectory);
+
+        if (parsed.HelpRequested)
+        {
+            log.Info(CommandLineParser.Usage);
+            return SuccessExitCode;
+        }
+
+        if (parsed.Request is null)
+        {
+            log.Error(parsed.ErrorMessage ?? "The command line could not be interpreted.");
+            log.Error(CommandLineParser.Usage);
+            return FailureExitCode;
+        }
+
+        try
+        {
+            BatchFactory.Create(log).Run(parsed.Request);
+            return SuccessExitCode;
+        }
+        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)
+        {
+            log.Error("Reconciliation failed: " + exception.Message);
+            return FailureExitCode;
+        }
+    }
+}
