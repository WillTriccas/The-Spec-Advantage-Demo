index 0000000..204a453
--- /dev/null
+++ b/LegacyTradeReconciliation/Infrastructure/InputSignatureCalculator.cs
@@ -0,0 +1,52 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using LegacyTradeReconciliation.Abstractions;
+using LegacyTradeReconciliation.Configuration;
+
+namespace LegacyTradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Derives the content signature that makes an exact rerun idempotent.
+/// </summary>
+/// <remarks>
+/// <para>
+/// The signature covers the business date plus the name and full content of every file in
+/// the input directory. Re-running the batch with byte-identical inputs therefore leaves
+/// the published artefacts and the ledger untouched, which is what lets Trade Operations
+/// safely retry a failed overnight schedule.
+/// </para>
+/// <para>
+/// The payload layout, including the use of <see cref="Environment.NewLine"/>, is part of
+/// the observable contract: the resulting hash is published in <c>run-ledger.csv</c>, so it
+/// is reproduced exactly rather than "tidied up".
+/// </para>
+/// </remarks>
+public sealed class InputSignatureCalculator : IInputSignatureCalculator
+{
+    public string Calculate(RunRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        if (!Directory.Exists(request.InputDirectory))
+        {
+            throw new DirectoryNotFoundException($"Input directory '{request.InputDirectory}' does not exist.");
+        }
+
+        var payload = new StringBuilder();
+        payload.AppendLine(request.BusinessDate.ToString(CsvFieldFormat.DateFormat, CultureInfo.InvariantCulture));
+
+        IOrderedEnumerable<string> inputFiles = Directory
+            .GetFiles(request.InputDirectory)
+            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase);
+
+        foreach (string filePath in inputFiles)
+        {
+            payload.AppendLine(Path.GetFileName(filePath));
+            payload.AppendLine(File.ReadAllText(filePath));
+        }
+
+        byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+        return Convert.ToHexString(hash).ToLowerInvariant();
+    }
+}
