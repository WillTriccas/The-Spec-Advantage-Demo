+++ b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
@@ -0,0 +1,191 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using TradeRecon.Application.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditWorkflowTests
+{
+    [Fact]
+    public void ProposeAndDecide_ProduceOrderedHashChain()
+    {
+        var stateDirectory = CreateStateDirectory();
+        try
+        {
+            var initialize = AuditWorkflow.Initialize(stateDirectory);
+            Assert.True((bool?)initialize.GetType().GetProperty("ok")?.GetValue(initialize) == true);
+
+            var propose = AuditWorkflow.Propose(
+                stateDirectory,
+                "REQ-001",
+                "maker-a",
+                "2024-06-03",
+                "Break is due to ACC001 mismatch.",
+                "Evidence: ACC001 settlement amount 12345.67");
+            var proposalDoc = JsonDocument.Parse(JsonSerializer.Serialize(propose));
+            Assert.Equal("PROPOSED", proposalDoc.RootElement.GetProperty("action").GetString());
+            Assert.Equal(1, proposalDoc.RootElement.GetProperty("sequence").GetInt32());
+            Assert.DoesNotContain("ACC001", JsonSerializer.Serialize(propose));
+            Assert.DoesNotContain("12345.67", JsonSerializer.Serialize(propose));
+
+            var decision = AuditWorkflow.Decide(stateDirectory, "REQ-001", "checker-b", "APPROVED");
+            var decisionDoc = JsonDocument.Parse(JsonSerializer.Serialize(decision));
+            Assert.Equal("APPROVED", decisionDoc.RootElement.GetProperty("action").GetString());
+            Assert.Equal("checker-b", decisionDoc.RootElement.GetProperty("actor").GetString());
+            Assert.Equal(2, decisionDoc.RootElement.GetProperty("sequence").GetInt32());
+
+            var exportPath = Path.Combine(stateDirectory, "audit-export.json");
+            var export = AuditWorkflow.Export(stateDirectory, "2024-06-03", "2024-06-03", exportPath);
+            var exportDoc = JsonDocument.Parse(JsonSerializer.Serialize(export));
+            var entries = exportDoc.RootElement.GetProperty("entries");
+            Assert.Equal(2, entries.GetArrayLength());
+
+            string? previousHash = null;
+            foreach (var entry in entries.EnumerateArray())
+            {
+                var sequence = entry.GetProperty("sequence").GetInt32();
+                Assert.Equal(sequence, sequence);
+                var currentHash = entry.GetProperty("hash").GetString();
+                if (previousHash is not null)
+                {
+                    Assert.Equal(previousHash, entry.GetProperty("previousHash").GetString());
+                }
+                else
+                {
+                    Assert.Equal(JsonValueKind.Null, entry.GetProperty("previousHash").ValueKind);
+                }
+
+                var payload = new
+                {
+                    sequence = entry.GetProperty("sequence").GetInt32(),
+                    timestamp = entry.GetProperty("timestamp").GetString(),
+                    requestId = entry.GetProperty("requestId").GetString(),
+                    action = entry.GetProperty("action").GetString(),
+                    actor = entry.GetProperty("actor").GetString(),
+                    proposer = entry.GetProperty("proposer").GetString(),
+                    checker = entry.TryGetProperty("checker", out var checkerElement) ? checkerElement.GetString() : null,
+                    businessDate = entry.GetProperty("businessDate").GetString(),
+                    reason = entry.GetProperty("reason").GetString(),
+                    evidence = entry.GetProperty("evidence").GetString(),
+                    previousHash = entry.GetProperty("previousHash").ValueKind == JsonValueKind.Null ? null : entry.GetProperty("previousHash").GetString(),
+                    version = entry.GetProperty("version").GetInt32()
+                };
+
+                var canonical = CanonicalJson(payload);
+                using var sha = SHA256.Create();
+                var computedHash = Convert.ToHexString(sha.ComputeHash(Encoding.UTF8.GetBytes(canonical))).ToLowerInvariant();
+                Assert.Equal(computedHash, currentHash);
+                previousHash = currentHash;
+            }
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
