+    [Fact]
+    public void RepeatedApproval_IsIdempotent()
+    {
+        var stateDirectory = CreateStateDirectory();
+        try
+        {
+            AuditWorkflow.Propose(stateDirectory, "REQ-003", "maker-a", "2024-06-03", "Reason", "Evidence");
+            var first = AuditWorkflow.Decide(stateDirectory, "REQ-003", "checker-b", "APPROVED");
+            var second = AuditWorkflow.Decide(stateDirectory, "REQ-003", "checker-b", "APPROVED");
+
+            var firstDoc = JsonDocument.Parse(JsonSerializer.Serialize(first));
+            var secondDoc = JsonDocument.Parse(JsonSerializer.Serialize(second));
+            Assert.False(firstDoc.RootElement.GetProperty("idempotent").GetBoolean());
+            Assert.True(secondDoc.RootElement.GetProperty("idempotent").GetBoolean());
+
+            var export = AuditWorkflow.Export(stateDirectory, "2024-06-03", "2024-06-03", Path.Combine(stateDirectory, "export.json"));
+            var exportDoc = JsonDocument.Parse(JsonSerializer.Serialize(export));
+            Assert.Equal(2, exportDoc.RootElement.GetProperty("count").GetInt32());
+            var approvedEntries = exportDoc.RootElement.GetProperty("entries").EnumerateArray().Where(item => item.GetProperty("action").GetString() == "APPROVED").ToList();
+            Assert.Single(approvedEntries);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
