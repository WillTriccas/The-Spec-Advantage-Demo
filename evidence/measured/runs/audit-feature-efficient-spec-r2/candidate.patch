+    private static Task<int> RunAuditCommandAsync(string[] args)
+    {
+        if (args.Length == 0 || args[0].Equals("--help", StringComparison.OrdinalIgnoreCase) || args[0].Equals("-h", StringComparison.OrdinalIgnoreCase))
+        {
+            var usage = JsonSerializer.Serialize(new
+            {
+                ok = true,
+                action = "audit-help",
+                usage = "TradeRecon.Console audit <initialize|propose|decide|export> ..."
+            });
+            System.Console.Out.WriteLine(usage);
+            return Task.FromResult(ExitClean);
+        }
+
+        try
+        {
+            var command = args[0];
+            var result = command switch
+            {
+                "initialize" => AuditWorkflow.Initialize(RequireArgument(args, 1, "stateDirectory")),
+                "propose" => AuditWorkflow.Propose(
+                    RequireArgument(args, 1, "stateDirectory"),
+                    RequireArgument(args, 2, "requestId"),
+                    RequireArgument(args, 3, "proposer"),
+                    RequireArgument(args, 4, "businessDate"),
+                    RequireArgument(args, 5, "reason"),
+                    RequireArgument(args, 6, "evidence")),
+                "decide" => AuditWorkflow.Decide(
+                    RequireArgument(args, 1, "stateDirectory"),
+                    RequireArgument(args, 2, "requestId"),
+                    RequireArgument(args, 3, "approver"),
+                    RequireArgument(args, 4, "decision")),
+                "export" => AuditWorkflow.Export(
+                    RequireArgument(args, 1, "stateDirectory"),
+                    RequireArgument(args, 2, "fromDate"),
+                    RequireArgument(args, 3, "toDate"),
+                    RequireArgument(args, 4, "exportPath")),
+                _ => new { ok = false, action = command, error = $"Unknown audit command '{command}'." }
+            };
+
+            var payload = JsonSerializer.Serialize(result);
+            System.Console.Out.WriteLine(payload);
+            return Task.FromResult((bool?)result.GetType().GetProperty("ok")?.GetValue(result) == true ? ExitClean : ExitError);
+        }
+        catch (Exception ex)
+        {
+            var payload = JsonSerializer.Serialize(new
+            {
+                ok = false,
+                action = "audit",
+                error = ex.Message
+            });
+            System.Console.Error.WriteLine(payload);
+            return Task.FromResult(ExitError);
+        }
+    }
+
+    private static string RequireArgument(string[] args, int index, string name)
+    {
+        if (args.Length <= index)
+        {
+            throw new ArgumentException($"Missing required argument '{name}'.");
+        }
+
+        return args[index];
+    }
+
     private sealed record CliOptions(
         DateOnly BusinessDate,
         string FixturesDirectory,
diff --git a/tests/TradeRecon.Tests/AuditWorkflowTests.cs b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
