+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://example.com/schemas/audit-adapter.schema.json",
+  "title": "Audit Adapter Contract",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "workingDirectory", "commands"],
+  "properties": {
+    "schemaVersion": {
+      "type": "string",
+      "minLength": 1
+    },
+    "workingDirectory": {
+      "type": "string",
+      "minLength": 1
+    },
+    "commands": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["initialize", "propose", "decide", "export"],
+      "properties": {
+        "initialize": {
+          "$ref": "#/$defs/command"
+        },
+        "propose": {
+          "$ref": "#/$defs/command"
+        },
+        "decide": {
+          "$ref": "#/$defs/command"
+        },
+        "export": {
+          "$ref": "#/$defs/command"
+        }
+      }
+    }
+  },
+  "$defs": {
+    "command": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["executable", "arguments"],
+      "properties": {
+        "executable": {
+          "type": "string",
+          "minLength": 1
+        },
+        "arguments": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "allowedExitCodes": {
+          "type": "array",
+          "items": {
+            "type": "integer"
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditWorkflow.cs b/src/TradeRecon.Application/Audit/AuditWorkflow.cs
new file mode 100644
index 0000000..8930f9c
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditWorkflow.cs
@@ -0,0 +1,471 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Application.Audit;
+
+public static partial class AuditWorkflow
+{
+    private const string StateFileName = "audit-history.json";
+    private static readonly JsonSerializerOptions StateJsonOptions = new()
+    {
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+        WriteIndented = true,
+        PropertyNamingPolicy = null
+    };
+
+    private static readonly Regex AccountPattern = new(
+        @"(?<![A-Za-z0-9])(?:[A-Z]{2,}[A-Z0-9-]{2,}[0-9][A-Z0-9-]*|[A-Z]{3,}[0-9]{3,})(?![A-Za-z0-9])",
+        RegexOptions.Compiled | RegexOptions.CultureInvariant | RegexOptions.IgnoreCase);
+
+    private static readonly Regex AmountPattern = new(
+        @"(?<![A-Za-z0-9])(?:[$€£¥]?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?)(?:\s*(?:USD|EUR|GBP|JPY|AUD|CAD|CHF|CNY|SEK|NOK|NZD|HKD|SGD))?(?![A-Za-z0-9])",
+        RegexOptions.Compiled | RegexOptions.CultureInvariant | RegexOptions.IgnoreCase);
+
+    public static object Initialize(string stateDirectory)
+    {
+        var resolvedDirectory = EnsureStateDirectory(stateDirectory);
+        var state = LoadState(resolvedDirectory);
+        return new
+        {
+            ok = true,
+            action = "initialize",
+            stateDirectory = resolvedDirectory,
+            entries = state.Entries.Count,
+            version = state.Version
+        };
+    }
+
+    public static object Propose(
+        string stateDirectory,
+        string requestId,
+        string proposer,
+        string businessDate,
+        string reason,
+        string evidence)
+    {
+        if (string.IsNullOrWhiteSpace(requestId) ||
+            string.IsNullOrWhiteSpace(proposer) ||
+            string.IsNullOrWhiteSpace(businessDate))
+        {
+            return ErrorResult("propose", "requestId, proposer, and businessDate are required.");
+        }
+
+        if (!TryParseBusinessDate(businessDate, out var parsedDate))
+        {
+            return ErrorResult("propose", "businessDate must use yyyy-MM-dd format.");
+        }
+
+        var sanitizedReason = SanitizeForAudit(reason);
+        var sanitizedEvidence = SanitizeForAudit(evidence);
+        if (string.IsNullOrWhiteSpace(sanitizedReason))
+        {
+            return ErrorResult("propose", "Reason is required.");
+        }
+
+        if (string.IsNullOrWhiteSpace(sanitizedEvidence))
+        {
+            return ErrorResult("propose", "Evidence is required.");
+        }
+
+        using var lockHandle = AcquireLock(stateDirectory);
+        var state = LoadState(stateDirectory);
+
+        var currentDecision = state.Entries.LastOrDefault(item =>
+            string.Equals(item.RequestId, requestId, StringComparison.Ordinal) &&
+            (item.Action == "APPROVED" || item.Action == "REJECTED"));
+        if (currentDecision is not null)
+        {
+            return ErrorResult("propose", "A final decision already exists for this request.");
+        }
+
+        var existingProposal = state.Entries.LastOrDefault(item =>
+            string.Equals(item.RequestId, requestId, StringComparison.Ordinal) &&
+            item.Action == "PROPOSED");
+        if (existingProposal is not null)
+        {
+            return SuccessResult(existingProposal, true);
+        }
+
+        var entry = CreateEntry(
+            state,
+            requestId,
+            "PROPOSED",
+            proposer,
+            businessDate,
+            sanitizedReason,
+            sanitizedEvidence,
+            proposer,
+            null);
+
+        state.Entries.Add(entry);
+        PersistState(stateDirectory, state);
+        return SuccessResult(entry, false);
+    }
+
+    public static object Decide(
+        string stateDirectory,
+        string requestId,
+        string approver,
+        string decision)
+    {
+        if (string.IsNullOrWhiteSpace(requestId) || string.IsNullOrWhiteSpace(approver))
+        {
+            return ErrorResult("decide", "requestId and approver are required.");
+        }
+
+        if (!string.Equals(decision, "APPROVED", StringComparison.OrdinalIgnoreCase) &&
+            !string.Equals(decision, "REJECTED", StringComparison.OrdinalIgnoreCase))
+        {
+            return ErrorResult("decide", "Decision must be APPROVED or REJECTED.");
+        }
+
+        using var lockHandle = AcquireLock(stateDirectory);
+        var state = LoadState(stateDirectory);
+
+        var existingFinalDecision = state.Entries.LastOrDefault(item =>
+            string.Equals(item.RequestId, requestId, StringComparison.Ordinal) &&
+            (item.Action == "APPROVED" || item.Action == "REJECTED"));
+        if (existingFinalDecision is not null)
+        {
+            if (string.Equals(existingFinalDecision.Action, decision, StringComparison.OrdinalIgnoreCase))
+            {
+                return SuccessResult(existingFinalDecision, true);
+            }
+
+            return new
+            {
+                ok = true,
+                action = "decide",
+                requestId,
+                decision = existingFinalDecision.Action,
+                actor = existingFinalDecision.Actor,
+                finalDecision = existingFinalDecision.Action,
+                idempotent = true,
+                conflict = true
+            };
+        }
+
+        var proposal = state.Entries.LastOrDefault(item =>
+            string.Equals(item.RequestId, requestId, StringComparison.Ordinal) &&
+            item.Action == "PROPOSED");
+        if (proposal is null)
+        {
+            return ErrorResult("decide", "No proposal exists for this request.");
+        }
+
+        if (string.Equals(proposal.Proposer, approver, StringComparison.Ordinal))
+        {
+            return ErrorResult("decide", "Self-approval is not permitted.");
+        }
+
+        var entry = CreateEntry(
+            state,
+            requestId,
+            decision.ToUpperInvariant(),
+            approver,
+            proposal.BusinessDate ?? string.Empty,
+            proposal.Reason ?? string.Empty,
+            proposal.Evidence ?? string.Empty,
+            proposal.Proposer,
+            approver);
+
+        state.Entries.Add(entry);
+        PersistState(stateDirectory, state);
+        return SuccessResult(entry, false);
+    }
+
+    public static object Export(string stateDirectory, string fromDate, string toDate, string exportPath)
+    {
+        if (!TryParseBusinessDate(fromDate, out var from) || !TryParseBusinessDate(toDate, out var to))
+        {
+            return ErrorResult("export", "fromDate and toDate must both use yyyy-MM-dd format.");
+        }
+
+        using var lockHandle = AcquireLock(stateDirectory);
+        var state = LoadState(stateDirectory);
+
+        var entries = state.Entries
+            .Where(item => TryParseBusinessDate(item.BusinessDate ?? string.Empty, out var itemDate) && itemDate >= from && itemDate <= to)
+            .Select(ToExportRecord)
+            .ToList();
+
+        var payload = new
+        {
+            ok = true,
+            action = "export",
+            fromDate,
+            toDate,
+            count = entries.Count,
+            entries
+        };
+
+        var serialized = JsonSerializer.Serialize(payload, StateJsonOptions);
+
+        if (!string.IsNullOrWhiteSpace(exportPath))
+        {
+            var directory = Path.GetDirectoryName(exportPath);
+            if (!string.IsNullOrWhiteSpace(directory))
+            {
+                Directory.CreateDirectory(directory);
+            }
+
+            File.WriteAllText(exportPath, serialized + Environment.NewLine, Encoding.UTF8);
+        }
+
+        return payload;
+    }
+
+    private static string EnsureStateDirectory(string stateDirectory)
+    {
+        var directory = string.IsNullOrWhiteSpace(stateDirectory)
+            ? Path.Combine(Path.GetTempPath(), "trade-recon-audit")
+            : Path.GetFullPath(stateDirectory);
+
+        Directory.CreateDirectory(directory);
+        return directory;
+    }
+
+    private static FileStream AcquireLock(string stateDirectory)
+    {
+        var directory = EnsureStateDirectory(stateDirectory);
+        var lockPath = Path.Combine(directory, "audit-workflow.lock");
+        return new FileStream(lockPath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+    }
+
+    private static AuditState LoadState(string stateDirectory)
+    {
+        var directory = EnsureStateDirectory(stateDirectory);
+        var statePath = Path.Combine(directory, StateFileName);
+
+        if (!File.Exists(statePath))
+        {
+            var newState = new AuditState();
+            PersistState(directory, newState);
+            return newState;
+        }
+
+        using var stream = File.OpenRead(statePath);
+        var state = JsonSerializer.Deserialize<AuditState>(stream, StateJsonOptions) ?? new AuditState();
+        if (state.Entries is null)
+        {
+            state.Entries = new List<AuditEntry>();
+        }
+
+        state.Version ??= 1;
+        return state;
+    }
+
+    private static void PersistState(string stateDirectory, AuditState state)
+    {
+        var directory = EnsureStateDirectory(stateDirectory);
+        var statePath = Path.Combine(directory, StateFileName);
+        var tempPath = statePath + ".tmp";
+        var json = JsonSerializer.Serialize(state, StateJsonOptions);
+        File.WriteAllText(tempPath, json + Environment.NewLine, Encoding.UTF8);
+        File.Move(tempPath, statePath, overwrite: true);
+    }
+
+    private static AuditEntry CreateEntry(
+        AuditState state,
+        string requestId,
+        string action,
+        string actor,
+        string businessDate,
+        string reason,
+        string evidence,
+        string? proposer,
+        string? checker)
+    {
+        var sequence = state.Entries.Count + 1;
+        var timestamp = DateTimeOffset.UtcNow.ToString("O", CultureInfo.InvariantCulture);
+        var previousHash = state.Entries.Count == 0 ? null : state.Entries[^1].Hash;
+        var entry = new AuditEntry
+        {
+            Sequence = sequence,
+            Timestamp = timestamp,
+            RequestId = requestId,
+            Action = action,
+            Actor = actor,
+            Proposer = proposer,
+            Checker = checker,
+            BusinessDate = businessDate,
+            Reason = reason,
+            Evidence = evidence,
+            PreviousHash = previousHash,
+            Version = state.Version ?? 1
+        };
+
+        entry.Hash = ComputeHash(entry);
+        return entry;
+    }
+
+    private static object SuccessResult(AuditEntry entry, bool idempotent)
+    {
+        return new
+        {
+            ok = true,
+            action = entry.Action,
+            requestId = entry.RequestId,
+            actor = entry.Actor,
+            proposer = entry.Proposer,
+            checker = entry.Checker,
+            businessDate = entry.BusinessDate,
+            reason = entry.Reason,
+            evidence = entry.Evidence,
+            sequence = entry.Sequence,
+            timestamp = entry.Timestamp,
+            previousHash = entry.PreviousHash,
+            hash = entry.Hash,
+            version = entry.Version,
+            idempotent
+        };
+    }
+
+    private static object ErrorResult(string action, string message)
+    {
+        return new
+        {
+            ok = false,
+            action,
+            error = SanitizeForAudit(message)
+        };
+    }
+
+    private static object ToExportRecord(AuditEntry entry)
+    {
+        return new
+        {
+            sequence = entry.Sequence,
+            timestamp = entry.Timestamp,
+            requestId = entry.RequestId,
+            action = entry.Action,
+            actor = entry.Actor,
+            proposer = entry.Proposer,
+            checker = entry.Checker,
+            businessDate = entry.BusinessDate,
+            reason = entry.Reason,
+            evidence = entry.Evidence,
+            previousHash = entry.PreviousHash,
+            hash = entry.Hash,
+            version = entry.Version
+        };
+    }
+
+    private static string ComputeHash(AuditEntry entry)
+    {
+        var payload = new
+        {
+            sequence = entry.Sequence,
+            timestamp = entry.Timestamp,
+            requestId = entry.RequestId,
+            action = entry.Action,
+            actor = entry.Actor,
+            proposer = entry.Proposer,
+            checker = entry.Checker,
+            businessDate = entry.BusinessDate,
+            reason = entry.Reason,
+            evidence = entry.Evidence,
+            previousHash = entry.PreviousHash,
+            version = entry.Version
+        };
+
+        var canonical = CanonicalJson(payload);
+        using var sha256 = SHA256.Create();
+        var hashBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(canonical));
+        return Convert.ToHexString(hashBytes).ToLowerInvariant();
+    }
+
+    private static string CanonicalJson(object value)
+    {
+        var element = JsonSerializer.SerializeToElement(value);
+        return CanonicalizeJsonElement(element);
+    }
+
+    private static string CanonicalizeJsonElement(JsonElement element)
+    {
+        return element.ValueKind switch
+        {
+            JsonValueKind.Object => "{" + string.Join(",", element.EnumerateObject().OrderBy(pair => pair.Name, StringComparer.Ordinal).Select(pair => JsonSerializer.Serialize(pair.Name) + ":" + CanonicalizeJsonElement(pair.Value))) + "}",
+            JsonValueKind.Array => "[" + string.Join(",", element.EnumerateArray().Select(CanonicalizeJsonElement)) + "]",
+            JsonValueKind.String => JsonSerializer.Serialize(element.GetString() ?? string.Empty),
+            JsonValueKind.Number => element.GetRawText(),
+            JsonValueKind.True => "true",
+            JsonValueKind.False => "false",
+            JsonValueKind.Null => "null",
+            _ => "null"
+        };
+    }
+
+    private static string SanitizeForAudit(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return string.Empty;
+        }
+
+        var sanitized = value;
+        sanitized = AccountPattern.Replace(sanitized, "[ACCOUNT]");
+        sanitized = AmountPattern.Replace(sanitized, "[AMOUNT]");
+        return sanitized.Trim();
+    }
+
+    private static bool TryParseBusinessDate(string? value, out DateOnly businessDate)
+    {
+        return DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out businessDate);
+    }
+}
+
+public sealed class AuditState
+{
+    [JsonPropertyName("version")]
+    public int? Version { get; set; } = 1;
+
+    [JsonPropertyName("entries")]
+    public List<AuditEntry> Entries { get; set; } = new();
+}
+
+public sealed class AuditEntry
+{
+    [JsonPropertyName("sequence")]
+    public int Sequence { get; set; }
+
+    [JsonPropertyName("timestamp")]
+    public string Timestamp { get; set; } = string.Empty;
+
+    [JsonPropertyName("requestId")]
+    public string RequestId { get; set; } = string.Empty;
+
+    [JsonPropertyName("action")]
+    public string Action { get; set; } = string.Empty;
+
+    [JsonPropertyName("actor")]
+    public string Actor { get; set; } = string.Empty;
+
+    [JsonPropertyName("proposer")]
+    public string? Proposer { get; set; }
+
+    [JsonPropertyName("checker")]
+    public string? Checker { get; set; }
+
+    [JsonPropertyName("businessDate")]
+    public string? BusinessDate { get; set; }
+
+    [JsonPropertyName("reason")]
+    public string? Reason { get; set; }
+
+    [JsonPropertyName("evidence")]
+    public string? Evidence { get; set; }
+
+    [JsonPropertyName("previousHash")]
+    public string? PreviousHash { get; set; }
+
+    [JsonPropertyName("hash")]
+    public string Hash { get; set; } = string.Empty;
+
+    [JsonPropertyName("version")]
+    public int Version { get; set; } = 1;
+}
