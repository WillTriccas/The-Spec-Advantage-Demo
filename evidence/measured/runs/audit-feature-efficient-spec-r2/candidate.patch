+    [Fact]
+    public void ConflictingDecisions_KeepSingleFinalDecision()
+    {
+        var stateDirectory = CreateStateDirectory();
+        try
+        {
+            AuditWorkflow.Propose(stateDirectory, "REQ-004", "maker-a", "2024-06-03", "Reason", "Evidence");
+            var approve = AuditWorkflow.Decide(stateDirectory, "REQ-004", "checker-b", "APPROVED");
+            var reject = AuditWorkflow.Decide(stateDirectory, "REQ-004", "checker-c", "REJECTED");
+
+            var approveDoc = JsonDocument.Parse(JsonSerializer.Serialize(approve));
+            var rejectDoc = JsonDocument.Parse(JsonSerializer.Serialize(reject));
+            Assert.Equal("APPROVED", approveDoc.RootElement.GetProperty("action").GetString());
+            Assert.True(rejectDoc.RootElement.GetProperty("conflict").GetBoolean());
+
+            var export = AuditWorkflow.Export(stateDirectory, "2024-06-03", "2024-06-03", Path.Combine(stateDirectory, "export.json"));
+            var exportDoc = JsonDocument.Parse(JsonSerializer.Serialize(export));
+            var finalEntries = exportDoc.RootElement.GetProperty("entries").EnumerateArray().Where(item => item.GetProperty("action").GetString() == "APPROVED" || item.GetProperty("action").GetString() == "REJECTED").ToList();
+            Assert.Single(finalEntries);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    private static string CreateStateDirectory()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "audit-tests-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        return directory;
+    }
+
+    private static string CanonicalJson(object value)
+    {
+        var element = JsonSerializer.SerializeToElement(value);
+        return CanonicalizeJsonElement(element);
+    }
+
+    private static string CanonicalizeJsonElement(JsonElement element)
+    {
+        return element.ValueKind switch
+        {
+            JsonValueKind.Object => "{" + string.Join(",", element.EnumerateObject().OrderBy(pair => pair.Name, StringComparer.Ordinal).Select(pair => JsonSerializer.Serialize(pair.Name) + ":" + CanonicalizeJsonElement(pair.Value))) + "}",
+            JsonValueKind.Array => "[" + string.Join(",", element.EnumerateArray().Select(CanonicalizeJsonElement)) + "]",
+            JsonValueKind.String => JsonSerializer.Serialize(element.GetString() ?? string.Empty),
+            JsonValueKind.Number => element.GetRawText(),
+            JsonValueKind.True => "true",
+            JsonValueKind.False => "false",
+            JsonValueKind.Null => "null",
+            _ => "null"
+        };
+    }
