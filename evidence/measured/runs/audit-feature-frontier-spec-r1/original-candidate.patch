@@ -0,0 +1,143 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+using AuditProgram = TradeRecon.AuditConsole.Program;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Black-box behaviour of the audit adapter commands: every declared exit code returns a
+/// parseable JSON document and the workflow rules hold across separate command invocations
+/// (REQ-1, NFR-5).
+/// </summary>
+public class AuditCliContractTests
+{
+    [Fact]
+    public void Initialize_ReturnsParseableJsonAndCreatesDurableState()
+    {
+        using var temp = new TempState();
+
+        var (exitCode, payload, stderr) = Run("initialize", "--state", temp.StateDirectory);
+
+        Assert.Equal(AuditProgram.ExitOk, exitCode);
+        Assert.Equal("initialized", (string?)payload["status"]);
+        Assert.True((bool?)payload["ok"]);
+        Assert.True(File.Exists(Path.Combine(temp.StateDirectory, "audit", "ledger.jsonl")));
+        Assert.DoesNotContain("Exception", stderr, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void FullLifecycle_AcrossSeparateInvocations_ProducesOneFinalDecision()
+    {
+        using var temp = new TempState();
+
+        Assert.Equal(AuditProgram.ExitOk, Run("initialize", "--state", temp.StateDirectory).ExitCode);
+
+        var proposed = Run(
+            "propose", "--state", temp.StateDirectory, "--request-id", "req-1", "--proposer", "maker-a",
+            "--business-date", "2024-06-03", "--reason", "timing difference", "--evidence", "ticket AUD-4471");
+        Assert.Equal(AuditProgram.ExitOk, proposed.ExitCode);
+        Assert.Equal("accepted", (string?)proposed.Payload["status"]);
+
+        var selfApproval = Run(
+            "decide", "--state", temp.StateDirectory, "--request-id", "req-1",
+            "--approver", "maker-a", "--decision", "approve");
+        Assert.Equal(AuditProgram.ExitRejected, selfApproval.ExitCode);
+        Assert.Equal("self_approval_forbidden", (string?)selfApproval.Payload["reason"]);
+
+        var approved = Run(
+            "decide", "--state", temp.StateDirectory, "--request-id", "req-1",
+            "--approver", "checker-b", "--decision", "approve");
+        Assert.Equal(AuditProgram.ExitOk, approved.ExitCode);
+        Assert.Equal("accepted", (string?)approved.Payload["status"]);
+
+        var repeat = Run(
+            "decide", "--state", temp.StateDirectory, "--request-id", "req-1",
+            "--approver", "checker-b", "--decision", "approve");
+        Assert.Equal(AuditProgram.ExitOk, repeat.ExitCode);
+        Assert.Equal("idempotent", (string?)repeat.Payload["status"]);
+
+        var exported = Run(
+            "export", "--state", temp.StateDirectory, "--from", "2024-06-01",
+            "--to", "2024-06-30", "--export-path", temp.ExportPath);
+        Assert.Equal(AuditProgram.ExitOk, exported.ExitCode);
+
+        var fromFile = JsonNode.Parse(File.ReadAllText(temp.ExportPath))!;
+        var entries = AuditTestSupport.EntryObjects(fromFile).ToList();
+
+        Assert.Equal(2, entries.Count);
+        var terminal = Assert.Single(entries, e => AuditAction.IsTerminal((string?)e["action"]));
+        Assert.Equal("checker-b", (string?)terminal["checker"]);
+        Assert.Equal("maker-a", (string?)terminal["proposer"]);
+        AuditWorkflowTests.AssertChainIsIntact(entries);
+
+        var fromStdout = AuditTestSupport.EntryObjects(exported.Payload).ToList();
+        Assert.Equal(entries.Count, fromStdout.Count);
+    }
+
+    [Theory]
+    [InlineData("initialize")]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    public void EveryCommand_WithoutStateDirectory_StillReturnsParseableJson(string command)
+    {
+        var (exitCode, payload, _) = Run(command);
+
+        Assert.Equal(AuditProgram.ExitError, exitCode);
+        Assert.Equal("rejected", (string?)payload["status"]);
+        Assert.False((bool?)payload["ok"]);
+    }
+
+    [Fact]
+    public void UnknownCommand_ReturnsParseableJsonAndUsageExitCode()
+    {
+        using var temp = new TempState();
+
+        var (exitCode, payload, _) = Run("resolve", "--state", temp.StateDirectory);
+
+        Assert.Equal(AuditProgram.ExitError, exitCode);
+        Assert.Equal("unknown_command", (string?)payload["reason"]);
+    }
+
+    [Fact]
+    public void UnknownOption_ReturnsParseableJsonAndUsageExitCode()
+    {
+        using var temp = new TempState();
+
+        var (exitCode, payload, _) = Run("propose", "--state", temp.StateDirectory, "--account", "ACC001");
+
+        Assert.Equal(AuditProgram.ExitError, exitCode);
+        Assert.Equal("invalid_arguments", (string?)payload["reason"]);
+        Assert.DoesNotContain("ACC001", payload.ToJsonString(), StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Propose_WithOmittedOptionValues_IsRefusedWithoutDurableHistory()
+    {
+        using var temp = new TempState();
+
+        var (exitCode, payload, _) = Run(
+            "propose", "--state", temp.StateDirectory, "--request-id", "req-1", "--proposer", "maker-a",
+            "--business-date", "2024-06-03", "--reason", "--evidence");
+
+        Assert.Equal(AuditProgram.ExitRejected, exitCode);
+        Assert.Equal("empty_reason", (string?)payload["reason"]);
+
+        var export = Run(
+            "export", "--state", temp.StateDirectory, "--from", "2024-06-01",
+            "--to", "2024-06-30", "--export-path", temp.ExportPath);
+        Assert.Empty(AuditTestSupport.EntryObjects(export.Payload));
+    }
+
+    private static CommandRun Run(params string[] args)
+    {
+        var stdout = new StringWriter();
+        var stderr = new StringWriter();
+        var exitCode = AuditProgram.Run(args, stdout, stderr);
+        var payload = JsonNode.Parse(stdout.ToString())!.AsObject();
+        return new CommandRun(exitCode, payload, stderr.ToString());
+    }
+
+    private sealed record CommandRun(int ExitCode, JsonObject Payload, string Stderr);
+}
