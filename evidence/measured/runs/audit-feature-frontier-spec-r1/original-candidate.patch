+using System.Globalization;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Deterministic UTC timestamp source for lifecycle entries.</summary>
+public static class AuditClock
+{
+    /// <summary>Current UTC instant formatted as an ISO-8601 timestamp with millisecond precision.</summary>
+    public static string UtcNowIso8601()
+        => DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture);
+}
diff --git a/src/TradeRecon.Audit/AuditLedgerStore.cs b/src/TradeRecon.Audit/AuditLedgerStore.cs
new file mode 100644
index 0000000..ddc1201
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditLedgerStore.cs
@@ -0,0 +1,201 @@
+using System.Diagnostics;
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// File-backed, append-only lifecycle ledger.
+///
+/// Durable state lives beneath the evaluator-owned state directory so it survives across
+/// separate command processes:
+/// <code>
+/// {stateDirectory}/audit/ledger.jsonl   one canonical JSON entry per line, append only
+/// {stateDirectory}/audit/metadata.json  workflow metadata written by initialize
+/// {stateDirectory}/audit/.lock          cross-process mutual exclusion for read-modify-append
+/// </code>
+/// Entries are never rewritten or removed; later state is represented only by later entries
+/// (INV-2). A conditional append is performed under an exclusive lock on the lock file so two
+/// concurrent processes cannot both write a terminal decision for the same request (INV-3).
+/// </summary>
+public sealed class AuditLedgerStore
+{
+    /// <summary>Ledger schema version emitted on every entry.</summary>
+    public const string SchemaVersion = "1.0";
+
+    private static readonly TimeSpan DefaultLockTimeout = TimeSpan.FromSeconds(60);
+    private static readonly UTF8Encoding Utf8NoBom = new(encoderShouldEmitUTF8Identifier: false);
+
+    private readonly string _auditDirectory;
+
+    public AuditLedgerStore(string stateDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+        StateDirectory = Path.GetFullPath(stateDirectory);
+        _auditDirectory = Path.Combine(StateDirectory, "audit");
+        LedgerPath = Path.Combine(_auditDirectory, "ledger.jsonl");
+        MetadataPath = Path.Combine(_auditDirectory, "metadata.json");
+        LockPath = Path.Combine(_auditDirectory, ".lock");
+    }
+
+    /// <summary>Evaluator-owned root state directory.</summary>
+    public string StateDirectory { get; }
+
+    /// <summary>Absolute path of the append-only ledger file.</summary>
+    public string LedgerPath { get; }
+
+    /// <summary>Absolute path of the workflow metadata document.</summary>
+    public string MetadataPath { get; }
+
+    /// <summary>Absolute path of the cross-process lock file.</summary>
+    public string LockPath { get; }
+
+    /// <summary>
+    /// Creates the durable layout if required. Safe to call repeatedly and from any command,
+    /// so a caller that skips <c>initialize</c> still gets a consistent store.
+    /// </summary>
+    public void Initialize()
+    {
+        Directory.CreateDirectory(_auditDirectory);
+
+        CreateIfMissing(LedgerPath, string.Empty);
+
+        var metadata = new JsonObject
+        {
+            ["schemaVersion"] = SchemaVersion,
+            ["createdAt"] = AuditClock.UtcNowIso8601(),
+            ["ledgerFile"] = "audit/ledger.jsonl"
+        };
+
+        CreateIfMissing(MetadataPath, CanonicalJson.Serialize(metadata) + "\n");
+    }
+
+    /// <summary>
+    /// Creates <paramref name="path"/> with <paramref name="content"/> exactly once. Concurrent
+    /// initialisers race on <see cref="FileMode.CreateNew"/>; losers wait for the winner's content
+    /// instead of failing, so any command may initialise the store safely.
+    /// </summary>
+    private static void CreateIfMissing(string path, string content)
+    {
+        var stopwatch = Stopwatch.StartNew();
+
+        while (true)
+        {
+            try
+            {
+                using var stream = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+
+                if (content.Length > 0)
+                {
+                    var bytes = Utf8NoBom.GetBytes(content);
+                    stream.Write(bytes, 0, bytes.Length);
+                    stream.Flush(flushToDisk: true);
+                }
+
+                return;
+            }
+            catch (IOException) when (File.Exists(path))
+            {
+                // Another process is creating (or has created) the file. Wait for its content to land.
+                if (content.Length == 0 || new FileInfo(path).Length > 0 || stopwatch.Elapsed >= DefaultLockTimeout)
+                {
+                    return;
+                }
+
+                Thread.Sleep(2);
+            }
+            catch (UnauthorizedAccessException) when (File.Exists(path))
+            {
+                return;
+            }
+        }
+    }
+
+    /// <summary>Acquires the exclusive cross-process lock guarding conditional appends.</summary>
+    public IDisposable AcquireLock() => AcquireLock(DefaultLockTimeout);
+
+    /// <summary>Acquires the exclusive cross-process lock, waiting up to <paramref name="timeout"/>.</summary>
+    public IDisposable AcquireLock(TimeSpan timeout)
+    {
+        Directory.CreateDirectory(_auditDirectory);
+
+        var stopwatch = Stopwatch.StartNew();
+        var delayMilliseconds = 2;
+
+        while (true)
+        {
+            try
+            {
+                return new LedgerLock(new FileStream(
+                    LockPath,
+                    FileMode.OpenOrCreate,
+                    FileAccess.ReadWrite,
+                    FileShare.None,
+                    bufferSize: 1,
+                    FileOptions.None));
+            }
+            catch (IOException) when (stopwatch.Elapsed < timeout)
+            {
+                Thread.Sleep(delayMilliseconds);
+                delayMilliseconds = Math.Min(delayMilliseconds * 2, 25);
+            }
+            catch (UnauthorizedAccessException) when (stopwatch.Elapsed < timeout)
+            {
+                Thread.Sleep(delayMilliseconds);
+                delayMilliseconds = Math.Min(delayMilliseconds * 2, 25);
+            }
+        }
+    }
+
+    /// <summary>Reads every durable lifecycle entry in append (sequence) order.</summary>
+    public IReadOnlyList<JsonObject> ReadEntries()
+    {
+        if (!File.Exists(LedgerPath))
+        {
+            return Array.Empty<JsonObject>();
+        }
+
+        var entries = new List<JsonObject>();
+
+        using var stream = new FileStream(LedgerPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+        using var reader = new StreamReader(stream, Utf8NoBom);
+
+        while (reader.ReadLine() is { } line)
+        {
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            if (JsonNode.Parse(line) is JsonObject entry)
+            {
+                entries.Add(entry);
+            }
+        }
+
+        return entries;
+    }
+
+    /// <summary>
+    /// Appends a durable entry. The caller must already hold the lock returned by
+    /// <see cref="AcquireLock()"/> and must have derived sequence and previousHash from the
+    /// entries read inside that same lock.
+    /// </summary>
+    public void Append(JsonObject entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+        Directory.CreateDirectory(_auditDirectory);
+
+        var line = CanonicalJson.Serialize(entry) + "\n";
+        var payload = Utf8NoBom.GetBytes(line);
+
+        using var stream = new FileStream(LedgerPath, FileMode.Append, FileAccess.Write, FileShare.Read);
+        stream.Write(payload, 0, payload.Length);
+        stream.Flush(flushToDisk: true);
+    }
+
+    private sealed class LedgerLock(FileStream stream) : IDisposable
+    {
+        public void Dispose() => stream.Dispose();
+    }
+}
