+using System.Globalization;
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Input for the <c>propose</c> command.</summary>
+public sealed record ProposeRequest(
+    string RequestId,
+    string Proposer,
+    string BusinessDate,
+    string Reason,
+    string Evidence);
+
+/// <summary>Input for the <c>decide</c> command.</summary>
+public sealed record DecideRequest(string RequestId, string Approver, string Decision);
+
+/// <summary>Input for the <c>export</c> command.</summary>
+public sealed record ExportRequest(string FromDate, string ToDate, string ExportPath);
+
+/// <summary>
+/// Maker-checker resolution workflow over the append-only audit ledger.
+///
+/// Guarantees:
+/// <list type="bullet">
+///   <item>A proposal durably records requestId, proposer, business date, reason and evidence (REQ-2).</item>
+///   <item>A terminal decision is only appended for a checker distinct from the durable proposer (REQ-3, INV-1).</item>
+///   <item>Entries carry a contiguous 1-based sequence and a SHA-256 previous-hash chain (REQ-4).</item>
+///   <item>Repeating an accepted action is idempotent (REQ-5, INV-4) and conflicting concurrent
+///         decisions leave exactly one terminal entry (REQ-6, INV-3).</item>
+///   <item>Reason and evidence are redacted before hashing so no account or amount value reaches
+///         the ledger, stdout, diagnostics or the export (REQ-8, INV-5).</item>
+/// </list>
+/// </summary>
+public sealed class AuditWorkflowService(AuditLedgerStore store)
+{
+    private static readonly UTF8Encoding Utf8NoBom = new(encoderShouldEmitUTF8Identifier: false);
+
+    private readonly AuditLedgerStore _store = store ?? throw new ArgumentNullException(nameof(store));
+
+    /// <summary>Creates the durable workflow state beneath the evaluator-owned state directory.</summary>
+    public AuditCommandResult Initialize()
+    {
+        _store.Initialize();
+
+        var payload = Envelope("initialize", "initialized", ok: true);
+        payload["entryCount"] = _store.ReadEntries().Count;
+        return new AuditCommandResult(AuditStatus.Completed, payload);
+    }
+
+    /// <summary>Records a maker's proposed resolution for a reconciliation break.</summary>
+    public AuditCommandResult Propose(ProposeRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        var requestId = (request.RequestId ?? string.Empty).Trim();
+        var proposer = (request.Proposer ?? string.Empty).Trim();
+        var reason = (request.Reason ?? string.Empty).Trim();
+        var evidence = (request.Evidence ?? string.Empty).Trim();
+
+        if (requestId.Length == 0)
+        {
+            return Reject("propose", "invalid_request_id", "A non-empty requestId is required.", requestId: null);
+        }
+
+        if (proposer.Length == 0)
+        {
+            return Reject("propose", "invalid_proposer", "A non-empty proposer identity is required.", requestId);
+        }
+
+        if (!TryParseDate(request.BusinessDate, out var businessDate))
+        {
+            return Reject("propose", "invalid_business_date", "businessDate must be an ISO yyyy-MM-dd value.", requestId);
+        }
+
+        if (reason.Length == 0)
+        {
+            return Reject("propose", "empty_reason", "A non-empty reason is required.", requestId);
+        }
+
+        if (evidence.Length == 0)
+        {
+            return Reject("propose", "empty_evidence", "Non-empty evidence is required.", requestId);
+        }
+
+        var reasonDigest = CanonicalJson.Sha256(reason);
+        var evidenceDigest = CanonicalJson.Sha256(evidence);
+        var safeReason = SensitiveDataRedactor.Redact(reason);
+        var safeEvidence = SensitiveDataRedactor.Redact(evidence);
+        var redacted = !string.Equals(safeReason, reason, StringComparison.Ordinal)
+            || !string.Equals(safeEvidence, evidence, StringComparison.Ordinal);
+
+        _store.Initialize();
+        using var _ = _store.AcquireLock();
+
+        var entries = _store.ReadEntries();
+        var existingProposal = FindProposal(entries, requestId);
+
+        if (existingProposal is not null)
+        {
+            var samePayload = IdentityEquals(Text(existingProposal, "proposer"), proposer)
+                && string.Equals(Text(existingProposal, "businessDate"), Format(businessDate), StringComparison.Ordinal)
+                && string.Equals(Text(existingProposal, "reasonDigest"), reasonDigest, StringComparison.Ordinal)
+                && string.Equals(Text(existingProposal, "evidenceDigest"), evidenceDigest, StringComparison.Ordinal);
+
+            if (!samePayload)
+            {
+                return Reject(
+                    "propose",
+                    "request_already_exists",
+                    "A different proposal is already durable for this requestId.",
+                    requestId);
+            }
+
+            var repeat = Envelope("propose", "idempotent", ok: true);
+            Describe(repeat, existingProposal);
+            return new AuditCommandResult(AuditStatus.Idempotent, repeat);
+        }
+
+        var entry = Append(
+            entries,
+            requestId,
+            AuditAction.Proposed,
+            actor: proposer,
+            actorRole: "proposer",
+            proposer: proposer,
+            checker: null,
+            businessDate: Format(businessDate),
+            reason: safeReason,
+            reasonDigest: reasonDigest,
+            evidence: safeEvidence,
+            evidenceDigest: evidenceDigest,
+            redacted: redacted);
+
+        var payload = Envelope("propose", "accepted", ok: true);
+        Describe(payload, entry);
+        return new AuditCommandResult(AuditStatus.Accepted, payload);
+    }
+
+    /// <summary>Records the single terminal approval or rejection made by a distinct checker.</summary>
+    public AuditCommandResult Decide(DecideRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        var requestId = (request.RequestId ?? string.Empty).Trim();
+        var approver = (request.Approver ?? string.Empty).Trim();
+
+        if (requestId.Length == 0)
+        {
+            return Reject("decide", "invalid_request_id", "A non-empty requestId is required.", requestId: null);
+        }
+
+        if (approver.Length == 0)
+        {
+            return Reject("decide", "invalid_approver", "A non-empty approver identity is required.", requestId);
+        }
+
+        if (!TryNormalizeDecision(request.Decision, out var action))
+        {
+            return Reject("decide", "invalid_decision", "decision must be approve/approved or reject/rejected.", requestId);
+        }
+
+        _store.Initialize();
+        using var _ = _store.AcquireLock();
+
+        var entries = _store.ReadEntries();
+        var proposal = FindProposal(entries, requestId);
+
+        if (proposal is null)
+        {
+            return Reject("decide", "unknown_request", "No durable proposal exists for this requestId.", requestId);
+        }
+
+        var proposer = Text(proposal, "proposer");
+
+        if (IdentityEquals(proposer, approver))
+        {
+            var selfApproval = Reject(
+                "decide",
+                "self_approval_forbidden",
+                "The checker identity must differ from the durable proposer identity.",
+                requestId);
+            selfApproval.Payload["decision"] = action;
+            return selfApproval;
+        }
+
+        var terminal = FindTerminal(entries, requestId);
+
+        if (terminal is not null)
+        {
+            var sameDecision = string.Equals(Text(terminal, "action"), action, StringComparison.Ordinal)
+                && IdentityEquals(Text(terminal, "checker"), approver);
+
+            if (sameDecision)
+            {
+                var repeat = Envelope("decide", "idempotent", ok: true);
+                Describe(repeat, terminal);
+                return new AuditCommandResult(AuditStatus.Idempotent, repeat);
+            }
+
+            var conflict = Reject(
+                "decide",
+                "already_decided",
+                "A terminal decision is already durable for this requestId.",
+                requestId);
+            conflict.Payload["decision"] = action;
+            conflict.Payload["finalAction"] = Text(terminal, "action");
+            conflict.Payload["finalChecker"] = Text(terminal, "checker");
+            return conflict;
+        }
+
+        var entry = Append(
+            entries,
+            requestId,
+            action,
+            actor: approver,
+            actorRole: "checker",
+            proposer: proposer,
+            checker: approver,
+            businessDate: Text(proposal, "businessDate"),
+            reason: Text(proposal, "reason"),
+            reasonDigest: Text(proposal, "reasonDigest"),
+            evidence: Text(proposal, "evidence"),
+            evidenceDigest: Text(proposal, "evidenceDigest"),
+            redacted: proposal["redacted"]?.GetValue<bool>() ?? false);
+
+        var payload = Envelope("decide", "accepted", ok: true);
+        Describe(payload, entry);
+        return new AuditCommandResult(AuditStatus.Accepted, payload);
+    }
+
+    /// <summary>Exports the durable history for an inclusive business-date range.</summary>
+    public AuditCommandResult Export(ExportRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        if (!TryParseDate(request.FromDate, out var from))
+        {
+            return Reject("export", "invalid_from_date", "fromDate must be an ISO yyyy-MM-dd value.", requestId: null);
+        }
+
+        if (!TryParseDate(request.ToDate, out var to))
+        {
+            return Reject("export", "invalid_to_date", "toDate must be an ISO yyyy-MM-dd value.", requestId: null);
+        }
+
+        if (to < from)
+        {
+            return Reject("export", "invalid_date_range", "toDate must not precede fromDate.", requestId: null);
+        }
+
+        _store.Initialize();
+
+        IReadOnlyList<JsonObject> entries;
+        using (_store.AcquireLock())
+        {
+            entries = _store.ReadEntries();
+        }
+
+        var selected = entries
+            .Where(entry => TryParseDate(Text(entry, "businessDate"), out var date) && date >= from && date <= to)
+            .OrderBy(entry => entry["sequence"]?.GetValue<int>() ?? 0)
+            .Select(entry => (JsonNode)entry.DeepClone().AsObject())
+            .ToArray();
+
+        var document = Envelope("export", "completed", ok: true);
+        document["fromDate"] = Format(from);
+        document["toDate"] = Format(to);
+        document["generatedAt"] = AuditClock.UtcNowIso8601();
+        document["entryCount"] = selected.Length;
+        document["entries"] = new JsonArray(selected);
+
+        var exportPath = (request.ExportPath ?? string.Empty).Trim();
+
+        if (exportPath.Length > 0)
+        {
+            var fullPath = Path.GetFullPath(exportPath);
+            var directory = Path.GetDirectoryName(fullPath);
+
+            if (!string.IsNullOrEmpty(directory))
+            {
+                Directory.CreateDirectory(directory);
+            }
+
+            File.WriteAllText(fullPath, CanonicalJson.Serialize(document) + "\n", Utf8NoBom);
+        }
+
+        return new AuditCommandResult(AuditStatus.Completed, document);
+    }
+
+    private JsonObject Append(
+        IReadOnlyList<JsonObject> entries,
+        string requestId,
+        string action,
+        string actor,
+        string actorRole,
+        string proposer,
+        string? checker,
+        string businessDate,
+        string reason,
+        string reasonDigest,
+        string evidence,
+        string evidenceDigest,
+        bool redacted)
+    {
+        var previous = entries.Count == 0 ? null : entries[^1];
+        var previousHash = previous is null ? null : Text(previous, "hash");
+
+        var entry = new JsonObject
+        {
+            ["schemaVersion"] = AuditLedgerStore.SchemaVersion,
+            ["sequence"] = entries.Count + 1,
+            ["requestId"] = requestId,
+            ["action"] = action,
+            ["actor"] = actor,
+            ["actorRole"] = actorRole,
+            ["proposer"] = proposer,
+            ["checker"] = checker,
+            ["businessDate"] = businessDate,
+            ["reason"] = reason,
+            ["reasonDigest"] = reasonDigest,
+            ["evidence"] = evidence,
+            ["evidenceDigest"] = evidenceDigest,
+            ["redacted"] = redacted,
+            ["recordedAt"] = AuditClock.UtcNowIso8601(),
+            ["previousHash"] = previousHash
+        };
+
+        entry["hash"] = CanonicalJson.ComputeHash(entry);
+        _store.Append(entry);
+        return entry;
+    }
+
+    private static JsonObject Envelope(string command, string status, bool ok)
+        => new()
+        {
+            ["schemaVersion"] = AuditLedgerStore.SchemaVersion,
+            ["command"] = command,
+            ["status"] = status,
+            ["ok"] = ok
+        };
+
+    private static AuditCommandResult Reject(string command, string reason, string message, string? requestId)
+    {
+        var payload = Envelope(command, "rejected", ok: false);
+        payload["reason"] = reason;
+        payload["message"] = message;
+
+        if (requestId is not null)
+        {
+            payload["requestId"] = requestId;
+        }
+
+        return new AuditCommandResult(AuditStatus.Rejected, payload);
+    }
+
+    private static void Describe(JsonObject payload, JsonObject entry)
+    {
+        payload["requestId"] = Text(entry, "requestId");
+        payload["action"] = Text(entry, "action");
+        payload["actor"] = Text(entry, "actor");
+        payload["proposer"] = Text(entry, "proposer");
+        payload["checker"] = entry["checker"] is null ? null : Text(entry, "checker");
+        payload["businessDate"] = Text(entry, "businessDate");
+        payload["sequence"] = entry["sequence"]?.GetValue<int>() ?? 0;
+        payload["hash"] = Text(entry, "hash");
+    }
+
+    private static JsonObject? FindProposal(IReadOnlyList<JsonObject> entries, string requestId)
+        => entries.FirstOrDefault(entry =>
+            string.Equals(Text(entry, "requestId"), requestId, StringComparison.Ordinal)
+            && string.Equals(Text(entry, "action"), AuditAction.Proposed, StringComparison.Ordinal));
+
+    private static JsonObject? FindTerminal(IReadOnlyList<JsonObject> entries, string requestId)
+        => entries.FirstOrDefault(entry =>
+            string.Equals(Text(entry, "requestId"), requestId, StringComparison.Ordinal)
+            && AuditAction.IsTerminal(Text(entry, "action")));
+
+    private static string Text(JsonObject entry, string property)
+        => entry[property]?.GetValue<string>() ?? string.Empty;
+
+    private static bool IdentityEquals(string? left, string? right)
+        => string.Equals((left ?? string.Empty).Trim(), (right ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);
+
+    private static bool TryParseDate(string? value, out DateOnly date)
+        => DateOnly.TryParseExact(
+            (value ?? string.Empty).Trim(),
+            "yyyy-MM-dd",
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.None,
+            out date);
+
+    private static string Format(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+    private static bool TryNormalizeDecision(string? decision, out string action)
+    {
+        switch ((decision ?? string.Empty).Trim().ToUpperInvariant())
+        {
+            case "APPROVE":
+            case "APPROVED":
+            case "APPROVAL":
+                action = AuditAction.Approved;
+                return true;
+            case "REJECT":
+            case "REJECTED":
+            case "REJECTION":
+            case "DENY":
+            case "DENIED":
+                action = AuditAction.Rejected;
+                return true;
+            default:
+                action = string.Empty;
+                return false;
+        }
+    }
+}
diff --git a/src/TradeRecon.Audit/CanonicalJson.cs b/src/TradeRecon.Audit/CanonicalJson.cs
new file mode 100644
index 0000000..5e57b2a
--- /dev/null
+++ b/src/TradeRecon.Audit/CanonicalJson.cs
@@ -0,0 +1,84 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Encodings.Web;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Canonical JSON serialisation used for the tamper-evidence hash chain.
+///
+/// Canonical form is compact (no insignificant whitespace) JSON with object keys sorted
+/// recursively using ordinal (code-point) ordering, encoded as UTF-8. String escaping is
+/// the minimal set required by RFC 8259 so the canonical bytes match what an independent
+/// verifier produces from the exported entry.
+/// </summary>
+public static class CanonicalJson
+{
+    private static readonly JsonWriterOptions WriterOptions = new()
+    {
+        Indented = false,
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+
+    private static readonly JsonSerializerOptions ValueOptions = new()
+    {
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+
+    /// <summary>Serialises <paramref name="node"/> to its canonical JSON representation.</summary>
+    public static string Serialize(JsonNode? node)
+    {
+        using var buffer = new MemoryStream();
+        using (var writer = new Utf8JsonWriter(buffer, WriterOptions))
+        {
+            Write(writer, node);
+        }
+
+        return Encoding.UTF8.GetString(buffer.ToArray());
+    }
+
+    /// <summary>Lowercase SHA-256 hex digest over the canonical JSON of <paramref name="node"/>.</summary>
+    public static string ComputeHash(JsonNode? node)
+        => Sha256Hex(Encoding.UTF8.GetBytes(Serialize(node)));
+
+    /// <summary>Lowercase SHA-256 hex digest of a UTF-8 encoded string value.</summary>
+    public static string Sha256(string value)
+        => Sha256Hex(Encoding.UTF8.GetBytes(value));
+
+    private static string Sha256Hex(byte[] payload)
+        => Convert.ToHexString(SHA256.HashData(payload)).ToLowerInvariant();
+
+    private static void Write(Utf8JsonWriter writer, JsonNode? node)
+    {
+        switch (node)
+        {
+            case null:
+                writer.WriteNullValue();
+                break;
+            case JsonObject obj:
+                writer.WriteStartObject();
+                foreach (var property in obj.OrderBy(p => p.Key, StringComparer.Ordinal))
+                {
+                    writer.WritePropertyName(property.Key);
+                    Write(writer, property.Value);
+                }
+
+                writer.WriteEndObject();
+                break;
+            case JsonArray array:
+                writer.WriteStartArray();
+                foreach (var item in array)
+                {
+                    Write(writer, item);
+                }
+
+                writer.WriteEndArray();
+                break;
+            default:
+                node.WriteTo(writer, ValueOptions);
+                break;
+        }
+    }
+}
diff --git a/src/TradeRecon.Audit/SensitiveDataRedactor.cs b/src/TradeRecon.Audit/SensitiveDataRedactor.cs
new file mode 100644
index 0000000..50c5177
--- /dev/null
+++ b/src/TradeRecon.Audit/SensitiveDataRedactor.cs
@@ -0,0 +1,84 @@
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Allow-listed scrubbing for free-text workflow input.
+///
+/// The audit workflow never receives account or amount fields as first-class parameters, but
+/// analyst-supplied reason and evidence text may quote them. Sensitive-looking tokens are
+/// replaced <em>before</em> the lifecycle entry is hashed and persisted, so the durable
+/// history, the exported history and every diagnostic line are free of raw account
+/// identifiers and trade amounts (INV-5 / NFR-1).
+/// </summary>
+public static partial class SensitiveDataRedactor
+{
+    /// <summary>Placeholder substituted for a redacted account identifier.</summary>
+    public const string AccountPlaceholder = "[REDACTED-ACCOUNT]";
+
+    /// <summary>Placeholder substituted for a redacted monetary amount.</summary>
+    public const string AmountPlaceholder = "[REDACTED-AMOUNT]";
+
+    /// <summary>Placeholder substituted for an explicitly marked sensitive token.</summary>
+    public const string SentinelPlaceholder = "[REDACTED]";
+
+    /// <summary>Redacts sensitive tokens from <paramref name="value"/>.</summary>
+    public static string Redact(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return value ?? string.Empty;
+        }
+
+        var redacted = SentinelToken().Replace(value, SentinelPlaceholder);
+        redacted = IbanLikeToken().Replace(redacted, AccountPlaceholder);
+        redacted = AccountCodeToken().Replace(redacted, AccountPlaceholder);
+        redacted = LabelledAccountToken().Replace(redacted, m => m.Groups[1].Value + AccountPlaceholder);
+        redacted = CurrencyAmount().Replace(redacted, AmountPlaceholder);
+        redacted = SymbolAmount().Replace(redacted, AmountPlaceholder);
+        redacted = GroupedAmount().Replace(redacted, AmountPlaceholder);
+        redacted = DecimalAmount().Replace(redacted, AmountPlaceholder);
+        redacted = LongDigitRun().Replace(redacted, AmountPlaceholder);
+        return redacted;
+    }
+
+    /// <summary>True when redaction would change <paramref name="value"/>.</summary>
+    public static bool ContainsSensitiveData(string? value)
+        => !string.Equals(Redact(value), value ?? string.Empty, StringComparison.Ordinal);
+
+    // Any token explicitly marked as a sensitive sentinel by a caller or test harness.
+    [GeneratedRegex(@"[A-Za-z0-9_-]*SENTINEL[A-Za-z0-9_.-]*", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant)]
+    private static partial Regex SentinelToken();
+
+    // IBAN-like account identifiers, e.g. GB29NWBK60161331926819.
+    [GeneratedRegex(@"\b[A-Z]{2}[0-9]{2}[A-Z0-9]{10,30}\b", RegexOptions.CultureInvariant)]
+    private static partial Regex IbanLikeToken();
+
+    // Reconciliation account codes, e.g. ACC001, ACCT-4451, ACCOUNT12.
+    [GeneratedRegex(@"\bACC[A-Za-z]*[-_]?[A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]*\b", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant)]
+    private static partial Regex AccountCodeToken();
+
+    // "account: X1", "account no 42", "account id = Z-9".
+    [GeneratedRegex(@"(?i)\b(account(?:\s*(?:id|number|no\.?|#))?\s*[:=#-]?\s*)([A-Za-z0-9][A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]*)\b", RegexOptions.CultureInvariant)]
+    private static partial Regex LabelledAccountToken();
+
+    // Currency-qualified amounts, e.g. "EUR 1600000", "usd 12.5".
+    [GeneratedRegex(@"(?i)\b(?:usd|eur|gbp|jpy|chf|aud|cad|sek|nok|hkd|sgd)\s*[0-9][0-9,_ ]*(?:\.[0-9]+)?", RegexOptions.CultureInvariant)]
+    private static partial Regex CurrencyAmount();
+
+    // Symbol-qualified amounts, e.g. "$1200", "£99".
+    [GeneratedRegex(@"[$\u20ac\u00a3\u00a5]\s*[0-9][0-9,]*(?:\.[0-9]+)?", RegexOptions.CultureInvariant)]
+    private static partial Regex SymbolAmount();
+
+    // Thousand-separated amounts, e.g. "1,600,000.00".
+    [GeneratedRegex(@"\b[0-9]{1,3}(?:,[0-9]{3})+(?:\.[0-9]+)?\b", RegexOptions.CultureInvariant)]
+    private static partial Regex GroupedAmount();
+
+    // Any decimal quantity, e.g. "1600500.25", "0.01".
+    [GeneratedRegex(@"\b[0-9]+\.[0-9]+\b", RegexOptions.CultureInvariant)]
+    private static partial Regex DecimalAmount();
+
+    // Long bare digit runs are treated as notional amounts or account numbers.
+    [GeneratedRegex(@"\b[0-9]{6,}\b", RegexOptions.CultureInvariant)]
+    private static partial Regex LongDigitRun();
+}
