new file mode 100644
index 0000000..1936f13
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditSensitiveDataTests.cs
@@ -0,0 +1,142 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+using AuditProgram = TradeRecon.AuditConsole.Program;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Sensitive-data boundary for the audit feature (REQ-8, INV-5, NFR-1). Synthetic account and
+/// amount sentinels supplied through analyst free text must never reach stdout, stderr, the
+/// durable ledger or the compliance export.
+/// </summary>
+public class AuditSensitiveDataTests
+{
+    private static readonly string[] Sentinels =
+    [
+        "ACC001",
+        "ACCT-SENTINEL-4471",
+        "SENTINEL-AMOUNT-9",
+        "1600500.25",
+        "1,600,000.00",
+        "GB29NWBK60161331926819",
+        "987654321"
+    ];
+
+    private const string SensitiveReason =
+        "Break on ACC001 (ACCT-SENTINEL-4471): settlement 1600500.25 versus trade 1,600,000.00";
+
+    private const string SensitiveEvidence =
+        "Custodian statement for GB29NWBK60161331926819 shows SENTINEL-AMOUNT-9 and reference 987654321";
+
+    [Fact]
+    public void SentinelsNeverReachOutputStateOrExport()
+    {
+        using var temp = new TempState();
+
+        var transcript = new List<string>();
+
+        transcript.Add(Invoke(temp, "initialize", "--state", temp.StateDirectory));
+        transcript.Add(Invoke(
+            temp, "propose", "--state", temp.StateDirectory, "--request-id", "req-1", "--proposer", "maker-a",
+            "--business-date", "2024-06-03", "--reason", SensitiveReason, "--evidence", SensitiveEvidence));
+        transcript.Add(Invoke(
+            temp, "decide", "--state", temp.StateDirectory, "--request-id", "req-1",
+            "--approver", "checker-b", "--decision", "approve"));
+        transcript.Add(Invoke(
+            temp, "export", "--state", temp.StateDirectory, "--from", "2024-06-01",
+            "--to", "2024-06-30", "--export-path", temp.ExportPath));
+
+        transcript.Add(File.ReadAllText(temp.ExportPath));
+        transcript.Add(File.ReadAllText(Path.Combine(temp.StateDirectory, "audit", "ledger.jsonl")));
+
+        foreach (var sentinel in Sentinels)
+        {
+            foreach (var text in transcript)
+            {
+                Assert.DoesNotContain(sentinel, text, StringComparison.OrdinalIgnoreCase);
+            }
+        }
+    }
+
+    [Fact]
+    public void RedactedHistoryStillExposesReasonEvidenceAndActors()
+    {
+        using var temp = new TempState();
+        var service = temp.CreateService();
+
+        service.Propose(new ProposeRequest("req-1", "maker-a", "2024-06-03", SensitiveReason, SensitiveEvidence));
+        service.Decide(new DecideRequest("req-1", "checker-b", "approve"));
+        service.Export(new ExportRequest("2024-06-01", "2024-06-30", temp.ExportPath));
+
+        var document = JsonNode.Parse(File.ReadAllText(temp.ExportPath))!;
+        var entries = AuditTestSupport.EntryObjects(document).ToList();
+
+        Assert.Equal(2, entries.Count);
+
+        foreach (var entry in entries)
+        {
+            Assert.False(string.IsNullOrWhiteSpace((string?)entry["reason"]));
+            Assert.False(string.IsNullOrWhiteSpace((string?)entry["evidence"]));
+            Assert.False(string.IsNullOrWhiteSpace((string?)entry["proposer"]));
+            Assert.Contains(SensitiveDataRedactor.AccountPlaceholder, (string?)entry["reason"]!, StringComparison.Ordinal);
+            Assert.True((bool?)entry["redacted"]);
+            Assert.Equal(64, ((string?)entry["reasonDigest"])!.Length);
+            Assert.Equal(64, ((string?)entry["evidenceDigest"])!.Length);
+        }
+
+        AuditWorkflowTests.AssertChainIsIntact(entries);
+    }
+
+    [Fact]
+    public void BenignReasonAndEvidenceArePreservedVerbatim()
+    {
+        const string reason = "Custodian confirmed a timing difference on T-1";
+        const string evidence = "ticket AUD-4471 and email thread from ops";
+
+        using var temp = new TempState();
+        var service = temp.CreateService();
+
+        service.Propose(new ProposeRequest("req-1", "maker-a", "2024-06-03", reason, evidence));
+        var entry = AuditTestSupport
+            .EntryObjects(service.Export(new ExportRequest("2024-06-01", "2024-06-30", temp.ExportPath)).Payload)
+            .Single();
+
+        Assert.Equal(reason, (string?)entry["reason"]);
+        Assert.Equal(evidence, (string?)entry["evidence"]);
+        Assert.False((bool?)entry["redacted"]);
+    }
+
+    [Theory]
+    [InlineData("ACC001", true)]
+    [InlineData("acct-4451", true)]
+    [InlineData("account: X9", true)]
+    [InlineData("GB29NWBK60161331926819", true)]
+    [InlineData("EUR 1600000", true)]
+    [InlineData("$1200.50", true)]
+    [InlineData("1,600,000.00", true)]
+    [InlineData("0.01", true)]
+    [InlineData("987654321", true)]
+    [InlineData("MY-SENTINEL-VALUE", true)]
+    [InlineData("Timing difference confirmed with the custodian", false)]
+    [InlineData("ticket AUD-4471 attached", false)]
+    [InlineData("settled on 2024-06-03 as agreed", false)]
+    public void RedactorFlagsSensitiveTokensWithoutOverReaching(string value, bool sensitive)
+    {
+        Assert.Equal(sensitive, SensitiveDataRedactor.ContainsSensitiveData(value));
+
+        if (!sensitive)
+        {
+            Assert.Equal(value, SensitiveDataRedactor.Redact(value));
+        }
+    }
+
+    private static string Invoke(TempState temp, params string[] args)
+    {
+        _ = temp;
+        var stdout = new StringWriter();
+        var stderr = new StringWriter();
+        AuditProgram.Run(args, stdout, stderr);
+        return stdout + "\n" + stderr;
+    }
+}
diff --git a/tests/TradeRecon.Tests/AuditTestSupport.cs b/tests/TradeRecon.Tests/AuditTestSupport.cs
new file mode 100644
index 0000000..462cc8c
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditTestSupport.cs
@@ -0,0 +1,82 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Independent verification helpers for the exported audit history.
+///
+/// These deliberately re-derive canonical JSON and the SHA-256 chain with their own code so a
+/// bug in <see cref="CanonicalJson"/> cannot make the assertions pass vacuously.
+/// </summary>
+internal static class AuditTestSupport
+{
+    public static string Canonical(JsonNode? node)
+        => node switch
+        {
+            null => "null",
+            JsonObject obj => "{" + string.Join(
+                ",",
+                obj.OrderBy(p => p.Key, StringComparer.Ordinal)
+                    .Select(p => JsonSerializer.Serialize(p.Key) + ":" + Canonical(p.Value))) + "}",
+            JsonArray array => "[" + string.Join(",", array.Select(Canonical)) + "]",
+            _ => node.ToJsonString()
+        };
+
+    public static string Sha256Hex(string value)
+        => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value))).ToLowerInvariant();
+
+    public static string RecomputeHash(JsonObject entry)
+    {
+        var copy = entry.DeepClone().AsObject();
+        copy.Remove("hash");
+        return Sha256Hex(Canonical(copy));
+    }
+
+    public static JsonArray Entries(JsonNode document)
+        => document switch
+        {
+            JsonArray array => array,
+            JsonObject obj => obj["entries"]!.AsArray(),
+            _ => throw new InvalidOperationException("Export must be an array or an object with entries.")
+        };
+
+    public static IEnumerable<JsonObject> EntryObjects(JsonNode document)
+        => Entries(document).Select(node => node!.AsObject());
+}
+
+/// <summary>Creates and removes an isolated evaluator-owned state directory per test.</summary>
+internal sealed class TempState : IDisposable
+{
+    public TempState()
+    {
+        Root = Path.Combine(Path.GetTempPath(), "traderecon-audit-tests", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(Root);
+    }
+
+    public string Root { get; }
+
+    public string StateDirectory => Path.Combine(Root, "state");
+
+    public string ExportPath => Path.Combine(Root, "export", "audit-history.json");
+
+    public AuditWorkflowService CreateService() => new(new AuditLedgerStore(StateDirectory));
+
+    public void Dispose()
+    {
+        try
+        {
+            if (Directory.Exists(Root))
+            {
+                Directory.Delete(Root, recursive: true);
+            }
+        }
+        catch (IOException)
+        {
+            // Best-effort cleanup only.
+        }
+    }
+}
diff --git a/tests/TradeRecon.Tests/AuditWorkflowTests.cs b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
new file mode 100644
index 0000000..7ce3db6
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditWorkflowTests.cs
@@ -0,0 +1,406 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Lifecycle behaviour of the maker-checker resolution workflow (REQ-2 … REQ-7).
+/// </summary>
+public class AuditWorkflowTests
+{
+    private const string BusinessDate = "2024-06-03";
+    private const string Reason = "Custodian confirmed a timing difference";
+    private const string Evidence = "ticket AUD-4471 attached";
+
+    [Fact]
+    public void Propose_RecordsOneDurableProposalForTheRequest()
+    {
+        using var temp = new TempState();
+        var service = temp.CreateService();
+
+        var result = service.Propose(new ProposeRequest("req-1", "maker-a", BusinessDate, Reason, Evidence));
+
+        Assert.Equal(AuditStatus.Accepted, result.Status);
+
+        var entries = ExportEntries(temp, service);
+        var entry = Assert.Single(entries);
+        Assert.Equal("req-1", (string?)entry["requestId"]);
+        Assert.Equal("PROPOSED", (string?)entry["action"]);
+        Assert.Equal("maker-a", (string?)entry["proposer"]);
+        Assert.Equal(BusinessDate, (string?)entry["businessDate"]);
+        Assert.Equal(Reason, (string?)entry["reason"]);
+        Assert.Equal(Evidence, (string?)entry["evidence"]);
+        Assert.Equal(1, (int?)entry["sequence"]);
+        Assert.Null(entry["previousHash"]?.GetValue<string>());
+    }
+
+    [Theory]
+    [InlineData("", Evidence)]
+    [InlineData("   ", Evidence)]
+    [InlineData(Reason, "")]
+    [InlineData(Reason, "  ")]
+    public void Propose_WithoutReasonOrEvidence_LeavesNoDurableHistory(string reason, string evidence)
+    {
+        using var temp = new TempState();
+        var service = temp.CreateService();
+
+        var result = service.Propose(new ProposeRequest("req-invalid", "maker-a", BusinessDate, reason, evidence));
+
+        Assert.Equal(AuditStatus.Rejected, result.Status);
+        Assert.Empty(ExportEntries(temp, service));
+    }
+
+    [Fact]
+    public void Propose_WithMalformedBusinessDate_IsRejected()
+    {
+        using var temp = new TempState();
+        var service = temp.CreateService();
+
+        var result = service.Propose(new ProposeRequest("req-1", "maker-a", "03/06/2024", Reason, Evidence));
+
+        Assert.Equal(AuditStatus.Rejected, result.Status);
+        Assert.Equal("invalid_business_date", (string?)result.Payload["reason"]);
+        Assert.Empty(ExportEntries(temp, service));
+    }
+
+    [Fact]
+    public void Propose_RepeatedWithIdenticalPayload_IsIdempotent()
+    {
+        using var temp = new TempState();
