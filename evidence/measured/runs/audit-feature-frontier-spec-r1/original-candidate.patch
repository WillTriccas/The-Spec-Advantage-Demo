new file mode 100644
index 0000000..4eccb51
--- /dev/null
+++ b/src/TradeRecon.AuditConsole/Program.cs
@@ -0,0 +1,202 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+
+namespace TradeRecon.AuditConsole;
+
+/// <summary>
+/// Black-box command-line host for the explainable exception-resolution workflow.
+///
+/// The evaluator owns every path and identity; this host only translates a shell-free
+/// argument array into a workflow command and prints one deterministic JSON document to
+/// stdout. Diagnostics are written to stderr and never contain reason or evidence text.
+///
+/// <code>
+/// TradeRecon.AuditConsole initialize --state &lt;dir&gt;
+/// TradeRecon.AuditConsole propose    --state &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;id&gt;
+///                                    --business-date &lt;yyyy-MM-dd&gt; --reason &lt;text&gt; --evidence &lt;text&gt;
+/// TradeRecon.AuditConsole decide     --state &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;id&gt; --decision &lt;approve|reject&gt;
+/// TradeRecon.AuditConsole export     --state &lt;dir&gt; --from &lt;yyyy-MM-dd&gt; --to &lt;yyyy-MM-dd&gt; --export-path &lt;file&gt;
+/// </code>
+///
+/// Exit codes: 0 accepted or idempotent, 3 refused by a workflow rule, 1 usage or internal error.
+/// </summary>
+public static class Program
+{
+    /// <summary>The command completed and its outcome is durable (or already was).</summary>
+    public const int ExitOk = 0;
+
+    /// <summary>Usage error or unexpected internal failure.</summary>
+    public const int ExitError = 1;
+
+    /// <summary>The command was refused by a workflow rule; no durable entry was written.</summary>
+    public const int ExitRejected = 3;
+
+    private const string Usage =
+        "Usage: TradeRecon.AuditConsole <initialize|propose|decide|export> --state <dir> [options]";
+
+    private static readonly string[] KnownOptions =
+    [
+        "--state", "--state-directory", "--request-id", "--proposer", "--business-date",
+        "--reason", "--evidence", "--approver", "--decision", "--from", "--from-date",
+        "--to", "--to-date", "--export-path", "--help", "-h"
+    ];
+
+    public static int Main(string[] args)
+        => Run(args, Console.Out, Console.Error);
+
+    /// <summary>Executes one command against the supplied output writers.</summary>
+    public static int Run(string[] args, TextWriter stdout, TextWriter stderr)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+        ArgumentNullException.ThrowIfNull(stdout);
+        ArgumentNullException.ThrowIfNull(stderr);
+
+        if (args.Length == 0 || args.Contains("--help") || args.Contains("-h"))
+        {
+            stderr.WriteLine(Usage);
+            Write(stdout, Failure("help", "usage", Usage));
+            return args.Length == 0 ? ExitError : ExitOk;
+        }
+
+        var command = args[0].Trim().ToLowerInvariant();
+        Dictionary<string, string> options;
+
+        try
+        {
+            options = ParseOptions(args.Skip(1).ToArray());
+        }
+        catch (ArgumentException ex)
+        {
+            stderr.WriteLine($"audit {command}: invalid arguments");
+            Write(stdout, Failure(command, "invalid_arguments", ex.Message));
+            return ExitError;
+        }
+
+        var stateDirectory = Value(options, "--state", "--state-directory");
+
+        if (stateDirectory.Length == 0)
+        {
+            stderr.WriteLine($"audit {command}: --state is required");
+            Write(stdout, Failure(command, "missing_state_directory", "--state <dir> is required."));
+            return ExitError;
+        }
+
+        try
+        {
+            var service = new AuditWorkflowService(new AuditLedgerStore(stateDirectory));
+            var result = command switch
+            {
+                "initialize" or "init" => service.Initialize(),
+                "propose" => service.Propose(new ProposeRequest(
+                    Value(options, "--request-id"),
+                    Value(options, "--proposer"),
+                    Value(options, "--business-date"),
+                    Value(options, "--reason"),
+                    Value(options, "--evidence"))),
+                "decide" => service.Decide(new DecideRequest(
+                    Value(options, "--request-id"),
+                    Value(options, "--approver"),
+                    Value(options, "--decision"))),
+                "export" => service.Export(new ExportRequest(
+                    Value(options, "--from", "--from-date"),
+                    Value(options, "--to", "--to-date"),
+                    Value(options, "--export-path"))),
+                _ => null
+            };
+
+            if (result is null)
+            {
+                stderr.WriteLine($"audit: unknown command '{command}'");
+                Write(stdout, Failure(command, "unknown_command", Usage));
+                return ExitError;
+            }
+
+            stderr.WriteLine($"audit {command}: status={result.Payload["status"]} requestId={result.Payload["requestId"]}");
+            Write(stdout, result.Payload);
+            return result.Status == AuditStatus.Rejected ? ExitRejected : ExitOk;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or NotSupportedException
+            or ArgumentException or PathTooLongException or TimeoutException)
+        {
+            // Diagnostics are limited to the exception type so no analyst-supplied text can leak.
+            stderr.WriteLine($"audit {command}: failed ({ex.GetType().Name})");
+            Write(stdout, Failure(command, "command_failed", ex.GetType().Name));
+            return ExitError;
+        }
+    }
+
+    private static Dictionary<string, string> ParseOptions(string[] args)
+    {
+        var options = new Dictionary<string, string>(StringComparer.Ordinal);
+
+        for (var i = 0; i < args.Length; i++)
+        {
+            var token = args[i];
+
+            if (!token.StartsWith("--", StringComparison.Ordinal) && !token.StartsWith("-h", StringComparison.Ordinal))
+            {
+                throw new ArgumentException($"Unexpected argument at position {i}.");
+            }
+
+            var name = token;
+            string value;
+
+            var separator = token.IndexOf('=');
+            if (separator > 0)
+            {
+                name = token[..separator];
+                value = token[(separator + 1)..];
+            }
+            else if (i + 1 < args.Length && !KnownOptions.Contains(args[i + 1], StringComparer.Ordinal))
+            {
+                // A missing value (the evaluator may substitute an empty placeholder) is kept as
+                // an empty string so the workflow can refuse it through its documented outcome.
+                value = args[++i];
+            }
+            else
+            {
+                value = string.Empty;
+            }
+
+            if (!KnownOptions.Contains(name, StringComparer.Ordinal))
+            {
+                throw new ArgumentException($"Unknown option '{name}'.");
+            }
+
+            options[name] = value;
+        }
+
+        return options;
+    }
+
+    private static string Value(IReadOnlyDictionary<string, string> options, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (options.TryGetValue(name, out var value))
+            {
+                return value;
+            }
+        }
+
+        return string.Empty;
+    }
+
+    private static JsonObject Failure(string command, string reason, string message)
+        => new()
+        {
+            ["schemaVersion"] = AuditLedgerStore.SchemaVersion,
+            ["command"] = command,
+            ["status"] = "rejected",
+            ["ok"] = false,
+            ["reason"] = reason,
+            ["message"] = SensitiveDataRedactor.Redact(message)
+        };
+
+    private static void Write(TextWriter stdout, JsonObject payload)
+    {
+        stdout.Write(CanonicalJson.Serialize(payload));
+        stdout.Write('\n');
+        stdout.Flush();
+    }
+}
