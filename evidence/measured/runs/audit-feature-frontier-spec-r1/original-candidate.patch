+
+    internal static void AssertChainIsIntact(IReadOnlyList<JsonObject> entries)
+    {
+        string? previousHash = null;
+
+        for (var i = 0; i < entries.Count; i++)
+        {
+            var entry = entries[i];
+
+            Assert.Equal(i + 1, (int?)entry["sequence"]);
+            Assert.Equal(previousHash, entry["previousHash"]?.GetValue<string>());
+
+            var hash = (string?)entry["hash"];
+            Assert.False(string.IsNullOrWhiteSpace(hash));
+            Assert.Equal(64, hash!.Length);
+            Assert.Equal(hash, hash.ToLowerInvariant());
+            Assert.Equal(hash, AuditTestSupport.RecomputeHash(entry));
+
+            previousHash = hash;
+        }
+    }
+
+    private static List<JsonObject> ExportEntries(
+        TempState temp,
+        AuditWorkflowService service,
+        string from = "2024-01-01",
+        string to = "2024-12-31")
+    {
+        var result = service.Export(new ExportRequest(from, to, temp.ExportPath));
+        return AuditTestSupport.EntryObjects(result.Payload).ToList();
+    }
