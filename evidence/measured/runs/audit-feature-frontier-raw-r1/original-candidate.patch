diff --git a/src/TradeRecon.Application/Abstractions/IAuditLogStore.cs b/src/TradeRecon.Application/Abstractions/IAuditLogStore.cs
new file mode 100644
index 0000000..aebda84
--- /dev/null
+++ b/src/TradeRecon.Application/Abstractions/IAuditLogStore.cs
@@ -0,0 +1,46 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Abstractions;
+
+/// <summary>
+/// Append-only persistence for the resolution history. Implementations must make
+/// <see cref="BeginTransaction"/> mutually exclusive across processes: read-decide-append is
+/// a single critical section, which is what guarantees that two racing decisions produce
+/// exactly one durable final decision.
+/// </summary>
+public interface IAuditLogStore
+{
+    /// <summary>
+    /// Creates the backing store if it does not exist. Idempotent; returns <c>true</c> when
+    /// this call created it and <c>false</c> when it was already present.
+    /// </summary>
+    bool Initialize();
+
+    /// <summary>Reads the full history in append order without taking the write lock.</summary>
+    IReadOnlyList<AuditEntry> ReadAll();
+
+    /// <summary>Opens the exclusive read-modify-append critical section.</summary>
+    IAuditLogTransaction BeginTransaction();
+}
+
+/// <summary>Exclusive critical section over the append-only history.</summary>
+public interface IAuditLogTransaction : IDisposable
+{
+    /// <summary>History as observed when the lock was acquired, in append order.</summary>
+    IReadOnlyList<AuditEntry> Entries { get; }
+
+    /// <summary>Durably appends one entry. The entry becomes visible on return.</summary>
+    void Append(AuditEntry entry);
+}
+
+/// <summary>Raised when the audit store is unreadable, corrupt or cannot be locked.</summary>
+public sealed class AuditStoreException : Exception
+{
+    public AuditStoreException(string message) : base(message)
+    {
+    }
+
+    public AuditStoreException(string message, Exception innerException) : base(message, innerException)
+    {
+    }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditChainVerifier.cs b/src/TradeRecon.Application/Audit/AuditChainVerifier.cs
new file mode 100644
index 0000000..e458fbb
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditChainVerifier.cs
@@ -0,0 +1,55 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>Result of replaying the hash chain over a history.</summary>
+public sealed record AuditChainVerification
+{
+    public required bool IsValid { get; init; }
+    public required int EntryCount { get; init; }
+
+    /// <summary>Sequence of the first entry that failed verification, if any.</summary>
+    public long? FirstInvalidSequence { get; init; }
+
+    /// <summary>Hash of the last entry, i.e. the current head of the chain.</summary>
+    public required string HeadHash { get; init; }
+}
+
+/// <summary>
+/// Replays an append-only history and checks that sequences are contiguous, that each entry's
+/// stored hash matches its content, and that each entry points at its predecessor. Any edit,
+/// removal or reordering of a persisted entry is therefore detectable.
+/// </summary>
+public static class AuditChainVerifier
+{
+    public static AuditChainVerification Verify(IReadOnlyList<AuditEntry> entries)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+
+        var previousHash = AuditHash.Genesis;
+        long? firstInvalid = null;
+
+        for (var i = 0; i < entries.Count; i++)
+        {
+            var entry = entries[i];
+            var expectedSequence = i + 1;
+            var linked = string.Equals(entry.PreviousEntryHash, previousHash, StringComparison.Ordinal);
+            var selfConsistent = string.Equals(entry.EntryHash, entry.RecomputeEntryHash(), StringComparison.Ordinal);
+
+            if ((entry.Sequence != expectedSequence || !linked || !selfConsistent) && firstInvalid is null)
+            {
+                firstInvalid = entry.Sequence;
+            }
+
+            previousHash = entry.EntryHash;
+        }
+
+        return new AuditChainVerification
+        {
+            IsValid = firstInvalid is null,
+            EntryCount = entries.Count,
+            FirstInvalidSequence = firstInvalid,
+            HeadHash = previousHash
+        };
+    }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditCommands.cs b/src/TradeRecon.Application/Audit/AuditCommands.cs
new file mode 100644
index 0000000..b391df4
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditCommands.cs
@@ -0,0 +1,117 @@
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>Request to propose a resolution for a reconciliation break.</summary>
+public sealed record ProposeResolutionCommand
+{
+    public required string RequestId { get; init; }
+    public required string Proposer { get; init; }
+    public required DateOnly BusinessDate { get; init; }
+    public required string Reason { get; init; }
+    public required string Evidence { get; init; }
+}
+
+/// <summary>Request for a checker to approve or reject an existing proposal.</summary>
+public sealed record DecideResolutionCommand
+{
+    public required string RequestId { get; init; }
+    public required string Approver { get; init; }
+    public required ResolutionAction Decision { get; init; }
+}
+
+/// <summary>Outcome classification shared by every audit command.</summary>
+public enum AuditOutcomeStatus
+{
+    /// <summary>A new durable entry was appended.</summary>
+    Accepted = 0,
+
+    /// <summary>An identical earlier call already recorded this fact; nothing was appended.</summary>
+    AlreadyRecorded = 1,
+
+    /// <summary>The request exists but the call contradicts what is already durable.</summary>
+    Conflict = 2,
+
+    /// <summary>Refused by a control (segregation of duties). Nothing was appended.</summary>
+    Denied = 3,
+
+    /// <summary>No such resolution request.</summary>
+    NotFound = 4,
+
+    /// <summary>The supplied arguments were not usable.</summary>
+    Invalid = 5
+}
+
+/// <summary>
+/// Result of a propose/decide call. <see cref="Applied"/> is <c>true</c> only when this call
+/// appended a new entry, which lets callers distinguish a first attempt from an idempotent
+/// retry without inspecting the history themselves.
+/// </summary>
+public sealed record AuditCommandOutcome
+{
+    public required AuditOutcomeStatus Status { get; init; }
+    public required bool Applied { get; init; }
+
+    /// <summary>Stable machine-readable failure code, or <c>null</c> on success.</summary>
+    public string? ErrorCode { get; init; }
+
+    /// <summary>Operator-facing explanation. Never contains account data or amounts.</summary>
+    public string? Message { get; init; }
+
+    /// <summary>Entry this call created, or the pre-existing entry it collided with.</summary>
+    public AuditEntry? Entry { get; init; }
+
+    /// <summary>Request state after the call, when the request exists.</summary>
+    public ResolutionRequestState? Request { get; init; }
+
+    /// <summary><c>true</c> when the call was a duplicate of an already durable fact.</summary>
+    public bool Replayed => Status == AuditOutcomeStatus.AlreadyRecorded;
+
+    /// <summary><c>true</c> when the caller should treat the command as successful.</summary>
+    public bool IsSuccess => Status is AuditOutcomeStatus.Accepted or AuditOutcomeStatus.AlreadyRecorded;
+}
+
+/// <summary>Stable error codes surfaced in command output and used by tests.</summary>
+public static class AuditErrorCodes
+{
+    public const string SelfApprovalForbidden = "self_approval_forbidden";
+    public const string ProposerMismatch = "proposer_mismatch";
+    public const string RequestNotFound = "request_not_found";
+    public const string AlreadyDecided = "already_decided";
+    public const string InvalidDecision = "invalid_decision";
+    public const string InvalidArgument = "invalid_argument";
+}
+
+/// <summary>Parses the free-form decision token accepted on the command line.</summary>
+public static class ResolutionDecisionParser
+{
+    /// <summary>Maps approve/reject synonyms onto the durable decision actions.</summary>
+    public static bool TryParse(string? value, out ResolutionAction decision)
+    {
+        decision = default;
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return false;
+        }
+
+        switch (value.Trim().ToLowerInvariant())
+        {
+            case "approve":
+            case "approved":
+            case "accept":
+            case "accepted":
+                decision = ResolutionAction.Approved;
+                return true;
+            case "reject":
+            case "rejected":
+            case "deny":
+            case "denied":
+            case "decline":
+            case "declined":
+                decision = ResolutionAction.Rejected;
+                return true;
+            default:
+                return false;
+        }
+    }
+}
