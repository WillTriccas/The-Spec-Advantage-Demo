+namespace TradeRecon.Infrastructure.Audit;
+
+/// <summary>Configuration for the file-backed append-only audit store.</summary>
+public sealed class AuditStoreOptions
+{
+    /// <summary>Directory that holds the history and its lock file.</summary>
+    public required string StateDirectory { get; init; }
+
+    /// <summary>How long to wait for the exclusive write lock before giving up.</summary>
+    public TimeSpan LockTimeout { get; init; } = TimeSpan.FromSeconds(30);
+}
diff --git a/src/TradeRecon.Infrastructure/Audit/FileAuditLogStore.cs b/src/TradeRecon.Infrastructure/Audit/FileAuditLogStore.cs
new file mode 100644
index 0000000..8924695
--- /dev/null
+++ b/src/TradeRecon.Infrastructure/Audit/FileAuditLogStore.cs
@@ -0,0 +1,217 @@
+using System.Globalization;
+using TradeRecon.Application.Abstractions;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Infrastructure.Audit;
+
+/// <summary>
+/// Append-only, hash-chained audit history stored as JSON lines on disk.
+///
+/// Durability and concurrency:
+/// <list type="bullet">
+///   <item>Writes only ever append; no line is rewritten or removed.</item>
+///   <item>A dedicated lock file opened with <see cref="FileShare.None"/> serialises the whole
+///         read-decide-append cycle across processes on every supported platform, so two racing
+///         decisions cannot both observe "undecided" and both append.</item>
+///   <item>Each appended line is flushed to the operating system before the lock is released,
+///         so a competing process always sees a committed history.</item>
+/// </list>
+/// </summary>
+public sealed class FileAuditLogStore : IAuditLogStore
+{
+    /// <summary>Name of the append-only history file inside the state directory.</summary>
+    public const string HistoryFileName = "resolution-audit-log.jsonl";
+
+    /// <summary>Name of the cross-process lock file inside the state directory.</summary>
+    public const string LockFileName = ".resolution-audit.lock";
+
+    private readonly string _stateDirectory;
+    private readonly string _historyPath;
+    private readonly string _lockPath;
+    private readonly TimeSpan _lockTimeout;
+
+    public FileAuditLogStore(AuditStoreOptions options)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+
+        if (string.IsNullOrWhiteSpace(options.StateDirectory))
+        {
+            throw new ArgumentException("A state directory is required.", nameof(options));
+        }
+
+        _stateDirectory = Path.GetFullPath(options.StateDirectory);
+        _historyPath = Path.Combine(_stateDirectory, HistoryFileName);
+        _lockPath = Path.Combine(_stateDirectory, LockFileName);
+        _lockTimeout = options.LockTimeout;
+    }
+
+    /// <summary>Absolute path of the state directory backing this store.</summary>
+    public string StateDirectory => _stateDirectory;
+
+    /// <summary>Absolute path of the append-only history file.</summary>
+    public string HistoryPath => _historyPath;
+
+    /// <inheritdoc />
+    public bool Initialize()
+    {
+        EnsureDirectory();
+
+        if (File.Exists(_historyPath))
+        {
+            return false;
+        }
+
+        // CreateNew loses the race deliberately: a concurrent initializer already created it.
+        try
+        {
+            using var stream = new FileStream(
+                _historyPath, FileMode.CreateNew, FileAccess.Write, FileShare.ReadWrite);
+            return true;
+        }
+        catch (IOException) when (File.Exists(_historyPath))
+        {
+            return false;
+        }
+    }
+
+    /// <inheritdoc />
+    public IReadOnlyList<AuditEntry> ReadAll()
+    {
+        if (!File.Exists(_historyPath))
+        {
+            return [];
+        }
+
+        try
+        {
+            using var stream = new FileStream(
+                _historyPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+            return ReadEntries(stream);
+        }
+        catch (IOException ex)
+        {
+            throw new AuditStoreException("The audit history could not be read.", ex);
+        }
+    }
+
+    /// <inheritdoc />
+    public IAuditLogTransaction BeginTransaction()
+    {
+        EnsureDirectory();
+
+        var lockStream = AcquireLock();
+        try
+        {
+            return new FileAuditLogTransaction(_historyPath, lockStream, ReadAll());
+        }
+        catch
+        {
+            lockStream.Dispose();
+            throw;
+        }
+    }
+
+    private void EnsureDirectory() => Directory.CreateDirectory(_stateDirectory);
+
+    private FileStream AcquireLock()
+    {
+        var deadline = DateTime.UtcNow + _lockTimeout;
+
+        while (true)
+        {
+            try
+            {
+                return new FileStream(_lockPath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new AuditStoreException(
+                        "Timed out waiting for exclusive access to the audit history.", ex);
+                }
+
+                // Jittered back-off keeps contending processes from retrying in lockstep.
+                Thread.Sleep(Random.Shared.Next(5, 25));
+            }
+        }
+    }
+
+    private static IReadOnlyList<AuditEntry> ReadEntries(Stream stream)
+    {
+        using var reader = new StreamReader(stream, AuditEntryDocument.FileEncoding);
+        var entries = new List<AuditEntry>();
+        var lineNumber = 0;
+
+        while (reader.ReadLine() is { } line)
+        {
+            lineNumber++;
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            entries.Add(AuditEntryDocument.Deserialize(line, lineNumber));
+        }
+
+        return entries;
+    }
+
+    private sealed class FileAuditLogTransaction : IAuditLogTransaction
+    {
+        private readonly string _historyPath;
+        private readonly FileStream _lockStream;
+        private readonly List<AuditEntry> _entries;
+        private bool _disposed;
+
+        public FileAuditLogTransaction(string historyPath, FileStream lockStream, IReadOnlyList<AuditEntry> entries)
+        {
+            _historyPath = historyPath;
+            _lockStream = lockStream;
+            _entries = [.. entries];
+        }
+
+        public IReadOnlyList<AuditEntry> Entries => _entries;
+
+        public void Append(AuditEntry entry)
+        {
+            ArgumentNullException.ThrowIfNull(entry);
+            ObjectDisposedException.ThrowIf(_disposed, this);
+
+            if (entry.Sequence != _entries.Count + 1)
+            {
+                throw new AuditStoreException(
+                    "An audit entry may only be appended at the current end of the history, at sequence "
+                    + (_entries.Count + 1).ToString(CultureInfo.InvariantCulture) + ".");
+            }
+
+            try
+            {
+                using var stream = new FileStream(
+                    _historyPath, FileMode.Append, FileAccess.Write, FileShare.Read);
+                using var writer = new StreamWriter(stream, AuditEntryDocument.FileEncoding);
+                writer.NewLine = "\n";
+                writer.WriteLine(AuditEntryDocument.Serialize(entry));
+                writer.Flush();
+                stream.Flush(flushToDisk: true);
+            }
+            catch (IOException ex)
+            {
+                throw new AuditStoreException("The audit entry could not be appended.", ex);
+            }
+
+            _entries.Add(entry);
+        }
+
+        public void Dispose()
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            _disposed = true;
+            _lockStream.Dispose();
+        }
+    }
+}
