new file mode 100644
index 0000000..b07d7ac
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/SensitiveTextRedactor.cs
@@ -0,0 +1,58 @@
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Masks anything that could identify an account or disclose a trade amount before free-text
+/// reason/evidence is retained. The service applies this at the boundary, so no unredacted
+/// analyst text is ever written to disk, echoed to a command's output or exported.
+///
+/// The redactor is deliberately conservative: it prefers masking harmless text over letting a
+/// single account identifier or amount escape.
+/// </summary>
+public static partial class SensitiveTextRedactor
+{
+    /// <summary>Replacement token substituted for every masked span.</summary>
+    public const string Mask = "[REDACTED]";
+
+    /// <summary>Applied in order; each pattern is a superset-safe mask.</summary>
+    private static readonly Regex[] Patterns =
+    [
+        IsinLikePattern(),
+        AlphaNumericIdentifierPattern(),
+        NumericPattern()
+    ];
+
+    /// <summary>Returns <paramref name="value"/> with identifiers and amounts masked.</summary>
+    public static string Redact(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return string.Empty;
+        }
+
+        var redacted = value;
+        foreach (var pattern in Patterns)
+        {
+            redacted = pattern.Replace(redacted, Mask);
+        }
+
+        return redacted;
+    }
+
+    /// <summary><c>true</c> when the text still contains a maskable token.</summary>
+    public static bool ContainsSensitiveTokens(string? value)
+        => !string.IsNullOrEmpty(value) && Patterns.Any(p => p.IsMatch(value));
+
+    /// <summary>ISIN-shaped instrument identifiers, e.g. GB00B03MLX29.</summary>
+    [GeneratedRegex(@"\b[A-Z]{2}[A-Z0-9]{9}[0-9]\b", RegexOptions.CultureInvariant)]
+    private static partial Regex IsinLikePattern();
+
+    /// <summary>Account/trade/settlement style identifiers, e.g. ACC002, T003, S008.</summary>
+    [GeneratedRegex(@"\b[A-Za-z]+[-_]?[0-9]{2,}[A-Za-z0-9]*\b", RegexOptions.CultureInvariant)]
+    private static partial Regex AlphaNumericIdentifierPattern();
+
+    /// <summary>Any bare number, including grouped and fractional amounts.</summary>
+    [GeneratedRegex(@"[0-9][0-9,._]*", RegexOptions.CultureInvariant)]
+    private static partial Regex NumericPattern();
+}
diff --git a/src/TradeRecon.Audit.Console/AuditCommandLine.cs b/src/TradeRecon.Audit.Console/AuditCommandLine.cs
new file mode 100644
index 0000000..d887c6a
--- /dev/null
+++ b/src/TradeRecon.Audit.Console/AuditCommandLine.cs
@@ -0,0 +1,126 @@
+using System.Globalization;
+
+namespace TradeRecon.Audit.Console;
+
+/// <summary>
+/// Minimal, shell-free command-line parser for the audit host.
+///
+/// Every value is taken verbatim from the following argument, so free text supplied for
+/// <c>--reason</c> or <c>--evidence</c> is never reinterpreted as an option — an external
+/// harness can pass arbitrary operator text without quoting rules or shell involvement.
+/// </summary>
+internal sealed record AuditCommandLine
+{
+    private static readonly IReadOnlyDictionary<string, string> Aliases = new Dictionary<string, string>(StringComparer.Ordinal)
+    {
+        ["--state"] = "state",
+        ["--state-dir"] = "state",
+        ["--state-directory"] = "state",
+        ["--request-id"] = "requestId",
+        ["--request"] = "requestId",
+        ["--proposer"] = "proposer",
+        ["--business-date"] = "businessDate",
+        ["--date"] = "businessDate",
+        ["--reason"] = "reason",
+        ["--evidence"] = "evidence",
+        ["--approver"] = "approver",
+        ["--checker"] = "approver",
+        ["--decision"] = "decision",
+        ["--from"] = "fromDate",
+        ["--from-date"] = "fromDate",
+        ["--to"] = "toDate",
+        ["--to-date"] = "toDate",
+        ["--export-path"] = "exportPath",
+        ["--export"] = "exportPath",
+        ["--out"] = "exportPath"
+    };
+
+    private readonly Dictionary<string, string> _values = new(StringComparer.Ordinal);
+
+    /// <summary>The sub-command name, lower-cased; empty when none was supplied.</summary>
+    public string Command { get; private init; } = string.Empty;
+
+    /// <summary>Parse failure reason, or <c>null</c> when the arguments are usable.</summary>
+    public string? Error { get; private init; }
+
+    public static AuditCommandLine Parse(string[] args)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+
+        if (args.Length == 0 || args[0].StartsWith("--", StringComparison.Ordinal))
+        {
+            return new AuditCommandLine
+            {
+                Error = "A sub-command is required: initialize, propose, decide or export."
+            };
+        }
+
+        var parsed = new AuditCommandLine { Command = args[0].ToLowerInvariant() };
+
+        for (var i = 1; i < args.Length; i++)
+        {
+            var token = args[i];
+            if (!Aliases.TryGetValue(token, out var name))
+            {
+                return new AuditCommandLine
+                {
+                    Command = parsed.Command,
+                    Error = $"Unknown option '{Sanitize(token)}'."
+                };
+            }
+
+            if (i + 1 >= args.Length)
+            {
+                return new AuditCommandLine
+                {
+                    Command = parsed.Command,
+                    Error = $"Option '{Sanitize(token)}' requires a value."
+                };
+            }
+
+            // Values are consumed verbatim; only the option token is interpreted.
+            parsed._values[name] = args[++i];
+        }
+
+        return parsed;
+    }
+
+    public string? Get(string name) => _values.TryGetValue(name, out var value) ? value : null;
+
+    /// <summary>Reads a required option, recording a message when it is absent or blank.</summary>
+    public bool TryGetRequired(string name, string optionText, out string value, out string? error)
+    {
+        if (_values.TryGetValue(name, out var found) && !string.IsNullOrWhiteSpace(found))
+        {
+            value = found;
+            error = null;
+            return true;
+        }
+
+        value = string.Empty;
+        error = $"Option '{optionText}' is required.";
+        return false;
+    }
+
+    /// <summary>Reads a required ISO-8601 date option.</summary>
+    public bool TryGetRequiredDate(string name, string optionText, out DateOnly value, out string? error)
+    {
+        value = default;
+        if (!TryGetRequired(name, optionText, out var text, out error))
+        {
+            return false;
+        }
+
+        if (!DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out value))
+        {
+            error = $"Option '{optionText}' must be an ISO-8601 date (yyyy-MM-dd).";
+            return false;
+        }
+
+        return true;
+    }
+
+    /// <summary>Strips control characters so a bad argument cannot corrupt the JSON output.</summary>
+    private static string Sanitize(string value)
+        => new(value.Where(c => !char.IsControl(c)).Take(64).ToArray());
+}
diff --git a/src/TradeRecon.Audit.Console/Program.cs b/src/TradeRecon.Audit.Console/Program.cs
new file mode 100644
index 0000000..4d3d1fe
--- /dev/null
+++ b/src/TradeRecon.Audit.Console/Program.cs
@@ -0,0 +1,271 @@
+using Microsoft.Extensions.DependencyInjection;
+using TradeRecon.Application.Abstractions;
+using TradeRecon.Application.Audit;
+using TradeRecon.Infrastructure;
+
+namespace TradeRecon.Audit.Console;
+
+/// <summary>
+/// Black-box command-line host for explainable exception resolution and its audit history.
+///
+/// <code>
+/// initialize --state &lt;dir&gt;
+/// propose    --state &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;identity&gt;
+///            --business-date &lt;yyyy-MM-dd&gt; --reason &lt;text&gt; --evidence &lt;text&gt;
+/// decide     --state &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;identity&gt; --decision &lt;approve|reject&gt;
+/// export     --state &lt;dir&gt; --from &lt;yyyy-MM-dd&gt; --to &lt;yyyy-MM-dd&gt; --export-path &lt;file&gt;
+/// </code>
+///
+/// Contract:
+/// <list type="bullet">
+///   <item>Every invocation writes one parseable JSON document to stdout; diagnostics go to stderr.</item>
+///   <item><c>export</c> writes the same document to the requested export path.</item>
+///   <item>Exit 0 on success (including idempotent retries), 3 when a control refused the
+///         command or the arguments were unusable, 1 on an unexpected internal failure.</item>
+///   <item>No account identifier, instrument identifier or trade amount is ever written to
+///         stdout, stderr or the export.</item>
+/// </list>
+/// </summary>
+public static class Program
+{
+    /// <summary>Command applied, or replayed an already durable fact.</summary>
+    public const int ExitSuccess = 0;
+
+    /// <summary>Unexpected internal failure.</summary>
+    public const int ExitError = 1;
+
+    /// <summary>Refused: unusable arguments, a control denial, or a conflicting decision.</summary>
+    public const int ExitRefused = 3;
+
+    private const string UsageText =
+        "Usage: TradeRecon.Audit.Console <initialize|propose|decide|export> [options]";
+
+    public static int Main(string[] args) => Run(args, System.Console.Out, System.Console.Error);
+
+    /// <summary>Runs one command against the supplied writers. Used directly by the tests.</summary>
+    public static int Run(string[] args, TextWriter stdout, TextWriter stderr)
+    {
+        ArgumentNullException.ThrowIfNull(args);
+        ArgumentNullException.ThrowIfNull(stdout);
+        ArgumentNullException.ThrowIfNull(stderr);
+
+        var reportBuilder = new AuditReportBuilder();
+
+        if (args.Contains("--help") || args.Contains("-h"))
+        {
+            stdout.Write(reportBuilder.BuildCommandJson("help", Refused("usage", UsageText), 0));
+            stdout.Write('\n');
+            return ExitSuccess;
+        }
+
+        var commandLine = AuditCommandLine.Parse(args);
+        if (commandLine.Error is { } parseError)
+        {
+            return Fail(stdout, reportBuilder, commandLine.Command, parseError);
+        }
+
+        try
+        {
+            return commandLine.Command switch
+            {
+                "initialize" or "init" => Initialize(commandLine, stdout, reportBuilder),
+                "propose" => Propose(commandLine, stdout, reportBuilder),
+                "decide" => Decide(commandLine, stdout, reportBuilder),
+                "export" => Export(commandLine, stdout, reportBuilder),
+                _ => Fail(stdout, reportBuilder, commandLine.Command, UsageText)
+            };
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or AuditStoreException)
+        {
+            // Only the failure class is disclosed; nothing derived from operator input.
+            stderr.WriteLine($"Audit command failed: {ex.GetType().Name}");
+            stdout.Write(reportBuilder.BuildCommandJson(
+                commandLine.Command, Refused("store_unavailable", "The audit history is unavailable."), 0));
+            stdout.Write('\n');
+            return ExitError;
+        }
+    }
+
+    private static int Initialize(AuditCommandLine commandLine, TextWriter stdout, AuditReportBuilder reportBuilder)
+    {
+        if (!commandLine.TryGetRequired("state", "--state", out var stateDirectory, out var error))
+        {
+            return Fail(stdout, reportBuilder, "initialize", error!);
+        }
+
+        var services = Compose(stateDirectory, out var provider);
+        using (provider)
+        {
+            var created = services.Initialize();
+            var history = services.ReadHistory();
+
+            var outcome = new AuditCommandOutcome
+            {
+                Status = created ? AuditOutcomeStatus.Accepted : AuditOutcomeStatus.AlreadyRecorded,
+                Applied = created
+            };
+
+            stdout.Write(reportBuilder.BuildCommandJson(
+                "initialize", outcome, history.Count, Path.GetFullPath(stateDirectory)));
+            stdout.Write('\n');
+            return ExitSuccess;
+        }
+    }
+
+    private static int Propose(AuditCommandLine commandLine, TextWriter stdout, AuditReportBuilder reportBuilder)
+    {
+        if (!commandLine.TryGetRequired("state", "--state", out var stateDirectory, out var error)
+            || !commandLine.TryGetRequired("requestId", "--request-id", out var requestId, out error)
+            || !commandLine.TryGetRequired("proposer", "--proposer", out var proposer, out error)
+            || !commandLine.TryGetRequired("reason", "--reason", out var reason, out error)
+            || !commandLine.TryGetRequired("evidence", "--evidence", out var evidence, out error))
+        {
+            return Fail(stdout, reportBuilder, "propose", error!);
+        }
+
+        if (!commandLine.TryGetRequiredDate("businessDate", "--business-date", out var businessDate, out error))
+        {
+            return Fail(stdout, reportBuilder, "propose", error!);
+        }
+
+        var services = Compose(stateDirectory, out var provider);
+        using (provider)
+        {
+            services.Initialize();
+            var outcome = services.Propose(new ProposeResolutionCommand
+            {
+                RequestId = requestId,
+                Proposer = proposer,
+                BusinessDate = businessDate,
+                Reason = reason,
+                Evidence = evidence
+            });
+
+            return Emit(stdout, reportBuilder, "propose", outcome, services.ReadHistory().Count);
+        }
+    }
+
+    private static int Decide(AuditCommandLine commandLine, TextWriter stdout, AuditReportBuilder reportBuilder)
+    {
+        if (!commandLine.TryGetRequired("state", "--state", out var stateDirectory, out var error)
+            || !commandLine.TryGetRequired("requestId", "--request-id", out var requestId, out error)
+            || !commandLine.TryGetRequired("approver", "--approver", out var approver, out error)
+            || !commandLine.TryGetRequired("decision", "--decision", out var decisionText, out error))
+        {
+            return Fail(stdout, reportBuilder, "decide", error!);
+        }
+
+        if (!ResolutionDecisionParser.TryParse(decisionText, out var decision))
+        {
+            return Fail(
+                stdout,
+                reportBuilder,
+                "decide",
+                "Option '--decision' must be approve or reject.",
+                AuditErrorCodes.InvalidDecision);
+        }
+
+        var services = Compose(stateDirectory, out var provider);
+        using (provider)
+        {
+            services.Initialize();
+            var outcome = services.Decide(new DecideResolutionCommand
+            {
+                RequestId = requestId,
+                Approver = approver,
+                Decision = decision
+            });
+
+            return Emit(stdout, reportBuilder, "decide", outcome, services.ReadHistory().Count);
+        }
+    }
+
+    private static int Export(AuditCommandLine commandLine, TextWriter stdout, AuditReportBuilder reportBuilder)
+    {
+        if (!commandLine.TryGetRequired("state", "--state", out var stateDirectory, out var error)
+            || !commandLine.TryGetRequired("exportPath", "--export-path", out var exportPath, out error))
+        {
+            return Fail(stdout, reportBuilder, "export", error!);
+        }
+
+        if (!commandLine.TryGetRequiredDate("fromDate", "--from", out var fromDate, out error)
+            || !commandLine.TryGetRequiredDate("toDate", "--to", out var toDate, out error))
+        {
+            return Fail(stdout, reportBuilder, "export", error!);
+        }
+
+        if (fromDate > toDate)
+        {
+            return Fail(stdout, reportBuilder, "export", "Option '--from' must not be after '--to'.");
+        }
+
+        var services = Compose(stateDirectory, out var provider);
+        using (provider)
+        {
+            services.Initialize();
+            var history = services.ReadHistory();
+            var selected = services.SelectRange(history, fromDate, toDate);
+            var export = reportBuilder.BuildExport(history, selected, fromDate, toDate);
+            var json = reportBuilder.Serialize(export);
+
+            var fullPath = Path.GetFullPath(exportPath);
+            var directory = Path.GetDirectoryName(fullPath);
+            if (!string.IsNullOrEmpty(directory))
+            {
+                Directory.CreateDirectory(directory);
+            }
+
+            File.WriteAllText(fullPath, json + "\n", new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+
+            stdout.Write(json);
+            stdout.Write('\n');
+
+            // A broken hash chain means the history was tampered with; the export still ships so
+            // Compliance can see what survived, but the command reports the refusal.
+            return export.Integrity.ChainVerified ? ExitSuccess : ExitRefused;
+        }
+    }
+
+    private static int Emit(
+        TextWriter stdout,
+        AuditReportBuilder reportBuilder,
+        string command,
+        AuditCommandOutcome outcome,
+        int historyEntryCount)
+    {
+        stdout.Write(reportBuilder.BuildCommandJson(command, outcome, historyEntryCount));
+        stdout.Write('\n');
+        return outcome.IsSuccess ? ExitSuccess : ExitRefused;
+    }
+
+    private static int Fail(
+        TextWriter stdout,
+        AuditReportBuilder reportBuilder,
+        string command,
+        string message,
+        string errorCode = AuditErrorCodes.InvalidArgument)
+    {
+        stdout.Write(reportBuilder.BuildCommandJson(
+            string.IsNullOrEmpty(command) ? "unknown" : command,
+            Refused(errorCode, message),
+            0));
+        stdout.Write('\n');
+        return ExitRefused;
+    }
+
+    private static AuditCommandOutcome Refused(string errorCode, string message) => new()
+    {
+        Status = AuditOutcomeStatus.Invalid,
+        Applied = false,
+        ErrorCode = errorCode,
+        Message = message
+    };
+
+    private static AuditResolutionService Compose(string stateDirectory, out ServiceProvider provider)
+    {
+        var services = new ServiceCollection();
+        services.AddTradeReconAudit(stateDirectory);
+        provider = services.BuildServiceProvider();
+        return provider.GetRequiredService<AuditResolutionService>();
+    }
+}
