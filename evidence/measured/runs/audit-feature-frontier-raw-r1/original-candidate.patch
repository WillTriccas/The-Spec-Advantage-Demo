new file mode 100644
index 0000000..18d81a7
--- /dev/null
+++ b/src/TradeRecon.Domain/Audit/ResolutionRequestState.cs
@@ -0,0 +1,61 @@
+namespace TradeRecon.Domain.Audit;
+
+/// <summary>Lifecycle state of a resolution request, derived from the append-only history.</summary>
+public enum ResolutionState
+{
+    /// <summary>No proposal exists for the request identifier.</summary>
+    Unknown = 0,
+
+    /// <summary>Proposed and awaiting a checker's decision.</summary>
+    PendingApproval = 1,
+
+    /// <summary>A checker approved the proposal. Final.</summary>
+    Approved = 2,
+
+    /// <summary>A checker rejected the proposal. Final.</summary>
+    Rejected = 3
+}
+
+/// <summary>
+/// Read model for one resolution request, folded from the history. Never persisted: the
+/// append-only log is the single source of truth, so the projection can never drift from it.
+/// </summary>
+public sealed record ResolutionRequestState
+{
+    public required string RequestId { get; init; }
+    public required ResolutionState State { get; init; }
+    public required AuditEntry Proposal { get; init; }
+
+    /// <summary>The one durable final decision, or <c>null</c> while pending.</summary>
+    public AuditEntry? FinalDecision { get; init; }
+
+    public string Proposer => Proposal.Actor;
+    public DateOnly BusinessDate => Proposal.BusinessDate;
+    public bool IsFinal => FinalDecision is not null;
+
+    /// <summary>Folds a request's ordered entries into its current state.</summary>
+    public static ResolutionRequestState FromEntries(IEnumerable<AuditEntry> entries)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+
+        var ordered = entries.OrderBy(e => e.Sequence).ToList();
+        var proposal = ordered.FirstOrDefault(e => e.Action == ResolutionAction.Proposed)
+            ?? throw new InvalidOperationException("A resolution request must start with a proposal.");
+
+        // The store admits at most one decision per request; take the earliest defensively.
+        var decision = ordered.FirstOrDefault(e => e.IsDecision);
+
+        return new ResolutionRequestState
+        {
+            RequestId = proposal.RequestId,
+            Proposal = proposal,
+            FinalDecision = decision,
+            State = decision?.Action switch
+            {
+                ResolutionAction.Approved => ResolutionState.Approved,
+                ResolutionAction.Rejected => ResolutionState.Rejected,
+                _ => ResolutionState.PendingApproval
+            }
+        };
+    }
+}
