@@ -0,0 +1,84 @@
+using TradeRecon.Application.Audit;
+using TradeRecon.Infrastructure.Audit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>Scratch directory that removes itself at the end of a test.</summary>
+internal sealed class TempDirectory : IDisposable
+{
+    public TempDirectory()
+    {
+        Path = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"trade-recon-audit-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(Path);
+    }
+
+    public string Path { get; }
+
+    /// <summary>Path of the append-only history file inside this directory.</summary>
+    public string HistoryPath => System.IO.Path.Combine(Path, FileAuditLogStore.HistoryFileName);
+
+    public void Dispose()
+    {
+        try
+        {
+            Directory.Delete(Path, recursive: true);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            // A leaked temp directory must never fail a test run.
+        }
+    }
+}
+
+internal static class AuditTestSupport
+{
+    /// <summary>Reason text seeded with an account, an instrument and an amount.</summary>
+    public const string SensitiveReason =
+        "Custodian ACC002 mis-booked DE0005140008; net amount 1,600,500.00 EUR differs from trade T003.";
+
+    /// <summary>Evidence text seeded with the same classes of sensitive token.</summary>
+    public const string SensitiveEvidence =
+        "Break register row for ACC003 / JP3633400001 shows settlement S008 at 987654.32 JPY.";
+
+    /// <summary>Tokens that must never appear in command output or in the export.</summary>
+    public static readonly string[] SensitiveTokens =
+    [
+        "ACC002", "ACC003", "DE0005140008", "JP3633400001", "T003", "S008",
+        "1,600,500", "1600500", "987654", "987,654"
+    ];
+
+    public static AuditResolutionService CreateService(TempDirectory directory, TimeProvider? clock = null)
+        => new(new FileAuditLogStore(new AuditStoreOptions { StateDirectory = directory.Path }), clock);
+
+    public static ProposeResolutionCommand Proposal(
+        string requestId = "REQ-1001",
+        string proposer = "analyst.maker",
+        string businessDate = "2024-06-03",
+        string reason = "Timing difference confirmed with the custodian.",
+        string evidence = "Custodian statement reference in the shared evidence store.")
+        => new()
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = DateOnly.Parse(businessDate, System.Globalization.CultureInfo.InvariantCulture),
+            Reason = reason,
+            Evidence = evidence
+        };
+
+    /// <summary>Walks up from the test binaries to the repository root (the folder with the solution).</summary>
+    public static string RepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            if (File.Exists(System.IO.Path.Combine(directory.FullName, "TradeRecon.sln")))
+            {
+                return directory.FullName;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new InvalidOperationException("The repository root containing TradeRecon.sln was not found.");
+    }
+}
