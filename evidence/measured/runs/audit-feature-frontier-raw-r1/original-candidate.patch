+namespace TradeRecon.Domain.Audit;
+
+/// <summary>
+/// The maker-checker role an actor held when an audit entry was recorded. Segregation of
+/// duties is enforced by requiring the checker of a request to be a different identity
+/// from its proposer.
+/// </summary>
+public enum ResolutionRole
+{
+    /// <summary>The identity that proposed the resolution (the "maker").</summary>
+    Proposer = 0,
+
+    /// <summary>The identity that approved or rejected the proposal (the "checker").</summary>
+    Checker = 1
+}
diff --git a/src/TradeRecon.Infrastructure/Audit/AuditEntryDocument.cs b/src/TradeRecon.Infrastructure/Audit/AuditEntryDocument.cs
new file mode 100644
index 0000000..11a2fda
--- /dev/null
+++ b/src/TradeRecon.Infrastructure/Audit/AuditEntryDocument.cs
@@ -0,0 +1,117 @@
+using System.Globalization;
+using System.Text;
+using System.Text.Json;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Infrastructure.Audit;
+
+/// <summary>
+/// On-disk representation of one audit entry. Kept separate from the domain record so the
+/// persisted shape is an explicit, stable contract rather than an accident of the model.
+/// </summary>
+internal sealed record AuditEntryDocument
+{
+    public long Sequence { get; init; }
+    public string PreviousEntryHash { get; init; } = string.Empty;
+    public string RequestId { get; init; } = string.Empty;
+    public string BusinessDate { get; init; } = string.Empty;
+    public string Action { get; init; } = string.Empty;
+    public string Actor { get; init; } = string.Empty;
+    public string ActorRole { get; init; } = string.Empty;
+    public string Proposer { get; init; } = string.Empty;
+    public int Version { get; init; }
+    public string RecordedAt { get; init; } = string.Empty;
+    public string ReasonHash { get; init; } = string.Empty;
+    public string EvidenceHash { get; init; } = string.Empty;
+
+    /// <summary>Reason text with identifiers and amounts masked before it was retained.</summary>
+    public string ReasonRedacted { get; init; } = string.Empty;
+
+    /// <summary>Evidence text with identifiers and amounts masked before it was retained.</summary>
+    public string EvidenceRedacted { get; init; } = string.Empty;
+
+    public string EntryHash { get; init; } = string.Empty;
+
+    private static readonly JsonSerializerOptions Options = new()
+    {
+        WriteIndented = false,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
+    };
+
+    public static string Serialize(AuditEntry entry) => JsonSerializer.Serialize(
+        new AuditEntryDocument
+        {
+            Sequence = entry.Sequence,
+            PreviousEntryHash = entry.PreviousEntryHash,
+            RequestId = entry.RequestId,
+            BusinessDate = entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            Action = entry.Action.ToString(),
+            Actor = entry.Actor,
+            ActorRole = entry.ActorRole.ToString(),
+            Proposer = entry.Proposer,
+            Version = entry.Version,
+            RecordedAt = entry.RecordedAtText,
+            ReasonHash = entry.ReasonHash,
+            EvidenceHash = entry.EvidenceHash,
+            ReasonRedacted = entry.ReasonRedacted,
+            EvidenceRedacted = entry.EvidenceRedacted,
+            EntryHash = entry.EntryHash
+        },
+        Options);
+
+    public static AuditEntry Deserialize(string line, int lineNumber)
+    {
+        AuditEntryDocument? document;
+        try
+        {
+            document = JsonSerializer.Deserialize<AuditEntryDocument>(line, Options);
+        }
+        catch (JsonException ex)
+        {
+            throw new Application.Abstractions.AuditStoreException(
+                $"Audit history line {lineNumber.ToString(CultureInfo.InvariantCulture)} is not valid JSON.", ex);
+        }
+
+        if (document is null)
+        {
+            throw new Application.Abstractions.AuditStoreException(
+                $"Audit history line {lineNumber.ToString(CultureInfo.InvariantCulture)} is empty.");
+        }
+
+        if (!DateOnly.TryParseExact(document.BusinessDate, "yyyy-MM-dd", CultureInfo.InvariantCulture,
+                DateTimeStyles.None, out var businessDate)
+            || !Enum.TryParse<ResolutionAction>(document.Action, ignoreCase: false, out var action)
+            || !Enum.TryParse<ResolutionRole>(document.ActorRole, ignoreCase: false, out var role)
+            || !DateTimeOffset.TryParseExact(document.RecordedAt, AuditEntry.TimestampFormat,
+                CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
+                out var recordedAt))
+        {
+            throw new Application.Abstractions.AuditStoreException(
+                $"Audit history line {lineNumber.ToString(CultureInfo.InvariantCulture)} has unreadable fields.");
+        }
+
+        // The stored hash is preserved verbatim so that tampering stays detectable; it is never
+        // recomputed on read.
+        return new AuditEntry
+        {
+            Sequence = document.Sequence,
+            PreviousEntryHash = document.PreviousEntryHash,
+            RequestId = document.RequestId,
+            BusinessDate = businessDate,
+            Action = action,
+            Actor = document.Actor,
+            ActorRole = role,
+            Proposer = document.Proposer,
+            Version = document.Version,
+            RecordedAtUtc = recordedAt,
+            ReasonHash = document.ReasonHash,
+            EvidenceHash = document.EvidenceHash,
+            ReasonRedacted = document.ReasonRedacted,
+            EvidenceRedacted = document.EvidenceRedacted,
+            EntryHash = document.EntryHash
+        };
+    }
+
+    /// <summary>UTF-8 without a BOM keeps the history byte-stable across platforms.</summary>
+    public static readonly Encoding FileEncoding = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
+}
