@@ -0,0 +1,129 @@
+using System.Text.Json.Serialization;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>One durable history record as published to Compliance.</summary>
+public sealed record JsonAuditEntry
+{
+    /// <summary>Global append order — the primary tamper-evident ordering signal.</summary>
+    public required long Sequence { get; init; }
+
+    /// <summary>Identity of the resolution request.</summary>
+    public required string RequestId { get; init; }
+
+    /// <summary>Business date of the reconciliation break under resolution.</summary>
+    public required string BusinessDate { get; init; }
+
+    /// <summary>Lifecycle action: Proposed, Approved or Rejected.</summary>
+    public required string Action { get; init; }
+
+    /// <summary>Identity that performed the action.</summary>
+    public required string Actor { get; init; }
+
+    /// <summary>Role held by the actor: Proposer or Checker.</summary>
+    public required string ActorRole { get; init; }
+
+    /// <summary>Identity that proposed the request.</summary>
+    public required string Proposer { get; init; }
+
+    /// <summary>Checker identity for decisions; null for proposals.</summary>
+    public string? Checker { get; init; }
+
+    /// <summary>Alias of <see cref="Checker"/> matching the command-line vocabulary.</summary>
+    public string? Approver { get; init; }
+
+    /// <summary>Approved/Rejected for decisions; null for proposals.</summary>
+    public string? Decision { get; init; }
+
+    /// <summary>True for the one durable decision that closed the request.</summary>
+    public required bool IsFinalDecision { get; init; }
+
+    /// <summary>Per-request version: 1 is the proposal, 2 the final decision.</summary>
+    public required int Version { get; init; }
+
+    /// <summary>UTC instant at which the entry became durable.</summary>
+    public required string RecordedAt { get; init; }
+
+    /// <summary>SHA-256 of the reason text; the text itself is never published.</summary>
+    public required string ReasonHash { get; init; }
+
+    /// <summary>SHA-256 of the evidence text; the text itself is never published.</summary>
+    public required string EvidenceHash { get; init; }
+
+    /// <summary>Hash of the preceding entry.</summary>
+    public required string PreviousEntryHash { get; init; }
+
+    /// <summary>Hash over this entry's content, chaining it to its predecessor.</summary>
+    public required string EntryHash { get; init; }
+}
+
+/// <summary>Chain-verification summary published alongside the exported entries.</summary>
+public sealed record JsonAuditIntegrity
+{
+    public required bool ChainVerified { get; init; }
+    public required int TotalEntries { get; init; }
+    public required string HeadHash { get; init; }
+    public long? FirstInvalidSequence { get; init; }
+}
+
+/// <summary>Per-request roll-up proving four-eyes review for closed requests.</summary>
+public sealed record JsonAuditRequestSummary
+{
+    public required string RequestId { get; init; }
+    public required string BusinessDate { get; init; }
+    public required string State { get; init; }
+    public required string Proposer { get; init; }
+    public string? Checker { get; init; }
+    public string? Decision { get; init; }
+    public required bool HasFinalDecision { get; init; }
+
+    /// <summary>True when a decision exists and its checker differs from the proposer.</summary>
+    public required bool SegregationOfDutiesSatisfied { get; init; }
+
+    public long? ProposalSequence { get; init; }
+    public long? DecisionSequence { get; init; }
+}
+
+/// <summary>The append-only history export for a date range.</summary>
+public sealed record JsonAuditExport
+{
+    public required string SchemaVersion { get; init; }
+    public required string Command { get; init; }
+    public required string FromDate { get; init; }
+    public required string ToDate { get; init; }
+    public required int EntryCount { get; init; }
+    public required int RequestCount { get; init; }
+    public required JsonAuditIntegrity Integrity { get; init; }
+    public required IReadOnlyList<JsonAuditRequestSummary> Requests { get; init; }
+    public required IReadOnlyList<JsonAuditEntry> Entries { get; init; }
+}
+
+/// <summary>Result document emitted by initialize, propose and decide.</summary>
+public sealed record JsonAuditCommandResult
+{
+    public required string SchemaVersion { get; init; }
+    public required string Command { get; init; }
+    public required string Status { get; init; }
+    public required bool Applied { get; init; }
+    public string? ErrorCode { get; init; }
+    public string? Message { get; init; }
+    public string? RequestId { get; init; }
+    public string? BusinessDate { get; init; }
+    public string? State { get; init; }
+    public string? Proposer { get; init; }
+    public string? Checker { get; init; }
+    public string? Decision { get; init; }
+    public bool? SegregationOfDutiesSatisfied { get; init; }
+
+    /// <summary>Entry this call created, or the durable entry it collided with.</summary>
+    public JsonAuditEntry? Entry { get; init; }
+
+    /// <summary>The single final decision for the request, once one exists.</summary>
+    public JsonAuditEntry? FinalDecision { get; init; }
+
+    /// <summary>Total entries in the history after the call.</summary>
+    public required int HistoryEntryCount { get; init; }
+
+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
+    public string? StateDirectory { get; init; }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditReportBuilder.cs b/src/TradeRecon.Application/Audit/AuditReportBuilder.cs
new file mode 100644
index 0000000..6d0fa04
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditReportBuilder.cs
@@ -0,0 +1,155 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Renders the deterministic JSON documents published by the audit command line.
+///
+/// Publication rule: an audit entry is projected to request identity, lifecycle action, actor
+/// identity/role and tamper-evidence metadata only. Reason and evidence appear as SHA-256
+/// digests, so the export is verifiable against the original text without disclosing it, and
+/// no account identifier or trade amount carried in that text can reach the export.
+/// </summary>
+public sealed class AuditReportBuilder
+{
+    /// <summary>Version stamped into every audit document so evaluators can pin expectations.</summary>
+    public const string JsonSchemaVersion = "1.0";
+
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        WriteIndented = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        Converters = { new JsonStringEnumConverter() }
+    };
+
+    /// <summary>Serialises the result of initialize, propose or decide.</summary>
+    public string BuildCommandJson(
+        string command,
+        AuditCommandOutcome outcome,
+        int historyEntryCount,
+        string? stateDirectory = null)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(outcome);
+
+        var request = outcome.Request;
+        var final = request?.FinalDecision;
+
+        var result = new JsonAuditCommandResult
+        {
+            SchemaVersion = JsonSchemaVersion,
+            Command = command,
+            Status = outcome.Status.ToString(),
+            Applied = outcome.Applied,
+            ErrorCode = outcome.ErrorCode,
+            Message = outcome.Message,
+            RequestId = request?.RequestId ?? outcome.Entry?.RequestId,
+            BusinessDate = request is null ? null : FormatDate(request.BusinessDate),
+            State = request?.State.ToString(),
+            Proposer = request?.Proposer,
+            Checker = final?.Actor,
+            Decision = final?.Action.ToString(),
+            SegregationOfDutiesSatisfied = final is null ? null : !IdentitiesMatch(final.Actor, request!.Proposer),
+            Entry = outcome.Entry is null ? null : Project(outcome.Entry, request),
+            FinalDecision = final is null ? null : Project(final, request),
+            HistoryEntryCount = historyEntryCount,
+            StateDirectory = stateDirectory
+        };
+
+        return JsonSerializer.Serialize(result, JsonOptions);
+    }
+
+    /// <summary>Builds the append-only history export for a closed date range.</summary>
+    public JsonAuditExport BuildExport(
+        IReadOnlyList<AuditEntry> allEntries,
+        IReadOnlyList<AuditEntry> selectedEntries,
+        DateOnly fromDate,
+        DateOnly toDate)
+    {
+        ArgumentNullException.ThrowIfNull(allEntries);
+        ArgumentNullException.ThrowIfNull(selectedEntries);
+
+        var verification = AuditChainVerifier.Verify(allEntries);
+        var requests = AuditResolutionService.ProjectRequests(selectedEntries);
+
+        return new JsonAuditExport
+        {
+            SchemaVersion = JsonSchemaVersion,
+            Command = "export",
+            FromDate = FormatDate(fromDate),
+            ToDate = FormatDate(toDate),
+            EntryCount = selectedEntries.Count,
+            RequestCount = requests.Count,
+            Integrity = new JsonAuditIntegrity
+            {
+                ChainVerified = verification.IsValid,
+                TotalEntries = verification.EntryCount,
+                HeadHash = verification.HeadHash,
+                FirstInvalidSequence = verification.FirstInvalidSequence
+            },
+            Requests = requests.Select(r => new JsonAuditRequestSummary
+            {
+                RequestId = r.RequestId,
+                BusinessDate = FormatDate(r.BusinessDate),
+                State = r.State.ToString(),
+                Proposer = r.Proposer,
+                Checker = r.FinalDecision?.Actor,
+                Decision = r.FinalDecision?.Action.ToString(),
+                HasFinalDecision = r.IsFinal,
+                SegregationOfDutiesSatisfied =
+                    r.FinalDecision is not null && !IdentitiesMatch(r.FinalDecision.Actor, r.Proposer),
+                ProposalSequence = r.Proposal.Sequence,
+                DecisionSequence = r.FinalDecision?.Sequence
+            }).ToList(),
+            Entries = selectedEntries.Select(e => Project(e, FindRequest(requests, e.RequestId))).ToList()
+        };
+    }
+
+    /// <summary>Serialises an export document.</summary>
+    public string Serialize(JsonAuditExport export)
+    {
+        ArgumentNullException.ThrowIfNull(export);
+        return JsonSerializer.Serialize(export, JsonOptions);
+    }
+
+    private static ResolutionRequestState? FindRequest(
+        IReadOnlyList<ResolutionRequestState> requests,
+        string requestId)
+        => requests.FirstOrDefault(r => string.Equals(r.RequestId, requestId, StringComparison.OrdinalIgnoreCase));
+
+    private static JsonAuditEntry Project(AuditEntry entry, ResolutionRequestState? request)
+    {
+        var isFinal = entry.IsDecision
+            && (request?.FinalDecision is null || request.FinalDecision.Sequence == entry.Sequence);
+
+        return new JsonAuditEntry
+        {
+            Sequence = entry.Sequence,
+            RequestId = entry.RequestId,
+            BusinessDate = FormatDate(entry.BusinessDate),
+            Action = entry.Action.ToString(),
+            Actor = entry.Actor,
+            ActorRole = entry.ActorRole.ToString(),
+            Proposer = entry.Proposer,
+            Checker = entry.Checker,
+            Approver = entry.Checker,
+            Decision = entry.IsDecision ? entry.Action.ToString() : null,
+            IsFinalDecision = isFinal,
+            Version = entry.Version,
+            RecordedAt = entry.RecordedAtText,
+            ReasonHash = entry.ReasonHash,
+            EvidenceHash = entry.EvidenceHash,
+            PreviousEntryHash = entry.PreviousEntryHash,
+            EntryHash = entry.EntryHash
+        };
+    }
+
+    private static bool IdentitiesMatch(string left, string right)
+        => string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);
+
+    private static string FormatDate(DateOnly value)
+        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+}
diff --git a/src/TradeRecon.Application/Audit/AuditResolutionService.cs b/src/TradeRecon.Application/Audit/AuditResolutionService.cs
new file mode 100644
index 0000000..75e4a98
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditResolutionService.cs
@@ -0,0 +1,309 @@
+using TradeRecon.Application.Abstractions;
+using TradeRecon.Domain.Audit;
+
+namespace TradeRecon.Application.Audit;
+
+/// <summary>
+/// Maker-checker workflow for reconciliation-break resolutions, on top of an append-only
+/// history.
+///
+/// Guarantees:
+/// <list type="number">
+///   <item>Segregation of duties — a request's checker must differ from its proposer.</item>
+///   <item>Idempotent retries — replaying a propose/decide call appends nothing and returns
+///         the already durable fact.</item>
+///   <item>Exactly one final decision — read-decide-append runs inside the store's exclusive
+///         critical section, so concurrent conflicting decisions cannot both become durable.</item>
+///   <item>No sensitive disclosure — reason and evidence are hashed for tamper evidence and
+///         redacted before retention; neither is ever returned to a caller.</item>
+/// </list>
+/// </summary>
+public sealed class AuditResolutionService
+{
+    /// <summary>Longest accepted request identifier or actor identity.</summary>
+    public const int MaxIdentifierLength = 200;
+
+    /// <summary>Longest accepted reason or evidence text.</summary>
+    public const int MaxTextLength = 4000;
+
+    private readonly IAuditLogStore _store;
+    private readonly TimeProvider _clock;
+
+    public AuditResolutionService(IAuditLogStore store, TimeProvider? clock = null)
+    {
+        _store = store ?? throw new ArgumentNullException(nameof(store));
+        _clock = clock ?? TimeProvider.System;
+    }
+
+    /// <summary>Creates the store if needed. Safe to call repeatedly.</summary>
+    public bool Initialize() => _store.Initialize();
+
+    /// <summary>Reads the whole history in append order.</summary>
+    public IReadOnlyList<AuditEntry> ReadHistory() => _store.ReadAll();
+
+    /// <summary>Records a proposal, or replays the existing one for the same request.</summary>
+    public AuditCommandOutcome Propose(ProposeResolutionCommand command)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        if (!TryNormaliseIdentifier(command.RequestId, out var requestId))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "A non-empty request identifier is required.");
+        }
+
+        if (!TryNormaliseIdentifier(command.Proposer, out var proposer))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "A non-empty proposer identity is required.");
+        }
+
+        if (!IsAcceptableText(command.Reason))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "A non-empty reason within the length limit is required.");
+        }
+
+        if (!IsAcceptableText(command.Evidence))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "Non-empty evidence within the length limit is required.");
+        }
+
+        using var transaction = _store.BeginTransaction();
+        var existing = FindRequest(transaction.Entries, requestId);
+
+        if (existing is not null)
+        {
+            // Retries are idempotent on the request identifier. A different proposer replaying
+            // the same identifier is a collision, not a retry, so it is refused.
+            if (!IdentitiesMatch(existing.Proposer, proposer))
+            {
+                return new AuditCommandOutcome
+                {
+                    Status = AuditOutcomeStatus.Conflict,
+                    Applied = false,
+                    ErrorCode = AuditErrorCodes.ProposerMismatch,
+                    Message = "The request identifier is already owned by a different proposer.",
+                    Entry = existing.Proposal,
+                    Request = existing
+                };
+            }
+
+            return new AuditCommandOutcome
+            {
+                Status = AuditOutcomeStatus.AlreadyRecorded,
+                Applied = false,
+                Entry = existing.Proposal,
+                Request = existing
+            };
+        }
+
+        var entry = AuditEntry.Create(
+            sequence: transaction.Entries.Count + 1,
+            previousEntryHash: HeadHash(transaction.Entries),
+            requestId: requestId,
+            businessDate: command.BusinessDate,
+            action: ResolutionAction.Proposed,
+            actor: proposer,
+            actorRole: ResolutionRole.Proposer,
+            proposer: proposer,
+            version: 1,
+            recordedAtUtc: NextTimestamp(transaction.Entries),
+            reasonHash: AuditHash.OfText(command.Reason),
+            evidenceHash: AuditHash.OfText(command.Evidence),
+            reasonRedacted: SensitiveTextRedactor.Redact(command.Reason),
+            evidenceRedacted: SensitiveTextRedactor.Redact(command.Evidence));
+
+        transaction.Append(entry);
+
+        return new AuditCommandOutcome
+        {
+            Status = AuditOutcomeStatus.Accepted,
+            Applied = true,
+            Entry = entry,
+            Request = ResolutionRequestState.FromEntries([entry])
+        };
+    }
+
+    /// <summary>Records the single final decision for a request, enforcing four-eyes review.</summary>
+    public AuditCommandOutcome Decide(DecideResolutionCommand command)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+
+        if (!TryNormaliseIdentifier(command.RequestId, out var requestId))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "A non-empty request identifier is required.");
+        }
+
+        if (!TryNormaliseIdentifier(command.Approver, out var approver))
+        {
+            return Invalid(AuditErrorCodes.InvalidArgument, "A non-empty approver identity is required.");
+        }
+
+        if (command.Decision is not (ResolutionAction.Approved or ResolutionAction.Rejected))
+        {
+            return Invalid(AuditErrorCodes.InvalidDecision, "The decision must be approve or reject.");
+        }
+
+        using var transaction = _store.BeginTransaction();
+        var existing = FindRequest(transaction.Entries, requestId);
+
+        if (existing is null)
+        {
+            return new AuditCommandOutcome
+            {
+                Status = AuditOutcomeStatus.NotFound,
+                Applied = false,
+                ErrorCode = AuditErrorCodes.RequestNotFound,
+                Message = "No proposal exists for the supplied request identifier."
+            };
+        }
+
+        // Segregation of duties is checked before anything else durable happens, and a refused
+        // attempt never appends: the history only ever contains legitimate lifecycle facts.
+        if (IdentitiesMatch(existing.Proposer, approver))
+        {
+            return new AuditCommandOutcome
+            {
+                Status = AuditOutcomeStatus.Denied,
+                Applied = false,
+                ErrorCode = AuditErrorCodes.SelfApprovalForbidden,
+                Message = "A proposer may not decide their own resolution request.",
+                Request = existing
+            };
+        }
+
+        if (existing.FinalDecision is { } final)
+        {
+            var sameChecker = IdentitiesMatch(final.Actor, approver);
+            var sameDecision = final.Action == command.Decision;
+
+            // Same checker replaying the same decision is a retry; anything else is a race that
+            // arrived after the outcome was already durable.
+            return new AuditCommandOutcome
+            {
+                Status = sameChecker && sameDecision ? AuditOutcomeStatus.AlreadyRecorded : AuditOutcomeStatus.Conflict,
+                Applied = false,
+                ErrorCode = sameChecker && sameDecision ? null : AuditErrorCodes.AlreadyDecided,
+                Message = sameChecker && sameDecision
+                    ? null
+                    : "The request already has a final decision; it is immutable.",
+                Entry = final,
+                Request = existing
+            };
+        }
+
+        var entry = AuditEntry.Create(
+            sequence: transaction.Entries.Count + 1,
+            previousEntryHash: HeadHash(transaction.Entries),
+            requestId: requestId,
+            businessDate: existing.BusinessDate,
+            action: command.Decision,
+            actor: approver,
+            actorRole: ResolutionRole.Checker,
+            proposer: existing.Proposer,
+            version: existing.Proposal.Version + 1,
+            recordedAtUtc: NextTimestamp(transaction.Entries),
+            reasonHash: existing.Proposal.ReasonHash,
+            evidenceHash: existing.Proposal.EvidenceHash,
+            reasonRedacted: existing.Proposal.ReasonRedacted,
+            evidenceRedacted: existing.Proposal.EvidenceRedacted);
+
+        transaction.Append(entry);
+
+        return new AuditCommandOutcome
+        {
+            Status = AuditOutcomeStatus.Accepted,
+            Applied = true,
+            Entry = entry,
+            Request = ResolutionRequestState.FromEntries([existing.Proposal, entry])
+        };
+    }
+
+    /// <summary>
+    /// Selects the history for a closed date range. An entry is in range when either the
+    /// business date it relates to or the date it was recorded falls inside the window, so a
+    /// compliance query works whether it is framed in business or booking terms.
+    /// </summary>
+    public IReadOnlyList<AuditEntry> SelectRange(
+        IReadOnlyList<AuditEntry> entries,
+        DateOnly fromDate,
+        DateOnly toDate)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+
+        return entries
+            .Where(e => InRange(e.BusinessDate, fromDate, toDate)
+                || InRange(DateOnly.FromDateTime(e.RecordedAtUtc.UtcDateTime), fromDate, toDate))
+            .OrderBy(e => e.Sequence)
+            .ToList();
+    }
+
+    /// <summary>Folds the history into per-request read models, ordered by proposal sequence.</summary>
+    public static IReadOnlyList<ResolutionRequestState> ProjectRequests(IReadOnlyList<AuditEntry> entries)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+
+        return entries
+            .GroupBy(e => e.RequestId, StringComparer.OrdinalIgnoreCase)
+            .Select(g => ResolutionRequestState.FromEntries(g))
+            .OrderBy(r => r.Proposal.Sequence)
+            .ToList();
+    }
+
+    private static bool InRange(DateOnly value, DateOnly fromDate, DateOnly toDate)
+        => value >= fromDate && value <= toDate;
+
+    private static ResolutionRequestState? FindRequest(IReadOnlyList<AuditEntry> entries, string requestId)
+    {
+        var forRequest = entries
+            .Where(e => string.Equals(e.RequestId, requestId, StringComparison.OrdinalIgnoreCase))
+            .ToList();
+
+        return forRequest.Count == 0 ? null : ResolutionRequestState.FromEntries(forRequest);
+    }
+
+    private static string HeadHash(IReadOnlyList<AuditEntry> entries)
+        => entries.Count == 0 ? AuditHash.Genesis : entries[^1].EntryHash;
+
+    private DateTimeOffset NextTimestamp(IReadOnlyList<AuditEntry> entries)
+    {
+        var now = _clock.GetUtcNow().ToUniversalTime();
+        if (entries.Count > 0 && entries[^1].RecordedAtUtc > now)
+        {
+            // Clock skew must never make the history appear to go backwards.
+            return entries[^1].RecordedAtUtc;
+        }
+
+        return now;
+    }
+
+    private static bool IdentitiesMatch(string left, string right)
+        => string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);
+
+    private static bool TryNormaliseIdentifier(string? value, out string normalised)
+    {
+        normalised = string.Empty;
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return false;
+        }
+
+        var trimmed = value.Trim();
+        if (trimmed.Length > MaxIdentifierLength || trimmed.Any(char.IsControl))
+        {
+            return false;
+        }
+
+        normalised = trimmed;
+        return true;
+    }
+
+    private static bool IsAcceptableText(string? value)
+        => !string.IsNullOrWhiteSpace(value) && value.Length <= MaxTextLength;
+
+    private static AuditCommandOutcome Invalid(string errorCode, string message) => new()
+    {
+        Status = AuditOutcomeStatus.Invalid,
+        Applied = false,
+        ErrorCode = errorCode,
+        Message = message
+    };
+}
