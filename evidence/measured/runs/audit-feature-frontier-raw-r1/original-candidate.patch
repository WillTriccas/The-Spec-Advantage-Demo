+using TradeRecon.Application.Audit;
+using TradeRecon.Domain.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Behavioural contract for the maker-checker resolution workflow: segregation of duties,
+/// idempotent retries, exactly one durable final decision, and a tamper-evident history.
+/// </summary>
+public class AuditResolutionWorkflowTests
+{
+    [Fact]
+    public void ProposeThenApproveByAnotherPerson_RecordsBothLifecycleFacts()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+
+        var proposed = service.Propose(AuditTestSupport.Proposal());
+        var decided = service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.Equal(AuditOutcomeStatus.Accepted, proposed.Status);
+        Assert.Equal(AuditOutcomeStatus.Accepted, decided.Status);
+
+        var history = service.ReadHistory();
+        Assert.Equal(2, history.Count);
+        Assert.Equal(ResolutionAction.Proposed, history[0].Action);
+        Assert.Equal(ResolutionAction.Approved, history[1].Action);
+        Assert.Equal(ResolutionRole.Proposer, history[0].ActorRole);
+        Assert.Equal(ResolutionRole.Checker, history[1].ActorRole);
+        Assert.Equal("analyst.maker", history[1].Proposer);
+        Assert.Equal("supervisor.checker", history[1].Actor);
+        Assert.NotEqual(history[1].Proposer, history[1].Actor);
+        Assert.Equal(new[] { 1L, 2L }, history.Select(e => e.Sequence));
+        Assert.Equal(new[] { 1, 2 }, history.Select(e => e.Version));
+    }
+
+    [Fact]
+    public void ProposerMayNotDecideTheirOwnRequest_AndNothingIsAppended()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+
+        var denied = service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "  ANALYST.Maker ",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.Equal(AuditOutcomeStatus.Denied, denied.Status);
+        Assert.Equal(AuditErrorCodes.SelfApprovalForbidden, denied.ErrorCode);
+        Assert.False(denied.Applied);
+
+        var history = service.ReadHistory();
+        Assert.Single(history);
+        Assert.Equal(ResolutionAction.Proposed, history[0].Action);
+        Assert.DoesNotContain(history, e => e.IsDecision);
+    }
+
+    [Fact]
+    public void RepeatedPropose_IsIdempotent()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+
+        var first = service.Propose(AuditTestSupport.Proposal());
+        var replay = service.Propose(AuditTestSupport.Proposal());
+
+        Assert.Equal(AuditOutcomeStatus.Accepted, first.Status);
+        Assert.Equal(AuditOutcomeStatus.AlreadyRecorded, replay.Status);
+        Assert.False(replay.Applied);
+        Assert.True(replay.Replayed);
+        Assert.Equal(first.Entry!.EntryHash, replay.Entry!.EntryHash);
+        Assert.Single(service.ReadHistory());
+    }
+
+    [Fact]
+    public void ReusingARequestIdentifierWithADifferentProposer_IsRefused()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+
+        var collision = service.Propose(AuditTestSupport.Proposal(proposer: "another.maker"));
+
+        Assert.Equal(AuditOutcomeStatus.Conflict, collision.Status);
+        Assert.Equal(AuditErrorCodes.ProposerMismatch, collision.ErrorCode);
+        Assert.Single(service.ReadHistory());
+    }
+
+    [Fact]
+    public void RepeatedDecide_IsIdempotent()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+
+        var command = new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Rejected
+        };
+
+        var first = service.Decide(command);
+        var replay = service.Decide(command);
+
+        Assert.Equal(AuditOutcomeStatus.Accepted, first.Status);
+        Assert.Equal(AuditOutcomeStatus.AlreadyRecorded, replay.Status);
+        Assert.False(replay.Applied);
+        Assert.Equal(2, service.ReadHistory().Count);
+        Assert.Single(service.ReadHistory(), e => e.IsDecision);
+    }
+
+    [Theory]
+    [InlineData("supervisor.checker", ResolutionAction.Rejected)]
+    [InlineData("other.checker", ResolutionAction.Approved)]
+    public void ADecisionIsImmutableOnceDurable(string approver, ResolutionAction decision)
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+        service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        var conflicting = service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = approver,
+            Decision = decision
+        });
+
+        Assert.Equal(AuditOutcomeStatus.Conflict, conflicting.Status);
+        Assert.Equal(AuditErrorCodes.AlreadyDecided, conflicting.ErrorCode);
+
+        var decisions = service.ReadHistory().Where(e => e.IsDecision).ToList();
+        var single = Assert.Single(decisions);
+        Assert.Equal(ResolutionAction.Approved, single.Action);
+        Assert.Equal("supervisor.checker", single.Actor);
+    }
+
+    [Fact]
+    public void DecidingAnUnknownRequest_IsRefused()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+
+        var outcome = service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-does-not-exist",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        Assert.Equal(AuditOutcomeStatus.NotFound, outcome.Status);
+        Assert.Equal(AuditErrorCodes.RequestNotFound, outcome.ErrorCode);
+        Assert.Empty(service.ReadHistory());
+    }
+
+    [Fact]
+    public void ConcurrentConflictingDecisions_ProduceExactlyOneDurableFinalDecision()
+    {
+        using var directory = new TempDirectory();
+        AuditTestSupport.CreateService(directory).Propose(AuditTestSupport.Proposal());
+
+        // Each worker uses its own store instance on a dedicated thread, so they contend for the
+        // store's exclusive lock exactly as separate processes would.
+        var outcomes = RunConcurrently(8, i =>
+            AuditTestSupport.CreateService(directory).Decide(new DecideResolutionCommand
+            {
+                RequestId = "REQ-1001",
+                Approver = $"checker.{i}",
+                Decision = i % 2 == 0 ? ResolutionAction.Approved : ResolutionAction.Rejected
+            }));
+
+        Assert.Single(outcomes, o => o.Applied);
+
+        var history = AuditTestSupport.CreateService(directory).ReadHistory();
+        var decision = Assert.Single(history, e => e.IsDecision);
+        Assert.Equal(2, history.Count);
+        Assert.NotEqual(decision.Proposer, decision.Actor);
+        Assert.True(AuditChainVerifier.Verify(history).IsValid);
+    }
+
+    [Fact]
+    public void ConcurrentProposalsForOneRequest_AppendOnlyOnce()
+    {
+        using var directory = new TempDirectory();
+
+        var outcomes = RunConcurrently(6, _ =>
+            AuditTestSupport.CreateService(directory).Propose(AuditTestSupport.Proposal()));
+
+        Assert.Single(outcomes, o => o.Applied);
+        Assert.All(outcomes, o => Assert.True(o.IsSuccess));
+        Assert.Single(AuditTestSupport.CreateService(directory).ReadHistory());
+    }
+
+    /// <summary>Releases <paramref name="count"/> dedicated threads into <paramref name="work"/> at once.</summary>
+    private static AuditCommandOutcome[] RunConcurrently(int count, Func<int, AuditCommandOutcome> work)
+    {
+        var outcomes = new AuditCommandOutcome[count];
+        var failures = new Exception?[count];
+        using var start = new ManualResetEventSlim(false);
+        var threads = new Thread[count];
+
+        for (var i = 0; i < count; i++)
+        {
+            var index = i;
+            threads[index] = new Thread(() =>
+            {
+                start.Wait();
+                try
+                {
+                    outcomes[index] = work(index);
+                }
+                catch (Exception ex)
+                {
+                    failures[index] = ex;
+                }
+            })
+            { IsBackground = true };
+            threads[index].Start();
+        }
+
+        start.Set();
+        foreach (var thread in threads)
+        {
+            Assert.True(thread.Join(TimeSpan.FromMinutes(1)), "A concurrent audit worker did not finish.");
+        }
+
+        Assert.All(failures, failure => Assert.Null(failure));
+        return outcomes;
+    }
+
+    [Fact]
+    public void TheHistoryIsHashChainedAndDetectsTampering()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+        service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Approved
+        });
+
+        var clean = service.ReadHistory();
+        Assert.True(AuditChainVerifier.Verify(clean).IsValid);
+        Assert.Equal(AuditHash.Genesis, clean[0].PreviousEntryHash);
+        Assert.Equal(clean[0].EntryHash, clean[1].PreviousEntryHash);
+
+        var lines = File.ReadAllLines(directory.HistoryPath);
+        lines[1] = lines[1].Replace("supervisor.checker", "impostor.checker", StringComparison.Ordinal);
+        File.WriteAllLines(directory.HistoryPath, lines);
+
+        var verification = AuditChainVerifier.Verify(service.ReadHistory());
+        Assert.False(verification.IsValid);
+        Assert.Equal(2L, verification.FirstInvalidSequence);
+    }
+
+    [Fact]
+    public void HistoryIsAppendOnly_EarlierLinesAreNeverRewritten()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+        service.Propose(AuditTestSupport.Proposal());
+        var afterPropose = File.ReadAllLines(directory.HistoryPath);
+
+        service.Decide(new DecideResolutionCommand
+        {
+            RequestId = "REQ-1001",
+            Approver = "supervisor.checker",
+            Decision = ResolutionAction.Approved
+        });
+        var afterDecide = File.ReadAllLines(directory.HistoryPath);
+
+        Assert.Single(afterPropose);
+        Assert.Equal(2, afterDecide.Length);
+        Assert.Equal(afterPropose[0], afterDecide[0]);
+    }
+
+    [Fact]
+    public void ExportRange_SelectsByBusinessDateOrRecordedDate()
+    {
+        using var directory = new TempDirectory();
+        var clock = new FixedTimeProvider(new DateTimeOffset(2025, 1, 15, 9, 30, 0, TimeSpan.Zero));
+        var service = AuditTestSupport.CreateService(directory, clock);
+
+        service.Propose(AuditTestSupport.Proposal("REQ-JUNE", businessDate: "2024-06-03"));
+        service.Propose(AuditTestSupport.Proposal("REQ-JULY", businessDate: "2024-07-10"));
+
+        var history = service.ReadHistory();
+
+        var byBusinessDate = service.SelectRange(history, new DateOnly(2024, 6, 1), new DateOnly(2024, 6, 30));
+        Assert.Equal(new[] { "REQ-JUNE" }, byBusinessDate.Select(e => e.RequestId));
+
+        var byRecordedDate = service.SelectRange(history, new DateOnly(2025, 1, 1), new DateOnly(2025, 1, 31));
+        Assert.Equal(2, byRecordedDate.Count);
+
+        var outsideBoth = service.SelectRange(history, new DateOnly(2023, 1, 1), new DateOnly(2023, 12, 31));
+        Assert.Empty(outsideBoth);
+    }
+
+    [Fact]
+    public void ReasonAndEvidenceAreBoundByHashAndRedactedBeforeRetention()
+    {
+        using var directory = new TempDirectory();
+        var service = AuditTestSupport.CreateService(directory);
+
+        service.Propose(AuditTestSupport.Proposal(
+            reason: AuditTestSupport.SensitiveReason,
+            evidence: AuditTestSupport.SensitiveEvidence));
+
+        var entry = Assert.Single(service.ReadHistory());
+        Assert.Equal(AuditHash.OfText(AuditTestSupport.SensitiveReason), entry.ReasonHash);
+        Assert.Equal(AuditHash.OfText(AuditTestSupport.SensitiveEvidence), entry.EvidenceHash);
+
+        var persisted = File.ReadAllText(directory.HistoryPath);
+        foreach (var token in AuditTestSupport.SensitiveTokens)
+        {
+            Assert.DoesNotContain(token, persisted, StringComparison.OrdinalIgnoreCase);
+        }
+    }
+
+    [Theory]
+    [InlineData("Break on ACC002 for 1,600,500.00 EUR")]
+    [InlineData("Instrument DE0005140008 settled late")]
+    [InlineData("Trade T003 versus settlement S003")]
+    public void Redactor_MasksIdentifiersAndAmounts(string text)
+    {
+        var redacted = SensitiveTextRedactor.Redact(text);
+
+        Assert.Contains(SensitiveTextRedactor.Mask, redacted, StringComparison.Ordinal);
+        Assert.False(SensitiveTextRedactor.ContainsSensitiveTokens(redacted));
+    }
+
+    private sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+}
