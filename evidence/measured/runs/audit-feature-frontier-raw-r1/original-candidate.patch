diff --git a/tests/TradeRecon.Tests/AuditAdapterContractTests.cs b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
new file mode 100644
index 0000000..e927fac
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditAdapterContractTests.cs
@@ -0,0 +1,159 @@
+using System.Text.Json;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Contract tests for the data-only adapter files at the candidate root. The audit adapter is
+/// how an external evaluator drives the maker-checker workflow, so its shape, placeholders and
+/// shell-free command arrays are asserted here — and the pre-existing reconciliation adapter is
+/// asserted to be preserved.
+/// </summary>
+public class AuditAdapterContractTests
+{
+    private static readonly string[] Commands = ["initialize", "propose", "decide", "export"];
+
+    private static readonly Dictionary<string, string[]> RequiredPlaceholders = new(StringComparer.Ordinal)
+    {
+        ["initialize"] = ["{stateDirectory}"],
+        ["propose"] = ["{stateDirectory}", "{requestId}", "{proposer}", "{businessDate}", "{reason}", "{evidence}"],
+        ["decide"] = ["{stateDirectory}", "{requestId}", "{approver}", "{decision}"],
+        ["export"] = ["{stateDirectory}", "{fromDate}", "{toDate}", "{exportPath}"]
+    };
+
+    /// <summary>Characters that would imply a shell is interpreting the command.</summary>
+    private static readonly char[] ShellMetacharacters = ['|', '&', ';', '>', '<', '`', '$', '*', '?', '\n', '\r'];
+
+    private static readonly string[] Shells =
+        ["cmd", "cmd.exe", "sh", "bash", "zsh", "powershell", "powershell.exe", "pwsh", "pwsh.exe"];
+
+    [Fact]
+    public void AuditAdapterExistsAtTheCandidateRoot()
+        => Assert.True(File.Exists(AdapterPath("audit-adapter.json")));
+
+    [Theory]
+    [InlineData("initialize")]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    public void EachCommandIsAShellFreeExecutableAndArgumentArray(string command)
+    {
+        var element = AuditAdapter().GetProperty(command);
+        var executable = element.GetProperty("executable").GetString();
+
+        Assert.False(string.IsNullOrWhiteSpace(executable));
+        Assert.DoesNotContain(Path.GetFileName(executable!).ToLowerInvariant(), Shells);
+
+        var arguments = element.GetProperty("arguments");
+        Assert.Equal(JsonValueKind.Array, arguments.ValueKind);
+        Assert.NotEqual(0, arguments.GetArrayLength());
+
+        foreach (var argument in arguments.EnumerateArray())
+        {
+            var value = argument.GetString();
+            Assert.NotNull(value);
+            Assert.Equal(-1, value!.IndexOfAny(ShellMetacharacters));
+        }
+
+        var exitCodes = element.GetProperty("allowedExitCodes").EnumerateArray().Select(e => e.GetInt32()).ToList();
+        Assert.Contains(0, exitCodes);
+    }
+
+    [Theory]
+    [InlineData("initialize")]
+    [InlineData("propose")]
+    [InlineData("decide")]
+    [InlineData("export")]
+    public void EachCommandSuppliesItsRequiredPlaceholders(string command)
+    {
+        var arguments = AuditAdapter()
+            .GetProperty(command)
+            .GetProperty("arguments")
+            .EnumerateArray()
+            .Select(e => e.GetString() ?? string.Empty)
+            .ToList();
+
+        foreach (var placeholder in RequiredPlaceholders[command])
+        {
+            // A placeholder must be a whole argument so no quoting or splitting is ever needed.
+            Assert.Contains(placeholder, arguments);
+        }
+    }
+
+    [Fact]
+    public void PlaceholdersAreNotUsedOutsideTheirOwnCommand()
+    {
+        var adapter = AuditAdapter();
+        var known = RequiredPlaceholders.Values.SelectMany(v => v).Distinct(StringComparer.Ordinal).ToList();
+
+        foreach (var command in Commands)
+        {
+            var arguments = adapter.GetProperty(command)
+                .GetProperty("arguments")
+                .EnumerateArray()
+                .Select(e => e.GetString() ?? string.Empty)
+                .ToList();
+
+            var unexpected = known
+                .Except(RequiredPlaceholders[command], StringComparer.Ordinal)
+                .Where(arguments.Contains)
+                .ToList();
+
+            Assert.Empty(unexpected);
+        }
+    }
+
+    [Fact]
+    public void TheAuditAdapterCarriesASchemaVersionAndWorkingDirectory()
+    {
+        var adapter = AuditAdapter();
+
+        Assert.False(string.IsNullOrWhiteSpace(adapter.GetProperty("schemaVersion").GetString()));
+        Assert.False(string.IsNullOrWhiteSpace(adapter.GetProperty("workingDirectory").GetString()));
+    }
+
+    [Fact]
+    public void TheAuditAdapterTargetsAProjectThatExists()
+    {
+        var root = AuditTestSupport.RepositoryRoot();
+
+        foreach (var command in Commands)
+        {
+            var arguments = AuditAdapter().GetProperty(command)
+                .GetProperty("arguments")
+                .EnumerateArray()
+                .Select(e => e.GetString() ?? string.Empty)
+                .ToList();
+
+            var projectIndex = arguments.IndexOf("--project");
+            Assert.True(projectIndex >= 0 && projectIndex + 1 < arguments.Count);
+            Assert.True(File.Exists(Path.Combine(root, arguments[projectIndex + 1].Replace('/', Path.DirectorySeparatorChar))));
+        }
+    }
+
+    [Fact]
+    public void TheReconciliationAdapterIsPreserved()
+    {
+        var adapter = Adapter("benchmark-adapter.json");
+
+        foreach (var section in new[] { "build", "test", "run" })
+        {
+            var element = adapter.GetProperty(section);
+            Assert.False(string.IsNullOrWhiteSpace(element.GetProperty("executable").GetString()));
+            Assert.NotEqual(0, element.GetProperty("arguments").GetArrayLength());
+        }
+
+        var outputs = adapter.GetProperty("outputs").EnumerateArray().Select(e => e.GetString()).ToList();
+        Assert.Contains("{businessDate}/eod-summary.txt", outputs);
+        Assert.Contains("{businessDate}/eod-break-register.csv", outputs);
+        Assert.Contains("{businessDate}/eod-result.json", outputs);
+    }
+
+    private static JsonElement AuditAdapter() => Adapter("audit-adapter.json");
+
+    private static JsonElement Adapter(string fileName)
+        => JsonDocument.Parse(File.ReadAllText(AdapterPath(fileName))).RootElement;
+
+    private static string AdapterPath(string fileName)
+        => Path.Combine(AuditTestSupport.RepositoryRoot(), fileName);
+}
diff --git a/tests/TradeRecon.Tests/AuditCliContractTests.cs b/tests/TradeRecon.Tests/AuditCliContractTests.cs
new file mode 100644
index 0000000..d58c978
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditCliContractTests.cs
@@ -0,0 +1,326 @@
+using System.Text;
+using System.Text.Json;
+using Xunit;
+using AuditProgram = TradeRecon.Audit.Console.Program;
+
+namespace TradeRecon.Tests;
+
+/// <summary>
+/// Black-box contract for the audit command line: every invocation emits one parseable JSON
+/// document on stdout, exit codes are stable, retries are idempotent, self-approval is refused
+/// and nothing sensitive reaches stdout or the export.
+/// </summary>
+public class AuditCliContractTests
+{
+    private const string Proposer = "analyst.maker";
+    private const string Checker = "supervisor.checker";
+    private const string RequestId = "REQ-CLI-ALPHA";
+    private const string BusinessDate = "2024-06-03";
+
+    [Fact]
+    public void Initialize_CreatesTheHistoryAndIsIdempotent()
+    {
+        using var directory = new TempDirectory();
+
+        var first = Invoke("initialize", "--state", directory.Path);
+        var second = Invoke("initialize", "--state", directory.Path);
+
+        Assert.Equal(AuditProgram.ExitSuccess, first.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, second.ExitCode);
+        Assert.Equal("Accepted", first.Json.GetProperty("status").GetString());
+        Assert.True(first.Json.GetProperty("applied").GetBoolean());
+        Assert.Equal("AlreadyRecorded", second.Json.GetProperty("status").GetString());
+        Assert.False(second.Json.GetProperty("applied").GetBoolean());
+        Assert.True(File.Exists(directory.HistoryPath));
+    }
+
+    [Fact]
+    public void ProposeApproveExport_ProducesAFourEyesHistory()
+    {
+        using var directory = new TempDirectory();
+        var exportPath = Path.Combine(directory.Path, "export", "audit-history.json");
+
+        Assert.Equal(AuditProgram.ExitSuccess, Invoke("initialize", "--state", directory.Path).ExitCode);
+        var proposed = Propose(directory);
+        var decided = Decide(directory, Checker, "approve");
+        var exported = Invoke(
+            "export", "--state", directory.Path,
+            "--from", "2024-06-01", "--to", "2024-06-30",
+            "--export-path", exportPath);
+
+        Assert.Equal(AuditProgram.ExitSuccess, proposed.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, decided.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, exported.ExitCode);
+        Assert.Equal("Approved", decided.Json.GetProperty("state").GetString());
+        Assert.True(decided.Json.GetProperty("segregationOfDutiesSatisfied").GetBoolean());
+
+        // The export is written to the requested path and is byte-identical to stdout.
+        Assert.True(File.Exists(exportPath));
+        Assert.Equal(exported.StdOut.Trim(), File.ReadAllText(exportPath).Trim());
+
+        var entries = exported.Json.GetProperty("entries");
+        Assert.Equal(JsonValueKind.Array, entries.ValueKind);
+        Assert.Equal(2, entries.GetArrayLength());
+        Assert.True(exported.Json.GetProperty("integrity").GetProperty("chainVerified").GetBoolean());
+
+        var proposal = entries[0];
+        var decision = entries[1];
+        Assert.Equal(RequestId, proposal.GetProperty("requestId").GetString());
+        Assert.Equal("Proposed", proposal.GetProperty("action").GetString());
+        Assert.Equal(Proposer, proposal.GetProperty("actor").GetString());
+        Assert.Equal("Proposer", proposal.GetProperty("actorRole").GetString());
+        Assert.False(proposal.GetProperty("isFinalDecision").GetBoolean());
+
+        Assert.Equal("Approved", decision.GetProperty("action").GetString());
+        Assert.Equal(Checker, decision.GetProperty("actor").GetString());
+        Assert.Equal("Checker", decision.GetProperty("actorRole").GetString());
+        Assert.Equal(Checker, decision.GetProperty("approver").GetString());
+        Assert.Equal(Proposer, decision.GetProperty("proposer").GetString());
+        Assert.True(decision.GetProperty("isFinalDecision").GetBoolean());
+        Assert.NotEqual(
+            decision.GetProperty("proposer").GetString(),
+            decision.GetProperty("checker").GetString());
+
+        // Order and tamper-evidence metadata are present on every entry.
+        foreach (var entry in entries.EnumerateArray())
+        {
+            Assert.True(entry.GetProperty("sequence").GetInt64() > 0);
+            Assert.True(entry.GetProperty("version").GetInt32() > 0);
+            Assert.False(string.IsNullOrWhiteSpace(entry.GetProperty("recordedAt").GetString()));
+            Assert.Equal(64, entry.GetProperty("entryHash").GetString()!.Length);
+            Assert.Equal(64, entry.GetProperty("previousEntryHash").GetString()!.Length);
+        }
+
+        var request = Assert.Single(exported.Json.GetProperty("requests").EnumerateArray().ToList());
+        Assert.Equal("Approved", request.GetProperty("state").GetString());
+        Assert.True(request.GetProperty("hasFinalDecision").GetBoolean());
+        Assert.True(request.GetProperty("segregationOfDutiesSatisfied").GetBoolean());
+    }
+
+    [Fact]
+    public void SelfApproval_IsRefusedAndLeavesTheRequestPending()
+    {
+        using var directory = new TempDirectory();
+        Propose(directory);
+
+        var denied = Decide(directory, Proposer, "approve");
+
+        Assert.Equal(AuditProgram.ExitRefused, denied.ExitCode);
+        Assert.Equal("Denied", denied.Json.GetProperty("status").GetString());
+        Assert.Equal("self_approval_forbidden", denied.Json.GetProperty("errorCode").GetString());
+        Assert.False(denied.Json.GetProperty("applied").GetBoolean());
+        Assert.Equal("PendingApproval", denied.Json.GetProperty("state").GetString());
+
+        var exported = Export(directory);
+        Assert.Equal(1, exported.Json.GetProperty("entries").GetArrayLength());
+        Assert.Equal("PendingApproval", exported.Json.GetProperty("requests")[0].GetProperty("state").GetString());
+        Assert.False(exported.Json.GetProperty("requests")[0].GetProperty("hasFinalDecision").GetBoolean());
+    }
+
+    [Fact]
+    public void RetriesAreIdempotent()
+    {
+        using var directory = new TempDirectory();
+
+        var propose = Propose(directory);
+        var proposeRetry = Propose(directory);
+        var decide = Decide(directory, Checker, "reject");
+        var decideRetry = Decide(directory, Checker, "reject");
+
+        Assert.Equal(AuditProgram.ExitSuccess, propose.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, proposeRetry.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, decide.ExitCode);
+        Assert.Equal(AuditProgram.ExitSuccess, decideRetry.ExitCode);
+        Assert.True(propose.Json.GetProperty("applied").GetBoolean());
+        Assert.False(proposeRetry.Json.GetProperty("applied").GetBoolean());
+        Assert.True(decide.Json.GetProperty("applied").GetBoolean());
+        Assert.False(decideRetry.Json.GetProperty("applied").GetBoolean());
+
+        var exported = Export(directory);
+        Assert.Equal(2, exported.Json.GetProperty("entries").GetArrayLength());
+        Assert.Equal("Rejected", exported.Json.GetProperty("requests")[0].GetProperty("decision").GetString());
+    }
+
+    [Fact]
+    public void ASecondConflictingDecision_IsRefusedAndTheFirstStandsAsTheOnlyFinalDecision()
+    {
+        using var directory = new TempDirectory();
+        Propose(directory);
+        Decide(directory, Checker, "approve");
+
+        var conflicting = Decide(directory, "another.checker", "reject");
+
+        Assert.Equal(AuditProgram.ExitRefused, conflicting.ExitCode);
+        Assert.Equal("Conflict", conflicting.Json.GetProperty("status").GetString());
+        Assert.Equal("already_decided", conflicting.Json.GetProperty("errorCode").GetString());
+        Assert.Equal(Checker, conflicting.Json.GetProperty("checker").GetString());
+
+        var entries = Export(directory).Json.GetProperty("entries").EnumerateArray().ToList();
+        Assert.Equal(2, entries.Count);
+        Assert.Single(entries, e => e.GetProperty("isFinalDecision").GetBoolean());
+    }
+
+    [Fact]
+    public void SensitiveTextNeverReachesCommandOutputOrTheExport()
+    {
+        using var directory = new TempDirectory();
+
+        var proposed = Invoke(
+            "propose", "--state", directory.Path,
+            "--request-id", RequestId,
+            "--proposer", Proposer,
+            "--business-date", BusinessDate,
+            "--reason", AuditTestSupport.SensitiveReason,
+            "--evidence", AuditTestSupport.SensitiveEvidence);
+        var decided = Decide(directory, Checker, "approve");
+        var exported = Export(directory);
+
+        Assert.Equal(AuditProgram.ExitSuccess, proposed.ExitCode);
+
+        foreach (var token in AuditTestSupport.SensitiveTokens)
+        {
+            Assert.DoesNotContain(token, proposed.StdOut, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(token, proposed.StdErr, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(token, decided.StdOut, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(token, exported.StdOut, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(token, exported.StdErr, StringComparison.OrdinalIgnoreCase);
+        }
+
+        // The digests still bind the entry to the exact text that was supplied.
+        var proposal = exported.Json.GetProperty("entries")[0];
+        Assert.Equal(
+            TradeRecon.Domain.Audit.AuditHash.OfText(AuditTestSupport.SensitiveReason),
+            proposal.GetProperty("reasonHash").GetString());
+        Assert.Equal(
+            TradeRecon.Domain.Audit.AuditHash.OfText(AuditTestSupport.SensitiveEvidence),
+            proposal.GetProperty("evidenceHash").GetString());
+    }
+
+    [Fact]
+    public void ExportOutsideTheRequestedRange_ReturnsAnEmptyHistory()
+    {
+        using var directory = new TempDirectory();
+        Propose(directory);
+        Decide(directory, Checker, "approve");
+
+        var exported = Invoke(
+            "export", "--state", directory.Path,
+            "--from", "2020-01-01", "--to", "2020-12-31",
+            "--export-path", Path.Combine(directory.Path, "empty.json"));
+
+        Assert.Equal(AuditProgram.ExitSuccess, exported.ExitCode);
+        Assert.Equal(0, exported.Json.GetProperty("entryCount").GetInt32());
+        Assert.Empty(exported.Json.GetProperty("entries").EnumerateArray());
+        Assert.Equal(2, exported.Json.GetProperty("integrity").GetProperty("totalEntries").GetInt32());
+    }
+
+    [Fact]
+    public void ExportReportsATamperedHistory()
+    {
+        using var directory = new TempDirectory();
+        Propose(directory);
+        Decide(directory, Checker, "approve");
+
+        var lines = File.ReadAllLines(directory.HistoryPath);
+        lines[1] = lines[1].Replace(Checker, Proposer, StringComparison.Ordinal);
+        File.WriteAllLines(directory.HistoryPath, lines);
+
+        var exported = Export(directory);
+
+        Assert.Equal(AuditProgram.ExitRefused, exported.ExitCode);
+        Assert.False(exported.Json.GetProperty("integrity").GetProperty("chainVerified").GetBoolean());
+        Assert.Equal(2, exported.Json.GetProperty("integrity").GetProperty("firstInvalidSequence").GetInt64());
+    }
+
+    [Theory]
+    [InlineData("propose", "--state")]
+    [InlineData("decide", "--state")]
+    [InlineData("export", "--state")]
+    public void MissingRequiredOptions_AreRefusedWithParseableJson(string command, string option)
+    {
+        using var directory = new TempDirectory();
+
+        var result = Invoke(command, option, directory.Path);
+
+        Assert.Equal(AuditProgram.ExitRefused, result.ExitCode);
+        Assert.Equal("Invalid", result.Json.GetProperty("status").GetString());
+        Assert.Equal("invalid_argument", result.Json.GetProperty("errorCode").GetString());
+    }
+
+    [Theory]
+    [InlineData("maybe")]
+    [InlineData("")]
+    public void AnUnrecognisedDecision_IsRefused(string decision)
+    {
+        using var directory = new TempDirectory();
+        Propose(directory);
+
+        var result = Decide(directory, Checker, decision);
+
+        Assert.Equal(AuditProgram.ExitRefused, result.ExitCode);
+        Assert.Equal("Invalid", result.Json.GetProperty("status").GetString());
+        Assert.Equal(1, Export(directory).Json.GetProperty("entries").GetArrayLength());
+    }
+
+    [Theory]
+    [InlineData("resolve")]
+    [InlineData("--state")]
+    public void AnUnknownSubCommand_IsRefusedWithParseableJson(string command)
+    {
+        var result = Invoke(command);
+
+        Assert.Equal(AuditProgram.ExitRefused, result.ExitCode);
+        Assert.Equal("Invalid", result.Json.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public void FreeTextValuesAreTakenVerbatim()
+    {
+        using var directory = new TempDirectory();
+
+        // A reason that looks like an option must not be reinterpreted as one.
+        var result = Invoke(
+            "propose", "--state", directory.Path,
+            "--request-id", RequestId,
+            "--proposer", Proposer,
+            "--business-date", BusinessDate,
+            "--reason", "--custodian confirmed the timing difference",
+            "--evidence", "--attachment in the evidence store");
+
+        Assert.Equal(AuditProgram.ExitSuccess, result.ExitCode);
+        Assert.True(result.Json.GetProperty("applied").GetBoolean());
+    }
+
+    private static CommandResult Propose(TempDirectory directory) => Invoke(
+        "propose", "--state", directory.Path,
+        "--request-id", RequestId,
+        "--proposer", Proposer,
+        "--business-date", BusinessDate,
+        "--reason", "Custodian confirmed a timing difference on the settlement leg.",
+        "--evidence", "Custodian statement filed in the evidence store.");
+
+    private static CommandResult Decide(TempDirectory directory, string approver, string decision) => Invoke(
+        "decide", "--state", directory.Path,
+        "--request-id", RequestId,
+        "--approver", approver,
+        "--decision", decision);
+
+    private static CommandResult Export(TempDirectory directory) => Invoke(
+        "export", "--state", directory.Path,
+        "--from", "2024-01-01", "--to", "2030-12-31",
+        "--export-path", Path.Combine(directory.Path, "audit-export.json"));
+
+    private static CommandResult Invoke(params string[] args)
+    {
+        var stdout = new StringWriter(new StringBuilder());
+        var stderr = new StringWriter(new StringBuilder());
+        var exitCode = AuditProgram.Run(args, stdout, stderr);
+        return new CommandResult(exitCode, stdout.ToString(), stderr.ToString());
+    }
+
+    private sealed record CommandResult(int ExitCode, string StdOut, string StdErr)
+    {
+        /// <summary>Parses stdout, which is always exactly one JSON document.</summary>
+        public JsonElement Json => JsonDocument.Parse(StdOut).RootElement;
+    }
+}
