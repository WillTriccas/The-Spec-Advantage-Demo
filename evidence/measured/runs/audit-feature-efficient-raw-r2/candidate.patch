diff --git a/tests/TradeRecon.Tests/AuditCliTests.cs b/tests/TradeRecon.Tests/AuditCliTests.cs
new file mode 100644
index 0000000..31a33bf
--- /dev/null
+++ b/tests/TradeRecon.Tests/AuditCliTests.cs
@@ -0,0 +1,150 @@
+using System.Diagnostics;
+using System.Text.Json;
+using AuditCliProgram = TradeRecon.AuditCli.Program;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditCliTests
+{
+    [Fact]
+    public async Task ProposeAndDecide_Workflow_IsIdempotentAndSanitized()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "audit-cli-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            var initialize = await InvokeAsync("initialize", stateDirectory);
+            using var initDoc = JsonDocument.Parse(initialize);
+            Assert.True(initDoc.RootElement.GetProperty("ok").GetBoolean());
+
+            var propose = await InvokeAsync(
+                "propose",
+                stateDirectory,
+                "REQ-001",
+                "analyst",
+                "2024-06-03",
+                "Trade amount mismatch due to account ACC-00042.",
+                "Trade amount $123.45 for account ACC-00042; settlement should match.");
+
+            using var proposeDoc = JsonDocument.Parse(propose);
+            Assert.Equal("proposed", proposeDoc.RootElement.GetProperty("status").GetString());
+            Assert.DoesNotContain("ACC-00042", propose);
+            Assert.DoesNotContain("$123.45", propose);
+
+            var approve = await InvokeAsync("decide", stateDirectory, "REQ-001", "checker", "approved");
+            using var approveDoc = JsonDocument.Parse(approve);
+            Assert.True(approveDoc.RootElement.GetProperty("ok").GetBoolean());
+            Assert.Equal("approved", approveDoc.RootElement.GetProperty("finalDecision").GetString());
+            Assert.Equal("checker", approveDoc.RootElement.GetProperty("approver").GetString());
+
+            var retry = await InvokeAsync("decide", stateDirectory, "REQ-001", "checker", "approved");
+            using var retryDoc = JsonDocument.Parse(retry);
+            Assert.True(retryDoc.RootElement.GetProperty("idempotent").GetBoolean());
+
+            var exportPath = Path.Combine(stateDirectory, "history.json");
+            var export = await InvokeAsync("export", stateDirectory, "2024-06-03", "2024-06-03", exportPath);
+            using var exportDoc = JsonDocument.Parse(export);
+            var entries = exportDoc.RootElement.GetProperty("entries");
+            Assert.Equal(2, entries.GetArrayLength());
+            Assert.Equal("proposed", entries[0].GetProperty("action").GetString());
+            Assert.Equal("approved", entries[1].GetProperty("action").GetString());
+            Assert.DoesNotContain("ACC-00042", export);
+            Assert.DoesNotContain("$123.45", export);
+            Assert.True(File.Exists(exportPath));
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task SelfApproval_IsRejected()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "audit-cli-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            await InvokeAsync("propose", stateDirectory, "REQ-002", "analyst", "2024-06-03", "Reason", "Evidence");
+            var result = await InvokeAsync("decide", stateDirectory, "REQ-002", "analyst", "approved");
+
+            using var doc = JsonDocument.Parse(result);
+            Assert.False(doc.RootElement.GetProperty("ok").GetBoolean());
+            Assert.Equal("self_approval_blocked", doc.RootElement.GetProperty("code").GetString());
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task ConflictingDecision_IsBlocked_AfterFinalDecision()
+    {
+        var stateDirectory = Path.Combine(Path.GetTempPath(), "audit-cli-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stateDirectory);
+
+        try
+        {
+            await InvokeAsync("propose", stateDirectory, "REQ-003", "analyst", "2024-06-03", "Reason", "Evidence");
+            var approved = await InvokeAsync("decide", stateDirectory, "REQ-003", "checker", "approved");
+            using var approvedDoc = JsonDocument.Parse(approved);
+            Assert.True(approvedDoc.RootElement.GetProperty("ok").GetBoolean());
+
+            var rejected = await InvokeAsync("decide", stateDirectory, "REQ-003", "other-checker", "rejected");
+            using var rejectedDoc = JsonDocument.Parse(rejected);
+            Assert.False(rejectedDoc.RootElement.GetProperty("ok").GetBoolean());
+            Assert.Equal("final_decision_conflict", rejectedDoc.RootElement.GetProperty("code").GetString());
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    private static async Task<string> InvokeAsync(params string[] args)
+    {
+        var assemblyPath = typeof(AuditCliProgram).Assembly.Location;
+        var dotnetPath = Environment.GetEnvironmentVariable("DOTNET_ROOT") is { Length: > 0 } dotnetRoot
+            ? Path.Combine(dotnetRoot, "dotnet.exe")
+            : "dotnet";
+
+        var process = new Process
+        {
+            StartInfo = new ProcessStartInfo
+            {
+                FileName = dotnetPath,
+                Arguments = $"\"{assemblyPath}\" {string.Join(' ', args.Select(EscapeArg))}",
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+                UseShellExecute = false,
+                CreateNoWindow = true
+            }
+        };
+
+        process.Start();
+        var stdoutTask = process.StandardOutput.ReadToEndAsync();
+        var stderrTask = process.StandardError.ReadToEndAsync();
+        await process.WaitForExitAsync();
+
+        var stdout = await stdoutTask;
+        var stderr = await stderrTask;
+        Assert.True(process.ExitCode == 0 || process.ExitCode == 1, $"Unexpected exit code {process.ExitCode} for {string.Join(' ', args)}. stderr='{stderr}'.");
+        return stdout.Trim();
+    }
+
+    private static string EscapeArg(string value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return "\"\"";
+        }
+
+        return value.Contains(' ') || value.Contains('"')
+            ? $"\"{value.Replace("\"", "\\\"")}\""
+            : value;
+    }
+}
