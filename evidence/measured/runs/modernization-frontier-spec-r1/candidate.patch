+
+    public static PositionRecord Position(
+        string positionId = "P-1",
+        string account = "ACC-1",
+        string instrument = "INS.N",
+        decimal quantity = 100m,
+        string settlementDate = "2025-03-17",
+        string currency = "USD") =>
+        new()
+        {
+            PositionId = positionId,
+            Account = account,
+            Instrument = instrument,
+            Quantity = quantity,
+            SettlementDate = FieldFormat.ParseDate(settlementDate),
+            Currency = currency,
+        };
+
+    public static SettlementRecord Settlement(
+        string settlementId = "S-1",
+        string account = "ACC-1",
+        string instrument = "INS.N",
+        decimal quantity = 100m,
+        string settlementDate = "2025-03-17",
+        string currency = "USD",
+        decimal cashAmount = 1000m) =>
+        new()
+        {
+            SettlementId = settlementId,
+            Account = account,
+            Instrument = instrument,
+            Quantity = quantity,
+            SettlementDate = FieldFormat.ParseDate(settlementDate),
+            Currency = currency,
+            CashAmount = cashAmount,
+        };
