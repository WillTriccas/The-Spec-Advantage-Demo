@@ -0,0 +1,111 @@
+using System.Text.Json;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Execution;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// The benchmark adapter is the only interface an external evaluator uses (REQ-7, AC-10), so its
+/// shape, placeholders, and declared outputs are asserted here rather than trusted by inspection.
+/// </summary>
+public sealed class BenchmarkAdapterTests
+{
+    private static readonly JsonDocument Adapter = JsonDocument.Parse(File.ReadAllText(AdapterPath()));
+
+    private static readonly string[] ShellExecutables = ["cmd", "cmd.exe", "sh", "bash", "powershell", "pwsh"];
+
+    [Fact]
+    public void TheAdapterDeclaresAWorkingDirectoryAndSchemaVersion()
+    {
+        Assert.Equal("1.0.0", Adapter.RootElement.GetProperty("schemaVersion").GetString());
+        Assert.Equal(".", Adapter.RootElement.GetProperty("workingDirectory").GetString());
+    }
+
+    [Theory]
+    [InlineData("build")]
+    [InlineData("test")]
+    [InlineData("run")]
+    public void EveryCommandIsShellFreeAndDeclaresItsAllowedExitCodes(string commandName)
+    {
+        JsonElement command = Adapter.RootElement.GetProperty(commandName);
+
+        string executable = command.GetProperty("executable").GetString()!;
+        Assert.False(string.IsNullOrWhiteSpace(executable));
+        Assert.DoesNotContain(executable, ShellExecutables);
+
+        string[] arguments = command.GetProperty("arguments")
+            .EnumerateArray()
+            .Select(argument => argument.GetString()!)
+            .ToArray();
+        Assert.All(arguments, argument => Assert.DoesNotContain('&', argument));
+        Assert.All(arguments, argument => Assert.DoesNotContain('|', argument));
+
+        int[] allowedExitCodes = command.GetProperty("allowedExitCodes")
+            .EnumerateArray()
+            .Select(code => code.GetInt32())
+            .ToArray();
+        Assert.Contains(ExitCodes.Success, allowedExitCodes);
+    }
+
+    [Fact]
+    public void TheRunCommandSubstitutesEvaluatorOwnedValues()
+    {
+        string[] arguments = Adapter.RootElement.GetProperty("run").GetProperty("arguments")
+            .EnumerateArray()
+            .Select(argument => argument.GetString()!)
+            .ToArray();
+
+        Assert.Contains("{businessDate}", arguments);
+        Assert.Contains("{inputDirectory}", arguments);
+        Assert.Contains("{outputDirectory}", arguments);
+
+        // The three positional values must stay in the order the CLI contract expects.
+        Assert.True(
+            Array.IndexOf(arguments, "{businessDate}") <
+            Array.IndexOf(arguments, "{inputDirectory}"));
+        Assert.True(
+            Array.IndexOf(arguments, "{inputDirectory}") <
+            Array.IndexOf(arguments, "{outputDirectory}"));
+    }
+
+    [Fact]
+    public void TheAdapterDeclaresEveryOutputFileTheBatchWrites()
+    {
+        string[] declared = Adapter.RootElement.GetProperty("outputs")
+            .EnumerateArray()
+            .Select(output => output.GetString()!)
+            .ToArray();
+
+        Assert.Equal(BatchFileNames.DeclaredOutputs, declared);
+    }
+
+    [Fact]
+    public void TheRunExecutableTargetsTheBuiltDotNetEightApplication()
+    {
+        JsonElement run = Adapter.RootElement.GetProperty("run");
+
+        Assert.Equal("dotnet", run.GetProperty("executable").GetString());
+        Assert.Contains(
+            run.GetProperty("arguments").EnumerateArray().Select(argument => argument.GetString()!),
+            argument => argument.Contains("net8.0", StringComparison.Ordinal) &&
+                        argument.EndsWith(".dll", StringComparison.Ordinal));
+    }
+
+    private static string AdapterPath()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            string candidate = Path.Combine(directory.FullName, "benchmark-adapter.json");
+            if (File.Exists(candidate))
+            {
+                return candidate;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new FileNotFoundException("benchmark-adapter.json was not found above the test output directory.");
+    }
+}
