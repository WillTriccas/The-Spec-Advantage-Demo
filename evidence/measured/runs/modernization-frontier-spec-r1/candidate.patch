@@ -0,0 +1,144 @@
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Manual override rules (REQ-4, INV-3, AC-6, AC-7). An override is evidence: it either resolves a
+/// concrete break and stays visible in matched-trades.csv, or it surfaces as a stale instruction.
+/// </summary>
+public sealed class ManualOverrideTests
+{
+    private readonly MatchingEngine _engine = new();
+
+    [Fact]
+    public void OverrideCannotManufactureAMatchWithoutConcreteCounterparts()
+    {
+        ReconciliationResult result = _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            [],
+            [],
+            [Build.Override(tradeId: "T-1", action: "ForceMatch")]);
+
+        Assert.Empty(result.MatchedTrades);
+        BreakRecord broken = Assert.Single(result.OpenBreaks);
+        Assert.Equal("T-1", broken.TradeId);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void OverrideCannotResolveADuplicateTradeBreak()
+    {
+        ReconciliationResult result = _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "T-1")],
+            [Build.Position()],
+            [Build.Settlement()],
+            [Build.Override(tradeId: "T-1", action: "ForceMatch")]);
+
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+        Assert.Equal(BreakReasons.DuplicateTradeId, Assert.Single(result.OpenBreaks).Reasons);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Theory]
+    [InlineData("ForceMatch", MatchStatuses.ManualOverrideMatched)]
+    [InlineData("forcematch", MatchStatuses.ManualOverrideMatched)]
+    [InlineData("SuppressBreak", MatchStatuses.ManualOverrideSuppressed)]
+    [InlineData(" suppressbreak ", MatchStatuses.ManualOverrideSuppressed)]
+    public void AnAppliedOverrideRemainsEvidencedInMatchedTrades(string action, string expectedStatus)
+    {
+        ReconciliationResult result = ReconcileToleranceBreakWith(
+            Build.Override(tradeId: "T-1", action: action, note: "cash rounded", approvedBy: "ops"));
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(expectedStatus, matched.Status);
+        Assert.Equal("cash rounded", matched.OverrideNote);
+        Assert.Equal("P-1", matched.PositionId);
+        Assert.Equal("S-1", matched.SettlementId);
+        Assert.Empty(result.OpenBreaks);
+        Assert.Empty(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void OnlyTheFirstOverrideForATradeAppliesAndLaterInstructionsAreStale()
+    {
+        ReconciliationResult result = _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 1000m)],
+            [Build.Position(positionId: "P-1")],
+            [Build.Settlement(settlementId: "S-1", cashAmount: 2000m)],
+            [
+                Build.Override(tradeId: "T-1", action: "SuppressBreak", note: "first", approvedBy: "ops"),
+                Build.Override(tradeId: "T-1", action: "ForceMatch", note: "second", approvedBy: "ops-manager"),
+            ]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.ManualOverrideSuppressed, matched.Status);
+        Assert.Equal("first", matched.OverrideNote);
+
+        ManualOverrideRecord stale = Assert.Single(result.StaleOverrides);
+        Assert.Equal("second", stale.Note);
+    }
+
+    [Theory]
+    [InlineData("", "ops")]
+    [InlineData("   ", "ops")]
+    [InlineData("note", "")]
+    [InlineData("note", "   ")]
+    public void AnOverrideWithoutANoteOrAnApproverIsStale(string note, string approvedBy)
+    {
+        ReconciliationResult result = ReconcileToleranceBreakWith(
+            Build.Override(tradeId: "T-1", action: "ForceMatch", note: note, approvedBy: approvedBy));
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Single(result.OpenBreaks);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void AnUnknownOverrideActionIsStale()
+    {
+        ReconciliationResult result = ReconcileToleranceBreakWith(
+            Build.Override(tradeId: "T-1", action: "EscalateToOps", note: "n", approvedBy: "ops"));
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Single(result.OpenBreaks);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void AnOverrideForATradeThatNeverBrokeIsStale()
+    {
+        ReconciliationResult result = _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            [Build.Position()],
+            [Build.Settlement()],
+            [Build.Override(tradeId: "T-1", action: "ForceMatch")]);
+
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void TextuallyIdenticalDuplicateInstructionsAreNeverCollapsed()
+    {
+        ReconciliationResult result = _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            [Build.Position()],
+            [Build.Settlement()],
+            [
+                Build.Override(tradeId: "T-1", action: "ForceMatch", note: "same", approvedBy: "ops"),
+                Build.Override(tradeId: "T-1", action: "ForceMatch", note: "same", approvedBy: "ops"),
+            ]);
+
+        Assert.Equal(2, result.StaleOverrides.Count);
+    }
+
+    /// <summary>Builds a settlement-amount break that a manual override is allowed to resolve.</summary>
+    private ReconciliationResult ReconcileToleranceBreakWith(ManualOverrideRecord instruction) =>
+        _engine.Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 1000m)],
+            [Build.Position(positionId: "P-1")],
+            [Build.Settlement(settlementId: "S-1", cashAmount: 2000m)],
+            [instruction]);
+}
