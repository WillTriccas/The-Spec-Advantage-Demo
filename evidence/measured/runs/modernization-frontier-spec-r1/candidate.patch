@@ -0,0 +1,149 @@
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Execution;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Operability: a malformed or incomplete input set must fail loudly instead of producing
+/// success-shaped output (NFR-3), and diagnostics must not echo record payloads (NFR-5).
+/// </summary>
+public sealed class InputValidationTests
+{
+    private static readonly CsvReconciliationInputStore Store = new();
+
+    [Fact]
+    public void AMissingRequiredInputFileIsReportedByName()
+    {
+        using var workspace = new TempWorkspace();
+
+        ReconciliationInputException exception =
+            Assert.Throws<ReconciliationInputException>(() => Store.LoadTrades(workspace.InputDirectory));
+
+        Assert.Contains(BatchFileNames.Trades, exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void AMissingInputDirectoryIsReported()
+    {
+        string missing = Path.Combine(Path.GetTempPath(), "trade-reconciliation-tests", Guid.NewGuid().ToString("N"));
+
+        ReconciliationInputException exception =
+            Assert.Throws<ReconciliationInputException>(() => Store.LoadPositions(missing));
+
+        Assert.Contains(missing, exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void AnAbsentOverridesFileIsNotAnError()
+    {
+        using var workspace = new TempWorkspace();
+
+        Assert.Empty(Store.LoadOverrides(workspace.InputDirectory));
+    }
+
+    [Fact]
+    public void AMalformedRowIsRejectedWithItsLineNumberAndWithoutItsPayload()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.WriteInput(
+            BatchFileNames.Trades,
+            "trade_id,account,instrument,quantity,settlement_date,currency,net_amount",
+            "T-1,ACC-1,INS.N,100,2025-03-17,USD,1000.00",
+            "T-2,ACC-1,INS.N,100,2025-03-17,USD");
+
+        ReconciliationInputException exception =
+            Assert.Throws<ReconciliationInputException>(() => Store.LoadTrades(workspace.InputDirectory));
+
+        Assert.Contains("line 3", exception.Message, StringComparison.Ordinal);
+        Assert.DoesNotContain("T-2", exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void AnUnparsableNumberIsRejectedWithItsColumnNameAndWithoutItsPayload()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.WriteInput(
+            BatchFileNames.Settlements,
+            "settlement_id,account,instrument,quantity,settlement_date,currency,cash_amount",
+            "S-1,ACC-1,INS.N,100,2025-03-17,USD,not-a-number");
+
+        ReconciliationInputException exception =
+            Assert.Throws<ReconciliationInputException>(() => Store.LoadSettlements(workspace.InputDirectory));
+
+        Assert.Contains("cash_amount", exception.Message, StringComparison.Ordinal);
+        Assert.DoesNotContain("not-a-number", exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void BlankRowsAreSkipped()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.WriteInput(
+            BatchFileNames.Positions,
+            "position_id,account,instrument,quantity,settlement_date,currency",
+            "P-1,ACC-1,INS.N,100,2025-03-17,USD",
+            "   ",
+            "P-2,ACC-1,INS.N,100,2025-03-17,USD");
+
+        Assert.Equal(2, Store.LoadPositions(workspace.InputDirectory).Count);
+    }
+
+    [Fact]
+    public void AnIncompleteInputSetNeverProducesResultFiles()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.WriteInput(
+            BatchFileNames.Trades,
+            "trade_id,account,instrument,quantity,settlement_date,currency,net_amount");
+
+        var request = new RunRequest
+        {
+            BusinessDate = new DateOnly(2025, 3, 17),
+            InputDirectory = workspace.InputDirectory,
+            OutputDirectory = workspace.OutputDirectory,
+        };
+
+        Assert.Throws<ReconciliationInputException>(() =>
+            ReconciliationBatch.CreateDefault(NullDiagnostics.Instance).Execute(request));
+
+        foreach (string fileName in BatchFileNames.DeclaredOutputs)
+        {
+            Assert.False(File.Exists(workspace.OutputPath(fileName)), $"{fileName} must not exist.");
+        }
+    }
+
+    [Theory]
+    [InlineData("not-a-decimal")]
+    [InlineData("-1")]
+    public void AnInvalidToleranceOverrideIsAConfigurationError(string value)
+    {
+        Assert.Throws<ReconciliationConfigurationException>(() =>
+            ReconciliationTolerances.FromEnvironment(name =>
+                name == ReconciliationTolerances.EnvironmentVariablePrefix + "POSITION_QUANTITY_TOLERANCE"
+                    ? value
+                    : null));
+    }
+
+    [Fact]
+    public void ToleranceOverridesFallBackToTheLegacyDefaults()
+    {
+        ReconciliationTolerances tolerances = ReconciliationTolerances.FromEnvironment(_ => null);
+
+        Assert.Equal(ReconciliationTolerances.DefaultPositionQuantityTolerance, tolerances.PositionQuantity);
+        Assert.Equal(ReconciliationTolerances.DefaultSettlementQuantityTolerance, tolerances.SettlementQuantity);
+        Assert.Equal(ReconciliationTolerances.DefaultSettlementAmountTolerance, tolerances.SettlementAmount);
+    }
+
+    [Fact]
+    public void AToleranceOverrideIsHonored()
+    {
+        ReconciliationTolerances tolerances = ReconciliationTolerances.FromEnvironment(name =>
+            name == ReconciliationTolerances.EnvironmentVariablePrefix + "SETTLEMENT_AMOUNT_TOLERANCE"
+                ? "12.50"
+                : null);
+
+        Assert.Equal(12.50m, tolerances.SettlementAmount);
+    }
+}
