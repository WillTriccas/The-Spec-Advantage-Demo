+namespace TradeReconciliation.Core.Domain;
+
+/// <summary>A row of <c>matched-trades.csv</c>. All identity fields are normalized.</summary>
+public sealed class MatchedTradeRecord
+{
+    public required string TradeId { get; init; }
+
+    public required string Status { get; init; }
+
+    public required string Account { get; init; }
+
+    public required string Instrument { get; init; }
+
+    public required decimal Quantity { get; init; }
+
+    public required DateOnly SettlementDate { get; init; }
+
+    public required string Currency { get; init; }
+
+    public string? PositionId { get; init; }
+
+    public string? SettlementId { get; init; }
+
+    public string? OverrideNote { get; init; }
+}
+
+/// <summary>A row of <c>break-queue.csv</c>. All identity fields are normalized.</summary>
+public sealed class BreakRecord
+{
+    public required string TradeId { get; init; }
+
+    public required string Account { get; init; }
+
+    public required string Instrument { get; init; }
+
+    public required decimal Quantity { get; init; }
+
+    public required DateOnly SettlementDate { get; init; }
+
+    public required string Currency { get; init; }
+
+    /// <summary>Pipe-delimited, de-duplicated, ordinally sorted break reason codes.</summary>
+    public required string Reasons { get; init; }
+
+    public string? PositionId { get; init; }
+
+    public string? SettlementId { get; init; }
+
+    /// <summary>
+    /// True only when concrete position and settlement counterparts exist for the trade.
+    /// A manual override can never manufacture a match for a break where this is false (INV-3).
+    /// </summary>
+    public required bool CanManualOverride { get; init; }
+}
+
+/// <summary>A row of <c>run-ledger.csv</c>.</summary>
+public sealed class RunLedgerEntry
+{
+    public required DateOnly BusinessDate { get; init; }
+
+    public required string InputSignature { get; init; }
+
+    public required int TotalTradesRead { get; init; }
+
+    public required int OpenBreakCount { get; init; }
+
+    public required int MatchedCount { get; init; }
+}
