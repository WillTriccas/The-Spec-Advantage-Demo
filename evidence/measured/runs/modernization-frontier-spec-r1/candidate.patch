@@ -0,0 +1,77 @@
+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Csv;
+
+/// <summary>
+/// Writes the three reconciliation result files with stable headers and deterministic row order (REQ-5).
+/// </summary>
+public sealed class CsvReconciliationOutputWriter : IReconciliationOutputWriter
+{
+    internal const string MatchedTradesHeader =
+        "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+
+    internal const string BreakQueueHeader =
+        "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+    public void WriteMatchedTrades(string outputDirectory, IReadOnlyList<MatchedTradeRecord> matchedTrades)
+    {
+        ArgumentNullException.ThrowIfNull(matchedTrades);
+
+        var lines = new List<string>(matchedTrades.Count + 1) { MatchedTradesHeader };
+        foreach (MatchedTradeRecord record in matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal))
+        {
+            lines.Add(string.Join(
+                ',',
+                record.TradeId,
+                record.Status,
+                record.Account,
+                record.Instrument,
+                FieldFormat.Quantity(record.Quantity),
+                FieldFormat.Date(record.SettlementDate),
+                record.Currency,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty,
+                record.OverrideNote ?? string.Empty));
+        }
+
+        WriteAllLines(outputDirectory, BatchFileNames.MatchedTrades, lines);
+    }
+
+    public void WriteBreakQueue(string outputDirectory, IReadOnlyList<BreakRecord> breakQueue)
+    {
+        ArgumentNullException.ThrowIfNull(breakQueue);
+
+        var lines = new List<string>(breakQueue.Count + 1) { BreakQueueHeader };
+        foreach (BreakRecord record in breakQueue
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .ThenBy(record => record.Reasons, StringComparer.Ordinal))
+        {
+            lines.Add(string.Join(
+                ',',
+                record.TradeId,
+                record.Account,
+                record.Instrument,
+                FieldFormat.Quantity(record.Quantity),
+                FieldFormat.Date(record.SettlementDate),
+                record.Currency,
+                record.Reasons,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty));
+        }
+
+        WriteAllLines(outputDirectory, BatchFileNames.BreakQueue, lines);
+    }
+
+    public void WriteEndOfDayReport(string outputDirectory, string reportText) =>
+        File.WriteAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport), reportText);
+
+    public bool ResultFilesExist(string outputDirectory) =>
+        File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades)) &&
+        File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue)) &&
+        File.Exists(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport));
+
+    private static void WriteAllLines(string outputDirectory, string fileName, IEnumerable<string> lines) =>
+        File.WriteAllLines(Path.Combine(outputDirectory, fileName), lines);
+}
diff --git a/src/TradeReconciliation.Core/Csv/CsvRunLedgerStore.cs b/src/TradeReconciliation.Core/Csv/CsvRunLedgerStore.cs
new file mode 100644
index 0000000..1938b48
--- /dev/null
+++ b/src/TradeReconciliation.Core/Csv/CsvRunLedgerStore.cs
@@ -0,0 +1,102 @@
+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Csv;
+
+/// <summary>
+/// Append-only <c>run-ledger.csv</c> history. A run is identified by its business date plus the
+/// fingerprint of every input file, so an exact rerun never appends a duplicate entry (INV-4).
+/// </summary>
+public sealed class CsvRunLedgerStore : IRunLedgerStore
+{
+    internal const string Header = "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+    public RunLedgerEntry? FindRun(string outputDirectory, DateOnly businessDate, string inputSignature) =>
+        LoadEntries(outputDirectory).FirstOrDefault(entry =>
+            entry.BusinessDate == businessDate &&
+            string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal));
+
+    public void AppendIfMissing(string outputDirectory, RunLedgerEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+
+        if (FindRun(outputDirectory, entry.BusinessDate, entry.InputSignature) is not null)
+        {
+            return;
+        }
+
+        string path = LedgerPath(outputDirectory);
+        bool fileExists = File.Exists(path);
+
+        using var writer = new StreamWriter(path, append: true);
+        if (!fileExists)
+        {
+            writer.WriteLine(Header);
+        }
+
+        writer.WriteLine(string.Join(
+            ',',
+            FieldFormat.Date(entry.BusinessDate),
+            entry.InputSignature,
+            FieldFormat.Count(entry.TotalTradesRead),
+            FieldFormat.Count(entry.OpenBreakCount),
+            FieldFormat.Count(entry.MatchedCount)));
+    }
+
+    internal static IReadOnlyList<RunLedgerEntry> LoadEntries(string outputDirectory)
+    {
+        string path = LedgerPath(outputDirectory);
+        if (!File.Exists(path))
+        {
+            return [];
+        }
+
+        string[] lines = File.ReadAllLines(path);
+        var entries = new List<RunLedgerEntry>(Math.Max(0, lines.Length - 1));
+
+        for (int index = 1; index < lines.Length; index++)
+        {
+            string line = lines[index];
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            entries.Add(ParseEntry(line, index + 1));
+        }
+
+        return entries;
+    }
+
+    private static RunLedgerEntry ParseEntry(string line, int lineNumber)
+    {
+        string[] cells = line.Split(',');
+        if (cells.Length != 5)
+        {
+            throw ReconciliationInputException.UnexpectedCellCount(BatchFileNames.RunLedger, lineNumber, 5, cells.Length);
+        }
+
+        if (!FieldFormat.TryParseDate(cells[0], out DateOnly businessDate))
+        {
+            throw ReconciliationInputException.UnparsableCell(BatchFileNames.RunLedger, lineNumber, "business_date");
+        }
+
+        return new RunLedgerEntry
+        {
+            BusinessDate = businessDate,
+            InputSignature = cells[1],
+            TotalTradesRead = ParseCount(cells[2], lineNumber, "total_trades_read"),
+            OpenBreakCount = ParseCount(cells[3], lineNumber, "open_break_count"),
+            MatchedCount = ParseCount(cells[4], lineNumber, "matched_count"),
+        };
+    }
+
+    private static int ParseCount(string value, int lineNumber, string columnName) =>
+        int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int parsed)
+            ? parsed
+            : throw ReconciliationInputException.UnparsableCell(BatchFileNames.RunLedger, lineNumber, columnName);
+
+    private static string LedgerPath(string outputDirectory) =>
+        Path.Combine(outputDirectory, BatchFileNames.RunLedger);
+}
