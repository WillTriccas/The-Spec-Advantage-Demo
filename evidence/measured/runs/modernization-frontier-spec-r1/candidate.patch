@@ -0,0 +1,38 @@
+namespace TradeReconciliation.Core.Csv;
+
+/// <summary>
+/// Raised when an input dataset is missing or structurally invalid. The message deliberately
+/// carries file names, line numbers, and column names only — never record payloads (NFR-3, NFR-5).
+/// </summary>
+public sealed class ReconciliationInputException : Exception
+{
+    public ReconciliationInputException(string message)
+        : base(message)
+    {
+    }
+
+    public ReconciliationInputException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+
+    public ReconciliationInputException()
+    {
+    }
+
+    public static ReconciliationInputException MissingFile(string fileName, string directory) =>
+        new($"Required input file '{fileName}' was not found in input directory '{directory}'.");
+
+    public static ReconciliationInputException MissingDirectory(string directory) =>
+        new($"Input directory '{directory}' does not exist.");
+
+    public static ReconciliationInputException UnexpectedCellCount(
+        string fileName,
+        int lineNumber,
+        int expected,
+        int actual) =>
+        new($"Unexpected csv format in '{fileName}' line {lineNumber}: expected {expected} columns but found {actual}.");
+
+    public static ReconciliationInputException UnparsableCell(string fileName, int lineNumber, string columnName) =>
+        new($"Unparsable value in '{fileName}' line {lineNumber} column '{columnName}'.");
+}
