+namespace TradeReconciliation.Core.Domain;
+
+/// <summary>Trade as ingested from <c>trades.csv</c>. Raw (un-normalized) values are retained.</summary>
+public sealed class TradeRecord
+{
+    public required string TradeId { get; init; }
+
+    public required string Account { get; init; }
+
+    public required string Instrument { get; init; }
+
+    public required decimal Quantity { get; init; }
+
+    public required DateOnly SettlementDate { get; init; }
+
+    public required string Currency { get; init; }
+
+    public required decimal NetAmount { get; init; }
+}
+
+/// <summary>Custodian position as ingested from <c>positions.csv</c>.</summary>
+public sealed class PositionRecord
+{
+    public required string PositionId { get; init; }
+
+    public required string Account { get; init; }
+
+    public required string Instrument { get; init; }
+
+    public required decimal Quantity { get; init; }
+
+    public required DateOnly SettlementDate { get; init; }
+
+    public required string Currency { get; init; }
+}
+
+/// <summary>Settlement instruction as ingested from <c>settlements.csv</c>.</summary>
+public sealed class SettlementRecord
+{
+    public required string SettlementId { get; init; }
+
+    public required string Account { get; init; }
+
+    public required string Instrument { get; init; }
+
+    public required decimal Quantity { get; init; }
+
+    public required DateOnly SettlementDate { get; init; }
+
+    public required string Currency { get; init; }
+
+    public required decimal CashAmount { get; init; }
+}
+
+/// <summary>
+/// Manual override instruction as ingested from <c>overrides.csv</c>.
+/// </summary>
+/// <remarks>
+/// This is deliberately a reference type without value equality. Duplicate instructions for the
+/// same trade are distinct pieces of evidence (AMB-2 / REQ-4) and must never collapse into one row,
+/// so identity is reference identity.
+/// </remarks>
+public sealed class ManualOverrideRecord
+{
+    public required string TradeId { get; init; }
+
+    public required string Action { get; init; }
+
+    public required string Note { get; init; }
+
+    public required string ApprovedBy { get; init; }
+}
