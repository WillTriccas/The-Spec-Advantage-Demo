+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Execution;
+
+namespace TradeReconciliation.Cli;
+
+/// <summary>
+/// Composition root for the batch. Argument parsing, configuration, and failure-to-exit-code
+/// translation live here; all business behavior lives in TradeReconciliation.Core.
+/// </summary>
+public static class Program
+{
+    public static int Main(string[] args) => Run(args, Console.Out, Console.Error);
+
+    /// <summary>Runs the batch against explicit writers so the entry point stays testable.</summary>
+    public static int Run(string[] args, TextWriter output, TextWriter error)
+    {
+        ArgumentNullException.ThrowIfNull(output);
+        ArgumentNullException.ThrowIfNull(error);
+
+        try
+        {
+            RunRequest request = RunRequest.Resolve(args, AppContext.BaseDirectory);
+            ReconciliationTolerances tolerances = ReconciliationTolerances.FromEnvironment();
+
+            ReconciliationBatch batch = ReconciliationBatch.CreateDefault(
+                new ConsoleBatchDiagnostics(output),
+                tolerances);
+
+            batch.Execute(request);
+            return ExitCodes.Success;
+        }
+        catch (CommandLineException exception)
+        {
+            error.WriteLine($"Invalid command line: {exception.Message}");
+            return ExitCodes.InvalidCommandLine;
+        }
+        catch (ReconciliationConfigurationException exception)
+        {
+            error.WriteLine($"Invalid configuration: {exception.Message}");
+            return ExitCodes.InvalidConfiguration;
+        }
+        catch (ReconciliationInputException exception)
+        {
+            error.WriteLine($"Invalid input: {exception.Message}");
+            return ExitCodes.InvalidInput;
+        }
+        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
+        {
+            error.WriteLine($"Output could not be written: {exception.Message}");
+            return ExitCodes.OutputFailure;
+        }
+    }
+}
