+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>Determinism of the fingerprint that makes reruns idempotent (INV-4).</summary>
+public sealed class InputFingerprintCalculatorTests
+{
+    private static readonly InputFingerprintCalculator Calculator = new();
+    private static readonly DateOnly BusinessDate = new(2025, 3, 17);
+
+    [Fact]
+    public void IdenticalInputsProduceTheSameFingerprint()
+    {
+        using var first = new TempWorkspace();
+        using var second = new TempWorkspace();
+        first.CopyFixtureInput(Fixtures.Baseline);
+        second.CopyFixtureInput(Fixtures.Baseline);
+
+        Assert.Equal(
+            Calculator.Calculate(BusinessDate, first.InputDirectory),
+            Calculator.Calculate(BusinessDate, second.InputDirectory));
+    }
+
+    [Fact]
+    public void AChangedInputFileChangesTheFingerprint()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+        string before = Calculator.Calculate(BusinessDate, workspace.InputDirectory);
+
+        File.AppendAllText(
+            Path.Combine(workspace.InputDirectory, BatchFileNames.Trades),
+            "T-9001,ACC-009,NEW.N,10,2025-03-17,USD,900.00" + Environment.NewLine);
+
+        Assert.NotEqual(before, Calculator.Calculate(BusinessDate, workspace.InputDirectory));
+    }
+
+    [Fact]
+    public void ADifferentBusinessDateChangesTheFingerprint()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        Assert.NotEqual(
+            Calculator.Calculate(BusinessDate, workspace.InputDirectory),
+            Calculator.Calculate(BusinessDate.AddDays(1), workspace.InputDirectory));
+    }
+
+    [Fact]
+    public void TheFingerprintIsALowerCaseSha256Digest()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        string fingerprint = Calculator.Calculate(BusinessDate, workspace.InputDirectory);
+
+        Assert.Equal(64, fingerprint.Length);
+        Assert.All(fingerprint, character => Assert.Contains(character, "0123456789abcdef"));
+    }
+}
+
+/// <summary>Report layout and totals are part of the downstream contract (REQ-5).</summary>
+public sealed class EndOfDayReportBuilderTests
+{
+    private static readonly DateOnly BusinessDate = new(2025, 3, 17);
+
+    [Fact]
+    public void AReportWithoutBreaksStatesNone()
+    {
+        ReconciliationResult result = new MatchingEngine().Reconcile(
+            [Build.Trade()],
+            [Build.Position()],
+            [Build.Settlement()],
+            []);
+
+        string report = new EndOfDayReportBuilder().Build(BusinessDate, result);
+
+        Assert.Contains("Open Break Reasons" + Environment.NewLine + "------------------" + Environment.NewLine + "None", report, StringComparison.Ordinal);
+        Assert.DoesNotContain("Stale Overrides" + Environment.NewLine + "---------------", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void TheReportEndsWithExactlyOneNewLine()
+    {
+        ReconciliationResult result = new MatchingEngine().Reconcile([], [], [], []);
+
+        string report = new EndOfDayReportBuilder().Build(BusinessDate, result);
+
+        Assert.EndsWith("None" + Environment.NewLine, report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void BreakReasonCountsAreOrderedAndAggregated()
+    {
+        ReconciliationResult result = new MatchingEngine().Reconcile(
+            [
+                Build.Trade(tradeId: "T-1", account: "ACC-9"),
+                Build.Trade(tradeId: "T-2", account: "ACC-9"),
+                Build.Trade(tradeId: "T-3", quantity: 0m),
+            ],
+            [],
+            [],
+            []);
+
+        string report = new EndOfDayReportBuilder().Build(BusinessDate, result);
+
+        int missingPosition = report.IndexOf(BreakReasons.MissingPosition + ": 2", StringComparison.Ordinal);
+        int missingSettlement = report.IndexOf(BreakReasons.MissingSettlement + ": 2", StringComparison.Ordinal);
+        int outOfBounds = report.IndexOf(BreakReasons.TradeValueOutOfBounds + ": 1", StringComparison.Ordinal);
+
+        Assert.True(missingPosition >= 0 && missingSettlement > missingPosition && outOfBounds > missingSettlement);
+    }
+
+    [Fact]
+    public void StaleOverridesAreListedWithTheirActionAndApprover()
+    {
+        ReconciliationResult result = new MatchingEngine().Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            [Build.Position()],
+            [Build.Settlement()],
+            [Build.Override(tradeId: "T-1", action: "ForceMatch", note: "n", approvedBy: "ops-manager")]);
+
+        string report = new EndOfDayReportBuilder().Build(BusinessDate, result);
+
+        Assert.Contains("Stale Overrides: 1", report, StringComparison.Ordinal);
+        Assert.Contains("T-1: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+    }
+}
+
+/// <summary>Output file schemas are stable and deterministically ordered (REQ-5, AC-8).</summary>
+public sealed class OutputWriterTests
+{
+    [Fact]
+    public void MatchedTradesAndBreakQueueKeepTheirLegacyHeaders()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.OverrideRerun);
+
+        ReconciliationBatch.CreateDefault(NullDiagnostics.Instance).Execute(new RunRequest
+        {
+            BusinessDate = new DateOnly(2025, 3, 17),
+            InputDirectory = workspace.InputDirectory,
+            OutputDirectory = workspace.OutputDirectory,
+        });
+
+        Assert.Equal(
+            "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note",
+            File.ReadAllLines(workspace.OutputPath(BatchFileNames.MatchedTrades))[0]);
+        Assert.Equal(
+            "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id",
+            File.ReadAllLines(workspace.OutputPath(BatchFileNames.BreakQueue))[0]);
+        Assert.Equal(
+            "business_date,input_signature,total_trades_read,open_break_count,matched_count",
+            File.ReadAllLines(workspace.OutputPath(BatchFileNames.RunLedger))[0]);
+    }
+
+    [Fact]
+    public void RowsAreOrderedByTradeIdRegardlessOfInputOrder()
+    {
+        var writer = new CsvReconciliationOutputWriter();
+        using var workspace = new TempWorkspace();
+
+        writer.WriteMatchedTrades(workspace.OutputDirectory,
+        [
+            Matched("T-3"),
+            Matched("T-1"),
+            Matched("T-2"),
+        ]);
+
+        string[] lines = File.ReadAllLines(workspace.OutputPath(BatchFileNames.MatchedTrades));
+        Assert.Equal(["T-1", "T-2", "T-3"], lines.Skip(1).Select(line => line.Split(',')[0]));
+    }
+
+    [Fact]
+    public void QuantitiesUseInvariantTrimmedFormatting()
+    {
+        var writer = new CsvReconciliationOutputWriter();
+        using var workspace = new TempWorkspace();
+
+        writer.WriteMatchedTrades(workspace.OutputDirectory, [Matched("T-1", 50.0080m), Matched("T-2", 100m)]);
+
+        string[] lines = File.ReadAllLines(workspace.OutputPath(BatchFileNames.MatchedTrades));
+        Assert.Equal("50.008", lines[1].Split(',')[4]);
+        Assert.Equal("100", lines[2].Split(',')[4]);
+    }
+
+    private static MatchedTradeRecord Matched(string tradeId, decimal quantity = 100m) => new()
+    {
+        TradeId = tradeId,
+        Status = MatchStatuses.Matched,
+        Account = "ACC-1",
+        Instrument = "INS.N",
+        Quantity = quantity,
+        SettlementDate = new DateOnly(2025, 3, 17),
+        Currency = "USD",
+        PositionId = "P-1",
+        SettlementId = "S-1",
+        OverrideNote = null,
+    };
+}
