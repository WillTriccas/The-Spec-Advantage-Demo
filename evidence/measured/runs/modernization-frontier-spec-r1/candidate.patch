-namespace LegacyTradeReconciliation
-{
-    public sealed class CsvFileGateway
-    {
-        public List<TradeRecord> LoadTrades(string inputDirectory)
-        {
-            return ReadRequiredLines(inputDirectory, BatchConfiguration.TradesFileName)
