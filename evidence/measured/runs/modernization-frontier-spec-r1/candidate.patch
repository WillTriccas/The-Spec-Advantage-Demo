+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Abstractions;
+
+/// <summary>Reads the four synthetic input datasets for a run.</summary>
+public interface IReconciliationInputStore
+{
+    IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory);
+
+    IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory);
+
+    IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory);
+
+    /// <summary>Loads manual overrides. An absent overrides file yields an empty list.</summary>
+    IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory);
+}
+
+/// <summary>Writes the three reconciliation result files.</summary>
+public interface IReconciliationOutputWriter
+{
+    void WriteMatchedTrades(string outputDirectory, IReadOnlyList<MatchedTradeRecord> matchedTrades);
+
+    void WriteBreakQueue(string outputDirectory, IReadOnlyList<BreakRecord> breakQueue);
+
+    void WriteEndOfDayReport(string outputDirectory, string reportText);
+
+    /// <summary>True when a previous run already left all three result files behind.</summary>
+    bool ResultFilesExist(string outputDirectory);
+}
+
+/// <summary>Append-only history of executed runs, used for exact-rerun detection (INV-4).</summary>
+public interface IRunLedgerStore
+{
+    /// <summary>Returns the recorded entry for an identical prior run, or <see langword="null"/>.</summary>
+    RunLedgerEntry? FindRun(string outputDirectory, DateOnly businessDate, string inputSignature);
+
+    void AppendIfMissing(string outputDirectory, RunLedgerEntry entry);
+}
+
+/// <summary>Produces a stable fingerprint of the business date plus every input file.</summary>
+public interface IInputFingerprintCalculator
+{
+    string Calculate(DateOnly businessDate, string inputDirectory);
+}
+
+/// <summary>
+/// Operational diagnostics sink. Implementations must emit dates, identifiers, and counts only —
+/// never trade, position, settlement, or override payloads (NFR-5).
+/// </summary>
+public interface IBatchDiagnostics
+{
+    void RunStarting(DateOnly businessDate, string inputDirectory, string outputDirectory);
+
+    void ExactRerunDetected(DateOnly businessDate, string inputSignature);
+
+    void RunCompleted(ReconciliationRunSummary summary);
+}
