@@ -0,0 +1,82 @@
+using System.Globalization;
+
+namespace TradeReconciliation.Core.Configuration;
+
+/// <summary>
+/// Externally configurable reconciliation tolerances. Defaults reproduce the legacy
+/// <c>BatchConfiguration</c> constants exactly; overriding them changes business behavior and is
+/// therefore an explicit, auditable operator action.
+/// </summary>
+public sealed class ReconciliationTolerances
+{
+    public const decimal DefaultPositionQuantityTolerance = 0.01m;
+    public const decimal DefaultSettlementQuantityTolerance = 0.02m;
+    public const decimal DefaultSettlementAmountTolerance = 5.00m;
+
+    /// <summary>Environment variable prefix used for operator overrides.</summary>
+    public const string EnvironmentVariablePrefix = "TRADERECON_";
+
+    public static ReconciliationTolerances Default { get; } = new();
+
+    /// <summary>Inclusive absolute tolerance between trade and position quantity.</summary>
+    public decimal PositionQuantity { get; init; } = DefaultPositionQuantityTolerance;
+
+    /// <summary>Inclusive absolute tolerance between trade and settlement quantity.</summary>
+    public decimal SettlementQuantity { get; init; } = DefaultSettlementQuantityTolerance;
+
+    /// <summary>Inclusive absolute tolerance between trade net amount and settlement cash amount.</summary>
+    public decimal SettlementAmount { get; init; } = DefaultSettlementAmountTolerance;
+
+    /// <summary>
+    /// Reads tolerance overrides from the environment. Any unset variable keeps the legacy default;
+    /// a present but unparsable or negative value is a configuration error rather than a silent fallback.
+    /// </summary>
+    public static ReconciliationTolerances FromEnvironment(
+        Func<string, string?>? environmentReader = null)
+    {
+        Func<string, string?> read = environmentReader ?? Environment.GetEnvironmentVariable;
+
+        return new ReconciliationTolerances
+        {
+            PositionQuantity = Read(read, "POSITION_QUANTITY_TOLERANCE", DefaultPositionQuantityTolerance),
+            SettlementQuantity = Read(read, "SETTLEMENT_QUANTITY_TOLERANCE", DefaultSettlementQuantityTolerance),
+            SettlementAmount = Read(read, "SETTLEMENT_AMOUNT_TOLERANCE", DefaultSettlementAmountTolerance),
+        };
+    }
+
+    private static decimal Read(Func<string, string?> read, string name, decimal fallback)
+    {
+        string variable = EnvironmentVariablePrefix + name;
+        string? raw = read(variable);
+        if (string.IsNullOrWhiteSpace(raw))
+        {
+            return fallback;
+        }
+
+        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal value) || value < 0m)
+        {
+            throw new ReconciliationConfigurationException(
+                $"Environment variable '{variable}' must be a non-negative invariant-culture decimal.");
+        }
+
+        return value;
+    }
+}
+
+/// <summary>Raised when operator-supplied configuration cannot be honored.</summary>
+public sealed class ReconciliationConfigurationException : Exception
+{
+    public ReconciliationConfigurationException(string message)
+        : base(message)
+    {
+    }
+
+    public ReconciliationConfigurationException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+
+    public ReconciliationConfigurationException()
+    {
+    }
+}
diff --git a/src/TradeReconciliation.Core/Csv/CsvReconciliationInputStore.cs b/src/TradeReconciliation.Core/Csv/CsvReconciliationInputStore.cs
new file mode 100644
index 0000000..6584236
--- /dev/null
+++ b/src/TradeReconciliation.Core/Csv/CsvReconciliationInputStore.cs
@@ -0,0 +1,170 @@
+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Csv;
+
+/// <summary>
+/// Reads the synthetic reconciliation datasets from delimited files.
+/// </summary>
+/// <remarks>
+/// The legacy schemas are strictly positional, trimmed, and unquoted: a value can never contain a
+/// comma because a row with an extra comma is rejected as malformed. That property is what makes the
+/// unquoted writer in <see cref="CsvReconciliationOutputWriter"/> lossless.
+/// </remarks>
+public sealed class CsvReconciliationInputStore : IReconciliationInputStore
+{
+    public IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory) =>
+        ReadRecords(
+            inputDirectory,
+            BatchFileNames.Trades,
+            required: true,
+            expectedCellCount: 7,
+            (cells, context) => new TradeRecord
+            {
+                TradeId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = context.Decimal(cells[3], "quantity"),
+                SettlementDate = context.Date(cells[4], "settlement_date"),
+                Currency = cells[5],
+                NetAmount = context.Decimal(cells[6], "net_amount"),
+            });
+
+    public IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory) =>
+        ReadRecords(
+            inputDirectory,
+            BatchFileNames.Positions,
+            required: true,
+            expectedCellCount: 6,
+            (cells, context) => new PositionRecord
+            {
+                PositionId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = context.Decimal(cells[3], "quantity"),
+                SettlementDate = context.Date(cells[4], "settlement_date"),
+                Currency = cells[5],
+            });
+
+    public IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory) =>
+        ReadRecords(
+            inputDirectory,
+            BatchFileNames.Settlements,
+            required: true,
+            expectedCellCount: 7,
+            (cells, context) => new SettlementRecord
+            {
+                SettlementId = cells[0],
+                Account = cells[1],
+                Instrument = cells[2],
+                Quantity = context.Decimal(cells[3], "quantity"),
+                SettlementDate = context.Date(cells[4], "settlement_date"),
+                Currency = cells[5],
+                CashAmount = context.Decimal(cells[6], "cash_amount"),
+            });
+
+    public IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory) =>
+        ReadRecords(
+            inputDirectory,
+            BatchFileNames.Overrides,
+            required: false,
+            expectedCellCount: 4,
+            (cells, _) => new ManualOverrideRecord
+            {
+                TradeId = cells[0],
+                Action = cells[1],
+                Note = cells[2],
+                ApprovedBy = cells[3],
+            });
+
+    private static List<T> ReadRecords<T>(
+        string inputDirectory,
+        string fileName,
+        bool required,
+        int expectedCellCount,
+        Func<string[], CellParser, T> projection)
+    {
+        string path = Path.Combine(inputDirectory, fileName);
+        if (!File.Exists(path))
+        {
+            if (!required)
+            {
+                return [];
+            }
+
+            throw Directory.Exists(inputDirectory)
+                ? ReconciliationInputException.MissingFile(fileName, inputDirectory)
+                : ReconciliationInputException.MissingDirectory(inputDirectory);
+        }
+
+        string[] lines = ReadAllLines(path, fileName);
+        var records = new List<T>(Math.Max(0, lines.Length - 1));
+
+        // Line 1 is the header row; input order is preserved because duplicate detection and
+        // override precedence are both first-occurrence rules (REQ-2, REQ-4).
+        for (int index = 1; index < lines.Length; index++)
+        {
+            string line = lines[index];
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            int lineNumber = index + 1;
+            string[] cells = SplitCells(line, expectedCellCount, fileName, lineNumber);
+            records.Add(projection(cells, new CellParser(fileName, lineNumber)));
+        }
+
+        return records;
+    }
+
+    private static string[] ReadAllLines(string path, string fileName)
+    {
+        try
+        {
+            return File.ReadAllLines(path);
+        }
+        catch (IOException exception)
+        {
+            throw new ReconciliationInputException($"Input file '{fileName}' could not be read.", exception);
+        }
+        catch (UnauthorizedAccessException exception)
+        {
+            throw new ReconciliationInputException($"Input file '{fileName}' could not be read.", exception);
+        }
+    }
+
+    private static string[] SplitCells(string line, int expectedCellCount, string fileName, int lineNumber)
+    {
+        string[] cells = line.Split(',');
+        if (cells.Length != expectedCellCount)
+        {
+            throw ReconciliationInputException.UnexpectedCellCount(
+                fileName,
+                lineNumber,
+                expectedCellCount,
+                cells.Length);
+        }
+
+        for (int index = 0; index < cells.Length; index++)
+        {
+            cells[index] = cells[index].Trim();
+        }
+
+        return cells;
+    }
+
+    private readonly struct CellParser(string fileName, int lineNumber)
+    {
+        public decimal Decimal(string value, string columnName) =>
+            FieldFormat.TryParseDecimal(value, out decimal parsed)
+                ? parsed
+                : throw ReconciliationInputException.UnparsableCell(fileName, lineNumber, columnName);
+
+        public DateOnly Date(string value, string columnName) =>
+            FieldFormat.TryParseDate(value, out DateOnly parsed)
+                ? parsed
+                : throw ReconciliationInputException.UnparsableCell(fileName, lineNumber, columnName);
+    }
+}
diff --git a/src/TradeReconciliation.Core/Csv/CsvReconciliationOutputWriter.cs b/src/TradeReconciliation.Core/Csv/CsvReconciliationOutputWriter.cs
new file mode 100644
index 0000000..cdc1527
