+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Cli;
+
+/// <summary>
+/// Console diagnostics for the batch.
+/// </summary>
+/// <remarks>
+/// NFR-5: every message is limited to dates, directory locations, identifiers, and counts. Trade,
+/// position, settlement, and override payloads are never written to the operational log.
+/// </remarks>
+internal sealed class ConsoleBatchDiagnostics(TextWriter output) : IBatchDiagnostics
+{
+    private readonly TextWriter _output = output;
+
+    public void RunStarting(DateOnly businessDate, string inputDirectory, string outputDirectory)
+    {
+        _output.WriteLine($"Starting reconciliation for {FieldFormat.Date(businessDate)}.");
+        _output.WriteLine($"Input directory: {inputDirectory}");
+        _output.WriteLine($"Output directory: {outputDirectory}");
+    }
+
+    public void ExactRerunDetected(DateOnly businessDate, string inputSignature)
+    {
+        _output.WriteLine(
+            $"Exact rerun detected for {FieldFormat.Date(businessDate)}. Existing outputs were retained.");
+        _output.WriteLine($"Input signature: {inputSignature}");
+    }
+
+    public void RunCompleted(ReconciliationRunSummary summary)
+    {
+        if (summary.WasExactRerun)
+        {
+            return;
+        }
+
+        _output.WriteLine(
+            $"Processed {FieldFormat.Count(summary.TotalTradesRead)} trades into " +
+            $"{FieldFormat.Count(summary.MatchedRowCount)} matched rows and " +
+            $"{FieldFormat.Count(summary.OpenBreakCount)} open breaks.");
+        _output.WriteLine($"Stale overrides: {FieldFormat.Count(summary.StaleOverrideCount)}");
+        _output.WriteLine($"Input signature: {summary.InputSignature}");
+    }
+}
