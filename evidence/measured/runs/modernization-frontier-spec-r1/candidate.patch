+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Execution;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// The externally observable command contract and its documented exit codes (REQ-1, REQ-7, NFR-3).
+/// </summary>
+public sealed class CommandLineTests
+{
+    [Fact]
+    public void ThreePositionalArgumentsAreAccepted()
+    {
+        using var workspace = new TempWorkspace();
+
+        RunRequest request = RunRequest.Resolve(
+            ["2025-03-17", workspace.InputDirectory, workspace.OutputDirectory],
+            AppContext.BaseDirectory);
+
+        Assert.Equal(new DateOnly(2025, 3, 17), request.BusinessDate);
+        Assert.Equal(Path.GetFullPath(workspace.InputDirectory), request.InputDirectory);
+        Assert.Equal(Path.GetFullPath(workspace.OutputDirectory), request.OutputDirectory);
+    }
+
+    [Fact]
+    public void NoArgumentsSelectsThePackagedSampleDataset()
+    {
+        RunRequest request = RunRequest.Resolve([], AppContext.BaseDirectory);
+
+        Assert.Equal(new DateOnly(2025, 3, 17), request.BusinessDate);
+        Assert.EndsWith(Path.Combine("data", "sample"), request.InputDirectory, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("2025-03-17")]
+    [InlineData("2025-03-17", "input")]
+    [InlineData("2025-03-17", "input", "output", "extra")]
+    public void AnyOtherArgumentCountIsRejected(params string[] args) =>
+        Assert.Throws<CommandLineException>(() => RunRequest.Resolve(args, AppContext.BaseDirectory));
+
+    [Theory]
+    [InlineData("17-03-2025")]
+    [InlineData("2025/03/17")]
+    [InlineData("today")]
+    public void AnUnparsableBusinessDateIsRejected(string businessDate) =>
+        Assert.Throws<CommandLineException>(() =>
+            RunRequest.Resolve([businessDate, "input", "output"], AppContext.BaseDirectory));
+
+    [Fact]
+    public void AValidRunExitsWithSuccessAndWritesEveryDeclaredOutput()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        var output = new StringWriter();
+        var error = new StringWriter();
+
+        int exitCode = Cli.Program.Run(
+            ["2025-03-17", workspace.InputDirectory, workspace.OutputDirectory],
+            output,
+            error);
+
+        Assert.Equal(ExitCodes.Success, exitCode);
+        Assert.Equal(string.Empty, error.ToString());
+        foreach (string fileName in BatchFileNames.DeclaredOutputs)
+        {
+            Assert.True(File.Exists(workspace.OutputPath(fileName)), $"{fileName} was not written.");
+        }
+    }
+
+    [Fact]
+    public void DiagnosticsReportCountsWithoutRecordPayloads()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.OverrideRerun);
+
+        var output = new StringWriter();
+        Cli.Program.Run(["2025-03-17", workspace.InputDirectory, workspace.OutputDirectory], output, new StringWriter());
+
+        string log = output.ToString();
+        Assert.Contains("Processed 5 trades into 4 matched rows and 1 open breaks.", log, StringComparison.Ordinal);
+        Assert.DoesNotContain("FX leg booked in broker mirror", log, StringComparison.Ordinal);
+        Assert.DoesNotContain("ops-supervisor", log, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void AnExactRerunReportsItselfAndStaysSuccessful()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+        string[] args = ["2025-03-17", workspace.InputDirectory, workspace.OutputDirectory];
+
+        Assert.Equal(ExitCodes.Success, Cli.Program.Run(args, new StringWriter(), new StringWriter()));
+
+        var output = new StringWriter();
+        Assert.Equal(ExitCodes.Success, Cli.Program.Run(args, output, new StringWriter()));
+        Assert.Contains("Exact rerun detected for 2025-03-17", output.ToString(), StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void AnInvalidCommandLineExitsWithItsOwnCode()
+    {
+        var error = new StringWriter();
+
+        int exitCode = Cli.Program.Run(["2025-03-17"], new StringWriter(), error);
+
+        Assert.Equal(ExitCodes.InvalidCommandLine, exitCode);
+        Assert.Contains("Invalid command line", error.ToString(), StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void MissingInputExitsWithTheInvalidInputCode()
+    {
+        using var workspace = new TempWorkspace();
+        var error = new StringWriter();
+
+        int exitCode = Cli.Program.Run(
+            ["2025-03-17", workspace.InputDirectory, workspace.OutputDirectory],
+            new StringWriter(),
+            error);
+
+        Assert.Equal(ExitCodes.InvalidInput, exitCode);
+        Assert.Contains(BatchFileNames.Trades, error.ToString(), StringComparison.Ordinal);
+    }
+}
