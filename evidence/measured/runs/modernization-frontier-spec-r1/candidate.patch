@@ -0,0 +1,44 @@
+using System.Globalization;
+
+namespace TradeReconciliation.Core.Csv;
+
+/// <summary>
+/// Canonical value handling for the reconciliation contract.
+/// </summary>
+public static class ValueNormalizer
+{
+    /// <summary>
+    /// Trimmed, invariant upper-case form used for every account, instrument, currency, trade
+    /// identifier, and override action comparison (REQ-2).
+    /// </summary>
+    public static string Normalize(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();
+}
+
+/// <summary>
+/// Formatting rules for the observable CSV and report files. These are compatibility boundaries:
+/// changing them changes the downstream contract.
+/// </summary>
+public static class FieldFormat
+{
+    public const string DateFormat = "yyyy-MM-dd";
+    private const string QuantityFormat = "0.####";
+
+    public static string Date(DateOnly value) => value.ToString(DateFormat, CultureInfo.InvariantCulture);
+
+    public static string Quantity(decimal value) => value.ToString(QuantityFormat, CultureInfo.InvariantCulture);
+
+    public static string Count(int value) => value.ToString(CultureInfo.InvariantCulture);
+
+    public static DateOnly ParseDate(string value) =>
+        DateOnly.ParseExact(value, DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None);
+
+    public static bool TryParseDate(string value, out DateOnly parsed) =>
+        DateOnly.TryParseExact(value, DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed);
+
+    public static bool TryParseDecimal(string value, out decimal parsed) =>
+        decimal.TryParse(
+            value,
+            NumberStyles.Number | NumberStyles.AllowLeadingSign,
+            CultureInfo.InvariantCulture,
+            out parsed);
+}
