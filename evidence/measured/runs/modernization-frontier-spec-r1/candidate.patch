@@ -0,0 +1,68 @@
+using System.Text;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Reporting;
+
+/// <summary>
+/// Builds <c>end-of-day-report.txt</c>. The layout, headings, totals, and ordering are part of the
+/// downstream contract, so the builder is deterministic and free of clock or environment input.
+/// </summary>
+public sealed class EndOfDayReportBuilder
+{
+    public string Build(DateOnly businessDate, ReconciliationResult result)
+    {
+        ArgumentNullException.ThrowIfNull(result);
+
+        var report = new StringBuilder();
+        report.AppendLine("Legacy Trade Reconciliation - End Of Day Report");
+        report.AppendLine("Business Date: " + FieldFormat.Date(businessDate));
+        report.AppendLine();
+        report.AppendLine("Totals");
+        report.AppendLine("------");
+        report.AppendLine("Trades Read: " + FieldFormat.Count(result.TotalTradesRead));
+        report.AppendLine("Canonical Trades: " + FieldFormat.Count(result.CanonicalTradeCount));
+        report.AppendLine("Matched: " + FieldFormat.Count(result.MatchedCount));
+        report.AppendLine("Manual Override Matched: " + FieldFormat.Count(result.ManualOverrideMatchedCount));
+        report.AppendLine("Manual Override Suppressed: " + FieldFormat.Count(result.ManualOverrideSuppressedCount));
+        report.AppendLine("Open Breaks: " + FieldFormat.Count(result.OpenBreaks.Count));
+        report.AppendLine("Duplicate Trades: " + FieldFormat.Count(result.DuplicateTradeCount));
+        report.AppendLine("Stale Overrides: " + FieldFormat.Count(result.StaleOverrides.Count));
+        report.AppendLine();
+        report.AppendLine("Open Break Reasons");
+        report.AppendLine("------------------");
+
+        List<IGrouping<string, string>> reasonCounts = result.OpenBreaks
+            .SelectMany(record => record.Reasons.Split('|'))
+            .Select(reason => reason.Trim())
+            .Where(reason => !string.IsNullOrWhiteSpace(reason))
+            .GroupBy(reason => reason, StringComparer.Ordinal)
+            .OrderBy(group => group.Key, StringComparer.Ordinal)
+            .ToList();
+
+        foreach (IGrouping<string, string> reasonCount in reasonCounts)
+        {
+            report.AppendLine(reasonCount.Key + ": " + FieldFormat.Count(reasonCount.Count()));
+        }
+
+        if (reasonCounts.Count == 0)
+        {
+            report.AppendLine("None");
+        }
+
+        if (result.StaleOverrides.Count > 0)
+        {
+            report.AppendLine();
+            report.AppendLine("Stale Overrides");
+            report.AppendLine("---------------");
+
+            foreach (ManualOverrideRecord staleOverride in result.StaleOverrides
+                .OrderBy(item => item.TradeId, StringComparer.Ordinal))
+            {
+                report.AppendLine(staleOverride.TradeId + ": " + staleOverride.Action + " (" + staleOverride.ApprovedBy + ")");
+            }
+        }
+
+        return report.ToString().TrimEnd() + Environment.NewLine;
+    }
+}
