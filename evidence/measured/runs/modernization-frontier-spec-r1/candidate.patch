+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Unit coverage for every legacy business invariant, exercised without file execution (NFR-2).
+/// </summary>
+public sealed class MatchingEngineTests
+{
+    private readonly MatchingEngine _engine = new();
+
+    [Fact]
+    public void IdentityComparisonsUseTrimmedUpperCaseValues()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(tradeId: " t-1 ", account: " acc-1 ", instrument: " ins.n ", currency: " usd ")],
+            positions: [Build.Position(account: "ACC-1", instrument: "INS.N", currency: "USD")],
+            settlements: [Build.Settlement(account: " Acc-1", instrument: "Ins.N ", currency: "Usd")]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.Matched, matched.Status);
+        Assert.Equal("T-1", matched.TradeId);
+        Assert.Equal("ACC-1", matched.Account);
+        Assert.Equal("INS.N", matched.Instrument);
+        Assert.Equal("USD", matched.Currency);
+        Assert.Empty(result.OpenBreaks);
+    }
+
+    [Fact]
+    public void FirstOccurrenceOfATradeIdIsCanonicalAndLaterRowsBreak()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "t-1 ")],
+            positions: [Build.Position()],
+            settlements: [Build.Settlement()]);
+
+        Assert.Equal(2, result.TotalTradesRead);
+        Assert.Equal(1, result.CanonicalTradeCount);
+        Assert.Equal(1, result.DuplicateTradeCount);
+        Assert.Single(result.MatchedTrades);
+
+        BreakRecord duplicate = Assert.Single(result.OpenBreaks);
+        Assert.Equal(BreakReasons.DuplicateTradeId, duplicate.Reasons);
+        Assert.False(duplicate.CanManualOverride);
+    }
+
+    [Theory]
+    [InlineData("100.01", true)]
+    [InlineData("99.99", true)]
+    [InlineData("100.02", false)]
+    public void PositionQuantityToleranceIsAClosedInterval(string positionQuantity, bool expectMatch)
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(quantity: 100m)],
+            positions: [Build.Position(quantity: Amount(positionQuantity))],
+            settlements: [Build.Settlement(quantity: 100m)]);
+
+        AssertOutcome(result, expectMatch, BreakReasons.PositionQuantityOutOfTolerance);
+    }
+
+    [Theory]
+    [InlineData("100.02", true)]
+    [InlineData("99.98", true)]
+    [InlineData("100.03", false)]
+    public void SettlementQuantityToleranceIsAClosedInterval(string settlementQuantity, bool expectMatch)
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(quantity: 100m)],
+            positions: [Build.Position(quantity: 100m)],
+            settlements: [Build.Settlement(quantity: Amount(settlementQuantity))]);
+
+        AssertOutcome(result, expectMatch, BreakReasons.SettlementQuantityOutOfTolerance);
+    }
+
+    [Theory]
+    [InlineData("1005.00", true)]
+    [InlineData("995.00", true)]
+    [InlineData("1005.01", false)]
+    public void SettlementAmountToleranceIsAClosedInterval(string cashAmount, bool expectMatch)
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(netAmount: 1000m)],
+            positions: [Build.Position()],
+            settlements: [Build.Settlement(cashAmount: Amount(cashAmount))]);
+
+        AssertOutcome(result, expectMatch, BreakReasons.SettlementAmountOutOfTolerance);
+    }
+
+    private static decimal Amount(string value) =>
+        decimal.Parse(value, System.Globalization.CultureInfo.InvariantCulture);
+
+    [Fact]
+    public void TolerancesAreExternallyConfigurable()
+    {
+        var strictEngine = new MatchingEngine(new ReconciliationTolerances
+        {
+            PositionQuantity = 0m,
+            SettlementQuantity = 0m,
+            SettlementAmount = 0m,
+        });
+
+        ReconciliationResult result = strictEngine.Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 100.01m)],
+            [Build.Settlement(quantity: 100m)],
+            []);
+
+        Assert.Equal(BreakReasons.PositionQuantityOutOfTolerance, Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    [Theory]
+    [InlineData("0", "1000")]
+    [InlineData("-5", "1000")]
+    [InlineData("100", "0")]
+    [InlineData("100", "-1")]
+    public void NonPositiveTradeValuesAlwaysBreakEvenWithPerfectCounterparts(string rawQuantity, string rawNetAmount)
+    {
+        decimal quantity = Amount(rawQuantity);
+        decimal netAmount = Amount(rawNetAmount);
+
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(quantity: quantity, netAmount: netAmount)],
+            positions: [Build.Position(quantity: quantity)],
+            settlements: [Build.Settlement(quantity: quantity, cashAmount: netAmount)]);
+
+        BreakRecord broken = Assert.Single(result.OpenBreaks);
+        Assert.Equal(BreakReasons.TradeValueOutOfBounds, broken.Reasons);
+        Assert.False(broken.CanManualOverride);
+        Assert.Empty(result.MatchedTrades);
+    }
+
+    [Fact]
+    public void CounterpartIdentityIsCheckedBeforeTolerances()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(settlementDate: "2025-03-17", currency: "USD")],
+            positions: [Build.Position(settlementDate: "2025-03-18")],
+            settlements: [Build.Settlement(currency: "EUR")]);
+
+        BreakRecord broken = Assert.Single(result.OpenBreaks);
+        Assert.Equal(
+            $"{BreakReasons.PositionSettlementDateMismatch}|{BreakReasons.SettlementCurrencyMismatch}",
+            broken.Reasons);
+        Assert.True(broken.CanManualOverride);
+    }
+
+    [Fact]
+    public void AbsentCounterpartsAreReportedAndBlockManualOverride()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade()],
+            positions: [],
+            settlements: []);
+
+        BreakRecord broken = Assert.Single(result.OpenBreaks);
+        Assert.Equal($"{BreakReasons.MissingPosition}|{BreakReasons.MissingSettlement}", broken.Reasons);
+        Assert.False(broken.CanManualOverride);
+        Assert.Null(broken.PositionId);
+        Assert.Null(broken.SettlementId);
+    }
+
+    [Fact]
+    public void ACounterpartIsConsumedByAtMostOneTrade()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "T-2")],
+            positions: [Build.Position(positionId: "P-1")],
+            settlements: [Build.Settlement(settlementId: "S-1")]);
+
+        Assert.Single(result.MatchedTrades);
+        BreakRecord broken = Assert.Single(result.OpenBreaks);
+        Assert.Equal("T-2", broken.TradeId);
+        Assert.Equal($"{BreakReasons.MissingPosition}|{BreakReasons.MissingSettlement}", broken.Reasons);
+    }
+
+    [Fact]
+    public void QuantitySignMismatchIsABreak()
+    {
+        ReconciliationResult result = Reconcile(
+            trades: [Build.Trade(quantity: 100m)],
+            positions: [Build.Position(quantity: -100m)],
+            settlements: [Build.Settlement(quantity: 100m)]);
+
+        Assert.Equal(BreakReasons.PositionQuantitySignMismatch, Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    private static void AssertOutcome(ReconciliationResult result, bool expectMatch, string expectedBreakReason)
+    {
+        if (expectMatch)
+        {
+            Assert.Single(result.MatchedTrades);
+            Assert.Empty(result.OpenBreaks);
+            return;
+        }
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Equal(expectedBreakReason, Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    private ReconciliationResult Reconcile(
+        IReadOnlyList<TradeRecord> trades,
+        IReadOnlyList<PositionRecord> positions,
+        IReadOnlyList<SettlementRecord> settlements,
+        IReadOnlyList<ManualOverrideRecord>? overrides = null) =>
+        _engine.Reconcile(trades, positions, settlements, overrides ?? []);
+}
