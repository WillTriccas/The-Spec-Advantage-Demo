+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Golden-master characterization of the observable file contract (REQ-5, REQ-6, AC-8, AC-9).
+/// These assertions are the ported public characterization tests plus the outputs the legacy suite
+/// never covered: matched-trades for the baseline fixture and the run ledger itself.
+/// </summary>
+public sealed class GoldenMasterTests
+{
+    private static readonly DateOnly BusinessDate = new(2025, 3, 17);
+
+    [Fact]
+    public void BaselineFixtureReproducesTheGoldenBreakQueueAndReport()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        RunBatch(workspace);
+
+        Assert.Equal(
+            Fixtures.Normalize(Fixtures.ReadExpected(Fixtures.Baseline, BatchFileNames.BreakQueue)),
+            workspace.ReadNormalizedOutput(BatchFileNames.BreakQueue));
+        Assert.Equal(
+            Fixtures.Normalize(Fixtures.ReadExpected(Fixtures.Baseline, BatchFileNames.EndOfDayReport)),
+            workspace.ReadNormalizedOutput(BatchFileNames.EndOfDayReport));
+    }
+
+    [Fact]
+    public void ResultFilesUsePlatformNativeLineEndingsAndEndWithATerminator()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        RunBatch(workspace);
+
+        foreach (string fileName in BatchFileNames.DeclaredOutputs)
+        {
+            string content = workspace.ReadOutput(fileName);
+            Assert.EndsWith(Environment.NewLine, content, StringComparison.Ordinal);
+            Assert.Equal(
+                content.Split(Environment.NewLine).Length - 1,
+                content.Count(character => character == '\n'));
+        }
+    }
+
+    [Fact]
+    public void OverrideFixtureReproducesEveryGoldenResultFile()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.OverrideRerun);
+
+        RunBatch(workspace);
+
+        Assert.Equal(
+            Fixtures.Normalize(Fixtures.ReadExpected(Fixtures.OverrideRerun, BatchFileNames.MatchedTrades)),
+            workspace.ReadNormalizedOutput(BatchFileNames.MatchedTrades));
+        Assert.Equal(
+            Fixtures.Normalize(Fixtures.ReadExpected(Fixtures.OverrideRerun, BatchFileNames.BreakQueue)),
+            workspace.ReadNormalizedOutput(BatchFileNames.BreakQueue));
+        Assert.Equal(
+            Fixtures.Normalize(Fixtures.ReadExpected(Fixtures.OverrideRerun, BatchFileNames.EndOfDayReport)),
+            workspace.ReadNormalizedOutput(BatchFileNames.EndOfDayReport));
+    }
+
+    [Fact]
+    public void EveryDeclaredOutputFileIsWritten()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        RunBatch(workspace);
+
+        foreach (string fileName in BatchFileNames.DeclaredOutputs)
+        {
+            Assert.True(File.Exists(workspace.OutputPath(fileName)), $"{fileName} was not written.");
+        }
+    }
+
+    [Fact]
+    public void ExactRerunIsByteIdenticalAndDoesNotDuplicateLedgerHistory()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.OverrideRerun);
+
+        RunBatch(workspace);
+
+        Dictionary<string, string> firstRun = BatchFileNames.DeclaredOutputs
+            .ToDictionary(fileName => fileName, workspace.ReadOutput, StringComparer.Ordinal);
+
+        ReconciliationRunSummary rerun = RunBatch(workspace);
+
+        Assert.True(rerun.WasExactRerun);
+        foreach (string fileName in BatchFileNames.DeclaredOutputs)
+        {
+            Assert.Equal(firstRun[fileName], workspace.ReadOutput(fileName));
+        }
+
+        string[] ledgerLines = File.ReadAllLines(workspace.OutputPath(BatchFileNames.RunLedger));
+        Assert.Equal(2, ledgerLines.Length);
+        Assert.Equal(CsvRunLedgerHeader, ledgerLines[0]);
+    }
+
+    [Fact]
+    public void ChangedInputForTheSameDateProducesASecondLedgerEntry()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.Baseline);
+
+        RunBatch(workspace);
+
+        File.AppendAllText(
+            Path.Combine(workspace.InputDirectory, BatchFileNames.Trades),
+            "T-9001,ACC-009,NEW.N,10,2025-03-17,USD,900.00" + Environment.NewLine);
+
+        ReconciliationRunSummary second = RunBatch(workspace);
+
+        Assert.False(second.WasExactRerun);
+        Assert.Equal(3, File.ReadAllLines(workspace.OutputPath(BatchFileNames.RunLedger)).Length);
+    }
+
+    [Fact]
+    public void DuplicateOverrideInstructionIsSurfacedAsStaleEvidence()
+    {
+        using var workspace = new TempWorkspace();
+        workspace.CopyFixtureInput(Fixtures.OverrideRerun);
+
+        File.AppendAllText(
+            Path.Combine(workspace.InputDirectory, BatchFileNames.Overrides),
+            "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager" + Environment.NewLine);
+
+        RunBatch(workspace);
+
+        string report = workspace.ReadOutput(BatchFileNames.EndOfDayReport);
+        Assert.Contains("Stale Overrides: 1", report, StringComparison.Ordinal);
+        Assert.Contains("T-1003: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+
+        // The first instruction still applied, so the trade stays evidenced as a suppressed break.
+        Assert.Contains(
+            "T-1003,ManualOverrideSuppressed,",
+            workspace.ReadOutput(BatchFileNames.MatchedTrades),
+            StringComparison.Ordinal);
+    }
+
+    private const string CsvRunLedgerHeader =
+        "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+    private static ReconciliationRunSummary RunBatch(TempWorkspace workspace) =>
+        ReconciliationBatch.CreateDefault(NullDiagnostics.Instance).Execute(new RunRequest
+        {
+            BusinessDate = BusinessDate,
+            InputDirectory = workspace.InputDirectory,
+            OutputDirectory = workspace.OutputDirectory,
+        });
+}
