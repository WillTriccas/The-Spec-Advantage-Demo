--- /dev/null
+++ b/src/TradeReconciliation.Core/Domain/ReconciliationResult.cs
@@ -0,0 +1,40 @@
+namespace TradeReconciliation.Core.Domain;
+
+/// <summary>Outcome of a single reconciliation pass. Collections are already in output order.</summary>
+public sealed class ReconciliationResult
+{
+    public required IReadOnlyList<MatchedTradeRecord> MatchedTrades { get; init; }
+
+    public required IReadOnlyList<BreakRecord> OpenBreaks { get; init; }
+
+    public required IReadOnlyList<ManualOverrideRecord> StaleOverrides { get; init; }
+
+    public required int TotalTradesRead { get; init; }
+
+    public required int CanonicalTradeCount { get; init; }
+
+    public required int DuplicateTradeCount { get; init; }
+
+    public required int MatchedCount { get; init; }
+
+    public required int ManualOverrideMatchedCount { get; init; }
+
+    public required int ManualOverrideSuppressedCount { get; init; }
+}
+
+/// <summary>Operational counts for a completed batch execution. Contains no trade payload data.</summary>
+/// <param name="BusinessDate">Business date the batch was executed for.</param>
+/// <param name="InputSignature">Fingerprint of the business date plus every input file.</param>
+/// <param name="WasExactRerun">True when an identical run was already recorded in the ledger.</param>
+/// <param name="TotalTradesRead">Number of trade rows ingested.</param>
+/// <param name="MatchedRowCount">Number of rows written to <c>matched-trades.csv</c>.</param>
+/// <param name="OpenBreakCount">Number of rows written to <c>break-queue.csv</c>.</param>
+/// <param name="StaleOverrideCount">Number of manual override instructions that did not apply.</param>
+public readonly record struct ReconciliationRunSummary(
+    DateOnly BusinessDate,
+    string InputSignature,
+    bool WasExactRerun,
+    int TotalTradesRead,
+    int MatchedRowCount,
+    int OpenBreakCount,
+    int StaleOverrideCount);
