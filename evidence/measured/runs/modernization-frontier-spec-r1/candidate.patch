+/// <summary>Diagnostics sink that records nothing, for tests that do not assert on logging.</summary>
+internal sealed class NullDiagnostics : IBatchDiagnostics
+{
+    public static NullDiagnostics Instance { get; } = new();
+
+    public void RunStarting(DateOnly businessDate, string inputDirectory, string outputDirectory)
+    {
+    }
+
+    public void ExactRerunDetected(DateOnly businessDate, string inputSignature)
+    {
+    }
+
+    public void RunCompleted(ReconciliationRunSummary summary)
+    {
+    }
+}
+
+/// <summary>Creates and cleans an isolated working directory for a single test.</summary>
+internal sealed class TempWorkspace : IDisposable
+{
+    public TempWorkspace()
+    {
+        Root = Path.Combine(Path.GetTempPath(), "trade-reconciliation-tests", Guid.NewGuid().ToString("N"));
+        InputDirectory = Path.Combine(Root, "input");
+        OutputDirectory = Path.Combine(Root, "output");
+        Directory.CreateDirectory(InputDirectory);
+        Directory.CreateDirectory(OutputDirectory);
+    }
+
+    public string Root { get; }
+
+    public string InputDirectory { get; }
+
+    public string OutputDirectory { get; }
+
+    public string OutputPath(string fileName) => Path.Combine(OutputDirectory, fileName);
+
+    public string ReadOutput(string fileName) => File.ReadAllText(OutputPath(fileName));
+
+    /// <summary>Output text with line endings collapsed to LF, for fixture comparisons.</summary>
+    public string ReadNormalizedOutput(string fileName) => Fixtures.Normalize(ReadOutput(fileName));
+
+    public void WriteInput(string fileName, params string[] lines) =>
+        File.WriteAllLines(Path.Combine(InputDirectory, fileName), lines);
+
+    /// <summary>Copies a checked-in fixture's input dataset into this workspace.</summary>
+    public void CopyFixtureInput(string fixtureName)
+    {
+        foreach (string source in Directory.GetFiles(Fixtures.InputDirectory(fixtureName)))
+        {
+            File.Copy(source, Path.Combine(InputDirectory, Path.GetFileName(source)), overwrite: true);
+        }
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            if (Directory.Exists(Root))
+            {
+                Directory.Delete(Root, recursive: true);
+            }
+        }
+        catch (IOException)
+        {
+            // A leftover temp directory must never fail a test run.
+        }
+    }
+}
+
+/// <summary>Locations of the checked-in golden-master fixtures.</summary>
+internal static class Fixtures
+{
+    public const string Baseline = "baseline";
+    public const string OverrideRerun = "override-rerun";
+
+    public static string InputDirectory(string fixtureName) =>
+        Path.Combine(AppContext.BaseDirectory, "Fixtures", fixtureName, "input");
+
+    public static string ExpectedFile(string fixtureName, string fileName) =>
+        Path.Combine(AppContext.BaseDirectory, "Fixtures", fixtureName, "expected", fileName);
+
+    public static string ReadExpected(string fixtureName, string fileName) =>
+        File.ReadAllText(ExpectedFile(fixtureName, fileName));
+
+    /// <summary>
+    /// Collapses CRLF to LF. The batch writes platform-native line endings exactly as the legacy
+    /// application did, while the checked-in fixtures are stored with LF, so golden-master
+    /// comparisons normalize both sides and line-ending behavior is asserted separately.
+    /// </summary>
+    public static string Normalize(string content) => content.Replace("\r\n", "\n", StringComparison.Ordinal);
+}
