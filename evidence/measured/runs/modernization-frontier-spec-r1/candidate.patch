@@ -0,0 +1,26 @@
+namespace TradeReconciliation.Core.Execution;
+
+/// <summary>
+/// Process exit codes. Only <see cref="Success"/> is a successful outcome; every failure is a
+/// distinct, documented non-zero code so operators can route incidents (NFR-3).
+/// </summary>
+public static class ExitCodes
+{
+    /// <summary>The batch completed, or an identical prior run was retained.</summary>
+    public const int Success = 0;
+
+    /// <summary>An unexpected fault. The batch made no completion guarantee.</summary>
+    public const int UnexpectedFailure = 1;
+
+    /// <summary>The positional command contract was not satisfied.</summary>
+    public const int InvalidCommandLine = 2;
+
+    /// <summary>Input data was missing, unreadable, or structurally invalid.</summary>
+    public const int InvalidInput = 3;
+
+    /// <summary>Operator-supplied configuration could not be honored.</summary>
+    public const int InvalidConfiguration = 4;
+
+    /// <summary>Outputs could not be written.</summary>
+    public const int OutputFailure = 5;
+}
diff --git a/src/TradeReconciliation.Core/Execution/InputFingerprintCalculator.cs b/src/TradeReconciliation.Core/Execution/InputFingerprintCalculator.cs
new file mode 100644
index 0000000..4b68f03
--- /dev/null
+++ b/src/TradeReconciliation.Core/Execution/InputFingerprintCalculator.cs
@@ -0,0 +1,39 @@
+using System.Security.Cryptography;
+using System.Text;
+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Csv;
+
+namespace TradeReconciliation.Core.Execution;
+
+/// <summary>
+/// Fingerprints a run as the business date plus the name and full content of every file in the input
+/// directory. The fingerprint is what makes an exact rerun detectable and therefore idempotent (INV-4).
+/// </summary>
+/// <remarks>
+/// The payload layout is a compatibility boundary: <c>run-ledger.csv</c> stores the resulting digest,
+/// so changing the layout would invalidate ledgers produced by earlier runs.
+/// </remarks>
+public sealed class InputFingerprintCalculator : IInputFingerprintCalculator
+{
+    public string Calculate(DateOnly businessDate, string inputDirectory)
+    {
+        if (!Directory.Exists(inputDirectory))
+        {
+            throw ReconciliationInputException.MissingDirectory(inputDirectory);
+        }
+
+        var payload = new StringBuilder();
+        payload.AppendLine(FieldFormat.Date(businessDate));
+
+        foreach (string filePath in Directory
+            .GetFiles(inputDirectory)
+            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
+        {
+            payload.AppendLine(Path.GetFileName(filePath));
+            payload.AppendLine(File.ReadAllText(filePath));
+        }
+
+        byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+        return Convert.ToHexString(hash).ToLowerInvariant();
+    }
+}
diff --git a/src/TradeReconciliation.Core/Execution/ReconciliationBatch.cs b/src/TradeReconciliation.Core/Execution/ReconciliationBatch.cs
new file mode 100644
index 0000000..1fe7f31
--- /dev/null
+++ b/src/TradeReconciliation.Core/Execution/ReconciliationBatch.cs
@@ -0,0 +1,151 @@
+using TradeReconciliation.Core.Abstractions;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+using TradeReconciliation.Core.Reporting;
+
+namespace TradeReconciliation.Core.Execution;
+
+/// <summary>
+/// Orchestrates one batch execution. Every collaborator is injected, so the orchestration is
+/// exercisable without touching the file system (NFR-2).
+/// </summary>
+public sealed class ReconciliationBatch
+{
+    private readonly IReconciliationInputStore _inputStore;
+    private readonly IReconciliationOutputWriter _outputWriter;
+    private readonly IRunLedgerStore _ledgerStore;
+    private readonly IInputFingerprintCalculator _fingerprintCalculator;
+    private readonly MatchingEngine _matchingEngine;
+    private readonly EndOfDayReportBuilder _reportBuilder;
+    private readonly IBatchDiagnostics _diagnostics;
+
+    public ReconciliationBatch(
+        IReconciliationInputStore inputStore,
+        IReconciliationOutputWriter outputWriter,
+        IRunLedgerStore ledgerStore,
+        IInputFingerprintCalculator fingerprintCalculator,
+        MatchingEngine matchingEngine,
+        EndOfDayReportBuilder reportBuilder,
+        IBatchDiagnostics diagnostics)
+    {
+        ArgumentNullException.ThrowIfNull(inputStore);
+        ArgumentNullException.ThrowIfNull(outputWriter);
+        ArgumentNullException.ThrowIfNull(ledgerStore);
+        ArgumentNullException.ThrowIfNull(fingerprintCalculator);
+        ArgumentNullException.ThrowIfNull(matchingEngine);
+        ArgumentNullException.ThrowIfNull(reportBuilder);
+        ArgumentNullException.ThrowIfNull(diagnostics);
+
+        _inputStore = inputStore;
+        _outputWriter = outputWriter;
+        _ledgerStore = ledgerStore;
+        _fingerprintCalculator = fingerprintCalculator;
+        _matchingEngine = matchingEngine;
+        _reportBuilder = reportBuilder;
+        _diagnostics = diagnostics;
+    }
+
+    /// <summary>Builds a batch wired to the default file-based adapters.</summary>
+    public static ReconciliationBatch CreateDefault(
+        IBatchDiagnostics diagnostics,
+        ReconciliationTolerances? tolerances = null) =>
+        new(
+            new CsvReconciliationInputStore(),
+            new CsvReconciliationOutputWriter(),
+            new CsvRunLedgerStore(),
+            new InputFingerprintCalculator(),
+            new MatchingEngine(tolerances ?? ReconciliationTolerances.Default),
+            new EndOfDayReportBuilder(),
+            diagnostics);
+
+    public ReconciliationRunSummary Execute(RunRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        _diagnostics.RunStarting(request.BusinessDate, request.InputDirectory, request.OutputDirectory);
+        GuardInputsAvailable(request.InputDirectory);
+        Directory.CreateDirectory(request.OutputDirectory);
+
+        string inputSignature = _fingerprintCalculator.Calculate(request.BusinessDate, request.InputDirectory);
+
+        // INV-4: an identical rerun keeps the existing outputs and never appends a duplicate ledger row.
+        RunLedgerEntry? previousRun = _ledgerStore.FindRun(
+            request.OutputDirectory,
+            request.BusinessDate,
+            inputSignature);
+
+        if (previousRun is not null && _outputWriter.ResultFilesExist(request.OutputDirectory))
+        {
+            _diagnostics.ExactRerunDetected(request.BusinessDate, inputSignature);
+
+            var rerunSummary = new ReconciliationRunSummary(
+                request.BusinessDate,
+                inputSignature,
+                WasExactRerun: true,
+                previousRun.TotalTradesRead,
+                previousRun.MatchedCount,
+                previousRun.OpenBreakCount,
+                StaleOverrideCount: 0);
+
+            _diagnostics.RunCompleted(rerunSummary);
+            return rerunSummary;
+        }
+
+        ReconciliationResult result = _matchingEngine.Reconcile(
+            _inputStore.LoadTrades(request.InputDirectory),
+            _inputStore.LoadPositions(request.InputDirectory),
+            _inputStore.LoadSettlements(request.InputDirectory),
+            _inputStore.LoadOverrides(request.InputDirectory));
+
+        _outputWriter.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+        _outputWriter.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+        _outputWriter.WriteEndOfDayReport(
+            request.OutputDirectory,
+            _reportBuilder.Build(request.BusinessDate, result));
+
+        _ledgerStore.AppendIfMissing(
+            request.OutputDirectory,
+            new RunLedgerEntry
+            {
+                BusinessDate = request.BusinessDate,
+                InputSignature = inputSignature,
+                TotalTradesRead = result.TotalTradesRead,
+                OpenBreakCount = result.OpenBreaks.Count,
+                MatchedCount = result.MatchedTrades.Count,
+            });
+
+        var summary = new ReconciliationRunSummary(
+            request.BusinessDate,
+            inputSignature,
+            WasExactRerun: false,
+            result.TotalTradesRead,
+            result.MatchedTrades.Count,
+            result.OpenBreaks.Count,
+            result.StaleOverrides.Count);
+
+        _diagnostics.RunCompleted(summary);
+        return summary;
+    }
+
+    /// <summary>
+    /// Fails fast with an actionable message instead of producing success-shaped output from an
+    /// incomplete input set (NFR-3).
+    /// </summary>
+    private static void GuardInputsAvailable(string inputDirectory)
+    {
+        if (!Directory.Exists(inputDirectory))
+        {
+            throw ReconciliationInputException.MissingDirectory(inputDirectory);
+        }
+
+        foreach (string fileName in BatchFileNames.RequiredInputs)
+        {
+            if (!File.Exists(Path.Combine(inputDirectory, fileName)))
+            {
+                throw ReconciliationInputException.MissingFile(fileName, inputDirectory);
+            }
+        }
+    }
+}
diff --git a/src/TradeReconciliation.Core/Execution/RunRequest.cs b/src/TradeReconciliation.Core/Execution/RunRequest.cs
new file mode 100644
index 0000000..d547543
--- /dev/null
+++ b/src/TradeReconciliation.Core/Execution/RunRequest.cs
@@ -0,0 +1,97 @@
+using TradeReconciliation.Core.Csv;
+
+namespace TradeReconciliation.Core.Execution;
+
+/// <summary>
+/// The externally observable command contract: a business date, an input directory, and an output
+/// directory, in that positional order (AMB-1). This is a compatibility boundary.
+/// </summary>
+public sealed class RunRequest
+{
+    public const int ExpectedArgumentCount = 3;
+
+    public const string Usage =
+        "Usage: TradeReconciliation.Cli <business-date yyyy-MM-dd> <input-directory> <output-directory>";
+
+    public required DateOnly BusinessDate { get; init; }
+
+    public required string InputDirectory { get; init; }
+
+    public required string OutputDirectory { get; init; }
+
+    /// <summary>
+    /// Resolves the run request. No arguments selects the packaged sample dataset, matching the
+    /// legacy convenience behavior; otherwise exactly three positional arguments are required.
+    /// </summary>
+    public static RunRequest Resolve(IReadOnlyList<string>? args, string baseDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(baseDirectory);
+
+        if (args is null || args.Count == 0)
+        {
+            return new RunRequest
+            {
+                BusinessDate = new DateOnly(2025, 3, 17),
+                InputDirectory = Path.Combine(baseDirectory, "data", "sample"),
+                OutputDirectory = Path.Combine(baseDirectory, "output", "sample"),
+            };
+        }
+
+        if (args.Count != ExpectedArgumentCount)
+        {
+            throw new CommandLineException(
+                $"Expected either no arguments or exactly {ExpectedArgumentCount} arguments. {Usage}");
+        }
+
+        if (!FieldFormat.TryParseDate(args[0], out DateOnly businessDate))
+        {
+            throw new CommandLineException($"Business date must be formatted as {FieldFormat.DateFormat}. {Usage}");
+        }
+
+        return new RunRequest
+        {
+            BusinessDate = businessDate,
+            InputDirectory = ResolveDirectory(args[1], "input"),
+            OutputDirectory = ResolveDirectory(args[2], "output"),
+        };
+    }
+
+    private static string ResolveDirectory(string value, string role)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            throw new CommandLineException($"The {role} directory argument must not be empty. {Usage}");
+        }
+
+        try
+        {
+            return Path.GetFullPath(value);
+        }
+        catch (ArgumentException exception)
+        {
+            throw new CommandLineException($"The {role} directory argument is not a usable path. {Usage}", exception);
+        }
+        catch (NotSupportedException exception)
+        {
+            throw new CommandLineException($"The {role} directory argument is not a usable path. {Usage}", exception);
+        }
+    }
+}
+
+/// <summary>Raised when the positional command contract is not satisfied.</summary>
+public sealed class CommandLineException : Exception
+{
+    public CommandLineException(string message)
+        : base(message)
+    {
+    }
+
+    public CommandLineException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+
+    public CommandLineException()
+    {
+    }
+}
diff --git a/src/TradeReconciliation.Core/Matching/CounterpartIndex.cs b/src/TradeReconciliation.Core/Matching/CounterpartIndex.cs
new file mode 100644
index 0000000..75ba3db
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/CounterpartIndex.cs
@@ -0,0 +1,57 @@
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Matching;
+
+/// <summary>
+/// Account/instrument index of position and settlement counterparts.
+/// A missing pair key yields <see langword="null"/>, which is materially different from an empty
+/// candidate list: it means no counterpart record exists at all for that account and instrument.
+/// </summary>
+internal sealed class CounterpartIndex
+{
+    private readonly Dictionary<string, List<PositionRecord>> _positions;
+    private readonly Dictionary<string, List<SettlementRecord>> _settlements;
+
+    private CounterpartIndex(
+        Dictionary<string, List<PositionRecord>> positions,
+        Dictionary<string, List<SettlementRecord>> settlements)
+    {
+        _positions = positions;
+        _settlements = settlements;
+    }
+
+    public static CounterpartIndex Build(
+        IReadOnlyList<PositionRecord> positions,
+        IReadOnlyList<SettlementRecord> settlements)
+    {
+        Dictionary<string, List<PositionRecord>> positionsByPair = positions
+            .GroupBy(position => PairKey(position.Account, position.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(position => position.PositionId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        Dictionary<string, List<SettlementRecord>> settlementsByPair = settlements
+            .GroupBy(settlement => PairKey(settlement.Account, settlement.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(settlement => settlement.SettlementId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        return new CounterpartIndex(positionsByPair, settlementsByPair);
+    }
+
+    public IReadOnlyList<PositionRecord>? PositionsFor(TradeRecord trade) =>
+        _positions.TryGetValue(PairKey(trade.Account, trade.Instrument), out List<PositionRecord>? candidates)
+            ? candidates
+            : null;
+
+    public IReadOnlyList<SettlementRecord>? SettlementsFor(TradeRecord trade) =>
+        _settlements.TryGetValue(PairKey(trade.Account, trade.Instrument), out List<SettlementRecord>? candidates)
+            ? candidates
+            : null;
+
+    private static string PairKey(string account, string instrument) =>
+        ValueNormalizer.Normalize(account) + "|" + ValueNormalizer.Normalize(instrument);
+}
diff --git a/src/TradeReconciliation.Core/Matching/MatchingEngine.cs b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
new file mode 100644
index 0000000..489d7c5
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
@@ -0,0 +1,368 @@
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Matching;
+
+/// <summary>
+/// Pure reconciliation rules: no file, clock, or environment access, so every business invariant is
+/// unit testable without end-to-end execution (NFR-2).
+/// </summary>
+public sealed class MatchingEngine
+{
+    private readonly ReconciliationTolerances _tolerances;
+
+    public MatchingEngine()
+        : this(ReconciliationTolerances.Default)
+    {
+    }
+
+    public MatchingEngine(ReconciliationTolerances tolerances)
+    {
+        ArgumentNullException.ThrowIfNull(tolerances);
+        _tolerances = tolerances;
+    }
+
+    public ReconciliationResult Reconcile(
+        IReadOnlyList<TradeRecord> trades,
+        IReadOnlyList<PositionRecord> positions,
+        IReadOnlyList<SettlementRecord> settlements,
+        IReadOnlyList<ManualOverrideRecord> overrides)
+    {
+        ArgumentNullException.ThrowIfNull(trades);
+        ArgumentNullException.ThrowIfNull(positions);
+        ArgumentNullException.ThrowIfNull(settlements);
+        ArgumentNullException.ThrowIfNull(overrides);
+
+        OverrideLedger overrideLedger = OverrideLedger.Build(overrides);
+        CounterpartIndex counterparts = CounterpartIndex.Build(positions, settlements);
+
+        ClassificationOutcome classification = Classify(trades, counterparts);
+        ApplyOverrides(classification.MatchedTrades, classification.Breaks, overrideLedger);
+        overrideLedger.CollectUnusedInstructions(overrides);
+
+        List<MatchedTradeRecord> matchedTrades = classification.MatchedTrades;
+
+        return new ReconciliationResult
+        {
+            MatchedTrades = [.. matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            OpenBreaks = [.. classification.Breaks.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            StaleOverrides = [.. overrideLedger.Stale.OrderBy(record => record.TradeId, StringComparer.Ordinal)],
+            TotalTradesRead = trades.Count,
+            CanonicalTradeCount = classification.CanonicalTradeCount,
+            DuplicateTradeCount = classification.DuplicateTradeCount,
+            MatchedCount = matchedTrades.Count(record => record.Status == MatchStatuses.Matched),
+            ManualOverrideMatchedCount =
+                matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideMatched),
+            ManualOverrideSuppressedCount =
+                matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideSuppressed),
+        };
+    }
+
+    private ClassificationOutcome Classify(IReadOnlyList<TradeRecord> trades, CounterpartIndex counterparts)
+    {
+        var matchedTrades = new List<MatchedTradeRecord>();
+        var breaks = new List<BreakRecord>();
+        var seenTradeIds = new HashSet<string>(StringComparer.Ordinal);
+        var usedPositions = new HashSet<string>(StringComparer.Ordinal);
+        var usedSettlements = new HashSet<string>(StringComparer.Ordinal);
+        int duplicateTradeCount = 0;
+
+        foreach (TradeRecord trade in trades)
+        {
+            // INV-1: the first occurrence of a trade identifier is canonical, every later row is a
+            // separately accounted duplicate break rather than a silently dropped row.
+            if (!seenTradeIds.Add(ValueNormalizer.Normalize(trade.TradeId)))
+            {
+                duplicateTradeCount++;
+                breaks.Add(CreateBreak(trade, BreakReasons.DuplicateTradeId, null, null, canManualOverride: false));
+                continue;
+            }
+
+            if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+            {
+                breaks.Add(CreateBreak(trade, BreakReasons.TradeValueOutOfBounds, null, null, canManualOverride: false));
+                continue;
+            }
+
+            var reasons = new List<string>();
+            IReadOnlyList<PositionRecord>? positionCandidates = counterparts.PositionsFor(trade);
+            IReadOnlyList<SettlementRecord>? settlementCandidates = counterparts.SettlementsFor(trade);
+
+            PositionRecord? position = null;
+            if (positionCandidates is null)
+            {
+                reasons.Add(BreakReasons.MissingPosition);
+            }
+            else
+            {
+                position = SelectPosition(trade, positionCandidates, usedPositions, reasons);
+            }
+
+            SettlementRecord? settlement = null;
+            if (settlementCandidates is null)
+            {
+                reasons.Add(BreakReasons.MissingSettlement);
+            }
+            else
+            {
+                settlement = SelectSettlement(trade, settlementCandidates, usedSettlements, reasons);
+            }
+
+            if (reasons.Count == 0 && position is not null && settlement is not null)
+            {
+                usedPositions.Add(position.PositionId);
+                usedSettlements.Add(settlement.SettlementId);
+                matchedTrades.Add(CreateMatchedTrade(
+                    trade,
+                    MatchStatuses.Matched,
+                    position.PositionId,
+                    settlement.SettlementId,
+                    note: null));
+                continue;
+            }
+
+            // INV-3: an override may only resolve a break whose counterparts concretely exist.
+            bool canManualOverride =
+                positionCandidates is not null &&
+                settlementCandidates is not null &&
+                !reasons.Exists(BreakReasons.BlocksManualOverride);
+
+            breaks.Add(CreateBreak(
+                trade,
+                FormatReasons(reasons),
+                position?.PositionId ?? NearestPositionId(trade, positionCandidates),
+                settlement?.SettlementId ?? NearestSettlementId(trade, settlementCandidates),
+                canManualOverride));
+        }
+
+        return new ClassificationOutcome(matchedTrades, breaks, seenTradeIds.Count, duplicateTradeCount);
+    }
+
+    private static void ApplyOverrides(
+        List<MatchedTradeRecord> matchedTrades,
+        List<BreakRecord> breaks,
+        OverrideLedger overrideLedger)
+    {
+        foreach (BreakRecord breakRecord in breaks.ToList())
+        {
+            if (!overrideLedger.TryGetInstruction(breakRecord.TradeId, out ManualOverrideRecord? instruction))
+            {
+                continue;
+            }
+
+            overrideLedger.MarkTargeted(breakRecord.TradeId);
+
+            if (!breakRecord.CanManualOverride ||
+                string.IsNullOrWhiteSpace(instruction.Note) ||
+                string.IsNullOrWhiteSpace(instruction.ApprovedBy))
+            {
+                overrideLedger.MarkStale(instruction);
+                continue;
+            }
+
+            string? status = ValueNormalizer.Normalize(instruction.Action) switch
+            {
+                OverrideActions.ForceMatch => MatchStatuses.ManualOverrideMatched,
+                OverrideActions.SuppressBreak => MatchStatuses.ManualOverrideSuppressed,
+                _ => null,
+            };
+
+            if (status is null)
+            {
+                overrideLedger.MarkStale(instruction);
+                continue;
+            }
+
+            // The resolved break stays evidenced in matched-trades.csv, carrying the override note
+            // and the counterpart identifiers the break was raised against (REQ-4).
+            matchedTrades.Add(new MatchedTradeRecord
+            {
+                TradeId = breakRecord.TradeId,
+                Status = status,
+                Account = breakRecord.Account,
+                Instrument = breakRecord.Instrument,
+                Quantity = breakRecord.Quantity,
+                SettlementDate = breakRecord.SettlementDate,
+                Currency = breakRecord.Currency,
+                PositionId = breakRecord.PositionId,
+                SettlementId = breakRecord.SettlementId,
+                OverrideNote = instruction.Note,
+            });
+
+            breaks.Remove(breakRecord);
+        }
+    }
+
+    private PositionRecord? SelectPosition(
+        TradeRecord trade,
+        IReadOnlyList<PositionRecord> candidates,
+        HashSet<string> usedPositions,
+        List<string> reasons)
+    {
+        List<PositionRecord> available =
+            candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingPosition);
+            return null;
+        }
+
+        // INV-2: identity compatibility is proven before any tolerance is evaluated.
+        List<PositionRecord> sameDate =
+            available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionSettlementDateMismatch);
+            return null;
+        }
+
+        List<PositionRecord> sameCurrency = sameDate
+            .Where(candidate => ValueNormalizer.Normalize(candidate.Currency) == ValueNormalizer.Normalize(trade.Currency))
+            .ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionCurrencyMismatch);
+            return null;
+        }
+
+        PositionRecord candidatePosition = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.PositionQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _tolerances.PositionQuantity)
+        {
+            reasons.Add(BreakReasons.PositionQuantityOutOfTolerance);
+            return null;
+        }
+
+        return candidatePosition;
+    }
+
+    private SettlementRecord? SelectSettlement(
+        TradeRecord trade,
+        IReadOnlyList<SettlementRecord> candidates,
+        HashSet<string> usedSettlements,
+        List<string> reasons)
+    {
+        List<SettlementRecord> available =
+            candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingSettlement);
+            return null;
+        }
+
+        List<SettlementRecord> sameDate =
+            available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementDateMismatch);
+            return null;
+        }
+
+        List<SettlementRecord> sameCurrency = sameDate
+            .Where(candidate => ValueNormalizer.Normalize(candidate.Currency) == ValueNormalizer.Normalize(trade.Currency))
+            .ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementCurrencyMismatch);
+            return null;
+        }
+
+        SettlementRecord candidateSettlement = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.SettlementQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _tolerances.SettlementQuantity)
+        {
+            reasons.Add(BreakReasons.SettlementQuantityOutOfTolerance);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _tolerances.SettlementAmount)
+        {
+            reasons.Add(BreakReasons.SettlementAmountOutOfTolerance);
+            return null;
+        }
+
+        return candidateSettlement;
+    }
+
+    private static string? NearestPositionId(TradeRecord trade, IReadOnlyList<PositionRecord>? candidates) =>
+        candidates?
+            .OrderBy(candidate => Math.Abs(candidate.SettlementDate.DayNumber - trade.SettlementDate.DayNumber))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .Select(candidate => candidate.PositionId)
+            .FirstOrDefault();
+
+    private static string? NearestSettlementId(TradeRecord trade, IReadOnlyList<SettlementRecord>? candidates) =>
+        candidates?
+            .OrderBy(candidate => Math.Abs(candidate.SettlementDate.DayNumber - trade.SettlementDate.DayNumber))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .Select(candidate => candidate.SettlementId)
+            .FirstOrDefault();
+
+    private static string FormatReasons(IEnumerable<string> reasons) =>
+        string.Join('|', reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal));
+
+    private static BreakRecord CreateBreak(
+        TradeRecord trade,
+        string reasons,
+        string? positionId,
+        string? settlementId,
+        bool canManualOverride) =>
+        new()
+        {
+            TradeId = ValueNormalizer.Normalize(trade.TradeId),
+            Account = ValueNormalizer.Normalize(trade.Account),
+            Instrument = ValueNormalizer.Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = ValueNormalizer.Normalize(trade.Currency),
+            Reasons = reasons,
+            PositionId = positionId,
+            SettlementId = settlementId,
+            CanManualOverride = canManualOverride,
+        };
+
+    private static MatchedTradeRecord CreateMatchedTrade(
+        TradeRecord trade,
+        string status,
+        string? positionId,
+        string? settlementId,
+        string? note) =>
+        new()
+        {
+            TradeId = ValueNormalizer.Normalize(trade.TradeId),
+            Status = status,
+            Account = ValueNormalizer.Normalize(trade.Account),
+            Instrument = ValueNormalizer.Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = ValueNormalizer.Normalize(trade.Currency),
+            PositionId = positionId,
+            SettlementId = settlementId,
+            OverrideNote = note,
+        };
+
+    private sealed record ClassificationOutcome(
+        List<MatchedTradeRecord> MatchedTrades,
+        List<BreakRecord> Breaks,
+        int CanonicalTradeCount,
+        int DuplicateTradeCount);
+}
diff --git a/src/TradeReconciliation.Core/Matching/OverrideLedger.cs b/src/TradeReconciliation.Core/Matching/OverrideLedger.cs
new file mode 100644
index 0000000..c6a2afd
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/OverrideLedger.cs
@@ -0,0 +1,72 @@
+using TradeReconciliation.Core.Csv;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Matching;
+
+/// <summary>
+/// Tracks which manual override instructions may apply and which must be surfaced as stale.
+/// </summary>
+/// <remarks>
+/// AMB-2 / REQ-4: only the first instruction per trade is eligible. Every later instruction, every
+/// instruction rejected at an ineligible break, and every instruction whose trade never broke is
+/// preserved as stale evidence. Instructions are tracked by reference identity so that two textually
+/// identical rows remain two distinct pieces of evidence.
+/// </remarks>
+internal sealed class OverrideLedger
+{
+    private readonly Dictionary<string, ManualOverrideRecord> _eligibleByTradeId;
+    private readonly HashSet<string> _targetedTradeIds = new(StringComparer.Ordinal);
+    private readonly HashSet<ManualOverrideRecord> _staleIdentity = new(ReferenceEqualityComparer.Instance);
+    private readonly List<ManualOverrideRecord> _stale = [];
+
+    private OverrideLedger(Dictionary<string, ManualOverrideRecord> eligibleByTradeId) =>
+        _eligibleByTradeId = eligibleByTradeId;
+
+    public IReadOnlyList<ManualOverrideRecord> Stale => _stale;
+
+    public static OverrideLedger Build(IReadOnlyList<ManualOverrideRecord> overrides)
+    {
+        List<IGrouping<string, ManualOverrideRecord>> groups = overrides
+            .GroupBy(instruction => ValueNormalizer.Normalize(instruction.TradeId), StringComparer.Ordinal)
+            .ToList();
+
+        var ledger = new OverrideLedger(
+            groups.ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal));
+
+        foreach (ManualOverrideRecord superseded in groups.SelectMany(group => group.Skip(1)))
+        {
+            ledger.MarkStale(superseded);
+        }
+
+        return ledger;
+    }
+
+    public bool TryGetInstruction(string tradeId, out ManualOverrideRecord instruction) =>
+        _eligibleByTradeId.TryGetValue(ValueNormalizer.Normalize(tradeId), out instruction!);
+
+    /// <summary>Records that a break existed for this trade, so its instruction was considered.</summary>
+    public void MarkTargeted(string tradeId) => _targetedTradeIds.Add(ValueNormalizer.Normalize(tradeId));
+
+    public void MarkStale(ManualOverrideRecord instruction)
+    {
+        _stale.Add(instruction);
+        _staleIdentity.Add(instruction);
+    }
+
+    /// <summary>
+    /// Surfaces every instruction that never met a break, so an override can never disappear silently.
+    /// </summary>
+    public void CollectUnusedInstructions(IReadOnlyList<ManualOverrideRecord> overrides)
+    {
+        foreach (ManualOverrideRecord instruction in overrides)
+        {
+            if (_targetedTradeIds.Contains(ValueNormalizer.Normalize(instruction.TradeId)) ||
+                _staleIdentity.Contains(instruction))
+            {
+                continue;
+            }
+
+            MarkStale(instruction);
+        }
+    }
+}
