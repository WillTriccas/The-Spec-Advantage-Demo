new file mode 100644
index 0000000..d3fdade
--- /dev/null
+++ b/src/TradeReconciliation.Core/ReconciliationInputException.cs
@@ -0,0 +1,19 @@
+namespace TradeReconciliation.Core;
+
+/// <summary>
+/// Raised when the batch cannot proceed because of missing or malformed input.
+/// The message is safe to log: it names files, line numbers, and counts, never
+/// trade, position, settlement, or override payloads.
+/// </summary>
+public sealed class ReconciliationInputException : Exception
+{
+    public ReconciliationInputException(string message)
+        : base(message)
+    {
+    }
+
+    public ReconciliationInputException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+}
diff --git a/src/TradeReconciliation.Core/Reporting/EndOfDayReporter.cs b/src/TradeReconciliation.Core/Reporting/EndOfDayReporter.cs
new file mode 100644
index 0000000..1c23f27
--- /dev/null
+++ b/src/TradeReconciliation.Core/Reporting/EndOfDayReporter.cs
@@ -0,0 +1,72 @@
+using System.Text;
+
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Reporting;
+
+/// <summary>
+/// Renders <c>end-of-day-report.txt</c>. Section order, headings, and counts are
+/// part of the observable contract relied on by Trade Operations.
+/// </summary>
+public sealed class EndOfDayReporter : IEndOfDayReporter
+{
+    public string BuildReport(DateTime businessDate, ReconciliationResult result)
+    {
+        ArgumentNullException.ThrowIfNull(result);
+
+        var report = new StringBuilder();
+        AppendLine(report, "Legacy Trade Reconciliation - End Of Day Report");
+        AppendLine(report, "Business Date: " + OutputFormat.FormatDate(businessDate));
+        AppendLine(report, string.Empty);
+        AppendLine(report, "Totals");
+        AppendLine(report, "------");
+        AppendLine(report, "Trades Read: " + result.TotalTradesRead);
+        AppendLine(report, "Canonical Trades: " + result.CanonicalTradeCount);
+        AppendLine(report, "Matched: " + result.MatchedCount);
+        AppendLine(report, "Manual Override Matched: " + result.ManualOverrideMatchedCount);
+        AppendLine(report, "Manual Override Suppressed: " + result.ManualOverrideSuppressedCount);
+        AppendLine(report, "Open Breaks: " + result.OpenBreaks.Count);
+        AppendLine(report, "Duplicate Trades: " + result.DuplicateTradeCount);
+        AppendLine(report, "Stale Overrides: " + result.StaleOverrides.Count);
+        AppendLine(report, string.Empty);
+        AppendLine(report, "Open Break Reasons");
+        AppendLine(report, "------------------");
+
+        var reasonCounts = result.OpenBreaks
+            .SelectMany(record => record.Reasons.Split('|'))
+            .Select(reason => reason.Trim())
+            .Where(reason => !string.IsNullOrWhiteSpace(reason))
+            .GroupBy(reason => reason, StringComparer.Ordinal)
+            .OrderBy(group => group.Key, StringComparer.Ordinal)
+            .Select(group => group.Key + ": " + group.Count())
+            .ToList();
+
+        foreach (var reasonCount in reasonCounts)
+        {
+            AppendLine(report, reasonCount);
+        }
+
+        if (reasonCounts.Count == 0)
+        {
+            AppendLine(report, "None");
+        }
+
+        if (result.StaleOverrides.Count > 0)
+        {
+            AppendLine(report, string.Empty);
+            AppendLine(report, "Stale Overrides");
+            AppendLine(report, "---------------");
+
+            foreach (var staleOverride in result.StaleOverrides.OrderBy(item => item.TradeId, StringComparer.Ordinal))
+            {
+                AppendLine(report, staleOverride.TradeId + ": " + staleOverride.Action + " (" + staleOverride.ApprovedBy + ")");
+            }
+        }
+
+        return report.ToString().TrimEnd() + OutputFormat.LineSeparator;
+    }
+
+    private static void AppendLine(StringBuilder builder, string text) =>
+        builder.Append(text).Append(OutputFormat.LineSeparatorChar);
+}
