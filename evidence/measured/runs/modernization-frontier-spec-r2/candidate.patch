+            Path.Combine(directory, BatchFileNames.Trades),
+            "trade_id,account,instrument,quantity,settlement_date,currency,net_amount\n"
+            + "T-1,ACC-001,IBM.N,100,2025-03-17,USD,12500\n"
+            + "\n"
+            + "T-1,ACC-001,IBM.N,100,2025-03-17,USD,12500\n");
+
+        Assert.Equal(2, _gateway.LoadTrades(directory).Count);
+    }
+
+    [Fact]
+    public void Treats_a_missing_override_file_as_no_instructions()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-no-overrides");
+
+        Assert.Empty(_gateway.LoadOverrides(directory));
+    }
+
+    // NFR-3: diagnostics name the file and line, and never echo a full payload.
+    [Fact]
+    public void Reports_a_missing_required_file_with_an_actionable_message()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-missing");
+
+        var exception = Assert.Throws<ReconciliationInputException>(() => _gateway.LoadTrades(directory));
+
+        Assert.Contains(BatchFileNames.Trades, exception.Message, StringComparison.Ordinal);
+        Assert.Contains(directory, exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Reports_a_malformed_row_with_its_line_number()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-malformed");
+        File.WriteAllText(
+            Path.Combine(directory, BatchFileNames.Positions),
+            "position_id,account,instrument,quantity,settlement_date,currency\n"
+            + "P-1,ACC-001,IBM.N,100,2025-03-17,USD\n"
+            + "P-2,ACC-001,IBM.N\n");
+
+        var exception = Assert.Throws<ReconciliationInputException>(() => _gateway.LoadPositions(directory));
+
+        Assert.Contains("line 3", exception.Message, StringComparison.Ordinal);
+        Assert.Contains(BatchFileNames.Positions, exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Reports_an_unparsable_number_with_its_line_number()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-number");
+        File.WriteAllText(
+            Path.Combine(directory, BatchFileNames.Positions),
+            "position_id,account,instrument,quantity,settlement_date,currency\n"
+            + "P-1,ACC-001,IBM.N,one hundred,2025-03-17,USD\n");
+
+        var exception = Assert.Throws<ReconciliationInputException>(() => _gateway.LoadPositions(directory));
+
+        Assert.Contains("line 2", exception.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Writes_quantities_and_dates_in_invariant_formats()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-write");
+
+        _gateway.WriteMatchedTrades(directory, [new MatchedTradeRecord
+        {
+            TradeId = "T-1",
+            Status = "Matched",
+            Account = "ACC-001",
+            Instrument = "IBM.N",
+            Quantity = 1000.5m,
+            SettlementDate = new DateTime(2025, 3, 17),
+            Currency = "USD",
+            PositionId = "P-1",
+            SettlementId = "S-1"
+        }]);
+
+        Assert.Equal(
+            CsvFileGateway.MatchedTradesHeader + "\n"
+            + "T-1,Matched,ACC-001,IBM.N,1000.5,2025-03-17,USD,P-1,S-1,\n",
+            File.ReadAllText(Path.Combine(directory, BatchFileNames.MatchedTrades)));
+    }
+
+    [Fact]
+    public void Writes_a_header_only_file_when_there_is_nothing_to_report()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-empty");
+
+        _gateway.WriteBreakQueue(directory, []);
+
+        Assert.Equal(
+            CsvFileGateway.BreakQueueHeader + "\n",
+            File.ReadAllText(Path.Combine(directory, BatchFileNames.BreakQueue)));
+    }
+
+    // INV-4: the fingerprint is what makes an exact rerun detectable.
+    [Fact]
+    public void Input_signature_is_stable_for_identical_inputs_and_changes_with_content()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("gateway-signature");
+        var path = Path.Combine(directory, BatchFileNames.Trades);
+        File.WriteAllText(path, "trade_id\nT-1\n");
+
+        var businessDate = new DateTime(2025, 3, 17);
+        var first = _gateway.CalculateInputSignature(businessDate, directory);
+
+        Assert.Equal(first, _gateway.CalculateInputSignature(businessDate, directory));
+        Assert.NotEqual(first, _gateway.CalculateInputSignature(businessDate.AddDays(1), directory));
+
+        File.WriteAllText(path, "trade_id\nT-2\n");
+        Assert.NotEqual(first, _gateway.CalculateInputSignature(businessDate, directory));
+    }
+
+    [Fact]
+    public void Input_signature_rejects_a_missing_directory()
+    {
+        var directory = Path.Combine(TestPaths.CreateTemporaryDirectory("gateway-signature-missing"), "absent");
+
+        Assert.Throws<ReconciliationInputException>(
+            () => _gateway.CalculateInputSignature(new DateTime(2025, 3, 17), directory));
+    }
+}
