@@ -0,0 +1,34 @@
+using System.Globalization;
+
+namespace TradeReconciliation.Core.Configuration;
+
+/// <summary>
+/// Formatting rules that make every output file byte-deterministic across
+/// operating systems. The legacy batch relied on <see cref="Environment.NewLine"/>;
+/// pinning "\n" keeps identical reruns byte-identical on any host while matching
+/// the checked-in golden-master fixtures.
+/// </summary>
+public static class OutputFormat
+{
+    /// <summary>Line separator used for every generated file.</summary>
+    public const string LineSeparator = "\n";
+
+    /// <summary>Character form of <see cref="LineSeparator"/> for buffered writes.</summary>
+    public const char LineSeparatorChar = '\n';
+
+    /// <summary>Invariant date format used in every generated file.</summary>
+    public const string DateFormat = "yyyy-MM-dd";
+
+    /// <summary>Invariant quantity format: up to four decimals, no trailing zeroes.</summary>
+    public const string DecimalFormat = "0.####";
+
+    public static string FormatDate(DateTime value) =>
+        value.ToString(DateFormat, CultureInfo.InvariantCulture);
+
+    public static string FormatDecimal(decimal value) =>
+        value.ToString(DecimalFormat, CultureInfo.InvariantCulture);
+
+    /// <summary>Joins <paramref name="lines"/> with a trailing separator after the final line.</summary>
+    public static string JoinLines(IEnumerable<string> lines) =>
+        string.Concat(lines.Select(line => line + LineSeparator));
+}
