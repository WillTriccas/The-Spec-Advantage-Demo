@@ -0,0 +1,316 @@
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Business-rule coverage for the reconciliation engine. These tests exercise the
+/// rules directly, without any file I/O (NFR-2).
+/// </summary>
+public sealed class MatchingEngineTests
+{
+    private readonly MatchingEngine _engine = new(ReconciliationOptions.Default);
+
+    private static decimal Amount(string text) =>
+        decimal.Parse(text, System.Globalization.CultureInfo.InvariantCulture);
+
+    private ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord>? trades = null,
+        IReadOnlyCollection<PositionRecord>? positions = null,
+        IReadOnlyCollection<SettlementRecord>? settlements = null,
+        IReadOnlyCollection<ManualOverrideRecord>? overrides = null) =>
+        _engine.Reconcile(
+            trades ?? [],
+            positions ?? [],
+            settlements ?? [],
+            overrides ?? []);
+
+    // AC-2 / REQ-2: identity comparisons use trimmed uppercase values.
+    [Fact]
+    public void Matches_records_that_differ_only_by_case_or_whitespace()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: " t-1 ", account: " acc-001 ", instrument: " ibm.n ", currency: " usd ")],
+            [Build.Position(account: "ACC-001", instrument: "IBM.N", currency: "USD")],
+            [Build.Settlement(account: "ACC-001", instrument: "IBM.N", currency: "USD")]);
+
+        var matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.Matched, matched.Status);
+        Assert.Equal("T-1", matched.TradeId);
+        Assert.Equal("ACC-001", matched.Account);
+        Assert.Equal("IBM.N", matched.Instrument);
+        Assert.Equal("USD", matched.Currency);
+        Assert.Empty(result.OpenBreaks);
+    }
+
+    // AC-3 / INV-1: the first occurrence of a trade id is canonical, later ones break.
+    [Fact]
+    public void Treats_first_trade_id_occurrence_as_canonical_and_breaks_later_duplicates()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "t-1")],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Equal(2, result.TotalTradesRead);
+        Assert.Equal(1, result.CanonicalTradeCount);
+        Assert.Equal(1, result.DuplicateTradeCount);
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+        Assert.Equal(BreakReasons.DuplicateTradeId, Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    // AC-4 / REQ-3: each tolerance is an inclusive closed interval.
+    [Theory]
+    [InlineData("100.01", "100", "12500", null)]
+    [InlineData("100", "100.02", "12500", null)]
+    [InlineData("100", "100", "12505", null)]
+    [InlineData("100.02", "100", "12500", BreakReasons.PositionQuantityOutOfTolerance)]
+    [InlineData("100", "100.03", "12500", BreakReasons.SettlementQuantityOutOfTolerance)]
+    [InlineData("100", "100", "12505.01", BreakReasons.SettlementAmountOutOfTolerance)]
+    public void Applies_each_tolerance_as_a_closed_interval(
+        string positionQuantity,
+        string settlementQuantity,
+        string settlementCash,
+        string? expectedBreakReason)
+    {
+        var result = Reconcile(
+            [Build.Trade(quantity: 100m, netAmount: 12500m)],
+            [Build.Position(quantity: Amount(positionQuantity))],
+            [Build.Settlement(quantity: Amount(settlementQuantity), cashAmount: Amount(settlementCash))]);
+
+        if (expectedBreakReason is null)
+        {
+            Assert.Single(result.MatchedTrades);
+            Assert.Empty(result.OpenBreaks);
+        }
+        else
+        {
+            Assert.Empty(result.MatchedTrades);
+            Assert.Equal(expectedBreakReason, Assert.Single(result.OpenBreaks).Reasons);
+        }
+    }
+
+    [Fact]
+    public void Honours_caller_supplied_tolerances()
+    {
+        var engine = new MatchingEngine(new ReconciliationOptions { SettlementAmountTolerance = 10m });
+
+        var result = engine.Reconcile(
+            [Build.Trade(quantity: 100m, netAmount: 12500m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 12510m)],
+            []);
+
+        Assert.Single(result.MatchedTrades);
+    }
+
+    // AC-5 / REQ-3: non-positive quantity or net amount always breaks.
+    [Theory]
+    [InlineData("0", "12500")]
+    [InlineData("-100", "12500")]
+    [InlineData("100", "0")]
+    [InlineData("100", "-12500")]
+    public void Breaks_non_positive_trades_even_when_counterparts_exist(string quantityText, string netAmountText)
+    {
+        var quantity = Amount(quantityText);
+        var netAmount = Amount(netAmountText);
+
+        var result = Reconcile(
+            [Build.Trade(quantity: quantity, netAmount: netAmount)],
+            [Build.Position(quantity: quantity)],
+            [Build.Settlement(quantity: quantity, cashAmount: netAmount)]);
+
+        Assert.Empty(result.MatchedTrades);
+        var openBreak = Assert.Single(result.OpenBreaks);
+        Assert.Equal(BreakReasons.TradeValueOutOfBounds, openBreak.Reasons);
+        Assert.False(openBreak.CanManualOverride);
+    }
+
+    // INV-2: identity must agree before any tolerance check can apply.
+    [Theory]
+    [InlineData("ACC-999", "IBM.N", "USD", BreakReasons.MissingPosition + "|" + BreakReasons.MissingSettlement)]
+    [InlineData("ACC-001", "IBM.N", "EUR", BreakReasons.PositionCurrencyMismatch + "|" + BreakReasons.SettlementCurrencyMismatch)]
+    public void Requires_identity_agreement_before_tolerances(string account, string instrument, string currency, string expectedReasons)
+    {
+        var result = Reconcile(
+            [Build.Trade(account: account, instrument: instrument, currency: currency)],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Equal(expectedReasons, Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    [Fact]
+    public void Requires_settlement_date_agreement_before_tolerances()
+    {
+        var result = Reconcile(
+            [Build.Trade(settlementDate: new DateTime(2025, 3, 18))],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Equal(
+            BreakReasons.PositionSettlementDateMismatch + "|" + BreakReasons.SettlementDateMismatch,
+            Assert.Single(result.OpenBreaks).Reasons);
+    }
+
+    [Fact]
+    public void Does_not_reuse_a_counterpart_across_two_trades()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "T-2")],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Single(result.MatchedTrades);
+        var openBreak = Assert.Single(result.OpenBreaks);
+        Assert.Equal("T-2", openBreak.TradeId);
+        Assert.Equal(
+            BreakReasons.MissingPosition + "|" + BreakReasons.MissingSettlement,
+            openBreak.Reasons);
+    }
+
+    // AC-6 / INV-3: an override cannot manufacture a missing counterpart.
+    [Fact]
+    public void Override_cannot_resolve_a_break_without_concrete_counterparts()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            positions: [],
+            settlements: [],
+            overrides: [Build.Override(tradeId: "T-1")]);
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Equal("T-1", Assert.Single(result.OpenBreaks).TradeId);
+        Assert.Equal("T-1", Assert.Single(result.StaleOverrides).TradeId);
+    }
+
+    // AC-7 / AMB-2: only the first override may apply; later instructions are stale.
+    [Fact]
+    public void Applies_only_the_first_override_and_reports_later_instructions_as_stale()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 12600m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 12500m)],
+            [
+                Build.Override(tradeId: "T-1", action: "ForceMatch", note: "First instruction"),
+                Build.Override(tradeId: "T-1", action: "ForceMatch", note: "Superseded duplicate instruction")
+            ]);
+
+        var matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.ManualOverrideMatched, matched.Status);
+        Assert.Equal("First instruction", matched.OverrideNote);
+        Assert.Empty(result.OpenBreaks);
+
+        var stale = Assert.Single(result.StaleOverrides);
+        Assert.Equal("Superseded duplicate instruction", stale.Note);
+    }
+
+    // REQ-4: a suppressed break stays evidenced in matched-trades.csv.
+    [Fact]
+    public void Suppressed_break_remains_evidenced_with_its_counterpart_identifiers()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 12600m)],
+            [Build.Position(positionId: "P-9")],
+            [Build.Settlement(settlementId: "S-9", cashAmount: 12500m)],
+            [Build.Override(tradeId: "T-1", action: "SuppressBreak", note: "FX leg booked in broker mirror")]);
+
+        var matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.ManualOverrideSuppressed, matched.Status);
+        Assert.Equal("FX leg booked in broker mirror", matched.OverrideNote);
+        Assert.Equal("P-9", matched.PositionId);
+        Assert.Equal("S-9", matched.SettlementId);
+        Assert.Equal(0, result.MatchedCount);
+        Assert.Equal(1, result.ManualOverrideSuppressedCount);
+    }
+
+    [Theory]
+    [InlineData("", "ops-manager")]
+    [InlineData("   ", "ops-manager")]
+    [InlineData("Reviewed", "")]
+    [InlineData("Reviewed", "   ")]
+    public void Rejects_overrides_without_a_note_and_an_approver(string note, string approvedBy)
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 12600m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 12500m)],
+            [Build.Override(tradeId: "T-1", note: note, approvedBy: approvedBy)]);
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Single(result.OpenBreaks);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void Reports_an_unknown_override_action_as_stale_and_keeps_the_break()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 12600m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 12500m)],
+            [Build.Override(tradeId: "T-1", action: "CloseQuietly")]);
+
+        Assert.Empty(result.MatchedTrades);
+        Assert.Single(result.OpenBreaks);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void Reports_an_override_for_a_trade_that_never_broke_as_stale()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1")],
+            [Build.Position()],
+            [Build.Settlement()],
+            [Build.Override(tradeId: "T-1")]);
+
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void Accepts_override_actions_regardless_of_case()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-1", netAmount: 12600m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 12500m)],
+            [Build.Override(tradeId: " t-1 ", action: " forcematch ")]);
+
+        Assert.Equal(MatchStatuses.ManualOverrideMatched, Assert.Single(result.MatchedTrades).Status);
+        Assert.Empty(result.OpenBreaks);
+    }
+
+    // INV-1: every canonical trade is accounted for exactly once.
+    [Fact]
+    public void Accounts_for_every_trade_row_exactly_once()
+    {
+        var trades = new[]
+        {
+            Build.Trade(tradeId: "T-1"),
+            Build.Trade(tradeId: "T-2", account: "ACC-002", instrument: "VOD.L", currency: "GBP", netAmount: 10250m),
+            Build.Trade(tradeId: "T-1")
+        };
+
+        var result = Reconcile(trades, [Build.Position()], [Build.Settlement()]);
+
+        Assert.Equal(trades.Length, result.MatchedTrades.Count + result.OpenBreaks.Count);
+        Assert.Equal(trades.Length, result.TotalTradesRead);
+    }
+
+    [Fact]
+    public void Orders_output_collections_deterministically_by_trade_id()
+    {
+        var result = Reconcile(
+            [Build.Trade(tradeId: "T-3"), Build.Trade(tradeId: "T-1"), Build.Trade(tradeId: "T-2")],
+            positions: [],
+            settlements: []);
+
+        Assert.Equal(["T-1", "T-2", "T-3"], result.OpenBreaks.Select(record => record.TradeId));
+    }
+}
