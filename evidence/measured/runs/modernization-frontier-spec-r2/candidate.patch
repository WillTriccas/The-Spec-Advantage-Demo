+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Reporting;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>REQ-5: the end-of-day report layout is part of the output contract.</summary>
+public sealed class EndOfDayReporterTests
+{
+    private readonly EndOfDayReporter _reporter = new();
+
+    [Fact]
+    public void Reports_none_when_there_are_no_open_breaks()
+    {
+        var report = _reporter.BuildReport(new DateTime(2025, 3, 17), new ReconciliationResult());
+
+        Assert.Equal(
+            "Legacy Trade Reconciliation - End Of Day Report\n"
+            + "Business Date: 2025-03-17\n"
+            + "\n"
+            + "Totals\n"
+            + "------\n"
+            + "Trades Read: 0\n"
+            + "Canonical Trades: 0\n"
+            + "Matched: 0\n"
+            + "Manual Override Matched: 0\n"
+            + "Manual Override Suppressed: 0\n"
+            + "Open Breaks: 0\n"
+            + "Duplicate Trades: 0\n"
+            + "Stale Overrides: 0\n"
+            + "\n"
+            + "Open Break Reasons\n"
+            + "------------------\n"
+            + "None\n",
+            report);
+    }
+
+    [Fact]
+    public void Aggregates_compound_break_reasons_in_ordinal_order()
+    {
+        var result = new ReconciliationResult
+        {
+            OpenBreaks =
+            [
+                new BreakRecord { TradeId = "T-1", Reasons = "SettlementDateMismatch|MissingPosition" },
+                new BreakRecord { TradeId = "T-2", Reasons = "MissingPosition" }
+            ]
+        };
+
+        var report = _reporter.BuildReport(new DateTime(2025, 3, 17), result);
+
+        Assert.Contains("MissingPosition: 2\nSettlementDateMismatch: 1\n", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Lists_stale_overrides_with_the_approver_for_audit()
+    {
+        var result = new ReconciliationResult
+        {
+            StaleOverrides =
+            [
+                new ManualOverrideRecord { TradeId = "T-9", Action = "ForceMatch", ApprovedBy = "ops-manager" }
+            ]
+        };
+
+        var report = _reporter.BuildReport(new DateTime(2025, 3, 17), result);
+
+        Assert.Contains("Stale Overrides: 1\n", report, StringComparison.Ordinal);
+        Assert.Contains("T-9: ForceMatch (ops-manager)\n", report, StringComparison.Ordinal);
+        Assert.EndsWith("\n", report, StringComparison.Ordinal);
+    }
+}
