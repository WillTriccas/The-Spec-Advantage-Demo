+namespace TradeReconciliation.Core.Diagnostics;
+
+/// <summary>
+/// Operational diagnostics sink. Implementations must emit dates, identifiers,
+/// and counts only - never trade, position, settlement, or override payloads.
+/// </summary>
+public interface IBatchLogger
+{
+    void Info(string message);
+
+    void Error(string message);
+}
+
+/// <summary>Writes progress to stdout and failures to stderr.</summary>
+public sealed class ConsoleBatchLogger : IBatchLogger
+{
+    public static ConsoleBatchLogger Instance { get; } = new();
+
+    public void Info(string message) => Console.Out.WriteLine(message);
+
+    public void Error(string message) => Console.Error.WriteLine(message);
+}
+
+/// <summary>Discards diagnostics; useful for in-process tests.</summary>
+public sealed class NullBatchLogger : IBatchLogger
+{
+    public static NullBatchLogger Instance { get; } = new();
+
+    public void Info(string message)
+    {
+    }
+
+    public void Error(string message)
+    {
+    }
+}
