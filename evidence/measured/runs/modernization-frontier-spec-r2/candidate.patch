diff --git a/src/TradeReconciliation.Core/Matching/MatchingEngine.cs b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
new file mode 100644
index 0000000..39fe22f
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/MatchingEngine.cs
@@ -0,0 +1,361 @@
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+using static TradeReconciliation.Core.Matching.TextNormalization;
+
+namespace TradeReconciliation.Core.Matching;
+
+/// <summary>
+/// Reconciles trades against positions and settlements, then applies manual
+/// overrides. The rules here are a faithful port of the legacy .NET Framework
+/// engine; every ordering, tolerance, and reason string is part of the
+/// observable output contract.
+/// </summary>
+public sealed class MatchingEngine : IMatchingEngine
+{
+    private readonly ReconciliationOptions _options;
+
+    public MatchingEngine()
+        : this(ReconciliationOptions.Default)
+    {
+    }
+
+    public MatchingEngine(ReconciliationOptions options) =>
+        _options = options ?? throw new ArgumentNullException(nameof(options));
+
+    public ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord> trades,
+        IReadOnlyCollection<PositionRecord> positions,
+        IReadOnlyCollection<SettlementRecord> settlements,
+        IReadOnlyCollection<ManualOverrideRecord> overrides)
+    {
+        ArgumentNullException.ThrowIfNull(trades);
+        ArgumentNullException.ThrowIfNull(positions);
+        ArgumentNullException.ThrowIfNull(settlements);
+        ArgumentNullException.ThrowIfNull(overrides);
+
+        var matchedTrades = new List<MatchedTradeRecord>();
+        var breakQueue = new List<BreakRecord>();
+        var staleOverrides = new List<ManualOverrideRecord>();
+
+        // Only the first override instruction per trade can ever apply; later
+        // instructions stay visible as stale evidence (INV-3, AMB-2).
+        var overrideGroups = overrides
+            .GroupBy(record => Normalize(record.TradeId), StringComparer.Ordinal)
+            .ToList();
+        var overrideMap = overrideGroups.ToDictionary(
+            group => group.Key,
+            group => group.First(),
+            StringComparer.Ordinal);
+        staleOverrides.AddRange(overrideGroups.SelectMany(group => group.Skip(1)));
+
+        var positionsByPair = positions
+            .GroupBy(position => BuildPairKey(position.Account, position.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(position => position.PositionId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        var settlementsByPair = settlements
+            .GroupBy(settlement => BuildPairKey(settlement.Account, settlement.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(settlement => settlement.SettlementId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        var usedPositions = new HashSet<string>(StringComparer.Ordinal);
+        var usedSettlements = new HashSet<string>(StringComparer.Ordinal);
+        var seenTradeIds = new HashSet<string>(StringComparer.Ordinal);
+        var duplicateTradeCount = 0;
+
+        foreach (var trade in trades)
+        {
+            var normalizedTradeId = Normalize(trade.TradeId);
+            if (!seenTradeIds.Add(normalizedTradeId))
+            {
+                duplicateTradeCount++;
+                breakQueue.Add(CreateBreak(trade, BreakReasons.DuplicateTradeId, null, null, false));
+                continue;
+            }
+
+            if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+            {
+                breakQueue.Add(CreateBreak(trade, BreakReasons.TradeValueOutOfBounds, null, null, false));
+                continue;
+            }
+
+            var pairKey = BuildPairKey(trade.Account, trade.Instrument);
+            var reasons = new List<string>();
+
+            PositionRecord? position = null;
+            if (!positionsByPair.TryGetValue(pairKey, out var positionCandidates))
+            {
+                reasons.Add(BreakReasons.MissingPosition);
+            }
+            else
+            {
+                position = FindPosition(trade, positionCandidates, usedPositions, reasons);
+            }
+
+            SettlementRecord? settlement = null;
+            if (!settlementsByPair.TryGetValue(pairKey, out var settlementCandidates))
+            {
+                reasons.Add(BreakReasons.MissingSettlement);
+            }
+            else
+            {
+                settlement = FindSettlement(trade, settlementCandidates, usedSettlements, reasons);
+            }
+
+            if (reasons.Count == 0 && position is not null && settlement is not null)
+            {
+                usedPositions.Add(position.PositionId);
+                usedSettlements.Add(settlement.SettlementId);
+                matchedTrades.Add(CreateMatchedTrade(trade, MatchStatuses.Matched, position.PositionId, settlement.SettlementId, null));
+                continue;
+            }
+
+            breakQueue.Add(CreateBreak(
+                trade,
+                string.Join("|", reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal)),
+                position?.PositionId ?? GetNearestPositionId(trade, positionCandidates),
+                settlement?.SettlementId ?? GetNearestSettlementId(trade, settlementCandidates),
+                positionCandidates is not null
+                    && settlementCandidates is not null
+                    && reasons.All(reason => !BreakReasons.BlocksManualOverride(reason))));
+        }
+
+        var resolvedTrades = ApplyOverrides(matchedTrades, breakQueue, staleOverrides, overrideMap);
+
+        staleOverrides.AddRange(overrides.Where(record =>
+            !resolvedTrades.Contains(Normalize(record.TradeId)) && !staleOverrides.Contains(record)));
+
+        return new ReconciliationResult
+        {
+            MatchedTrades = matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            OpenBreaks = breakQueue.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            StaleOverrides = staleOverrides.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            TotalTradesRead = trades.Count,
+            CanonicalTradeCount = seenTradeIds.Count,
+            DuplicateTradeCount = duplicateTradeCount,
+            MatchedCount = matchedTrades.Count(record => record.Status == MatchStatuses.Matched),
+            ManualOverrideMatchedCount = matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideMatched),
+            ManualOverrideSuppressedCount = matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideSuppressed)
+        };
+    }
+
+    /// <summary>
+    /// Applies at most one override per break. An override can only resolve a
+    /// break that already has concrete position and settlement counterparts, and
+    /// an applied override stays evidenced in <c>matched-trades.csv</c>.
+    /// </summary>
+    private static HashSet<string> ApplyOverrides(
+        List<MatchedTradeRecord> matchedTrades,
+        List<BreakRecord> breakQueue,
+        List<ManualOverrideRecord> staleOverrides,
+        Dictionary<string, ManualOverrideRecord> overrideMap)
+    {
+        var resolvedTrades = new HashSet<string>(StringComparer.Ordinal);
+
+        foreach (var breakRecord in breakQueue.ToList())
+        {
+            if (!overrideMap.TryGetValue(Normalize(breakRecord.TradeId), out var manualOverride))
+            {
+                continue;
+            }
+
+            resolvedTrades.Add(Normalize(breakRecord.TradeId));
+
+            if (!breakRecord.CanManualOverride
+                || string.IsNullOrWhiteSpace(manualOverride.Note)
+                || string.IsNullOrWhiteSpace(manualOverride.ApprovedBy))
+            {
+                staleOverrides.Add(manualOverride);
+                continue;
+            }
+
+            var status = Normalize(manualOverride.Action) switch
+            {
+                OverrideActions.ForceMatch => MatchStatuses.ManualOverrideMatched,
+                OverrideActions.SuppressBreak => MatchStatuses.ManualOverrideSuppressed,
+                _ => null
+            };
+
+            if (status is null)
+            {
+                staleOverrides.Add(manualOverride);
+                continue;
+            }
+
+            matchedTrades.Add(CreateMatchedTrade(
+                new TradeRecord
+                {
+                    TradeId = breakRecord.TradeId,
+                    Account = breakRecord.Account,
+                    Instrument = breakRecord.Instrument,
+                    Quantity = breakRecord.Quantity,
+                    SettlementDate = breakRecord.SettlementDate,
+                    Currency = breakRecord.Currency
+                },
+                status,
+                breakRecord.PositionId,
+                breakRecord.SettlementId,
+                manualOverride.Note));
+            breakQueue.Remove(breakRecord);
+        }
+
+        return resolvedTrades;
+    }
+
+    private PositionRecord? FindPosition(
+        TradeRecord trade,
+        IEnumerable<PositionRecord> candidates,
+        HashSet<string> usedPositions,
+        List<string> reasons)
+    {
+        var available = candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingPosition);
+            return null;
+        }
+
+        var sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionSettlementDateMismatch);
+            return null;
+        }
+
+        var sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionCurrencyMismatch);
+            return null;
+        }
+
+        var candidatePosition = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.PositionQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _options.PositionQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.PositionQuantityOutOfTolerance);
+            return null;
+        }
+
+        return candidatePosition;
+    }
+
+    private SettlementRecord? FindSettlement(
+        TradeRecord trade,
+        IEnumerable<SettlementRecord> candidates,
+        HashSet<string> usedSettlements,
+        List<string> reasons)
+    {
+        var available = candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingSettlement);
+            return null;
+        }
+
+        var sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementDateMismatch);
+            return null;
+        }
+
+        var sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementCurrencyMismatch);
+            return null;
+        }
+
+        var candidateSettlement = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.SettlementQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _options.SettlementQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementQuantityOutOfTolerance);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _options.SettlementAmountTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementAmountOutOfTolerance);
+            return null;
+        }
+
+        return candidateSettlement;
+    }
+
+    private static string? GetNearestPositionId(TradeRecord trade, IEnumerable<PositionRecord>? candidates) =>
+        candidates?
+            .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .Select(candidate => candidate.PositionId)
+            .FirstOrDefault();
+
+    private static string? GetNearestSettlementId(TradeRecord trade, IEnumerable<SettlementRecord>? candidates) =>
+        candidates?
+            .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .Select(candidate => candidate.SettlementId)
+            .FirstOrDefault();
+
+    private static BreakRecord CreateBreak(
+        TradeRecord trade,
+        string reasons,
+        string? positionId,
+        string? settlementId,
+        bool canManualOverride) => new()
+        {
+            TradeId = Normalize(trade.TradeId),
+            Account = Normalize(trade.Account),
+            Instrument = Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = Normalize(trade.Currency),
+            Reasons = reasons,
+            PositionId = positionId,
+            SettlementId = settlementId,
+            CanManualOverride = canManualOverride
+        };
+
+    private static MatchedTradeRecord CreateMatchedTrade(
+        TradeRecord trade,
+        string status,
+        string? positionId,
+        string? settlementId,
+        string? note) => new()
+        {
+            TradeId = Normalize(trade.TradeId),
+            Status = status,
+            Account = Normalize(trade.Account),
+            Instrument = Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = Normalize(trade.Currency),
+            PositionId = positionId,
+            SettlementId = settlementId,
+            OverrideNote = note
+        };
+}
diff --git a/src/TradeReconciliation.Core/Matching/TextNormalization.cs b/src/TradeReconciliation.Core/Matching/TextNormalization.cs
new file mode 100644
index 0000000..9c7cb87
--- /dev/null
+++ b/src/TradeReconciliation.Core/Matching/TextNormalization.cs
@@ -0,0 +1,16 @@
+namespace TradeReconciliation.Core.Matching;
+
+/// <summary>
+/// Canonical text normalization for identity comparisons: account, instrument,
+/// currency, trade identifier, and override action are all compared on trimmed
+/// uppercase values.
+/// </summary>
+public static class TextNormalization
+{
+    public static string Normalize(string? value) =>
+        (value ?? string.Empty).Trim().ToUpperInvariant();
+
+    /// <summary>Account and instrument pair key used to bucket counterpart candidates.</summary>
+    public static string BuildPairKey(string? account, string? instrument) =>
+        Normalize(account) + "|" + Normalize(instrument);
+}
diff --git a/src/TradeReconciliation.Core/Persistence/CsvFileGateway.cs b/src/TradeReconciliation.Core/Persistence/CsvFileGateway.cs
new file mode 100644
index 0000000..1717d79
--- /dev/null
+++ b/src/TradeReconciliation.Core/Persistence/CsvFileGateway.cs
@@ -0,0 +1,237 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Persistence;
+
+/// <summary>
+/// File-system implementation of the reconciliation storage ports. Input parsing
+/// is strict and reports actionable, payload-free diagnostics; output writing is
+/// byte-deterministic.
+/// </summary>
+public sealed class CsvFileGateway : IReconciliationInputStore, IReconciliationOutputStore
+{
+    internal const string MatchedTradesHeader =
+        "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+
+    internal const string BreakQueueHeader =
+        "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+    public IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Trades, 7, cells => new TradeRecord
+        {
+            TradeId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5],
+            NetAmount = ParseDecimal(cells[6])
+        });
+
+    public IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Positions, 6, cells => new PositionRecord
+        {
+            PositionId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5]
+        });
+
+    public IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory) =>
+        ReadRequired(inputDirectory, BatchFileNames.Settlements, 7, cells => new SettlementRecord
+        {
+            SettlementId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = ParseDecimal(cells[3]),
+            SettlementDate = ParseDate(cells[4]),
+            Currency = cells[5],
+            CashAmount = ParseDecimal(cells[6])
+        });
+
+    /// <summary>Overrides are optional: an absent file simply means no instructions.</summary>
+    public IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory)
+    {
+        var path = Path.Combine(inputDirectory, BatchFileNames.Overrides);
+        if (!File.Exists(path))
+        {
+            return [];
+        }
+
+        return ParseLines(File.ReadAllLines(path), BatchFileNames.Overrides, 4, cells => new ManualOverrideRecord
+        {
+            TradeId = cells[0],
+            Action = cells[1],
+            Note = cells[2],
+            ApprovedBy = cells[3]
+        });
+    }
+
+    public string CalculateInputSignature(DateTime businessDate, string inputDirectory)
+    {
+        EnsureInputDirectory(inputDirectory);
+
+        var payload = new StringBuilder();
+        Append(payload, OutputFormat.FormatDate(businessDate));
+
+        foreach (var filePath in Directory.GetFiles(inputDirectory).OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
+        {
+            Append(payload, Path.GetFileName(filePath));
+            Append(payload, File.ReadAllText(filePath));
+        }
+
+        var hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+        return Convert.ToHexString(hash).ToLowerInvariant();
+
+        static void Append(StringBuilder builder, string value) =>
+            builder.Append(value).Append(OutputFormat.LineSeparatorChar);
+    }
+
+    public void EnsureOutputDirectory(string outputDirectory) =>
+        Directory.CreateDirectory(outputDirectory);
+
+    public bool ResultFilesExist(string outputDirectory) =>
+        File.Exists(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades))
+        && File.Exists(Path.Combine(outputDirectory, BatchFileNames.BreakQueue))
+        && File.Exists(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport));
+
+    public void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades)
+    {
+        ArgumentNullException.ThrowIfNull(matchedTrades);
+
+        var lines = new List<string> { MatchedTradesHeader };
+        lines.AddRange(matchedTrades
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ",",
+                record.TradeId,
+                record.Status,
+                record.Account,
+                record.Instrument,
+                OutputFormat.FormatDecimal(record.Quantity),
+                OutputFormat.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty,
+                record.OverrideNote ?? string.Empty)));
+
+        WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.MatchedTrades), lines);
+    }
+
+    public void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue)
+    {
+        ArgumentNullException.ThrowIfNull(breakQueue);
+
+        var lines = new List<string> { BreakQueueHeader };
+        lines.AddRange(breakQueue
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .ThenBy(record => record.Reasons, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ",",
+                record.TradeId,
+                record.Account,
+                record.Instrument,
+                OutputFormat.FormatDecimal(record.Quantity),
+                OutputFormat.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.Reasons,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty)));
+
+        WriteAllLines(Path.Combine(outputDirectory, BatchFileNames.BreakQueue), lines);
+    }
+
+    public void WriteEndOfDayReport(string outputDirectory, string reportText) =>
+        File.WriteAllText(Path.Combine(outputDirectory, BatchFileNames.EndOfDayReport), reportText);
+
+    private static void WriteAllLines(string path, IEnumerable<string> lines) =>
+        File.WriteAllText(path, OutputFormat.JoinLines(lines));
+
+    private static List<T> ReadRequired<T>(string inputDirectory, string fileName, int expectedCellCount, Func<string[], T> map)
+    {
+        EnsureInputDirectory(inputDirectory);
+
+        var path = Path.Combine(inputDirectory, fileName);
+        if (!File.Exists(path))
+        {
+            throw new ReconciliationInputException(
+                $"Required input file '{fileName}' was not found in '{inputDirectory}'.");
+        }
+
+        return ParseLines(File.ReadAllLines(path), fileName, expectedCellCount, map);
+    }
+
+    private static List<T> ParseLines<T>(IReadOnlyList<string> allLines, string fileName, int expectedCellCount, Func<string[], T> map)
+    {
+        var records = new List<T>();
+
+        // Line 1 is the header; line numbers below are 1-based for operators.
+        for (var index = 1; index < allLines.Count; index++)
+        {
+            var line = allLines[index];
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            var cells = SplitCells(line, fileName, index + 1, expectedCellCount);
+            try
+            {
+                records.Add(map(cells));
+            }
+            catch (ReconciliationInputException exception)
+            {
+                throw new ReconciliationInputException(
+                    $"Malformed row in '{fileName}' at line {index + 1}: {exception.Message}",
+                    exception);
+            }
+        }
+
+        return records;
+    }
+
+    private static string[] SplitCells(string line, string fileName, int lineNumber, int expectedCellCount)
+    {
+        var cells = line.Split(',');
+        if (cells.Length != expectedCellCount)
+        {
+            throw new ReconciliationInputException(
+                $"Malformed row in '{fileName}' at line {lineNumber}: expected {expectedCellCount} columns but found {cells.Length}.");
+        }
+
+        for (var index = 0; index < cells.Length; index++)
+        {
+            cells[index] = cells[index].Trim();
+        }
+
+        return cells;
+    }
+
+    private static void EnsureInputDirectory(string inputDirectory)
+    {
+        if (!Directory.Exists(inputDirectory))
+        {
+            throw new ReconciliationInputException($"Input directory '{inputDirectory}' does not exist.");
+        }
+    }
+
+    private static decimal ParseDecimal(string value) =>
+        decimal.TryParse(value, NumberStyles.Number | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var parsed)
+            ? parsed
+            : throw new ReconciliationInputException($"Expected an invariant decimal number but found '{Describe(value)}'.");
+
+    private static DateTime ParseDate(string value) =>
+        DateTime.TryParseExact(value, OutputFormat.DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
+            ? parsed
+            : throw new ReconciliationInputException($"Expected a {OutputFormat.DateFormat} date but found '{Describe(value)}'.");
+
+    /// <summary>Truncates an offending cell so diagnostics never carry a full payload.</summary>
+    private static string Describe(string value) =>
+        value.Length <= 16 ? value : value[..16] + "...";
+}
diff --git a/src/TradeReconciliation.Core/Persistence/CsvRunLedgerStore.cs b/src/TradeReconciliation.Core/Persistence/CsvRunLedgerStore.cs
