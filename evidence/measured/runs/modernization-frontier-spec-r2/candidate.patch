@@ -0,0 +1,156 @@
+using TradeReconciliation.Core.Batch;
+using TradeReconciliation.Core.Diagnostics;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+using TradeReconciliation.Core.Persistence;
+using TradeReconciliation.Core.Reporting;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// NFR-2: the orchestration is exercised through in-memory ports, with no file
+/// system involved, so rerun and write behaviour can be asserted directly.
+/// </summary>
+public sealed class ReconciliationBatchTests
+{
+    private static readonly DateTime BusinessDate = new(2025, 3, 17);
+
+    [Fact]
+    public void Writes_all_results_and_records_the_run_on_a_first_pass()
+    {
+        var storage = new FakeStorage();
+        var outcome = CreateBatch(storage).Execute(Request());
+
+        Assert.False(outcome.RerunDetected);
+        Assert.True(storage.OutputDirectoryCreated);
+        Assert.Equal(1, storage.MatchedWrites);
+        Assert.Equal(1, storage.BreakWrites);
+        Assert.Equal(1, storage.ReportWrites);
+        var entry = Assert.Single(storage.LedgerEntries);
+        Assert.Equal(FakeStorage.Signature, entry.InputSignature);
+    }
+
+    // INV-4 / AC-9: an exact rerun retains outputs and adds no ledger history.
+    [Fact]
+    public void Skips_work_when_an_identical_run_is_already_recorded()
+    {
+        var storage = new FakeStorage();
+        var batch = CreateBatch(storage);
+
+        batch.Execute(Request());
+        var outcome = batch.Execute(Request());
+
+        Assert.True(outcome.RerunDetected);
+        Assert.Null(outcome.Result);
+        Assert.Equal(1, storage.MatchedWrites);
+        Assert.Single(storage.LedgerEntries);
+    }
+
+    // A ledger hit is not enough: the result files must still be on disk.
+    [Fact]
+    public void Reruns_the_reconciliation_when_previous_result_files_are_gone()
+    {
+        var storage = new FakeStorage();
+        var batch = CreateBatch(storage);
+
+        batch.Execute(Request());
+        storage.ResultFilesPresent = false;
+        var outcome = batch.Execute(Request());
+
+        Assert.False(outcome.RerunDetected);
+        Assert.Equal(2, storage.MatchedWrites);
+        Assert.Single(storage.LedgerEntries);
+    }
+
+    // NFR-5: diagnostics carry dates and counts only, never payloads.
+    [Fact]
+    public void Logs_counts_without_leaking_record_payloads()
+    {
+        var storage = new FakeStorage();
+        var logger = new RecordingLogger();
+
+        CreateBatch(storage, logger).Execute(Request());
+
+        var log = string.Join("\n", logger.Messages);
+        Assert.Contains("Loaded 1 trades", log, StringComparison.Ordinal);
+        Assert.Contains("Processed 1 trades", log, StringComparison.Ordinal);
+        Assert.DoesNotContain("ACC-001", log, StringComparison.Ordinal);
+        Assert.DoesNotContain("IBM.N", log, StringComparison.Ordinal);
+        Assert.DoesNotContain(FakeStorage.Signature, log, StringComparison.Ordinal);
+    }
+
+    private static ReconciliationBatch CreateBatch(FakeStorage storage, IBatchLogger? logger = null) =>
+        new(storage, storage, storage, new MatchingEngine(), new EndOfDayReporter(), logger ?? NullBatchLogger.Instance);
+
+    private static RunRequest Request() => new()
+    {
+        BusinessDate = BusinessDate,
+        InputDirectory = "in-memory-input",
+        OutputDirectory = "in-memory-output"
+    };
+
+    private sealed class FakeStorage : IReconciliationInputStore, IReconciliationOutputStore, IRunLedgerStore
+    {
+        public const string Signature = "fake-signature";
+
+        public bool OutputDirectoryCreated { get; private set; }
+
+        public bool ResultFilesPresent { get; set; }
+
+        public int MatchedWrites { get; private set; }
+
+        public int BreakWrites { get; private set; }
+
+        public int ReportWrites { get; private set; }
+
+        public List<RunLedgerEntry> LedgerEntries { get; } = [];
+
+        public IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory) => [Build.Trade()];
+
+        public IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory) => [Build.Position()];
+
+        public IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory) => [Build.Settlement()];
+
+        public IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory) => [];
+
+        public string CalculateInputSignature(DateTime businessDate, string inputDirectory) => Signature;
+
+        public void EnsureOutputDirectory(string outputDirectory) => OutputDirectoryCreated = true;
+
+        public bool ResultFilesExist(string outputDirectory) => ResultFilesPresent;
+
+        public void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades)
+        {
+            MatchedWrites++;
+            ResultFilesPresent = true;
+        }
+
+        public void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue) => BreakWrites++;
+
+        public void WriteEndOfDayReport(string outputDirectory, string reportText) => ReportWrites++;
+
+        public bool Contains(string outputDirectory, DateTime businessDate, string inputSignature) =>
+            LedgerEntries.Any(entry =>
+                entry.BusinessDate == businessDate
+                && string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal));
+
+        public void AppendIfMissing(string outputDirectory, RunLedgerEntry entry)
+        {
+            if (!Contains(outputDirectory, entry.BusinessDate, entry.InputSignature))
+            {
+                LedgerEntries.Add(entry);
+            }
+        }
+    }
+
+    private sealed class RecordingLogger : IBatchLogger
+    {
+        public List<string> Messages { get; } = [];
+
+        public void Info(string message) => Messages.Add(message);
+
+        public void Error(string message) => Messages.Add(message);
+    }
+}
