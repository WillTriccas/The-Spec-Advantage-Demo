+using TradeReconciliation.Core;
+using TradeReconciliation.Core.Batch;
+using TradeReconciliation.Core.Configuration;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>REQ-1 / NFR-3: the external command contract and its exit codes.</summary>
+public sealed class CommandLineTests
+{
+    [Fact]
+    public void Resolves_the_three_positional_arguments()
+    {
+        var input = TestPaths.CreateTemporaryDirectory("cli-input");
+        var output = TestPaths.CreateTemporaryDirectory("cli-output");
+
+        var request = RunRequest.Resolve(["2025-03-17", input, output]);
+
+        Assert.Equal(new DateTime(2025, 3, 17), request.BusinessDate);
+        Assert.Equal(Path.GetFullPath(input), request.InputDirectory);
+        Assert.Equal(Path.GetFullPath(output), request.OutputDirectory);
+    }
+
+    [Fact]
+    public void Falls_back_to_the_packaged_sample_data_when_no_arguments_are_supplied()
+    {
+        var request = RunRequest.Resolve(null);
+
+        Assert.Equal(new DateTime(2025, 3, 17), request.BusinessDate);
+        Assert.Equal(Path.Combine(AppContext.BaseDirectory, "data", "sample"), request.InputDirectory);
+        Assert.Equal(Path.Combine(AppContext.BaseDirectory, "output", "sample"), request.OutputDirectory);
+    }
+
+    [Theory]
+    [InlineData("2025-03-17")]
+    [InlineData("2025-03-17", "input")]
+    [InlineData("2025-03-17", "input", "output", "extra")]
+    public void Rejects_the_wrong_number_of_arguments(params string[] args) =>
+        Assert.Throws<ReconciliationUsageException>(() => RunRequest.Resolve(args));
+
+    [Theory]
+    [InlineData("17-03-2025")]
+    [InlineData("2025/03/17")]
+    [InlineData("not-a-date")]
+    public void Rejects_a_business_date_that_is_not_iso_formatted(string businessDate) =>
+        Assert.Throws<ReconciliationUsageException>(
+            () => RunRequest.Resolve([businessDate, "input", "output"]));
+
+    [Fact]
+    public void Entry_point_returns_success_for_a_valid_run()
+    {
+        var output = TestPaths.CreateTemporaryDirectory("cli-success");
+
+        var exitCode = Cli.Program.Main(["2025-03-17", TestPaths.Fixture("baseline", "input"), output]);
+
+        Assert.Equal(BatchExitCodes.Success, exitCode);
+        Assert.All(
+            BatchFileNames.Outputs,
+            fileName => Assert.True(File.Exists(Path.Combine(output, fileName))));
+    }
+
+    [Fact]
+    public void Entry_point_returns_a_usage_error_for_a_bad_command_line() =>
+        Assert.Equal(BatchExitCodes.UsageError, Cli.Program.Main(["2025-03-17"]));
+
+    [Fact]
+    public void Entry_point_returns_an_input_error_for_a_missing_input_directory()
+    {
+        var output = TestPaths.CreateTemporaryDirectory("cli-input-error");
+        var input = Path.Combine(output, "absent");
+
+        Assert.Equal(BatchExitCodes.InputError, Cli.Program.Main(["2025-03-17", input, output]));
+    }
+}
