+using System.Globalization;
+
+using TradeReconciliation.Core.Configuration;
+
+namespace TradeReconciliation.Core.Batch;
+
+/// <summary>
+/// The external command contract: an optional positional
+/// <c>&lt;business-date&gt; &lt;input-directory&gt; &lt;output-directory&gt;</c> triple.
+/// </summary>
+public sealed class RunRequest
+{
+    public const string Usage =
+        "Usage: LegacyTradeReconciliation [<business-date yyyy-MM-dd> <input-directory> <output-directory>]";
+
+    public required DateTime BusinessDate { get; init; }
+
+    public required string InputDirectory { get; init; }
+
+    public required string OutputDirectory { get; init; }
+
+    /// <summary>
+    /// Resolves the positional command line. With no arguments the batch falls
+    /// back to the packaged sample data, exactly as the legacy executable did.
+    /// </summary>
+    public static RunRequest Resolve(IReadOnlyList<string>? args)
+    {
+        if (args is null || args.Count == 0)
+        {
+            var baseDirectory = AppContext.BaseDirectory;
+            return new RunRequest
+            {
+                BusinessDate = new DateTime(2025, 3, 17, 0, 0, 0, DateTimeKind.Unspecified),
+                InputDirectory = Path.Combine(baseDirectory, "data", "sample"),
+                OutputDirectory = Path.Combine(baseDirectory, "output", "sample")
+            };
+        }
+
+        if (args.Count != 3)
+        {
+            throw new ReconciliationUsageException(
+                $"Expected either no arguments or exactly 3, but received {args.Count}. {Usage}");
+        }
+
+        if (!DateTime.TryParseExact(args[0], OutputFormat.DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var businessDate))
+        {
+            throw new ReconciliationUsageException(
+                $"Business date must use the {OutputFormat.DateFormat} format. {Usage}");
+        }
+
+        if (string.IsNullOrWhiteSpace(args[1]) || string.IsNullOrWhiteSpace(args[2]))
+        {
+            throw new ReconciliationUsageException($"Input and output directories are required. {Usage}");
+        }
+
+        return new RunRequest
+        {
+            BusinessDate = businessDate,
+            InputDirectory = Path.GetFullPath(args[1]),
+            OutputDirectory = Path.GetFullPath(args[2])
+        };
+    }
+}
