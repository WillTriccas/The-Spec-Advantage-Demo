@@ -0,0 +1,42 @@
+namespace TradeReconciliation.Tests;
+
+/// <summary>Locates repository and fixture paths from the test output directory.</summary>
+internal static class TestPaths
+{
+    /// <summary>Fixtures copied next to the test assembly.</summary>
+    public static string FixtureRoot { get; } = Path.Combine(AppContext.BaseDirectory, "Fixtures");
+
+    /// <summary>Candidate root: the directory that holds <c>benchmark-adapter.json</c>.</summary>
+    public static string CandidateRoot { get; } = FindCandidateRoot();
+
+    public static string Fixture(string fixtureName, params string[] segments) =>
+        Path.Combine([FixtureRoot, fixtureName, .. segments]);
+
+    /// <summary>Creates an empty, uniquely named working directory for a test.</summary>
+    public static string CreateTemporaryDirectory(string label)
+    {
+        var directory = Path.Combine(
+            Path.GetTempPath(),
+            "trade-reconciliation-tests",
+            label + "-" + Guid.NewGuid().ToString("N"));
+
+        Directory.CreateDirectory(directory);
+        return directory;
+    }
+
+    private static string FindCandidateRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            if (File.Exists(Path.Combine(directory.FullName, "benchmark-adapter.json")))
+            {
+                return directory.FullName;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new InvalidOperationException("benchmark-adapter.json was not found above the test output directory.");
+    }
+}
