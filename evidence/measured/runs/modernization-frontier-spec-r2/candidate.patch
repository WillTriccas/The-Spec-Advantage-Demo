@@ -0,0 +1,147 @@
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Diagnostics;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Matching;
+using TradeReconciliation.Core.Persistence;
+using TradeReconciliation.Core.Reporting;
+
+namespace TradeReconciliation.Core.Batch;
+
+/// <summary>What a single batch invocation did.</summary>
+/// <param name="RerunDetected">True when an identical prior run was found and outputs were retained.</param>
+/// <param name="Result">The reconciliation result, or <c>null</c> when a rerun was detected.</param>
+public sealed record BatchOutcome(bool RerunDetected, ReconciliationResult? Result);
+
+/// <summary>
+/// Orchestrates a reconciliation run: fingerprint inputs, detect an identical
+/// rerun, reconcile, write the four output files, and record run history.
+/// All storage access goes through injected ports so the orchestration is
+/// testable without the file system.
+/// </summary>
+public sealed class ReconciliationBatch
+{
+    private readonly IReconciliationInputStore _inputStore;
+    private readonly IReconciliationOutputStore _outputStore;
+    private readonly IRunLedgerStore _ledgerStore;
+    private readonly IMatchingEngine _matchingEngine;
+    private readonly IEndOfDayReporter _reporter;
+    private readonly IBatchLogger _logger;
+
+    public ReconciliationBatch(
+        IReconciliationInputStore inputStore,
+        IReconciliationOutputStore outputStore,
+        IRunLedgerStore ledgerStore,
+        IMatchingEngine matchingEngine,
+        IEndOfDayReporter reporter,
+        IBatchLogger logger)
+    {
+        _inputStore = inputStore ?? throw new ArgumentNullException(nameof(inputStore));
+        _outputStore = outputStore ?? throw new ArgumentNullException(nameof(outputStore));
+        _ledgerStore = ledgerStore ?? throw new ArgumentNullException(nameof(ledgerStore));
+        _matchingEngine = matchingEngine ?? throw new ArgumentNullException(nameof(matchingEngine));
+        _reporter = reporter ?? throw new ArgumentNullException(nameof(reporter));
+        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
+    }
+
+    /// <summary>Builds the production wiring used by the console entry point.</summary>
+    public static ReconciliationBatch CreateDefault(
+        ReconciliationOptions? options = null,
+        IBatchLogger? logger = null)
+    {
+        var gateway = new CsvFileGateway();
+        return new ReconciliationBatch(
+            gateway,
+            gateway,
+            new CsvRunLedgerStore(),
+            new MatchingEngine(options ?? ReconciliationOptions.Default),
+            new EndOfDayReporter(),
+            logger ?? ConsoleBatchLogger.Instance);
+    }
+
+    /// <summary>
+    /// Runs the batch for a positional command line and maps any failure to a
+    /// documented, non-success exit code with an actionable diagnostic.
+    /// </summary>
+    public int Run(string[]? args)
+    {
+        RunRequest request;
+        try
+        {
+            request = RunRequest.Resolve(args);
+        }
+        catch (ReconciliationUsageException exception)
+        {
+            _logger.Error("Invalid command line. " + exception.Message);
+            return BatchExitCodes.UsageError;
+        }
+
+        try
+        {
+            Execute(request);
+            return BatchExitCodes.Success;
+        }
+        catch (ReconciliationInputException exception)
+        {
+            _logger.Error("Reconciliation input error. " + exception.Message);
+            return BatchExitCodes.InputError;
+        }
+        catch (IOException exception)
+        {
+            _logger.Error("Reconciliation I/O error. " + exception.Message);
+            return BatchExitCodes.InputError;
+        }
+        catch (UnauthorizedAccessException exception)
+        {
+            _logger.Error("Reconciliation access error. " + exception.Message);
+            return BatchExitCodes.InputError;
+        }
+    }
+
+    /// <summary>Runs the batch for an already validated request, throwing on failure.</summary>
+    public BatchOutcome Execute(RunRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        var businessDate = OutputFormat.FormatDate(request.BusinessDate);
+        _outputStore.EnsureOutputDirectory(request.OutputDirectory);
+
+        var inputSignature = _inputStore.CalculateInputSignature(request.BusinessDate, request.InputDirectory);
+
+        if (_ledgerStore.Contains(request.OutputDirectory, request.BusinessDate, inputSignature)
+            && _outputStore.ResultFilesExist(request.OutputDirectory))
+        {
+            _logger.Info($"Exact rerun detected for {businessDate}. Existing outputs were retained.");
+            return new BatchOutcome(RerunDetected: true, Result: null);
+        }
+
+        var trades = _inputStore.LoadTrades(request.InputDirectory);
+        var positions = _inputStore.LoadPositions(request.InputDirectory);
+        var settlements = _inputStore.LoadSettlements(request.InputDirectory);
+        var overrides = _inputStore.LoadOverrides(request.InputDirectory);
+
+        _logger.Info(
+            $"Loaded {trades.Count} trades, {positions.Count} positions, {settlements.Count} settlements, " +
+            $"and {overrides.Count} override instructions for {businessDate}.");
+
+        var result = _matchingEngine.Reconcile(trades, positions, settlements, overrides);
+
+        _outputStore.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+        _outputStore.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+        _outputStore.WriteEndOfDayReport(request.OutputDirectory, _reporter.BuildReport(request.BusinessDate, result));
+
+        _ledgerStore.AppendIfMissing(request.OutputDirectory, new RunLedgerEntry
+        {
+            BusinessDate = request.BusinessDate,
+            InputSignature = inputSignature,
+            TotalTradesRead = result.TotalTradesRead,
+            OpenBreakCount = result.OpenBreaks.Count,
+            MatchedCount = result.MatchedTrades.Count
+        });
+
+        _logger.Info(
+            $"Processed {result.TotalTradesRead} trades into {result.MatchedTrades.Count} matched rows " +
+            $"and {result.OpenBreaks.Count} open breaks.");
+
+        return new BatchOutcome(RerunDetected: false, Result: result);
+    }
+}
