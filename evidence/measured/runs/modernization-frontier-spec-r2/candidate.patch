@@ -0,0 +1,98 @@
+using System.Text.Json;
+
+using TradeReconciliation.Core.Configuration;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// REQ-7 / AC-10: the benchmark adapter is the only interface an external
+/// evaluator needs, so its shape is asserted here rather than assumed.
+/// </summary>
+public sealed class BenchmarkAdapterTests
+{
+    private static readonly string[] RequiredRunPlaceholders =
+        ["{businessDate}", "{inputDirectory}", "{outputDirectory}"];
+
+    private static readonly char[] ShellMetacharacters =
+        ['&', '|', ';', '>', '<', '`', '$', '\n', '\r', '*', '?'];
+
+    private static readonly JsonDocument Adapter = JsonDocument.Parse(
+        File.ReadAllText(Path.Combine(TestPaths.CandidateRoot, "benchmark-adapter.json")));
+
+    [Fact]
+    public void Declares_a_schema_version_and_a_candidate_relative_working_directory()
+    {
+        Assert.False(string.IsNullOrWhiteSpace(Adapter.RootElement.GetProperty("schemaVersion").GetString()));
+        Assert.Equal(".", Adapter.RootElement.GetProperty("workingDirectory").GetString());
+    }
+
+    [Theory]
+    [InlineData("build")]
+    [InlineData("test")]
+    [InlineData("run")]
+    public void Every_command_is_shell_free_and_accepts_a_documented_exit_code(string commandName)
+    {
+        var command = Adapter.RootElement.GetProperty(commandName);
+
+        var executable = command.GetProperty("executable").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(executable));
+        AssertShellFree(executable!);
+
+        foreach (var argument in Arguments(command))
+        {
+            AssertShellFree(argument);
+        }
+
+        var allowedExitCodes = command.GetProperty("allowedExitCodes")
+            .EnumerateArray()
+            .Select(element => element.GetInt32())
+            .ToList();
+
+        Assert.NotEmpty(allowedExitCodes);
+        Assert.Contains(0, allowedExitCodes);
+    }
+
+    [Fact]
+    public void Run_command_substitutes_every_evaluator_owned_value()
+    {
+        var arguments = Arguments(Adapter.RootElement.GetProperty("run"));
+
+        foreach (var placeholder in RequiredRunPlaceholders)
+        {
+            Assert.Contains(placeholder, arguments);
+        }
+    }
+
+    [Fact]
+    public void Run_command_targets_the_built_candidate_entry_point()
+    {
+        var arguments = Arguments(Adapter.RootElement.GetProperty("run"));
+        var assemblyName = typeof(Cli.Program).Assembly.GetName().Name + ".dll";
+
+        Assert.Contains(arguments, argument => argument.EndsWith(assemblyName, StringComparison.Ordinal));
+    }
+
+    [Fact]
+    public void Declares_exactly_the_four_output_files()
+    {
+        var outputs = Adapter.RootElement.GetProperty("outputs")
+            .EnumerateArray()
+            .Select(element => element.GetString() ?? string.Empty)
+            .ToList();
+
+        Assert.Equal(BatchFileNames.Outputs, outputs);
+    }
+
+    private static List<string> Arguments(JsonElement command) =>
+        command.GetProperty("arguments")
+            .EnumerateArray()
+            .Select(element => element.GetString() ?? string.Empty)
+            .ToList();
+
+    private static void AssertShellFree(string value) =>
+        Assert.True(
+            value.IndexOfAny(ShellMetacharacters) < 0,
+            $"Adapter command token '{value}' must not rely on shell interpretation.");
+}
