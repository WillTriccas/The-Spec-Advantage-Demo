+using TradeReconciliation.Core;
+using TradeReconciliation.Core.Batch;
+using TradeReconciliation.Core.Diagnostics;
+
+namespace TradeReconciliation.Cli;
+
+/// <summary>
+/// Console entry point for the trade reconciliation batch.
+/// </summary>
+/// <remarks>
+/// External contract: <c>LegacyTradeReconciliation &lt;business-date yyyy-MM-dd&gt;
+/// &lt;input-directory&gt; &lt;output-directory&gt;</c>. Exit code 0 means the four
+/// output files are present and current; see <see cref="BatchExitCodes"/> for the
+/// documented failure codes.
+/// </remarks>
+public static class Program
+{
+    public static int Main(string[] args)
+    {
+        try
+        {
+            return ReconciliationBatch.CreateDefault().Run(args);
+        }
+        catch (Exception exception)
+        {
+            ConsoleBatchLogger.Instance.Error(
+                $"Reconciliation failed unexpectedly ({exception.GetType().Name}). {exception.Message}");
+            return BatchExitCodes.UnexpectedError;
+        }
+    }
+}
