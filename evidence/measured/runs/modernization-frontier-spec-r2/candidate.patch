+++ b/src/TradeReconciliation.Core/Persistence/CsvRunLedgerStore.cs
@@ -0,0 +1,97 @@
+using System.Globalization;
+
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Persistence;
+
+/// <summary>
+/// Append-only CSV run ledger. A run is identified by its business date plus the
+/// fingerprint of its inputs, so an identical rerun never adds a second row.
+/// </summary>
+public sealed class CsvRunLedgerStore : IRunLedgerStore
+{
+    internal const string Header = "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+    public bool Contains(string outputDirectory, DateTime businessDate, string inputSignature) =>
+        LoadEntries(LedgerPath(outputDirectory)).Any(entry =>
+            entry.BusinessDate == businessDate
+            && string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal));
+
+    public void AppendIfMissing(string outputDirectory, RunLedgerEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+
+        if (Contains(outputDirectory, entry.BusinessDate, entry.InputSignature))
+        {
+            return;
+        }
+
+        var path = LedgerPath(outputDirectory);
+        var payload = File.Exists(path) ? string.Empty : Header + OutputFormat.LineSeparator;
+
+        payload += string.Join(
+            ",",
+            OutputFormat.FormatDate(entry.BusinessDate),
+            entry.InputSignature,
+            entry.TotalTradesRead.ToString(CultureInfo.InvariantCulture),
+            entry.OpenBreakCount.ToString(CultureInfo.InvariantCulture),
+            entry.MatchedCount.ToString(CultureInfo.InvariantCulture)) + OutputFormat.LineSeparator;
+
+        File.AppendAllText(path, payload);
+    }
+
+    private static string LedgerPath(string outputDirectory) =>
+        Path.Combine(outputDirectory, BatchFileNames.RunLedger);
+
+    private static List<RunLedgerEntry> LoadEntries(string ledgerPath)
+    {
+        if (!File.Exists(ledgerPath))
+        {
+            return [];
+        }
+
+        var lines = File.ReadAllLines(ledgerPath);
+        var entries = new List<RunLedgerEntry>();
+
+        for (var index = 1; index < lines.Length; index++)
+        {
+            if (string.IsNullOrWhiteSpace(lines[index]))
+            {
+                continue;
+            }
+
+            entries.Add(ParseEntry(lines[index], index + 1));
+        }
+
+        return entries;
+    }
+
+    private static RunLedgerEntry ParseEntry(string line, int lineNumber)
+    {
+        var cells = line.Split(',');
+        if (cells.Length != 5)
+        {
+            throw new ReconciliationInputException(
+                $"Malformed row in '{BatchFileNames.RunLedger}' at line {lineNumber}: expected 5 columns but found {cells.Length}.");
+        }
+
+        if (!DateTime.TryParseExact(cells[0], OutputFormat.DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var businessDate)
+            || !int.TryParse(cells[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out var totalTradesRead)
+            || !int.TryParse(cells[3], NumberStyles.Integer, CultureInfo.InvariantCulture, out var openBreakCount)
+            || !int.TryParse(cells[4], NumberStyles.Integer, CultureInfo.InvariantCulture, out var matchedCount))
+        {
+            throw new ReconciliationInputException(
+                $"Malformed row in '{BatchFileNames.RunLedger}' at line {lineNumber}: business date and counts must be invariant values.");
+        }
+
+        return new RunLedgerEntry
+        {
+            BusinessDate = businessDate,
+            InputSignature = cells[1],
+            TotalTradesRead = totalTradesRead,
+            OpenBreakCount = openBreakCount,
+            MatchedCount = matchedCount
+        };
+    }
+}
diff --git a/src/TradeReconciliation.Core/Persistence/StoragePorts.cs b/src/TradeReconciliation.Core/Persistence/StoragePorts.cs
new file mode 100644
index 0000000..e88fc89
--- /dev/null
+++ b/src/TradeReconciliation.Core/Persistence/StoragePorts.cs
@@ -0,0 +1,45 @@
+using TradeReconciliation.Core.Domain;
+
+namespace TradeReconciliation.Core.Persistence;
+
+/// <summary>Read side of the durable storage port used by the batch.</summary>
+public interface IReconciliationInputStore
+{
+    IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory);
+
+    IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory);
+
+    IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory);
+
+    IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory);
+
+    /// <summary>
+    /// Stable fingerprint of the business date plus every file in the input
+    /// directory. Identical inputs for the same date yield an identical value,
+    /// which is what makes reruns idempotent.
+    /// </summary>
+    string CalculateInputSignature(DateTime businessDate, string inputDirectory);
+}
+
+/// <summary>Write side of the durable storage port used by the batch.</summary>
+public interface IReconciliationOutputStore
+{
+    void EnsureOutputDirectory(string outputDirectory);
+
+    /// <summary>True when all result files from a previous run are still present.</summary>
+    bool ResultFilesExist(string outputDirectory);
+
+    void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades);
+
+    void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue);
+
+    void WriteEndOfDayReport(string outputDirectory, string reportText);
+}
+
+/// <summary>Append-only run history that guarantees one entry per distinct run.</summary>
+public interface IRunLedgerStore
+{
+    bool Contains(string outputDirectory, DateTime businessDate, string inputSignature);
+
+    void AppendIfMissing(string outputDirectory, RunLedgerEntry entry);
+}
