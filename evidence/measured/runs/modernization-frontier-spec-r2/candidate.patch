+namespace TradeReconciliation.Core;
+
+/// <summary>Raised when the command line itself is unusable.</summary>
+public sealed class ReconciliationUsageException : Exception
+{
+    public ReconciliationUsageException(string message)
+        : base(message)
+    {
+    }
+}
+
+/// <summary>Process exit codes documented for operators and the benchmark adapter.</summary>
+public static class BatchExitCodes
+{
+    /// <summary>The batch produced (or deliberately retained) all four output files.</summary>
+    public const int Success = 0;
+
+    /// <summary>An unexpected failure; outputs may be incomplete.</summary>
+    public const int UnexpectedError = 1;
+
+    /// <summary>The command line was invalid.</summary>
+    public const int UsageError = 2;
+
+    /// <summary>Input files were missing, unreadable, or malformed.</summary>
+    public const int InputError = 3;
+}
