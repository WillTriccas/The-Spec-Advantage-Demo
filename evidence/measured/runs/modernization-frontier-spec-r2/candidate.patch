+using TradeReconciliation.Core;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Domain;
+using TradeReconciliation.Core.Persistence;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>INV-4: run history must never gain a duplicate entry.</summary>
+public sealed class CsvRunLedgerStoreTests
+{
+    private readonly CsvRunLedgerStore _store = new();
+
+    private static RunLedgerEntry Entry(string signature = "abc123", int totalTradesRead = 5) => new()
+    {
+        BusinessDate = new DateTime(2025, 3, 17),
+        InputSignature = signature,
+        TotalTradesRead = totalTradesRead,
+        OpenBreakCount = 3,
+        MatchedCount = 2
+    };
+
+    [Fact]
+    public void Writes_the_header_once_and_appends_distinct_runs()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("ledger-append");
+
+        _store.AppendIfMissing(directory, Entry("signature-a"));
+        _store.AppendIfMissing(directory, Entry("signature-b"));
+
+        Assert.Equal(
+            CsvRunLedgerStore.Header + "\n"
+            + "2025-03-17,signature-a,5,3,2\n"
+            + "2025-03-17,signature-b,5,3,2\n",
+            File.ReadAllText(Path.Combine(directory, BatchFileNames.RunLedger)));
+    }
+
+    [Fact]
+    public void Ignores_a_repeated_entry_for_the_same_date_and_signature()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("ledger-idempotent");
+
+        _store.AppendIfMissing(directory, Entry());
+        var afterFirst = File.ReadAllText(Path.Combine(directory, BatchFileNames.RunLedger));
+        _store.AppendIfMissing(directory, Entry());
+
+        Assert.Equal(afterFirst, File.ReadAllText(Path.Combine(directory, BatchFileNames.RunLedger)));
+        Assert.True(_store.Contains(directory, new DateTime(2025, 3, 17), "abc123"));
+        Assert.False(_store.Contains(directory, new DateTime(2025, 3, 18), "abc123"));
+        Assert.False(_store.Contains(directory, new DateTime(2025, 3, 17), "other"));
+    }
+
+    [Fact]
+    public void Reports_an_absent_ledger_as_containing_nothing()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("ledger-absent");
+
+        Assert.False(_store.Contains(directory, new DateTime(2025, 3, 17), "abc123"));
+    }
+
+    [Fact]
+    public void Rejects_a_corrupt_ledger_with_an_actionable_message()
+    {
+        var directory = TestPaths.CreateTemporaryDirectory("ledger-corrupt");
+        File.WriteAllText(
+            Path.Combine(directory, BatchFileNames.RunLedger),
+            CsvRunLedgerStore.Header + "\nnot-a-date,abc123,5,3,2\n");
+
+        var exception = Assert.Throws<ReconciliationInputException>(
+            () => _store.Contains(directory, new DateTime(2025, 3, 17), "abc123"));
+
+        Assert.Contains("line 2", exception.Message, StringComparison.Ordinal);
+    }
+}
