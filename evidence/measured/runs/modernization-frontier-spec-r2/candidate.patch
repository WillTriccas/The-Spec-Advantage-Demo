+namespace TradeReconciliation.Core.Configuration;
+
+/// <summary>
+/// Externally configurable reconciliation tolerances. Defaults reproduce the
+/// legacy .NET Framework batch exactly and must not be changed without a
+/// business rule change.
+/// </summary>
+public sealed class ReconciliationOptions
+{
+    /// <summary>Legacy defaults, used whenever the caller supplies nothing else.</summary>
+    public static ReconciliationOptions Default { get; } = new();
+
+    /// <summary>Inclusive absolute tolerance between trade and position quantity.</summary>
+    public decimal PositionQuantityTolerance { get; init; } = 0.01m;
+
+    /// <summary>Inclusive absolute tolerance between trade and settlement quantity.</summary>
+    public decimal SettlementQuantityTolerance { get; init; } = 0.02m;
+
+    /// <summary>Inclusive absolute tolerance between trade net amount and settlement cash.</summary>
+    public decimal SettlementAmountTolerance { get; init; } = 5.00m;
+}
