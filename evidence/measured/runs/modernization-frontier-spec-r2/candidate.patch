+using TradeReconciliation.Core;
+using TradeReconciliation.Core.Batch;
+using TradeReconciliation.Core.Configuration;
+using TradeReconciliation.Core.Diagnostics;
+
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Golden-master coverage over the observable file contract: the four output
+/// files, their schemas, deterministic ordering, and idempotent reruns.
+/// </summary>
+public sealed class GoldenMasterTests
+{
+    private const string BusinessDate = "2025-03-17";
+
+    private static int RunBatch(string inputDirectory, string outputDirectory) =>
+        ReconciliationBatch
+            .CreateDefault(logger: NullBatchLogger.Instance)
+            .Run([BusinessDate, inputDirectory, outputDirectory]);
+
+    // AC-8 / REQ-5: the baseline fixture reproduces the legacy break queue and report.
+    [Fact]
+    public void Baseline_fixture_reproduces_the_golden_master_outputs()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("baseline");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(TestPaths.Fixture("baseline", "input"), outputDirectory));
+
+        AssertMatchesFixture("baseline", BatchFileNames.BreakQueue, outputDirectory);
+        AssertMatchesFixture("baseline", BatchFileNames.EndOfDayReport, outputDirectory);
+    }
+
+    // AC-8 / REQ-5: every run declares all four outputs.
+    [Fact]
+    public void Every_run_writes_all_four_declared_outputs()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("outputs");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(TestPaths.Fixture("baseline", "input"), outputDirectory));
+
+        foreach (var fileName in BatchFileNames.Outputs)
+        {
+            Assert.True(
+                File.Exists(Path.Combine(outputDirectory, fileName)),
+                $"Declared output '{fileName}' was not written.");
+        }
+    }
+
+    // REQ-4 / AC-7: overrides applied, evidenced, and audited exactly as before.
+    [Fact]
+    public void Override_fixture_reproduces_the_golden_master_outputs()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("override-rerun");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(TestPaths.Fixture("override-rerun", "input"), outputDirectory));
+
+        AssertMatchesFixture("override-rerun", BatchFileNames.MatchedTrades, outputDirectory);
+        AssertMatchesFixture("override-rerun", BatchFileNames.BreakQueue, outputDirectory);
+        AssertMatchesFixture("override-rerun", BatchFileNames.EndOfDayReport, outputDirectory);
+    }
+
+    // AC-9 / REQ-6 / INV-4: an exact rerun changes nothing and adds no ledger row.
+    [Fact]
+    public void Exact_rerun_is_idempotent_across_every_declared_output()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("rerun");
+        var inputDirectory = TestPaths.Fixture("override-rerun", "input");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, outputDirectory));
+        var firstRun = ReadOutputs(outputDirectory);
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, outputDirectory));
+        var secondRun = ReadOutputs(outputDirectory);
+
+        Assert.Equal(firstRun, secondRun);
+        Assert.Equal(2, LedgerLineCount(outputDirectory));
+    }
+
+    [Fact]
+    public void Changed_inputs_for_the_same_business_date_append_exactly_one_more_ledger_row()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("rerun-changed");
+        var inputDirectory = CopyFixtureInput("override-rerun", "rerun-changed-input");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, outputDirectory));
+
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Overrides),
+            "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager\n");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, outputDirectory));
+
+        Assert.Equal(3, LedgerLineCount(outputDirectory));
+        Assert.Contains("Stale Overrides: 1", ReadOutput(outputDirectory, BatchFileNames.EndOfDayReport), StringComparison.Ordinal);
+    }
+
+    // AMB-2: a duplicate override instruction is audited, never silently dropped.
+    [Fact]
+    public void Duplicate_override_instruction_is_audited_in_the_report()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("duplicate-overrides-output");
+        var inputDirectory = CopyFixtureInput("override-rerun", "duplicate-overrides-input");
+
+        File.AppendAllText(
+            Path.Combine(inputDirectory, BatchFileNames.Overrides),
+            "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager\n");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, outputDirectory));
+
+        var report = ReadOutput(outputDirectory, BatchFileNames.EndOfDayReport);
+        Assert.Contains("Stale Overrides: 1", report, StringComparison.Ordinal);
+        Assert.Contains("T-1003: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+    }
+
+    // AMB-3 / REQ-5: identical inputs produce byte-identical files on any host.
+    [Fact]
+    public void Two_independent_runs_produce_byte_identical_outputs()
+    {
+        var inputDirectory = TestPaths.Fixture("baseline", "input");
+        var first = TestPaths.CreateTemporaryDirectory("determinism-a");
+        var second = TestPaths.CreateTemporaryDirectory("determinism-b");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, first));
+        Assert.Equal(BatchExitCodes.Success, RunBatch(inputDirectory, second));
+
+        foreach (var fileName in BatchFileNames.Outputs)
+        {
+            Assert.Equal(
+                File.ReadAllBytes(Path.Combine(first, fileName)),
+                File.ReadAllBytes(Path.Combine(second, fileName)));
+        }
+    }
+
+    [Fact]
+    public void Output_files_use_stable_headers_and_line_endings()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("schema");
+
+        Assert.Equal(BatchExitCodes.Success, RunBatch(TestPaths.Fixture("baseline", "input"), outputDirectory));
+
+        var matched = ReadOutput(outputDirectory, BatchFileNames.MatchedTrades);
+        var breaks = ReadOutput(outputDirectory, BatchFileNames.BreakQueue);
+        var ledger = ReadOutput(outputDirectory, BatchFileNames.RunLedger);
+
+        Assert.StartsWith(
+            "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note\n",
+            matched,
+            StringComparison.Ordinal);
+        Assert.StartsWith(
+            "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id\n",
+            breaks,
+            StringComparison.Ordinal);
+        Assert.StartsWith(
+            "business_date,input_signature,total_trades_read,open_break_count,matched_count\n",
+            ledger,
+            StringComparison.Ordinal);
+
+        foreach (var fileName in BatchFileNames.Outputs)
+        {
+            Assert.DoesNotContain('\r', ReadOutput(outputDirectory, fileName));
+        }
+    }
+
+    // NFR-3: missing or malformed input must not produce success-shaped output.
+    [Fact]
+    public void Missing_input_directory_fails_without_writing_result_files()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("missing-input");
+        var inputDirectory = Path.Combine(outputDirectory, "does-not-exist");
+
+        Assert.Equal(BatchExitCodes.InputError, RunBatch(inputDirectory, outputDirectory));
+        Assert.Empty(Directory.GetFiles(outputDirectory));
+    }
+
+    [Fact]
+    public void Missing_trades_file_fails_without_writing_result_files()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("missing-trades-output");
+        var inputDirectory = CopyFixtureInput("baseline", "missing-trades-input");
+        File.Delete(Path.Combine(inputDirectory, BatchFileNames.Trades));
+
+        Assert.Equal(BatchExitCodes.InputError, RunBatch(inputDirectory, outputDirectory));
+        Assert.Empty(Directory.GetFiles(outputDirectory));
+    }
+
+    [Fact]
+    public void Malformed_trade_row_fails_without_writing_result_files()
+    {
+        var outputDirectory = TestPaths.CreateTemporaryDirectory("malformed-output");
+        var inputDirectory = CopyFixtureInput("baseline", "malformed-input");
+        File.AppendAllText(Path.Combine(inputDirectory, BatchFileNames.Trades), "T-9999,ACC-001,IBM.N\n");
+
+        Assert.Equal(BatchExitCodes.InputError, RunBatch(inputDirectory, outputDirectory));
+        Assert.Empty(Directory.GetFiles(outputDirectory));
+    }
+
+    private static string CopyFixtureInput(string fixtureName, string label)
+    {
+        var target = TestPaths.CreateTemporaryDirectory(label);
+        foreach (var file in Directory.GetFiles(TestPaths.Fixture(fixtureName, "input")))
+        {
+            File.Copy(file, Path.Combine(target, Path.GetFileName(file)));
+        }
+
+        return target;
+    }
+
+    private static void AssertMatchesFixture(string fixtureName, string fileName, string outputDirectory) =>
+        Assert.Equal(
+            File.ReadAllText(TestPaths.Fixture(fixtureName, "expected", fileName)),
+            ReadOutput(outputDirectory, fileName));
+
+    private static string ReadOutput(string outputDirectory, string fileName) =>
+        File.ReadAllText(Path.Combine(outputDirectory, fileName));
+
+    private static Dictionary<string, string> ReadOutputs(string outputDirectory) =>
+        BatchFileNames.Outputs.ToDictionary(
+            fileName => fileName,
+            fileName => ReadOutput(outputDirectory, fileName),
+            StringComparer.Ordinal);
+
+    private static int LedgerLineCount(string outputDirectory) =>
+        File.ReadAllLines(Path.Combine(outputDirectory, BatchFileNames.RunLedger))
+            .Count(line => !string.IsNullOrWhiteSpace(line));
+}
diff --git a/tests/TradeReconciliation.Tests/MatchingEngineTests.cs b/tests/TradeReconciliation.Tests/MatchingEngineTests.cs
