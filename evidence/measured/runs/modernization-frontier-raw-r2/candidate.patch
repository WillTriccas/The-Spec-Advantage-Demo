+using System.Globalization;
+using System.Text;
+using TradeReconciliation.Application.Abstractions;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Application;
+
+/// <summary>Renders the human-readable end-of-day summary.</summary>
+public sealed class EndOfDayReportBuilder : IEndOfDayReportBuilder
+{
+    public string BuildReport(DateTime businessDate, ReconciliationResult result)
+    {
+        ArgumentNullException.ThrowIfNull(result);
+
+        StringBuilder report = new();
+        report.AppendLine("Legacy Trade Reconciliation - End Of Day Report");
+        report.AppendLine("Business Date: " + businessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
+        report.AppendLine();
+        report.AppendLine("Totals");
+        report.AppendLine("------");
+        report.AppendLine("Trades Read: " + Format(result.TotalTradesRead));
+        report.AppendLine("Canonical Trades: " + Format(result.CanonicalTradeCount));
+        report.AppendLine("Matched: " + Format(result.MatchedCount));
+        report.AppendLine("Manual Override Matched: " + Format(result.ManualOverrideMatchedCount));
+        report.AppendLine("Manual Override Suppressed: " + Format(result.ManualOverrideSuppressedCount));
+        report.AppendLine("Open Breaks: " + Format(result.OpenBreaks.Count));
+        report.AppendLine("Duplicate Trades: " + Format(result.DuplicateTradeCount));
+        report.AppendLine("Stale Overrides: " + Format(result.StaleOverrides.Count));
+        report.AppendLine();
+        report.AppendLine("Open Break Reasons");
+        report.AppendLine("------------------");
+
+        List<KeyValuePair<string, int>> reasonCounts = result.OpenBreaks
+            .SelectMany(record => record.Reasons.Split('|'))
+            .Select(reason => reason.Trim())
+            .Where(reason => !string.IsNullOrWhiteSpace(reason))
+            .GroupBy(reason => reason, StringComparer.Ordinal)
+            .OrderBy(group => group.Key, StringComparer.Ordinal)
+            .Select(group => new KeyValuePair<string, int>(group.Key, group.Count()))
+            .ToList();
+
+        foreach (KeyValuePair<string, int> reasonCount in reasonCounts)
+        {
+            report.AppendLine(reasonCount.Key + ": " + Format(reasonCount.Value));
+        }
+
+        if (reasonCounts.Count == 0)
+        {
+            report.AppendLine("None");
+        }
+
+        if (result.StaleOverrides.Count > 0)
+        {
+            report.AppendLine();
+            report.AppendLine("Stale Overrides");
+            report.AppendLine("---------------");
+
+            foreach (ManualOverrideRecord staleOverride in result.StaleOverrides.OrderBy(item => item.TradeId, StringComparer.Ordinal))
+            {
+                report.AppendLine(staleOverride.TradeId + ": " + staleOverride.Action + " (" + staleOverride.ApprovedBy + ")");
+            }
+        }
+
+        return report.ToString().TrimEnd() + Environment.NewLine;
+    }
+
+    private static string Format(int value) => value.ToString(CultureInfo.InvariantCulture);
+}
