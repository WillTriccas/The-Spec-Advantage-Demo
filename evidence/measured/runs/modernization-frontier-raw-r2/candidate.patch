+namespace TradeReconciliation.Configuration;
+
+/// <summary>Fixed input and output file names of the batch contract.</summary>
+public static class BatchFileNames
+{
+    public const string Trades = "trades.csv";
+    public const string Positions = "positions.csv";
+    public const string Settlements = "settlements.csv";
+    public const string Overrides = "overrides.csv";
+
+    public const string MatchedTrades = "matched-trades.csv";
+    public const string BreakQueue = "break-queue.csv";
+    public const string EndOfDayReport = "end-of-day-report.txt";
+    public const string RunLedger = "run-ledger.csv";
+
+    /// <summary>Output files that must all be present for a rerun to be treated as complete.</summary>
+    public static readonly IReadOnlyList<string> RequiredForCompleteRun =
+    [
+        MatchedTrades,
+        BreakQueue,
+        EndOfDayReport,
+    ];
+}
diff --git a/src/TradeReconciliation/Configuration/ReconciliationOptions.cs b/src/TradeReconciliation/Configuration/ReconciliationOptions.cs
new file mode 100644
index 0000000..b55be68
--- /dev/null
+++ b/src/TradeReconciliation/Configuration/ReconciliationOptions.cs
@@ -0,0 +1,39 @@
+namespace TradeReconciliation.Configuration;
+
+/// <summary>
+/// Matching tolerances applied by the reconciliation engine. The defaults are the
+/// production values Trade Operations relies on and must not change silently.
+/// </summary>
+public sealed class ReconciliationOptions
+{
+    public const decimal DefaultPositionQuantityTolerance = 0.01m;
+    public const decimal DefaultSettlementQuantityTolerance = 0.02m;
+    public const decimal DefaultSettlementAmountTolerance = 5.00m;
+
+    public static ReconciliationOptions Default { get; } = new();
+
+    /// <summary>Absolute quantity tolerance between a trade and its custodian position.</summary>
+    public decimal PositionQuantityTolerance { get; init; } = DefaultPositionQuantityTolerance;
+
+    /// <summary>Absolute quantity tolerance between a trade and its settlement instruction.</summary>
+    public decimal SettlementQuantityTolerance { get; init; } = DefaultSettlementQuantityTolerance;
+
+    /// <summary>Absolute cash tolerance between a trade net amount and settlement cash amount.</summary>
+    public decimal SettlementAmountTolerance { get; init; } = DefaultSettlementAmountTolerance;
+
+    /// <summary>Fails fast on a nonsensical configuration instead of silently mis-reconciling.</summary>
+    public void Validate()
+    {
+        ThrowIfNegative(PositionQuantityTolerance, nameof(PositionQuantityTolerance));
+        ThrowIfNegative(SettlementQuantityTolerance, nameof(SettlementQuantityTolerance));
+        ThrowIfNegative(SettlementAmountTolerance, nameof(SettlementAmountTolerance));
+    }
+
+    private static void ThrowIfNegative(decimal value, string name)
+    {
+        if (value < 0m)
+        {
+            throw new ArgumentOutOfRangeException(name, value, "Reconciliation tolerances must not be negative.");
+        }
+    }
+}
