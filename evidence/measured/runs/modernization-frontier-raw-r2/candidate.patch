+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Application.Abstractions;
+
+/// <summary>Reads the four synthetic CSV inputs for a business date.</summary>
+public interface IReconciliationDataSource
+{
+    IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory);
+
+    IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory);
+
+    IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory);
+
+    /// <summary>Manual overrides are optional; a missing file yields an empty list.</summary>
+    IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory);
+}
+
+/// <summary>Writes the observable batch artefacts.</summary>
+public interface IReconciliationOutputSink
+{
+    void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades);
+
+    void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue);
+
+    void WriteEndOfDayReport(string outputDirectory, string reportText);
+
+    bool AllRequiredOutputsExist(string outputDirectory);
+}
+
+/// <summary>Pure reconciliation decision logic.</summary>
+public interface IMatchingEngine
+{
+    ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord> trades,
+        IReadOnlyCollection<PositionRecord> positions,
+        IReadOnlyCollection<SettlementRecord> settlements,
+        IReadOnlyCollection<ManualOverrideRecord> manualOverrides);
+}
+
+/// <summary>Renders <c>end-of-day-report.txt</c>.</summary>
+public interface IEndOfDayReportBuilder
+{
+    string BuildReport(DateTime businessDate, ReconciliationResult result);
+}
+
+/// <summary>Computes the content signature used to detect exact-input reruns.</summary>
+public interface IInputSignatureCalculator
+{
+    string Calculate(DateTime businessDate, string inputDirectory);
+}
+
+/// <summary>Append-only audit ledger of completed runs.</summary>
+public interface IRunLedger
+{
+    bool Exists(DateTime businessDate, string inputSignature);
+
+    void AppendIfMissing(RunLedgerEntry entry);
+}
+
+/// <summary>Creates the ledger bound to a specific output directory.</summary>
+public interface IRunLedgerFactory
+{
+    IRunLedger Create(string outputDirectory);
+}
