+using TradeReconciliation.Application;
+using TradeReconciliation.Domain;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>The operator-facing summary is part of the observable contract, so its shape is pinned.</summary>
+public sealed class EndOfDayReportBuilderTests
+{
+    private static readonly EndOfDayReportBuilder Builder = new();
+
+    private static ReconciliationResult Result(
+        IReadOnlyList<BreakRecord>? breaks = null,
+        IReadOnlyList<ManualOverrideRecord>? staleOverrides = null) => new()
+        {
+            MatchedTrades = [],
+            OpenBreaks = breaks ?? [],
+            StaleOverrides = staleOverrides ?? [],
+            TotalTradesRead = 12,
+            CanonicalTradeCount = 11,
+            DuplicateTradeCount = 1,
+            MatchedCount = 7,
+            ManualOverrideMatchedCount = 2,
+            ManualOverrideSuppressedCount = 1,
+        };
+
+    private static BreakRecord Break(string tradeId, string reasons) => new()
+    {
+        TradeId = tradeId,
+        Account = "ACC-1",
+        Instrument = "IBM.N",
+        Quantity = 100m,
+        SettlementDate = Build.Settle,
+        Currency = "USD",
+        Reasons = reasons,
+        PositionId = null,
+        SettlementId = null,
+        CanManualOverride = false,
+    };
+
+    [Fact]
+    public void The_report_opens_with_the_expected_title_and_business_date()
+    {
+        string report = Builder.BuildReport(new DateTime(2025, 3, 17), Result());
+
+        string[] lines = report.Split(Environment.NewLine);
+        Assert.Equal("Legacy Trade Reconciliation - End Of Day Report", lines[0]);
+        Assert.Equal("Business Date: 2025-03-17", lines[1]);
+    }
+
+    [Fact]
+    public void Every_headline_total_is_rendered()
+    {
+        string report = Builder.BuildReport(Build.Settle, Result());
+
+        Assert.Contains("Trades Read: 12", report, StringComparison.Ordinal);
+        Assert.Contains("Canonical Trades: 11", report, StringComparison.Ordinal);
+        Assert.Contains("Matched: 7", report, StringComparison.Ordinal);
+        Assert.Contains("Manual Override Matched: 2", report, StringComparison.Ordinal);
+        Assert.Contains("Manual Override Suppressed: 1", report, StringComparison.Ordinal);
+        Assert.Contains("Open Breaks: 0", report, StringComparison.Ordinal);
+        Assert.Contains("Duplicate Trades: 1", report, StringComparison.Ordinal);
+        Assert.Contains("Stale Overrides: 0", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_clean_day_renders_None_under_the_break_reason_heading()
+    {
+        string report = Builder.BuildReport(Build.Settle, Result());
+
+        Assert.Contains("Open Break Reasons" + Environment.NewLine + "------------------" + Environment.NewLine + "None", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Pipe_separated_reasons_are_counted_individually_and_sorted_ordinally()
+    {
+        string report = Builder.BuildReport(Build.Settle, Result(
+        [
+            Break("T-1", BreakReasons.MissingPosition + "|" + BreakReasons.MissingSettlement),
+            Break("T-2", BreakReasons.MissingPosition),
+        ]));
+
+        Assert.Contains(BreakReasons.MissingPosition + ": 2", report, StringComparison.Ordinal);
+        Assert.Contains(BreakReasons.MissingSettlement + ": 1", report, StringComparison.Ordinal);
+        Assert.True(
+            report.IndexOf(BreakReasons.MissingPosition + ": 2", StringComparison.Ordinal) <
+            report.IndexOf(BreakReasons.MissingSettlement + ": 1", StringComparison.Ordinal));
+    }
+
+    [Fact]
+    public void The_stale_override_section_appears_only_when_instructions_were_discarded()
+    {
+        Assert.DoesNotContain("Stale Overrides" + Environment.NewLine + "---------------", Builder.BuildReport(Build.Settle, Result()), StringComparison.Ordinal);
+
+        string report = Builder.BuildReport(Build.Settle, Result(
+            staleOverrides: [Build.Override("T-9", "ForceMatch", "note", "ops-manager")]));
+
+        Assert.Contains("Stale Overrides" + Environment.NewLine + "---------------", report, StringComparison.Ordinal);
+        Assert.Contains("T-9: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void The_report_ends_with_exactly_one_trailing_newline()
+    {
+        string report = Builder.BuildReport(Build.Settle, Result());
+
+        Assert.EndsWith(Environment.NewLine, report, StringComparison.Ordinal);
+        Assert.False(report.EndsWith(Environment.NewLine + Environment.NewLine, StringComparison.Ordinal));
+    }
+}
