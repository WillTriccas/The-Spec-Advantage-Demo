@@ -0,0 +1,108 @@
+using TradeReconciliation.Cli;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>Argument handling, exit codes and the operator-facing console text.</summary>
+public sealed class BatchHostTests
+{
+    private static (int ExitCode, string Output, string Error) Run(params string[] args)
+    {
+        using StringWriter output = new();
+        using StringWriter error = new();
+        int exitCode = BatchHost.Run(args, output, error);
+        return (exitCode, output.ToString(), error.ToString());
+    }
+
+    [Fact]
+    public void The_three_argument_form_reconciles_and_reports_success()
+    {
+        using TempDirectory output = new();
+        string input = Path.Combine(AppContext.BaseDirectory, "Fixtures", "baseline", "input");
+
+        (int exitCode, string standardOutput, string standardError) = Run("2025-03-17", input, output.Path);
+
+        Assert.Equal(ExitCodes.Success, exitCode);
+        Assert.Contains("Processed", standardOutput, StringComparison.Ordinal);
+        Assert.Contains("open breaks.", standardOutput, StringComparison.Ordinal);
+        Assert.Empty(standardError);
+    }
+
+    [Fact]
+    public void An_exact_rerun_reports_that_existing_outputs_were_retained()
+    {
+        using TempDirectory output = new();
+        string input = Path.Combine(AppContext.BaseDirectory, "Fixtures", "baseline", "input");
+
+        Run("2025-03-17", input, output.Path);
+        (int exitCode, string standardOutput, _) = Run("2025-03-17", input, output.Path);
+
+        Assert.Equal(ExitCodes.Success, exitCode);
+        Assert.Equal(
+            "Exact rerun detected for 2025-03-17. Existing outputs were retained.",
+            standardOutput.Trim());
+    }
+
+    [Theory]
+    [InlineData("--help")]
+    [InlineData("-h")]
+    [InlineData("-?")]
+    [InlineData("/?")]
+    public void Help_switches_print_usage_and_succeed(string switchText)
+    {
+        (int exitCode, string standardOutput, _) = Run(switchText);
+
+        Assert.Equal(ExitCodes.Success, exitCode);
+        Assert.Contains("Usage:", standardOutput, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("2025-03-17")]
+    [InlineData("2025-03-17|input")]
+    [InlineData("2025-03-17|input|output|extra")]
+    public void An_unsupported_argument_count_is_a_usage_error(string pipeSeparatedArgs)
+    {
+        (int exitCode, _, string standardError) = Run(pipeSeparatedArgs.Split('|'));
+
+        Assert.Equal(ExitCodes.UsageError, exitCode);
+        Assert.Contains("Usage:", standardError, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_malformed_business_date_is_a_usage_error_naming_the_expected_format()
+    {
+        (int exitCode, _, string standardError) = Run("17-03-2025", "input", "output");
+
+        Assert.Equal(ExitCodes.UsageError, exitCode);
+        Assert.Contains("yyyy-MM-dd", standardError, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void An_empty_directory_argument_is_rejected_before_any_file_access()
+    {
+        (int exitCode, _, string standardError) = Run("2025-03-17", "   ", "output");
+
+        Assert.Equal(ExitCodes.UsageError, exitCode);
+        Assert.Contains("must not be empty", standardError, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_missing_input_directory_is_an_input_error_rather_than_a_crash()
+    {
+        using TempDirectory root = new();
+
+        (int exitCode, _, string standardError) = Run("2025-03-17", root.Combine("absent"), root.Combine("out"));
+
+        Assert.Equal(ExitCodes.InputError, exitCode);
+        Assert.NotEmpty(standardError);
+    }
+
+    [Fact]
+    public void Exit_codes_are_distinct_so_schedulers_can_route_failures()
+    {
+        Assert.Equal(0, ExitCodes.Success);
+        Assert.NotEqual(ExitCodes.Success, ExitCodes.UsageError);
+        Assert.NotEqual(ExitCodes.UsageError, ExitCodes.InputError);
+        Assert.NotEqual(ExitCodes.Success, ExitCodes.UnexpectedFailure);
+    }
+}
