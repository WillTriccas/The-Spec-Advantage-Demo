+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>Concise builders so scenario intent stays visible in the tests.</summary>
+internal static class Build
+{
+    public static readonly DateTime Settle = new(2025, 3, 17);
+
+    public static TradeRecord Trade(
+        string tradeId = "T-1",
+        string account = "ACC-1",
+        string instrument = "IBM.N",
+        decimal quantity = 100m,
+        DateTime? settlementDate = null,
+        string currency = "USD",
+        decimal netAmount = 1000m) => new()
+        {
+            TradeId = tradeId,
+            Account = account,
+            Instrument = instrument,
+            Quantity = quantity,
+            SettlementDate = settlementDate ?? Settle,
+            Currency = currency,
+            NetAmount = netAmount,
+        };
+
+    public static PositionRecord Position(
+        string positionId = "P-1",
+        string account = "ACC-1",
+        string instrument = "IBM.N",
+        decimal quantity = 100m,
+        DateTime? settlementDate = null,
+        string currency = "USD") => new()
+        {
+            PositionId = positionId,
+            Account = account,
+            Instrument = instrument,
+            Quantity = quantity,
+            SettlementDate = settlementDate ?? Settle,
+            Currency = currency,
+        };
+
+    public static SettlementRecord Settlement(
+        string settlementId = "S-1",
+        string account = "ACC-1",
+        string instrument = "IBM.N",
+        decimal quantity = 100m,
+        DateTime? settlementDate = null,
+        string currency = "USD",
+        decimal cashAmount = 1000m) => new()
+        {
+            SettlementId = settlementId,
+            Account = account,
+            Instrument = instrument,
+            Quantity = quantity,
+            SettlementDate = settlementDate ?? Settle,
+            Currency = currency,
+            CashAmount = cashAmount,
+        };
+
+    public static ManualOverrideRecord Override(
+        string tradeId = "T-1",
+        string action = "ForceMatch",
+        string note = "Approved by ops",
+        string approvedBy = "ops-manager") => new()
+        {
+            TradeId = tradeId,
+            Action = action,
+            Note = note,
+            ApprovedBy = approvedBy,
+        };
+}
