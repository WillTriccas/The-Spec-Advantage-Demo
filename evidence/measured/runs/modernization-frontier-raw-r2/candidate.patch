+namespace TradeReconciliation.Cli;
+
+/// <summary>Process exit codes published by the batch.</summary>
+public static class ExitCodes
+{
+    /// <summary>The batch completed, either by reconciling or by detecting an exact rerun.</summary>
+    public const int Success = 0;
+
+    /// <summary>An unexpected internal failure.</summary>
+    public const int UnexpectedFailure = 1;
+
+    /// <summary>The command line was malformed.</summary>
+    public const int UsageError = 2;
+
+    /// <summary>Batch inputs were missing, unreadable or malformed.</summary>
+    public const int InputError = 3;
+}
diff --git a/src/TradeReconciliation/Cli/RunRequest.cs b/src/TradeReconciliation/Cli/RunRequest.cs
new file mode 100644
index 0000000..4b6b8f9
--- /dev/null
+++ b/src/TradeReconciliation/Cli/RunRequest.cs
@@ -0,0 +1,98 @@
+using System.Globalization;
+using TradeReconciliation.Configuration;
+
+namespace TradeReconciliation.Cli;
+
+/// <summary>A validated request for a single batch invocation.</summary>
+public sealed class RunRequest
+{
+    /// <summary>Business date used when the batch is invoked without arguments.</summary>
+    public static readonly DateTime DefaultBusinessDate = new(2025, 3, 17);
+
+    public const string DateFormat = "yyyy-MM-dd";
+
+    public required DateTime BusinessDate { get; init; }
+
+    public required string InputDirectory { get; init; }
+
+    public required string OutputDirectory { get; init; }
+
+    /// <summary>
+    /// Resolves the batch arguments. Supported forms are the historical no-argument sample run
+    /// and the three-argument production form.
+    /// </summary>
+    public static RunRequest Resolve(string[]? args)
+    {
+        if (args is null || args.Length == 0)
+        {
+            string baseDirectory = AppContext.BaseDirectory;
+            return new RunRequest
+            {
+                BusinessDate = DefaultBusinessDate,
+                InputDirectory = Path.Combine(baseDirectory, "data", "sample"),
+                OutputDirectory = Path.Combine(baseDirectory, "output", "sample"),
+            };
+        }
+
+        if (args.Length != 3)
+        {
+            throw new CommandLineException(
+                $"Expected either no arguments or: <business-date {DateFormat}> <input-directory> <output-directory>.");
+        }
+
+        if (!DateTime.TryParseExact(args[0], DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime businessDate))
+        {
+            throw new CommandLineException($"Business date '{args[0]}' is not a valid {DateFormat} date.");
+        }
+
+        return new RunRequest
+        {
+            BusinessDate = businessDate,
+            InputDirectory = ResolveDirectory(args[1], "input"),
+            OutputDirectory = ResolveDirectory(args[2], "output"),
+        };
+    }
+
+    public static string Usage =>
+        $"""
+         Usage:
+           TradeReconciliation
+           TradeReconciliation <business-date {DateFormat}> <input-directory> <output-directory>
+
+         Reads {BatchFileNames.Trades}, {BatchFileNames.Positions}, {BatchFileNames.Settlements} and the optional
+         {BatchFileNames.Overrides} from the input directory, and writes {BatchFileNames.MatchedTrades},
+         {BatchFileNames.BreakQueue}, {BatchFileNames.EndOfDayReport} and {BatchFileNames.RunLedger}
+         to the output directory. Re-running with byte-identical inputs is idempotent.
+         """;
+
+    private static string ResolveDirectory(string value, string role)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            throw new CommandLineException($"The {role} directory argument must not be empty.");
+        }
+
+        try
+        {
+            return Path.GetFullPath(value);
+        }
+        catch (Exception exception) when (exception is ArgumentException or NotSupportedException or PathTooLongException)
+        {
+            throw new CommandLineException($"The {role} directory argument is not a usable path.", exception);
+        }
+    }
+}
+
+/// <summary>Raised for malformed command lines; always reported as a usage error.</summary>
+public sealed class CommandLineException : Exception
+{
+    public CommandLineException(string message)
+        : base(message)
+    {
+    }
+
+    public CommandLineException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+}
