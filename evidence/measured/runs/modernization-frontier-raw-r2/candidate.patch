@@ -0,0 +1,117 @@
+using System.Globalization;
+using TradeReconciliation.Application.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Infrastructure;
+
+/// <summary>Creates <see cref="RunLedgerStore"/> instances bound to an output directory.</summary>
+public sealed class RunLedgerStoreFactory : IRunLedgerFactory
+{
+    public IRunLedger Create(string outputDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(outputDirectory);
+        return new RunLedgerStore(Path.Combine(Path.GetFullPath(outputDirectory), BatchFileNames.RunLedger));
+    }
+}
+
+/// <summary>
+/// Append-only audit trail of completed runs, stored as <c>run-ledger.csv</c> next to the other
+/// outputs. Entries are keyed by business date plus input signature so an exact rerun never
+/// appends a duplicate row.
+/// </summary>
+public sealed class RunLedgerStore : IRunLedger
+{
+    internal const string Header = "business_date,input_signature,total_trades_read,open_break_count,matched_count";
+
+    private readonly string _ledgerPath;
+
+    public RunLedgerStore(string ledgerPath)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(ledgerPath);
+        _ledgerPath = ledgerPath;
+    }
+
+    public bool Exists(DateTime businessDate, string inputSignature)
+        => LoadEntries().Any(entry =>
+            entry.BusinessDate == businessDate &&
+            string.Equals(entry.InputSignature, inputSignature, StringComparison.Ordinal));
+
+    public void AppendIfMissing(RunLedgerEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+
+        if (Exists(entry.BusinessDate, entry.InputSignature))
+        {
+            return;
+        }
+
+        bool fileExists = File.Exists(_ledgerPath);
+        using StreamWriter writer = new(_ledgerPath, append: true);
+
+        if (!fileExists)
+        {
+            writer.WriteLine(Header);
+        }
+
+        writer.WriteLine(string.Join(
+            ",",
+            entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            entry.InputSignature,
+            entry.TotalTradesRead.ToString(CultureInfo.InvariantCulture),
+            entry.OpenBreakCount.ToString(CultureInfo.InvariantCulture),
+            entry.MatchedCount.ToString(CultureInfo.InvariantCulture)));
+    }
+
+    public IReadOnlyList<RunLedgerEntry> LoadEntries()
+    {
+        if (!File.Exists(_ledgerPath))
+        {
+            return [];
+        }
+
+        List<RunLedgerEntry> entries = [];
+        int lineNumber = 0;
+
+        foreach (string line in File.ReadLines(_ledgerPath))
+        {
+            lineNumber++;
+            if (lineNumber == 1 || string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            entries.Add(ParseEntry(line, lineNumber));
+        }
+
+        return entries;
+    }
+
+    private static RunLedgerEntry ParseEntry(string line, int lineNumber)
+    {
+        string[] cells = line.Split(',');
+        if (cells.Length != 5)
+        {
+            throw new ReconciliationInputException(
+                $"Corrupt run ledger at line {lineNumber.ToString(CultureInfo.InvariantCulture)}: expected 5 cells.");
+        }
+
+        if (!DateTime.TryParseExact(cells[0], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime businessDate) ||
+            !int.TryParse(cells[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out int totalTradesRead) ||
+            !int.TryParse(cells[3], NumberStyles.Integer, CultureInfo.InvariantCulture, out int openBreakCount) ||
+            !int.TryParse(cells[4], NumberStyles.Integer, CultureInfo.InvariantCulture, out int matchedCount))
+        {
+            throw new ReconciliationInputException(
+                $"Corrupt run ledger at line {lineNumber.ToString(CultureInfo.InvariantCulture)}: unparsable values.");
+        }
+
+        return new RunLedgerEntry
+        {
+            BusinessDate = businessDate,
+            InputSignature = cells[1],
+            TotalTradesRead = totalTradesRead,
+            OpenBreakCount = openBreakCount,
+            MatchedCount = matchedCount,
+        };
+    }
+}
