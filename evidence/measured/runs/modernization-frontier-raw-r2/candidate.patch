@@ -0,0 +1,171 @@
+using TradeReconciliation.Domain;
+using TradeReconciliation.Infrastructure;
+using TradeReconciliation.Infrastructure.Csv;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>Ingestion, publication and containment behaviour of the CSV boundary.</summary>
+public sealed class CsvFileGatewayTests
+{
+    private static readonly CsvFileGateway Gateway = new();
+
+    [Fact]
+    public void Header_rows_blank_lines_and_surrounding_whitespace_are_ignored()
+    {
+        using TempDirectory input = new();
+        input.WriteLines(
+            "trades.csv",
+            "trade_id,account,instrument,quantity,settlement_date,currency,net_amount",
+            "",
+            "  T-1 , ACC-1 ,IBM.N, 100 ,2025-03-17,USD, 1000 ",
+            "   ");
+
+        TradeRecord trade = Assert.Single(Gateway.LoadTrades(input.Path));
+
+        Assert.Equal("T-1", trade.TradeId);
+        Assert.Equal("ACC-1", trade.Account);
+        Assert.Equal(100m, trade.Quantity);
+        Assert.Equal(1000m, trade.NetAmount);
+    }
+
+    [Fact]
+    public void A_missing_required_input_file_is_reported_as_an_input_error()
+    {
+        using TempDirectory input = new();
+
+        ReconciliationInputException error = Assert.Throws<ReconciliationInputException>(
+            () => Gateway.LoadTrades(input.Path));
+
+        Assert.Contains("trades.csv", error.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void The_optional_override_file_is_treated_as_empty_when_absent()
+    {
+        using TempDirectory input = new();
+
+        Assert.Empty(Gateway.LoadOverrides(input.Path));
+    }
+
+    [Fact]
+    public void A_row_with_the_wrong_column_count_names_the_file_and_line()
+    {
+        using TempDirectory input = new();
+        input.WriteLines(
+            "positions.csv",
+            "position_id,account,instrument,quantity,settlement_date,currency",
+            "P-1,ACC-1,IBM.N,100,2025-03-17");
+
+        ReconciliationInputException error = Assert.Throws<ReconciliationInputException>(
+            () => Gateway.LoadPositions(input.Path));
+
+        Assert.Contains("positions.csv", error.Message, StringComparison.Ordinal);
+        Assert.Contains("2", error.Message, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("S-1,ACC-1,IBM.N,not-a-number,2025-03-17,USD,1000")]
+    [InlineData("S-1,ACC-1,IBM.N,100,17/03/2025,USD,1000")]
+    public void Unparseable_numbers_and_dates_are_rejected_rather_than_silently_defaulted(string row)
+    {
+        using TempDirectory input = new();
+        input.WriteLines(
+            "settlements.csv",
+            "settlement_id,account,instrument,quantity,settlement_date,currency,cash_amount",
+            row);
+
+        Assert.Throws<ReconciliationInputException>(() => Gateway.LoadSettlements(input.Path));
+    }
+
+    [Fact]
+    public void Input_paths_are_confined_to_the_declared_input_directory()
+    {
+        using TempDirectory input = new();
+
+        Assert.Throws<ReconciliationInputException>(
+            () => Gateway.LoadTrades(Path.Combine(input.Path, "..", "..", "elsewhere")));
+    }
+
+    [Fact]
+    public void Matched_trades_are_written_with_the_frozen_header_and_ordinal_ordering()
+    {
+        using TempDirectory output = new();
+
+        Gateway.WriteMatchedTrades(output.Path,
+        [
+            Matched("T-2"),
+            Matched("T-1"),
+        ]);
+
+        string[] lines = File.ReadAllLines(output.Combine("matched-trades.csv"));
+        Assert.Equal(
+            "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note",
+            lines[0]);
+        Assert.StartsWith("T-1,", lines[1], StringComparison.Ordinal);
+        Assert.StartsWith("T-2,", lines[2], StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Quantities_are_published_without_trailing_zeroes_and_dates_as_iso_8601()
+    {
+        using TempDirectory output = new();
+
+        Gateway.WriteMatchedTrades(output.Path, [Matched("T-1", 1234.5m)]);
+
+        Assert.Contains("1234.5,2025-03-17,", File.ReadAllLines(output.Combine("matched-trades.csv"))[1], StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void An_empty_result_still_publishes_a_header_only_file()
+    {
+        using TempDirectory output = new();
+
+        Gateway.WriteBreakQueue(output.Path, []);
+
+        string[] lines = File.ReadAllLines(output.Combine("break-queue.csv"));
+        Assert.Equal("trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id", Assert.Single(lines));
+    }
+
+    [Fact]
+    public void The_output_directory_is_created_on_demand()
+    {
+        using TempDirectory root = new();
+        string nested = root.Combine(Path.Combine("nested", "run"));
+
+        Gateway.WriteEndOfDayReport(nested, "report body");
+
+        Assert.True(File.Exists(Path.Combine(nested, "end-of-day-report.txt")));
+    }
+
+    [Fact]
+    public void Required_output_presence_is_reported_only_when_every_artefact_exists()
+    {
+        using TempDirectory output = new();
+
+        Assert.False(Gateway.AllRequiredOutputsExist(output.Path));
+
+        Gateway.WriteMatchedTrades(output.Path, []);
+        Gateway.WriteBreakQueue(output.Path, []);
+
+        Assert.False(Gateway.AllRequiredOutputsExist(output.Path));
+
+        Gateway.WriteEndOfDayReport(output.Path, "report body");
+
+        Assert.True(Gateway.AllRequiredOutputsExist(output.Path));
+    }
+
+    private static MatchedTradeRecord Matched(string tradeId, decimal quantity = 100m) => new()
+    {
+        TradeId = tradeId,
+        Status = MatchStatuses.Matched,
+        Account = "ACC-1",
+        Instrument = "IBM.N",
+        Quantity = quantity,
+        SettlementDate = Build.Settle,
+        Currency = "USD",
+        PositionId = "P-1",
+        SettlementId = "S-1",
+        OverrideNote = null,
+    };
+}
