index 0000000..743a9a1
--- /dev/null
+++ b/src/TradeReconciliation/Application/MatchingEngine.cs
@@ -0,0 +1,389 @@
+using TradeReconciliation.Application.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Application;
+
+/// <summary>
+/// Deterministic, side-effect free reconciliation of trades against custodian positions and
+/// settlement instructions, followed by manual override adjudication.
+/// </summary>
+/// <remarks>
+/// The rules implemented here are the externally depended-upon contract for Trade Operations:
+/// <list type="number">
+/// <item>Account, instrument and currency are compared on trimmed, upper-cased values.</item>
+/// <item>The first occurrence of a trade identifier is canonical; later duplicates always break.</item>
+/// <item>Counterpart candidates must agree on account, instrument, settlement date and currency
+/// before any tolerance is evaluated.</item>
+/// <item>Positions and settlements have independent quantity tolerances; settlement cash has its own.</item>
+/// <item>Non-positive trade quantities and net amounts always break.</item>
+/// <item>Manual overrides may only resolve breaks that already have concrete counterpart candidates.</item>
+/// <item>Suppressed breaks leave an audit row in <c>matched-trades.csv</c> rather than vanishing.</item>
+/// <item>Only the first override per trade is applied; later instructions are reported as stale.</item>
+/// </list>
+/// </remarks>
+public sealed class MatchingEngine : IMatchingEngine
+{
+    private readonly ReconciliationOptions _options;
+
+    public MatchingEngine()
+        : this(ReconciliationOptions.Default)
+    {
+    }
+
+    public MatchingEngine(ReconciliationOptions options)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        options.Validate();
+        _options = options;
+    }
+
+    public ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord> trades,
+        IReadOnlyCollection<PositionRecord> positions,
+        IReadOnlyCollection<SettlementRecord> settlements,
+        IReadOnlyCollection<ManualOverrideRecord> manualOverrides)
+    {
+        ArgumentNullException.ThrowIfNull(trades);
+        ArgumentNullException.ThrowIfNull(positions);
+        ArgumentNullException.ThrowIfNull(settlements);
+        ArgumentNullException.ThrowIfNull(manualOverrides);
+
+        List<MatchedTradeRecord> matchedTrades = [];
+        List<BreakRecord> breakQueue = [];
+        List<ManualOverrideRecord> staleOverrides = [];
+
+        List<IGrouping<string, ManualOverrideRecord>> overrideGroups = manualOverrides
+            .GroupBy(record => Normalize(record.TradeId), StringComparer.Ordinal)
+            .ToList();
+
+        // Only the first instruction per trade is honoured; the rest are audited as stale.
+        Dictionary<string, ManualOverrideRecord> overrideMap = overrideGroups
+            .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
+        staleOverrides.AddRange(overrideGroups.SelectMany(group => group.Skip(1)));
+
+        Dictionary<string, List<PositionRecord>> positionsByPair = positions
+            .GroupBy(position => BuildPairKey(position.Account, position.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(position => position.PositionId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        Dictionary<string, List<SettlementRecord>> settlementsByPair = settlements
+            .GroupBy(settlement => BuildPairKey(settlement.Account, settlement.Instrument), StringComparer.Ordinal)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderBy(settlement => settlement.SettlementId, StringComparer.Ordinal).ToList(),
+                StringComparer.Ordinal);
+
+        HashSet<string> usedPositions = new(StringComparer.Ordinal);
+        HashSet<string> usedSettlements = new(StringComparer.Ordinal);
+        HashSet<string> seenTradeIds = new(StringComparer.Ordinal);
+        int duplicateTradeCount = 0;
+
+        foreach (TradeRecord trade in trades)
+        {
+            string normalizedTradeId = Normalize(trade.TradeId);
+            if (!seenTradeIds.Add(normalizedTradeId))
+            {
+                duplicateTradeCount++;
+                breakQueue.Add(CreateBreak(trade, BreakReasons.DuplicateTradeId, null, null, canManualOverride: false));
+                continue;
+            }
+
+            if (trade.Quantity <= 0m || trade.NetAmount <= 0m)
+            {
+                breakQueue.Add(CreateBreak(trade, BreakReasons.TradeValueOutOfBounds, null, null, canManualOverride: false));
+                continue;
+            }
+
+            string pairKey = BuildPairKey(trade.Account, trade.Instrument);
+            PositionRecord? position = null;
+            SettlementRecord? settlement = null;
+            List<string> reasons = [];
+
+            if (!positionsByPair.TryGetValue(pairKey, out List<PositionRecord>? positionCandidates))
+            {
+                reasons.Add(BreakReasons.MissingPosition);
+            }
+            else
+            {
+                position = FindPosition(trade, positionCandidates, usedPositions, reasons);
+            }
+
+            if (!settlementsByPair.TryGetValue(pairKey, out List<SettlementRecord>? settlementCandidates))
+            {
+                reasons.Add(BreakReasons.MissingSettlement);
+            }
+            else
+            {
+                settlement = FindSettlement(trade, settlementCandidates, usedSettlements, reasons);
+            }
+
+            if (reasons.Count == 0 && position is not null && settlement is not null)
+            {
+                usedPositions.Add(position.PositionId);
+                usedSettlements.Add(settlement.SettlementId);
+                matchedTrades.Add(CreateMatchedTrade(trade, MatchStatuses.Matched, position.PositionId, settlement.SettlementId, note: null));
+                continue;
+            }
+
+            bool hasConcreteCounterparts =
+                positionCandidates is not null &&
+                settlementCandidates is not null &&
+                reasons.All(reason => !BreakReasons.NotManuallyOverridable.Contains(reason));
+
+            breakQueue.Add(CreateBreak(
+                trade,
+                FormatReasons(reasons),
+                position?.PositionId ?? GetNearestPositionId(trade, positionCandidates),
+                settlement?.SettlementId ?? GetNearestSettlementId(trade, settlementCandidates),
+                hasConcreteCounterparts));
+        }
+
+        ApplyManualOverrides(breakQueue, matchedTrades, staleOverrides, overrideMap, manualOverrides);
+
+        return new ReconciliationResult
+        {
+            MatchedTrades = matchedTrades.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            OpenBreaks = breakQueue.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            StaleOverrides = staleOverrides.OrderBy(record => record.TradeId, StringComparer.Ordinal).ToList(),
+            TotalTradesRead = trades.Count,
+            CanonicalTradeCount = seenTradeIds.Count,
+            DuplicateTradeCount = duplicateTradeCount,
+            MatchedCount = matchedTrades.Count(record => record.Status == MatchStatuses.Matched),
+            ManualOverrideMatchedCount = matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideMatched),
+            ManualOverrideSuppressedCount = matchedTrades.Count(record => record.Status == MatchStatuses.ManualOverrideSuppressed),
+        };
+    }
+
+    private static void ApplyManualOverrides(
+        List<BreakRecord> breakQueue,
+        List<MatchedTradeRecord> matchedTrades,
+        List<ManualOverrideRecord> staleOverrides,
+        Dictionary<string, ManualOverrideRecord> overrideMap,
+        IReadOnlyCollection<ManualOverrideRecord> allOverrides)
+    {
+        HashSet<string> targetedTrades = new(StringComparer.Ordinal);
+
+        foreach (BreakRecord breakRecord in breakQueue.ToList())
+        {
+            if (!overrideMap.TryGetValue(Normalize(breakRecord.TradeId), out ManualOverrideRecord? manualOverride))
+            {
+                continue;
+            }
+
+            targetedTrades.Add(Normalize(breakRecord.TradeId));
+
+            bool isUnusable =
+                !breakRecord.CanManualOverride ||
+                string.IsNullOrWhiteSpace(manualOverride.Note) ||
+                string.IsNullOrWhiteSpace(manualOverride.ApprovedBy);
+
+            if (isUnusable)
+            {
+                staleOverrides.Add(manualOverride);
+                continue;
+            }
+
+            string? status = Normalize(manualOverride.Action) switch
+            {
+                OverrideActions.ForceMatch => MatchStatuses.ManualOverrideMatched,
+                OverrideActions.SuppressBreak => MatchStatuses.ManualOverrideSuppressed,
+                _ => null,
+            };
+
+            if (status is null)
+            {
+                staleOverrides.Add(manualOverride);
+                continue;
+            }
+
+            matchedTrades.Add(CreateMatchedTrade(breakRecord, status, manualOverride.Note));
+            breakQueue.Remove(breakRecord);
+        }
+
+        // Overrides that never met a break at all are surfaced rather than silently dropped.
+        staleOverrides.AddRange(allOverrides.Where(record =>
+            !targetedTrades.Contains(Normalize(record.TradeId)) &&
+            !ContainsSameInstance(staleOverrides, record)));
+    }
+
+    private static bool ContainsSameInstance(List<ManualOverrideRecord> knownStale, ManualOverrideRecord candidate)
+        => knownStale.Exists(existing => ReferenceEquals(existing, candidate));
+
+    private PositionRecord? FindPosition(
+        TradeRecord trade,
+        IEnumerable<PositionRecord> candidates,
+        HashSet<string> usedPositions,
+        List<string> reasons)
+    {
+        List<PositionRecord> available = candidates.Where(candidate => !usedPositions.Contains(candidate.PositionId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingPosition);
+            return null;
+        }
+
+        List<PositionRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionSettlementDateMismatch);
+            return null;
+        }
+
+        List<PositionRecord> sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.PositionCurrencyMismatch);
+            return null;
+        }
+
+        PositionRecord candidatePosition = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidatePosition.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.PositionQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidatePosition.Quantity - trade.Quantity) > _options.PositionQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.PositionQuantityOutOfTolerance);
+            return null;
+        }
+
+        return candidatePosition;
+    }
+
+    private SettlementRecord? FindSettlement(
+        TradeRecord trade,
+        IEnumerable<SettlementRecord> candidates,
+        HashSet<string> usedSettlements,
+        List<string> reasons)
+    {
+        List<SettlementRecord> available = candidates.Where(candidate => !usedSettlements.Contains(candidate.SettlementId)).ToList();
+        if (available.Count == 0)
+        {
+            reasons.Add(BreakReasons.MissingSettlement);
+            return null;
+        }
+
+        List<SettlementRecord> sameDate = available.Where(candidate => candidate.SettlementDate == trade.SettlementDate).ToList();
+        if (sameDate.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementDateMismatch);
+            return null;
+        }
+
+        List<SettlementRecord> sameCurrency = sameDate.Where(candidate => Normalize(candidate.Currency) == Normalize(trade.Currency)).ToList();
+        if (sameCurrency.Count == 0)
+        {
+            reasons.Add(BreakReasons.SettlementCurrencyMismatch);
+            return null;
+        }
+
+        SettlementRecord candidateSettlement = sameCurrency
+            .OrderBy(candidate => Math.Abs(candidate.Quantity - trade.Quantity))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .First();
+
+        if (Math.Sign(candidateSettlement.Quantity) != Math.Sign(trade.Quantity))
+        {
+            reasons.Add(BreakReasons.SettlementQuantitySignMismatch);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.Quantity - trade.Quantity) > _options.SettlementQuantityTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementQuantityOutOfTolerance);
+            return null;
+        }
+
+        if (Math.Abs(candidateSettlement.CashAmount - trade.NetAmount) > _options.SettlementAmountTolerance)
+        {
+            reasons.Add(BreakReasons.SettlementAmountOutOfTolerance);
+            return null;
+        }
+
+        return candidateSettlement;
+    }
+
+    private static string FormatReasons(IEnumerable<string> reasons)
+        => string.Join("|", reasons.Distinct(StringComparer.Ordinal).OrderBy(reason => reason, StringComparer.Ordinal));
+
+    private static string? GetNearestPositionId(TradeRecord trade, IEnumerable<PositionRecord>? candidates)
+        => candidates?
+            .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+            .ThenBy(candidate => candidate.PositionId, StringComparer.Ordinal)
+            .Select(candidate => candidate.PositionId)
+            .FirstOrDefault();
+
+    private static string? GetNearestSettlementId(TradeRecord trade, IEnumerable<SettlementRecord>? candidates)
+        => candidates?
+            .OrderBy(candidate => Math.Abs((candidate.SettlementDate - trade.SettlementDate).Ticks))
+            .ThenBy(candidate => candidate.SettlementId, StringComparer.Ordinal)
+            .Select(candidate => candidate.SettlementId)
+            .FirstOrDefault();
+
+    private static BreakRecord CreateBreak(
+        TradeRecord trade,
+        string reasons,
+        string? positionId,
+        string? settlementId,
+        bool canManualOverride) => new()
+        {
+            TradeId = Normalize(trade.TradeId),
+            Account = Normalize(trade.Account),
+            Instrument = Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = Normalize(trade.Currency),
+            Reasons = reasons,
+            PositionId = positionId,
+            SettlementId = settlementId,
+            CanManualOverride = canManualOverride,
+        };
+
+    private static MatchedTradeRecord CreateMatchedTrade(
+        TradeRecord trade,
+        string status,
+        string? positionId,
+        string? settlementId,
+        string? note) => new()
+        {
+            TradeId = Normalize(trade.TradeId),
+            Status = status,
+            Account = Normalize(trade.Account),
+            Instrument = Normalize(trade.Instrument),
+            Quantity = trade.Quantity,
+            SettlementDate = trade.SettlementDate,
+            Currency = Normalize(trade.Currency),
+            PositionId = positionId,
+            SettlementId = settlementId,
+            OverrideNote = note,
+        };
+
+    private static MatchedTradeRecord CreateMatchedTrade(BreakRecord breakRecord, string status, string? note) => new()
+    {
+        TradeId = Normalize(breakRecord.TradeId),
+        Status = status,
+        Account = Normalize(breakRecord.Account),
+        Instrument = Normalize(breakRecord.Instrument),
+        Quantity = breakRecord.Quantity,
+        SettlementDate = breakRecord.SettlementDate,
+        Currency = Normalize(breakRecord.Currency),
+        PositionId = breakRecord.PositionId,
+        SettlementId = breakRecord.SettlementId,
+        OverrideNote = note,
+    };
+
+    private static string BuildPairKey(string account, string instrument)
+        => Normalize(account) + "|" + Normalize(instrument);
+
+    private static string Normalize(string? value)
+        => (value ?? string.Empty).Trim().ToUpperInvariant();
+}
diff --git a/src/TradeReconciliation/Application/ReconciliationBatch.cs b/src/TradeReconciliation/Application/ReconciliationBatch.cs
new file mode 100644
index 0000000..1df75d6
--- /dev/null
+++ b/src/TradeReconciliation/Application/ReconciliationBatch.cs
@@ -0,0 +1,93 @@
+using TradeReconciliation.Application.Abstractions;
+using TradeReconciliation.Cli;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Application;
+
+/// <summary>
+/// Orchestrates a single reconciliation run: rerun detection, ingestion, matching,
+/// artefact production and ledger append. All I/O is performed through injected
+/// abstractions so the orchestration is testable without touching the file system.
+/// </summary>
+public sealed class ReconciliationBatch
+{
+    private readonly IReconciliationDataSource _dataSource;
+    private readonly IReconciliationOutputSink _outputSink;
+    private readonly IMatchingEngine _matchingEngine;
+    private readonly IEndOfDayReportBuilder _reportBuilder;
+    private readonly IInputSignatureCalculator _signatureCalculator;
+    private readonly IRunLedgerFactory _ledgerFactory;
+
+    public ReconciliationBatch(
+        IReconciliationDataSource dataSource,
+        IReconciliationOutputSink outputSink,
+        IMatchingEngine matchingEngine,
+        IEndOfDayReportBuilder reportBuilder,
+        IInputSignatureCalculator signatureCalculator,
+        IRunLedgerFactory ledgerFactory)
+    {
+        ArgumentNullException.ThrowIfNull(dataSource);
+        ArgumentNullException.ThrowIfNull(outputSink);
+        ArgumentNullException.ThrowIfNull(matchingEngine);
+        ArgumentNullException.ThrowIfNull(reportBuilder);
+        ArgumentNullException.ThrowIfNull(signatureCalculator);
+        ArgumentNullException.ThrowIfNull(ledgerFactory);
+
+        _dataSource = dataSource;
+        _outputSink = outputSink;
+        _matchingEngine = matchingEngine;
+        _reportBuilder = reportBuilder;
+        _signatureCalculator = signatureCalculator;
+        _ledgerFactory = ledgerFactory;
+    }
+
+    public BatchOutcome Run(RunRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        Directory.CreateDirectory(request.OutputDirectory);
+
+        string inputSignature = _signatureCalculator.Calculate(request.BusinessDate, request.InputDirectory);
+        IRunLedger ledger = _ledgerFactory.Create(request.OutputDirectory);
+
+        if (ledger.Exists(request.BusinessDate, inputSignature) &&
+            _outputSink.AllRequiredOutputsExist(request.OutputDirectory))
+        {
+            return new BatchOutcome
+            {
+                Completion = BatchCompletion.IdempotentRerun,
+                BusinessDate = request.BusinessDate,
+                InputSignature = inputSignature,
+            };
+        }
+
+        ReconciliationResult result = _matchingEngine.Reconcile(
+            _dataSource.LoadTrades(request.InputDirectory),
+            _dataSource.LoadPositions(request.InputDirectory),
+            _dataSource.LoadSettlements(request.InputDirectory),
+            _dataSource.LoadOverrides(request.InputDirectory));
+
+        _outputSink.WriteMatchedTrades(request.OutputDirectory, result.MatchedTrades);
+        _outputSink.WriteBreakQueue(request.OutputDirectory, result.OpenBreaks);
+        _outputSink.WriteEndOfDayReport(request.OutputDirectory, _reportBuilder.BuildReport(request.BusinessDate, result));
+
+        ledger.AppendIfMissing(new RunLedgerEntry
+        {
+            BusinessDate = request.BusinessDate,
+            InputSignature = inputSignature,
+            TotalTradesRead = result.TotalTradesRead,
+            OpenBreakCount = result.OpenBreaks.Count,
+
+            // Intentionally every matched row, including manual override audit rows.
+            MatchedCount = result.MatchedTrades.Count,
+        });
+
+        return new BatchOutcome
+        {
+            Completion = BatchCompletion.Processed,
+            BusinessDate = request.BusinessDate,
+            InputSignature = inputSignature,
+            Result = result,
+        };
+    }
+}
diff --git a/src/TradeReconciliation/Cli/BatchHost.cs b/src/TradeReconciliation/Cli/BatchHost.cs
new file mode 100644
index 0000000..69a5507
--- /dev/null
+++ b/src/TradeReconciliation/Cli/BatchHost.cs
@@ -0,0 +1,91 @@
+using System.Globalization;
+using TradeReconciliation.Application;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Infrastructure;
+using TradeReconciliation.Infrastructure.Csv;
+
+namespace TradeReconciliation.Cli;
+
+/// <summary>
+/// Composition root and console shell. Keeping this separate from <see cref="Program"/> lets the
+/// whole command-line surface, including exit codes and console text, be exercised by tests.
+/// </summary>
+public static class BatchHost
+{
+    private static readonly string[] HelpSwitches = ["-h", "--help", "-?", "/?", "/h"];
+
+    public static int Run(string[]? args, TextWriter standardOutput, TextWriter standardError)
+    {
+        ArgumentNullException.ThrowIfNull(standardOutput);
+        ArgumentNullException.ThrowIfNull(standardError);
+
+        if (args is { Length: 1 } && HelpSwitches.Contains(args[0], StringComparer.OrdinalIgnoreCase))
+        {
+            standardOutput.WriteLine(RunRequest.Usage);
+            return ExitCodes.Success;
+        }
+
+        try
+        {
+            RunRequest request = RunRequest.Resolve(args);
+            BatchOutcome outcome = CreateBatch().Run(request);
+            standardOutput.WriteLine(DescribeOutcome(outcome));
+            return ExitCodes.Success;
+        }
+        catch (CommandLineException exception)
+        {
+            standardError.WriteLine(exception.Message);
+            standardError.WriteLine(RunRequest.Usage);
+            return ExitCodes.UsageError;
+        }
+        catch (ReconciliationInputException exception)
+        {
+            standardError.WriteLine(exception.Message);
+            return ExitCodes.InputError;
+        }
+        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
+        {
+            standardError.WriteLine("Batch input/output failed: " + exception.Message);
+            return ExitCodes.InputError;
+        }
+    }
+
+    /// <summary>Builds the batch from its production collaborators.</summary>
+    public static ReconciliationBatch CreateBatch()
+    {
+        CsvFileGateway gateway = new();
+        return new ReconciliationBatch(
+            gateway,
+            gateway,
+            new MatchingEngine(),
+            new EndOfDayReportBuilder(),
+            new InputSignatureCalculator(),
+            new RunLedgerStoreFactory());
+    }
+
+    /// <summary>
+    /// Produces the operator-facing completion line. The wording is part of the observable
+    /// behaviour Trade Operations scrapes from batch logs.
+    /// </summary>
+    internal static string DescribeOutcome(BatchOutcome outcome)
+    {
+        ArgumentNullException.ThrowIfNull(outcome);
+
+        if (outcome.Completion == BatchCompletion.IdempotentRerun)
+        {
+            return "Exact rerun detected for " +
+                   outcome.BusinessDate.ToString(RunRequest.DateFormat, CultureInfo.InvariantCulture) +
+                   ". Existing outputs were retained.";
+        }
+
+        ReconciliationResult result = outcome.Result
+            ?? throw new InvalidOperationException("A processed batch outcome must carry a reconciliation result.");
+
+        return string.Format(
+            CultureInfo.InvariantCulture,
+            "Processed {0} trades into {1} matched rows and {2} open breaks.",
+            result.TotalTradesRead,
+            result.MatchedTrades.Count,
+            result.OpenBreaks.Count);
+    }
+}
