+namespace TradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Raised when batch inputs are missing or malformed. Carries an operator-friendly message
+/// that never includes file contents, so break data cannot leak into logs.
+/// </summary>
+public sealed class ReconciliationInputException : Exception
+{
+    public ReconciliationInputException(string message)
+        : base(message)
+    {
+    }
+
+    public ReconciliationInputException(string message, Exception innerException)
+        : base(message, innerException)
+    {
+    }
+}
