+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Application;
+
+/// <summary>Why the batch finished the way it did.</summary>
+public enum BatchCompletion
+{
+    /// <summary>Inputs were reconciled and all artefacts were rewritten.</summary>
+    Processed,
+
+    /// <summary>An identical run already exists for the business date; outputs were retained.</summary>
+    IdempotentRerun,
+}
+
+/// <summary>Machine-readable summary of a single batch invocation.</summary>
+public sealed class BatchOutcome
+{
+    public required BatchCompletion Completion { get; init; }
+
+    public required DateTime BusinessDate { get; init; }
+
+    public required string InputSignature { get; init; }
+
+    /// <summary>Null when the run short-circuited as an idempotent rerun.</summary>
+    public ReconciliationResult? Result { get; init; }
+}
