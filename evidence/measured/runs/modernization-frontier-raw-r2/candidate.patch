diff --git a/src/TradeReconciliation/Infrastructure/Csv/CsvCells.cs b/src/TradeReconciliation/Infrastructure/Csv/CsvCells.cs
new file mode 100644
index 0000000..7f1fdcc
--- /dev/null
+++ b/src/TradeReconciliation/Infrastructure/Csv/CsvCells.cs
@@ -0,0 +1,71 @@
+using System.Globalization;
+
+namespace TradeReconciliation.Infrastructure.Csv;
+
+/// <summary>
+/// Minimal, strict CSV field handling for the synthetic batch formats.
+/// </summary>
+/// <remarks>
+/// The input contract has no quoting: a row must contain exactly the expected number of
+/// comma separated cells, so an embedded comma is a hard error rather than a silent
+/// mis-parse. Because malformed rows are rejected on ingestion, no produced cell can ever
+/// contain a separator, which keeps the emitted files well formed without quoting.
+/// </remarks>
+internal static class CsvCells
+{
+    public static string[] Split(string line, int expectedCellCount, string fileName, int lineNumber)
+    {
+        string[] cells = line.Split(',');
+        if (cells.Length != expectedCellCount)
+        {
+            throw new ReconciliationInputException(
+                $"Unexpected csv format in '{fileName}' line {lineNumber.ToString(CultureInfo.InvariantCulture)}: " +
+                $"expected {expectedCellCount.ToString(CultureInfo.InvariantCulture)} cells but found " +
+                $"{cells.Length.ToString(CultureInfo.InvariantCulture)}.");
+        }
+
+        for (int index = 0; index < cells.Length; index++)
+        {
+            cells[index] = cells[index].Trim();
+        }
+
+        return cells;
+    }
+
+    public static decimal ParseDecimal(string value, string columnName, string fileName, int lineNumber)
+    {
+        if (!decimal.TryParse(
+                value,
+                NumberStyles.Number | NumberStyles.AllowLeadingSign,
+                CultureInfo.InvariantCulture,
+                out decimal parsed))
+        {
+            throw new ReconciliationInputException(
+                $"Invalid decimal in column '{columnName}' of '{fileName}' line {lineNumber.ToString(CultureInfo.InvariantCulture)}.");
+        }
+
+        return parsed;
+    }
+
+    public static DateTime ParseDate(string value, string columnName, string fileName, int lineNumber)
+    {
+        if (!DateTime.TryParseExact(
+                value,
+                "yyyy-MM-dd",
+                CultureInfo.InvariantCulture,
+                DateTimeStyles.None,
+                out DateTime parsed))
+        {
+            throw new ReconciliationInputException(
+                $"Invalid yyyy-MM-dd date in column '{columnName}' of '{fileName}' line {lineNumber.ToString(CultureInfo.InvariantCulture)}.");
+        }
+
+        return parsed;
+    }
+
+    /// <summary>Renders a quantity or amount using the published output format.</summary>
+    public static string FormatDecimal(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);
+
+    /// <summary>Renders a settlement or business date using the published output format.</summary>
+    public static string FormatDate(DateTime value) => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+}
diff --git a/src/TradeReconciliation/Infrastructure/Csv/CsvFileGateway.cs b/src/TradeReconciliation/Infrastructure/Csv/CsvFileGateway.cs
new file mode 100644
index 0000000..07887f5
--- /dev/null
+++ b/src/TradeReconciliation/Infrastructure/Csv/CsvFileGateway.cs
@@ -0,0 +1,194 @@
+using TradeReconciliation.Application.Abstractions;
+using TradeReconciliation.Configuration;
+using TradeReconciliation.Domain;
+
+namespace TradeReconciliation.Infrastructure.Csv;
+
+/// <summary>
+/// File-system backed ingestion and publication of the batch CSV contract.
+/// </summary>
+public sealed class CsvFileGateway : IReconciliationDataSource, IReconciliationOutputSink
+{
+    internal const string MatchedTradesHeader =
+        "trade_id,status,account,instrument,quantity,settlement_date,currency,position_id,settlement_id,override_note";
+
+    internal const string BreakQueueHeader =
+        "trade_id,account,instrument,quantity,settlement_date,currency,reasons,position_id,settlement_id";
+
+    public IReadOnlyList<TradeRecord> LoadTrades(string inputDirectory)
+        => ReadRequired(inputDirectory, BatchFileNames.Trades, static (cells, file, line) => new TradeRecord
+        {
+            TradeId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = CsvCells.ParseDecimal(cells[3], "quantity", file, line),
+            SettlementDate = CsvCells.ParseDate(cells[4], "settlement_date", file, line),
+            Currency = cells[5],
+            NetAmount = CsvCells.ParseDecimal(cells[6], "net_amount", file, line),
+        }, expectedCellCount: 7);
+
+    public IReadOnlyList<PositionRecord> LoadPositions(string inputDirectory)
+        => ReadRequired(inputDirectory, BatchFileNames.Positions, static (cells, file, line) => new PositionRecord
+        {
+            PositionId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = CsvCells.ParseDecimal(cells[3], "quantity", file, line),
+            SettlementDate = CsvCells.ParseDate(cells[4], "settlement_date", file, line),
+            Currency = cells[5],
+        }, expectedCellCount: 6);
+
+    public IReadOnlyList<SettlementRecord> LoadSettlements(string inputDirectory)
+        => ReadRequired(inputDirectory, BatchFileNames.Settlements, static (cells, file, line) => new SettlementRecord
+        {
+            SettlementId = cells[0],
+            Account = cells[1],
+            Instrument = cells[2],
+            Quantity = CsvCells.ParseDecimal(cells[3], "quantity", file, line),
+            SettlementDate = CsvCells.ParseDate(cells[4], "settlement_date", file, line),
+            Currency = cells[5],
+            CashAmount = CsvCells.ParseDecimal(cells[6], "cash_amount", file, line),
+        }, expectedCellCount: 7);
+
+    public IReadOnlyList<ManualOverrideRecord> LoadOverrides(string inputDirectory)
+    {
+        string path = ResolveInputPath(inputDirectory, BatchFileNames.Overrides);
+        if (!File.Exists(path))
+        {
+            return [];
+        }
+
+        return Parse(path, BatchFileNames.Overrides, expectedCellCount: 4, static (cells, _, _) => new ManualOverrideRecord
+        {
+            TradeId = cells[0],
+            Action = cells[1],
+            Note = cells[2],
+            ApprovedBy = cells[3],
+        });
+    }
+
+    public void WriteMatchedTrades(string outputDirectory, IReadOnlyCollection<MatchedTradeRecord> matchedTrades)
+    {
+        ArgumentNullException.ThrowIfNull(matchedTrades);
+
+        List<string> lines = [MatchedTradesHeader];
+        lines.AddRange(matchedTrades
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ",",
+                record.TradeId,
+                record.Status,
+                record.Account,
+                record.Instrument,
+                CsvCells.FormatDecimal(record.Quantity),
+                CsvCells.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty,
+                record.OverrideNote ?? string.Empty)));
+
+        File.WriteAllLines(ResolveWritePath(outputDirectory, BatchFileNames.MatchedTrades), lines);
+    }
+
+    public void WriteBreakQueue(string outputDirectory, IReadOnlyCollection<BreakRecord> breakQueue)
+    {
+        ArgumentNullException.ThrowIfNull(breakQueue);
+
+        List<string> lines = [BreakQueueHeader];
+        lines.AddRange(breakQueue
+            .OrderBy(record => record.TradeId, StringComparer.Ordinal)
+            .ThenBy(record => record.Reasons, StringComparer.Ordinal)
+            .Select(record => string.Join(
+                ",",
+                record.TradeId,
+                record.Account,
+                record.Instrument,
+                CsvCells.FormatDecimal(record.Quantity),
+                CsvCells.FormatDate(record.SettlementDate),
+                record.Currency,
+                record.Reasons,
+                record.PositionId ?? string.Empty,
+                record.SettlementId ?? string.Empty)));
+
+        File.WriteAllLines(ResolveWritePath(outputDirectory, BatchFileNames.BreakQueue), lines);
+    }
+
+    public void WriteEndOfDayReport(string outputDirectory, string reportText)
+        => File.WriteAllText(ResolveWritePath(outputDirectory, BatchFileNames.EndOfDayReport), reportText);
+
+    public bool AllRequiredOutputsExist(string outputDirectory)
+        => BatchFileNames.RequiredForCompleteRun.All(fileName => File.Exists(ResolveOutputPath(outputDirectory, fileName)));
+
+    private static List<T> ReadRequired<T>(
+        string inputDirectory,
+        string fileName,
+        Func<string[], string, int, T> projection,
+        int expectedCellCount)
+    {
+        string path = ResolveInputPath(inputDirectory, fileName);
+        if (!File.Exists(path))
+        {
+            throw new ReconciliationInputException($"Required input file '{fileName}' was not found in the input directory.");
+        }
+
+        return Parse(path, fileName, expectedCellCount, projection);
+    }
+
+    private static List<T> Parse<T>(
+        string path,
+        string fileName,
+        int expectedCellCount,
+        Func<string[], string, int, T> projection)
+    {
+        List<T> records = [];
+        int lineNumber = 0;
+
+        foreach (string line in File.ReadLines(path))
+        {
+            lineNumber++;
+            if (lineNumber == 1 || string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            string[] cells = CsvCells.Split(line, expectedCellCount, fileName, lineNumber);
+            records.Add(projection(cells, fileName, lineNumber));
+        }
+
+        return records;
+    }
+
+    /// <summary>
+    /// Joins a fixed, code-owned file name onto a caller supplied directory and verifies the
+    /// result stays inside that directory, so a hostile directory argument cannot be used to
+    /// reach unrelated files.
+    /// </summary>
+    private static string ResolveInputPath(string directory, string fileName) => ResolvePath(directory, fileName);
+
+    private static string ResolveOutputPath(string directory, string fileName) => ResolvePath(directory, fileName);
+
+    /// <summary>Resolves an output path and guarantees its directory exists before writing.</summary>
+    private static string ResolveWritePath(string directory, string fileName)
+    {
+        string path = ResolvePath(directory, fileName);
+        Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+        return path;
+    }
+
+    private static string ResolvePath(string directory, string fileName)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(directory);
+
+        string root = Path.GetFullPath(directory);
+        string candidate = Path.GetFullPath(Path.Combine(root, fileName));
+
+        if (!candidate.StartsWith(
+                root.EndsWith(Path.DirectorySeparatorChar) ? root : root + Path.DirectorySeparatorChar,
+                StringComparison.OrdinalIgnoreCase))
+        {
+            throw new ReconciliationInputException($"Resolved path for '{fileName}' escapes the requested directory.");
+        }
+
+        return candidate;
+    }
+}
diff --git a/src/TradeReconciliation/Infrastructure/InputSignatureCalculator.cs b/src/TradeReconciliation/Infrastructure/InputSignatureCalculator.cs
new file mode 100644
index 0000000..a4f62e6
--- /dev/null
+++ b/src/TradeReconciliation/Infrastructure/InputSignatureCalculator.cs
@@ -0,0 +1,36 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using TradeReconciliation.Application.Abstractions;
+
+namespace TradeReconciliation.Infrastructure;
+
+/// <summary>
+/// Derives a stable SHA-256 fingerprint of the business date plus every file in the input
+/// directory. Two invocations with byte-identical inputs produce the same signature, which is
+/// what makes reruns idempotent.
+/// </summary>
+public sealed class InputSignatureCalculator : IInputSignatureCalculator
+{
+    public string Calculate(DateTime businessDate, string inputDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(inputDirectory);
+
+        if (!Directory.Exists(inputDirectory))
+        {
+            throw new ReconciliationInputException($"Input directory '{inputDirectory}' does not exist.");
+        }
+
+        StringBuilder payload = new();
+        payload.AppendLine(businessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
+
+        foreach (string filePath in Directory.GetFiles(inputDirectory).OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
+        {
+            payload.AppendLine(Path.GetFileName(filePath));
+            payload.AppendLine(File.ReadAllText(filePath));
+        }
+
+        byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(payload.ToString()));
+        return Convert.ToHexString(hash).ToLowerInvariant();
+    }
+}
