+using TradeReconciliation.Application;
+using TradeReconciliation.Cli;
+using TradeReconciliation.Domain;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Golden-master tests that lock in the observable file contract against fixtures captured
+/// from the pre-modernization batch. Comparisons normalize line endings so the assertions do
+/// not depend on how Git checked the fixtures out.
+/// </summary>
+public sealed class GoldenMasterTests
+{
+    private static string FixtureRoot(string name)
+        => Path.Combine(AppContext.BaseDirectory, "Fixtures", name);
+
+    private static BatchOutcome Execute(string fixtureRoot, string outputDirectory)
+        => BatchHost.CreateBatch().Run(new RunRequest
+        {
+            BusinessDate = new DateTime(2025, 3, 17),
+            InputDirectory = Path.Combine(fixtureRoot, "input"),
+            OutputDirectory = outputDirectory,
+        });
+
+    private static void AssertMatchesExpected(string fixtureRoot, string outputDirectory, string fileName)
+    {
+        string expected = File.ReadAllText(Path.Combine(fixtureRoot, "expected", fileName));
+        string actual = File.ReadAllText(Path.Combine(outputDirectory, fileName));
+        Assert.Equal(Normalize(expected), Normalize(actual));
+    }
+
+    private static string Normalize(string value) => value.Replace("\r\n", "\n", StringComparison.Ordinal);
+
+    [Fact]
+    public void Baseline_fixture_reproduces_the_frozen_break_queue_and_report()
+    {
+        using TempDirectory output = new();
+        string fixtureRoot = FixtureRoot("baseline");
+
+        BatchOutcome outcome = Execute(fixtureRoot, output.Path);
+
+        Assert.Equal(BatchCompletion.Processed, outcome.Completion);
+        AssertMatchesExpected(fixtureRoot, output.Path, "break-queue.csv");
+        AssertMatchesExpected(fixtureRoot, output.Path, "end-of-day-report.txt");
+    }
+
+    [Fact]
+    public void Override_fixture_reproduces_all_three_frozen_artefacts()
+    {
+        using TempDirectory output = new();
+        string fixtureRoot = FixtureRoot("override-rerun");
+
+        Execute(fixtureRoot, output.Path);
+
+        AssertMatchesExpected(fixtureRoot, output.Path, "matched-trades.csv");
+        AssertMatchesExpected(fixtureRoot, output.Path, "break-queue.csv");
+        AssertMatchesExpected(fixtureRoot, output.Path, "end-of-day-report.txt");
+    }
+
+    [Fact]
+    public void Every_run_publishes_all_four_declared_output_files()
+    {
+        using TempDirectory output = new();
+
+        Execute(FixtureRoot("baseline"), output.Path);
+
+        foreach (string fileName in new[] { "matched-trades.csv", "break-queue.csv", "end-of-day-report.txt", "run-ledger.csv" })
+        {
+            Assert.True(File.Exists(output.Combine(fileName)), fileName + " should have been written.");
+        }
+    }
+
+    [Fact]
+    public void Exact_input_rerun_is_idempotent_and_does_not_grow_the_ledger()
+    {
+        using TempDirectory output = new();
+        string fixtureRoot = FixtureRoot("override-rerun");
+
+        Execute(fixtureRoot, output.Path);
+
+        string firstMatched = output.ReadText("matched-trades.csv");
+        string firstBreaks = output.ReadText("break-queue.csv");
+        string firstReport = output.ReadText("end-of-day-report.txt");
+        string firstLedger = output.ReadText("run-ledger.csv");
+
+        BatchOutcome rerun = Execute(fixtureRoot, output.Path);
+
+        Assert.Equal(BatchCompletion.IdempotentRerun, rerun.Completion);
+        Assert.Equal(firstMatched, output.ReadText("matched-trades.csv"));
+        Assert.Equal(firstBreaks, output.ReadText("break-queue.csv"));
+        Assert.Equal(firstReport, output.ReadText("end-of-day-report.txt"));
+        Assert.Equal(firstLedger, output.ReadText("run-ledger.csv"));
+        Assert.Single(firstLedger.Split('\n', StringSplitOptions.RemoveEmptyEntries).Skip(1));
+    }
+
+    [Fact]
+    public void Changed_inputs_for_the_same_business_date_append_a_second_ledger_row()
+    {
+        using TempDirectory workspace = new();
+        using TempDirectory output = new();
+        string input = workspace.Combine("input");
+        Directory.CreateDirectory(input);
+        CopyFixtureInput("override-rerun", input);
+
+        BatchHost.CreateBatch().Run(Request(input, output.Path));
+
+        File.AppendAllText(
+            Path.Combine(input, "trades.csv"),
+            "T-9999,ACC-009,IBM.N,10,2025-03-17,USD,100" + Environment.NewLine);
+
+        BatchOutcome second = BatchHost.CreateBatch().Run(Request(input, output.Path));
+
+        Assert.Equal(BatchCompletion.Processed, second.Completion);
+        string[] ledgerRows = File.ReadAllLines(output.Combine("run-ledger.csv"));
+        Assert.Equal("business_date,input_signature,total_trades_read,open_break_count,matched_count", ledgerRows[0]);
+        Assert.Equal(3, ledgerRows.Length);
+    }
+
+    [Fact]
+    public void Duplicate_override_instructions_are_audited_as_stale()
+    {
+        using TempDirectory workspace = new();
+        using TempDirectory output = new();
+        string input = workspace.Combine("input");
+        Directory.CreateDirectory(input);
+        CopyFixtureInput("override-rerun", input);
+
+        File.AppendAllText(
+            Path.Combine(input, "overrides.csv"),
+            "T-1003,ForceMatch,Superseded duplicate instruction,ops-manager" + Environment.NewLine);
+
+        BatchHost.CreateBatch().Run(Request(input, output.Path));
+
+        string report = output.ReadText("end-of-day-report.txt");
+        Assert.Contains("Stale Overrides: 1", report, StringComparison.Ordinal);
+        Assert.Contains("T-1003: ForceMatch (ops-manager)", report, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Missing_output_files_force_a_full_reprocess_even_when_the_ledger_matches()
+    {
+        using TempDirectory output = new();
+        string fixtureRoot = FixtureRoot("baseline");
+
+        Execute(fixtureRoot, output.Path);
+        File.Delete(output.Combine("break-queue.csv"));
+
+        BatchOutcome outcome = Execute(fixtureRoot, output.Path);
+
+        Assert.Equal(BatchCompletion.Processed, outcome.Completion);
+        Assert.True(File.Exists(output.Combine("break-queue.csv")));
+    }
+
+    private static RunRequest Request(string input, string output) => new()
+    {
+        BusinessDate = new DateTime(2025, 3, 17),
+        InputDirectory = input,
+        OutputDirectory = output,
+    };
+
+    private static void CopyFixtureInput(string fixtureName, string destination)
+    {
+        string source = Path.Combine(FixtureRoot(fixtureName), "input");
+        foreach (string file in Directory.GetFiles(source))
+        {
+            File.Copy(file, Path.Combine(destination, Path.GetFileName(file)), overwrite: true);
+        }
+    }
+}
