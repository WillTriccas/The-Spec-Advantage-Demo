@@ -0,0 +1,264 @@
+using TradeReconciliation.Application;
+using TradeReconciliation.Domain;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>
+/// Rule-level tests for the reconciliation decisions. These pin the behaviours that the
+/// golden-master fixtures only cover incidentally, so a regression points at the exact rule.
+/// </summary>
+public sealed class MatchingEngineTests
+{
+    private static readonly MatchingEngine Engine = new();
+
+    private static ReconciliationResult Reconcile(
+        IReadOnlyCollection<TradeRecord>? trades = null,
+        IReadOnlyCollection<PositionRecord>? positions = null,
+        IReadOnlyCollection<SettlementRecord>? settlements = null,
+        IReadOnlyCollection<ManualOverrideRecord>? overrides = null)
+        => Engine.Reconcile(
+            trades ?? [],
+            positions ?? [],
+            settlements ?? [],
+            overrides ?? []);
+
+    private static BreakRecord SingleBreak(ReconciliationResult result) => Assert.Single(result.OpenBreaks);
+
+    [Fact]
+    public void A_trade_with_matching_position_and_settlement_is_matched_without_a_break()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade()],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.Matched, matched.Status);
+        Assert.Equal("P-1", matched.PositionId);
+        Assert.Equal("S-1", matched.SettlementId);
+        Assert.Empty(result.OpenBreaks);
+        Assert.Equal(1, result.MatchedCount);
+    }
+
+    [Fact]
+    public void Account_and_instrument_keys_are_matched_case_insensitively_after_trimming()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(account: " acc-1 ", instrument: "ibm.n")],
+            [Build.Position(account: "ACC-1", instrument: "IBM.N")],
+            [Build.Settlement(account: "ACC-1", instrument: "IBM.N")]);
+
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+    }
+
+    [Fact]
+    public void A_position_is_consumed_by_the_first_trade_and_is_unavailable_to_the_second()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade("T-1"), Build.Trade("T-2")],
+            [Build.Position()],
+            [Build.Settlement("S-1"), Build.Settlement("S-2")]);
+
+        BreakRecord unmatched = SingleBreak(result);
+        Assert.Equal("T-2", unmatched.TradeId);
+        Assert.Contains(BreakReasons.MissingPosition, unmatched.Reasons, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Quantity_drift_inside_the_position_tolerance_still_matches()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 100.01m)],
+            [Build.Settlement(quantity: 100m)]);
+
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+    }
+
+    [Fact]
+    public void Quantity_drift_beyond_the_position_tolerance_raises_a_quantity_mismatch_break()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 105m)],
+            [Build.Settlement(quantity: 100m)]);
+
+        Assert.Contains(BreakReasons.PositionQuantityOutOfTolerance, SingleBreak(result).Reasons, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_settlement_cash_difference_beyond_tolerance_raises_a_cash_break()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(netAmount: 1000m)],
+            [Build.Position()],
+            [Build.Settlement(cashAmount: 1200m)]);
+
+        Assert.Contains(BreakReasons.SettlementAmountOutOfTolerance, SingleBreak(result).Reasons, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Currency_and_settlement_date_differences_are_reported_as_distinct_reasons()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade()],
+            [Build.Position(currency: "EUR")],
+            [Build.Settlement(settlementDate: Build.Settle.AddDays(1))]);
+
+        BreakRecord raised = SingleBreak(result);
+        Assert.Contains(BreakReasons.PositionCurrencyMismatch, raised.Reasons, StringComparison.Ordinal);
+        Assert.Contains(BreakReasons.SettlementDateMismatch, raised.Reasons, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Opposite_signed_candidates_are_rejected_rather_than_matched()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: -100m)],
+            [Build.Settlement(quantity: 100m)]);
+
+        Assert.Contains(BreakReasons.PositionQuantitySignMismatch, SingleBreak(result).Reasons, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_repeated_trade_id_keeps_the_first_occurrence_and_breaks_the_duplicate()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade("T-1", account: "ACC-1"), Build.Trade("T-1", account: "ACC-2")],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Equal(2, result.TotalTradesRead);
+        Assert.Contains(BreakReasons.DuplicateTradeId, SingleBreak(result).Reasons, StringComparison.Ordinal);
+        Assert.Equal(MatchStatuses.Matched, Assert.Single(result.MatchedTrades).Status);
+    }
+
+    [Theory]
+    [InlineData(0, 1000)]
+    [InlineData(-5, 1000)]
+    [InlineData(100, 0)]
+    [InlineData(100, -25)]
+    public void Non_positive_quantities_or_amounts_are_rejected_as_out_of_bounds(decimal quantity, decimal netAmount)
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: quantity, netAmount: netAmount)],
+            [Build.Position()],
+            [Build.Settlement()]);
+
+        Assert.Contains(BreakReasons.TradeValueOutOfBounds, SingleBreak(result).Reasons, StringComparison.Ordinal);
+        Assert.Empty(result.MatchedTrades);
+    }
+
+    [Fact]
+    public void An_approved_override_converts_a_tolerance_break_into_a_manually_matched_row()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 105m)],
+            [Build.Settlement(quantity: 100m)],
+            [Build.Override()]);
+
+        MatchedTradeRecord matched = Assert.Single(result.MatchedTrades);
+        Assert.Equal(MatchStatuses.ManualOverrideMatched, matched.Status);
+        Assert.Empty(result.OpenBreaks);
+        Assert.Empty(result.StaleOverrides);
+        Assert.Equal(0, result.MatchedCount);
+    }
+
+    [Fact]
+    public void Only_the_first_override_for_a_trade_applies_and_later_ones_become_stale()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 105m)],
+            [Build.Settlement(quantity: 100m)],
+            [Build.Override(note: "First"), Build.Override(note: "Second")]);
+
+        Assert.Single(result.MatchedTrades);
+        ManualOverrideRecord stale = Assert.Single(result.StaleOverrides);
+        Assert.Equal("Second", stale.Note);
+    }
+
+    [Fact]
+    public void An_override_that_targets_no_break_is_recorded_as_stale()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade()],
+            [Build.Position()],
+            [Build.Settlement()],
+            [Build.Override("T-does-not-exist")]);
+
+        Assert.Equal("T-does-not-exist", Assert.Single(result.StaleOverrides).TradeId);
+    }
+
+    [Theory]
+    [InlineData("", "ops-manager", "ForceMatch")]
+    [InlineData("   ", "ops-manager", "ForceMatch")]
+    [InlineData("Approved", "", "ForceMatch")]
+    [InlineData("Approved", "ops-manager", "DeleteTrade")]
+    public void Overrides_missing_governance_data_or_using_an_unknown_action_are_stale(
+        string note, string approvedBy, string action)
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position(quantity: 105m)],
+            [Build.Settlement(quantity: 100m)],
+            [Build.Override(action: action, note: note, approvedBy: approvedBy)]);
+
+        Assert.Single(result.StaleOverrides);
+        Assert.Single(result.OpenBreaks);
+        Assert.Empty(result.MatchedTrades);
+    }
+
+    [Theory]
+    [InlineData(BreakReasons.MissingPosition)]
+    [InlineData(BreakReasons.MissingSettlement)]
+    public void Structural_breaks_cannot_be_overridden_and_the_instruction_goes_stale(string expectedReason)
+    {
+        bool missingPosition = expectedReason == BreakReasons.MissingPosition;
+
+        ReconciliationResult result = Reconcile(
+            [Build.Trade()],
+            missingPosition ? [] : [Build.Position()],
+            missingPosition ? [Build.Settlement()] : [],
+            [Build.Override()]);
+
+        Assert.Contains(expectedReason, SingleBreak(result).Reasons, StringComparison.Ordinal);
+        Assert.Single(result.StaleOverrides);
+    }
+
+    [Fact]
+    public void Results_are_ordered_by_trade_id_so_downstream_diffs_stay_stable()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade("T-3"), Build.Trade("T-1"), Build.Trade("T-2")],
+            [Build.Position("P-3"), Build.Position("P-1"), Build.Position("P-2")],
+            [Build.Settlement("S-3"), Build.Settlement("S-1"), Build.Settlement("S-2")]);
+
+        Assert.Equal(["T-1", "T-2", "T-3"], result.MatchedTrades.Select(trade => trade.TradeId));
+    }
+
+    [Fact]
+    public void The_closest_quantity_candidate_is_preferred_over_a_more_distant_one()
+    {
+        ReconciliationResult result = Reconcile(
+            [Build.Trade(quantity: 100m)],
+            [Build.Position("P-far", quantity: 150m), Build.Position("P-near", quantity: 100m)],
+            [Build.Settlement()]);
+
+        Assert.Equal("P-near", Assert.Single(result.MatchedTrades).PositionId);
+    }
+
+    [Fact]
+    public void An_empty_batch_produces_an_empty_but_well_formed_result()
+    {
+        ReconciliationResult result = Reconcile();
+
+        Assert.Equal(0, result.TotalTradesRead);
+        Assert.Empty(result.MatchedTrades);
+        Assert.Empty(result.OpenBreaks);
+        Assert.Empty(result.StaleOverrides);
+    }
+}
