+using System.Globalization;
+using TradeReconciliation.Application;
+using TradeReconciliation.Domain;
+using TradeReconciliation.Infrastructure;
+using Xunit;
+
+namespace TradeReconciliation.Tests;
+
+/// <summary>The audit ledger and the signature that drives idempotent reruns.</summary>
+public sealed class RunLedgerAndSignatureTests
+{
+    private static readonly DateTime BusinessDate = new(2025, 3, 17);
+
+    private static RunLedgerEntry Entry(string signature, int trades = 10, int breaks = 2, int matched = 8) => new()
+    {
+        BusinessDate = BusinessDate,
+        InputSignature = signature,
+        TotalTradesRead = trades,
+        OpenBreakCount = breaks,
+        MatchedCount = matched,
+    };
+
+    [Fact]
+    public void A_new_ledger_is_created_with_the_frozen_header_on_first_append()
+    {
+        using TempDirectory output = new();
+        RunLedgerStore store = new(output.Combine("run-ledger.csv"));
+
+        store.AppendIfMissing(Entry("abc123"));
+
+        string[] lines = File.ReadAllLines(output.Combine("run-ledger.csv"));
+        Assert.Equal("business_date,input_signature,total_trades_read,open_break_count,matched_count", lines[0]);
+        Assert.Equal("2025-03-17,abc123,10,2,8", lines[1]);
+    }
+
+    [Fact]
+    public void Appending_the_same_business_date_and_signature_twice_does_not_duplicate_the_row()
+    {
+        using TempDirectory output = new();
+        RunLedgerStore store = new(output.Combine("run-ledger.csv"));
+
+        store.AppendIfMissing(Entry("abc123"));
+        store.AppendIfMissing(Entry("abc123"));
+
+        Assert.Equal(2, File.ReadAllLines(output.Combine("run-ledger.csv")).Length);
+        Assert.Single(store.LoadEntries());
+    }
+
+    [Fact]
+    public void A_different_signature_for_the_same_date_is_appended_as_a_new_run()
+    {
+        using TempDirectory output = new();
+        RunLedgerStore store = new(output.Combine("run-ledger.csv"));
+
+        store.AppendIfMissing(Entry("abc123"));
+        store.AppendIfMissing(Entry("def456"));
+
+        Assert.Equal(2, store.LoadEntries().Count);
+        Assert.True(store.Exists(BusinessDate, "abc123"));
+        Assert.True(store.Exists(BusinessDate, "def456"));
+    }
+
+    [Fact]
+    public void Existence_is_scoped_to_both_the_business_date_and_the_signature()
+    {
+        using TempDirectory output = new();
+        RunLedgerStore store = new(output.Combine("run-ledger.csv"));
+        store.AppendIfMissing(Entry("abc123"));
+
+        Assert.False(store.Exists(BusinessDate.AddDays(1), "abc123"));
+        Assert.False(store.Exists(BusinessDate, "other-signature"));
+    }
+
+    [Fact]
+    public void An_absent_ledger_reports_no_entries_rather_than_failing()
+    {
+        using TempDirectory output = new();
+        RunLedgerStore store = new(output.Combine("run-ledger.csv"));
+
+        Assert.Empty(store.LoadEntries());
+        Assert.False(store.Exists(BusinessDate, "abc123"));
+    }
+
+    [Fact]
+    public void The_input_signature_is_a_stable_lowercase_sha256_digest()
+    {
+        using TempDirectory input = new();
+        input.WriteLines("trades.csv", "trade_id", "T-1");
+        InputSignatureCalculator calculator = new();
+
+        string first = calculator.Calculate(BusinessDate, input.Path);
+        string second = calculator.Calculate(BusinessDate, input.Path);
+
+        Assert.Equal(first, second);
+        Assert.Equal(64, first.Length);
+        Assert.Equal(first, first.ToLower(CultureInfo.InvariantCulture));
+    }
+
+    [Fact]
+    public void The_signature_changes_when_content_the_business_date_or_the_file_set_changes()
+    {
+        using TempDirectory input = new();
+        input.WriteLines("trades.csv", "trade_id", "T-1");
+        InputSignatureCalculator calculator = new();
+        string baseline = calculator.Calculate(BusinessDate, input.Path);
+
+        Assert.NotEqual(baseline, calculator.Calculate(BusinessDate.AddDays(1), input.Path));
+
+        input.WriteLines("trades.csv", "trade_id", "T-2");
+        string afterContentChange = calculator.Calculate(BusinessDate, input.Path);
+        Assert.NotEqual(baseline, afterContentChange);
+
+        input.WriteLines("overrides.csv", "trade_id,action,note,approved_by");
+        Assert.NotEqual(afterContentChange, calculator.Calculate(BusinessDate, input.Path));
+    }
+
+    [Fact]
+    public void A_missing_input_directory_is_surfaced_as_an_input_error()
+    {
+        using TempDirectory root = new();
+
+        Assert.Throws<ReconciliationInputException>(
+            () => new InputSignatureCalculator().Calculate(BusinessDate, root.Combine("absent")));
+    }
+
+    [Fact]
+    public void The_ledger_factory_binds_the_store_to_the_output_directory()
+    {
+        using TempDirectory output = new();
+
+        Application.Abstractions.IRunLedger ledger = new RunLedgerStoreFactory().Create(output.Path);
+        ledger.AppendIfMissing(Entry("abc123"));
+
+        Assert.True(File.Exists(output.Combine("run-ledger.csv")));
+    }
+}
