+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Deterministic outcome codes returned by every audit command.</summary>
+public static class AuditStatus
+{
+    public const string Initialized = "initialized";
+    public const string Proposed = "proposed";
+    public const string DuplicateProposal = "duplicate_proposal";
+    public const string Approved = "approved";
+    public const string Rejected = "rejected";
+    public const string DuplicateDecision = "duplicate_decision";
+    public const string SelfApprovalDenied = "self_approval_denied";
+    public const string DecisionConflict = "decision_conflict";
+    public const string RequestConflict = "request_conflict";
+    public const string UnknownRequest = "unknown_request";
+    public const string InvalidRequest = "invalid_request";
+    public const string Exported = "exported";
+}
+
+/// <summary>
+/// Machine-readable result of an audit command.
+///
+/// <see cref="Accepted"/> is true when the command reached its intended durable outcome —
+/// including an idempotent retry that deliberately wrote nothing (REQ-5). A deterministic
+/// policy refusal (self-approval, validation failure, conflicting decision) is a declared,
+/// non-accepted outcome rather than a crash.
+/// </summary>
+public sealed record AuditCommandResult
+{
+    public required string Command { get; init; }
+
+    public required string Status { get; init; }
+
+    public required bool Accepted { get; init; }
+
+    /// <summary>Operator-facing explanation. Never contains caller-supplied free text.</summary>
+    public required string Message { get; init; }
+
+    public string? RequestId { get; init; }
+
+    public string? Action { get; init; }
+
+    public string? Actor { get; init; }
+
+    public string? Proposer { get; init; }
+
+    public string? Checker { get; init; }
+
+    public int? Sequence { get; init; }
+
+    public string? EntryHash { get; init; }
+
+    /// <summary>True when this command wrote a new durable entry.</summary>
+    public bool Appended { get; init; }
+
+    /// <summary>Renders the allow-listed JSON document written to stdout.</summary>
+    public JsonObject ToJson() => new()
+    {
+        ["schemaVersion"] = "1.0",
+        ["command"] = Command,
+        ["status"] = Status,
+        ["accepted"] = Accepted,
+        ["appended"] = Appended,
+        ["requestId"] = RequestId,
+        ["action"] = Action,
+        ["actor"] = Actor,
+        ["proposer"] = Proposer,
+        ["checker"] = Checker,
+        ["sequence"] = Sequence,
+        ["entryHash"] = EntryHash,
+        ["message"] = Message
+    };
+}
diff --git a/src/TradeRecon.Audit/AuditEntry.cs b/src/TradeRecon.Audit/AuditEntry.cs
new file mode 100644
index 0000000..d17666a
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditEntry.cs
@@ -0,0 +1,133 @@
+using System.Globalization;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// One immutable entry of the append-only audit history.
+///
+/// The durable representation is an explicit, allow-listed JSON document: only the fields
+/// built here are ever persisted or exported, which is what keeps raw account and amount
+/// data out of the compliance export (INV-5).
+///
+/// Tamper evidence: <c>sequence</c> is a contiguous 1-based position in the ledger,
+/// <c>previousHash</c> is <c>null</c> for sequence 1 and otherwise the preceding entry's
+/// <c>hash</c>, and <c>hash</c> is the lowercase SHA-256 of the canonical JSON of the entry
+/// with the <c>hash</c> property removed (see <see cref="CanonicalJson"/>).
+/// </summary>
+public sealed class AuditEntry
+{
+    /// <summary>Property name of the tamper-evidence digest, excluded when hashing.</summary>
+    public const string HashProperty = "hash";
+
+    /// <summary>Schema version of a durable audit entry.</summary>
+    public const string EntrySchemaVersion = "1.0";
+
+    private AuditEntry(JsonObject document)
+    {
+        Document = document;
+    }
+
+    /// <summary>The durable JSON document exactly as persisted and exported.</summary>
+    public JsonObject Document { get; }
+
+    public int Sequence => (int)Document["sequence"]!;
+
+    public int RequestSequence => (int)Document["requestSequence"]!;
+
+    public string RequestId => (string)Document["requestId"]!;
+
+    public string Action => (string)Document["action"]!;
+
+    public string Actor => (string)Document["actor"]!;
+
+    public string Proposer => (string)Document["proposer"]!;
+
+    public string? Checker => (string?)Document["checker"];
+
+    public string BusinessDate => (string)Document["businessDate"]!;
+
+    public string Reason => (string)Document["reason"]!;
+
+    public string Evidence => (string)Document["evidence"]!;
+
+    public string ReasonDigest => (string)Document["reasonDigest"]!;
+
+    public string EvidenceDigest => (string)Document["evidenceDigest"]!;
+
+    public string Hash => (string)Document[HashProperty]!;
+
+    public string? PreviousHash => (string?)Document["previousHash"];
+
+    /// <summary>True when this entry closes its request.</summary>
+    public bool IsTerminal => AuditActions.IsTerminal(Action);
+
+    /// <summary>Parsed business date, used for the inclusive export range.</summary>
+    public DateOnly BusinessDateValue
+        => DateOnly.ParseExact(BusinessDate, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+    /// <summary>Builds a sealed entry, computing its hash over the canonical form.</summary>
+    public static AuditEntry Create(
+        int sequence,
+        int requestSequence,
+        string requestId,
+        string action,
+        string actor,
+        string actorRole,
+        string proposer,
+        string? checker,
+        string businessDate,
+        string redactedReason,
+        string reasonDigest,
+        string redactedEvidence,
+        string evidenceDigest,
+        DateTimeOffset recordedAt,
+        string? previousHash)
+    {
+        var document = new JsonObject
+        {
+            ["schemaVersion"] = EntrySchemaVersion,
+            ["sequence"] = sequence,
+            ["requestSequence"] = requestSequence,
+            ["requestId"] = requestId,
+            ["action"] = action,
+            ["eventType"] = action,
+            ["status"] = action,
+            ["decision"] = AuditActions.IsTerminal(action) ? action : null,
+            ["actor"] = actor,
+            ["actorRole"] = actorRole,
+            ["proposer"] = proposer,
+            ["checker"] = checker,
+            ["businessDate"] = businessDate,
+            ["reason"] = redactedReason,
+            ["reasonDigest"] = reasonDigest,
+            ["evidence"] = redactedEvidence,
+            ["evidenceDigest"] = evidenceDigest,
+            ["recordedAt"] = recordedAt.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture),
+            ["previousHash"] = previousHash
+        };
+
+        document[HashProperty] = ComputeHash(document);
+        return new AuditEntry(document);
+    }
+
+    /// <summary>Rehydrates an entry from a persisted ledger line.</summary>
+    public static AuditEntry FromDocument(JsonObject document) => new(document);
+
+    /// <summary>
+    /// Recomputes the tamper-evidence digest of <paramref name="document"/>: lowercase
+    /// SHA-256 over the canonical JSON of the document with <c>hash</c> removed.
+    /// </summary>
+    public static string ComputeHash(JsonObject document)
+    {
+        var copy = (JsonObject)document.DeepClone();
+        copy.Remove(HashProperty);
+        return CanonicalJson.Hash(copy);
+    }
+
+    /// <summary>True when this entry's stored hash still matches its content.</summary>
+    public bool HashMatches() => string.Equals(Hash, ComputeHash(Document), StringComparison.Ordinal);
+
+    /// <summary>A defensive copy of the durable document, safe to place in an export.</summary>
+    public JsonObject CloneDocument() => (JsonObject)Document.DeepClone();
+}
diff --git a/src/TradeRecon.Audit/AuditLedger.cs b/src/TradeRecon.Audit/AuditLedger.cs
new file mode 100644
index 0000000..575147c
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditLedger.cs
@@ -0,0 +1,166 @@
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// File-backed, append-only audit ledger that survives across separate command processes.
+///
+/// The ledger is a JSON-lines file: one canonical JSON entry per line, appended and never
+/// rewritten (INV-2). Cross-process serialisation uses an exclusive OS file lock, so a
+/// read-decide-append cycle is atomic even when independent <c>decide</c> processes race
+/// (INV-3 / RISK-3).
+/// </summary>
+public sealed class AuditLedger
+{
+    private const string LedgerFileName = "audit-ledger.jsonl";
+    private const string LockFileName = "audit-ledger.lock";
+
+    private static readonly TimeSpan DefaultLockTimeout = TimeSpan.FromSeconds(30);
+
+    public AuditLedger(string stateDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+        StateDirectory = Path.GetFullPath(stateDirectory);
+        LedgerPath = Path.Combine(StateDirectory, LedgerFileName);
+        LockPath = Path.Combine(StateDirectory, LockFileName);
+    }
+
+    /// <summary>Evaluator-owned directory holding the durable workflow state.</summary>
+    public string StateDirectory { get; }
+
+    /// <summary>Absolute path of the append-only ledger file.</summary>
+    public string LedgerPath { get; }
+
+    /// <summary>Absolute path of the cross-process lock file.</summary>
+    public string LockPath { get; }
+
+    /// <summary>Creates the state directory and an empty ledger when absent. Idempotent.</summary>
+    public void Initialize()
+    {
+        Directory.CreateDirectory(StateDirectory);
+        if (!File.Exists(LedgerPath))
+        {
+            using var _ = new FileStream(LedgerPath, FileMode.OpenOrCreate, FileAccess.Write, FileShare.ReadWrite);
+        }
+    }
+
+    /// <summary>
+    /// Acquires the exclusive cross-process lock. Every mutation and every consistent read
+    /// happens inside this scope.
+    /// </summary>
+    public IDisposable AcquireLock(TimeSpan? timeout = null)
+    {
+        Directory.CreateDirectory(StateDirectory);
+        var deadline = DateTime.UtcNow + (timeout ?? DefaultLockTimeout);
+
+        while (true)
+        {
+            try
+            {
+                return new LockScope(new FileStream(
+                    LockPath,
+                    FileMode.OpenOrCreate,
+                    FileAccess.ReadWrite,
+                    FileShare.None,
+                    bufferSize: 1,
+                    FileOptions.None));
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new TimeoutException("Timed out waiting for the audit ledger lock.");
+                }
+
+                Thread.Sleep(10);
+            }
+        }
+    }
+
+    /// <summary>Reads the full ledger in append order. Returns empty when uninitialised.</summary>
+    public IReadOnlyList<AuditEntry> ReadAll()
+    {
+        if (!File.Exists(LedgerPath))
+        {
+            return [];
+        }
+
+        var entries = new List<AuditEntry>();
+        foreach (var line in File.ReadLines(LedgerPath))
+        {
+            if (string.IsNullOrWhiteSpace(line))
+            {
+                continue;
+            }
+
+            var node = JsonNode.Parse(line) as JsonObject
+                ?? throw new InvalidDataException("The audit ledger contains a malformed entry.");
+            entries.Add(AuditEntry.FromDocument(node));
+        }
+
+        return entries;
+    }
+
+    /// <summary>
+    /// Appends one immutable entry. Must be called while holding <see cref="AcquireLock"/>;
+    /// the write is flushed to the operating system before the lock is released.
+    /// </summary>
+    public void Append(AuditEntry entry)
+    {
+        Directory.CreateDirectory(StateDirectory);
+        var line = CanonicalJson.Serialize(entry.Document) + "\n";
+        using var stream = new FileStream(
+            LedgerPath,
+            FileMode.Append,
+            FileAccess.Write,
+            FileShare.Read,
+            bufferSize: 4096,
+            FileOptions.None);
+        var bytes = Encoding.UTF8.GetBytes(line);
+        stream.Write(bytes, 0, bytes.Length);
+        stream.Flush(flushToDisk: true);
+    }
+
+    /// <summary>
+    /// Verifies the contiguous 1-based sequence and the SHA-256 previous-hash chain over
+    /// <paramref name="entries"/>. Returns <c>null</c> when the chain is intact.
+    /// </summary>
+    public static string? VerifyChain(IReadOnlyList<AuditEntry> entries)
+    {
+        string? previousHash = null;
+        for (var index = 0; index < entries.Count; index++)
+        {
+            var entry = entries[index];
+            if (entry.Sequence != index + 1)
+            {
+                return $"Entry at position {index + 1} declares sequence {entry.Sequence}.";
+            }
+
+            if (!string.Equals(entry.PreviousHash, previousHash, StringComparison.Ordinal))
+            {
+                return $"Entry {entry.Sequence} does not link to the preceding entry.";
+            }
+
+            if (!entry.HashMatches())
+            {
+                return $"Entry {entry.Sequence} has a hash that does not match its content.";
+            }
+
+            previousHash = entry.Hash;
+        }
+
+        return null;
+    }
+
+    private sealed class LockScope(FileStream stream) : IDisposable
+    {
+        private FileStream? _stream = stream;
+
+        public void Dispose()
+        {
+            var handle = Interlocked.Exchange(ref _stream, null);
+            handle?.Dispose();
+        }
+    }
+}
diff --git a/src/TradeRecon.Audit/AuditWorkflowService.cs b/src/TradeRecon.Audit/AuditWorkflowService.cs
new file mode 100644
index 0000000..ec12a5e
--- /dev/null
+++ b/src/TradeRecon.Audit/AuditWorkflowService.cs
@@ -0,0 +1,373 @@
+using System.Globalization;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>Inputs of the <c>propose</c> command.</summary>
+public sealed record ProposeCommand
+{
+    public string? RequestId { get; init; }
+
+    public string? Proposer { get; init; }
+
+    public string? BusinessDate { get; init; }
+
+    public string? Reason { get; init; }
+
+    public string? Evidence { get; init; }
+}
+
+/// <summary>Inputs of the <c>decide</c> command.</summary>
+public sealed record DecideCommand
+{
+    public string? RequestId { get; init; }
+
+    public string? Approver { get; init; }
+
+    public string? Decision { get; init; }
+}
+
+/// <summary>
+/// Maker-checker workflow over the append-only <see cref="AuditLedger"/>.
+///
+/// Every mutation loads the durable proposal state inside the exclusive ledger lock and
+/// validates against it, never against the identity supplied by the current process
+/// (RISK-2). That is what makes self-approval impossible (INV-1), retries idempotent
+/// (INV-4) and concurrent conflicting decisions resolve to exactly one terminal entry
+/// (INV-3).
+/// </summary>
+public sealed class AuditWorkflowService(AuditLedger ledger, Func<DateTimeOffset>? clock = null)
+{
+    private readonly AuditLedger _ledger = ledger;
+    private readonly Func<DateTimeOffset> _clock = clock ?? (() => DateTimeOffset.UtcNow);
+
+    /// <summary>Creates the durable workflow state beneath the evaluator-owned directory.</summary>
+    public AuditCommandResult Initialize()
+    {
+        using var _ = _ledger.AcquireLock();
+        _ledger.Initialize();
+        return new AuditCommandResult
+        {
+            Command = "initialize",
+            Status = AuditStatus.Initialized,
+            Accepted = true,
+            Message = "Audit workflow state is ready."
+        };
+    }
+
+    /// <summary>Records a maker's proposal, or reports the deterministic refusal.</summary>
+    public AuditCommandResult Propose(ProposeCommand command)
+    {
+        var requestId = SensitiveTextPolicy.NormalizeIdentifier(command.RequestId);
+        var proposer = SensitiveTextPolicy.NormalizeIdentifier(command.Proposer);
+        var reason = SensitiveTextPolicy.Redact(command.Reason);
+        var evidence = SensitiveTextPolicy.Redact(command.Evidence);
+
+        if (requestId.Length == 0)
+        {
+            return Invalid("propose", "A non-empty request identifier is required.");
+        }
+
+        if (proposer.Length == 0)
+        {
+            return Invalid("propose", "A non-empty proposer identity is required.", requestId);
+        }
+
+        if (!TryParseDate(command.BusinessDate, out var businessDate))
+        {
+            return Invalid("propose", "A business date formatted as yyyy-MM-dd is required.", requestId);
+        }
+
+        if (reason.Length == 0 || evidence.Length == 0)
+        {
+            return Invalid("propose", "A non-empty reason and non-empty evidence are required.", requestId);
+        }
+
+        var reasonDigest = CanonicalJson.Hash(command.Reason ?? string.Empty);
+        var evidenceDigest = CanonicalJson.Hash(command.Evidence ?? string.Empty);
+
+        using var _ = _ledger.AcquireLock();
+        _ledger.Initialize();
+        var entries = _ledger.ReadAll();
+        var existing = FindProposal(entries, requestId);
+
+        if (existing is not null)
+        {
+            var identical = string.Equals(existing.Proposer, proposer, StringComparison.OrdinalIgnoreCase)
+                && string.Equals(existing.BusinessDate, Format(businessDate), StringComparison.Ordinal)
+                && string.Equals(existing.ReasonDigest, reasonDigest, StringComparison.Ordinal)
+                && string.Equals(existing.EvidenceDigest, evidenceDigest, StringComparison.Ordinal);
+
+            return new AuditCommandResult
+            {
+                Command = "propose",
+                Status = identical ? AuditStatus.DuplicateProposal : AuditStatus.RequestConflict,
+                Accepted = identical,
+                Appended = false,
+                RequestId = requestId,
+                Action = AuditActions.Proposed,
+                Actor = proposer,
+                Proposer = existing.Proposer,
+                Sequence = existing.Sequence,
+                EntryHash = existing.Hash,
+                Message = identical
+                    ? "An identical proposal is already recorded; no duplicate entry was written."
+                    : "The request identifier is already bound to a different proposal."
+            };
+        }
+
+        var entry = AuditEntry.Create(
+            sequence: entries.Count + 1,
+            requestSequence: 1,
+            requestId: requestId,
+            action: AuditActions.Proposed,
+            actor: proposer,
+            actorRole: "proposer",
+            proposer: proposer,
+            checker: null,
+            businessDate: Format(businessDate),
+            redactedReason: reason,
+            reasonDigest: reasonDigest,
+            redactedEvidence: evidence,
+            evidenceDigest: evidenceDigest,
+            recordedAt: _clock(),
+            previousHash: entries.Count == 0 ? null : entries[^1].Hash);
+
+        _ledger.Append(entry);
+
+        return new AuditCommandResult
+        {
+            Command = "propose",
+            Status = AuditStatus.Proposed,
+            Accepted = true,
+            Appended = true,
+            RequestId = requestId,
+            Action = entry.Action,
+            Actor = entry.Actor,
+            Proposer = entry.Proposer,
+            Sequence = entry.Sequence,
+            EntryHash = entry.Hash,
+            Message = "Proposal recorded."
+        };
+    }
+
+    /// <summary>Records a checker's terminal decision, or reports the deterministic refusal.</summary>
+    public AuditCommandResult Decide(DecideCommand command)
+    {
+        var requestId = SensitiveTextPolicy.NormalizeIdentifier(command.RequestId);
+        var approver = SensitiveTextPolicy.NormalizeIdentifier(command.Approver);
+        var action = AuditActions.ParseDecision(command.Decision);
+
+        if (requestId.Length == 0)
+        {
+            return Invalid("decide", "A non-empty request identifier is required.");
+        }
+
+        if (approver.Length == 0)
+        {
+            return Invalid("decide", "A non-empty approver identity is required.", requestId);
+        }
+
+        if (action is null)
+        {
+            return Invalid("decide", "The decision must be 'approve' or 'reject'.", requestId);
+        }
+
+        using var _ = _ledger.AcquireLock();
+        _ledger.Initialize();
+        var entries = _ledger.ReadAll();
+        var proposal = FindProposal(entries, requestId);
+
+        if (proposal is null)
+        {
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = AuditStatus.UnknownRequest,
+                Accepted = false,
+                RequestId = requestId,
+                Actor = approver,
+                Message = "No proposal exists for the supplied request identifier."
+            };
+        }
+
+        // INV-1: the checker is compared with the durable proposer, not with any identity
+        // carried by the current process.
+        if (string.Equals(proposal.Proposer, approver, StringComparison.OrdinalIgnoreCase))
+        {
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = AuditStatus.SelfApprovalDenied,
+                Accepted = false,
+                RequestId = requestId,
+                Action = action,
+                Actor = approver,
+                Proposer = proposal.Proposer,
+                Message = "Segregation of duties: the proposer of a request cannot decide it."
+            };
+        }
+
+        var terminal = FindTerminal(entries, requestId);
+        if (terminal is not null)
+        {
+            var identical = string.Equals(terminal.Action, action, StringComparison.Ordinal)
+                && string.Equals(terminal.Checker, approver, StringComparison.OrdinalIgnoreCase);
+
+            return new AuditCommandResult
+            {
+                Command = "decide",
+                Status = identical ? AuditStatus.DuplicateDecision : AuditStatus.DecisionConflict,
+                Accepted = identical,
+                Appended = false,
+                RequestId = requestId,
+                Action = terminal.Action,
+                Actor = approver,
+                Proposer = terminal.Proposer,
+                Checker = terminal.Checker,
+                Sequence = terminal.Sequence,
+                EntryHash = terminal.Hash,
+                Message = identical
+                    ? "The identical decision is already final; no duplicate entry was written."
+                    : "The request already has a final decision and cannot be decided again."
+            };
+        }
+
+        var requestSequence = entries.Count(e => string.Equals(e.RequestId, requestId, StringComparison.Ordinal)) + 1;
+        var entry = AuditEntry.Create(
+            sequence: entries.Count + 1,
+            requestSequence: requestSequence,
+            requestId: requestId,
+            action: action,
+            actor: approver,
+            actorRole: "checker",
+            proposer: proposal.Proposer,
+            checker: approver,
+            businessDate: proposal.BusinessDate,
+            redactedReason: proposal.Reason,
+            reasonDigest: proposal.ReasonDigest,
+            redactedEvidence: proposal.Evidence,
+            evidenceDigest: proposal.EvidenceDigest,
+            recordedAt: _clock(),
+            previousHash: entries[^1].Hash);
+
+        _ledger.Append(entry);
+
+        return new AuditCommandResult
+        {
+            Command = "decide",
+            Status = action == AuditActions.Approved ? AuditStatus.Approved : AuditStatus.Rejected,
+            Accepted = true,
+            Appended = true,
+            RequestId = requestId,
+            Action = entry.Action,
+            Actor = entry.Actor,
+            Proposer = entry.Proposer,
+            Checker = entry.Checker,
+            Sequence = entry.Sequence,
+            EntryHash = entry.Hash,
+            Message = "Decision recorded."
+        };
+    }
+
+    /// <summary>
+    /// Builds the compliance export for an inclusive business-date range. The exported
+    /// entries are the durable documents byte-for-byte, so an external verifier can
+    /// recompute every hash from the export alone.
+    /// </summary>
+    public (AuditCommandResult Result, JsonObject Document) Export(string? fromDate, string? toDate)
+    {
+        if (!TryParseDate(fromDate, out var from) || !TryParseDate(toDate, out var to))
+        {
+            var failure = Invalid("export", "Both dates must be formatted as yyyy-MM-dd.");
+            return (failure, EmptyExport(fromDate, toDate));
+        }
+
+        if (from > to)
+        {
+            (from, to) = (to, from);
+        }
+
+        IReadOnlyList<AuditEntry> entries;
+        using (var _ = _ledger.AcquireLock())
+        {
+            entries = _ledger.ReadAll();
+        }
+
+        var chainFailure = AuditLedger.VerifyChain(entries);
+        var selected = entries
+            .Where(entry => entry.BusinessDateValue >= from && entry.BusinessDateValue <= to)
+            .ToList();
+
+        var array = new JsonArray();
+        foreach (var entry in selected)
+        {
+            array.Add(entry.CloneDocument());
+        }
+
+        var document = new JsonObject
+        {
+            ["schemaVersion"] = "1.0",
+            ["fromDate"] = Format(from),
+            ["toDate"] = Format(to),
+            ["entryCount"] = selected.Count,
+            ["requestCount"] = selected.Select(e => e.RequestId).Distinct(StringComparer.Ordinal).Count(),
+            ["hashAlgorithm"] = "sha256",
+            ["hashChainValid"] = chainFailure is null,
+            ["entries"] = array
+        };
+
+        var result = new AuditCommandResult
+        {
+            Command = "export",
+            Status = AuditStatus.Exported,
+            Accepted = true,
+            Message = chainFailure is null
+                ? "History exported."
+                : "History exported; the ledger hash chain failed verification."
+        };
+
+        return (result, document);
+    }
+
+    private static JsonObject EmptyExport(string? fromDate, string? toDate) => new()
+    {
+        ["schemaVersion"] = "1.0",
+        ["fromDate"] = fromDate,
+        ["toDate"] = toDate,
+        ["entryCount"] = 0,
+        ["requestCount"] = 0,
+        ["hashAlgorithm"] = "sha256",
+        ["hashChainValid"] = true,
+        ["entries"] = new JsonArray()
+    };
+
+    private static AuditEntry? FindProposal(IReadOnlyList<AuditEntry> entries, string requestId)
+        => entries.FirstOrDefault(entry =>
+            string.Equals(entry.RequestId, requestId, StringComparison.Ordinal)
+            && string.Equals(entry.Action, AuditActions.Proposed, StringComparison.Ordinal));
+
+    private static AuditEntry? FindTerminal(IReadOnlyList<AuditEntry> entries, string requestId)
+        => entries.FirstOrDefault(entry =>
+            string.Equals(entry.RequestId, requestId, StringComparison.Ordinal) && entry.IsTerminal);
+
+    private static AuditCommandResult Invalid(string command, string message, string? requestId = null)
+        => new()
+        {
+            Command = command,
+            Status = AuditStatus.InvalidRequest,
+            Accepted = false,
+            RequestId = requestId,
+            Message = message
+        };
+
+    private static bool TryParseDate(string? value, out DateOnly date)
+        => DateOnly.TryParseExact(
+            value?.Trim() ?? string.Empty,
+            "yyyy-MM-dd",
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.None,
+            out date);
+
+    private static string Format(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+}
diff --git a/src/TradeRecon.Audit/CanonicalJson.cs b/src/TradeRecon.Audit/CanonicalJson.cs
new file mode 100644
index 0000000..71b4dcd
--- /dev/null
+++ b/src/TradeRecon.Audit/CanonicalJson.cs
@@ -0,0 +1,85 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Encodings.Web;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Canonical JSON serialisation used for the tamper-evidence hash chain.
+///
+/// The canonical form is intentionally interoperable with the most common external
+/// verifier implementation (for example Python's
+/// <c>json.dumps(value, sort_keys=True, separators=(",", ":"))</c>):
+///   * object keys are sorted recursively using ordinal (code-point) order;
+///   * no insignificant whitespace is emitted;
+///   * only the JSON-mandated escapes are used;
+///   * every string stored in an audit entry is restricted to printable ASCII, so the
+///     result is byte-identical whether or not a verifier escapes non-ASCII characters.
+/// </summary>
+public static class CanonicalJson
+{
+    private static readonly JsonWriterOptions WriterOptions = new()
+    {
+        Indented = false,
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
+        SkipValidation = false
+    };
+
+    private static readonly JsonSerializerOptions ValueOptions = new()
+    {
+        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
+    };
+
+    /// <summary>Serialises a node to its canonical string form.</summary>
+    public static string Serialize(JsonNode? node)
+    {
+        using var buffer = new MemoryStream();
+        using (var writer = new Utf8JsonWriter(buffer, WriterOptions))
+        {
+            Write(writer, node);
+        }
+
+        return Encoding.UTF8.GetString(buffer.ToArray());
+    }
+
+    /// <summary>Lowercase hexadecimal SHA-256 of the canonical form of <paramref name="node"/>.</summary>
+    public static string Hash(JsonNode? node) => Hash(Serialize(node));
+
+    /// <summary>Lowercase hexadecimal SHA-256 of a UTF-8 string.</summary>
+    public static string Hash(string value)
+        => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value))).ToLowerInvariant();
+
+    private static void Write(Utf8JsonWriter writer, JsonNode? node)
+    {
+        switch (node)
+        {
+            case null:
+                writer.WriteNullValue();
+                break;
+            case JsonObject obj:
+                writer.WriteStartObject();
+                foreach (var property in obj.OrderBy(p => p.Key, StringComparer.Ordinal))
+                {
+                    writer.WritePropertyName(property.Key);
+                    Write(writer, property.Value);
+                }
+
+                writer.WriteEndObject();
+                break;
+            case JsonArray array:
+                writer.WriteStartArray();
+                foreach (var item in array)
+                {
+                    Write(writer, item);
+                }
+
+                writer.WriteEndArray();
+                break;
+            default:
+                node.WriteTo(writer, ValueOptions);
+                break;
+        }
+    }
+}
