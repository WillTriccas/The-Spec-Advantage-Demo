@@ -0,0 +1,300 @@
+using System.Diagnostics;
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests.Audit;
+
+/// <summary>
+/// Black-box tests of the audit command-line surface published through
+/// <c>audit-adapter.json</c>. Every case drives real, independent operating-system
+/// processes, which is what proves that durable state survives across processes and that a
+/// genuine concurrent approve/reject race still leaves one final decision (NFR-2, REQ-6).
+/// </summary>
+public sealed class AuditCliProcessTests : IDisposable
+{
+    private const string AccountSentinel = "ACC7781204";
+    private const string AmountSentinel = "1600500.75";
+    private const string BusinessDate = "2024-06-03";
+
+    private readonly string _root =
+        Path.Combine(Path.GetTempPath(), $"trade-recon-audit-cli-{Guid.NewGuid():N}");
+
+    private string StateDirectory => Path.Combine(_root, "state");
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_root))
+        {
+            Directory.Delete(_root, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void EveryCommandReturnsParseableJsonOnStdout()
+    {
+        var initialize = Run("initialize", "--state-directory", StateDirectory);
+        Assert.Equal(0, initialize.ExitCode);
+        Assert.Equal("initialized", (string?)initialize.Json["status"]);
+
+        var propose = RunPropose("REQ-1", "maker-a");
+        Assert.Equal(0, propose.ExitCode);
+        Assert.Equal("proposed", (string?)propose.Json["status"]);
+
+        var decide = Run(
+            "decide", "--state-directory", StateDirectory,
+            "--request-id", "REQ-1", "--approver", "checker-b", "--decision", "approve");
+        Assert.Equal(0, decide.ExitCode);
+        Assert.Equal("approved", (string?)decide.Json["status"]);
+
+        var exportPath = Path.Combine(_root, "export", "history.json");
+        var export = Run(
+            "export", "--state-directory", StateDirectory,
+            "--from-date", BusinessDate, "--to-date", BusinessDate, "--export-path", exportPath);
+        Assert.Equal(0, export.ExitCode);
+        Assert.True(File.Exists(exportPath));
+
+        var exported = JsonNode.Parse(File.ReadAllText(exportPath))!.AsObject();
+        Assert.Equal(2, exported["entries"]!.AsArray().Count);
+    }
+
+    [Fact]
+    public void SelfApprovalAcrossProcessesLeavesNoFinalDecision()
+    {
+        Run("initialize", "--state-directory", StateDirectory);
+        RunPropose("REQ-1", "maker-a");
+
+        var selfApproval = Run(
+            "decide", "--state-directory", StateDirectory,
+            "--request-id", "REQ-1", "--approver", "maker-a", "--decision", "approve");
+
+        Assert.Equal(3, selfApproval.ExitCode);
+        Assert.Equal("self_approval_denied", (string?)selfApproval.Json["status"]);
+        Assert.False((bool)selfApproval.Json["accepted"]!);
+        Assert.DoesNotContain(Export(), entry => (string)entry["action"]! != AuditActions.Proposed);
+    }
+
+    [Fact]
+    public void ProposalWithEmptyReasonAndEvidenceLeavesNoHistory()
+    {
+        Run("initialize", "--state-directory", StateDirectory);
+
+        var result = Run(
+            "propose", "--state-directory", StateDirectory,
+            "--request-id", "REQ-EMPTY", "--proposer", "maker-a",
+            "--business-date", BusinessDate, "--reason", string.Empty, "--evidence", string.Empty);
+
+        Assert.Equal(3, result.ExitCode);
+        Assert.Equal("invalid_request", (string?)result.Json["status"]);
+        Assert.Empty(Export());
+    }
+
+    [Fact]
+    public void RepeatingAnAcceptedApprovalIsIdempotent()
+    {
+        Run("initialize", "--state-directory", StateDirectory);
+        RunPropose("REQ-1", "maker-a");
+        Run("decide", "--state-directory", StateDirectory,
+            "--request-id", "REQ-1", "--approver", "checker-b", "--decision", "approve");
+
+        var repeat = Run("decide", "--state-directory", StateDirectory,
+            "--request-id", "REQ-1", "--approver", "checker-b", "--decision", "approve");
+
+        Assert.Equal(0, repeat.ExitCode);
+        Assert.Equal("duplicate_decision", (string?)repeat.Json["status"]);
+        Assert.False((bool)repeat.Json["appended"]!);
+        Assert.Single(Export(), entry => (string)entry["action"]! == AuditActions.Approved);
+    }
+
+    [Fact]
+    public void ConcurrentApproveAndRejectProcessesLeaveExactlyOneFinalDecision()
+    {
+        Run("initialize", "--state-directory", StateDirectory);
+        RunPropose("REQ-RACE", "maker-a");
+
+        var starts = new[]
+        {
+            ("checker-b", "approve"),
+            ("checker-c", "reject"),
+            ("checker-d", "approve"),
+            ("checker-e", "reject")
+        };
+
+        var processes = starts
+            .Select(start => Start(
+                "decide", "--state-directory", StateDirectory,
+                "--request-id", "REQ-RACE", "--approver", start.Item1, "--decision", start.Item2))
+            .ToList();
+
+        var results = processes.Select(Complete).ToList();
+
+        Assert.All(results, result => Assert.Contains(result.ExitCode, new[] { 0, 3 }));
+        Assert.Single(results, result => (bool)result.Json["appended"]!);
+
+        var terminal = Assert.Single(
+            Export(), entry => (string)entry["action"]! != AuditActions.Proposed);
+        Assert.False(string.IsNullOrWhiteSpace((string?)terminal["checker"]));
+        Assert.NotEqual((string?)terminal["proposer"], (string?)terminal["checker"]);
+    }
+
+    [Fact]
+    public void NoCommandSurfaceLeaksAccountOrAmountSentinels()
+    {
+        Run("initialize", "--state-directory", StateDirectory);
+
+        var propose = Run(
+            "propose", "--state-directory", StateDirectory,
+            "--request-id", "REQ-SENSITIVE", "--proposer", "maker-a",
+            "--business-date", BusinessDate,
+            "--reason", $"account {AccountSentinel} short by {AmountSentinel}",
+            "--evidence", $"custodian statement {AccountSentinel} / {AmountSentinel}");
+        var decide = Run(
+            "decide", "--state-directory", StateDirectory,
+            "--request-id", "REQ-SENSITIVE", "--approver", "checker-b", "--decision", "approve");
+
+        var exportPath = Path.Combine(_root, "sensitive-export.json");
+        var export = Run(
+            "export", "--state-directory", StateDirectory,
+            "--from-date", BusinessDate, "--to-date", BusinessDate, "--export-path", exportPath);
+
+        var surfaces = new List<string>
+        {
+            propose.StandardOutput, propose.StandardError,
+            decide.StandardOutput, decide.StandardError,
+            export.StandardOutput, export.StandardError,
+            File.ReadAllText(exportPath),
+            File.ReadAllText(Path.Combine(StateDirectory, "audit-ledger.jsonl"))
+        };
+
+        foreach (var surface in surfaces)
+        {
+            Assert.DoesNotContain(AccountSentinel, surface, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(AmountSentinel, surface, StringComparison.OrdinalIgnoreCase);
+        }
+    }
+
+    private List<JsonObject> Export()
+    {
+        var exportPath = Path.Combine(_root, $"export-{Guid.NewGuid():N}.json");
+        var export = Run(
+            "export", "--state-directory", StateDirectory,
+            "--from-date", "2000-01-01", "--to-date", "2100-12-31", "--export-path", exportPath);
+        Assert.Equal(0, export.ExitCode);
+
+        return JsonNode.Parse(File.ReadAllText(exportPath))!
+            .AsObject()["entries"]!
+            .AsArray()
+            .Select(node => node!.AsObject())
+            .ToList();
+    }
+
+    private CliResult RunPropose(string requestId, string proposer) => Run(
+        "propose", "--state-directory", StateDirectory,
+        "--request-id", requestId, "--proposer", proposer,
+        "--business-date", BusinessDate,
+        "--reason", "funding adjustment agreed with the custodian",
+        "--evidence", "signed custodian confirmation on file");
+
+    private static CliResult Run(params string[] args) => Complete(Start(args));
+
+    private static Process Start(params string[] args)
+    {
+        var (executable, prefix) = AuditCliLocator.Resolve();
+        var startInfo = new ProcessStartInfo(executable)
+        {
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+            WorkingDirectory = AppContext.BaseDirectory
+        };
+
+        foreach (var argument in prefix.Concat(args))
+        {
+            startInfo.ArgumentList.Add(argument);
+        }
+
+        return Process.Start(startInfo)
+            ?? throw new InvalidOperationException("The audit CLI process could not be started.");
+    }
+
+    private static CliResult Complete(Process process)
+    {
+        using (process)
+        {
+            var stdout = process.StandardOutput.ReadToEndAsync();
+            var stderr = process.StandardError.ReadToEndAsync();
+            Assert.True(process.WaitForExit(120_000), "The audit CLI did not exit in time.");
+
+            var standardOutput = stdout.GetAwaiter().GetResult();
+            var standardError = stderr.GetAwaiter().GetResult();
+            var json = JsonNode.Parse(standardOutput) as JsonObject
+                ?? throw new InvalidOperationException("The audit CLI did not emit a JSON object.");
+
+            return new CliResult(process.ExitCode, standardOutput, standardError, json);
+        }
+    }
+
+    private sealed record CliResult(int ExitCode, string StandardOutput, string StandardError, JsonObject Json);
+}
+
+/// <summary>Locates the built audit CLI so tests can drive it as a separate process.</summary>
+internal static class AuditCliLocator
+{
+    public static (string Executable, string[] Prefix) Resolve()
+    {
+        var root = FindRepositoryRoot();
+        foreach (var configuration in PreferredConfigurations())
+        {
+            var directory = Path.Combine(root, "src", "TradeRecon.Audit.Cli", "bin", configuration, "net8.0");
+            var apphost = Path.Combine(
+                directory,
+                OperatingSystem.IsWindows() ? "TradeRecon.Audit.Cli.exe" : "TradeRecon.Audit.Cli");
+            if (File.Exists(apphost))
+            {
+                return (apphost, []);
+            }
+
+            var library = Path.Combine(directory, "TradeRecon.Audit.Cli.dll");
+            if (File.Exists(library))
+            {
+                return ("dotnet", [library]);
+            }
+        }
+
+        // Fall back to the copy that sits beside the test assembly, hosted with the test
+        // project's runtime configuration.
+        var local = Path.Combine(AppContext.BaseDirectory, "TradeRecon.Audit.Cli.dll");
+        var runtimeConfig = Path.Combine(AppContext.BaseDirectory, "TradeRecon.Tests.runtimeconfig.json");
+        if (File.Exists(local) && File.Exists(runtimeConfig))
+        {
+            return ("dotnet", ["exec", "--runtimeconfig", runtimeConfig, local]);
+        }
+
+        throw new InvalidOperationException("The audit CLI has not been built.");
+    }
+
+    private static IEnumerable<string> PreferredConfigurations()
+    {
+        var isDebug = AppContext.BaseDirectory.Contains(
+            $"{Path.DirectorySeparatorChar}Debug{Path.DirectorySeparatorChar}",
+            StringComparison.OrdinalIgnoreCase);
+
+        return isDebug ? ["Debug", "Release"] : ["Release", "Debug"];
+    }
+
+    private static string FindRepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            if (File.Exists(Path.Combine(directory.FullName, "TradeRecon.sln")))
+            {
+                return directory.FullName;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new InvalidOperationException("The repository root could not be located.");
+    }
+}
