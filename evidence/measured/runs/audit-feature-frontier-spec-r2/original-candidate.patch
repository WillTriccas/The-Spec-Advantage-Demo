index 0000000..d95a29c
--- /dev/null
+++ b/src/TradeRecon.Audit.Cli/Program.cs
@@ -0,0 +1,243 @@
+using System.Text;
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+
+namespace TradeRecon.Audit.Cli;
+
+/// <summary>
+/// Black-box command-line surface of the explainable exception-resolution workflow,
+/// published to evaluators through <c>audit-adapter.json</c>.
+///
+/// Commands (every value is supplied by the caller; no shell interpretation is used):
+///   initialize --state-directory &lt;dir&gt;
+///   propose    --state-directory &lt;dir&gt; --request-id &lt;id&gt; --proposer &lt;identity&gt;
+///              --business-date &lt;yyyy-MM-dd&gt; --reason &lt;text&gt; --evidence &lt;text&gt;
+///   decide     --state-directory &lt;dir&gt; --request-id &lt;id&gt; --approver &lt;identity&gt;
+///              --decision &lt;approve|reject&gt;
+///   export     --state-directory &lt;dir&gt; --from-date &lt;yyyy-MM-dd&gt; --to-date &lt;yyyy-MM-dd&gt;
+///              --export-path &lt;file&gt;
+///
+/// Every command writes exactly one parseable JSON document to stdout; <c>export</c> writes
+/// the same document to the export path as well. Nothing that a caller supplied as free
+/// text is ever echoed to stdout or stderr (REQ-8).
+///
+/// Exit codes: 0 = accepted (including an idempotent retry), 3 = deterministic policy
+/// refusal, 1 = unexpected internal error.
+/// </summary>
+public static class Program
+{
+    /// <summary>The command reached its intended durable outcome.</summary>
+    public const int ExitAccepted = 0;
+
+    /// <summary>Unexpected internal error.</summary>
+    public const int ExitError = 1;
+
+    /// <summary>The command was deterministically refused by workflow policy.</summary>
+    public const int ExitRefused = 3;
+
+    public static int Main(string[] args)
+    {
+        System.Console.OutputEncoding = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
+
+        try
+        {
+            var (document, exitCode) = Execute(args);
+            System.Console.Out.Write(document.ToJsonString());
+            System.Console.Out.Write('\n');
+            System.Console.Out.Flush();
+            return exitCode;
+        }
+        catch (Exception ex)
+        {
+            // Diagnostics deliberately carry the exception type only: an exception message
+            // could otherwise echo caller-supplied account or amount text (RISK-4).
+            var failure = new JsonObject
+            {
+                ["schemaVersion"] = "1.0",
+                ["command"] = args.Length > 0 ? Sanitize(args[0]) : "unknown",
+                ["status"] = "internal_error",
+                ["accepted"] = false,
+                ["appended"] = false,
+                ["message"] = $"The audit command failed with {ex.GetType().Name}."
+            };
+            System.Console.Out.Write(failure.ToJsonString());
+            System.Console.Out.Write('\n');
+            System.Console.Out.Flush();
+            System.Console.Error.WriteLine($"audit: command failed with {ex.GetType().Name}.");
+            return ExitError;
+        }
+    }
+
+    private static (JsonObject Document, int ExitCode) Execute(string[] args)
+    {
+        if (args.Length == 0)
+        {
+            return (Usage("A command is required."), ExitRefused);
+        }
+
+        var command = args[0].Trim().ToLowerInvariant();
+        var options = CommandLine.Parse(args.Skip(1));
+
+        var stateDirectory = options.Value("state-directory") ?? options.Value("state");
+        if (command is "initialize" or "propose" or "decide" or "export"
+            && string.IsNullOrWhiteSpace(stateDirectory))
+        {
+            return (Refusal(command, "A state directory is required."), ExitRefused);
+        }
+
+        switch (command)
+        {
+            case "initialize":
+            {
+                var service = CreateService(stateDirectory!);
+                var result = service.Initialize();
+                return (result.ToJson(), ExitAccepted);
+            }
+
+            case "propose":
+            {
+                var service = CreateService(stateDirectory!);
+                var result = service.Propose(new ProposeCommand
+                {
+                    RequestId = options.Value("request-id") ?? options.Value("requestid"),
+                    Proposer = options.Value("proposer") ?? options.Value("maker"),
+                    BusinessDate = options.Value("business-date") ?? options.Value("date"),
+                    Reason = options.Value("reason"),
+                    Evidence = options.Value("evidence")
+                });
+                return (result.ToJson(), result.Accepted ? ExitAccepted : ExitRefused);
+            }
+
+            case "decide":
+            {
+                var service = CreateService(stateDirectory!);
+                var result = service.Decide(new DecideCommand
+                {
+                    RequestId = options.Value("request-id") ?? options.Value("requestid"),
+                    Approver = options.Value("approver") ?? options.Value("checker"),
+                    Decision = options.Value("decision")
+                });
+                return (result.ToJson(), result.Accepted ? ExitAccepted : ExitRefused);
+            }
+
+            case "export":
+            {
+                var exportPath = options.Value("export-path") ?? options.Value("output");
+                if (string.IsNullOrWhiteSpace(exportPath))
+                {
+                    return (Refusal(command, "An export path is required."), ExitRefused);
+                }
+
+                var service = CreateService(stateDirectory!);
+                var (result, document) = service.Export(
+                    options.Value("from-date") ?? options.Value("from"),
+                    options.Value("to-date") ?? options.Value("to"));
+
+                if (!result.Accepted)
+                {
+                    return (result.ToJson(), ExitRefused);
+                }
+
+                WriteExport(exportPath, document);
+                document["exportPath"] = Path.GetFullPath(exportPath);
+                return (document, ExitAccepted);
+            }
+
+            case "--help" or "-h" or "help":
+                return (Usage("Audit workflow commands: initialize, propose, decide, export."), ExitAccepted);
+
+            default:
+                return (Usage("Unknown command."), ExitRefused);
+        }
+    }
+
+    private static AuditWorkflowService CreateService(string stateDirectory)
+        => new(new AuditLedger(stateDirectory));
+
+    private static void WriteExport(string exportPath, JsonObject document)
+    {
+        var fullPath = Path.GetFullPath(exportPath);
+        var directory = Path.GetDirectoryName(fullPath);
+        if (!string.IsNullOrEmpty(directory))
+        {
+            Directory.CreateDirectory(directory);
+        }
+
+        // Write through a temporary file so a reader never observes a partial export.
+        var temporary = fullPath + ".tmp";
+        File.WriteAllText(temporary, CanonicalJson.Serialize(document) + "\n", new UTF8Encoding(false));
+        File.Move(temporary, fullPath, overwrite: true);
+    }
+
+    private static JsonObject Usage(string message) => new()
+    {
+        ["schemaVersion"] = "1.0",
+        ["command"] = "usage",
+        ["status"] = AuditStatus.InvalidRequest,
+        ["accepted"] = false,
+        ["appended"] = false,
+        ["message"] = message,
+        ["commands"] = new JsonArray("initialize", "propose", "decide", "export")
+    };
+
+    private static JsonObject Refusal(string command, string message) => new()
+    {
+        ["schemaVersion"] = "1.0",
+        ["command"] = command,
+        ["status"] = AuditStatus.InvalidRequest,
+        ["accepted"] = false,
+        ["appended"] = false,
+        ["message"] = message
+    };
+
+    private static string Sanitize(string value)
+        => SensitiveTextPolicy.NormalizeIdentifier(value);
+
+    /// <summary>
+    /// Minimal <c>--name value</c> parser. Values are taken verbatim, so free text that
+    /// begins with a dash or is an empty string is still accepted as a value.
+    /// </summary>
+    private sealed class CommandLine
+    {
+        private readonly Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);
+
+        public static CommandLine Parse(IEnumerable<string> args)
+        {
+            var parsed = new CommandLine();
+            var pending = null as string;
+
+            foreach (var arg in args)
+            {
+                if (pending is not null)
+                {
+                    parsed._values[pending] = arg;
+                    pending = null;
+                    continue;
+                }
+
+                if (arg.StartsWith("--", StringComparison.Ordinal))
+                {
+                    var body = arg[2..];
+                    var separator = body.IndexOf('=', StringComparison.Ordinal);
+                    if (separator >= 0)
+                    {
+                        parsed._values[body[..separator]] = body[(separator + 1)..];
+                    }
+                    else
+                    {
+                        pending = body;
+                    }
+                }
+            }
+
+            if (pending is not null)
+            {
+                parsed._values[pending] = string.Empty;
+            }
+
+            return parsed;
+        }
+
+        public string? Value(string name) => _values.TryGetValue(name, out var value) ? value : null;
+    }
+}
