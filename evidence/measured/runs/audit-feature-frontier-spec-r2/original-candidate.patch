@@ -0,0 +1,137 @@
+using System.Text.Json.Nodes;
+using Xunit;
+
+namespace TradeRecon.Tests.Audit;
+
+/// <summary>
+/// Guards the two candidate-root adapter contracts (REQ-1, REQ-9): the pre-existing
+/// <c>benchmark-adapter.json</c> must keep its observable shape, and
+/// <c>audit-adapter.json</c> must expose shell-free command arrays with every documented
+/// placeholder.
+/// </summary>
+public sealed class AuditAdapterContractTests
+{
+    private static readonly string[] AuditCommands = ["initialize", "propose", "decide", "export"];
+
+    private static readonly Dictionary<string, string[]> RequiredPlaceholders = new()
+    {
+        ["initialize"] = ["{stateDirectory}"],
+        ["propose"] = ["{stateDirectory}", "{requestId}", "{proposer}", "{businessDate}", "{reason}", "{evidence}"],
+        ["decide"] = ["{stateDirectory}", "{requestId}", "{approver}", "{decision}"],
+        ["export"] = ["{stateDirectory}", "{fromDate}", "{toDate}", "{exportPath}"]
+    };
+
+    [Fact]
+    public void BenchmarkAdapterIsPreserved()
+    {
+        var adapter = Load("benchmark-adapter.json");
+
+        foreach (var command in new[] { "build", "test", "run" })
+        {
+            var section = adapter[command]!.AsObject();
+            Assert.False(string.IsNullOrWhiteSpace((string?)section["executable"]));
+            Assert.NotEmpty(section["arguments"]!.AsArray());
+            Assert.NotEmpty(section["allowedExitCodes"]!.AsArray());
+        }
+
+        Assert.Equal(3, adapter["outputs"]!.AsArray().Count);
+    }
+
+    [Fact]
+    public void AuditAdapterDeclaresEveryWorkflowCommand()
+    {
+        var adapter = Load("audit-adapter.json");
+
+        Assert.Equal("1.0.0", (string?)adapter["schemaVersion"]);
+        Assert.False(string.IsNullOrWhiteSpace((string?)adapter["workingDirectory"]));
+
+        foreach (var command in AuditCommands)
+        {
+            var section = adapter[command]!.AsObject();
+
+            Assert.False(string.IsNullOrWhiteSpace((string?)section["executable"]));
+            Assert.DoesNotContain("&&", (string)section["executable"]!, StringComparison.Ordinal);
+
+            var arguments = section["arguments"]!.AsArray()
+                .Select(node => (string)node!)
+                .ToList();
+            Assert.NotEmpty(arguments);
+            Assert.Contains(command, arguments);
+
+            foreach (var argument in arguments)
+            {
+                // Shell-free: no operator may be smuggled into an argument.
+                Assert.DoesNotContain("&&", argument, StringComparison.Ordinal);
+                Assert.DoesNotContain("||", argument, StringComparison.Ordinal);
+                Assert.DoesNotContain(">", argument, StringComparison.Ordinal);
+                Assert.DoesNotContain("|", argument, StringComparison.Ordinal);
+            }
+
+            foreach (var placeholder in RequiredPlaceholders[command])
+            {
+                Assert.Contains(placeholder, arguments);
+            }
+
+            var exitCodes = section["allowedExitCodes"]!.AsArray().Select(node => (int)node!).ToList();
+            Assert.Contains(0, exitCodes);
+        }
+
+        // Deterministic refusals (self-approval, validation, conflicting decision) are a
+        // declared outcome of the two decision-bearing commands.
+        Assert.Contains(3, adapter["propose"]!["allowedExitCodes"]!.AsArray().Select(node => (int)node!));
+        Assert.Contains(3, adapter["decide"]!["allowedExitCodes"]!.AsArray().Select(node => (int)node!));
+    }
+
+    [Fact]
+    public void AuditAdapterUsesOnlyRepositoryRelativePaths()
+    {
+        var root = RepositoryRoot();
+        var adapter = Load("audit-adapter.json");
+
+        // initialize compiles the workflow host on demand, so it is the command that
+        // guarantees the published binary the other three commands invoke directly.
+        var initializeProject = SinglePathArgument(adapter, "initialize", ".csproj");
+        Assert.True(File.Exists(Resolve(root, initializeProject)));
+
+        foreach (var command in new[] { "propose", "decide", "export" })
+        {
+            var assembly = SinglePathArgument(adapter, command, ".dll");
+            Assert.StartsWith("src/TradeRecon.Audit.Cli/", assembly, StringComparison.Ordinal);
+            Assert.True(
+                File.Exists(Resolve(root, assembly)),
+                $"The '{command}' command points at a binary that the build does not produce.");
+        }
+    }
+
+    private static string SinglePathArgument(JsonObject adapter, string command, string extension)
+    {
+        var argument = adapter[command]!["arguments"]!.AsArray()
+            .Select(node => (string)node!)
+            .Single(value => value.EndsWith(extension, StringComparison.Ordinal));
+
+        Assert.False(Path.IsPathRooted(argument));
+        return argument;
+    }
+
+    private static string Resolve(string root, string relativePath)
+        => Path.Combine(root, relativePath.Replace('/', Path.DirectorySeparatorChar));
+
+    private static JsonObject Load(string fileName)
+        => JsonNode.Parse(File.ReadAllText(Path.Combine(RepositoryRoot(), fileName)))!.AsObject();
+
+    private static string RepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null)
+        {
+            if (File.Exists(Path.Combine(directory.FullName, "TradeRecon.sln")))
+            {
+                return directory.FullName;
+            }
+
+            directory = directory.Parent;
+        }
+
+        throw new InvalidOperationException("The repository root could not be located.");
+    }
+}
diff --git a/tests/TradeRecon.Tests/Audit/AuditCliProcessTests.cs b/tests/TradeRecon.Tests/Audit/AuditCliProcessTests.cs
