@@ -0,0 +1,129 @@
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Audit;
+
+/// <summary>
+/// Allow-listed sanitisation for the free-text fields that enter the audit workflow.
+///
+/// The audit feature must never surface raw account identifiers or trade amounts in logs,
+/// command output or the compliance export (INV-5 / REQ-8). Free text supplied by a maker
+/// is therefore normalised to printable ASCII and every value-bearing token is masked
+/// <em>before</em> it is written to durable state, so the stored bytes, the exported bytes
+/// and the hashed bytes are all identical and the hash chain still verifies.
+///
+/// A token is masked when it carries a digit (every account identifier and every trade
+/// amount in this domain does) or when it is an identifier-like composite of an
+/// account/amount keyword. The unredacted text is never persisted; a SHA-256 digest of the
+/// original input is recorded instead so the operator's submission stays provable.
+/// </summary>
+public static class SensitiveTextPolicy
+{
+    /// <summary>Replacement emitted in place of a masked token.</summary>
+    public const string Mask = "[REDACTED]";
+
+    /// <summary>Maximum stored length of a sanitised free-text field.</summary>
+    public const int MaxTextLength = 512;
+
+    /// <summary>Maximum stored length of an identifier (request id, actor).</summary>
+    public const int MaxIdentifierLength = 200;
+
+    private static readonly string[] SensitiveKeywords =
+    [
+        "account", "acct", "acc", "iban", "bban", "ledger", "amount", "amt", "notional",
+        "balance", "quantity", "qty", "value", "price", "cash", "usd", "eur", "gbp", "jpy"
+    ];
+
+    private static readonly Regex TokenPattern = new(
+        @"[A-Za-z0-9][A-Za-z0-9._/\\+@:-]*",
+        RegexOptions.CultureInvariant | RegexOptions.Compiled);
+
+    private static readonly Regex WhitespaceRuns = new(
+        @"\s{2,}",
+        RegexOptions.CultureInvariant | RegexOptions.Compiled);
+
+    /// <summary>
+    /// Normalises <paramref name="value"/> to printable ASCII and masks every token that
+    /// could carry an account identifier or a monetary amount.
+    /// </summary>
+    public static string Redact(string? value)
+    {
+        var normalised = NormalizeToPrintableAscii(value);
+        if (normalised.Length == 0)
+        {
+            return string.Empty;
+        }
+
+        var masked = TokenPattern.Replace(normalised, match => IsSensitive(match.Value) ? Mask : match.Value);
+        return Tidy(masked);
+    }
+
+    /// <summary>
+    /// Normalises an identity or request identifier. Identifiers are preserved verbatim
+    /// (the export must round-trip the caller's requestId exactly) apart from control and
+    /// non-ASCII characters, which are dropped so canonical JSON stays byte-stable.
+    /// </summary>
+    public static string NormalizeIdentifier(string? value)
+    {
+        var normalised = Tidy(NormalizeToPrintableAscii(value));
+        return normalised.Length <= MaxIdentifierLength
+            ? normalised
+            : normalised[..MaxIdentifierLength];
+    }
+
+    /// <summary>True when the token would expose an account identifier or an amount.</summary>
+    private static bool IsSensitive(string token)
+    {
+        foreach (var character in token)
+        {
+            if (char.IsAsciiDigit(character))
+            {
+                return true;
+            }
+        }
+
+        foreach (var keyword in SensitiveKeywords)
+        {
+            // A bare English word ("account") is prose; a longer composite that embeds the
+            // keyword ("acct-sentinel", "house_account_ref") is an identifier and is masked.
+            if (token.Length > keyword.Length
+                && token.Contains(keyword, StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static string NormalizeToPrintableAscii(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+        {
+            return string.Empty;
+        }
+
+        var builder = new StringBuilder(value.Length);
+        foreach (var character in value)
+        {
+            if (character is >= ' ' and <= '~')
+            {
+                builder.Append(character);
+            }
+            else
+            {
+                // Control characters and non-ASCII text are replaced by a separator so the
+                // canonical JSON encoding cannot diverge between verifier implementations.
+                builder.Append(' ');
+            }
+        }
+
+        return builder.ToString();
+    }
+
+    private static string Tidy(string value)
+    {
+        var collapsed = WhitespaceRuns.Replace(value, " ").Trim();
+        return collapsed.Length <= MaxTextLength ? collapsed : collapsed[..MaxTextLength].TrimEnd();
+    }
+}
