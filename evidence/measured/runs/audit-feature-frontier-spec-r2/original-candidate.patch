+namespace TradeRecon.Audit;
+
+/// <summary>Lifecycle actions recorded in the append-only audit history.</summary>
+public static class AuditActions
+{
+    /// <summary>A maker proposed a resolution for a reconciliation break.</summary>
+    public const string Proposed = "PROPOSED";
+
+    /// <summary>A checker approved the proposal. Terminal.</summary>
+    public const string Approved = "APPROVED";
+
+    /// <summary>A checker rejected the proposal. Terminal.</summary>
+    public const string Rejected = "REJECTED";
+
+    /// <summary>True when the action closes the request.</summary>
+    public static bool IsTerminal(string action)
+        => action is Approved or Rejected;
+
+    /// <summary>Maps a caller-supplied decision word onto a terminal action.</summary>
+    public static string? ParseDecision(string? decision)
+    {
+        var value = decision?.Trim();
+        if (string.IsNullOrEmpty(value))
+        {
+            return null;
+        }
+
+        return value.ToUpperInvariant() switch
+        {
+            "APPROVE" or "APPROVED" or "APPROVAL" or "ACCEPT" or "ACCEPTED" => Approved,
+            "REJECT" or "REJECTED" or "REJECTION" or "DENY" or "DENIED" or "DECLINE" or "DECLINED" => Rejected,
+            _ => null
+        };
+    }
+}
