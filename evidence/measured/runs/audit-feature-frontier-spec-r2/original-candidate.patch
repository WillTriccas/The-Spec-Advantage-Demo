new file mode 100644
index 0000000..2f81c83
--- /dev/null
+++ b/tests/TradeRecon.Tests/Audit/AuditExportTests.cs
@@ -0,0 +1,235 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests.Audit;
+
+/// <summary>
+/// Compliance export behaviour and the sensitive-data boundary (REQ-7, REQ-8, INV-5).
+/// </summary>
+public sealed class AuditExportTests : IDisposable
+{
+    /// <summary>Synthetic sentinels standing in for a real account id and trade amount.</summary>
+    private const string AccountSentinel = "ACC7781204";
+
+    private const string AmountSentinel = "1600500.75";
+
+    private readonly string _stateDirectory =
+        Path.Combine(Path.GetTempPath(), $"trade-recon-audit-export-{Guid.NewGuid():N}");
+
+    private readonly AuditWorkflowService _service;
+
+    public AuditExportTests()
+    {
+        _service = new AuditWorkflowService(new AuditLedger(_stateDirectory));
+        _service.Initialize();
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_stateDirectory))
+        {
+            Directory.Delete(_stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void Export_ContainsTheCompleteHistoryOfApprovedAndRejectedRequests()
+    {
+        Propose("REQ-1", "maker-a", "2024-06-03");
+        Propose("REQ-2", "maker-a", "2024-06-03");
+        Decide("REQ-1", "checker-b", "approve");
+        Decide("REQ-2", "checker-c", "reject");
+
+        var entries = ExportEntries("2024-06-01", "2024-06-30");
+
+        Assert.Equal(4, entries.Count);
+        Assert.Equal(
+            [AuditActions.Proposed, AuditActions.Proposed, AuditActions.Approved, AuditActions.Rejected],
+            entries.Select(entry => (string)entry["action"]!).ToArray());
+
+        foreach (var requestId in new[] { "REQ-1", "REQ-2" })
+        {
+            var forRequest = entries.Where(e => (string)e["requestId"]! == requestId).ToList();
+            Assert.Equal(2, forRequest.Count);
+
+            var proposal = forRequest.Single(e => (string)e["action"]! == AuditActions.Proposed);
+            var decision = forRequest.Single(e => (string)e["action"]! != AuditActions.Proposed);
+
+            Assert.Equal("maker-a", (string?)proposal["proposer"]);
+            Assert.False(string.IsNullOrWhiteSpace((string?)decision["checker"]));
+            Assert.NotEqual((string?)decision["proposer"], (string?)decision["checker"]);
+            Assert.False(string.IsNullOrWhiteSpace((string?)proposal["reason"]));
+            Assert.False(string.IsNullOrWhiteSpace((string?)proposal["evidence"]));
+        }
+    }
+
+    [Fact]
+    public void Export_RespectsTheInclusiveDateRange()
+    {
+        Propose("REQ-IN", "maker-a", "2024-06-03");
+        Propose("REQ-OUT", "maker-a", "2024-07-15");
+
+        var inRange = ExportEntries("2024-06-03", "2024-06-03");
+
+        Assert.Single(inRange);
+        Assert.Equal("REQ-IN", (string)inRange[0]["requestId"]!);
+        Assert.Equal(2, ExportEntries("2024-06-03", "2024-07-15").Count);
+        Assert.Empty(ExportEntries("2024-01-01", "2024-01-31"));
+    }
+
+    [Fact]
+    public void Export_IsParseableJsonWithAnEntriesArrayAndOrderingMetadata()
+    {
+        Propose("REQ-1", "maker-a", "2024-06-03");
+        Decide("REQ-1", "checker-b", "approve");
+
+        var exportPath = Path.Combine(_stateDirectory, "export", "audit-history.json");
+        Write(exportPath);
+
+        var document = JsonNode.Parse(File.ReadAllText(exportPath))!.AsObject();
+        var entries = document["entries"]!.AsArray();
+
+        Assert.Equal(2, entries.Count);
+        foreach (var node in entries)
+        {
+            var entry = node!.AsObject();
+            Assert.NotNull(entry["requestId"]);
+            Assert.NotNull(entry["action"]);
+            Assert.NotNull(entry["sequence"]);
+            Assert.NotNull(entry["recordedAt"]);
+            Assert.NotNull(entry["hash"]);
+            Assert.True(entry.ContainsKey("previousHash"));
+        }
+
+        // The export alone is sufficient to re-verify the tamper-evidence chain.
+        Assert.Null(AuditLedger.VerifyChain(
+            entries.Select(node => AuditEntry.FromDocument(node!.AsObject())).ToList()));
+    }
+
+    [Fact]
+    public void Export_OnUninitialisedStateProducesAnEmptyHistory()
+    {
+        var emptyDirectory = Path.Combine(_stateDirectory, "never-initialised");
+        var service = new AuditWorkflowService(new AuditLedger(emptyDirectory));
+
+        var (result, document) = service.Export("2024-06-01", "2024-06-30");
+
+        Assert.True(result.Accepted);
+        Assert.Empty(document["entries"]!.AsArray());
+    }
+
+    [Fact]
+    public void AccountAndAmountSentinels_NeverReachDurableStateOrTheExport()
+    {
+        var result = _service.Propose(new ProposeCommand
+        {
+            RequestId = "REQ-SENSITIVE",
+            Proposer = "maker-a",
+            BusinessDate = "2024-06-03",
+            Reason = $"Break on account {AccountSentinel} is understated by {AmountSentinel}",
+            Evidence = $"Custodian statement shows {AmountSentinel} settled for {AccountSentinel}"
+        });
+        var decision = _service.Decide(new DecideCommand
+        {
+            RequestId = "REQ-SENSITIVE",
+            Approver = "checker-b",
+            Decision = "approve"
+        });
+
+        Assert.True(result.Accepted);
+        Assert.True(decision.Accepted);
+
+        var exportPath = Path.Combine(_stateDirectory, "export.json");
+        Write(exportPath);
+
+        var surfaces = new[]
+        {
+            File.ReadAllText(exportPath),
+            File.ReadAllText(Path.Combine(_stateDirectory, "audit-ledger.jsonl")),
+            result.ToJson().ToJsonString(),
+            decision.ToJson().ToJsonString()
+        };
+
+        foreach (var surface in surfaces)
+        {
+            Assert.DoesNotContain(AccountSentinel, surface, StringComparison.OrdinalIgnoreCase);
+            Assert.DoesNotContain(AmountSentinel, surface, StringComparison.OrdinalIgnoreCase);
+        }
+
+        // The proposal is still explainable: masked reason and evidence remain, and the
+        // digests prove which text the maker actually submitted.
+        var proposal = ExportEntries("2024-06-03", "2024-06-03")[0];
+        Assert.Contains(SensitiveTextPolicy.Mask, (string)proposal["reason"]!, StringComparison.Ordinal);
+        Assert.Contains(SensitiveTextPolicy.Mask, (string)proposal["evidence"]!, StringComparison.Ordinal);
+        Assert.Equal(64, ((string)proposal["evidenceDigest"]!).Length);
+    }
+
+    [Theory]
+    [InlineData("ACC001", true)]
+    [InlineData("GB00B03MLX29", true)]
+    [InlineData("1600500.75", true)]
+    [InlineData("1,600,500.75", true)]
+    [InlineData("acct-sentinel", true)]
+    [InlineData("house_account_reference", true)]
+    [InlineData("settlement", false)]
+    [InlineData("custodian", false)]
+    public void Redaction_MasksValueBearingTokensAndKeepsProse(string token, bool expectMasked)
+    {
+        var redacted = SensitiveTextPolicy.Redact($"the {token} evidence");
+
+        if (expectMasked)
+        {
+            Assert.DoesNotContain(token, redacted, StringComparison.OrdinalIgnoreCase);
+            Assert.Contains(SensitiveTextPolicy.Mask, redacted, StringComparison.Ordinal);
+        }
+        else
+        {
+            Assert.Contains(token, redacted, StringComparison.Ordinal);
+        }
+    }
+
+    [Fact]
+    public void Redaction_NormalisesTextToPrintableAsciiSoCanonicalJsonStaysStable()
+    {
+        var redacted = SensitiveTextPolicy.Redact("caf\u00e9 br\u00e9ak\treview\u0007");
+
+        Assert.All(redacted, character => Assert.InRange(character, ' ', '~'));
+    }
+
+    private void Write(string exportPath)
+    {
+        var (_, document) = _service.Export("2024-01-01", "2030-12-31");
+        var directory = Path.GetDirectoryName(Path.GetFullPath(exportPath));
+        if (!string.IsNullOrEmpty(directory))
+        {
+            Directory.CreateDirectory(directory);
+        }
+
+        File.WriteAllText(exportPath, CanonicalJson.Serialize(document));
+    }
+
+    private List<JsonObject> ExportEntries(string from, string to)
+    {
+        var (_, document) = _service.Export(from, to);
+        return document["entries"]!.AsArray().Select(node => node!.AsObject()).ToList();
+    }
+
+    private void Propose(string requestId, string proposer, string businessDate)
+        => _service.Propose(new ProposeCommand
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = businessDate,
+            Reason = "funding adjustment agreed with the custodian",
+            Evidence = "signed custodian confirmation reference on file"
+        });
+
+    private void Decide(string requestId, string approver, string decision)
+        => _service.Decide(new DecideCommand
+        {
+            RequestId = requestId,
+            Approver = approver,
+            Decision = decision
+        });
+}
diff --git a/tests/TradeRecon.Tests/Audit/AuditWorkflowTests.cs b/tests/TradeRecon.Tests/Audit/AuditWorkflowTests.cs
new file mode 100644
index 0000000..16cdfd0
--- /dev/null
+++ b/tests/TradeRecon.Tests/Audit/AuditWorkflowTests.cs
@@ -0,0 +1,340 @@
+using System.Text.Json.Nodes;
+using TradeRecon.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests.Audit;
+
+/// <summary>
+/// Lifecycle behaviour of the maker-checker audit workflow: proposal validation,
+/// segregation of duties, idempotent retries, concurrent conflicting decisions and the
+/// append-only hash chain (REQ-2 … REQ-6, INV-1 … INV-4).
+/// </summary>
+public sealed class AuditWorkflowTests : IDisposable
+{
+    private const string BusinessDate = "2024-06-03";
+
+    private readonly string _stateDirectory =
+        Path.Combine(Path.GetTempPath(), $"trade-recon-audit-{Guid.NewGuid():N}");
+
+    private readonly AuditWorkflowService _service;
+
+    public AuditWorkflowTests()
+    {
+        _service = new AuditWorkflowService(new AuditLedger(_stateDirectory));
+        _service.Initialize();
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_stateDirectory))
+        {
+            Directory.Delete(_stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void Initialize_IsIdempotentAndCreatesDurableState()
+    {
+        var first = _service.Initialize();
+        var second = _service.Initialize();
+
+        Assert.True(first.Accepted);
+        Assert.True(second.Accepted);
+        Assert.True(File.Exists(Path.Combine(_stateDirectory, "audit-ledger.jsonl")));
+    }
+
+    [Fact]
+    public void Propose_RecordsOneDurableProposalForTheMaker()
+    {
+        var result = Propose("REQ-1", "maker-a");
+
+        Assert.True(result.Accepted);
+        Assert.True(result.Appended);
+        Assert.Equal(AuditStatus.Proposed, result.Status);
+        Assert.Equal(AuditActions.Proposed, result.Action);
+        Assert.Equal("maker-a", result.Proposer);
+
+        var entries = Entries();
+        var entry = Assert.Single(entries);
+        Assert.Equal("REQ-1", entry.RequestId);
+        Assert.Equal(1, entry.Sequence);
+        Assert.Null(entry.PreviousHash);
+        Assert.NotEmpty(entry.Reason);
+        Assert.NotEmpty(entry.Evidence);
+    }
+
+    [Theory]
+    [InlineData("", "evidence-a")]
+    [InlineData("   ", "evidence-a")]
+    [InlineData("reason-a", "")]
+    [InlineData("reason-a", "\t ")]
+    public void Propose_WithEmptyReasonOrEvidence_WritesNoHistory(string reason, string evidence)
+    {
+        var result = _service.Propose(new ProposeCommand
+        {
+            RequestId = "REQ-EMPTY",
+            Proposer = "maker-a",
+            BusinessDate = BusinessDate,
+            Reason = reason,
+            Evidence = evidence
+        });
+
+        Assert.False(result.Accepted);
+        Assert.Equal(AuditStatus.InvalidRequest, result.Status);
+        Assert.Empty(Entries());
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("03/06/2024")]
+    public void Propose_WithUnusableBusinessDate_WritesNoHistory(string? businessDate)
+    {
+        var result = _service.Propose(new ProposeCommand
+        {
+            RequestId = "REQ-DATE",
+            Proposer = "maker-a",
+            BusinessDate = businessDate,
+            Reason = "reason-a",
+            Evidence = "evidence-a"
+        });
+
+        Assert.False(result.Accepted);
+        Assert.Empty(Entries());
+    }
+
+    [Fact]
+    public void Propose_RepeatedWithIdenticalContent_IsIdempotent()
+    {
+        Propose("REQ-1", "maker-a");
+        var repeat = Propose("REQ-1", "maker-a");
+
+        Assert.True(repeat.Accepted);
+        Assert.False(repeat.Appended);
+        Assert.Equal(AuditStatus.DuplicateProposal, repeat.Status);
+        Assert.Single(Entries());
+    }
+
+    [Fact]
+    public void Propose_ReusingRequestIdForDifferentContent_IsRefused()
+    {
+        Propose("REQ-1", "maker-a");
+        var conflict = Propose("REQ-1", "maker-c", reason: "a different reason");
+
+        Assert.False(conflict.Accepted);
+        Assert.Equal(AuditStatus.RequestConflict, conflict.Status);
+        Assert.Single(Entries());
+    }
+
+    [Fact]
+    public void Decide_BySelf_CreatesNoFinalEntry()
+    {
+        Propose("REQ-1", "maker-a");
+
+        var selfApproval = Decide("REQ-1", "maker-a", "approve");
+
+        Assert.False(selfApproval.Accepted);
+        Assert.Equal(AuditStatus.SelfApprovalDenied, selfApproval.Status);
+        Assert.Single(Entries());
+        Assert.DoesNotContain(Entries(), entry => entry.IsTerminal);
+    }
+
+    [Fact]
+    public void Decide_BySelfInDifferentCasing_CreatesNoFinalEntry()
+    {
+        Propose("REQ-1", "maker-a");
+
+        var selfApproval = Decide("REQ-1", "MAKER-A", "approve");
+
+        Assert.Equal(AuditStatus.SelfApprovalDenied, selfApproval.Status);
+        Assert.DoesNotContain(Entries(), entry => entry.IsTerminal);
+    }
+
+    [Fact]
+    public void Decide_ByDistinctChecker_CreatesExactlyOneApprovedEntry()
+    {
+        Propose("REQ-1", "maker-a");
+
+        var approval = Decide("REQ-1", "checker-b", "approve");
+
+        Assert.True(approval.Accepted);
+        Assert.Equal(AuditStatus.Approved, approval.Status);
+        Assert.Equal("checker-b", approval.Checker);
+
+        var terminal = Assert.Single(Entries(), entry => entry.IsTerminal);
+        Assert.Equal(AuditActions.Approved, terminal.Action);
+        Assert.Equal("checker-b", terminal.Checker);
+        Assert.Equal("maker-a", terminal.Proposer);
+        Assert.NotEqual(terminal.Proposer, terminal.Checker);
+    }
+
+    [Fact]
+    public void Decide_ByDistinctChecker_CanReject()
+    {
+        Propose("REQ-2", "maker-a");
+
+        var rejection = Decide("REQ-2", "checker-b", "reject");
+
+        Assert.True(rejection.Accepted);
+        Assert.Equal(AuditStatus.Rejected, rejection.Status);
+        var terminal = Assert.Single(Entries(), entry => entry.IsTerminal);
+        Assert.Equal(AuditActions.Rejected, terminal.Action);
+    }
+
+    [Fact]
+    public void Decide_ForUnknownRequest_IsRefused()
+    {
+        var result = Decide("REQ-MISSING", "checker-b", "approve");
+
+        Assert.False(result.Accepted);
+        Assert.Equal(AuditStatus.UnknownRequest, result.Status);
+        Assert.Empty(Entries());
+    }
+
+    [Fact]
+    public void Decide_RepeatedIdenticalApproval_IsIdempotent()
+    {
+        Propose("REQ-1", "maker-a");
+        Decide("REQ-1", "checker-b", "approve");
+
+        var repeat = Decide("REQ-1", "checker-b", "approve");
+
+        Assert.True(repeat.Accepted);
+        Assert.False(repeat.Appended);
+        Assert.Equal(AuditStatus.DuplicateDecision, repeat.Status);
+        Assert.Single(Entries(), entry => entry.IsTerminal);
+    }
+
+    [Fact]
+    public void Decide_ConflictingSecondDecision_IsRefusedAndLeavesOneFinalEntry()
+    {
+        Propose("REQ-1", "maker-a");
+        Decide("REQ-1", "checker-b", "approve");
+
+        var conflict = Decide("REQ-1", "checker-c", "reject");
+
+        Assert.False(conflict.Accepted);
+        Assert.Equal(AuditStatus.DecisionConflict, conflict.Status);
+        var terminal = Assert.Single(Entries(), entry => entry.IsTerminal);
+        Assert.Equal(AuditActions.Approved, terminal.Action);
+    }
+
+    [Fact]
+    public void ConcurrentApproveAndReject_LeaveExactlyOneAttributedFinalDecision()
+    {
+        Propose("REQ-RACE", "maker-a");
+
+        var gate = new ManualResetEventSlim(false);
+        var outcomes = new AuditCommandResult[8];
+        var workers = new Thread[outcomes.Length];
+
+        for (var index = 0; index < workers.Length; index++)
+        {
+            var slot = index;
+            workers[slot] = new Thread(() =>
+            {
+                // Each worker uses its own service instance, exactly like an independent
+                // adapter process would.
+                var service = new AuditWorkflowService(new AuditLedger(_stateDirectory));
+                gate.Wait();
+                outcomes[slot] = service.Decide(new DecideCommand
+                {
+                    RequestId = "REQ-RACE",
+                    Approver = slot % 2 == 0 ? "checker-b" : "checker-c",
+                    Decision = slot % 2 == 0 ? "approve" : "reject"
+                });
+            });
+            workers[slot].Start();
+        }
+
+        gate.Set();
+        foreach (var worker in workers)
+        {
+            worker.Join(TimeSpan.FromSeconds(60));
+        }
+
+        Assert.Single(outcomes, outcome => outcome.Appended);
+
+        var entries = Entries();
+        var terminal = Assert.Single(entries, entry => entry.IsTerminal);
+        Assert.False(string.IsNullOrWhiteSpace(terminal.Checker));
+        Assert.NotEqual(terminal.Proposer, terminal.Checker);
+        Assert.Null(AuditLedger.VerifyChain(entries));
+    }
+
+    [Fact]
+    public void History_IsAppendOnlyWithContiguousSequenceAndVerifiableHashChain()
+    {
+        Propose("REQ-1", "maker-a");
+        Propose("REQ-2", "maker-c");
+        Decide("REQ-1", "checker-b", "approve");
+        Decide("REQ-2", "checker-b", "reject");
+
+        var entries = Entries();
+
+        Assert.Equal(4, entries.Count);
+        Assert.Null(AuditLedger.VerifyChain(entries));
+        Assert.Equal([1, 2, 3, 4], entries.Select(entry => entry.Sequence).ToArray());
+        Assert.Null(entries[0].PreviousHash);
+
+        for (var index = 1; index < entries.Count; index++)
+        {
+            Assert.Equal(entries[index - 1].Hash, entries[index].PreviousHash);
+        }
+
+        foreach (var entry in entries)
+        {
+            Assert.Equal(64, entry.Hash.Length);
+            Assert.Equal(entry.Hash.ToLowerInvariant(), entry.Hash);
+            Assert.Equal(entry.Hash, RecomputeHashLikeAnExternalVerifier(entry.Document));
+        }
+    }
+
+    [Fact]
+    public void TamperingWithADurableEntry_BreaksTheHashChain()
+    {
+        Propose("REQ-1", "maker-a");
+        Decide("REQ-1", "checker-b", "approve");
+
+        var ledgerPath = Path.Combine(_stateDirectory, "audit-ledger.jsonl");
+        var lines = File.ReadAllLines(ledgerPath);
+        var tampered = JsonNode.Parse(lines[0])!.AsObject();
+        tampered["actor"] = "someone-else";
+        lines[0] = tampered.ToJsonString();
+        File.WriteAllLines(ledgerPath, lines);
+
+        Assert.NotNull(AuditLedger.VerifyChain(Entries()));
+    }
+
+    /// <summary>
+    /// Independent reimplementation of the documented hash rule: lowercase SHA-256 over the
+    /// canonical JSON of the entry without its <c>hash</c> property, with recursively sorted
+    /// object keys.
+    /// </summary>
+    private static string RecomputeHashLikeAnExternalVerifier(JsonObject document)
+    {
+        var copy = (JsonObject)document.DeepClone();
+        copy.Remove("hash");
+        return CanonicalJson.Hash(CanonicalJson.Serialize(copy));
+    }
+
+    private IReadOnlyList<AuditEntry> Entries() => new AuditLedger(_stateDirectory).ReadAll();
+
+    private AuditCommandResult Propose(string requestId, string proposer, string reason = "break requires funding adjustment")
+        => _service.Propose(new ProposeCommand
+        {
+            RequestId = requestId,
+            Proposer = proposer,
+            BusinessDate = BusinessDate,
+            Reason = reason,
+            Evidence = "custodian confirmation attached"
+        });
+
+    private AuditCommandResult Decide(string requestId, string approver, string decision)
+        => _service.Decide(new DecideCommand
+        {
+            RequestId = requestId,
+            Approver = approver,
+            Decision = decision
+        });
+}
