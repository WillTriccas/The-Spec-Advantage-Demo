+    private static async Task<int> RunAuditCommandAsync(string[] args)
+    {
+        var commandArgs = string.Equals(args[0], "audit", StringComparison.OrdinalIgnoreCase)
+           ? args[1..]
+           : args;
+
+        if (commandArgs.Length == 0)
+        {
+           System.Console.WriteLine("{\"ok\":false,\"error\":\"No audit command supplied.\"}");
+           return ExitError;
+        }
+
+        var command = commandArgs[0];
+
+        try
+        {
+           var values = ParseAuditArguments(commandArgs);
+           switch (command)
+           {
+               case "initialize":
+                   var initializeStateDirectory = GetRequiredAuditValue(values, commandArgs, 0, "stateDirectory");
+                   AuditCommandProcessor.Initialize(initializeStateDirectory);
+                   WriteAuditJson(new { ok = true, command = "initialize", stateDirectory = initializeStateDirectory, status = "initialized" });
+                   return ExitClean;
+
+               case "propose":
+                   var proposeStateDirectory = GetRequiredAuditValue(values, commandArgs, 0, "stateDirectory");
+                   var requestId = GetRequiredAuditValue(values, commandArgs, 1, "requestId");
+                   var proposer = GetRequiredAuditValue(values, commandArgs, 2, "proposer");
+                   var proposalDate = GetRequiredAuditValue(values, commandArgs, 3, "businessDate");
+                   var reason = GetRequiredAuditValue(values, commandArgs, 4, "reason");
+                   var evidence = GetRequiredAuditValue(values, commandArgs, 5, "evidence");
+                   var proposal = AuditCommandProcessor.Propose(
+                       proposeStateDirectory,
+                       requestId,
+                       proposer,
+                       DateOnly.ParseExact(proposalDate, "yyyy-MM-dd", CultureInfo.InvariantCulture),
+                       reason,
+                       evidence);
+                   WriteAuditJson(new
+                   {
+                       ok = true,
+                       command = "propose",
+                       requestId = proposal.RequestId,
+                       actor = proposal.Actor,
+                       action = proposal.Action,
+                       businessDate = proposal.BusinessDate,
+                       sequence = proposal.Sequence,
+                       previousHash = proposal.PreviousHash,
+                       hash = proposal.Hash,
+                       timestampUtc = proposal.TimestampUtc,
+                       version = proposal.Version
+                   });
+                   return ExitClean;
+
+               case "decide":
+                   var decideStateDirectory = GetRequiredAuditValue(values, commandArgs, 0, "stateDirectory");
+                   var decideRequestId = GetRequiredAuditValue(values, commandArgs, 1, "requestId");
+                   var approver = GetRequiredAuditValue(values, commandArgs, 2, "approver");
+                   var decision = GetRequiredAuditValue(values, commandArgs, 3, "decision");
+                   var finalDecision = AuditCommandProcessor.Decide(decideStateDirectory, decideRequestId, approver, decision);
+                   WriteAuditJson(new
+                   {
+                       ok = true,
+                       command = "decide",
+                       requestId = finalDecision.RequestId,
+                       actor = finalDecision.Actor,
+                       action = finalDecision.Action,
+                       businessDate = finalDecision.BusinessDate,
+                       sequence = finalDecision.Sequence,
+                       previousHash = finalDecision.PreviousHash,
+                       hash = finalDecision.Hash,
+                       timestampUtc = finalDecision.TimestampUtc,
+                       version = finalDecision.Version
+                   });
+                   return ExitClean;
+
+               case "export":
+                   var exportStateDirectory = GetRequiredAuditValue(values, commandArgs, 0, "stateDirectory");
+                   var exportFromDate = GetRequiredAuditValue(values, commandArgs, 1, "fromDate");
+                   var exportToDate = GetRequiredAuditValue(values, commandArgs, 2, "toDate");
+                   var exportPath = GetRequiredAuditValue(values, commandArgs, 3, "exportPath");
+
+                   var exportPayload = AuditCommandProcessor.Export(
+                       exportStateDirectory,
+                       DateOnly.ParseExact(exportFromDate, "yyyy-MM-dd", CultureInfo.InvariantCulture),
+                       DateOnly.ParseExact(exportToDate, "yyyy-MM-dd", CultureInfo.InvariantCulture));
+
+                   var entries = exportPayload.Entries.Select(entry => new
+                   {
+                       requestId = entry.RequestId,
+                       action = entry.Action,
+                       actor = entry.Actor,
+                       businessDate = entry.BusinessDate,
+                       reason = entry.Reason,
+                       evidence = entry.Evidence,
+                       sequence = entry.Sequence,
+                       previousHash = entry.PreviousHash,
+                       hash = entry.Hash,
+                       timestampUtc = entry.TimestampUtc,
+                       version = entry.Version
+                   }).ToList();
+
+                   var jsonPayload = new { entries };
+                   var outputJson = JsonSerializer.Serialize(jsonPayload, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
+                   var exportDirectory = Path.GetDirectoryName(exportPath);
+                   if (!string.IsNullOrWhiteSpace(exportDirectory))
+                   {
+                       Directory.CreateDirectory(exportDirectory);
+                   }
+
+                   await File.WriteAllTextAsync(exportPath, outputJson + Environment.NewLine).ConfigureAwait(false);
+                   WriteAuditJson(jsonPayload);
+                   return ExitClean;
+
+               default:
+                   throw new ArgumentException($"Unknown audit command '{command}'.");
+           }
+        }
+        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or FormatException or DirectoryNotFoundException or PathTooLongException or NotSupportedException)
+        {
+           WriteAuditJson(new { ok = false, command = command, error = ex.Message });
+           return ExitError;
+        }
+    }
