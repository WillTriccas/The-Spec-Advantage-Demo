+using System.Diagnostics;
+using TradeRecon.Application.Audit;
+using Xunit;
+
+namespace TradeRecon.Tests;
+
+public class AuditWorkflowTests
+{
+    [Fact]
+    public void Propose_CreatesOrderedHashChain_AndRedactsEvidence()
+    {
+        var stateDirectory = CreateStateDirectory();
+
+        try
+        {
+            AuditCommandProcessor.Initialize(stateDirectory);
+
+            var proposal = AuditCommandProcessor.Propose(
+                stateDirectory,
+                "REQ-100",
+                "maker-a",
+                new DateOnly(2024, 06, 03),
+                "Break needs review after account ACC123 mismatch and amount 125000.00.",
+                "Evidence: account ACC123 and amount 125000.00 were reviewed.");
+
+            Assert.Equal("PROPOSED", proposal.Action);
+            Assert.Equal("maker-a", proposal.Actor);
+            Assert.Equal(1, proposal.Sequence);
+            Assert.Null(proposal.PreviousHash);
+            Assert.False(string.IsNullOrWhiteSpace(proposal.Hash));
+
+            var export = AuditCommandProcessor.Export(stateDirectory, new DateOnly(2024, 06, 03), new DateOnly(2024, 06, 03));
+            var entry = Assert.Single(export.Entries);
+            Assert.True(entry.Reason.Contains("review", StringComparison.OrdinalIgnoreCase));
+            Assert.DoesNotContain("ACC123", entry.Reason, StringComparison.Ordinal);
+            Assert.DoesNotContain("125000.00", entry.Evidence, StringComparison.Ordinal);
+            Assert.Equal(proposal.Hash, entry.Hash);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void Decide_RejectsSelfApproval_AndAcceptsDistinctChecker()
+    {
+        var stateDirectory = CreateStateDirectory();
+
+        try
+        {
+            AuditCommandProcessor.Initialize(stateDirectory);
+            AuditCommandProcessor.Propose(
+                stateDirectory,
+                "REQ-200",
+                "maker-a",
+                new DateOnly(2024, 06, 03),
+                "Reason is provided.",
+                "Evidence is captured.");
+
+            var ex = Assert.Throws<InvalidOperationException>(() =>
+                AuditCommandProcessor.Decide(stateDirectory, "REQ-200", "maker-a", "APPROVED"));
+            Assert.Contains("Self-approval", ex.Message, StringComparison.OrdinalIgnoreCase);
+
+            var approved = AuditCommandProcessor.Decide(stateDirectory, "REQ-200", "checker-b", "APPROVED");
+            Assert.Equal("APPROVED", approved.Action);
+            Assert.Equal("checker-b", approved.Actor);
+
+            var export = AuditCommandProcessor.Export(stateDirectory, new DateOnly(2024, 06, 03), new DateOnly(2024, 06, 03));
+            Assert.Equal(2, export.Entries.Count);
+            Assert.Equal("APPROVED", Assert.Single(export.Entries, entry => entry.Action == "APPROVED").Action);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void Decide_IsIdempotent_ForRepeatedDecision()
+    {
+        var stateDirectory = CreateStateDirectory();
+
+        try
+        {
+            AuditCommandProcessor.Initialize(stateDirectory);
+            AuditCommandProcessor.Propose(
+                stateDirectory,
+                "REQ-300",
+                "maker-a",
+                new DateOnly(2024, 06, 03),
+                "Reason is provided.",
+                "Evidence is captured.");
+
+            var first = AuditCommandProcessor.Decide(stateDirectory, "REQ-300", "checker-b", "APPROVED");
+            var second = AuditCommandProcessor.Decide(stateDirectory, "REQ-300", "checker-b", "APPROVED");
+
+            Assert.Equal(first.Hash, second.Hash);
+            Assert.Equal(2, AuditCommandProcessor.Export(stateDirectory, new DateOnly(2024, 06, 03), new DateOnly(2024, 06, 03)).Entries.Count);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public async Task ConcurrentConflictingDecisions_KeepExactlyOneFinalDecision()
+    {
+        var stateDirectory = CreateStateDirectory();
+
+        try
+        {
+            AuditCommandProcessor.Initialize(stateDirectory);
+            AuditCommandProcessor.Propose(
+                stateDirectory,
+                "REQ-400",
+                "maker-a",
+                new DateOnly(2024, 06, 03),
+                "Reason is provided.",
+                "Evidence is captured.");
+
+            var tasks = new[]
+            {
+                Task.Run(() => AuditCommandProcessor.Decide(stateDirectory, "REQ-400", "checker-b", "APPROVED")),
+                Task.Run(() => AuditCommandProcessor.Decide(stateDirectory, "REQ-400", "checker-c", "REJECTED"))
+            };
+
+            var results = new List<AuditEntry>();
+            foreach (var task in tasks)
+            {
+                try
+                {
+                    results.Add(await task);
+                }
+                catch (InvalidOperationException)
+                {
+                }
+            }
+
+            Assert.Single(results);
+
+            var export = AuditCommandProcessor.Export(stateDirectory, new DateOnly(2024, 06, 03), new DateOnly(2024, 06, 03));
+            var exportedFinalEntries = export.Entries.Where(entry => entry.Action == "APPROVED" || entry.Action == "REJECTED").ToList();
+            Assert.Single(exportedFinalEntries);
+        }
+        finally
+        {
+            Directory.Delete(stateDirectory, recursive: true);
+        }
+    }
+
+    private static string CreateStateDirectory()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"audit-workflow-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(path);
+        return path;
+    }
+}
