@@ -0,0 +1,62 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://example.com/schemas/audit-adapter.schema.json",
+  "title": "Audit Adapter Contract",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "workingDirectory", "commands"],
+  "properties": {
+    "schemaVersion": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
+    },
+    "workingDirectory": {
+      "type": "string"
+    },
+    "commands": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["initialize", "propose", "decide", "export"],
+      "properties": {
+        "initialize": {
+          "$ref": "#/definitions/commandDefinition"
+        },
+        "propose": {
+          "$ref": "#/definitions/commandDefinition"
+        },
+        "decide": {
+          "$ref": "#/definitions/commandDefinition"
+        },
+        "export": {
+          "$ref": "#/definitions/commandDefinition"
+        }
+      }
+    }
+  },
+  "definitions": {
+    "commandDefinition": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["executable", "arguments", "allowedExitCodes"],
+      "properties": {
+        "executable": {
+          "type": "string",
+          "minLength": 1
+        },
+        "arguments": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "allowedExitCodes": {
+          "type": "array",
+          "items": {
+            "type": "integer",
+            "minimum": 0
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/TradeRecon.Application/Audit/AuditCommandProcessor.cs b/src/TradeRecon.Application/Audit/AuditCommandProcessor.cs
new file mode 100644
index 0000000..835df34
--- /dev/null
+++ b/src/TradeRecon.Application/Audit/AuditCommandProcessor.cs
@@ -0,0 +1,404 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace TradeRecon.Application.Audit;
+
+public static partial class AuditCommandProcessor
+{
+    private static readonly ConcurrentDictionary<string, object> DirectoryLocks = new(StringComparer.OrdinalIgnoreCase);
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        WriteIndented = false
+    };
+
+    public static void Initialize(string stateDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+
+        var directory = EnsureDirectory(stateDirectory);
+        var statePath = Path.Combine(directory, "audit-state.json");
+
+        using var _ = AcquireLock(directory);
+        if (!File.Exists(statePath))
+        {
+            WriteState(directory, new AuditState());
+        }
+    }
+
+    public static AuditEntry Propose(
+        string stateDirectory,
+        string requestId,
+        string proposer,
+        DateOnly businessDate,
+        string reason,
+        string evidence)
+    {
+        ValidateRequestIdentity(requestId, nameof(requestId));
+        ValidateActor(proposer, nameof(proposer));
+        var sanitizedReason = SanitizeAuditText(reason);
+        var sanitizedEvidence = SanitizeAuditText(evidence);
+        if (string.IsNullOrWhiteSpace(sanitizedReason))
+        {
+            throw new ArgumentException("Reason must be provided.", nameof(reason));
+        }
+
+        if (string.IsNullOrWhiteSpace(sanitizedEvidence))
+        {
+            throw new ArgumentException("Evidence must be provided.", nameof(evidence));
+        }
+
+        var directory = EnsureDirectory(stateDirectory);
+        using var _ = AcquireLock(directory);
+        var state = LoadState(directory);
+        var existing = state.Entries
+            .Where(entry => entry.RequestId == requestId && entry.Action == AuditAction.Proposed)
+            .OrderBy(entry => entry.Sequence)
+            .LastOrDefault();
+
+        if (existing is not null)
+        {
+            return existing;
+        }
+
+        var previousHash = state.Entries.Count == 0 ? null : state.Entries[^1].Hash;
+        var nextSequence = state.Entries.Count == 0 ? 1 : state.Entries.Max(entry => entry.Sequence) + 1;
+        var entry = new AuditEntry
+        {
+            RequestId = requestId,
+            Action = AuditAction.Proposed,
+            Actor = proposer,
+            BusinessDate = businessDate,
+            Reason = sanitizedReason,
+            Evidence = sanitizedEvidence,
+            Sequence = nextSequence,
+            TimestampUtc = DateTimeOffset.UtcNow,
+            Version = "1.0.0",
+            PreviousHash = previousHash,
+            Hash = string.Empty
+        };
+
+        entry.Hash = ComputeHash(entry);
+        state.Entries.Add(entry);
+        WriteState(directory, state);
+        return entry;
+    }
+
+    public static AuditEntry Decide(
+        string stateDirectory,
+        string requestId,
+        string approver,
+        string decision)
+    {
+        ValidateRequestIdentity(requestId, nameof(requestId));
+        ValidateActor(approver, nameof(approver));
+        if (!Enum.TryParse<AuditDecision>(decision, true, out var parsedDecision))
+        {
+            throw new ArgumentException("Decision must be APPROVED or REJECTED.", nameof(decision));
+        }
+
+        var directory = EnsureDirectory(stateDirectory);
+        using var _ = AcquireLock(directory);
+        var state = LoadState(directory);
+        var proposal = state.Entries
+            .Where(entry => entry.RequestId == requestId && entry.Action == AuditAction.Proposed)
+            .OrderBy(entry => entry.Sequence)
+            .LastOrDefault();
+
+        if (proposal is null)
+        {
+            throw new InvalidOperationException($"No proposal exists for requestId '{requestId}'.");
+        }
+
+        if (string.Equals(proposal.Actor, approver, StringComparison.Ordinal))
+        {
+            throw new InvalidOperationException("Self-approval is not permitted.");
+        }
+
+        var terminal = state.Entries
+            .Where(entry => entry.RequestId == requestId && (entry.Action == AuditAction.Approved || entry.Action == AuditAction.Rejected))
+            .OrderBy(entry => entry.Sequence)
+            .LastOrDefault();
+        var expectedAction = parsedDecision == AuditDecision.Approved ? AuditAction.Approved : AuditAction.Rejected;
+
+        if (terminal is not null)
+        {
+            if (string.Equals(terminal.Action, expectedAction, StringComparison.Ordinal) &&
+                string.Equals(terminal.Actor, approver, StringComparison.Ordinal))
+            {
+                return terminal;
+            }
+
+            throw new InvalidOperationException("A final decision already exists for this request.");
+        }
+
+        var previousHash = state.Entries.Count == 0 ? null : state.Entries[^1].Hash;
+        var nextSequence = state.Entries.Count == 0 ? 1 : state.Entries.Max(entry => entry.Sequence) + 1;
+        var entry = new AuditEntry
+        {
+            RequestId = requestId,
+            Action = parsedDecision == AuditDecision.Approved ? AuditAction.Approved : AuditAction.Rejected,
+            Actor = approver,
+            BusinessDate = proposal.BusinessDate,
+            Reason = proposal.Reason,
+            Evidence = proposal.Evidence,
+            Sequence = nextSequence,
+            TimestampUtc = DateTimeOffset.UtcNow,
+            Version = "1.0.0",
+            PreviousHash = previousHash,
+            Hash = string.Empty
+        };
+
+        entry.Hash = ComputeHash(entry);
+        state.Entries.Add(entry);
+        WriteState(directory, state);
+        return entry;
+    }
+
+    public static AuditExportResult Export(
+        string stateDirectory,
+        DateOnly fromDate,
+        DateOnly toDate)
+    {
+        var directory = EnsureDirectory(stateDirectory);
+        using var _ = AcquireLock(directory);
+        var state = LoadState(directory);
+
+        var entries = state.Entries
+            .Where(entry => entry.BusinessDate >= fromDate && entry.BusinessDate <= toDate)
+            .OrderBy(entry => entry.Sequence)
+            .ToList();
+
+        return new AuditExportResult(entries);
+    }
+
+    public static string ResetForTests(string stateDirectory)
+    {
+        var directory = EnsureDirectory(stateDirectory);
+        using var _ = AcquireLock(directory);
+        var statePath = Path.Combine(directory, "audit-state.json");
+        if (File.Exists(statePath))
+        {
+            File.Delete(statePath);
+        }
+
+        WriteState(directory, new AuditState());
+        return statePath;
+    }
+
+    private static string EnsureDirectory(string stateDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(stateDirectory);
+        var directory = Path.GetFullPath(stateDirectory);
+        Directory.CreateDirectory(directory);
+        return directory;
+    }
+
+    private static AuditState LoadState(string directory)
+    {
+        var statePath = Path.Combine(directory, "audit-state.json");
+        if (!File.Exists(statePath))
+        {
+            return new AuditState();
+        }
+
+        var json = File.ReadAllText(statePath);
+        if (string.IsNullOrWhiteSpace(json))
+        {
+            return new AuditState();
+        }
+
+        var state = JsonSerializer.Deserialize<AuditState>(json, JsonOptions);
+        return state ?? new AuditState();
+    }
+
+    private static void WriteState(string directory, AuditState state)
+    {
+        var statePath = Path.Combine(directory, "audit-state.json");
+        var json = JsonSerializer.Serialize(state, JsonOptions);
+        File.WriteAllText(statePath, json + Environment.NewLine);
+    }
+
+    private static IDisposable AcquireLock(string directory)
+    {
+        var gate = DirectoryLocks.GetOrAdd(directory, _ => new object());
+        Monitor.Enter(gate);
+
+        var lockPath = Path.Combine(directory, "audit.lock");
+        var start = DateTime.UtcNow;
+        while (true)
+        {
+            try
+            {
+                var stream = new FileStream(lockPath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+                return new DirectoryLock(stream, gate);
+            }
+            catch (IOException) when (DateTime.UtcNow - start < TimeSpan.FromSeconds(5))
+            {
+                Thread.Sleep(50);
+            }
+            catch (IOException ex)
+            {
+                Monitor.Exit(gate);
+                throw new IOException("Unable to acquire the audit state lock within the timeout window.", ex);
+            }
+            catch (UnauthorizedAccessException ex)
+            {
+                Monitor.Exit(gate);
+                throw new UnauthorizedAccessException("Unable to acquire the audit state lock.", ex);
+            }
+        }
+    }
+
+    private sealed class DirectoryLock : IDisposable
+    {
+        private readonly object _gate;
+        private readonly FileStream _stream;
+
+        public DirectoryLock(FileStream stream, object gate)
+        {
+            _stream = stream ?? throw new ArgumentNullException(nameof(stream));
+            _gate = gate ?? throw new ArgumentNullException(nameof(gate));
+        }
+
+        public void Dispose()
+        {
+            _stream.Dispose();
+            Monitor.Exit(_gate);
+        }
+    }
+
+    private static void ValidateActor(string actor, string parameterName)
+    {
+        if (string.IsNullOrWhiteSpace(actor))
+        {
+            throw new ArgumentException("Actor identity is required.", parameterName);
+        }
+    }
+
+    private static void ValidateRequestIdentity(string requestId, string parameterName)
+    {
+        if (string.IsNullOrWhiteSpace(requestId))
+        {
+            throw new ArgumentException("RequestId is required.", parameterName);
+        }
+    }
+
+    private static string ComputeHash(AuditEntry entry)
+    {
+        var payload = new Dictionary<string, object?>
+        {
+            ["requestId"] = entry.RequestId,
+            ["action"] = entry.Action,
+            ["actor"] = entry.Actor,
+            ["businessDate"] = entry.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+            ["reason"] = entry.Reason,
+            ["evidence"] = entry.Evidence,
+            ["sequence"] = entry.Sequence,
+            ["timestampUtc"] = entry.TimestampUtc.ToString("O", CultureInfo.InvariantCulture),
+            ["version"] = entry.Version,
+            ["previousHash"] = entry.PreviousHash
+        };
+
+        var canonical = CanonicalizeJson(payload);
+        var data = SHA256.HashData(Encoding.UTF8.GetBytes(canonical));
+        return Convert.ToHexString(data).ToLowerInvariant();
+    }
+
+    private static string CanonicalizeJson(object? value)
+    {
+        var element = JsonSerializer.SerializeToElement(value, JsonOptions);
+        return CanonicalizeJsonElement(element);
+    }
+
+    private static string CanonicalizeJsonElement(JsonElement element)
+    {
+        return element.ValueKind switch
+        {
+            JsonValueKind.Object => "{" + string.Join(",", element.EnumerateObject()
+                .OrderBy(property => property.Name, StringComparer.Ordinal)
+                .Select(property => JsonSerializer.Serialize(property.Name) + ":" + CanonicalizeJsonElement(property.Value))) + "}",
+            JsonValueKind.Array => "[" + string.Join(",", element.EnumerateArray().Select(CanonicalizeJsonElement)) + "]",
+            JsonValueKind.String => JsonSerializer.Serialize(element.GetString() ?? string.Empty),
+            JsonValueKind.Number => element.GetRawText(),
+            JsonValueKind.True => "true",
+            JsonValueKind.False => "false",
+            JsonValueKind.Null => "null",
+            _ => "null"
+        };
+    }
+
+    private static string SanitizeAuditText(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return string.Empty;
+        }
+
+        var sanitized = value;
+        sanitized = Regex.Replace(sanitized, @"(?i)\b(?:acct|account|client|counterparty|portfolio|instrument|trade|settlement)[A-Z0-9\-_./]{2,}\b", "[REDACTED_ACCOUNT]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b[A-Z]{2,}[A-Z0-9\-_./]*\d+[A-Z0-9\-_./]*\b", "[REDACTED_ACCOUNT]");
+        sanitized = Regex.Replace(sanitized, @"(?i)\b(?:amount|value|notional|principal|quantity|balance)\s*[:=]?\s*[-+]?\d[\d,]*(?:\.\d+)?\b", "[REDACTED_AMOUNT]");
+        sanitized = Regex.Replace(sanitized, @"(?<![A-Za-z])[-+]?\d[\d,]*(?:\.\d+)?\b", "[REDACTED_AMOUNT]");
+        return sanitized.Trim();
+    }
+}
+
+public enum AuditDecision
+{
+    Approved,
+    Rejected
+}
+
+public static class AuditAction
+{
+    public const string Proposed = "PROPOSED";
+    public const string Approved = "APPROVED";
+    public const string Rejected = "REJECTED";
+}
+
+public sealed class AuditState
+{
+    public string SchemaVersion { get; set; } = "1.0.0";
+
+    public List<AuditEntry> Entries { get; set; } = [];
+}
+
+public sealed class AuditEntry
+{
+    public string RequestId { get; set; } = string.Empty;
+
+    public string Action { get; set; } = string.Empty;
+
+    public string Actor { get; set; } = string.Empty;
+
+    public DateOnly BusinessDate { get; set; }
+
+    public string Reason { get; set; } = string.Empty;
+
+    public string Evidence { get; set; } = string.Empty;
+
+    public int Sequence { get; set; }
+
+    public string? PreviousHash { get; set; }
+
+    public string Hash { get; set; } = string.Empty;
+
+    public DateTimeOffset TimestampUtc { get; set; }
+
+    public string Version { get; set; } = string.Empty;
+}
+
+public sealed class AuditExportResult
+{
+    public AuditExportResult(IReadOnlyList<AuditEntry> entries)
+    {
+        Entries = entries;
+    }
+
+    public IReadOnlyList<AuditEntry> Entries { get; }
+}
