{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spec-demo/run.schema.json",
  "title": "Benchmark run artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "benchmarkVersion",
    "episodeId",
    "laneId",
    "model",
    "inputMode",
    "repetition",
    "baseline",
    "execution",
    "source",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "benchmarkVersion": { "type": "string", "minLength": 1 },
    "episodeId": {
      "enum": ["modernization", "audit-feature"]
    },
    "laneId": {
      "enum": [
        "efficient-raw",
        "efficient-spec",
        "frontier-raw",
        "frontier-spec"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "tier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["efficient", "frontier"] }
      }
    },
    "inputMode": { "enum": ["raw", "spec"] },
    "repetition": { "type": "integer", "minimum": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "spec": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256", "qualityScore"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "qualityScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "startedAt",
        "endedAt",
        "elapsedSeconds",
        "agentVersion",
        "toolCalls"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "failed", "timed-out", "cancelled"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "agentVersion": { "type": "string", "minLength": 1 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "inputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "outputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "estimatedCostUsd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "diffPath"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "diffPath": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "transcriptPath", "evaluatorPath"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "transcriptPath": { "type": "string", "minLength": 1 },
        "evaluatorPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
